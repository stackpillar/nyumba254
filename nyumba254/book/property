<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Book a stay — Nyumba254</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet"/>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  :root{
    --green:#0F6E56;--green-mid:#1D9E75;--green-dark:#085041;--green-light:#E1F5EE;
    --gold:#BA7517;--gold-light:#FAEEDA;--red:#c0392b;--red-light:#fdecea;
    --text:#1a1a18;--text-2:#4a4a46;--text-3:#888780;
    --border:#e0ded8;--surface:#f7f6f2;--white:#ffffff;
    --radius:10px;--radius-lg:16px;
    --shadow:0 1px 3px rgba(0,0,0,0.06),0 4px 14px rgba(0,0,0,0.05);
    --shadow-lg:0 10px 32px rgba(0,0,0,0.12);
  }
  body{font-family:'Inter',sans-serif;color:var(--text);background:var(--surface);line-height:1.6;font-size:15px}
  a{color:inherit;text-decoration:none}
  img{display:block;max-width:100%}
  button{font-family:inherit;cursor:pointer}
  h1,h2,h3{font-family:'Playfair Display',serif;font-weight:700;color:var(--text)}

  .topbar{position:sticky;top:0;z-index:50;background:var(--white);border-bottom:1px solid var(--border)}
  .topbar-inner{max-width:1180px;margin:0 auto;padding:16px 28px;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .brand{display:flex;align-items:center;gap:10px}
  .brand-mark{width:34px;height:34px;border-radius:8px;background:var(--green);display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .brand-mark svg{width:17px;height:17px;stroke:white;fill:none;stroke-width:2}
  .brand-name{font-family:'Playfair Display',serif;font-size:18px;font-weight:700}
  .back-link{display:flex;align-items:center;gap:6px;font-size:13.5px;font-weight:600;color:var(--text-2)}
  .back-link:hover{color:var(--green)}
  .back-link svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:var(--radius);font-weight:600;font-size:14px;padding:13px 20px;transition:all .15s;width:100%}
  .btn-primary{background:var(--green);color:white}
  .btn-primary:hover{background:var(--green-dark)}
  .btn-primary:disabled{opacity:.5;cursor:not-allowed}

  .wrap{max-width:1180px;margin:0 auto;padding:28px}

  /* ── Gallery ───────────────────────────────────────────── */
  .gallery{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:1fr 1fr;gap:8px;border-radius:var(--radius-lg);overflow:hidden;height:420px;margin-bottom:28px}
  .gallery img,.gallery .no-photo{width:100%;height:100%;object-fit:cover;background:var(--green-light)}
  .gallery a:nth-child(1){grid-row:1/3}
  .no-photo{display:flex;align-items:center;justify-content:center;color:var(--green-mid)}
  .no-photo svg{width:36px;height:36px;stroke:currentColor;fill:none;stroke-width:1.3}
  @media(max-width:760px){.gallery{grid-template-columns:1fr;grid-template-rows:none;height:260px}.gallery a:not(:first-child){display:none}}

  /* ── Content layout ────────────────────────────────────── */
  .layout{display:grid;grid-template-columns:1.6fr 1fr;gap:44px;align-items:start}
  @media(max-width:900px){.layout{grid-template-columns:1fr}}

  .title-row{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:6px;flex-wrap:wrap}
  .title-row h1{font-size:26px}
  .verified-badge{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--green-dark);background:var(--green-light);padding:5px 12px;border-radius:20px;flex-shrink:0}
  .verified-badge svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2}
  .subtitle{font-size:14px;color:var(--text-3);margin-bottom:22px}

  .facts{display:flex;gap:22px;flex-wrap:wrap;padding:18px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin-bottom:24px}
  .fact{font-size:13.5px;color:var(--text-2)}
  .fact strong{display:block;font-size:15px;color:var(--text);font-weight:600}

  .desc{font-size:14.5px;color:var(--text-2);margin-bottom:28px;max-width:60ch}

  .cal-section h2{font-size:18px;margin-bottom:14px}
  .cal-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
  .cal-nav button{background:white;border:1.5px solid var(--border);border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center}
  .cal-nav button:hover{border-color:var(--green);color:var(--green)}
  .cal-nav button svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2}
  .cal-nav span{font-size:14px;font-weight:600}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
  .cal-dow{font-size:10.5px;font-weight:700;color:var(--text-3);text-align:center;padding:4px 0;text-transform:uppercase}
  .cal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:12.5px;border-radius:8px;color:var(--text-2)}
  .cal-day.blank{visibility:hidden}
  .cal-day.past{color:var(--text-3);opacity:.35}
  .cal-day.booked{background:var(--red-light);color:var(--red);text-decoration:line-through}
  .cal-day.open{background:var(--green-light);color:var(--green-dark);font-weight:600}
  .cal-legend{display:flex;gap:16px;margin-top:12px;font-size:12px;color:var(--text-3)}
  .cal-legend span{display:inline-flex;align-items:center;gap:6px}
  .dot{width:9px;height:9px;border-radius:3px;display:inline-block}

  /* ── Booking widget ────────────────────────────────────── */
  .widget{position:sticky;top:84px;background:white;border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow);padding:22px}
  .widget-price{font-size:22px;font-weight:700;color:var(--green-dark);margin-bottom:16px}
  .widget-price span{font-size:13px;font-weight:500;color:var(--text-3)}
  .widget-dates{display:grid;grid-template-columns:1fr 1fr;border:1.5px solid var(--border);border-radius:8px;overflow:hidden;margin-bottom:12px}
  .widget-dates .f{padding:9px 12px;border-right:1px solid var(--border)}
  .widget-dates .f:last-child{border-right:none}
  .widget-dates label{display:block;font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--text-3);margin-bottom:3px}
  .widget-dates input{border:none;outline:none;font-size:13px;width:100%;font-family:inherit;color:var(--text)}
  .field-block{margin-bottom:14px}
  .field-block label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--text-3);margin-bottom:6px}
  .field-block select{width:100%;padding:10px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:13.5px;outline:none;font-family:inherit}
  .price-breakdown{margin:16px 0;padding-top:14px;border-top:1px solid var(--border);font-size:13.5px}
  .price-breakdown div{display:flex;justify-content:space-between;padding:5px 0;color:var(--text-2)}
  .price-breakdown .total{font-weight:700;color:var(--text);border-top:1px solid var(--border);margin-top:6px;padding-top:10px}
  .widget-note{font-size:11.5px;color:var(--text-3);text-align:center;margin-top:10px}
  .widget-error{font-size:12.5px;color:var(--red);background:var(--red-light);border-radius:8px;padding:9px 11px;margin-bottom:12px;display:none}

  .state{text-align:center;padding:80px 20px;color:var(--text-3)}
  footer{background:var(--green-dark);color:rgba(255,255,255,0.7);padding:32px 28px;text-align:center;font-size:12.5px;margin-top:40px}
  footer a{color:rgba(255,255,255,0.9);font-weight:600}
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <div class="brand-mark"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg></div>
      <div class="brand-name">Nyumba254</div>
    </div>
    <a href="index.html" class="back-link"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>Back to search</a>
  </div>
</div>

<div class="wrap" id="page-content">
  <div class="state" id="loading-state">Loading stay…</div>
</div>

<footer><p>Nyumba254 — book direct, no agent fees. <a href="index.html">Browse more stays</a></p></footer>

<script>
const SUPABASE_URL='https://vliuuloyfhyxcsuchpss.supabase.co';
const SUPABASE_KEY='sb_publishable_oIIcecf3wzKMual5K24Z8Q_zmxVfgsx';
const { createClient } = supabase;
const db = createClient(SUPABASE_URL, SUPABASE_KEY);

const params=new URLSearchParams(location.search);
const propertyId=params.get('id');
let property=null, bookedRanges=[], calMonth=new Date();
calMonth.setDate(1);

function escHtml(s){ if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function fmtDate(d){ return d.toISOString().slice(0,10); }
function nightsBetween(a,b){ return Math.max(0,Math.round((new Date(b)-new Date(a))/86400000)); }

function isDateBooked(dateStr){
  return bookedRanges.some(r=>dateStr>=r.check_in && dateStr<r.check_out);
}
function rangeOverlapsBooked(ci,co){
  return bookedRanges.some(r=> ci < r.check_out && co > r.check_in);
}

async function loadProperty(){
  if(!propertyId){ renderNotFound(); return; }
  try{
    const{data,error}=await db.from('bnb_properties')
      .select('id,property_label,nightly_rate,weekend_rate,cleaning_fee,notes,max_guests,min_stay_nights,is_publicly_bookable,listing_id,listings(area,address,description,listing_photos(url,is_cover))')
      .eq('id',propertyId).maybeSingle();
    if(error||!data||!data.is_publicly_bookable){ renderNotFound(); return; }
    property=data;

    let avail=await db.from('public_bnb_availability').select('check_in,check_out').eq('bnb_property_id',propertyId);
    if(avail.error){
      avail=await db.from('bnb_bookings').select('check_in,check_out,status').eq('bnb_property_id',propertyId).neq('status','cancelled');
    }
    bookedRanges=(avail.data||[]).map(r=>({check_in:r.check_in,check_out:r.check_out}));

    renderPage();
  }catch(err){
    console.error('loadProperty failed:',err);
    renderNotFound();
  }
}

function renderNotFound(){
  document.getElementById('page-content').innerHTML=`<div class="state">
    <h1 style="font-size:20px;margin-bottom:8px">This stay isn't available</h1>
    <p>It may have been removed, or the host has turned off direct booking. <a href="index.html" style="color:var(--green);font-weight:600">Browse other stays →</a></p>
  </div>`;
}

function galleryHtml(photos){
  const shown=(photos&&photos.length?photos:[null,null,null]).slice(0,3);
  return shown.map(url=>url
    ? `<a href="${escHtml(url)}" target="_blank"><img src="${escHtml(url)}" alt="${escHtml(property.property_label)}"/></a>`
    : `<div class="no-photo"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>`
  ).join('');
}

function renderPage(){
  const photos=(property.listings?.listing_photos||[]).sort((a,b)=>(b.is_cover?1:0)-(a.is_cover?1:0)).map(p=>p.url);
  const area=property.listings?.area||'Kenya';
  document.getElementById('page-content').innerHTML=`
    <div class="gallery">${galleryHtml(photos)}</div>
    <div class="layout">
      <div>
        <div class="title-row">
          <h1>${escHtml(property.property_label)}</h1>
          <span class="verified-badge"><svg viewBox="0 0 24 24"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><polyline points="9 12 11 14 15 10"/></svg>Verified host</span>
        </div>
        <div class="subtitle">${escHtml(area)}${property.listings?.address?' · '+escHtml(property.listings.address):''}</div>

        <div class="facts">
          <div class="fact"><strong>${property.max_guests||'—'}</strong>guests max</div>
          <div class="fact"><strong>${property.min_stay_nights||1}</strong>night min. stay</div>
          <div class="fact"><strong>KES ${Number(property.cleaning_fee||0).toLocaleString('en-KE')}</strong>cleaning fee</div>
        </div>

        <p class="desc">${escHtml(property.notes||property.listings?.description||'Contact the host after booking for full details about this stay.')}</p>

        <div class="cal-section">
          <h2>Availability</h2>
          <div class="cal-nav">
            <button id="cal-prev" aria-label="Previous month"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></button>
            <span id="cal-label"></span>
            <button id="cal-next" aria-label="Next month"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></button>
          </div>
          <div class="cal-grid" id="cal-grid"></div>
          <div class="cal-legend">
            <span><i class="dot" style="background:var(--green-light)"></i>Open</span>
            <span><i class="dot" style="background:var(--red-light)"></i>Booked</span>
          </div>
        </div>
      </div>

      <div class="widget">
        <div class="widget-price">KES ${Number(property.nightly_rate||0).toLocaleString('en-KE')}<span> / night</span></div>
        <div class="widget-error" id="widget-error"></div>
        <div class="widget-dates">
          <div class="f"><label>Check-in</label><input type="date" id="w-checkin"/></div>
          <div class="f"><label>Check-out</label><input type="date" id="w-checkout"/></div>
        </div>
        <div class="field-block">
          <label>Guests</label>
          <select id="w-guests">${Array.from({length:property.max_guests||6},(_,i)=>i+1).map(n=>`<option value="${n}">${n} guest${n!==1?'s':''}</option>`).join('')}</select>
        </div>
        <div class="price-breakdown" id="price-breakdown" style="display:none"></div>
        <button class="btn btn-primary" id="btn-reserve">Reserve</button>
        <div class="widget-note">You won't be charged yet</div>
      </div>
    </div>
  `;
  renderCalendar();
  wireWidget();
}

function renderCalendar(){
  const label=document.getElementById('cal-label');
  const grid=document.getElementById('cal-grid');
  const y=calMonth.getFullYear(), m=calMonth.getMonth();
  label.textContent=calMonth.toLocaleDateString('en-KE',{month:'long',year:'numeric'});
  const firstDow=new Date(y,m,1).getDay();
  const daysInMonth=new Date(y,m+1,0).getDate();
  const todayStr=fmtDate(new Date());
  let html=['Su','Mo','Tu','We','Th','Fr','Sa'].map(d=>`<div class="cal-dow">${d}</div>`).join('');
  for(let i=0;i<firstDow;i++) html+=`<div class="cal-day blank"></div>`;
  for(let d=1;d<=daysInMonth;d++){
    const dateStr=fmtDate(new Date(y,m,d));
    const isPast=dateStr<todayStr;
    const booked=isDateBooked(dateStr);
    const cls=isPast?'past':(booked?'booked':'open');
    html+=`<div class="cal-day ${cls}">${d}</div>`;
  }
  grid.innerHTML=html;
  document.getElementById('cal-prev').onclick=()=>{ calMonth.setMonth(calMonth.getMonth()-1); renderCalendar(); };
  document.getElementById('cal-next').onclick=()=>{ calMonth.setMonth(calMonth.getMonth()+1); renderCalendar(); };
}

function wireWidget(){
  const ci=document.getElementById('w-checkin'), co=document.getElementById('w-checkout');
  const today=new Date(), tmrw=new Date(Date.now()+86400000);
  ci.min=fmtDate(today); co.min=fmtDate(tmrw);
  ci.addEventListener('change',()=>{
    const d=new Date(ci.value); d.setDate(d.getDate()+(property.min_stay_nights||1));
    co.min=fmtDate(d);
    if(co.value&&co.value<co.min) co.value=fmtDate(d);
    updatePricing();
  });
  co.addEventListener('change',updatePricing);
  document.getElementById('w-guests').addEventListener('change',updatePricing);
  document.getElementById('btn-reserve').addEventListener('click',handleReserve);
}

function updatePricing(){
  const ci=document.getElementById('w-checkin').value, co=document.getElementById('w-checkout').value;
  const box=document.getElementById('price-breakdown');
  const errEl=document.getElementById('widget-error');
  errEl.style.display='none';
  if(!ci||!co){ box.style.display='none'; return; }
  const nights=nightsBetween(ci,co);
  if(nights<(property.min_stay_nights||1)){
    errEl.textContent=`This stay requires a minimum of ${property.min_stay_nights||1} night(s).`;
    errEl.style.display='block';
    box.style.display='none';
    return;
  }
  if(rangeOverlapsBooked(ci,co)){
    errEl.textContent='Those dates overlap an existing booking — try different dates.';
    errEl.style.display='block';
    box.style.display='none';
    return;
  }
  const nightlyTotal=nights*Number(property.nightly_rate||0);
  const cleaning=Number(property.cleaning_fee||0);
  const total=nightlyTotal+cleaning;
  box.style.display='block';
  box.innerHTML=`
    <div><span>KES ${Number(property.nightly_rate).toLocaleString('en-KE')} × ${nights} night${nights!==1?'s':''}</span><span>KES ${nightlyTotal.toLocaleString('en-KE')}</span></div>
    ${cleaning?`<div><span>Cleaning fee</span><span>KES ${cleaning.toLocaleString('en-KE')}</span></div>`:''}
    <div class="total"><span>Total</span><span>KES ${total.toLocaleString('en-KE')}</span></div>
  `;
}

function handleReserve(){
  const ci=document.getElementById('w-checkin').value, co=document.getElementById('w-checkout').value;
  const guests=document.getElementById('w-guests').value;
  const errEl=document.getElementById('widget-error');
  if(!ci||!co){ errEl.textContent='Please choose check-in and check-out dates.'; errEl.style.display='block'; return; }
  const nights=nightsBetween(ci,co);
  if(nights<(property.min_stay_nights||1)){ errEl.textContent=`This stay requires a minimum of ${property.min_stay_nights||1} night(s).`; errEl.style.display='block'; return; }
  if(rangeOverlapsBooked(ci,co)){ errEl.textContent='Those dates overlap an existing booking — try different dates.'; errEl.style.display='block'; return; }
  errEl.style.display='none';
  const q=new URLSearchParams({property:propertyId,checkin:ci,checkout:co,guests}).toString();
  location.href=`checkout.html?${q}`;
}

loadProperty();
</script>
</body>
</html>