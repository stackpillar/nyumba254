<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Booking confirmed — Nyumba254</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet"/>
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  :root{
    --green:#0F6E56;--green-mid:#1D9E75;--green-dark:#085041;--green-light:#E1F5EE;
    --gold:#BA7517;--gold-light:#FAEEDA;
    --text:#1a1a18;--text-2:#4a4a46;--text-3:#888780;
    --border:#e0ded8;--surface:#f7f6f2;--white:#ffffff;
    --radius:10px;--radius-lg:16px;
    --shadow:0 1px 3px rgba(0,0,0,0.06),0 4px 14px rgba(0,0,0,0.05);
  }
  body{font-family:'Inter',sans-serif;color:var(--text);background:var(--surface);line-height:1.6;font-size:15px;min-height:100vh}
  a{color:inherit;text-decoration:none}
  h1,h2{font-family:'Playfair Display',serif;font-weight:700;color:var(--text)}
  button{font-family:inherit;cursor:pointer}

  .topbar{background:var(--white);border-bottom:1px solid var(--border)}
  .topbar-inner{max-width:640px;margin:0 auto;padding:16px 28px;display:flex;align-items:center}
  .brand{display:flex;align-items:center;gap:10px}
  .brand-mark{width:34px;height:34px;border-radius:8px;background:var(--green);display:flex;align-items:center;justify-content:center}
  .brand-mark svg{width:17px;height:17px;stroke:white;fill:none;stroke-width:2}
  .brand-name{font-family:'Playfair Display',serif;font-size:18px;font-weight:700}

  .wrap{max-width:560px;margin:0 auto;padding:56px 28px 60px;text-align:center}
  .check-badge{width:64px;height:64px;border-radius:50%;background:var(--green-light);display:flex;align-items:center;justify-content:center;margin:0 auto 22px}
  .check-badge svg{width:30px;height:30px;stroke:var(--green-dark);fill:none;stroke-width:2.2}
  h1{font-size:26px;margin-bottom:10px}
  .sub{font-size:14.5px;color:var(--text-2);margin-bottom:30px;max-width:42ch;margin-left:auto;margin-right:auto}

  .ref-card{background:white;border:1px solid var(--border);border-radius:var(--radius-lg);padding:22px;margin-bottom:24px;text-align:left}
  .ref-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--text-3);margin-bottom:6px}
  .ref-value{font-size:22px;font-weight:700;color:var(--green-dark);font-family:'Inter',monospace;letter-spacing:.02em;margin-bottom:16px}
  .status-row{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-2);padding-top:14px;border-top:1px solid var(--border)}
  .status-dot{width:8px;height:8px;border-radius:50%;background:var(--gold);flex-shrink:0}

  .steps{text-align:left;background:white;border:1px solid var(--border);border-radius:var(--radius-lg);padding:22px;margin-bottom:26px}
  .steps h2{font-size:15px;margin-bottom:14px}
  .step{display:flex;gap:12px;margin-bottom:14px}
  .step:last-child{margin-bottom:0}
  .step-num{width:22px;height:22px;border-radius:50%;background:var(--green-light);color:var(--green-dark);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .step p{font-size:13.5px;color:var(--text-2)}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:var(--radius);font-weight:600;font-size:14px;padding:13px 22px;width:100%;transition:all .15s}
  .btn-primary{background:var(--green);color:white;margin-bottom:10px}
  .btn-primary:hover{background:var(--green-dark)}
  .btn-outline{background:white;color:var(--text-2);border:1.5px solid var(--border)}
  .btn-outline:hover{border-color:var(--green);color:var(--green)}

  .state{padding:80px 20px;color:var(--text-3)}
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <div class="brand-mark"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg></div>
      <div class="brand-name">Nyumba254</div>
    </div>
  </div>
</div>

<div class="wrap" id="page-content"></div>

<script>
const params=new URLSearchParams(location.search);
const ref=params.get('ref');

function escHtml(s){ if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function render(){
  const el=document.getElementById('page-content');
  if(!ref){
    el.innerHTML=`<div class="state">
      <h1 style="font-size:20px;margin-bottom:8px">No booking reference found</h1>
      <p>If you just completed checkout, check your email for confirmation — or <a href="my-bookings.html" style="color:var(--green);font-weight:600">look up your booking</a>.</p>
    </div>`;
    return;
  }
  el.innerHTML=`
    <div class="check-badge"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
    <h1>Booking request sent</h1>
    <p class="sub">Your host has been notified and is verifying your M-Pesa payment. You'll get a confirmation the moment it clears.</p>

    <div class="ref-card">
      <div class="ref-label">Booking reference</div>
      <div class="ref-value">${escHtml(ref)}</div>
      <div class="status-row"><span class="status-dot"></span>Awaiting payment verification</div>
    </div>

    <div class="steps">
      <h2>What happens next</h2>
      <div class="step"><div class="step-num">1</div><p>Your host verifies your M-Pesa payment — usually within a few hours.</p></div>
      <div class="step"><div class="step-num">2</div><p>You'll get an email confirming your stay, with check-in details from your host.</p></div>
      <div class="step"><div class="step-num">3</div><p>Save your reference above — you'll need it to look up or manage this booking.</p></div>
    </div>

    <a href="my-bookings.html" class="btn btn-primary">Find this booking later</a>
    <a href="index.html" class="btn btn-outline">Browse more stays</a>
  `;
}
render();
</script>
</body>
</html>