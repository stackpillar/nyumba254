<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Reset your password — Nyumba254</title>
</head>
<body style="margin:0;padding:0;background-color:#f7f6f2;font-family:'Helvetica Neue',Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f7f6f2;padding:32px 16px;">
  <tr>
    <td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;background-color:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e0ded8;">

        <!-- Header -->
        <tr>
          <td style="background-color:#085041;padding:32px 32px 28px;text-align:center;">
            <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 12px;">
              <tr>
                <td style="width:40px;height:40px;background-color:#0F6E56;border-radius:9px;text-align:center;vertical-align:middle;">
                  <span style="color:#ffffff;font-size:18px;line-height:40px;">🏠</span>
                </td>
              </tr>
            </table>
            <span style="font-family:Georgia,'Times New Roman',serif;font-size:20px;color:#ffffff;font-weight:700;letter-spacing:.2px;">Nyumba254</span>
          </td>
        </tr>

        <!-- Body -->
        <tr>
          <td style="padding:40px 36px 8px;">
            <h1 style="margin:0 0 12px;font-family:Georgia,'Times New Roman',serif;font-size:24px;color:#1a1a18;font-weight:700;line-height:1.3;">
              Reset your password
            </h1>
            <p style="margin:0 0 28px;font-size:15px;line-height:1.65;color:#4a4a46;">
              We received a request to reset the password for your Nyumba254 seller account. Click the button below to choose a new password. This link is valid for 1 hour.
            </p>
          </td>
        </tr>

        <!-- CTA button -->
        <tr>
          <td style="padding:0 36px 40px;text-align:center;">
            <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto;">
              <tr>
                <td style="border-radius:10px;background-color:#0F6E56;">
                  <a href="{{ .ConfirmationURL }}" target="_blank"
                     style="display:inline-block;padding:14px 36px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:10px;">
                    Reset password
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Divider -->
        <tr>
          <td style="padding:0 36px;">
            <div style="height:1px;background-color:#e0ded8;"></div>
          </td>
        </tr>

        <!-- Security note -->
        <tr>
          <td style="padding:24px 36px 36px;">
            <p style="margin:0;font-size:12px;line-height:1.7;color:#888780;">
              If you didn't request a password reset, you can safely ignore this email — your password will not be changed. This link will expire in 1 hour for your security.
            </p>
          </td>
        </tr>

      </table>

      <!-- Footer -->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;margin-top:24px;">
        <tr>
          <td style="text-align:center;padding:0 16px;">
            <p style="margin:0 0 4px;font-size:12px;color:#888780;">
              Nyumba254 · Kisumu · Nairobi · Mombasa
            </p>
            <p style="margin:0;font-size:11px;color:#aaa8a0;">
              No agents. No commission. Just your listing in front of real buyers.
            </p>
          </td>
        </tr>
      </table>

    </td>
  </tr>
</table>
</body>
</html>