<script id="coming-soon-patch">
(function(){
  var SELS = ['a[href^="/plans"]','#nav-premium-upgrade','#premium-upgrade-btn','#elite-upgrade-btn','[data-act="upgrade"]'];
  var SEL = SELS.join(',');
  var st = document.createElement('style');
  st.textContent = SELS.join(',') + '{opacity:.5!important;cursor:not-allowed!important;filter:grayscale(.4)}';
  document.head.appendChild(st);
  document.addEventListener('click', function(e){
    var el = e.target.closest(SEL);
    if(!el) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    showToast("Paid plans open soon — we'll notify you here and by email.",'');
  }, true);
})();
