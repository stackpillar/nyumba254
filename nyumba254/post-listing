<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>Post a Listing — Nyumba254</title>
<meta name="robots" content="noindex,follow"/>
<meta name="theme-color" content="#0F6E56"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet"/>
<link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--green:#0F6E56;--green-light:#E1F5EE;--green-mid:#1D9E75;--green-dark:#085041;--red:#C53030;--red-light:#FFF5F5;--text:#1a1a18;--text-2:#4a4a46;--text-3:#6b6a63;--border:#e0ded8;--surface:#f7f6f2;--white:#fff;--radius:10px;--radius-lg:16px}
html{scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;color:var(--text);background:var(--surface);font-size:15px;line-height:1.6}
a{text-decoration:none;color:inherit}button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}input,select,textarea{font-family:inherit}
[hidden]{display:none!important}:focus-visible{outline:2px solid var(--green);outline-offset:2px}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
.skip-link{position:absolute;left:-9999px;top:0;background:var(--green);color:#fff;padding:10px 18px;z-index:100001}.skip-link:focus{left:0}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
nav{position:sticky;top:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 32px;height:64px;background:var(--white);border-bottom:1px solid var(--border)}
.logo{display:flex;align-items:center;gap:10px;font-family:'Playfair Display',serif;font-size:20px;color:var(--green-dark)}
.logo img{height:40px;width:40px;border-radius:22%;box-shadow:0 0 0 1px rgba(0,0,0,.08)}
.nav-right{display:flex;align-items:center;gap:8px}.nav-link{font-size:14px;color:var(--text-2);padding:8px 14px;border-radius:var(--radius);min-height:40px;display:inline-flex;align-items:center}.nav-link:hover{background:var(--surface)}
.page-wrap{max-width:860px;margin:0 auto;padding:36px 24px 60px}
.kicker{text-align:center;font-size:11.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--green-dark);margin-bottom:8px}
.page-title{text-align:center;font-family:'Playfair Display',serif;font-size:30px;margin-bottom:6px}
.page-sub{text-align:center;font-size:13.5px;color:var(--text-3);margin-bottom:22px}
.badge-strip{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:12px}
.badge-pill{font-size:12px;font-weight:600;color:var(--text-2);background:#fff;border:1px solid var(--border);padding:6px 13px;border-radius:20px}
.save-status{text-align:center;font-size:11.5px;color:var(--text-3);margin-bottom:14px;min-height:18px}
.steps-bar{display:flex;background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px 24px 14px}
.step-item{display:flex;flex-direction:column;align-items:center;gap:8px;flex:1}
.step-dot{width:44px;height:44px;border-radius:50%;background:var(--surface);display:flex;align-items:center;justify-content:center;transition:all .25s}
.step-dot svg{width:19px;height:19px;stroke:var(--text-3);fill:none;stroke-width:2}
.step-dot.active{background:var(--green-dark)}.step-dot.active svg{stroke:#fff}.step-dot.done{background:var(--green-light)}.step-dot.done svg{stroke:var(--green)}
.step-label{font-size:12.5px;color:var(--text-3);font-weight:500}.step-label.active{color:var(--green-dark);font-weight:700}.step-label.done{color:var(--green);font-weight:600}
.track{height:4px;background:var(--border);border-radius:3px;margin:14px 0 20px;overflow:hidden}.track div{height:100%;background:var(--green);transition:width .3s}
.form-card{background:#fff;border-radius:var(--radius-lg);border:1px solid var(--border);padding:30px;margin-bottom:18px}
.form-card h2{font-size:18px;font-weight:600;margin-bottom:6px}.form-card h2 .opt{font-size:12px;font-weight:400;color:var(--text-3)}
.hint{font-size:13px;color:var(--text-3);margin-bottom:22px}
.field{margin-bottom:18px}.field:last-child{margin-bottom:0}
.field label{display:block;font-size:13px;font-weight:600;color:var(--text-2);margin-bottom:6px}.field label .req{color:var(--red)}.field label .opt{font-size:11.5px;font-weight:400;color:var(--text-3)}
.field input,.field select,.field textarea{width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:var(--radius);font-size:14px;background:var(--surface);outline:none;transition:border-color .15s}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--green);background:#fff}
.field [aria-invalid="true"]{border-color:var(--red);background:var(--red-light)}
.field textarea{resize:vertical;min-height:100px;line-height:1.6}.field select:disabled{opacity:.6}
.field-hint{font-size:12px;color:var(--text-3);margin-top:5px}.field-error{font-size:12px;color:var(--red);margin-top:5px}.field-error:empty{display:none}
.row{display:flex;justify-content:space-between;gap:8px;align-items:center}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
.linkbtn{font-size:12.5px;font-weight:600;color:var(--green);min-height:32px;padding:0 2px}.linkbtn:hover{text-decoration:underline}
.cat-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.cat-option{border:2px solid var(--border);border-radius:var(--radius-lg);padding:18px 14px;cursor:pointer;background:#fff;position:relative;text-align:left;width:100%}
.cat-option:hover{border-color:var(--green-mid)}.cat-option[aria-checked="true"]{border-color:var(--green);background:var(--green-light)}
.cat-option .tick{position:absolute;top:10px;right:10px;width:22px;height:22px;border-radius:50%;background:var(--green);color:#fff;display:none;align-items:center;justify-content:center;font-size:12px}.cat-option[aria-checked="true"] .tick{display:flex}
.cat-ico{width:38px;height:38px;border-radius:9px;background:var(--surface);display:flex;align-items:center;justify-content:center;margin-bottom:10px}.cat-ico svg{width:18px;height:18px;stroke:var(--text-2);fill:none;stroke-width:1.8}
.cat-option[aria-checked="true"] .cat-ico svg{stroke:var(--green)}
.cat-title{font-size:14.5px;font-weight:700}.cat-desc{font-size:12px;color:var(--text-3);line-height:1.4}
.map-frame{border-radius:var(--radius-lg);overflow:hidden;border:1.5px solid var(--border);margin-top:10px}#location-map{height:280px;background:var(--surface)}
.map-tools{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btn-alt{padding:12px;border-radius:var(--radius);font-size:14px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;border:1.5px solid var(--border);background:#fff;color:var(--text-2)}
.btn-alt:hover{border-color:var(--green);color:var(--green-dark);background:var(--green-light)}.btn-alt.dark{background:var(--green-dark);color:#fff;border-color:var(--green-dark)}.btn-alt.dark:hover{background:var(--green)}
.pin-status{font-size:12.5px;margin-top:8px;color:var(--text-3)}.pin-status.ok{color:var(--green-dark);font-weight:600}
.photo-drop{border:2px dashed var(--border);border-radius:var(--radius-lg);padding:32px 24px;text-align:center;cursor:pointer;background:var(--surface);display:block}
.photo-drop:hover,.photo-drop.drag{border-color:var(--green);background:var(--green-light)}.photo-drop p{font-size:14px;margin-bottom:4px}.photo-drop span{font-size:12px;color:var(--text-3)}
.photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px;margin-top:16px}
.thumb{position:relative;aspect-ratio:1;border-radius:8px;overflow:hidden;border:1.5px solid var(--border)}.thumb img{width:100%;height:100%;object-fit:cover}
.thumb .rm{position:absolute;top:4px;right:4px;width:28px;height:28px;background:rgba(0,0,0,.65);color:#fff;border-radius:50%;font-size:16px}
.thumb .cv{position:absolute;bottom:4px;left:4px;background:rgba(0,0,0,.6);color:#fff;font-size:11px;padding:3px 8px;border-radius:4px}.thumb .cv.on{background:var(--green)}
.thumb.bad{border-color:var(--red)}.thumb .fail{position:absolute;inset:0;background:rgba(197,48,48,.75);color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center;text-align:center;padding:4px}
.prog{margin-top:10px;height:4px;background:var(--border);border-radius:2px;overflow:hidden}.prog div{height:100%;background:var(--green);width:0;transition:width .3s}
.notice{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px 14px;font-size:12.5px;color:var(--text-2);line-height:1.6;margin-top:14px}
.amenity-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.amenity-chip{display:flex;align-items:center;gap:8px;padding:11px 12px;border:1.5px solid var(--border);border-radius:var(--radius);cursor:pointer;font-size:13.5px;color:var(--text-2);background:var(--surface);min-height:44px}
.amenity-chip.checked{border-color:var(--green);background:var(--green-light);color:var(--green-dark);font-weight:600}.amenity-chip input{width:16px;height:16px;accent-color:var(--green)}
.amenity-chip .x{margin-left:auto;font-weight:700;color:var(--text-3);min-width:28px;min-height:28px}
.tier-row{border:1.5px solid var(--border);border-radius:var(--radius-lg);padding:16px;margin-bottom:12px;background:var(--surface)}
.tier-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-size:13px;font-weight:700;color:var(--green-dark)}
.tier-rm{width:30px;height:30px;border-radius:50%;background:#fff;border:1.5px solid var(--border);font-size:15px}.tier-rm:hover{border-color:var(--red);color:var(--red)}
.tier-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:10px}
.tier-row label{display:block;font-size:11.5px;font-weight:600;color:var(--text-2);margin-bottom:5px}
.tier-row input,.tier-row select{width:100%;padding:9px 11px;border:1.5px solid var(--border);border-radius:var(--radius);font-size:13px;background:#fff;outline:none}
.btn-add{width:100%;padding:12px;border-radius:var(--radius);border:1.5px dashed var(--green);background:var(--green-light);color:var(--green-dark);font-size:14px;font-weight:600;min-height:44px}
.form-actions{display:flex;gap:12px;justify-content:space-between;align-items:center;margin-top:22px}
.btn-back{padding:11px 22px;border-radius:var(--radius);border:1.5px solid var(--border);background:#fff;font-size:14px;font-weight:500;color:var(--text-2);min-height:44px}
.btn-next,.btn-submit{padding:11px 28px;border-radius:var(--radius);background:var(--green);color:#fff;font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px;min-height:44px}
.btn-next:hover,.btn-submit:hover{background:var(--green-dark)}.btn-submit{font-size:15px;padding:13px 30px}.btn-next:disabled,.btn-submit:disabled{opacity:.6;cursor:not-allowed}
.review-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--green-dark);margin:18px 0 6px;display:flex;justify-content:space-between;align-items:center}.review-title:first-child{margin-top:0}
.sum{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid var(--border);font-size:14px}.sum span:first-child{color:var(--text-2);flex-shrink:0}.sum strong{text-align:right;overflow-wrap:anywhere}
.rev-photos{display:flex;gap:8px;overflow-x:auto;padding:6px 0}.rev-photos img{width:64px;height:64px;object-fit:cover;border-radius:8px;flex-shrink:0}
.box{border-radius:var(--radius);padding:14px 16px;font-size:13px;line-height:1.6;margin-bottom:16px;background:var(--surface);border:1px solid var(--border);color:var(--text-2)}.box.ok{background:var(--green-light);border-color:var(--green-mid);color:var(--green-dark)}
.success-screen{text-align:center;padding:50px 24px}
.success-icon{width:72px;height:72px;background:var(--green-light);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 22px}.success-icon svg{width:36px;height:36px;stroke:var(--green);fill:none;stroke-width:2.5}
.success-screen h2{font-family:'Playfair Display',serif;font-size:28px;margin-bottom:10px}.success-screen>p{font-size:15px;color:var(--text-2);max-width:460px;margin:0 auto 20px}
.next-list{text-align:left;max-width:440px;margin:0 auto 24px;font-size:14px;color:var(--text-2)}.next-list li{margin:0 0 8px 18px}
.success-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}.success-actions a,.success-actions button{padding:11px 22px;border-radius:var(--radius);font-size:14px;font-weight:600;border:1.5px solid var(--border);min-height:44px;display:inline-flex;align-items:center}.success-actions .p{background:var(--green);color:#fff;border-color:var(--green)}
.toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,80px);z-index:9999;background:var(--text);color:#fff;padding:12px 20px;border-radius:var(--radius);font-size:14px;opacity:0;transition:all .3s;max-width:min(92vw,380px);text-align:center;pointer-events:none}
.toast.show{transform:translate(-50%,0);opacity:1}.toast.error{background:var(--red)}.toast.success{background:var(--green-dark)}
.overlay{position:fixed;inset:0;background:rgba(15,15,12,.6);display:none;align-items:center;justify-content:center;z-index:1000;padding:20px}.overlay.show{display:flex}
.modal{background:#fff;border-radius:var(--radius-lg);max-width:420px;width:100%;padding:28px;text-align:center}.modal h2{margin-bottom:8px}.modal p{font-size:13px;color:var(--text-3);margin-bottom:18px}.modal .acts{display:flex;gap:10px}.modal .acts button{flex:1;justify-content:center}
@media(max-width:768px){nav{padding:0 16px}.page-wrap{padding:22px 16px 40px}.form-card{padding:20px 16px}.grid-2,.grid-3{grid-template-columns:1fr}.cat-grid{grid-template-columns:1fr 1fr}.steps-bar{padding:14px 8px 10px}.step-label{display:none}.tier-grid{grid-template-columns:1fr 1fr}
.field input,.field select,.field textarea,.tier-row input,.tier-row select{font-size:16px}
.form-actions{position:sticky;bottom:0;background:var(--surface);padding:12px 0 calc(12px + env(safe-area-inset-bottom,0px));margin:16px 0 0;z-index:20;border-top:1px solid var(--border)}.toast{bottom:90px}}
@media(max-width:480px){.cat-grid{grid-template-columns:1fr}}
</style>
