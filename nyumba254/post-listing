<script>
(function(){'use strict';
const $=id=>document.getElementById(id),qsa=(s,r)=>[...(r||document).querySelectorAll(s)];
const esc=escHtml,val=id=>{const e=$(id);return e?e.value.trim():''},chk=id=>!!($(id)&&$(id).checked);
const money=n=>'KES '+Number(n||0).toLocaleString('en-KE');
const uuid=()=>crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random().toString(36).slice(2);

/* ═══ CONFIG ═══ */
const STEPS=[['Type','<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>'],['Basics','<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>'],['Details','<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>'],['Photos','<path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/>'],['Contact','<path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/>']];
const CAT_INFO={apartment:['Flats, units and compounds','<rect x="4" y="3" width="16" height="18" rx="1"/><line x1="9" y1="17" x2="15" y2="17"/><line x1="9" y1="7" x2="9" y2="7.01"/><line x1="15" y1="7" x2="15" y2="7.01"/>'],house:['Standalone homes and yards','<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>'],boarding:['Student rooms and bed spaces','<rect x="2" y="7" width="20" height="13" rx="1"/><path d="M2 11h20M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/>'],airbnb:['Short stays and furnished rentals','<polygon points="12 2 15 8.3 22 9.3 17 14.1 18.2 21 12 17.8 5.8 21 7 14.1 2 9.3 9 8.3 12 2"/>'],commercial:['Retail shops, offices and business spaces','<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>']};
const FREQS={standard:[['month','Per month'],['once','One-time (for sale)']],boarding:[['month','Per month'],['term','Per term'],['semester','Per semester']],airbnb:[['night','Per night'],['week','Per week']]};
const PRICE_HINT={standard:'Digits only. Choose the payment frequency alongside it.',airbnb:'The nightly or weekly rate shown to guests.',commercial:'Monthly lease rate, or the asking price if for sale.'};
const LABEL={furnished:{yes:'Fully furnished',partial:'Partly furnished',no:'Unfurnished'},parking:{private:'Private',shared:'Shared compound',street:'Street only',none:'None'},security:{gated_guard_cctv:'Gated, guarded and CCTV',gated_guard:'Gated with guard',gated_cctv:'Gated with CCTV',gated:'Gated, no guard',cctv:'CCTV only',none:'None'}};
const FREQ_SUFFIX={month:'/month',once:'',night:'/night',term:'/term',semester:'/semester',week:'/week'};
const FIELD_IDS=['title','description','county','area','area_custom','address','price','price_frequency','comm_lease_type','deposit','available_from','listed_by','std_bathrooms','std_bedrooms','std_size','std_furnished','std_parking','std_security','board_gender','board_institution','air_guests','air_bedrooms','air_bathrooms','air_min_stay','air_checkin','air_rules','std_rules','comm_type','comm_size','comm_parking','comm_condition','comm_units','comm_frontage','video_url','contact_name','phone','whatsapp','contact_email'];
const PS={sale_standard_pct:.1,rent_standard_pct:3,standard_min_fee:500,standard_max_fee:18000,standard_fee_per_unit:50,trial_days:14,bnb_basic_price:700,enforce_verification_general:0,unverified_listing_limit:2};
const DRAFT_KEY='nk_post_listing_draft_v3';

/* ═══ STATE ═══ */
const S={step:1,max:1,cat:'apartment',amen:new Set(),custom:[],tiers:[],seq:0,pin:null,photos:[],cover:0,video:null,user:null,userName:'',first:true,cov:{rental:false,bnb:false},ready:false,busy:false,guestBlocked:false,
  sub:{listingId:null,urls:{},unitsDone:false,photosDone:false,videoLinked:false}};
const group=()=>(NK_CATEGORIES[S.cat]||{}).group;
let toastT;function toast(m,k){const t=$('toast');t.textContent=m;t.className='toast show '+(k||'');clearTimeout(toastT);toastT=setTimeout(()=>t.className='toast',4200)}

/* ═══ FIELD HELPERS ═══ */
function fail(id,msg){const e=$('e-'+id),i=$(id);if(e)e.textContent=msg||'';if(i)i.setAttribute('aria-invalid',msg?'true':'false');return !msg}
function clearErrors(root){qsa('.field-error',root).forEach(e=>{if(e.id.startsWith('e-'))e.textContent=''});qsa('[aria-invalid]',root).forEach(i=>i.setAttribute('aria-invalid','false'))}
const digits=v=>String(v||'').replace(/\D/g,'');
const priceVal=()=>parseInt(digits($('price').value),10)||0;
function fmtPrice(el){const d=digits(el.value);const fromEnd=el.value.length-(el.selectionEnd??el.value.length);el.value=d?Number(d).toLocaleString('en-KE'):'';const p=Math.max(0,el.value.length-fromEnd);try{el.setSelectionRange(p,p)}catch(e){}}
const freq=()=>group()==='commercial'?(val('comm_lease_type')==='sale'?'once':'month'):val('price_frequency');

/* ═══ STEP BAR + NAVIGATION ═══ */
function renderBar(){
  $('steps-bar').innerHTML=STEPS.map(([n,ic],i)=>{const k=i+1,cls=k<S.step?'done':k===S.step?'active':'';const can=k<=S.max&&k!==S.step;
    return `<div class="step-item" role="listitem"><button type="button" class="step-dot ${cls}" ${can?`data-act="go" data-n="${k}"`:'disabled'} aria-label="Step ${k}: ${n}${k<S.step?' (completed)':''}" ${k===S.step?'aria-current="step"':''}><svg viewBox="0 0 24 24" aria-hidden="true">${ic}</svg></button><div class="step-label ${cls}">${n}</div></div>`}).join('');
  $('track').style.width=(S.step/5*100)+'%';$('step-count').textContent=`Step ${S.step} of 5 · ${STEPS[S.step-1][0]}`;
  $('btn-back').hidden=S.step===1;$('btn-next').hidden=S.step===5;$('btn-submit').hidden=S.step!==5;
}
function show(n,push){
  qsa('#flow section').forEach(s=>s.hidden=s.id!=='step-'+n);S.step=n;S.max=Math.max(S.max,n);renderBar();
  if(n===5)renderReview();
  if(map)setTimeout(()=>{map.invalidateSize();if(n===2)followAddress()},150);
  window.scrollTo({top:0,behavior:'smooth'});const h=$('h-'+n);if(h)h.focus({preventScroll:true});
  if(push)history.pushState({step:n},'');
  saveDraftNow();
}
function go(n){
  if(n<S.step)return show(n,true);
  if(n===S.step+1){if(!validate(S.step))return;return show(n,true)}
}
