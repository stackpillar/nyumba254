<body>
<a href="#main" class="skip-link">Skip to form</a>
<nav aria-label="Main">
  <a href="/" class="logo"><img src="/logo-icon.png" alt="" width="40" height="40"/>Nyumba254</a>
  <div class="nav-right"><a href="https://wa.me/254739348560" target="_blank" rel="noopener" class="nav-link">Need help?</a><a href="/listings" class="nav-link">Browse listings</a></div>
</nav>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<main class="page-wrap" id="main">
  <div class="kicker" id="page-kicker">Getting started takes just a few minutes</div>
  <h1 class="page-title">List your property</h1>
  <p class="page-sub">Reviewed by our team before going live, with buyer enquiries handled right here on Nyumba254.</p>
  <div class="badge-strip"><span class="badge-pill">Reviewed before going live</span><span class="badge-pill">Photos required</span><span class="badge-pill">Draft auto-saves</span></div>
  <div class="save-status" id="save-status" aria-live="polite"></div>

  <div id="flow">
  <div class="steps-bar" id="steps-bar" role="list" aria-label="Progress"></div>
  <div class="track"><div id="track"></div></div>
  <div id="plan-banner" hidden></div>

  <!-- 1 TYPE -->
  <section id="step-1" aria-labelledby="h-1">
    <div class="form-card">
      <h2 id="h-1" tabindex="-1">What type of property are you listing?</h2>
      <p class="hint">Choose the closest match so the next steps ask for the right details.</p>
      <div class="cat-grid" role="radiogroup" aria-label="Property type" id="cat-grid"></div>
    </div>
  </section>

  <!-- 2 BASICS -->
  <section id="step-2" hidden aria-labelledby="h-2">
    <div class="form-card">
      <h2 id="h-2" tabindex="-1">General information</h2>
      <p class="hint">The core details buyers use to decide whether the property fits.</p>
      <div class="field"><div class="row"><label for="title">Property title <span class="req">*</span></label><button type="button" class="linkbtn" id="ai-title-btn" data-act="ai-title">✨ Enhance</button></div>
        <input id="title" maxlength="120" placeholder="e.g. 2 bedroom apartment in Kilimani" autocomplete="off"/><div class="field-hint">Specific titles get more enquiries. Enhance with AI polishes yours using the details you entered.</div><div class="field-hint" id="ai-note-title"></div><div class="field-error" id="e-title" role="alert"></div></div>
      <div class="field"><div class="row"><label for="description">Description <span class="req">*</span></label><button type="button" class="linkbtn" id="ai-desc-btn" data-act="ai-desc">✨ Enhance</button></div>
        <textarea id="description" rows="5" maxlength="2000" placeholder="Room sizes, security, water and power, house rules, nearby landmarks…"></textarea>
        <div class="row"><div class="field-hint">Don't add phone numbers or links; contact details come in the last step.</div><div class="field-hint" id="desc-count">0 / 30 minimum</div></div><div class="field-hint" id="ai-note-description"></div><div class="field-error" id="e-description" role="alert"></div></div>
      <div class="grid-2">
        <div class="field"><div class="row"><label for="county">County <span class="req">*</span></label><button type="button" class="linkbtn" data-act="locate">Use my location</button></div><select id="county"></select><div class="field-error" id="e-county" role="alert"></div></div>
        <div class="field"><label for="area">Area <span class="req">*</span></label><select id="area" disabled></select><div class="field-error" id="e-area" role="alert"></div></div>
      </div>
      <div class="field" id="area-custom-f" hidden><label for="area_custom">Type your area <span class="req">*</span></label><input id="area_custom" placeholder="e.g. Nyahera" maxlength="60"/><div class="field-error" id="e-area_custom" role="alert"></div></div>
      <div class="field"><label for="address">Address or landmark <span class="req">*</span></label><input id="address" placeholder="e.g. Ngong Road, off Argwings Kodhek Road" maxlength="140"/><div class="field-hint">This appears on your listing card and page, so use a street or landmark rather than a house number.</div><div class="field-error" id="e-address" role="alert"></div></div>
      <div class="field">
        <label>Exact pin <span class="opt">optional</span></label>
        <div class="field-hint" style="margin:-2px 0 8px">The map moves to your area as you fill in the address. Add an exact pin if you want buyers to find the property more easily. An exact pin is visible to everyone.</div>
        <div class="map-tools"><button type="button" class="btn-alt dark" data-act="drop-pin">Pin exact location here</button><button type="button" class="btn-alt" data-act="gps">Use my GPS (be at the property)</button></div>
        <div class="map-frame"><div id="location-map" role="application" aria-label="Map"></div></div>
        <div class="pin-status" id="pin-status"></div><div id="pin-warn" role="note" hidden style="margin-top:10px;padding:11px 13px;border-radius:10px;background:#FFF7E6;border:1px solid #F3D9A0;color:#7a4f00;font-size:12.5px;line-height:1.55"><strong>Check your pin.</strong> It marks the spot on the map and buyers will see it on your listing. If you are not at the property right now, drag the pin to the exact spot or tap "Remove pin".</div>
        <button type="button" class="linkbtn" id="clear-pin" data-act="clear-pin" hidden>Remove pin</button>
      </div>
      <div class="grid-2" id="price-row">
        <div class="field" id="price-f"><label for="price" id="price-label">Price (KES) <span class="req">*</span></label><input id="price" inputmode="numeric" autocomplete="off" placeholder="e.g. 25,000"/><div class="field-hint" id="price-hint"></div><div class="field-error" id="e-price" role="alert"></div></div>
        <div class="field" id="freq-f"><label for="price_frequency">Payment frequency <span class="req">*</span></label><select id="price_frequency"></select></div>
        <div class="field" id="lease-f" hidden><label for="comm_lease_type">Lease or sale <span class="req">*</span></label><select id="comm_lease_type"><option value="lease">Lease (monthly rent)</option><option value="sale">For sale</option></select></div>
      </div>
      <div class="grid-3">
        <div class="field" id="deposit-f"><label for="deposit">Deposit <span class="opt">optional</span></label><select id="deposit"><option value="">Not specified</option><option value="0">No deposit</option><option value="1">1 month</option><option value="2">2 months</option><option value="3">3 months</option><option value="4">4 months</option><option value="5">5 months</option><option value="6">6 months</option></select></div>
        <div class="field"><label for="available_from">Available from <span class="opt">optional</span></label><input type="date" id="available_from"/></div>
        <div class="field"><label for="listed_by">Listed by <span class="opt">optional</span></label><select id="listed_by"><option value="">Select</option><option value="owner">Owner</option><option value="caretaker">Caretaker</option></select></div>
      </div>
    </div>
  </section>

  <!-- 3 DETAILS -->
  <section id="step-3" hidden aria-labelledby="h-3">
    <div class="form-card" data-group="standard">
      <h2 id="h-3" tabindex="-1"><span id="details-title">Property details</span></h2>
      <p class="hint">Structured details make the listing easier to review and match.</p>
      <div class="grid-2">
