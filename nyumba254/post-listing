async function processImage(file){
  let bmp;try{bmp=await createImageBitmap(file,{imageOrientation:'from-image'})}catch(e){bmp=await new Promise((ok,no)=>{const im=new Image();im.onload=()=>ok(im);im.onerror=no;im.src=URL.createObjectURL(file)})}
  const MAX=1800,r=Math.min(1,MAX/Math.max(bmp.width,bmp.height)),w=Math.round(bmp.width*r),h=Math.round(bmp.height*r);
  const c=document.createElement('canvas');c.width=w;c.height=h;const x=c.getContext('2d');x.imageSmoothingQuality='high';x.drawImage(bmp,0,0,w,h);
  const fs=Math.max(16,Math.round(w*.028));x.font=`italic 500 ${fs}px 'Playfair Display',Georgia,serif`;x.textAlign='right';x.textBaseline='bottom';x.shadowColor='rgba(0,0,0,.45)';x.shadowBlur=fs*.6;x.fillStyle='rgba(255,255,255,.55)';x.fillText('Nyumba254',w-fs*.9,h-fs*.9);
  const blob=await new Promise(res=>c.toBlob(res,'image/jpeg',.85));if(!blob)throw new Error('encode');
  return new File([blob],file.name.replace(/\.\w+$/,'')+'.jpg',{type:'image/jpeg'});
}
async function addPhotos(files){
  const list=[...files];let room=10-S.photos.length;if(room<=0)return toast('Maximum 10 photos','error');
  const prog=$('prog'),bar=$('prog-bar');prog.hidden=false;let done=0,skipped=[];
  for(const f of list.slice(0,room)){
    bar.style.width=Math.round(done/Math.min(list.length,room)*100)+'%';
    if(!/^image\/(jpeg|png|webp)$/.test(f.type)){skipped.push(f.name+' (use JPG, PNG or WebP; iPhone: Settings > Camera > Formats > Most Compatible)');done++;continue}
    if(f.size>25*1024*1024){skipped.push(f.name+' (over 25 MB)');done++;continue}
    try{const p=await processImage(f);S.photos.push({file:p,url:URL.createObjectURL(p)})}catch(e){skipped.push(f.name+' (could not be read)')}
