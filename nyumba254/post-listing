  if(t.id==='file-input'||t.id==='camera-input'){addPhotos(t.files);t.value=''}
  if(t.id==='vid-up'||t.id==='vid-rec'){pickVideo(t.files[0]);t.value=''}
  if(t.id==='contact_email')checkGuestEmail();
  saveDraft();
});
$('custom-am').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();addCustomAm()}});
/* Enter moves on only from single-line text inputs, never from buttons, selects or textareas */
document.addEventListener('keydown',e=>{
  if(e.key!=='Enter'||e.target.tagName!=='INPUT'||!/^(text|tel|email|number|url|date)$/.test(e.target.type)||S.step>=5||S.busy)return;
  if(e.target.id==='custom-am'||e.target.dataset.t)return;e.preventDefault();go(S.step+1);
});
const drop=$('drop');['dragenter','dragover'].forEach(v=>drop.addEventListener(v,e=>{e.preventDefault();drop.classList.add('drag')}));
['dragleave','drop'].forEach(v=>drop.addEventListener(v,e=>{e.preventDefault();drop.classList.remove('drag')}));drop.addEventListener('drop',e=>addPhotos(e.dataTransfer.files));
['dragover','drop'].forEach(v=>window.addEventListener(v,e=>e.preventDefault()));
window.addEventListener('beforeunload',saveDraftNow);document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden')saveDraftNow()});

/* ═══ INIT ═══ */
async function init(){
  $('available_from').min=new Date().toISOString().slice(0,10);fillCounties();fillAreas('');renderCats();renderAmenities();renderBar();initMap();applyCat();
  history.replaceState({step:1},'');
  const {data:{session}}=await db.auth.getSession();
  if(session){S.user=session.user;
    const {data:p}=await db.from('profiles').select('phone,full_name').eq('id',S.user.id).maybeSingle();
    if(p&&p.phone)$('phone').value=p.phone.startsWith('254')?'0'+p.phone.slice(3):p.phone;
    if(p&&p.full_name){$('contact_name').value=p.full_name;S.userName=p.full_name}$('contact_email').value=S.user.email||'';
    
  }else{$('guest-note').hidden=false;$('video-file-f').querySelector('label').innerHTML='Video upload <span class="opt">available after you sign in</span>';qsa('[data-act="vid-up"],[data-act="vid-rec"]').forEach(b=>b.disabled=true)}
  await loadSettings();await loadAccount();updateKicker();checkPlan();
  const gate=await checkGate();
  if(gate.blocked){toast(`Unverified sellers are limited to ${gate.limit} listing(s). Verify your account to post more.`,'error');setTimeout(()=>{location.href='/dashboard?verify=1&limit='+gate.limit},1800);return}
  await findDraft();S.ready=true;
  setTimeout(()=>{if(map)map.invalidateSize()},300);
}
init();
})();
</script>
