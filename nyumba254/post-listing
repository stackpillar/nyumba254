/* ═══ VALIDATION ═══ */
const PHONE_IN_TEXT=/(?:\+254|\b254|\b0)[\s-]?[17]\d{2}[\s-]?\d{3}[\s-]?\d{3}\b|https?:\/\/|www\./i;
function validate(step,quiet){
  let ok=true;const chkf=(id,test,msg)=>{const good=test(val(id));if(!quiet)fail(id,good?'':msg);else if(!good)ok=false;if(!good)ok=false;return good};
  if(step===2){
    chkf('title',v=>v.length>=6,'Enter a title of at least 6 characters');
    chkf('description',v=>v.length>=30&&!PHONE_IN_TEXT.test(v),val('description').length<30?'Write at least 30 characters so buyers know what to expect':'Remove the phone number or link ("'+((val('description').match(PHONE_IN_TEXT)||[''])[0].trim())+'"). Contact details are collected in the last step');
    chkf('county',v=>!!v,'Choose a county');
    chkf('area',v=>!!v,'Choose an area');
    if(val('area')==='__other__')chkf('area_custom',v=>v.length>1,'Type your area');
    chkf('address',v=>v.length>2,'Enter a street, road or landmark');
    if(group()!=='boarding')chkf('price',()=>priceVal()>0,'Enter a price');
    
  }
  if(step===3){
    const g=group(),n=id=>parseFloat(val(id))>=0&&val(id)!=='';
