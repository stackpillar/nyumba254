    .card-amenities { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; padding-top: 10px; border-top: 1px solid var(--border); }
    .card-amenity-chip { background: var(--green-light); color: var(--green-dark); border-radius: 20px; padding: 3px 9px; font-size: 11px; font-weight: 600; }
    .card-amenity-chip.more { background: var(--surface); color: var(--text-3); border: 1px solid var(--border); }
    .card-foot { display: flex; align-items: stretch; gap: 8px; margin-top: auto; padding-top: 4px; }
    .card-cta { display: flex; gap: 8px; flex: 1; min-width: 0; }
    .nk-compare-check { position: relative; z-index: 4; display: inline-flex; align-items: center; gap: 6px; min-height: 42px; padding: 0 10px; border: 1.5px solid var(--border); border-radius: var(--radius); font-size: 12.5px; font-weight: 600; color: var(--text-2); background: white; cursor: pointer; white-space: nowrap; }
    .nk-compare-check input { width: 16px; height: 16px; accent-color: var(--green); cursor: pointer; }
