  let nkRequestId = 0;

  function toggleMoreAreas() {
    const more = document.getElementById('area-checks-more');
    const btn = document.getElementById('area-more-toggle');
    const total = btn.dataset.total || '';
    const isHidden = more.style.display === 'none';
    more.style.display = isHidden ? '' : 'none';
    btn.textContent = isHidden ? 'Show fewer areas ▴' : `Show all ${total} areas ▾`;
  }

  function readUrlParams() {
    const p = new URLSearchParams(window.location.search);
    if (p.get('q')) {
      const searchEl = document.getElementById('search-q');
      searchEl.value = p.get('q');
      nkFormatSearchInput(searchEl);
    }

    let county = p.get('county') || '';
    if (!county && p.get('area')) county = NK_AREA_TO_COUNTY[p.get('area')] || '';

    if (county) {
      const sel = document.getElementById('county-select');
      sel.value = county;
      renderAreaChecklist(county);
    }

    if (p.get('area')) {
      document.querySelectorAll('#area-checks input').forEach(cb => {
        if (cb.value === p.get('area')) cb.checked = true;
      });
      if (document.querySelector(`#area-checks-more input[value="${p.get('area')}"]`)) {
        toggleMoreAreas();
      }
    }
    if (p.get('category')) {
      document.querySelectorAll('#cat-pills .filter-pill').forEach(pill => {
        pill.classList.toggle('active', pill.dataset.val === p.get('category'));
      });
      toggleGroupFilters(p.get('category'));
    }
    if (p.get('freq')) {
      document.querySelectorAll('#type-pills .filter-pill').forEach(pill => {
        pill.classList.toggle('active', pill.dataset.val === p.get('freq'));
      });
    }
    if (p.get('minPrice')) document.getElementById('price-min').value = p.get('minPrice');
    if (p.get('maxPrice')) document.getElementById('price-max').value = p.get('maxPrice');
  }

  function setPill(el, groupId) {
    document.querySelectorAll(`#${groupId} .filter-pill`).forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    if (groupId === 'cat-pills') toggleGroupFilters(el.dataset.val);
    applyFilters();
  }

  /* Bedrooms only makes sense for "standard" (apartment/house) and "airbnb"
     groups. Furnishing only applies to the "standard" group. Boarding
     houses use their own room-tier pricing instead. */
  function toggleGroupFilters(cat) {
    const meta = NK_CATEGORIES[cat];
    const group = meta ? meta.group : '';
    const bedSection = document.getElementById('bedrooms-filter-section');
    const furnSection = document.getElementById('furnished-filter-section');

    if (group === 'boarding' || group === 'commercial') {
      setPill(document.querySelector('#bed-pills .filter-pill[data-val=""]'), 'bed-pills');
      bedSection.style.display = 'none';
    } else {
      bedSection.style.display = '';
    }

    if (group === 'boarding' || group === 'airbnb' || group === 'commercial') {
      setPill(document.querySelector('#furn-pills .filter-pill[data-val=""]'), 'furn-pills');
      furnSection.style.display = 'none';
    } else {
      furnSection.style.display = '';
    }
  }

  function setPreset(min, max) {
    document.getElementById('price-min').value = min || '';
    document.getElementById('price-max').value = max || '';
    applyFilters();
  }

  function nkFormatSearchInput(el) {
    const raw = el.value;
    const stripped = raw.replace(/^KES\s?/i, '').replace(/,/g, '').trim();
    if (stripped.length && /^[0-9]+$/.test(stripped)) {
      el.value = 'KES ' + Number(stripped).toLocaleString('en-KE');
      el.dataset.priceValue = stripped;
    } else {
      delete el.dataset.priceValue;
    }
    debouncedApply();
  }

  function getFilters() {
    const freq = document.querySelector('#type-pills .filter-pill.active')?.dataset.val || '';
    const cat  = document.querySelector('#cat-pills .filter-pill.active')?.dataset.val || '';
    const beds = document.querySelector('#bed-pills .filter-pill.active')?.dataset.val || '';
    const furn = document.querySelector('#furn-pills .filter-pill.active')?.dataset.val || '';
    const county = document.getElementById('county-select')?.value || '';
    const areas = [...document.querySelectorAll('#area-checks input:checked')].map(c => c.value);
    const amenities = [...document.querySelectorAll('#amen-checks input:checked')].map(c => c.value);
    const priceMin = document.getElementById('price-min').value;
    const priceMax = document.getElementById('price-max').value;
    const searchEl = document.getElementById('search-q');
    const q = searchEl.value.trim();
    const priceExact = searchEl.dataset.priceValue ? Number(searchEl.dataset.priceValue) : null;
    const sort = document.getElementById('sort-select').value;
    return { freq, cat, beds, furn, county, areas, amenities, priceMin, priceMax, q, priceExact, sort };
  }

  function nkUpdatePageHeading(f) {
    const parts = [];
    if (f.cat && NK_CATEGORIES[f.cat]) parts.push(NK_CATEGORIES[f.cat].label + ' listings');
    if (f.county) parts.push('in ' + nkCountyLabel(f.county));
    const heading = parts.length ? parts.join(' ') : 'Browse listings';
    document.getElementById('page-title').textContent = heading;
    document.getElementById('page-desc').textContent = parts.length
      ? `${heading} — verified listings on Nyumba254`
      : 'Apartments, houses, boarding houses and Airbnb rentals across Kenya';
    document.title = parts.length ? heading + ' — Nyumba254' : 'Browse Listings — Nyumba254';
  }

  function renderActiveTags(f) {
    nkUpdatePageHeading(f);
    const tags = [];
    if (f.cat && NK_CATEGORIES[f.cat]) tags.push({ label: NK_CATEGORIES[f.cat].label, key: 'cat' });
    if (f.freq && NK_FREQ_TAG_LABEL[f.freq]) tags.push({ label: NK_FREQ_TAG_LABEL[f.freq], key: 'freq' });
    if (f.beds !== '') tags.push({ label: f.beds === '0' ? 'Studio' : `${f.beds}+ beds`, key: 'beds' });
    if (f.furn === 'true') tags.push({ label: 'Furnished', key: 'furn' });
    if (f.furn === 'false') tags.push({ label: 'Unfurnished', key: 'furn' });
    if (f.county && !f.areas.length) tags.push({ label: nkCountyLabel(f.county), key: 'county' });
    f.areas.forEach(a => tags.push({ label: a, key: 'area-' + a }));
    f.amenities.forEach(a => {
      const def = NK_AMENITIES.find(x => x.key === a);
      tags.push({ label: def ? def.label : a, key: 'amen-' + a });
    });
    if (f.priceMin || f.priceMax) {
      const label = f.priceMin && f.priceMax
        ? `KES ${Number(f.priceMin).toLocaleString()} – ${Number(f.priceMax).toLocaleString()}`
        : f.priceMin ? `From KES ${Number(f.priceMin).toLocaleString()}` : `Up to KES ${Number(f.priceMax).toLocaleString()}`;
      tags.push({ label, key: 'price' });
    }
    if (f.priceExact !== null) {
      tags.push({ label: `≈ KES ${f.priceExact.toLocaleString()}`, key: 'q' });
    } else if (f.q) {
      tags.push({ label: `"${f.q}"`, key: 'q' });
    }

    const el = document.getElementById('active-filters');
    el.innerHTML = tags.map(t => `
      <span class="filter-tag">${t.label}
        <button onclick="removeTag('${t.key}')" title="Remove filter">×</button>
      </span>`).join('');
  }

  function removeTag(key) {
    if (key === 'freq') setPill(document.querySelector('#type-pills .filter-pill[data-val=""]'), 'type-pills');
    else if (key === 'cat') setPill(document.querySelector('#cat-pills .filter-pill[data-val=""]'), 'cat-pills');
    else if (key === 'beds') setPill(document.querySelector('#bed-pills .filter-pill[data-val=""]'), 'bed-pills');
    else if (key === 'furn') setPill(document.querySelector('#furn-pills .filter-pill[data-val=""]'), 'furn-pills');
    else if (key === 'county') {
      document.getElementById('county-select').value = '';
      renderAreaChecklist('');
      applyFilters();
    }
    else if (key.startsWith('area-')) {
      const area = key.replace('area-', '');
      const cb = document.querySelector(`#area-checks input[value="${area}"]`);
      if (cb) { cb.checked = false; applyFilters(); }
    } else if (key.startsWith('amen-')) {
      const amen = key.replace('amen-', '');
      const cb = document.querySelector(`#amen-checks input[value="${amen}"]`);
      if (cb) { cb.checked = false; applyFilters(); }
    } else if (key === 'price') {
      document.getElementById('price-min').value = '';
      document.getElementById('price-max').value = '';
      applyFilters();
    } else if (key === 'q') {
      const searchEl = document.getElementById('search-q');
      searchEl.value = '';
      delete searchEl.dataset.priceValue;
      applyFilters();
    }
  }

  function resetAllFilters() {
    setPill(document.querySelector('#type-pills .filter-pill[data-val=""]'), 'type-pills');
    setPill(document.querySelector('#cat-pills .filter-pill[data-val=""]'), 'cat-pills');
    setPill(document.querySelector('#bed-pills .filter-pill[data-val=""]'), 'bed-pills');
    setPill(document.querySelector('#furn-pills .filter-pill[data-val=""]'), 'furn-pills');
    document.getElementById('county-select').value = '';
    renderAreaChecklist('');
    document.querySelectorAll('#amen-checks input:checked').forEach(cb => cb.checked = false);
    document.getElementById('price-min').value = '';
    document.getElementById('price-max').value = '';
    const searchEl = document.getElementById('search-q');
    searchEl.value = '';
    delete searchEl.dataset.priceValue;
    applyFilters();
  }

  /* ── Build and run Supabase query ── */
  async function applyFilters(page) {
    if (page) currentPage = page;
    const requestId = ++nkRequestId;
    const f = getFilters();
    renderActiveTags(f);

    const grid = document.getElementById('listings-grid');
    grid.innerHTML = Array(6).fill(`<div class="skeleton"><div class="skeleton-img"></div><div class="skeleton-body"><div class="skeleton-line xshort"></div><div class="skeleton-line"></div><div class="skeleton-line short"></div></div></div>`).join('');
    document.getElementById('result-count').textContent = 'Loading…';

    let query = db.from('listings').select('*, listing_photos(*), listing_units(*)', { count: 'exact' }).eq('status', 'active');

    if (f.freq)     query = query.eq('price_frequency', f.freq);
    if (f.cat)      query = query.eq('category', f.cat);
    if (f.beds !== '') {
      query = f.beds === '4' ? query.gte('details->>bedrooms', '4') : query.eq('details->>bedrooms', f.beds);
    }
    if (f.furn === 'true')  query = query.eq('details->>furnished', 'yes');
    if (f.furn === 'false') query = query.eq('details->>furnished', 'no');
    if (f.amenities.length) query = query.contains('amenities', f.amenities);

    if (f.areas.length) {
      query = query.in('area', f.areas);
    } else if (f.county) {
      const countyAreas = NK_AREAS_BY_COUNTY[f.county] || [];
      if (countyAreas.length) query = query.in('area', countyAreas);
    }
    if (f.priceMin) query = query.gte('price', parseFloat(f.priceMin));
    if (f.priceMax) query = query.lte('price', parseFloat(f.priceMax));

    if (f.priceExact !== null) {
      const band = Math.max(1, Math.round(f.priceExact * 0.15));
      query = query.gte('price', f.priceExact - band).lte('price', f.priceExact + band);
    } else if (f.q) {
      query = query.or(`title.ilike.%${f.q}%,description.ilike.%${f.q}%,area.ilike.%${f.q}%,address.ilike.%${f.q}%`);
    }

    if (f.sort === 'price_asc')       query = query.order('price', { ascending: true });
    else if (f.sort === 'price_desc') query = query.order('price', { ascending: false });
    else if (f.sort === 'featured')   query = query.order('is_admin_verified', { ascending: false }).order('created_at', { ascending: false });
    else                              query = query.order('created_at', { ascending: false });

    const from = (currentPage - 1) * PAGE_SIZE;
    query = query.range(from, from + PAGE_SIZE - 1);

    const { data, count, error } = await query;
    if (requestId !== nkRequestId) return;

    if (error) {
      console.error(error);
      document.getElementById('result-count').textContent = 'Something went wrong loading listings';
      document.getElementById('listings-grid').innerHTML = `<div class="empty-state">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <h3>Couldn't load listings</h3>
        <p>Please check your connection and <a onclick="applyFilters()" style="cursor:pointer">try again</a></p>
      </div>`;
      return;
    }

    totalCount = count || 0;
    renderResults(data || [], totalCount);
    renderPagination(totalCount);
  }

  /* ── Render listing cards (expanded style — carousel, status pill,
     room-type/spec chips, amenity chips, inline Send Inquiry) ── */
  const ciBedIcon  = `<svg viewBox="0 0 24 24"><path d="M2 4v16M22 4v16M2 12h20M2 8h4a2 2 0 012 2v2H2V8zM16 8h4a2 2 0 012 2v2h-6V8z"/></svg>`;
  const ciBathIcon = `<svg viewBox="0 0 24 24"><path d="M9 6l1-1a2 2 0 012.83 0l6.17 6.17a1 1 0 010 1.41L17 14M3 20h18M5 20v-4a3 3 0 013-3h1"/></svg>`;
  const ciSizeIcon = `<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="1"/></svg>`;
  const ciFurnIcon = `<svg viewBox="0 0 24 24"><rect x="2" y="8" width="20" height="10" rx="2"/><path d="M6 8V6a2 2 0 012-2h8a2 2 0 012 2v2"/><line x1="6" y1="14" x2="6" y2="18"/><line x1="18" y1="14" x2="18" y2="18"/></svg>`;
  const ciGroupIcon = `<svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`;
  const ciWalkIcon = `<svg viewBox="0 0 24 24"><circle cx="12" cy="4" r="2"/><path d="M12 6v6l-3 8M12 12l3 8M9 10l-3 2M15 10l3 2"/></svg>`;

  /* Per-listing state/lookup used by the card carousel + inquiry popup */
  const cardPhotoIndex = {};
  const cardDataById = {};
  let ciActiveListingId = null;
  let ciBuyerToken = null;

  function formatPrice(l) {
    const meta = NK_CATEGORIES[l.category] || { group: 'standard' };
    const prefix = meta.group === 'boarding' ? 'From ' : '';
    const suffix = NK_FREQ_LABEL[l.price_frequency] || '';
    const p = Number(l.price).toLocaleString('en-KE');
    return `${prefix}KES ${p}${suffix ? `<span>${suffix}</span>` : ''}`;
  }

  function buildStatusPill(l, meta) {
    if (meta.group === 'boarding') {
      const units = l.listing_units || [];
      const total = units.reduce((s,u) => s + (u.quantity_total ?? u.quantity_available ?? 0), 0);
      const available = units.reduce((s,u) => s + (u.quantity_available ?? 0), 0);
      if (total > 0) {
        if (available <= 0) return `<span class="card-status-pill low">Full</span>`;
        if (available / total <= 0.2) return `<span class="card-status-pill low">Almost full</span>`;
        return `<span class="card-status-pill">Available now</span>`;
      }
    }
    return `<span class="card-status-pill">Available now</span>`;
  }

  function buildRoomTypesHtml(l, d) {
    const units = l.listing_units || [];
    const rows = units.length
      ? units.map(u => ({ label: u.unit_label, price: u.price }))
      : (Array.isArray(d.room_types) ? d.room_types.map(t => ({ label: t.label, price: t.price })) : []);
    if (!rows.length) return '';
    return `<div class="card-roomtypes">${rows.slice(0,4).map(r => `
      <div class="card-roomtype-chip">
        <div class="rt-label">${escHtmlC(r.label)}</div>
        <div class="rt-price">KES ${Number(r.price).toLocaleString('en-KE')}</div>
      </div>`).join('')}</div>`;
  }

  const ciParkIcon = `<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 010 6H9"/></svg>`;
  const ciSecurityIcon = `<svg viewBox="0 0 24 24"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><polyline points="9 12 11 14 15 10"/></svg>`;

  function buildSpecsChipsHtml(l, meta, d) {
    const chips = [];
    if (meta.group === 'standard') {
      if (d.bedrooms !== undefined && d.bedrooms !== null && d.bedrooms !== '') chips.push([ciBedIcon, d.bedrooms == 0 ? 'Studio' : d.bedrooms + ' bed']);
      if (d.bathrooms) chips.push([ciBathIcon, d.bathrooms + ' bath']);
      if (d.size_sqm) chips.push([ciSizeIcon, d.size_sqm + 'm²']);
      if (d.furnished === 'yes') chips.push([ciFurnIcon, 'Furnished']);
      else if (d.furnished === 'partial') chips.push([ciFurnIcon, 'Part-furnished']);
    } else if (meta.group === 'airbnb') {
      if (d.guests) chips.push([ciGroupIcon, d.guests + ' guests']);
      if (d.bedrooms) chips.push([ciBedIcon, d.bedrooms + ' bed']);
      if (d.bathrooms) chips.push([ciBathIcon, d.bathrooms + ' bath']);
      if (d.min_stay) chips.push([ciSizeIcon, `${d.min_stay}+ night${d.min_stay==1?'':'s'}`]);
    } else if (meta.group === 'commercial') {
      if (d.size_sqm) chips.push([ciSizeIcon, d.size_sqm + 'm²']);
      if (d.parking) chips.push([ciParkIcon, nkTitleCaseC(d.parking)]);
      if (d.security) chips.push([ciSecurityIcon, nkTitleCaseC(d.security)]);
      if (d.unit_type) chips.push([ciGroupIcon, nkTitleCaseC(d.unit_type)]);
    }
    if (!chips.length) return '';
    return `<div class="card-specs-chips">${chips.map(([icon,label]) => `<div class="card-spec-chip">${icon}${label}</div>`).join('')}</div>`;
  }

  function nkTitleCaseC(s) { if (!s) return ''; return String(s).replace(/_/g,' ').replace(/\b\w/g, c => c.toUpperCase()); }

  function buildBoardingMetaHtml(l, d) {
    const items = [];
    if (d.gender && d.gender !== 'mixed') items.push(`<div class="card-meta-item">${ciGroupIcon}${d.gender.charAt(0).toUpperCase()+d.gender.slice(1)} only</div>`);
    else items.push(`<div class="card-meta-item">${ciGroupIcon}Mixed</div>`);
    if (d.institution) items.push(`<div class="card-meta-item">${ciWalkIcon}${escHtmlC(d.institution)}</div>`);
    return items.length ? `<div class="card-meta">${items.join('')}</div>` : '';
  }

  function buildAmenitiesHtml(l) {
    const list = Array.isArray(l.amenities) ? l.amenities : [];
    if (!list.length) return '';
    const labels = list.map(k => (NK_AMENITIES.find(a => a.key === k) || {}).label).filter(Boolean);
    const shown = labels.slice(0, 3);
    const extra = labels.length - shown.length;
    return `<div class="card-amenities">
      ${shown.map(l2 => `<span class="card-amenity-chip">${l2}</span>`).join('')}
      ${extra > 0 ? `<span class="card-amenity-chip more">+${extra} more</span>` : ''}
    </div>`;
  }

  function escHtmlC(str) { if (!str) return ''; return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function buildCard(l) {
    const photos = l.listing_photos && l.listing_photos.length
      ? [...l.listing_photos].sort((a,b) => a.position - b.position)
      : [];
    const cover = photos.find(p => p.is_cover) || photos[0];
    if (cover) {
      const coverIdx = photos.indexOf(cover);
      if (cardPhotoIndex[l.id] === undefined) cardPhotoIndex[l.id] = coverIdx >= 0 ? coverIdx : 0;
    }
    cardDataById[l.id] = l;

    const meta = NK_CATEGORIES[l.category] || { label: l.category, group: 'standard' };
    const d = l.details || {};
    const idx = cardPhotoIndex[l.id] || 0;
    const current = photos[idx];

    const imgHtml = current
      ? `<img id="card-img-${l.id}" src="${current.url}" alt="${l.title}" loading="lazy"/>`
      : `<div class="card-img-placeholder" id="card-img-${l.id}"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg><span style="font-size:11px">No photo</span></div>`;

    const carouselArrows = photos.length > 1 ? `
      <button class="card-carousel-arrow prev" onclick="nkCardPhotoNav(event,'${l.id}',-1)" aria-label="Previous photo"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></button>
      <button class="card-carousel-arrow next" onclick="nkCardPhotoNav(event,'${l.id}',1)" aria-label="Next photo"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></button>
      <div class="card-photo-counter" id="card-counter-${l.id}">${idx+1}/${photos.length}</div>` : '';

    const catBadge = `<span class="badge-cat ${l.category}">${meta.label}</span>`;
    const statusPill = buildStatusPill(l, meta);
    const subText = l.address || (NK_AREA_TO_COUNTY[l.area] ? l.area + ', ' + nkCountyLabel(NK_AREA_TO_COUNTY[l.area]) : (l.county ? l.area + ', ' + nkCountyLabel(l.county) : 'Kenya'));

    const middleHtml = meta.group === 'boarding'
      ? buildBoardingMetaHtml(l, d) + buildRoomTypesHtml(l, d)
      : buildSpecsChipsHtml(l, meta, d);

    const goto = `window.location='/listing?id=${String(l.listing_number).padStart(6,'0')}'`;

    return `
      <div class="card" onclick="${goto}" role="button" tabindex="0" aria-label="${l.title}" onkeydown="if(event.key==='Enter'){${goto}}">
        <div class="card-img" id="card-imgwrap-${l.id}">
          ${imgHtml}
          ${statusPill}
          <div class="nk-heart-overlay">${typeof NKSaved !== 'undefined' ? NKSaved.buildHeartBtn(l.id) : ''}</div>
          ${catBadge}
          ${carouselArrows}
        </div>
        <div class="card-body">
          <div class="card-area">${l.area}</div>
          <div class="card-title">${l.title}</div>
          <div class="card-sub">${subText}</div>
          <div class="card-price">${formatPrice(l)}</div>
          ${middleHtml}
          ${buildAmenitiesHtml(l)}
          ${cardCtaButtonHtml(l.id)}
        </div>
      </div>`;
  }

  /* ── Card CTA button: "Send Inquiry" the first time, "View conversation"
     once this buyer already has a thread with this listing (checked via
     the same nk_buyer_<id> localStorage key listing.html uses). ── */
  function nkHasCardThread(listingId) { return !!nkLSGetC('nk_buyer_' + listingId); }

  function ciSentIconHtml() { return `<svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>`; }

  function cardCtaButtonHtml(listingId) {
    if (nkHasCardThread(listingId)) {
      return `<button type="button" class="card-inquire-btn sent" id="card-cta-${listingId}" onclick="handleCardCta(event,'${listingId}')">
        ${ciSentIconHtml()}
        View conversation
      </button>`;
    }
    return `<button type="button" class="card-inquire-btn" id="card-cta-${listingId}" onclick="handleCardCta(event,'${listingId}')">
      ${ciSentIconHtml()}
      Send Inquiry
    </button>`;
  }

  function handleCardCta(event, listingId) {
    event.stopPropagation();
    if (nkHasCardThread(listingId)) {
      if (typeof NKGlobalChat !== 'undefined' && NKGlobalChat.registerAndOpen) NKGlobalChat.registerAndOpen(listingId);
    } else {
      openCardInquiry(event, listingId);
    }
  }

  /* Swap only the photo/counter DOM for one card — avoids re-rendering the
     whole grid on every arrow click. */
  function nkCardPhotoNav(event, listingId, dir) {
    event.stopPropagation();
    const l = cardDataById[listingId];
    if (!l) return;
    const photos = l.listing_photos && l.listing_photos.length
      ? [...l.listing_photos].sort((a,b) => a.position - b.position)
      : [];
    if (photos.length < 2) return;
    let idx = cardPhotoIndex[listingId] || 0;
    idx = (idx + dir + photos.length) % photos.length;
    cardPhotoIndex[listingId] = idx;
    const imgEl = document.getElementById(`card-img-${listingId}`);
    if (imgEl && imgEl.tagName === 'IMG') imgEl.src = photos[idx].url;
    const counterEl = document.getElementById(`card-counter-${listingId}`);
    if (counterEl) counterEl.textContent = `${idx+1}/${photos.length}`;
  }

  function renderResults(listings, count) {
    const grid = document.getElementById('listings-grid');
    const rc = document.getElementById('result-count');
    rc.innerHTML = `<strong>${count.toLocaleString()}</strong> listing${count !== 1 ? 's' : ''} found`;

    if (!listings.length) {
      grid.innerHTML = `<div class="empty-state">
        <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
        <h3>No listings match your filters</h3>
        <p>Try adjusting your search or <a onclick="resetAllFilters()" style="cursor:pointer">reset all filters</a></p>
        <button class="btn btn-primary" style="margin-top:14px" onclick="openNotifyModal()">🔔 Notify me when a match is posted</button>
      </div>`;
      return;
    }
    grid.innerHTML = listings.map(buildCard).join('');
  }

  /* ════════════════════════════════════════════════════
     INLINE CARD INQUIRY — same enquiries/messages tables
     and buyer-token model as listing.html, but launched
     from the grid card instead of the detail page.
  ════════════════════════════════════════════════════ */
  function openCardInquiry(event, listingId) {
    event.stopPropagation();
    const l = cardDataById[listingId];
    if (!l) return;
    ciActiveListingId = listingId;
    ciBuyerToken = nkLSGetC('nk_buyer_' + listingId);

    document.getElementById('ci-listing-title').textContent = l.title;
    document.getElementById('ci-form').style.display = 'block';
    document.getElementById('ci-success').style.display = 'none';
    document.getElementById('ci-name').value = nkLSGetC('nk_buyer_name_' + listingId) || '';
    document.getElementById('ci-phone').value = nkLSGetC('nk_buyer_phone_' + listingId) || '';
    document.getElementById('ci-email').value = '';
    document.getElementById('ci-message').value = `Hi, I'm interested in "${l.title}". Is it still available?`;
    document.getElementById('ci-phone-field').style.display = l.contact_hidden ? 'none' : 'block';

    const meta = NK_CATEGORIES[l.category] || { group: 'standard' };
    const roomField = document.getElementById('ci-roomtype-field');
    if (meta.group === 'boarding' && (l.listing_units || []).length) {
      roomField.style.display = 'block';
      const sel = document.getElementById('ci-roomtype');
      sel.innerHTML = '<option value="">Any available room</option>' + l.listing_units
        .filter(u => (u.quantity_available ?? 0) > 0)
        .map(u => `<option value="${escHtmlC(u.unit_label)}">${escHtmlC(u.unit_label)} — KES ${Number(u.price).toLocaleString('en-KE')}/mo</option>`)
        .join('');
    } else {
      roomField.style.display = 'none';
    }

    document.getElementById('card-inquiry-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeCardInquiry() {
    document.getElementById('card-inquiry-overlay').classList.remove('open');
    document.body.style.overflow = '';
    ciActiveListingId = null;
  }
function nkScrollWrap(btn) {
  const wrap = btn.closest('.scroll-wrap');
  if (!wrap) return;
  const scroller = wrap.querySelector('.categories, .listings-grid, .areas');
  if (!scroller) return;
  const firstCard = scroller.querySelector(':scope > *');
  const gap = parseFloat(getComputedStyle(scroller).gap) || 16;
  const step = firstCard ? firstCard.getBoundingClientRect().width + gap : scroller.clientWidth * 0.8;
  scroller.scrollBy({ left: step, behavior: 'smooth' });
}
  function nkLSGetC(key) { try { return localStorage.getItem(key); } catch(e) { return null; } }
  function nkLSSetC(key, val) { try { localStorage.setItem(key, val); } catch(e) {} }

  async function submitCardInquiry() {
    if (!ciActiveListingId) return;
    const l = cardDataById[ciActiveListingId];
    const name = document.getElementById('ci-name').value.trim();
    const phone = document.getElementById('ci-phone').value.trim();
    const email = document.getElementById('ci-email').value.trim();
    let message = document.getElementById('ci-message').value.trim();
    const contactHidden = !!l?.contact_hidden;

    if (!name) { alert('Please enter your name'); return; }
    if (!contactHidden && (!phone || phone.replace(/\s/g,'').length < 9)) { alert('Please enter a valid phone number'); return; }
    if (!message) { alert('Please enter a message'); return; }

    const meta = NK_CATEGORIES[l.category] || { group: 'standard' };
    if (meta.group === 'boarding') {
      const roomType = document.getElementById('ci-roomtype').value;
      if (roomType) message = `Interested room type: ${roomType}. ${message}`;
    }

    const btn = document.getElementById('ci-submit-btn');
    btn.disabled = true; btn.textContent = 'Sending…';

    const token = ciBuyerToken || (crypto.randomUUID ? crypto.randomUUID() : Date.now()+'-'+Math.random().toString(36).slice(2));
    const enqId = (crypto.randomUUID ? crypto.randomUUID() : Date.now()+'-'+Math.random().toString(36).slice(2));
    const { data: { session } } = await nkSessionPromise;
    const currentUserId = session?.user?.id || null;

    const { error: enqErr } = await db.from('enquiries').insert({
      id: enqId, listing_id: ciActiveListingId, buyer_name: name, buyer_phone: phone,
      buyer_email: email || null, buyer_token: token, buyer_id: currentUserId, message
    });
    if (enqErr) {
      btn.disabled = false; btn.textContent = 'Send message';
      alert('Something went wrong: ' + (enqErr.message || 'unknown error'));
      return;
    }

    const msgId = (crypto.randomUUID ? crypto.randomUUID() : Date.now()+'-'+Math.random().toString(36).slice(2));
    const { error: msgErr } = await db.from('messages').insert({
      id: msgId, listing_id: ciActiveListingId, buyer_token: token, buyer_name: name,
      buyer_phone: phone, buyer_id: currentUserId, sender: 'buyer', content: message
    });
    btn.disabled = false; btn.textContent = 'Send message';
    if (msgErr) {
      await db.from('enquiries').delete().eq('id', enqId);
      alert('Something went wrong: ' + (msgErr.message || 'unknown error'));
      return;
    }

    nkLSSetC('nk_buyer_' + ciActiveListingId, token);
    nkLSSetC('nk_buyer_name_' + ciActiveListingId, name);
    nkLSSetC('nk_buyer_phone_' + ciActiveListingId, phone);
    nkUpdateCardCtaToSent(ciActiveListingId);

    fetch(`${EDGE_URL}/send-notification-email`, {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` },
      body: JSON.stringify({ type: 'new_buyer_enquiry', buyerName: name, buyerPhone: phone, buyerEmail: email || null, message, listingId: ciActiveListingId, listingTitle: l?.title }),
    }).catch(e => console.error('Enquiry notify email failed:', e));

    document.getElementById('ci-form').style.display = 'none';
    document.getElementById('ci-success').style.display = 'block';
    if (typeof NKGlobalChat !== 'undefined' && NKGlobalChat.registerAndOpen) NKGlobalChat.registerAndOpen(ciActiveListingId);
    setTimeout(() => { closeCardInquiry(); }, 2200);
  }

  /* Flips one card's CTA button to "View conversation" immediately after a
     successful send — no full grid re-render needed. */
  function nkUpdateCardCtaToSent(listingId) {
    const btn = document.getElementById(`card-cta-${listingId}`);
    if (!btn) return;
    btn.classList.add('sent');
    btn.innerHTML = `${ciSentIconHtml()}View conversation`;
  }

  function renderPagination(count) {
    const totalPages = Math.ceil(count / PAGE_SIZE);
    const el = document.getElementById('pagination');
    if (totalPages <= 1) { el.innerHTML = ''; return; }

    let html = `<button class="page-btn" onclick="applyFilters(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>←</button>`;
    for (let i = 1; i <= totalPages; i++) {
      if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
        html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="applyFilters(${i})">${i}</button>`;
      } else if (i === currentPage - 2 || i === currentPage + 2) {
        html += `<span style="padding:0 4px;color:var(--text-3);font-size:13px">…</span>`;
      }
    }
    html += `<button class="page-btn" onclick="applyFilters(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}>→</button>`;
    el.innerHTML = html;
  }

  function debouncedApply() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(applyFilters, 500);
  }

  function openSidebar() {
    document.getElementById('sidebar').classList.add('open');
    document.getElementById('overlay').classList.add('open');
    document.getElementById('filter-toggle-btn')?.setAttribute('aria-expanded', 'true');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('overlay').classList.remove('open');
    document.getElementById('filter-toggle-btn')?.setAttribute('aria-expanded', 'false');
  }

  function toggleMobileMenu() {
    const nav = document.getElementById('mobile-nav');
    const isOpen = nav.classList.toggle('open');
    document.getElementById('mobile-menu-btn')?.setAttribute('aria-expanded', isOpen);
  }

  function nkMakeClickablesKeyboardAccessible() {
    document.querySelectorAll('.filter-pill[onclick]').forEach(el => {
      if (el.hasAttribute('tabindex')) return;
      el.setAttribute('role', 'button');
      el.setAttribute('tabindex', '0');
      el.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el.click(); }
      });
    });
  }
  document.addEventListener('click', e => {
    const nav = document.getElementById('mobile-nav');
    const btn = document.querySelector('.mobile-menu-btn');
    if (nav && nav.classList.contains('open') && !nav.contains(e.target) && !btn.contains(e.target)) {
      nav.classList.remove('open');
    }
  });

  nkSessionPromise.then(({ data: { session } }) => {
    if (!session) return;
    const desktopLink = document.getElementById('nav-account-link');
    const mobileLink  = document.getElementById('mobile-account-link');
    if (desktopLink) {
      desktopLink.textContent = 'My Account';
      desktopLink.href = '/dashboard';
      desktopLink.style.fontWeight = '600';
      desktopLink.style.color = 'var(--green)';
    }
    if (mobileLink) {
      mobileLink.textContent = 'My Account';
      mobileLink.href = '/dashboard';
    }
  });

  /* ════════════════════════════════════════════════════
     NOTIFY ME
  ════════════════════════════════════════════════════ */
  function dismissNotifyStrip() {
    document.getElementById('notify-strip').style.display = 'none';
  }

  function nfPopulateCounties() {
    const sel = document.getElementById('nf-county-select');
    sel.innerHTML = '<option value="">Any county</option>' +
      NK_COUNTIES.map(c => `<option value="${c}">${nkCountyLabel(c)}</option>`).join('');
  }

  function nfHandleCountyChange() {
    const county = document.getElementById('nf-county-select').value;
    const areaSel = document.getElementById('nf-area-select');
    const areas = NK_AREAS_BY_COUNTY[county] || [];
    areaSel.innerHTML = '<option value="">Any area in this county</option>' +
      areas.map(a => `<option value="${a}">${a}</option>`).join('');
  }

  function nfToggleCustomArea() {
    const checked = document.getElementById('nf-area-not-listed').checked;
    document.getElementById('nf-area-wrap').style.display = checked ? 'none' : '';
    document.getElementById('nf-area-custom').style.display = checked ? 'block' : 'none';
    if (checked) document.getElementById('nf-area-select').value = '';
  }

  function nfSetPill(el, groupId) {
    document.querySelectorAll(`#${groupId} .filter-pill`).forEach(p => p.classList.remove('active'));
    el.classList.add('active');
  }

  function nfResetForm() {
    document.getElementById('nf-name').value = '';
    document.getElementById('nf-phone').value = '';
    document.getElementById('nf-email').value = '';
    document.getElementById('nf-budget-min').value = '';
    document.getElementById('nf-budget-max').value = '';
    document.getElementById('nf-notes').value = '';
    document.getElementById('nf-area-custom').value = '';
    document.getElementById('nf-area-custom').style.display = 'none';
    document.getElementById('nf-area-not-listed').checked = false;
    document.getElementById('nf-area-wrap').style.display = '';
    ['nf-type-pills','nf-cat-pills','nf-bed-pills'].forEach(groupId => {
      nfSetPill(document.querySelector(`#${groupId} .filter-pill[data-val=""]`), groupId);
    });
    document.getElementById('nf-consent').checked = false;
  }

  function openNotifyModal() {
    nfPopulateCounties();
    document.getElementById('nf-area-select').innerHTML = '<option value="">Any area in this county</option>';
    document.getElementById('notify-modal-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeNotifyModal() {
    document.getElementById('notify-modal-overlay').classList.remove('open');
    document.body.style.overflow = '';
    if (exitNotifyFlowActive) {
      const href = exitPendingHref;
      exitNotifyFlowActive = false;
      exitPendingHref = null;
      if (href) window.location.href = href;
    }
  }

  function showNotifySuccess() {
    const t = document.getElementById('notify-success-toast');
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4500);
  }

  async function submitNotifyAlert() {
    const name  = document.getElementById('nf-name').value.trim();
    const phone = document.getElementById('nf-phone').value.trim();
    const email = document.getElementById('nf-email').value.trim();

    if (!name)  { alert('Please enter your name'); return; }
    if (!email) { alert('Please enter an email so we can reach you'); return; }
    if (!document.getElementById('nf-consent').checked) {
      alert('Please agree to be contacted before submitting');
      return;
    }

    const priceType = document.querySelector('#nf-type-pills .filter-pill.active')?.dataset.val || null;
    const category  = document.querySelector('#nf-cat-pills .filter-pill.active')?.dataset.val || null;
    const bedsVal   = document.querySelector('#nf-bed-pills .filter-pill.active')?.dataset.val || '';
    const bedrooms  = bedsVal ? parseInt(bedsVal) : null;

    const county        = document.getElementById('nf-county-select').value || null;
    const customChecked  = document.getElementById('nf-area-not-listed').checked;
    const areaSelectVal  = document.getElementById('nf-area-select').value || null;
    const customAreaText = document.getElementById('nf-area-custom').value.trim();

    const area       = customChecked ? null : areaSelectVal;
    const customArea = customChecked ? (customAreaText || null) : null;

    let countyAreas = null;
    if (county && !area && !customChecked) {
      countyAreas = NK_AREAS_BY_COUNTY[county] || null;
    }

    const budgetMin = document.getElementById('nf-budget-min').value;
    const budgetMax = document.getElementById('nf-budget-max').value;
    const notes = document.getElementById('nf-notes').value.trim();

    const btn = document.getElementById('nf-submit-btn');
    btn.disabled = true; btn.textContent = 'Saving…';

    const { error } = await db.from('listing_alerts').insert({
      full_name: name,
      phone: phone || null,
      email,
      price_type: priceType,
      category,
      bedrooms,
      county,
      area,
      county_areas: countyAreas,
      custom_area: customArea,
      budget_min: budgetMin ? parseFloat(budgetMin) : null,
      budget_max: budgetMax ? parseFloat(budgetMax) : null,
      notes: notes || null,
    });

    btn.disabled = false; btn.textContent = 'Notify me';

    if (error) {
      alert('Something went wrong, please try again: ' + error.message);
      return;
    }

    db.functions.invoke('send-notification-email', {
      body: { type: 'alert_confirmation', alertName: name, alertEmail: email },
    }).catch(err => console.warn('Alert confirmation email failed to send:', err));

    document.getElementById('notify-modal-overlay').classList.remove('open');
    document.body.style.overflow = '';
    nfResetForm();
    showNotifySuccess();

    if (exitNotifyFlowActive) {
      const href = exitPendingHref;
      exitNotifyFlowActive = false;
      exitPendingHref = null;
      if (href) setTimeout(() => { window.location.href = href; }, 1200);
    }
  }

  document.getElementById('footer-year').textContent = new Date().getFullYear();
  nkPopulateFooterCounties();
  nkPopulateCountySelect();
  renderAreaChecklist('');
  renderAmenityChecks();
  readUrlParams();
  toggleGroupFilters(document.querySelector('#cat-pills .filter-pill.active')?.dataset.val || '');
  applyFilters();
  nkMakeClickablesKeyboardAccessible();
</script>

