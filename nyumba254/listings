      transition: border-color .15s, background .15s; font-family: inherit;
    }
    .nf-field input:focus, .nf-field select:focus, .nf-field textarea:focus { border-color: var(--green); background: white; }
    .nf-field textarea { resize: vertical; min-height: 60px; }
    .nf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .nf-check { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-2); cursor: pointer; font-weight: 500; }
