function handleCardCta(event, listingId) {
  event.preventDefault(); event.stopPropagation();
  if (nkHasCardThread(listingId)) {
    if (typeof NKGlobalChat !== 'undefined' && NKGlobalChat.registerAndOpen) NKGlobalChat.registerAndOpen(listingId);
  } else {
    openCardInquiry(event, listingId);
  }
}

function nkCardPhotoNav(event, listingId, dir) {
  event.preventDefault(); event.stopPropagation();
  const l = cardDataById[listingId];
  if (!l) return;
  const photos = l.listing_photos && l.listing_photos.length ? [...l.listing_photos].sort((a, b) => a.position - b.position) : [];
  if (photos.length < 2) return;
  let idx = cardPhotoIndex[listingId] || 0;
  idx = (idx + dir + photos.length) % photos.length;
  cardPhotoIndex[listingId] = idx;
  const imgEl = document.getElementById(`card-img-${listingId}`);
  if (imgEl && imgEl.tagName === 'IMG') imgEl.src = nkImgSrc(photos[idx].url, 420);
  const counterEl = document.getElementById(`card-counter-${listingId}`);
  if (counterEl) counterEl.textContent = `${idx + 1}/${photos.length}`;
}

/* C (Results): compute what a single-filter removal would unlock, for zero-result suggestions */
async function nkComputeZeroResultAlternatives(f) {
  const candidates = [];
  if (f.priceMin || f.priceMax) candidates.push({ label: 'Remove price limit', patch: { priceMin: '', priceMax: '' } });
  if (f.beds !== '') candidates.push({ label: 'Remove bedroom filter', patch: { beds: '' } });
  if (f.areas.length) candidates.push({ label: `Remove area filter`, patch: { areas: [] } });
  if (f.amenities.length) candidates.push({ label: 'Remove amenities filter', patch: { amenities: [] } });
  if (f.cat) candidates.push({ label: `Any property type`, patch: { cat: '' } });
  const results = [];
  for (const c of candidates.slice(0, 4)) {
    const merged = { ...f, ...c.patch };
    let q = db.from('listings').select('*', { count: 'exact', head: true }).eq('status', 'active');
    if (merged.freq) q = q.eq('price_frequency', merged.freq);
    if (merged.cat) q = q.eq('category', merged.cat);
    q = nkApplyBedroomFilter(q, merged.beds);
    if (merged.areas.length) { q = q.in('area', merged.areas); if (merged.county) q = q.eq('county', merged.county); }
    else if (merged.county) q = nkCountyEq(q, merged.county);
    if (merged.priceMin) q = q.gte('price', parseFloat(merged.priceMin));
    if (merged.priceMax) q = q.lte('price', parseFloat(merged.priceMax));
    if (merged.amenities.length) q = q.contains('amenities', merged.amenities);
    const { count } = await q;
    if (count > 0) results.push({ label: `${c.label} → ${count} result${count !== 1 ? 's' : ''}`, patch: c.patch });
  }
  return results;
}

function renderResults(listings, count, append, filtersUsed) {
  const grid = document.getElementById('listings-grid');
  const rc = document.getElementById('result-count');
  // C (Results): "Showing 1–12 of 87"
  if (count > 0 && !nkMobileMode) {
    const from = (currentPage - 1) * PAGE_SIZE + 1;
    const to = Math.min(currentPage * PAGE_SIZE, count);
    rc.innerHTML = `Showing <strong>${from}–${to}</strong> of <strong>${count.toLocaleString()}</strong>`;
  } else {
    rc.innerHTML = `<strong>${count.toLocaleString()}</strong> listing${count !== 1 ? 's' : ''} found`;
  }
  nkUpdateQuickFilterCount(count);

  if (nkMobileMode) {
    if (!append) { nkMobileAccum = []; grid.innerHTML = ''; nkRemoveInfiniteSentinel(); }
    if (!listings.length && !nkMobileAccum.length) { renderEmptyState(grid, filtersUsed); return; }
    nkMobileAccum = nkMobileAccum.concat(listings);
    const frag = document.createElement('div');
    frag.className = 'nk-mobile-feed-batch';
    frag.innerHTML = listings.map(buildCard).join('');
    grid.appendChild(frag);
    if (typeof NKSaved !== 'undefined' && NKSaved.hydrate) NKSaved.hydrate(frag);
    nkBindCardSwipe(frag);
    nkInsertInfiniteSentinel();
    return;
  }

  nkLastListings = listings;
  if (!listings.length) { renderEmptyState(grid, filtersUsed); return; }
  grid.innerHTML = listings.map(buildCard).join('');
  if (typeof NKSaved !== 'undefined' && NKSaved.hydrate) NKSaved.hydrate(grid); // A11: hearts render correctly even if saved-listings.js loads after this
  nkBindCardSwipe(grid);
}

async function renderEmptyState(grid, filtersUsed) {
  grid.innerHTML = `<div class="empty-state" style="width:100%">
    <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
    <h3>No listings match your filters</h3>
    <p>Try widening your price range, removing a filter, or checking a nearby area.</p>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:10px">
      <button class="btn btn-outline" onclick="resetAllFilters()">Reset all filters</button>
      <button class="btn btn-primary" onclick="openNotifyModal()">🔔 Notify me when a match is posted</button>
    </div>
    <div class="empty-suggestion-chips" id="empty-suggestion-chips"></div>
  </div>`;
  // C (Results): "Remove price limit → 14 results" style suggestion chips
  if (filtersUsed) {
    const alts = await nkComputeZeroResultAlternatives(filtersUsed);
    const chipsEl = document.getElementById('empty-suggestion-chips');
    if (chipsEl && alts.length) {
      chipsEl.innerHTML = alts.map((a, i) => `<button type="button" class="empty-suggestion-chip" data-alt-idx="${i}">${escHtml(a.label)}</button>`).join('');
      chipsEl.querySelectorAll('[data-alt-idx]').forEach((btn, i) => btn.addEventListener('click', () => nkApplyAlternative(alts[i].patch)));
    }
  }
}
function nkApplyAlternative(patch) {
  if ('priceMin' in patch) { document.getElementById('price-min').value = ''; document.getElementById('price-max').value = ''; clearPricePresetActive(); }
  if ('beds' in patch) setPillSilent(document.querySelector('#bed-pills .filter-pill[data-val=""]'), 'bed-pills');
  if ('areas' in patch) document.querySelectorAll('#area-checks input:checked').forEach(cb => cb.checked = false);
  if ('amenities' in patch) document.querySelectorAll('#amen-checks input:checked').forEach(cb => cb.checked = false);
  if ('cat' in patch) { setPillSilent(document.querySelector('#cat-pills .filter-pill[data-val=""]'), 'cat-pills'); toggleGroupFilters(''); syncCatTabs(''); }
  applyFilters();
}

let nkInfiniteObserver = null;
function nkInsertInfiniteSentinel() {
  nkRemoveInfiniteSentinel();
  const grid = document.getElementById('listings-grid');
  const sentinel = document.createElement('div');
  sentinel.id = 'nk-infinite-sentinel';
  sentinel.style.cssText = 'height:1px;width:100%;';
  grid.appendChild(sentinel);
  const pagesLoaded = Math.ceil(nkMobileAccum.length / PAGE_SIZE);
  if (nkHasMorePages && pagesLoaded < 3) {
    // Auto-load the first 3 pages, then switch to an explicit "Load more" button (C: Results)
  } else if (nkHasMorePages) {
    const loadMoreWrap = document.createElement('div');
    loadMoreWrap.id = 'nk-load-more-wrap';
    loadMoreWrap.innerHTML = `<button class="nk-load-more-btn" onclick="nkLoadNextMobilePage()">Load more listings</button>`;
    grid.appendChild(loadMoreWrap);
  } else if (nkMobileAccum.length) {
    const doneMsg = document.createElement('div');
    doneMsg.className = 'nk-feed-end';
    doneMsg.textContent = "You've reached the end of the results.";
    grid.appendChild(doneMsg);
  }
  if (!nkInfiniteObserver && 'IntersectionObserver' in window) {
    nkInfiniteObserver = new IntersectionObserver((entries) => { entries.forEach(entry => { if (entry.isIntersecting) nkLoadNextMobilePage(); }); }, { rootMargin: '600px 0px 600px 0px' });
  }
  if (nkInfiniteObserver && pagesLoaded < 3) nkInfiniteObserver.observe(sentinel);
}
function nkRemoveInfiniteSentinel() {
  document.getElementById('nk-infinite-sentinel')?.remove();
  document.getElementById('nk-load-more-wrap')?.remove();
  document.querySelector('.nk-feed-end')?.remove();
}
function nkLoadNextMobilePage() {
  if (!nkMobileMode || nkLoadingMore || !nkHasMorePages) return;
  nkLoadingMore = true;
  document.getElementById('nk-load-more-wrap')?.remove();
  const spinner = document.createElement('div');
  spinner.className = 'nk-load-more-spinner';
  spinner.id = 'nk-load-more-spinner';
  spinner.innerHTML = `<span class="nk-spinner"></span> Loading more…`;
  document.getElementById('listings-grid').appendChild(spinner);
  applyFilters(currentPage + 1, true).then(() => { document.getElementById('nk-load-more-spinner')?.remove(); });
}

function nkBindCardSwipe(scopeEl) {
  (scopeEl || document).querySelectorAll('.card-img').forEach(imgWrap => {
    if (imgWrap.dataset.swipeBound) return;
    imgWrap.dataset.swipeBound = '1';
    let startX = 0, startY = 0, dragging = false;
    imgWrap.addEventListener('touchstart', (e) => { if (!e.touches || !e.touches.length) return; startX = e.touches[0].clientX; startY = e.touches[0].clientY; dragging = true; }, { passive: true });
    imgWrap.addEventListener('touchend', (e) => {
      if (!dragging) return; dragging = false;
      const t = e.changedTouches && e.changedTouches[0];
      if (!t) return;
      const dx = t.clientX - startX, dy = t.clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.4) {
        const card = imgWrap.closest('.card');
        const listingId = card?.dataset.listingId;
        if (listingId) nkCardPhotoNav({ preventDefault(){}, stopPropagation(){} }, listingId, dx < 0 ? 1 : -1);
      }
    }, { passive: true });
  });
}

/* ════════════════════════════════════════════════════ INLINE CARD INQUIRY ════════════════════════════════════════════════════ */
function openCardInquiry(event, listingId) {
  if (event) { event.preventDefault(); event.stopPropagation(); }
  const l = cardDataById[listingId];
  if (!l) return;
  ciActiveListingId = listingId;
  const profile = nkGetBuyerProfile(); // B7: global buyer profile pre-fills every subsequent enquiry

  document.getElementById('ci-listing-title').textContent = l.title;
  document.getElementById('ci-form').style.display = 'block';
  document.getElementById('ci-success').style.display = 'none';
  document.getElementById('ci-name').value = profile.name || nkLSGetC('nk_buyer_name_' + listingId) || '';
  document.getElementById('ci-phone').value = profile.phone || nkLSGetC('nk_buyer_phone_' + listingId) || '';
  document.getElementById('ci-email').value = profile.email || '';
  document.getElementById('ci-message').value = `Hi, I'm interested in "${l.title}". Is it still available?`;
  document.getElementById('ci-phone-field').style.display = l.contact_hidden ? 'none' : 'block';
  document.getElementById('ci-hp').value = '';
  ['ci-name', 'ci-phone', 'ci-message'].forEach(id => { document.getElementById(id).classList.remove('invalid'); document.getElementById(id + '-error').classList.remove('visible'); });

  const meta = NK_CATEGORIES[l.category] || { group: 'standard' };
  const roomField = document.getElementById('ci-roomtype-field');
  if (meta.group === 'boarding' && (l.listing_units || []).length) {
    roomField.style.display = 'block';
    const sel = document.getElementById('ci-roomtype');
    sel.innerHTML = '<option value="">Any available room</option>' + l.listing_units.filter(u => (u.quantity_available ?? 0) > 0)
      .map(u => `<option value="${escHtml(u.unit_label)}">${escHtml(u.unit_label)} — KES ${Number(u.price).toLocaleString('en-KE')}/mo</option>`).join('');
  } else { roomField.style.display = 'none'; }

  nkOpenModal(document.getElementById('card-inquiry-overlay'));
}
function closeCardInquiry() { nkCloseModal(document.getElementById('card-inquiry-overlay')); ciActiveListingId = null; }
function nkLSGetC(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
function nkLSSetC(key, val) { try { localStorage.setItem(key, val); } catch (e) {} }

/* Security stop-gap while the real fix (atomic RPC/Edge Function + RLS,
   see nk-shared.js notes) is out of scope for static files: a honeypot
   field, and a short per-listing cooldown so a script can't spam sends. */
function nkInquiryOnCooldown(listingId) {
  const last = Number(nkLSGetC('nk_inquiry_cd_' + listingId) || 0);
  return Date.now() - last < 15000;
}

async function submitCardInquiry() {
  if (!ciActiveListingId) return;
  if (document.getElementById('ci-hp').value) return; // honeypot tripped — silently drop
  if (nkInquiryOnCooldown(ciActiveListingId)) { alert('Please wait a moment before sending another message.'); return; }

  const l = cardDataById[ciActiveListingId];
  const name = document.getElementById('ci-name').value.trim();
  const phoneRaw = document.getElementById('ci-phone').value.trim();
  const phone = nkNormalizePhone(phoneRaw); // C (Contacting sellers): normalise to +254…
  const email = document.getElementById('ci-email').value.trim();
  let message = document.getElementById('ci-message').value.trim();
  const contactHidden = !!l?.contact_hidden;

  let valid = true;
  const nameEl = document.getElementById('ci-name'), phoneEl = document.getElementById('ci-phone'), msgEl = document.getElementById('ci-message');
  [nameEl, phoneEl, msgEl].forEach(el => { el.classList.remove('invalid'); document.getElementById(el.id + '-error').classList.remove('visible'); });
  if (!name) { nameEl.classList.add('invalid'); document.getElementById('ci-name-error').classList.add('visible'); valid = false; }
  if (!contactHidden && (!phoneRaw || phoneRaw.replace(/\s/g, '').length < 9)) { phoneEl.classList.add('invalid'); document.getElementById('ci-phone-error').classList.add('visible'); valid = false; }
  if (!message) { msgEl.classList.add('invalid'); document.getElementById('ci-message-error').classList.add('visible'); valid = false; }
  if (!valid) return; // C (Contacting sellers): inline errors instead of alert()

  const meta = NK_CATEGORIES[l.category] || { group: 'standard' };
  if (meta.group === 'boarding') {
    const roomType = document.getElementById('ci-roomtype').value;
    if (roomType) message = `Interested room type: ${roomType}. ${message}`;
  }

  const btn = document.getElementById('ci-submit-btn');
  btn.disabled = true; btn.textContent = 'Sending…';

  const token = nkLSGetC('nk_buyer_' + ciActiveListingId) || (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2));
  const enqId = (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2));
  const { data: { session } } = await nkSessionPromise;
  const currentUserId = session?.user?.id || null;

  const { error: enqErr } = await db.from('enquiries').insert({ id: enqId, listing_id: ciActiveListingId, buyer_name: name, buyer_phone: phone, buyer_email: email || null, buyer_token: token, buyer_id: currentUserId, message });
  if (enqErr) { btn.disabled = false; btn.textContent = 'Send message'; alert('Something went wrong: ' + (enqErr.message || 'unknown error')); return; }

  const msgId = (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2));
  const { error: msgErr } = await db.from('messages').insert({ id: msgId, listing_id: ciActiveListingId, buyer_token: token, buyer_name: name, buyer_phone: phone, buyer_id: currentUserId, sender: 'buyer', content: message });
  btn.disabled = false; btn.textContent = 'Send message';
  if (msgErr) { await db.from('enquiries').delete().eq('id', enqId); alert('Something went wrong: ' + (msgErr.message || 'unknown error')); return; }

  nkLSSetC('nk_buyer_' + ciActiveListingId, token);
  nkLSSetC('nk_buyer_name_' + ciActiveListingId, name);
  nkLSSetC('nk_buyer_phone_' + ciActiveListingId, phone);
  nkLSSetC('nk_inquiry_cd_' + ciActiveListingId, String(Date.now()));
  nkSaveBuyerProfile({ name, phone, email }); // B7: remember globally for next time
  nkUpdateCardCtaToSent(ciActiveListingId);

  fetch(`${EDGE_URL}/send-notification-email`, {
    method: 'POST', headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` },
    body: JSON.stringify({ type: 'new_buyer_enquiry', buyerName: name, buyerPhone: phone, buyerEmail: email || null, message, listingId: ciActiveListingId, listingTitle: l?.title }),
  }).catch(e => console.error('Enquiry notify email failed:', e));

  document.getElementById('ci-form').style.display = 'none';
  document.getElementById('ci-success').style.display = 'block';
  if (typeof NKGlobalChat !== 'undefined' && NKGlobalChat.registerAndOpen) NKGlobalChat.registerAndOpen(ciActiveListingId);
  setTimeout(() => { closeCardInquiry(); }, 2200);
}

function nkUpdateCardCtaToSent(listingId) {
  const btn = document.getElementById(`card-cta-${listingId}`);
  if (!btn) return;
  btn.classList.add('sent');
  btn.innerHTML = `${ciSentIconHtml()}<span class="card-inquire-label">View conversation</span>`;
  btn.setAttribute('aria-label', 'View conversation');
}

function renderPagination(count) {
  const el = document.getElementById('pagination');
  if (nkMobileMode) { el.innerHTML = ''; return; }
  const totalPages = Math.ceil(count / PAGE_SIZE);
  if (totalPages <= 1) { el.innerHTML = ''; return; }
  let html = `<button class="page-btn" onclick="applyFilters(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''} aria-label="Previous page">←</button>`;
  for (let i = 1; i <= totalPages; i++) {
    if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
      html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="applyFilters(${i})" aria-current="${i === currentPage ? 'page' : 'false'}">${i}</button>`;
    } else if (i === currentPage - 2 || i === currentPage + 2) {
      html += `<span style="padding:0 4px;color:var(--text-3);font-size:13px">…</span>`;
    }
  }
  html += `<button class="page-btn" onclick="applyFilters(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''} aria-label="Next page">→</button>`;
  el.innerHTML = html;
}

