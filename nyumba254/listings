    .relax-chip small { font-weight: 500; color: var(--text-3); }
    .empty-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 16px; }

    .feed-footer { display: flex; justify-content: center; align-items: center; padding: 14px 0 6px; font-size: 13px; color: var(--text-3); }
