  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green:       #0F6E56;
      --green-light: #E1F5EE;
      --green-mid:   #1D9E75;
      --green-dark:  #085041;
      --gold:        var(--green-dark);
      --gold-light:  var(--green-light);
      --text:        #1a1a18;
      --text-2:      #4a4a46;
      --text-3:      #888780;
      --border:      #e0ded8;
      --surface:     #f7f6f2;
      --white:       #ffffff;
      --radius:      10px;
      --radius-lg:   16px;
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', sans-serif; color: var(--text); background: var(--surface); font-size: 15px; line-height: 1.6; }
    a { text-decoration: none; color: inherit; }
    button { font-family: inherit; cursor: pointer; border: none; }
    input, select { font-family: inherit; }

    /* ── Navbar ── */
    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 32px; height: 64px;
      background: var(--white); border-bottom: 1px solid var(--border);
    }
    .logo { display: flex; align-items: center; gap: 10px; font-family: 'Playfair Display', serif; font-size: 20px; color: var(--green-dark); }
    .logo-icon { width: 34px; height: 34px; background: var(--green); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
    .logo-icon svg { width: 18px; height: 18px; fill: none; stroke: white; stroke-width: 2; stroke-linecap: round; }
    .nav-links { display: flex; align-items: center; gap: 6px; }
    .nav-link { font-size: 14px; color: var(--text-2); padding: 8px 14px; border-radius: var(--radius); transition: background .15s; white-space: nowrap; }
    .nav-link:hover { background: var(--surface); color: var(--text); }
    .btn { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 500; padding: 9px 18px; border-radius: var(--radius); transition: all .15s; }
    .btn-primary { background: var(--green); color: white; }
    .btn-primary:hover { background: var(--green-dark); }
    .btn-outline { background: transparent; color: var(--text-2); border: 1.5px solid var(--border); }
    .btn-outline:hover { border-color: var(--green); color: var(--green); }
    .nav-count { background: var(--green); color: white; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 10px; min-width: 16px; text-align: center; }

    /* ── Mobile menu ── */
    .mobile-menu-btn {
      display: none; background: none; border: none; cursor: pointer;
      padding: 6px; border-radius: 6px;
    }
    .mobile-menu-btn svg { width: 22px; height: 22px; stroke: var(--text); fill: none; stroke-width: 2; display: block; }
    .mobile-nav {
      display: none; position: fixed; top: 64px; left: 0; right: 0;
      background: var(--white); border-bottom: 1px solid var(--border);
      padding: 16px; z-index: 99; flex-direction: column; gap: 4px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }
    .mobile-nav.open { display: flex; }
    .mobile-nav a { font-size: 15px; color: var(--text-2); padding: 10px 14px; border-radius: var(--radius); }
    .mobile-nav a:hover { background: var(--surface); }
    .mobile-nav .btn-primary { text-align: center; justify-content: center; margin-top: 8px; }

    /* ── Page header ── */
    .page-header {
      background: var(--white); border-bottom: 1px solid var(--border);
      padding: 24px 32px 0;
    }
    .page-header h1 { font-family: 'Playfair Display', serif; font-size: 28px; color: var(--text); margin-bottom: 4px; }
    .page-header p { font-size: 14px; color: var(--text-3); margin-bottom: 20px; }

    .header-search { display: flex; gap: 8px; flex-wrap: wrap; padding-bottom: 20px; }
    .header-search input {
      flex: 1; min-width: 200px; padding: 9px 14px; border-radius: var(--radius);
      border: 1.5px solid var(--border); font-size: 14px; color: var(--text); outline: none;
      background: var(--surface); transition: border-color .15s;
    }
    .header-search input:focus { border-color: var(--green); background: white; }
    .header-search button {
      padding: 9px 20px; background: var(--green); color: white; border-radius: var(--radius);
      font-size: 14px; font-weight: 500; transition: background .15s;
    }
    .header-search button:hover { background: var(--green-dark); }

    /* ── Layout ── */
    .layout { display: grid; grid-template-columns: 280px 1fr; gap: 0; min-height: calc(100vh - 200px); }

    /* ── Sidebar filters ── */
    .sidebar {
      background: var(--white); border-right: 1px solid var(--border);
      padding: 24px 20px; position: sticky; top: 64px;
      height: calc(100vh - 64px); overflow-y: auto;
    }
    .sidebar::-webkit-scrollbar { width: 4px; }
    .sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

    .filter-section { margin-bottom: 28px; }
    .filter-label { font-size: 11px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; display: block; }
    .filter-reset { float: right; font-size: 11px; color: var(--green); cursor: pointer; text-transform: none; letter-spacing: 0; font-weight: 500; }
    .filter-reset:hover { text-decoration: underline; }

    .check-list { display: flex; flex-direction: column; gap: 6px; }
    .check-item { display: flex; align-items: center; gap: 8px; cursor: pointer; }
    .check-item input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--green); cursor: pointer; }
    .check-item label { font-size: 13px; color: var(--text-2); cursor: pointer; flex: 1; }
    .check-item .check-count { font-size: 12px; color: var(--text-3); }

    .amen-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; }

    .county-select {
      width: 100%; padding: 9px 12px; border: 1.5px solid var(--border); border-radius: var(--radius);
      font-size: 13px; color: var(--text); background: white; outline: none; cursor: pointer; margin-bottom: 10px;
    }
    .county-select:focus { border-color: var(--green); }
    .area-hint { font-size: 12px; color: var(--text-3); }

    .range-row { display: flex; gap: 8px; align-items: center; }
    .range-input {
      flex: 1; padding: 8px 10px; border: 1.5px solid var(--border); border-radius: 8px;
      font-size: 13px; color: var(--text); outline: none; background: var(--surface);
      transition: border-color .15s;
    }
    .range-input:focus { border-color: var(--green); background: white; }
    .range-sep { font-size: 12px; color: var(--text-3); }

    .pill-group { display: flex; flex-wrap: wrap; gap: 6px; }
    .filter-pill {
      font-size: 12px; padding: 5px 12px; border-radius: 20px;
      border: 1.5px solid var(--border); background: white; color: var(--text-2);
      cursor: pointer; transition: all .15s; font-weight: 500;
    }
    .filter-pill:hover, .filter-pill:focus-visible { border-color: var(--green); color: var(--green); }
    .filter-pill:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
    .filter-pill.active { background: var(--green); color: white; border-color: var(--green); }

    .apply-btn {
      width: 100%; padding: 11px; background: var(--green); color: white;
      border-radius: var(--radius); font-size: 14px; font-weight: 600;
      transition: background .15s; margin-top: 8px;
    }
    .apply-btn:hover { background: var(--green-dark); }

    /* ── Main content ── */
    .main { padding: 24px; }

    .toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
    .result-count { font-size: 14px; color: var(--text-2); }
    .result-count strong { color: var(--text); font-weight: 600; }
    .sort-select {
      padding: 8px 12px; border: 1.5px solid var(--border); border-radius: var(--radius);
      font-size: 13px; color: var(--text); background: white; outline: none; cursor: pointer;
    }
    .sort-select:focus { border-color: var(--green); }

    .active-filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
    .filter-tag {
      display: inline-flex; align-items: center; gap: 5px;
      background: var(--green-light); color: var(--green-dark);
      font-size: 12px; font-weight: 500; padding: 4px 10px; border-radius: 20px;
      border: 1px solid #9FE1CB;
    }
    .filter-tag button { background: none; color: var(--green-dark); font-size: 14px; line-height: 1; padding: 0; margin-left: 2px; opacity: .7; }
    .filter-tag button:hover { opacity: 1; }

    .listings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }

    /* ── Horizontal scroll hint (mobile only) ── */
    .scroll-wrap { position: relative; }
    .scroll-hint {
      display: none;
      position: absolute;
      right: 2px;
      top: 50%;
      transform: translateY(-50%);
      width: 34px;
      height: 34px;
      align-items: center;
      justify-content: center;
      pointer-events: auto;
      z-index: 5;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .scroll-hint::before {
      content: '';
      position: absolute;
      inset: -10px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(15,110,86,0.45) 0%, rgba(15,110,86,0) 72%);
      filter: blur(7px);
    }
    .scroll-hint svg {
      position: relative;
      width: 15px;
      height: 15px;
      stroke: var(--green-dark);
      stroke-width: 3;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
      filter: drop-shadow(0 0 3px rgba(255,255,255,0.9));
    }

    .card {
      background: white; border-radius: var(--radius-lg); border: 1px solid var(--border);
      overflow: hidden; transition: transform .2s, box-shadow .2s; cursor: pointer;
    }
    .card:hover, .card:focus-visible { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(0,0,0,0.09); }
    .card:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
    .card-img { height: 180px; background: var(--surface); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .card-img img { width: 100%; height: 100%; object-fit: cover; }
    .card-img-placeholder { display: flex; flex-direction: column; align-items: center; gap: 6px; color: var(--text-3); }
    .card-img-placeholder svg { width: 32px; height: 32px; opacity: .3; stroke: currentColor; fill: none; stroke-width: 1.5; }
    .badge-cat { position: absolute; top: 10px; right: 10px; font-size: 10px; font-weight: 700; padding: 3px 9px; border-radius: 20px; text-transform: capitalize; }
    .badge-cat.apartment { background: var(--green); color: white; }
    .badge-cat.house { background: var(--green-dark); color: white; }
    .badge-cat.boarding { background: var(--green-light); color: var(--green-dark); border: 1px solid var(--green-mid); }
    .badge-cat.airbnb { background: white; color: var(--green-dark); border: 1px solid var(--green); }
    .badge-cat.commercial { background: var(--text); color: white; }
    .card-body { padding: 14px 16px; }
    .card-area { font-size: 11px; font-weight: 600; color: var(--green); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 4px; }
    .card-title { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 3px; line-height: 1.35; }
    .card-sub { font-size: 12px; color: var(--text-3); margin-bottom: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-price { font-size: 17px; font-weight: 700; color: var(--green-dark); margin-bottom: 10px; }
    .card-price span { font-size: 12px; font-weight: 400; color: var(--text-3); }
    .card-meta { display: flex; gap: 12px; font-size: 12px; color: var(--text-2); padding-top: 10px; border-top: 1px solid var(--border); flex-wrap: wrap; }
    .card-meta-item { display: flex; align-items: center; gap: 4px; }
    .card-meta-item svg { width: 13px; height: 13px; stroke: var(--text-3); fill: none; stroke-width: 2; }

    /* ── Expanded card additions: carousel, status pill, room types, amenities, inline inquiry ── */
    .card-carousel-arrow {
      position: absolute; top: 50%; transform: translateY(-50%); width: 30px; height: 30px; border-radius: 50%;
      background: rgba(255,255,255,0.92); border: none; display: flex; align-items: center; justify-content: center;
      cursor: pointer; z-index: 3; transition: background .15s;
    }
    .card-carousel-arrow:hover { background: white; }
    .card-carousel-arrow svg { width: 14px; height: 14px; stroke: var(--text); fill: none; stroke-width: 2.5; }
    .card-carousel-arrow.prev { left: 8px; }
    .card-carousel-arrow.next { right: 8px; }
    .card-photo-counter { position: absolute; bottom: 8px; right: 10px; background: rgba(0,0,0,0.55); color: white; font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 20px; z-index: 2; }
    .card-photo-dots { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); display: flex; gap: 3px; z-index: 2; }
    .card-photo-dots span { width: 4px; height: 4px; border-radius: 50%; background: rgba(255,255,255,0.5); }
    .card-photo-dots span.active { background: white; }
    .card-status-pill { position: absolute; top: 10px; left: 10px; z-index: 2; display: flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 700; padding: 3px 9px; border-radius: 20px; background: white; color: var(--green-dark); }
    .card-status-pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--green); flex-shrink: 0; }
    .card-status-pill.low::before { background: var(--text-3); }
    .card-status-pill.low { color: var(--text-2); }

    .card-roomtypes { display: grid; grid-template-columns: repeat(auto-fit, minmax(72px, 1fr)); gap: 6px; margin-bottom: 10px; }
    .card-roomtype-chip { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 6px 8px; text-align: left; }
    .card-roomtype-chip .rt-label { font-size: 10.5px; font-weight: 600; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-roomtype-chip .rt-price { font-size: 12px; font-weight: 700; color: var(--green-dark); margin-top: 1px; }

    .card-specs-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
    .card-spec-chip { display: flex; align-items: center; gap: 4px; background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 4px 9px; font-size: 11px; color: var(--text-2); font-weight: 500; }
    .card-spec-chip svg { width: 12px; height: 12px; stroke: var(--text-3); fill: none; stroke-width: 2; }

    .card-amenities { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; padding-top: 10px; border-top: 1px solid var(--border); }
    .card-amenity-chip { background: var(--green-light); color: var(--green-dark); border-radius: 20px; padding: 3px 9px; font-size: 10.5px; font-weight: 600; }
    .card-amenity-chip.more { background: var(--surface); color: var(--text-3); border: 1px solid var(--border); }

    .card-inquire-btn {
      width: 100%; display: flex; align-items: center; justify-content: center; gap: 7px;
      padding: 10px; border-radius: var(--radius); background: var(--green); color: white;
      font-size: 13px; font-weight: 600; transition: background .15s;
    }
    .card-inquire-btn:hover { background: var(--green-dark); }
    .card-inquire-btn svg { width: 14px; height: 14px; stroke: white; fill: none; stroke-width: 2; }
    .card-inquire-btn.sent { background: white; color: var(--green-dark); border: 1.5px solid var(--green); }
    .card-inquire-btn.sent:hover { background: var(--green-light); }
    .card-inquire-btn.sent svg { stroke: var(--green-dark); }

    .ci-success { display: none; text-align: center; padding: 10px 0 4px; }
    .ci-success-icon { width: 46px; height: 46px; background: var(--green-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; }
    .ci-success-icon svg { width: 22px; height: 22px; stroke: var(--green); fill: none; stroke-width: 2.5; }
    .ci-success h4 { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
    .ci-success p { font-size: 13px; color: var(--text-3); }

    .skeleton { background: white; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); }
    .skeleton-img { height: 180px; background: linear-gradient(90deg, #f0efe9 25%, #e8e7e1 50%, #f0efe9 75%); background-size: 200% 100%; animation: shimmer 1.4s infinite; }
    .skeleton-body { padding: 14px 16px; }
    .skeleton-line { height: 11px; background: linear-gradient(90deg, #f0efe9 25%, #e8e7e1 50%, #f0efe9 75%); background-size: 200% 100%; animation: shimmer 1.4s infinite; border-radius: 4px; margin-bottom: 9px; }
    .skeleton-line.short { width: 55%; }
    .skeleton-line.xshort { width: 35%; }
    @keyframes shimmer { to { background-position: -200% 0; } }

    .empty-state { text-align: center; padding: 80px 20px; color: var(--text-3); grid-column: 1/-1; }
    .empty-state svg { width: 48px; height: 48px; margin: 0 auto 16px; stroke: var(--border); fill: none; stroke-width: 1.5; }
    .empty-state h3 { font-size: 16px; font-weight: 600; color: var(--text-2); margin-bottom: 6px; }
    .empty-state p { font-size: 14px; }
    .empty-state a { color: var(--green); font-weight: 500; }

    .pagination { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 32px; }
    .page-btn {
      width: 36px; height: 36px; border-radius: 8px; border: 1.5px solid var(--border);
      background: white; color: var(--text-2); font-size: 13px; font-weight: 500;
      cursor: pointer; transition: all .15s; display: flex; align-items: center; justify-content: center;
    }
    .page-btn:hover { border-color: var(--green); color: var(--green); }
    .page-btn.active { background: var(--green); color: white; border-color: var(--green); }
    .page-btn:disabled { opacity: .4; cursor: not-allowed; }

    .filter-toggle {
      display: none; align-items: center; gap: 6px;
      padding: 8px 14px; border-radius: var(--radius); border: 1.5px solid var(--border);
      background: white; font-size: 13px; font-weight: 500; color: var(--text);
    }
    .filter-toggle svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 199; }
    .sidebar-overlay.open { display: block; }

    .notify-strip {
      position: relative;
      margin-top: 28px;
      background: linear-gradient(135deg, var(--green-light), #eef8f2);
      border: 1.5px dashed var(--green-mid);
      border-radius: var(--radius-lg);
      padding: 18px 22px;
    }
    .notify-strip-close {
      position: absolute; top: 8px; right: 10px; background: none; border: none;
      color: var(--text-3); cursor: pointer; font-size: 14px; padding: 4px;
    }
    .notify-strip-close:hover { color: var(--text); }
    .notify-strip-inner { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .notify-strip-icon { font-size: 26px; flex-shrink: 0; }
    .notify-strip-text { flex: 1; min-width: 220px; }
    .notify-strip-text strong { display: block; font-size: 14.5px; color: var(--green-dark); margin-bottom: 2px; }
    .notify-strip-text span { font-size: 13px; color: var(--text-2); }

    .notify-modal-overlay {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45);
      z-index: 500; align-items: center; justify-content: center; padding: 20px;
    }
    .notify-modal-overlay.open { display: flex; }
    .notify-modal {
      background: white; border-radius: var(--radius-lg); max-width: 520px; width: 100%;
      max-height: 90vh; overflow-y: auto; box-shadow: 0 8px 40px rgba(0,0,0,0.18);
    }
    .notify-modal-head {
      padding: 20px 24px 14px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; background: white; z-index: 2;
    }
    .notify-modal-head h3 { font-size: 17px; font-weight: 600; color: var(--text); font-family: 'Playfair Display', serif; }
    .notify-modal-close { background: none; border: none; font-size: 20px; color: var(--text-3); cursor: pointer; padding: 2px 6px; }
    .notify-modal-close:hover { color: var(--text); }
    .notify-modal-body { padding: 20px 24px; }
    .notify-modal-sub { font-size: 13px; color: var(--text-3); margin-bottom: 18px; line-height: 1.6; }
    .nf-field { margin-bottom: 16px; }
    .nf-field label { display: block; font-size: 12px; font-weight: 600; color: var(--text-2); margin-bottom: 6px; }
    .nf-optional { font-weight: 400; color: var(--text-3); font-size: 11px; }
