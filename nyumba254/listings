    .listings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 16px; align-items: stretch; }
    .card { position: relative; display: flex; flex-direction: column; background: white; border: 1px solid var(--border); border-radius: 18px; overflow: hidden; transition: transform .2s ease, box-shadow .2s ease; box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 4px 14px rgba(15,110,86,.07); }
