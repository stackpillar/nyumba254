<script defer>
document.addEventListener('DOMContentLoaded', nkListingsInit);

/* ---------------- state ---------------- */
let PAGE_SIZE = 12;
let currentPage = 1;
let totalCount = 0;
let debounceTimer = null;
let nkRequestId = 0;
let nkMobileMode = false;
let nkResponsiveModeInitialized = false;
let nkHasMorePages = true;
let nkLoadingMore = false;
let nkLastListings = [];
let nkMobileAccum = [];
const cardPhotoIndex = {};
const cardDataById = {};
let ciActiveListingId = null;
let nkCompareIds = new Set();

function nkListingsInit() {
  document.getElementById('footer-year').textContent = new Date().getFullYear();
  nkPopulateCountySelect();
  nkPopulateFooterCounties();
  renderAreaChecklist('');
  renderAmenityChecks();
  renderPricePresets();
  renderCatTabs();
  readUrlParams();
  toggleGroupFilters(document.querySelector('#cat-pills .filter-pill.active')?.dataset.val || '');
  nkInitDataSaver();
  nkApplyResponsiveMode();
  nkResponsiveModeInitialized = true; // A11: avoid the double fetch on first mobile load
  nkBuildQuickFilterBar();
  nkBuildStickyCompactSearch();
  nkRenderRecentlyViewedStrip();
  nkInitScrollTop();
  nkInitSidebarToggle();
  nkInitAccountNav(['nav-account-link', 'mobile-account-link']);
  nkTrackPageView();
  nkMakeClickablesKeyboardAccessible();
  nkBindRecentViewedTracking(document.getElementById('listings-grid'));
  nkBindRecentViewedTracking(document.getElementById('nk-recent-strip-mount'));
  applyFilters();
  window.addEventListener('resize', nkApplyResponsiveMode);
  window.addEventListener('pageshow', (e) => { if (e.persisted) restoreResultsScroll(); }); // B4: bfcache restore
  restoreResultsScroll();

  // A3: event delegation instead of onclick="fn('county-or-area-with-apostrophe')"
  nkDelegate(document.getElementById('cat-pills'), '.filter-pill', el => setPill(el, 'cat-pills'));
  nkDelegate(document.getElementById('type-pills'), '.filter-pill', el => setPill(el, 'type-pills'));
  nkDelegate(document.getElementById('bed-pills'), '.filter-pill', el => setPill(el, 'bed-pills'));
  nkDelegate(document.getElementById('furn-pills'), '.filter-pill', el => setPill(el, 'furn-pills'));
  nkDelegate(document.getElementById('nf-type-pills'), '.filter-pill', el => nfSetPill(el, 'nf-type-pills'));
  nkDelegate(document.getElementById('nf-cat-pills'), '.filter-pill', el => nfSetPill(el, 'nf-cat-pills'));
  nkDelegate(document.getElementById('nf-bed-pills'), '.filter-pill', el => nfSetPill(el, 'nf-bed-pills'));
  nkDelegate(document.getElementById('active-filters'), '[data-remove-key]', el => removeTag(el.dataset.removeKey));
  nkDelegate(document.getElementById('active-filters'), '[data-clear-all]', () => resetAllFilters());
  nkDelegate(document.getElementById('cat-tabs'), '.cat-tab', el => { setPill(document.querySelector(`#cat-pills .filter-pill[data-val="${CSS.escape(el.dataset.val)}"]`), 'cat-pills'); });

  document.getElementById('search-q').addEventListener('input', e => { nkFormatSearchInput(e.target); });
}

/* ---------- E: aria-pressed-aware pill wiring ---------- */
document.addEventListener('keydown', e => {
  if ((e.key === 'Enter' || e.key === ' ') && e.target.classList && e.target.classList.contains('filter-pill')) {
    e.preventDefault(); e.target.click();
  }
});

function renderAmenityChecks() {
  document.getElementById('amen-checks').innerHTML = NK_AMENITIES.map(a => `
    <div class="check-item"><input type="checkbox" id="amen-${a.key}" value="${a.key}" onchange="applyFilters()"/><label for="amen-${a.key}">${escHtml(a.label)}</label></div>`).join('');
}

function renderPricePresets() {
  const el = document.getElementById('price-presets');
  el.innerHTML = `
    <div class="filter-pill" data-min="0" data-max="10000">Under 10K</div>
    <div class="filter-pill" data-min="10000" data-max="30000">10K–30K</div>
    <div class="filter-pill" data-min="30000" data-max="80000">30K–80K</div>
    <div class="filter-pill" data-min="80000" data-max="">80K+</div>`;
  nkDelegate(el, '.filter-pill', pill => setPreset(pill.dataset.min ? Number(pill.dataset.min) : 0, pill.dataset.max ? Number(pill.dataset.max) : null, pill));
}

/* C: category tabs above results, mirrored with the sidebar pills */
function renderCatTabs() {
  const el = document.getElementById('cat-tabs');
  const opts = [['', 'All'], ...Object.entries(NK_CATEGORIES).map(([k, v]) => [k, v.label])];
  el.innerHTML = opts.map(([val, label]) => `<button type="button" class="cat-tab ${val === '' ? 'active' : ''}" data-val="${escHtml(val)}" role="tab">${escHtml(label)}</button>`).join('');
}
function syncCatTabs(activeVal) {
  document.querySelectorAll('#cat-tabs .cat-tab').forEach(t => t.classList.toggle('active', t.dataset.val === activeVal));
}

/* ---------- county/area select ---------- */
function nkPopulateCountySelect() {
  const sel = document.getElementById('county-select');
  if (!sel) return;
  sel.innerHTML = '<option value="">All counties</option>' + NK_COUNTIES.map(c => `<option value="${escHtml(c)}">${escHtml(nkCountyLabel(c))}</option>`).join('');
}
function nkPopulateFooterCounties() {
  const el = document.getElementById('footer-counties');
  if (!el) return;
  el.innerHTML = NK_COUNTIES.map(county => {
    const hasAreas = nkAreaCountFor(county) > 0;
    const href = hasAreas ? `/listings?county=${encodeURIComponent(county)}` : '#'; // E: absolute path, was listings.html?county=
    return `<a href="${href}">${escHtml(nkCountyLabel(county))}</a>`;
  }).join('');
}

function renderAreaChecklist(county) {
  const hint = document.getElementById('area-hint');
  const visible = document.getElementById('area-checks-visible');
  const more = document.getElementById('area-checks-more');
  const toggleBtn = document.getElementById('area-more-toggle');
  const areas = NK_AREAS_BY_COUNTY[county] || [];

  if (!county) {
    hint.style.display = 'block'; hint.textContent = 'Pick a county above to filter by area';
    visible.innerHTML = ''; more.innerHTML = ''; more.style.display = 'none'; toggleBtn.style.display = 'none';
    return;
  }
  if (!areas.length) {
    hint.style.display = 'block'; hint.textContent = 'No areas listed yet for this county';
    visible.innerHTML = ''; more.innerHTML = ''; more.style.display = 'none'; toggleBtn.style.display = 'none';
    return;
  }
  hint.style.display = 'none';
  const shown = areas.slice(0, 8);
  const rest = areas.slice(8);
  // E: one <label for="id"> per checkbox instead of a label nested in a label
  const checkHtml = a => { const id = 'area-' + a.replace(/[^a-z0-9]/gi, '-'); return `<div class="check-item"><input type="checkbox" id="${id}" value="${escHtml(a)}" onchange="applyFilters()"/><label for="${id}">${escHtml(a)}</label></div>`; };
  visible.innerHTML = shown.map(checkHtml).join('');
  more.innerHTML = rest.map(checkHtml).join('');
  more.style.display = 'none';
  if (rest.length) {
    toggleBtn.style.display = 'inline';
    toggleBtn.textContent = `Show all ${areas.length} areas ▾`;
    toggleBtn.dataset.total = areas.length;
  } else {
    toggleBtn.style.display = 'none';
  }
}

function handleCountyFilterChange() {
  const county = document.getElementById('county-select').value;
  renderAreaChecklist(county);
  applyFilters();
}
function nkSidebarNearMe() {
  nkUseNearMe(
    (county) => { document.getElementById('county-select').value = county; handleCountyFilterChange(); },
    (msg) => alert(msg)
  );
}

function toggleMoreAreas() {
  const more = document.getElementById('area-checks-more');
  const btn = document.getElementById('area-more-toggle');
  const total = btn.dataset.total || '';
  const isHidden = more.style.display === 'none';
  more.style.display = isHidden ? '' : 'none';
  btn.textContent = isHidden ? 'Show fewer areas ▴' : `Show all ${total} areas ▾`;
}

function readUrlParams() {
  const p = nkParseListingsParams();
  if (p.q) { const el = document.getElementById('search-q'); el.value = p.q; nkFormatSearchInput(el); }

  let county = p.county || '';
  if (!county && p.area && p.area[0]) county = NK_AREA_TO_COUNTY_GUESS[p.area[0]] || '';
  if (county) { document.getElementById('county-select').value = county; renderAreaChecklist(county); }

  if (p.area) {
    p.area.forEach(a => {
      const cb = document.querySelector(`#area-checks input[value="${CSS.escape(a)}"]`);
      if (cb) cb.checked = true;
      else if (document.querySelector(`#area-checks-more input[value="${CSS.escape(a)}"]`)) toggleMoreAreas();
    });
  }
  if (p.category) {
    document.querySelectorAll('#cat-pills .filter-pill').forEach(pill => { const m = pill.dataset.val === p.category; pill.classList.toggle('active', m); nkSetPressed(pill, m); });
    toggleGroupFilters(p.category);
    syncCatTabs(p.category);
  }
  if (p.freq) document.querySelectorAll('#type-pills .filter-pill').forEach(pill => { const m = pill.dataset.val === p.freq; pill.classList.toggle('active', m); nkSetPressed(pill, m); });
  if (p.beds) document.querySelectorAll('#bed-pills .filter-pill').forEach(pill => { const m = pill.dataset.val === p.beds; pill.classList.toggle('active', m); nkSetPressed(pill, m); });
  if (p.furn) document.querySelectorAll('#furn-pills .filter-pill').forEach(pill => { const m = pill.dataset.val === p.furn; pill.classList.toggle('active', m); nkSetPressed(pill, m); });
  if (p.minPrice) document.getElementById('price-min').value = p.minPrice;
  if (p.maxPrice) document.getElementById('price-max').value = p.maxPrice;
  if (p.amen) p.amen.forEach(k => { const cb = document.querySelector(`#amen-checks input[value="${CSS.escape(k)}"]`); if (cb) cb.checked = true; });
  if (p.sort) document.getElementById('sort-select').value = p.sort;
  if (p.page) currentPage = parseInt(p.page, 10) || 1;
  if (p.view === 'map') setTimeout(() => nkSetViewSegment('map'), 0);
}

function setPill(el, groupId) {
  document.querySelectorAll(`#${groupId} .filter-pill`).forEach(p => { p.classList.remove('active'); nkSetPressed(p, false); });
  el.classList.add('active'); nkSetPressed(el, true);
  if (groupId === 'cat-pills') { toggleGroupFilters(el.dataset.val); syncCatTabs(el.dataset.val); }
  applyFilters();
  nkSyncQuickChipLabels();
}

function toggleGroupFilters(cat) {
  const meta = NK_CATEGORIES[cat];
  const group = meta ? meta.group : '';
  const bedSection = document.getElementById('bedrooms-filter-section');
  const furnSection = document.getElementById('furnished-filter-section');
  if (group === 'boarding' || group === 'commercial') {
    setPillSilent(document.querySelector('#bed-pills .filter-pill[data-val=""]'), 'bed-pills');
    bedSection.style.display = 'none';
  } else { bedSection.style.display = ''; }
  if (group === 'boarding' || group === 'airbnb' || group === 'commercial') {
    setPillSilent(document.querySelector('#furn-pills .filter-pill[data-val=""]'), 'furn-pills');
    furnSection.style.display = 'none';
  } else { furnSection.style.display = ''; }
}
function setPillSilent(el, groupId) {
  document.querySelectorAll(`#${groupId} .filter-pill`).forEach(p => { p.classList.remove('active'); nkSetPressed(p, false); });
  el.classList.add('active'); nkSetPressed(el, true);
}

function clearPricePresetActive() { document.querySelectorAll('#price-presets .filter-pill').forEach(p => p.classList.remove('active')); }
function setPreset(min, max, el) {
  document.getElementById('price-min').value = min || '';
  document.getElementById('price-max').value = max ?? '';
  clearPricePresetActive();
  if (el) el.classList.add('active');
  applyFilters();
  nkSyncQuickChipLabels();
}

let nkSaveSearchDismissed = false;
function nkMaybeSuggestSaveSearch(tagCount) {
  const el = document.getElementById('nk-save-search-banner');
  if (!el) return;
  if (nkSaveSearchDismissed || tagCount < 3 || totalCount === 0 || totalCount > 3) { el.innerHTML = ''; return; }
  el.innerHTML = `<div style="background:var(--green-light);border:1.5px dashed var(--green-mid);border-radius:10px;padding:10px 14px;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;font-size:13px;color:var(--green-dark)">
    <span>🔍 Only ${totalCount} match${totalCount !== 1 ? 'es' : ''} your filters — want us to notify you if more come up?</span>
    <span style="display:flex;gap:8px">
      <button onclick="openNotifyModal()" style="background:var(--green);color:#fff;border:none;padding:7px 14px;border-radius:8px;font-size:12.5px;font-weight:600;cursor:pointer">Save this search</button>
      <button onclick="nkSaveSearchDismissed=true;document.getElementById('nk-save-search-banner').innerHTML=''" style="background:none;border:none;color:var(--green-dark);font-size:12.5px;cursor:pointer;text-decoration:underline">Dismiss</button>
    </span>
  </div>`;
}

function nkFormatSearchInput(el) {
  const raw = el.value;
  const stripped = raw.replace(/^KES\s?/i, '').replace(/,/g, '').trim();
  if (stripped.length && /^[0-9]+$/.test(stripped)) {
    const caretFromEnd = el.value.length - el.selectionEnd;
    el.value = 'KES ' + Number(stripped).toLocaleString('en-KE');
    const newPos = Math.max(0, el.value.length - caretFromEnd);
    el.setSelectionRange(newPos, newPos);
    el.dataset.priceValue = stripped;
  } else {
    delete el.dataset.priceValue;
  }
  debouncedApply();
}

(function () {
  let ptrStartY = null, ptrPulling = false, ptrEl = null;
  function ptrEnsureEl() {
    if (ptrEl) return ptrEl;
    ptrEl = document.createElement('div');
    ptrEl.id = 'nk-ptr-indicator';
    ptrEl.style.cssText = 'position:fixed;top:0;left:0;right:0;text-align:center;font-size:12.5px;font-weight:600;color:var(--green-dark);background:var(--green-light);padding:8px 0;transform:translateY(-100%);transition:transform .2s ease;z-index:500';
    ptrEl.textContent = '↓ Pull to refresh listings';
    document.body.appendChild(ptrEl);
    return ptrEl;
  }
  document.addEventListener('touchstart', e => {
    if (window.innerWidth > 768 || window.scrollY > 4) return;
    ptrStartY = e.touches[0].clientY; ptrPulling = true;
  }, { passive: true });
  document.addEventListener('touchmove', e => {
    if (!ptrPulling || ptrStartY === null) return;
    const dy = e.touches[0].clientY - ptrStartY;
    if (dy > 12) {
      const el = ptrEnsureEl();
      el.style.transform = 'translateY(0)';
      el.textContent = dy > 70 ? '↻ Release to refresh' : '↓ Pull to refresh listings';
    }
  }, { passive: true });
  document.addEventListener('touchend', () => {
    if (!ptrPulling) return;
    if (ptrEl) {
      const wasFar = ptrEl.textContent.includes('Release');
      ptrEl.style.transform = 'translateY(-100%)';
      if (wasFar) applyFilters(1);
    }
    ptrPulling = false; ptrStartY = null;
  }, { passive: true });
})();

function getFilters() {
  const freq = document.querySelector('#type-pills .filter-pill.active')?.dataset.val || '';
  const cat  = document.querySelector('#cat-pills .filter-pill.active')?.dataset.val || '';
  const beds = document.querySelector('#bed-pills .filter-pill.active')?.dataset.val || '';
  const furn = document.querySelector('#furn-pills .filter-pill.active')?.dataset.val || '';
  const county = document.getElementById('county-select')?.value || '';
  const areas = [...document.querySelectorAll('#area-checks input:checked')].map(c => c.value);
  const amenities = [...document.querySelectorAll('#amen-checks input:checked')].map(c => c.value);
  const priceMin = document.getElementById('price-min').value;
  const priceMax = document.getElementById('price-max').value;
  const searchEl = document.getElementById('search-q');
  const q = searchEl.value.trim();
  const priceExact = searchEl.dataset.priceValue ? Number(searchEl.dataset.priceValue) : null;
  const sort = document.getElementById('sort-select').value;
  const includeOccupied = document.getElementById('include-occupied-toggle')?.checked || false;
  return { freq, cat, beds, furn, county, areas, amenities, priceMin, priceMax, q, priceExact, sort, includeOccupied };
}

/* B1: filters -> URL, using the contract shared with index.html */
function nkFiltersToUrlObject(f) {
  return {
    category: f.cat, freq: f.freq, county: f.county, area: f.areas,
    minPrice: f.priceMin, maxPrice: f.priceMax, beds: f.beds,
    furn: f.furn, amen: f.amenities, q: f.priceExact !== null ? '' : f.q,
    sort: f.sort !== 'created_at_desc' ? f.sort : '',
    page: currentPage > 1 ? String(currentPage) : '',
    view: nkMapOpen ? 'map' : ''
  };
}

function nkUpdatePageHeading(f) {
  const parts = [];
  if (f.cat && NK_CATEGORIES[f.cat]) parts.push(NK_CATEGORIES[f.cat].label + ' listings');
  if (f.county) parts.push('in ' + nkCountyLabel(f.county));
  const heading = parts.length ? parts.join(' ') : 'Browse listings';
  document.getElementById('page-title').textContent = heading;
  document.getElementById('page-desc').textContent = parts.length ? `${heading} — verified listings on Nyumba254` : 'Apartments, houses, boarding houses and Airbnb rentals across Kenya';
  const title = parts.length ? heading + ' — Nyumba254' : 'Browse Listings — Nyumba254';
  document.title = title;
  document.getElementById('page-doc-title').textContent = title;
  const desc = parts.length ? `${heading} on Nyumba254 — no agents, no commission.` : 'Browse apartments, houses, boarding houses and Airbnb rentals across Kenya. Filter by county, area, price, category and more.';
  document.getElementById('page-doc-desc').setAttribute('content', desc);
  // E/SEO: canonical + JSON-LD reflect the active filter combo client-side.
  // A true clean route (e.g. /listings/kisumu/apartments) needs server-side
  // rewrites/prerendering — out of scope for a static file (see nk-shared.js notes).
  const canonicalUrl = 'https://nyumba254.com' + nkBuildListingsUrl(nkFiltersToUrlObject(f));
  document.getElementById('nk-canonical').setAttribute('href', canonicalUrl);
  nkRenderBreadcrumb(f);
  nkUpdateJsonLd(f);
}

function nkUpdateJsonLd(f) {
  const items = [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nyumba254.com/' }];
  let pos = 2;
  items.push({ '@type': 'ListItem', position: pos++, name: 'Listings', item: 'https://nyumba254.com/listings' });
  if (f.cat && NK_CATEGORIES[f.cat]) items.push({ '@type': 'ListItem', position: pos++, name: NK_CATEGORIES[f.cat].label });
  if (f.county) items.push({ '@type': 'ListItem', position: pos++, name: nkCountyLabel(f.county) });
  const el = document.getElementById('nk-jsonld-breadcrumb');
  if (el) el.textContent = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items });
}

function nkRenderBreadcrumb(f) {
  const el = document.getElementById('nk-breadcrumb');
  if (!el) return;
  const crumbs = [{ label: 'Home', href: '/' }, { label: 'Listings', href: (f.cat || f.county) ? '/listings' : null }];
  if (f.cat && NK_CATEGORIES[f.cat]) crumbs.push({ label: NK_CATEGORIES[f.cat].label, href: null });
  if (f.county) crumbs.push({ label: nkCountyLabel(f.county), href: null });
  el.innerHTML = crumbs.map((c, i) => {
    const isLast = i === crumbs.length - 1;
    const sep = i > 0 ? '<span class="nk-crumb-sep">/</span>' : '';
    const content = (c.href && !isLast) ? `<a href="${c.href}">${escHtml(c.label)}</a>` : `<span class="${isLast ? 'nk-crumb-current' : ''}">${escHtml(c.label)}</span>`;
    return sep + content;
  }).join('');
}

function renderActiveTags(f) {
  nkUpdatePageHeading(f);
  const tags = [];
  if (f.cat && NK_CATEGORIES[f.cat]) tags.push({ label: NK_CATEGORIES[f.cat].label, key: 'cat' });
  if (f.freq && NK_FREQ_TAG_LABEL[f.freq]) tags.push({ label: NK_FREQ_TAG_LABEL[f.freq], key: 'freq' });
  // A9: label now matches the actual query — only the open-ended "4" bucket gets a "+"
  if (f.beds !== '') tags.push({ label: f.beds === '0' ? 'Studio' : (f.beds === '4' ? '4+ beds' : `${f.beds} bed${f.beds === '1' ? '' : 's'}`), key: 'beds' });
  if (f.furn === 'true') tags.push({ label: 'Furnished', key: 'furn' });
  if (f.furn === 'false') tags.push({ label: 'Unfurnished', key: 'furn' });
  if (f.county && !f.areas.length) tags.push({ label: nkCountyLabel(f.county), key: 'county' });
  f.areas.forEach(a => tags.push({ label: a, key: 'area-' + a }));
  f.amenities.forEach(a => { const def = NK_AMENITIES.find(x => x.key === a); tags.push({ label: def ? def.label : a, key: 'amen-' + a }); });
  if (f.priceMin || f.priceMax) {
    const label = f.priceMin && f.priceMax
      ? `KES ${Number(f.priceMin).toLocaleString()} – ${Number(f.priceMax).toLocaleString()}`
      : f.priceMin ? `From KES ${Number(f.priceMin).toLocaleString()}` : `Up to KES ${Number(f.priceMax).toLocaleString()}`;
    tags.push({ label, key: 'price' });
  }
  if (f.priceExact !== null) tags.push({ label: `≈ KES ${f.priceExact.toLocaleString()} (±15%)`, key: 'q' });
  else if (f.q) tags.push({ label: `"${f.q}"`, key: 'q' });

  const el = document.getElementById('active-filters');
  // A3: data-remove-key + delegation instead of onclick="removeTag('area-Archer's Post')"
  let html = tags.map(t => `<span class="filter-tag">${escHtml(t.label)}<button data-remove-key="${escHtml(t.key)}" title="Remove filter">×</button></span>`).join('');
  if (tags.length) html += `<button class="clear-all-chip" data-clear-all>Clear all</button>`; // C: mobile "Clear all" chip
  el.innerHTML = html;
  const badge = document.getElementById('nk-filter-count-badge');
  if (badge) { badge.textContent = tags.length; badge.classList.toggle('visible', tags.length > 0); }
  nkMaybeSuggestSaveSearch(tags.length);
}

function nkToggleCompare(id, checked, ev) {
  if (checked) {
    if (nkCompareIds.size >= 3) {
      alert('You can compare up to 3 listings at a time.');
      if (ev && ev.target) ev.target.checked = false;
      return;
    }
    nkCompareIds.add(id);
  } else { nkCompareIds.delete(id); }
  nkRenderCompareBar();
}

function nkRenderCompareBar() {
  let bar = document.getElementById('nk-compare-bar');
  if (!bar) {
    bar = document.createElement('div');
    bar.id = 'nk-compare-bar';
    bar.className = 'nk-compare-bar';
    bar.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:600;background:var(--green-dark);color:#fff;padding:12px 20px;display:none;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;box-shadow:0 -4px 16px rgba(0,0,0,0.2)';
    document.body.appendChild(bar);
  }
  if (!nkCompareIds.size) { bar.style.display = 'none'; return; }
  bar.style.display = 'flex';
  bar.innerHTML = `<span style="font-size:13.5px;font-weight:600">${nkCompareIds.size} listing${nkCompareIds.size !== 1 ? 's' : ''} selected to compare</span>
    <span style="display:flex;gap:10px">
      <button id="nk-compare-clear-btn" style="background:rgba(255,255,255,0.15);color:#fff;border:none;padding:8px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer">Clear</button>
      <button id="nk-compare-now-btn" style="background:#fff;color:var(--green-dark);border:none;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer" ${nkCompareIds.size < 2 ? 'disabled' : ''}>Compare now</button>
    </span>`;
  document.getElementById('nk-compare-clear-btn').onclick = () => { nkCompareIds.clear(); nkRenderCompareBar(); document.querySelectorAll('.nk-compare-check input').forEach(c => c.checked = false); };
  document.getElementById('nk-compare-now-btn').onclick = nkOpenCompareModal;
}

function nkOpenCompareModal() {
  const ids = [...nkCompareIds];
  const listings = ids.map(id => cardDataById[id]).filter(Boolean);
  if (listings.length < 2) return;
  let modal = document.getElementById('nk-compare-modal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'nk-compare-modal';
    modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:700;display:flex;align-items:center;justify-content:center;padding:20px';
    modal.onclick = (e) => { if (e.target === modal) modal.style.display = 'none'; };
    document.body.appendChild(modal);
  }
  const bedroomsOf = l => (l.details && l.details.bedrooms != null) ? Number(l.details.bedrooms) : null;
  const pricePerBed = l => { const b = bedroomsOf(l); return (b && b > 0) ? `KES ${Math.round(l.price / b).toLocaleString('en-KE')}/bed` : '—'; };
  const amenSet = l => new Set(Array.isArray(l.amenities) ? l.amenities : []);
  const rows = [
    ['Title', l => escHtml(l.title)],
    ['Area', l => escHtml(l.area)],
    ['Price', l => formatPrice(l).replace(/<[^>]+>/g, '')],
    ['Category', l => escHtml((NK_CATEGORIES[l.category] || {}).label || l.category)],
    ['Bedrooms', l => (bedroomsOf(l) != null) ? (bedroomsOf(l) === 0 ? 'Studio' : bedroomsOf(l)) : '—'],
    ['Bathrooms', l => (l.details && l.details.bathrooms) || '—'],
    ['Price / bedroom', l => pricePerBed(l)],
    ['Amenities', l => (l.amenities || []).length ? escHtml((l.amenities || []).map(k => (NK_AMENITIES.find(a => a.key === k) || {}).label).filter(Boolean).join(', ')) : '—'],
  ];
  // Amenities-diff: highlight amenities not shared by all compared listings
  const allSets = listings.map(amenSet);
  const common = allSets.reduce((acc, s) => new Set([...acc].filter(x => s.has(x))), allSets[0] || new Set());
  const diffRow = listings.some(l => amenSet(l).size)
    ? `<tr><td style="padding:8px;font-weight:600;color:var(--text-2);border-bottom:1px solid var(--border)">Unique to this listing</td>${listings.map(l => {
        const uniq = [...amenSet(l)].filter(k => !common.has(k)).map(k => (NK_AMENITIES.find(a => a.key === k) || {}).label).filter(Boolean);
        return `<td style="padding:8px;border-bottom:1px solid var(--border)">${uniq.length ? escHtml(uniq.join(', ')) : '—'}</td>`;
      }).join('')}</tr>` : '';
  modal.innerHTML = `<div style="background:#fff;border-radius:16px;max-width:720px;width:100%;max-height:85vh;overflow:auto;padding:24px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <h3 style="font-family:'Playfair Display',serif;font-size:20px;color:var(--text)">Compare listings</h3>
      <button onclick="document.getElementById('nk-compare-modal').style.display='none'" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-3)">×</button>
    </div>
    <div style="overflow-x:auto">
    <table style="width:100%;border-collapse:collapse;font-size:13px">
      <thead><tr><th style="text-align:left;padding:8px"></th>${listings.map(l => `<th style="text-align:left;padding:8px;border-bottom:2px solid var(--border)">${escHtml(l.title)}</th>`).join('')}</tr></thead>
      <tbody>
        ${rows.map(([label, fn]) => `<tr><td style="padding:8px;font-weight:600;color:var(--text-2);border-bottom:1px solid var(--border)">${label}</td>${listings.map(l => `<td style="padding:8px;border-bottom:1px solid var(--border)">${fn(l)}</td>`).join('')}</tr>`).join('')}
        ${diffRow}
      </tbody>
    </table>
    </div>
  </div>`;
  modal.style.display = 'flex';
}

function removeTag(key) {
  if (key === 'freq') setPill(document.querySelector('#type-pills .filter-pill[data-val=""]'), 'type-pills');
  else if (key === 'cat') setPill(document.querySelector('#cat-pills .filter-pill[data-val=""]'), 'cat-pills');
  else if (key === 'beds') setPill(document.querySelector('#bed-pills .filter-pill[data-val=""]'), 'bed-pills');
  else if (key === 'furn') setPill(document.querySelector('#furn-pills .filter-pill[data-val=""]'), 'furn-pills');
  else if (key === 'county') { document.getElementById('county-select').value = ''; renderAreaChecklist(''); applyFilters(); }
  else if (key.startsWith('area-')) {
    const area = key.slice(5);
    const cb = document.querySelector(`#area-checks input[value="${CSS.escape(area)}"]`);
    if (cb) { cb.checked = false; applyFilters(); }
  } else if (key.startsWith('amen-')) {
    const amen = key.slice(5);
    const cb = document.querySelector(`#amen-checks input[value="${CSS.escape(amen)}"]`);
    if (cb) { cb.checked = false; applyFilters(); }
  } else if (key === 'price') {
    document.getElementById('price-min').value = ''; document.getElementById('price-max').value = '';
    clearPricePresetActive(); applyFilters();
  } else if (key === 'q') {
    const searchEl = document.getElementById('search-q');
    searchEl.value = ''; delete searchEl.dataset.priceValue; applyFilters();
  }
  nkSyncQuickChipLabels();
}

function resetAllFilters() {
  setPillSilent(document.querySelector('#type-pills .filter-pill[data-val=""]'), 'type-pills');
  setPillSilent(document.querySelector('#cat-pills .filter-pill[data-val=""]'), 'cat-pills');
  toggleGroupFilters(''); syncCatTabs('');
  setPillSilent(document.querySelector('#bed-pills .filter-pill[data-val=""]'), 'bed-pills');
  setPillSilent(document.querySelector('#furn-pills .filter-pill[data-val=""]'), 'furn-pills');
  document.getElementById('county-select').value = ''; renderAreaChecklist('');
  document.querySelectorAll('#amen-checks input:checked').forEach(cb => cb.checked = false);
  document.getElementById('price-min').value = ''; document.getElementById('price-max').value = '';
  clearPricePresetActive();
  const searchEl = document.getElementById('search-q');
  searchEl.value = ''; delete searchEl.dataset.priceValue;
  document.getElementById('include-occupied-toggle').checked = false;
  applyFilters();
  nkSyncQuickChipLabels();
}

async function applyFilters(page, append) {
  if (page) currentPage = page; else if (!append) currentPage = 1;
  const requestId = ++nkRequestId;
  const f = getFilters();
  renderActiveTags(f);
  nkSyncUrl(nkFiltersToUrlObject(f)); // B1: address bar always reflects current filters/sort/page/view

  const grid = document.getElementById('listings-grid');
  if (!append) {
    grid.innerHTML = Array(6).fill(`<div class="skeleton"><div class="skeleton-img"></div><div class="skeleton-body"><div class="skeleton-line xshort"></div><div class="skeleton-line"></div><div class="skeleton-line short"></div></div></div>`).join('');
    document.getElementById('result-count').textContent = 'Loading…';
    nkHasMorePages = true;
  }

  let query = db.from('listings').select('*, listing_photos(*), listing_units(*), profiles(verification_status)', { count: 'exact' });
  // B5: active listings only by default; occupied/sold shown only when the
  // toggle is on, and sorted after active ones (handled in the sort clause below).
  query = f.includeOccupied ? query.in('status', ['active', 'occupied']) : query.eq('status', 'active');

  if (f.freq) query = query.eq('price_frequency', f.freq);
  if (f.cat)  query = query.eq('category', f.cat);
  query = nkApplyBedroomFilter(query, f.beds); // A9: numeric-safe bedroom filter
  if (f.furn === 'true')  query = query.eq('details->>furnished', 'yes');
  if (f.furn === 'false') query = query.eq('details->>furnished', 'no');
  if (f.amenities.length) query = query.contains('amenities', f.amenities);

  // A5 fix: county comes from the listing's own county column; area is
  // paired with county whenever we know it, so a duplicated area name
  // in a different county can never leak into the results.
  if (f.areas.length) {
    query = query.in('area', f.areas);
    if (f.county) query = query.eq('county', f.county);
  } else if (f.county) {
    query = nkCountyEq(query, f.county);
  }
  if (f.priceMin) query = query.gte('price', parseFloat(f.priceMin));
  if (f.priceMax) query = query.lte('price', parseFloat(f.priceMax));

  if (f.priceExact !== null) {
    const band = Math.max(1, Math.round(f.priceExact * 0.15));
    query = query.gte('price', f.priceExact - band).lte('price', f.priceExact + band);
  } else if (f.q) {
    const safeQ = nkSanitizeSearchTerm(f.q); // A4: strip characters that break PostgREST's .or(...) filter
    if (safeQ) query = query.or(`title.ilike.%${safeQ}%,description.ilike.%${safeQ}%,area.ilike.%${safeQ}%,address.ilike.%${safeQ}%`);
  }

  if (f.sort === 'price_asc')       query = query.order('status', { ascending: true }).order('price', { ascending: true });
  else if (f.sort === 'price_desc') query = query.order('status', { ascending: true }).order('price', { ascending: false });
  else if (f.sort === 'featured')   query = query.order('status', { ascending: true }).order('is_featured', { ascending: false }).order('created_at', { ascending: false }); // A10: featured sort now matches the Featured section on index
  else                              query = query.order('status', { ascending: true }).order('created_at', { ascending: false });
  query = query.order('id'); // A11: tiebreaker so pagination can't repeat/skip rows

  const from = (currentPage - 1) * PAGE_SIZE;
  query = query.range(from, from + PAGE_SIZE - 1);

  const { data, count, error } = await query;
  if (requestId !== nkRequestId) return;

  if (error) {
    console.error(error);
    document.getElementById('result-count').textContent = 'Something went wrong loading listings';
    if (!append) {
      document.getElementById('listings-grid').innerHTML = `<div class="empty-state">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <h3>Couldn't load listings</h3>
        <p>Please check your connection and <a onclick="applyFilters()" style="cursor:pointer">try again</a></p>
      </div>`;
    }
    nkLoadingMore = false;
    return;
  }

  totalCount = count || 0;
  nkHasMorePages = from + (data ? data.length : 0) < totalCount;
  renderResults(data || [], totalCount, append, f);
  renderPagination(totalCount);
  if (nkMapOpen) nkPopulateMapMarkers();
  nkLoadingMore = false;

  // B6: record zero-result searches as a demand signal (see search_events note in nk-shared.js)
  if (totalCount === 0 && !append) nkRecordZeroResultSearch(f);

  // A11: scroll results into view on an explicit page change (desktop pagination)
  if (page && page > 0 && !append && !nkMobileMode) {
    document.getElementById('results')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  // B4: remember the current results URL + ID order for a future listing-detail "Back to results"/"Next listing"
  try {
    sessionStorage.setItem('nk_results_context', JSON.stringify({ url: location.href, ids: (data || []).map(l => l.id), ts: Date.now() }));
  } catch (e) {}
}

