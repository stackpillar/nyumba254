function buildStatusPill(l, meta) {
  if (l.status === 'occupied') {
    const label = l.price_frequency === 'once' ? 'Sold' : 'Occupied';
    return `<span class="card-status-pill low" style="background:#FFF5F5;color:#C53030">${label} — unavailable</span>`;
  }
  if (meta.group === 'boarding') {
    const units = l.listing_units || [];
    const total = units.reduce((s, u) => s + (u.quantity_total ?? u.quantity_available ?? 0), 0);
    const available = units.reduce((s, u) => s + (u.quantity_available ?? 0), 0);
    if (total > 0) {
      if (available <= 0) return `<span class="card-status-pill low">Full</span>`;
      if (available / total <= 0.2) return `<span class="card-status-pill low">Almost full</span>`;
      return `<span class="card-status-pill">Available now</span>`;
    }
  }
  return `<span class="card-status-pill">Available now</span>`;
}

function buildRoomTypesHtml(l, d) {
  const units = l.listing_units || [];
  const rows = units.length ? units.map(u => ({ label: u.unit_label, price: u.price })) : (Array.isArray(d.room_types) ? d.room_types.map(t => ({ label: t.label, price: t.price })) : []);
  if (!rows.length) return '';
  return `<div class="card-roomtypes">${rows.slice(0, 4).map(r => `
    <div class="card-roomtype-chip">
      <div class="rt-label">${escHtml(r.label)}</div>
      <div class="rt-price">KES ${Number(r.price).toLocaleString('en-KE')}</div>
    </div>`).join('')}</div>`;
}

function buildSpecsChipsHtml(l, meta, d) {
  const chips = [];
  if (meta.group === 'standard') {
    if (d.bedrooms !== undefined && d.bedrooms !== null && d.bedrooms !== '') chips.push([ciBedIcon, d.bedrooms == 0 ? 'Studio' : escHtml(d.bedrooms) + ' bed']);
    if (d.bathrooms) chips.push([ciBathIcon, escHtml(d.bathrooms) + ' bath']);
    if (d.size_sqm) chips.push([ciSizeIcon, escHtml(d.size_sqm) + 'm²']);
    if (d.furnished === 'yes') chips.push([ciFurnIcon, 'Furnished']);
    else if (d.furnished === 'partial') chips.push([ciFurnIcon, 'Part-furnished']);
  } else if (meta.group === 'airbnb') {
    if (d.guests) chips.push([ciGroupIcon, escHtml(d.guests) + ' guests']);
    if (d.bedrooms) chips.push([ciBedIcon, escHtml(d.bedrooms) + ' bed']);
    if (d.bathrooms) chips.push([ciBathIcon, escHtml(d.bathrooms) + ' bath']);
    if (d.min_stay) chips.push([ciSizeIcon, `${escHtml(d.min_stay)}+ night${d.min_stay == 1 ? '' : 's'}`]);
  } else if (meta.group === 'commercial') {
    if (d.size_sqm) chips.push([ciSizeIcon, escHtml(d.size_sqm) + 'm²']);
    if (d.parking) chips.push([ciParkIcon, escHtml(nkTitleCase(d.parking))]);
    if (d.security) chips.push([ciSecurityIcon, escHtml(nkTitleCase(d.security))]);
    if (d.unit_type) chips.push([ciGroupIcon, escHtml(nkTitleCase(d.unit_type))]);
  }
  if (!chips.length) return '';
  return `<div class="card-specs-chips">${chips.map(([icon, label]) => `<div class="card-spec-chip">${icon}${label}</div>`).join('')}</div>`;
}

function buildBoardingMetaHtml(l, d) {
  const items = [];
  if (d.gender && d.gender !== 'mixed') items.push(`<div class="card-meta-item">${ciGroupIcon}${escHtml(d.gender.charAt(0).toUpperCase() + d.gender.slice(1))} only</div>`);
  else items.push(`<div class="card-meta-item">${ciGroupIcon}Mixed</div>`);
  if (d.institution) items.push(`<div class="card-meta-item">${ciWalkIcon}${escHtml(d.institution)}</div>`);
  return items.length ? `<div class="card-meta">${items.join('')}</div>` : '';
}

function buildAmenitiesHtml(l) {
  const list = Array.isArray(l.amenities) ? l.amenities : [];
  if (!list.length) return '';
  const labels = list.map(k => (NK_AMENITIES.find(a => a.key === k) || {}).label).filter(Boolean);
  const shown = labels.slice(0, 3);
  const extra = labels.length - shown.length;
  return `<div class="card-amenities">
    ${shown.map(l2 => `<span class="card-amenity-chip">${escHtml(l2)}</span>`).join('')}
    ${extra > 0 ? `<span class="card-amenity-chip more">+${extra} more</span>` : ''}
  </div>`;
}

function buildVerifiedBadgeHtml(l) { return nkBuildVerifiedBadge(l); }

/* A2: every seller-supplied field goes through escHtml before it reaches innerHTML */
function buildCard(l) {
  const photos = l.listing_photos && l.listing_photos.length ? [...l.listing_photos].sort((a, b) => a.position - b.position) : [];
  const cover = photos.find(p => p.is_cover) || photos[0];
  if (cover) { const coverIdx = photos.indexOf(cover); if (cardPhotoIndex[l.id] === undefined) cardPhotoIndex[l.id] = coverIdx >= 0 ? coverIdx : 0; }
  cardDataById[l.id] = l;

  const meta = NK_CATEGORIES[l.category] || { label: escHtml(l.category), group: 'standard' };
  const d = l.details || {};
  const idx = cardPhotoIndex[l.id] || 0;
  const current = photos[idx];
  const safeTitle = escHtml(l.title);

  const imgHtml = current
    ? `<img id="card-img-${l.id}" src="${escHtml(nkImgSrc(current.url, 420))}" alt="${safeTitle}" loading="lazy" width="420" height="180"/>`
    : `<div class="card-img-placeholder" id="card-img-${l.id}"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg><span style="font-size:11px">No photo</span></div>`;

  const carouselArrows = photos.length > 1 ? `
    <button class="card-carousel-arrow prev" onclick="nkCardPhotoNav(event,'${escHtml(l.id)}',-1)" aria-label="Previous photo"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></button>
    <button class="card-carousel-arrow next" onclick="nkCardPhotoNav(event,'${escHtml(l.id)}',1)" aria-label="Next photo"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></button>
    <div class="card-photo-counter" id="card-counter-${l.id}">${idx + 1}/${photos.length}</div>` : '';

  const catBadge = `<span class="badge-cat ${escHtml(l.category)}">${meta.label}</span>`;
  const isFreshListing = l.created_at && (Date.now() - new Date(l.created_at).getTime()) < 3 * 24 * 60 * 60 * 1000;
  const statusPill = buildStatusPill(l, meta);
  const subText = l.address || (l.county ? `${l.area || ''}, ${nkCountyLabel(l.county)}` : (l.area || 'Kenya'));

  const middleHtml = meta.group === 'boarding' ? buildBoardingMetaHtml(l, d) + buildRoomTypesHtml(l, d) : buildSpecsChipsHtml(l, meta, d);

  const href = `/listing?id=${String(l.listing_number).padStart(6, '0')}`;
  const lat = (typeof l.latitude === 'number') ? l.latitude : '';
  const lng = (typeof l.longitude === 'number') ? l.longitude : '';

  // A11 / C (Results): a real <a href> instead of a div + onclick=window.location
  // so Ctrl/Cmd-click, "open in new tab", and crawling all work. Interactive
  // controls inside (compare checkbox, inquire button, carousel arrows) stop
  // propagation so they don't also trigger the card-level navigation.
  return `
    <a class="card nk-fade-in" href="${href}" data-listing-id="${escHtml(l.id)}" data-lat="${lat}" data-lng="${lng}" data-area="${escHtml(l.area)}" aria-label="${safeTitle}">
      <div class="card-img" id="card-imgwrap-${l.id}">
        ${imgHtml}
        ${statusPill}
        <div class="nk-heart-overlay" onclick="event.preventDefault();event.stopPropagation()">${typeof NKSaved !== 'undefined' ? NKSaved.buildHeartBtn(l.id) : ''}</div>
        ${catBadge}
        <label class="nk-compare-check" onclick="event.preventDefault();event.stopPropagation()" title="Add to compare">
          <input type="checkbox" onclick="event.stopPropagation()" onchange="nkToggleCompare('${escHtml(l.id)}', this.checked, event)" ${nkCompareIds.has(l.id) ? 'checked' : ''}/>
          <span>Compare</span>
        </label>
        ${carouselArrows}
      </div>
      <div class="card-body">
        <div class="card-area">${escHtml(l.area)} ${buildVerifiedBadgeHtml(l)} ${isFreshListing ? '<span style="background:#1D9E75;color:#fff;font-size:9.5px;font-weight:700;padding:1px 6px;border-radius:20px;margin-left:4px;vertical-align:middle">NEW</span>' : ''}</div>
        <div class="card-title">${safeTitle}</div>
        <div class="card-sub">${escHtml(subText)}</div>
        <div class="card-price">${formatPrice(l)}</div>
        ${middleHtml}
        ${buildAmenitiesHtml(l)}
        ${cardCtaButtonHtml(l.id)}
      </div>
    </a>`;
}

function nkHasCardThread(listingId) { return !!nkLSGetC('nk_buyer_' + listingId); }
function ciSentIconHtml() { return `<svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>`; }

function cardCtaButtonHtml(listingId) {
  const l = cardDataById[listingId];
  if (l && l.status === 'occupied') {
    return `<button type="button" class="card-inquire-btn" id="card-cta-${listingId}" disabled style="opacity:.55;cursor:not-allowed" aria-label="No longer available">
      ${ciSentIconHtml()}<span class="card-inquire-label">No longer available</span>
    </button>`;
  }
  if (nkHasCardThread(listingId)) {
    return `<button type="button" class="card-inquire-btn sent" id="card-cta-${listingId}" onclick="handleCardCta(event,'${escHtml(listingId)}')" aria-label="View conversation">
      ${ciSentIconHtml()}<span class="card-inquire-label">View conversation</span>
    </button>`;
  }
  return `<button type="button" class="card-inquire-btn" id="card-cta-${listingId}" onclick="handleCardCta(event,'${escHtml(listingId)}')" aria-label="Send inquiry">
    ${ciSentIconHtml()}<span class="card-inquire-label">Send Inquiry</span>
  </button><div style="text-align:center;font-size:10.5px;color:var(--text-3);margin-top:4px">Sellers usually reply within a few hours</div>`;
