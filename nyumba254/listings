/* C (Map): fetch a light query across up to ~300 matches for the current
   filters, instead of only the 12 already on the page. */
async function nkFetchMapListings() {
  const f = getFilters();
  let q = db.from('listings').select('id, listing_number, title, area, county, price, price_frequency, latitude, longitude').eq('status', 'active').limit(300);
  if (f.freq) q = q.eq('price_frequency', f.freq);
  if (f.cat) q = q.eq('category', f.cat);
  if (f.areas.length) { q = q.in('area', f.areas); if (f.county) q = q.eq('county', f.county); }
  else if (f.county) q = nkCountyEq(q, f.county);
  if (f.priceMin) q = q.gte('price', parseFloat(f.priceMin));
  if (f.priceMax) q = q.lte('price', parseFloat(f.priceMax));
  const { data, error } = await q;
  if (error) { console.error(error); return; }
  await nkPopulateMapMarkers(data || []);
}

/* Only uses the persistent area_geocodes cache — never geocodes live via
   Nominatim from the client (that was slow and against Nominatim's usage
   policy). Precomputing centroids server-side is tracked in
   nk-shared.js's backend notes; listings with no cached/own coordinates
   are simply skipped on the map rather than triggering a live geocode. */
async function nkGeocodeAreaCachedOnly(area, county) {
  const key = area + '|' + county;
  if (nkGeocodeCache[key]) return nkGeocodeCache[key];
  try {
    const { data: cached } = await db.from('area_geocodes').select('lat,lng').eq('area', area).eq('county', county || '').maybeSingle();
    if (cached) { const pos = { lat: cached.lat, lng: cached.lng }; nkGeocodeCache[key] = pos; return pos; }
  } catch (e) {}
  return null;
}

async function nkPopulateMapMarkers(listingsOverride) {
  if (!nkMapMarkersLayer) return;
  nkMapMarkersLayer.clearLayers();
  const listings = listingsOverride || (nkMobileMode ? nkMobileAccum : nkLastListings);
  if (!listings || !listings.length) return;
  const bounds = [];
  for (const l of listings) {
    let lat = typeof l.latitude === 'number' ? l.latitude : null;
    let lng = typeof l.longitude === 'number' ? l.longitude : null;
    if (lat === null || lng === null) {
      const pos = await nkGeocodeAreaCachedOnly(l.area, l.county || '');
      if (!pos) continue;
      lat = pos.lat; lng = pos.lng;
    }
    const marker = L.marker([lat, lng]).addTo(nkMapMarkersLayer);
    const href = `/listing?id=${String(l.listing_number).padStart(6, '0')}`;
    marker.bindPopup(`<strong>${escHtml(l.title)}</strong><br/>KES ${Number(l.price).toLocaleString('en-KE')}${NK_FREQ_LABEL[l.price_frequency] || ''}<br/><a href="${href}" style="color:#0F6E56;font-weight:600">View listing →</a>`);
    bounds.push([lat, lng]);
  }
  if (bounds.length) nkMapInstance.fitBounds(bounds, { padding: [30, 30], maxZoom: 14 });
}

