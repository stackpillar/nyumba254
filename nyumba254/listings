    .card-inquire-btn, .card-wa-btn, .card-msg-btn { position: relative; z-index: 4; display: flex; align-items: center; justify-content: center; gap: 7px; min-height: 42px; border-radius: var(--radius); font-size: 13px; font-weight: 600; transition: background .15s; }
    .card-inquire-btn { flex: 1; min-width: 0; background: var(--green); color: white; padding: 0 10px; }
