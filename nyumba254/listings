    .exit-star { width:28px; height:28px; cursor:pointer; stroke:var(--border); fill:none; stroke-width:1.5; transition:all .1s; }
    .exit-star.filled { fill:var(--green); stroke:var(--green); }
    .notify-success-toast.show { transform: translateY(0); opacity: 1; }

    /* Footer */
    footer { background: var(--text); color: rgba(255,255,255,0.6); padding: 48px 32px 28px; margin-top: 32px; }
