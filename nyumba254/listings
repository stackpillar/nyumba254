/* ═══════════════════════════════════════════════════════════════
   13. COMPARE  (checkbox passed explicitly, escaped, price per bedroom, amenity differences)
   ═══════════════════════════════════════════════════════════════ */
function toggleCompare(input) {
  const id = input.dataset.compare;
  if (input.checked) {
    if (compare.size >= 3) { input.checked = false; toast('You can compare up to 3 listings at a time.', 'error'); return; }
    compare.add(id);
  } else compare.delete(id);
  renderCompareBar();
}
function syncCompareChecks() { qsa('[data-compare]').forEach(i => { i.checked = compare.has(i.dataset.compare); }); }
function renderCompareBar() {
  const n = compare.size;
  $('compare-bar').classList.toggle('show', n > 0); document.body.classList.toggle('nk-compare-open', n > 0);
  $('cb-text').textContent = `${n} listing${n === 1 ? '' : 's'} selected to compare`;
  $('cb-go').disabled = n < 2;
}
function openCompare() {
  const ls = [...compare].map(id => cardData[id]).filter(Boolean);
  if (ls.length < 2) return;
  const bedsOf = l => { const b = (l.details || {}).bedrooms; return (b === undefined || b === null || b === '') ? null : Number(b); };
  const suffix = l => NK_FREQ_LABEL[l.price_frequency] || '';
  const sameFreq = ls.every(l => l.price_frequency === ls[0].price_frequency);
  const ppb = ls.map(l => { const b = bedsOf(l); return b > 0 ? Math.round(Number(l.price) / b) : null; });
  const best = sameFreq ? Math.min(...ppb.filter(v => v !== null)) : null;
  const cell = (fn) => ls.map((l, i) => `<td>${fn(l, i)}</td>`).join('');
  const amenKeys = [...new Set(ls.flatMap(l => Array.isArray(l.amenities) ? l.amenities : []))];
  const has = (l, k) => Array.isArray(l.amenities) && l.amenities.includes(k);
  const labelOf = k => (NK_AMENITIES.find(a => a.key === k) || {}).label || k;
  const common = amenKeys.filter(k => ls.every(l => has(l, k))), diff = amenKeys.filter(k => !common.includes(k));
  const row = (label, fn) => `<tr><th scope="row">${escHtml(label)}</th>${cell(fn)}</tr>`;
  $('cmp-body').innerHTML = `<table class="cmp-table"><thead><tr><th></th>${ls.map(l => `<th scope="col"><a href="${listingHref(l)}">${escHtml(l.title)}</a></th>`).join('')}</tr></thead><tbody>
    ${row('Location', l => escHtml([l.area, l.county && nkCountyLabel(l.county)].filter(Boolean).join(', ')))}
    ${row('Price', l => `<strong>${escHtml(fmtKES(l.price))}${escHtml(suffix(l))}</strong>`)}
    ${row('Category', l => escHtml((NK_CATEGORIES[l.category] || {}).label || l.category))}
    ${row('Bedrooms', l => { const b = bedsOf(l); return b === null ? '—' : b === 0 ? 'Studio' : escHtml(b); })}
    ${row('Bathrooms', l => escHtml((l.details || {}).bathrooms || '—'))}
    ${row('Size', l => (l.details || {}).size_sqm ? escHtml(l.details.size_sqm) + ' m²' : '—')}
    ${row('Price per bedroom', (l, i) => ppb[i] === null ? '—' : `<span${ppb[i] === best ? ' class="cmp-yes"' : ''}>${escHtml(fmtKES(ppb[i]))}${escHtml(suffix(l))}</span>${ppb[i] === best && ls.length > 1 ? ' (lowest)' : ''}`)}
    ${row('Amenities listed', l => (Array.isArray(l.amenities) ? l.amenities.length : 0))}
    ${amenKeys.length ? `<tr class="cmp-section"><td colspan="${ls.length + 1}">Amenity differences</td></tr>` : ''}
    ${diff.map(k => row(labelOf(k), l => has(l, k) ? '<span class="cmp-yes" aria-label="Yes">✓</span>' : '<span class="cmp-no" aria-label="No">—</span>')).join('')}
    ${common.length ? `<tr><th scope="row">In every listing</th><td colspan="${ls.length}">${escHtml(common.map(labelOf).join(', '))}</td></tr>` : ''}
  </tbody></table>`;
  nkOpenModal($('compare-overlay'));
}

