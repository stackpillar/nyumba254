            ${cover ? `<img src="${escHtml(nkImgSrc(cover.url, 200))}" alt="${escHtml(l.title)}" loading="lazy"/>` : `<div style="width:140px;height:100px;background:var(--surface);border-radius:10px;border:1px solid var(--border)"></div>`}
            <div class="nk-recent-title">${escHtml(l.title)}</div>
            <div class="nk-recent-price">KES ${Number(l.price).toLocaleString('en-KE')}${NK_FREQ_LABEL[freq] || ''}</div>
          </a>`;
        }).join('')}
      </div>
    </div>`;
}

/* ── Scroll-to-top FAB, sidebar collapse, view segment ── */
function nkInitScrollTop() {
  const btn = document.getElementById('nk-scrolltop-btn');
  if (!btn) return;
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return; ticking = true;
    requestAnimationFrame(() => { btn.classList.toggle('visible', window.scrollY > 800); ticking = false; });
  }, { passive: true });
}
function toggleSidebarPanel() {
  const layout = document.querySelector('.layout');
  const btn = document.getElementById('sidebar-toggle-btn');
  const tip = document.getElementById('sidebar-toggle-tip');
  if (!layout) return;
  const collapsed = layout.classList.toggle('sidebar-collapsed');
  if (btn) {
    const label = collapsed ? 'Expand filters' : 'Collapse filters';
    btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    btn.setAttribute('aria-label', label);
    if (tip) tip.textContent = label;
  }
  try { localStorage.setItem('nk_sidebar_collapsed', collapsed ? '1' : '0'); } catch (e) {}
}
function nkInitSidebarToggle() {
  if (window.innerWidth <= 900) return;
  if (nkLSGetC('nk_sidebar_collapsed') === '1') {
    document.querySelector('.layout')?.classList.add('sidebar-collapsed');
    const btn = document.getElementById('sidebar-toggle-btn'); const tip = document.getElementById('sidebar-toggle-tip');
    if (btn) { btn.setAttribute('aria-expanded', 'false'); btn.setAttribute('aria-label', 'Expand filters'); }
    if (tip) tip.textContent = 'Expand filters';
  }
}
window.addEventListener('resize', () => { if (window.innerWidth <= 900) document.querySelector('.layout')?.classList.remove('sidebar-collapsed'); });

function nkSetViewSegment(mode) {
  const wantMap = mode === 'map';
  if (wantMap !== nkMapOpen) nkToggleMapView();
  document.getElementById('nk-seg-grid')?.classList.toggle('active', !wantMap);
  document.getElementById('nk-seg-map')?.classList.toggle('active', wantMap);
  document.getElementById('nk-seg-grid')?.setAttribute('aria-selected', String(!wantMap));
  document.getElementById('nk-seg-map')?.setAttribute('aria-selected', String(wantMap));
}

/* B4: restore scroll position when returning to a previous results view (also handles bfcache via pageshow above) */
function restoreResultsScroll() {
  try {
    const saved = sessionStorage.getItem('nk_results_scroll_y');
    if (saved) window.scrollTo(0, parseInt(saved, 10) || 0);
  } catch (e) {}
}
window.addEventListener('beforeunload', () => { try { sessionStorage.setItem('nk_results_scroll_y', String(window.scrollY)); } catch (e) {} });

/* ════════════════════════════════════════════════════ A8: non-blocking exit-intent (mouse-leave only, once/week, requires real engagement) ════════════════════════════════════════════════════ */
const EXIT_SESSION_KEY = 'nk_exit_prompt_last_shown';
const EXIT_COOLDOWN_MS = 7 * 24 * 60 * 60 * 1000; // once a week, not once a day
const EXIT_REVIEW_DONE_KEY = 'nk_platform_review_done';
let exitStarRating = 0;
let exitTriggered = false;
let exitNotifyFlowActive = false;
let exitEngaged = false; // requires real interaction, not just a scroll-only session
const exitPageLoadedAt = Date.now();
const EXIT_MIN_TIME_MS = 20000;

['change', 'submit'].forEach(evt => document.addEventListener(evt, () => { exitEngaged = true; }, { passive: true }));
document.addEventListener('click', e => { if (e.target.closest('.card, .filter-pill, .card-inquire-btn, .sort-select, #search-q')) exitEngaged = true; }, { passive: true });

function exitAlreadyShown() { const last = parseInt(localStorage.getItem(EXIT_SESSION_KEY), 10); return !isNaN(last) && (Date.now() - last) < EXIT_COOLDOWN_MS; }
function exitMarkShown() { try { localStorage.setItem(EXIT_SESSION_KEY, String(Date.now())); } catch (e) {} }
function exitHasActiveEnquiry() {
  try { for (let i = 0; i < localStorage.length; i++) { if (localStorage.key(i)?.startsWith('nk_buyer_')) return true; } } catch (e) {}
  return false;
}
function exitOpenToast() {
  if (exitTriggered || exitAlreadyShown()) return;
  if (Date.now() - exitPageLoadedAt < EXIT_MIN_TIME_MS) return;
  if (!exitEngaged) return; // A8: never fire for a scroll-only session
  if (exitHasActiveEnquiry()) return;
  if (document.getElementById('notify-modal-overlay')?.classList.contains('open')) return;
  if (document.getElementById('card-inquiry-overlay')?.classList.contains('open')) return;
  exitTriggered = true; exitMarkShown();
  exitShowPanel('question');
  document.getElementById('nk-exit-toast').classList.add('open');
}
function exitShowPanel(name) { ['question', 'review', 'thanks'].forEach(p => { document.getElementById('exit-panel-' + p).style.display = (p === name) ? 'block' : 'none'; }); }
function exitClose() { document.getElementById('nk-exit-toast').classList.remove('open'); }

// A8: desktop mouse-leave only — the Escape-key trigger and the global
// link-interception trigger have been removed entirely.
document.addEventListener('mouseout', (e) => { if (window.innerWidth < 768) return; if (e.clientY <= 0) exitOpenToast(); });

function exitAnswerYes() {
  if (localStorage.getItem(EXIT_REVIEW_DONE_KEY)) { exitClose(); return; }
  exitStarRating = 0;
  document.getElementById('exit-review-nav').value = '';
  exitRenderStars();
  exitShowPanel('review');
}
function exitRenderStars() {
  const el = document.getElementById('exit-stars');
  el.innerHTML = [1, 2, 3, 4, 5].map(n => `<svg class="exit-star" data-n="${n}" viewBox="0 0 24 24" role="button" tabindex="0" aria-label="Rate ${n} star${n > 1 ? 's' : ''}"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`).join('');
  nkDelegate(el, '.exit-star', star => exitSetStar(Number(star.dataset.n)));
  el.querySelectorAll('.exit-star').forEach(star => star.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); exitSetStar(Number(star.dataset.n)); } }));
}
function exitSetStar(n) { exitStarRating = n; [...document.getElementById('exit-stars').children].forEach((star, i) => star.classList.toggle('filled', i < n)); }
function exitSkipReview() { exitShowPanel('thanks'); document.getElementById('exit-thanks-text').textContent = 'No worries — thanks for visiting!'; setTimeout(exitClose, 1400); }
async function exitSubmitReview() {
  if (!exitStarRating) { alert('Please pick a star rating'); return; }
  const nav = document.getElementById('exit-review-nav').value.trim();
  const btn = document.getElementById('exit-review-submit');
  btn.disabled = true; btn.textContent = 'Submitting…';
  const { error } = await db.from('reviews').insert({ review_type: 'platform', reviewer_role: 'buyer', reviewer_name: null, is_anonymous: true, rating: exitStarRating, comment: nav || null });
  btn.disabled = false; btn.textContent = 'Send';
  if (error) { alert('Something went wrong, please try again: ' + error.message); return; }
  try { localStorage.setItem(EXIT_REVIEW_DONE_KEY, '1'); } catch (e) {}
  exitShowPanel('thanks');
  document.getElementById('exit-thanks-text').textContent = 'Thank you for your feedback! 🎉';
  setTimeout(exitClose, 1400);
}
function exitAnswerNo() { exitNotifyFlowActive = true; exitClose(); openNotifyModal(); }
</script>

