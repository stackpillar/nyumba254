    .card-specs-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
    .card-spec-chip { display: flex; align-items: center; gap: 4px; background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 4px 9px; font-size: 11.5px; color: var(--text-2); font-weight: 500; }
