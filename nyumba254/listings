  const grid = $('listings-grid');
  grid.setAttribute('aria-busy', 'false');
  if (!list.length && !append) { renderEmpty(f); return; }
  const html = list.map((l, i) => cardHtml(l, append ? -1 : i) + ((i === 7 && list.length > 8) ? NOTIFY_INLINE : '')).join('');
  if (append) grid.insertAdjacentHTML('beforeend', html); else grid.innerHTML = html;
  hydrateHearts(grid);
