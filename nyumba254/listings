<script>if (typeof NKSaved !== 'undefined') NKSaved.init();</script>

<script>
  (function () {
    let sid = localStorage.getItem('nk_sid');
    if (!sid) {
      sid = (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2));
      localStorage.setItem('nk_sid', sid);
    }
    db.from('page_views').insert({
      path: location.pathname,
      referrer: document.referrer || null,
      user_agent: navigator.userAgent,
      session_id: sid
    });
  })();
  /* ════════════════════════════════════════════════════
     EXIT INTENT
  ════════════════════════════════════════════════════ */
  const EXIT_SESSION_KEY = 'nk_exit_prompt_last_shown';
  const EXIT_COOLDOWN_MS = 2 * 60 * 60 * 1000;
  const EXIT_REVIEW_DONE_KEY = 'nk_platform_review_done';
  let exitPendingHref = null;
  let exitStarRating = 0;
  let exitTriggered = false;
  let exitNotifyFlowActive = false;
  const exitPageLoadedAt = Date.now();

  function exitAlreadyShown() {
    const last = parseInt(localStorage.getItem(EXIT_SESSION_KEY), 10);
    return !isNaN(last) && (Date.now() - last) < EXIT_COOLDOWN_MS;
  }
  function exitMarkShown() { localStorage.setItem(EXIT_SESSION_KEY, String(Date.now())); }

  function exitOpenModal(href) {
    if (exitTriggered || exitAlreadyShown()) return;
    if (Date.now() - exitPageLoadedAt < 1200) return;
    if (document.getElementById('notify-modal-overlay')?.classList.contains('open')) return;
    exitTriggered = true;
    exitMarkShown();
    exitPendingHref = href || null;
    exitShowPanel('question');
    document.getElementById('exit-overlay').classList.add('open');
  }

  function exitShowPanel(name) {
    ['question', 'review', 'thanks'].forEach(p => {
      document.getElementById('exit-panel-' + p).style.display = (p === name) ? 'block' : 'none';
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const sidebar = document.getElementById('sidebar');
    if (sidebar && sidebar.classList.contains('open')) {
      closeSidebar();
      return;
    }
    exitOpenModal(null);
  });

  function exitClose() { document.getElementById('exit-overlay').classList.remove('open'); }
  function exitCloseAndGo() {
    exitClose();
    if (exitPendingHref) window.location.href = exitPendingHref;
  }

  document.addEventListener('mouseout', (e) => {
    if (e.clientY <= 0) exitOpenModal(null);
  });

  document.addEventListener('click', (e) => {
    if (exitAlreadyShown()) return;
    if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
    const a = e.target.closest('a[href]');
    if (!a) return;
    const href = a.getAttribute('href');
    if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || a.target === '_blank') return;
    e.preventDefault();
    exitOpenModal(href);
  });

  function exitAnswerYes() {
    if (localStorage.getItem(EXIT_REVIEW_DONE_KEY)) {
      exitCloseAndGo();
      return;
    }
    exitStarRating = 0;
    document.getElementById('exit-review-nav').value = '';
    document.getElementById('exit-review-improve').value = '';
    document.getElementById('exit-review-name').value = '';
    document.getElementById('exit-review-anon').checked = false;
    exitRenderStars();
    exitShowPanel('review');
  }

  function exitRenderStars() {
    const el = document.getElementById('exit-stars');
    el.innerHTML = [1,2,3,4,5].map(n =>
      `<svg class="exit-star" data-n="${n}" viewBox="0 0 24 24" onclick="exitSetStar(${n})" role="button" tabindex="0" aria-label="Rate ${n} star${n>1?'s':''}" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();exitSetStar(${n})}"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`
    ).join('');
  }
  function exitSetStar(n) {
    exitStarRating = n;
    [...document.getElementById('exit-stars').children].forEach((star, i) => star.classList.toggle('filled', i < n));
  }

  function exitToggleAnon() {
    const nameInput = document.getElementById('exit-review-name');
    const checked = document.getElementById('exit-review-anon').checked;
    if (checked) { nameInput.dataset.saved = nameInput.value; nameInput.value = ''; nameInput.disabled = true; }
    else { nameInput.disabled = false; nameInput.value = nameInput.dataset.saved || ''; }
  }

  function exitSkipReview() {
    exitShowPanel('thanks');
    document.getElementById('exit-thanks-text').textContent = 'No worries — thanks for visiting!';
    setTimeout(exitCloseAndGo, 1400);
  }

  async function exitSubmitReview() {
    if (!exitStarRating) { alert('Please pick a star rating'); return; }
    const nav = document.getElementById('exit-review-nav').value.trim();
    const improve = document.getElementById('exit-review-improve').value.trim();
    const isAnon = document.getElementById('exit-review-anon').checked;
    const typedName = document.getElementById('exit-review-name').value.trim();
    const reviewerName = isAnon ? null : (typedName || null);

    const parts = [];
    if (nav) parts.push(`Navigation/finding things: ${nav}`);
    if (improve) parts.push(`Suggested improvement: ${improve}`);
    const comment = parts.join(' | ') || null;

    const btn = document.getElementById('exit-review-submit');
    btn.disabled = true; btn.textContent = 'Submitting…';

    const { error } = await db.from('reviews').insert({
      review_type: 'platform',
      reviewer_role: 'buyer',
      reviewer_name: reviewerName,
      is_anonymous: isAnon,
      rating: exitStarRating,
      comment,
    });

    btn.disabled = false; btn.textContent = 'Submit & continue';
    if (error) { alert('Something went wrong, please try again: ' + error.message); return; }

    localStorage.setItem(EXIT_REVIEW_DONE_KEY, '1');
    exitShowPanel('thanks');
    document.getElementById('exit-thanks-text').textContent = 'Thank you for your feedback! 🎉';
    setTimeout(exitCloseAndGo, 1400);
  }

  function exitAnswerNo() {
    exitNotifyFlowActive = true;
    exitClose();
    openNotifyModal();
  }
</script>
