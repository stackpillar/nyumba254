/* The chat widget is a separate script (global-chat-widget.js) that pins itself bottom-right and, on phones, covers the
   tab bar's Account button. We can't edit it from here, so find it once it appears and tag it; the CSS above then keeps it
   in the shared bottom stack. Matching is by fixed position + "chat" in its text, aria-label, id or class. */
function liftChatWidget() {
  const ours = new Set(['toast', 'compare-bar', 'fb-prompt', 'scrolltop-btn', 'nk-ptr', 'main-nav', 'mobile-nav', 'sidebar', 'overlay']);
  const scan = () => {
    Array.from(document.body.children).forEach(el => {
      if (el.classList.contains('nk-chat-fab') || ours.has(el.id) || el.classList.contains('nk-tabbar') || el.tagName === 'SCRIPT') return;
      const cs = getComputedStyle(el);
      if (cs.position !== 'fixed' || cs.bottom === 'auto' || cs.right === 'auto') return;
      const label = (el.textContent + ' ' + (el.getAttribute('aria-label') || '') + ' ' + el.id + ' ' + el.className).slice(0, 400);
      if (/chat/i.test(label)) el.classList.add('nk-chat-fab');
    });
  };
  scan();
  const scanSoon = nkDebounce(scan, 150);
  new MutationObserver(scanSoon).observe(document.body, { childList: true });
  setTimeout(scan, 1500); setTimeout(scan, 4000);   // widgets often build their DOM after the session loads
}

function boot() {
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  document.addEventListener('nk:datasaver', e => { PAGE_SIZE = e.detail && e.detail.on ? 6 : 12; if (booted) runSearch(); });
  nkInitDataSaver();
  buildStatic(); readUrl();
  $('search-q').value = S.q;
  bindEvents(); renderControls(); syncDrawerInert();
  initSidebarCollapse(); initPullToRefresh(); initScrollWatch();
  loadAuthInfo(); renderRecent();
  nkInitAccountNav(['nav-account-link', 'mobile-account-link']);
  nkSessionPromise.then(({ data }) => { if (data && data.session) $('tab-account-link').setAttribute('href', '/dashboard'); });
  nkTrackPageView();
  initTabbarMeasure(); liftChatWidget();
  const restore = getRestore();
  const first = runSearch();
  booted = true;
  first.then(() => { if (restore) restoreScroll(restore); });
}
boot();

})();
</script>

