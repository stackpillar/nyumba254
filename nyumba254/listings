    .trust-bar { background: var(--green-light); border-top: 1px solid #9FE1CB; border-bottom: 1px solid #9FE1CB; padding: 16px 24px; display: flex; align-items: center; justify-content: center; gap: 12px 32px; flex-wrap: wrap; font-size: 13.5px; font-weight: 600; color: var(--green-dark); }

    /* ── Footer ── */
    footer { background: var(--text); color: rgba(255,255,255,.6); padding: 56px 32px 28px; }
