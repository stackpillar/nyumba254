/* ═══════════════════════════════════════════════════════════════
   6. RESULTS  (fetch → render → pagination / infinite feed → context)
   ═══════════════════════════════════════════════════════════════ */
let reqId = 0, booted = false, lastZeroSig = '';
const feed = { pages: 0, total: 0, items: [], loading: false, hasMore: false };
let feedObserver = null;

async function runSearch(opts) {
  opts = opts || {};
  const append = !!opts.append, mobile = isMobileFeed();
  const my = ++reqId;
  const f = cloneState(S);
  const page = append ? feed.pages + 1 : (mobile ? 1 : S.page);
  feed.loading = true;
  if (!append) {
    feed.pages = 0; feed.items = []; feed.hasMore = false;
    $('listings-grid').innerHTML = skeletonHtml(mobile ? 3 : 6);
    $('listings-grid').setAttribute('aria-busy', 'true');
    $('result-count').textContent = 'Loading…';
    $('feed-footer').innerHTML = ''; $('pagination').innerHTML = '';
    writeUrl(); updateHeading(f);
  } else {
    $('feed-footer').innerHTML = '<div class="feed-loading"><span class="nk-spinner"></span> Loading more…</div>';
  }
  const { data, count, error } = await fetchPage(f, page);
  if (my !== reqId) return;
  feed.loading = false;
  if (error) { console.error(error); renderError(); return; }
  const list = data || [];
  feed.total = count || 0;
  if (!append && !list.length && feed.total > 0 && page > 1) { S.page = 1; return runSearch(opts); }   // stale ?page=99
  feed.pages = page;
  feed.items.push(...list.map(l => ({ id: l.id, num: pad(l.listing_number) })));
  feed.hasMore = (page - 1) * PAGE_SIZE + list.length < feed.total;
  updateCount(page, list.length, mobile);
  renderResults(list, append, f);
  renderFeedFooter(); renderPagination();
  saveContext();
  if (!append) {
    updateJsonLd(list, f);
    if (S.view === 'map') refreshMap({ refit: !S.mapIds });
    if (opts.scroll) scrollToResults();
  }
}

function updateCount(page, n, mobile) {
  const t = feed.total, el = $('result-count');
  if (!t) { el.innerHTML = '<strong>0</strong> listings'; return; }
  const start = mobile ? 1 : (page - 1) * PAGE_SIZE + 1;
  const end = mobile ? feed.items.length : (page - 1) * PAGE_SIZE + n;
  el.innerHTML = `Showing <strong>${start}–${end}</strong> of <strong>${t.toLocaleString('en-KE')}</strong>`;
}

const NOTIFY_INLINE = '<div class="nk-inline-notify"><span><span aria-hidden="true">🔔</span> Want to hear the moment a listing like these is posted?</span><button type="button" class="btn btn-primary" data-open-alert>Get alerts</button></div>';
