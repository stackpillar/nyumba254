    .card-inquire-btn.sent { background: white; color: var(--green-dark); border: 1.5px solid var(--green); }
    .card-inquire-btn.sent:hover { background: var(--green-light); }
    .card-inquire-btn svg, .card-wa-btn svg, .card-msg-btn svg { width: 16px; height: 16px; flex-shrink: 0; stroke: currentColor; fill: none; stroke-width: 2; }
    .card-wa-btn { flex: 1; min-width: 0; background: #1fa855; color: white; padding: 0 10px; }
    .card-wa-btn:hover { background: #178a45; }
    .card-msg-btn { width: 46px; flex-shrink: 0; border: 1.5px solid var(--green); color: var(--green-dark); background: white; }
    .card-msg-btn:hover { background: var(--green-light); }
    .nk-inline-notify { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; background: var(--green-light); border: 1.5px dashed var(--green-mid); border-radius: var(--radius); padding: 12px 16px; font-size: 13.5px; color: var(--green-dark); font-weight: 500; }
    .nk-inline-notify .btn { padding: 8px 14px; font-size: 13px; }

    .skeleton { background: white; border-radius: 18px; overflow: hidden; border: 1px solid var(--border); }
    .skeleton-img { aspect-ratio: 4 / 3; background: linear-gradient(90deg, #f0efe9 25%, #e8e7e1 50%, #f0efe9 75%); background-size: 200% 100%; animation: shimmer 1.4s infinite; }
    .skeleton-body { padding: 14px 16px; }
    .skeleton-line { height: 11px; background: linear-gradient(90deg, #f0efe9 25%, #e8e7e1 50%, #f0efe9 75%); background-size: 200% 100%; animation: shimmer 1.4s infinite; border-radius: 4px; margin-bottom: 9px; }
    .skeleton-line.short { width: 55%; } .skeleton-line.xshort { width: 35%; }
    @keyframes shimmer { to { background-position: -200% 0; } }

    .empty-state { grid-column: 1 / -1; text-align: center; padding: 56px 20px; color: var(--text-3); }
