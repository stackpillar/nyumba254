async function submitNotifyAlert() {
  if (document.getElementById('nf-hp').value) return; // honeypot

  const name = document.getElementById('nf-name').value.trim();
  const phoneRaw = document.getElementById('nf-phone').value.trim();
  const phone = nkNormalizePhone(phoneRaw);
  const email = document.getElementById('nf-email').value.trim();

  if (!name) { alert('Please enter your name'); return; }
  if (!phoneRaw && !email) { alert('Please enter a phone number or email so we can reach you'); return; } // C: phone/WhatsApp is now the primary channel, not email-only
  if (!document.getElementById('nf-consent').checked) { alert('Please agree to be contacted before submitting'); return; }

  const priceType = document.querySelector('#nf-type-pills .filter-pill.active')?.dataset.val || null;
  const category  = document.querySelector('#nf-cat-pills .filter-pill.active')?.dataset.val || null;
  const bedsVal   = document.querySelector('#nf-bed-pills .filter-pill.active')?.dataset.val || '';
  const bedrooms  = bedsVal ? parseInt(bedsVal) : null;

  const county = document.getElementById('nf-county-select').value || null;
  const customChecked = document.getElementById('nf-area-not-listed').checked;
  const areaSelectVal = document.getElementById('nf-area-select').value || null;
  const customAreaText = document.getElementById('nf-area-custom').value.trim();
  const area = customChecked ? null : areaSelectVal;
  const customArea = customChecked ? (customAreaText || null) : null;

  const budgetMin = document.getElementById('nf-budget-min').value;
  const budgetMax = document.getElementById('nf-budget-max').value;
  const notes = document.getElementById('nf-notes').value.trim();

  const btn = document.getElementById('nf-submit-btn');
  btn.disabled = true; btn.textContent = 'Saving…';

  const { error } = await db.from('listing_alerts').insert({
    full_name: name, phone: phone || null, email: email || null,
    price_type: priceType, category, bedrooms, county, area, custom_area: customArea,
    budget_min: budgetMin ? parseFloat(budgetMin) : null, budget_max: budgetMax ? parseFloat(budgetMax) : null, notes: notes || null,
  });

  btn.disabled = false; btn.textContent = 'Notify me';
  if (error) { alert('Something went wrong, please try again: ' + error.message); return; }

  nkSaveBuyerProfile({ name, phone, email });
  if (email) db.functions.invoke('send-notification-email', { body: { type: 'alert_confirmation', alertName: name, alertEmail: email } }).catch(err => console.warn('Alert confirmation email failed to send:', err));

  nkCloseModal(document.getElementById('notify-modal-overlay'));
  nfResetForm();
  showNotifySuccess();
  if (exitNotifyFlowActive) exitNotifyFlowActive = false;
}

