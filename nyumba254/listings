    .card-roomtypes { display: grid; grid-template-columns: repeat(auto-fit, minmax(76px, 1fr)); gap: 6px; margin-bottom: 10px; }
    .card-roomtype-chip { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 6px 8px; }
    .rt-label { font-size: 11px; font-weight: 600; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
