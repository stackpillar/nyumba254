    .card.is-hover { outline: 2px solid var(--green); }
    .card.is-occupied { opacity: .78; }
    /* Stretched link: the title <a> covers the whole card, so the card is a real link
       (Ctrl/Cmd-click, open in new tab, crawlable) while buttons inside stay clickable. */
    .card-link { color: inherit; }
    .card-link::after { content: ''; position: absolute; inset: 0; z-index: 2; }
    .card-link:focus-visible { outline: none; }
    .card-link:focus-visible::after { outline: 3px solid var(--green); outline-offset: -3px; border-radius: 18px; }
    .card-img { position: relative; aspect-ratio: 4 / 3; background: var(--surface); overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .card-img::after { content: ''; position: absolute; inset: auto 0 0 0; height: 50%; z-index: 1; background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.34)); pointer-events: none; }
    .card-img img { width: 100%; height: 100%; object-fit: cover; }
    .card-img-placeholder { display: flex; flex-direction: column; align-items: center; gap: 6px; color: var(--text-3); font-size: 12px; }
    .card-img-placeholder svg { width: 34px; height: 34px; opacity: .35; stroke: currentColor; fill: none; stroke-width: 1.5; }
    .card-badges { position: absolute; top: 12px; left: 12px; z-index: 3; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
    .badge-featured, .badge-new, .badge-occ, .badge-avail { font-size: 10.5px; font-weight: 800; padding: 5px 11px; border-radius: 20px; letter-spacing: .03em; line-height: 1.2; }
    .badge-featured { background: linear-gradient(135deg, #F5B942, #E8973A); color: #3A2405; box-shadow: 0 2px 8px rgba(232,151,58,.45); }
    .badge-featured::before { content: '★ '; }
    .badge-new { background: linear-gradient(135deg, var(--green-mid), var(--green-dark)); color: white; }
    .badge-occ { background: var(--danger); color: white; }
    .badge-avail { background: white; color: var(--text-2); font-weight: 700; }
    .badge-cat { position: absolute; left: 12px; bottom: 12px; z-index: 3; font-size: 10.5px; font-weight: 700; padding: 4px 10px; border-radius: 20px; }
    .badge-cat.apartment { background: var(--green); color: white; }
    .badge-cat.house { background: var(--green-dark); color: white; }
    .badge-cat.boarding { background: var(--green-light); color: var(--green-dark); border: 1px solid var(--green-mid); }
    .badge-cat.airbnb { background: white; color: var(--green-dark); border: 1px solid var(--green); }
    .badge-cat.commercial { background: var(--text); color: white; }
    .card-img .nk-heart-overlay { position: absolute; top: 10px; right: 10px; z-index: 4; }
    .card-carousel-arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.94); display: flex; align-items: center; justify-content: center; z-index: 4; opacity: 0; transition: opacity .15s; }
    .card:hover .card-carousel-arrow, .card:focus-within .card-carousel-arrow { opacity: 1; }
    @media (hover: none) { .card-carousel-arrow { opacity: 1; width: 30px; height: 30px; } }
    .card-carousel-arrow svg { width: 14px; height: 14px; stroke: var(--text); fill: none; stroke-width: 2.5; }
    .card-carousel-arrow.prev { left: 8px; }
    .card-carousel-arrow.next { right: 8px; }
    .card-photo-counter { position: absolute; bottom: 12px; right: 12px; background: rgba(0,0,0,.55); color: white; font-size: 10.5px; font-weight: 600; padding: 2px 8px; border-radius: 20px; z-index: 3; }
    .card-body { padding: 15px 16px 14px; display: flex; flex-direction: column; flex: 1; }
    .card-area { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; font-size: 11px; font-weight: 700; color: var(--green); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 5px; }
    .card-area::before { content: '📍'; font-size: 12px; }
    .card-verified-badge { display: inline-flex; align-items: center; gap: 3px; background: var(--green-light); color: var(--green-dark); font-size: 9.5px; font-weight: 700; padding: 1px 7px 1px 5px; border-radius: 20px; text-transform: none; letter-spacing: 0; }
    .card-verified-badge svg { width: 9px; height: 9px; stroke: var(--green-dark); fill: none; stroke-width: 2.6; }
    .card-title { font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 3px; line-height: 1.35; }
    .card-sub { font-size: 12.5px; color: var(--text-3); margin-bottom: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-price { font-size: 18px; font-weight: 700; color: var(--green-dark); margin-bottom: 10px; letter-spacing: -.01em; }
    .card-price span { font-size: 12.5px; font-weight: 500; color: var(--text-2); }
    .card-meta { display: flex; gap: 12px; font-size: 12px; color: var(--text-2); margin-bottom: 10px; flex-wrap: wrap; }
    .card-meta-item { display: flex; align-items: center; gap: 4px; }
