    .nk-spinner { width: 16px; height: 16px; border: 2px solid var(--border); border-top-color: var(--green); border-radius: 50%; animation: nkSpin .7s linear infinite; display: inline-block; }
    @keyframes nkSpin { to { transform: rotate(360deg); } }
    .nk-feed-end { text-align: center; line-height: 1.8; }
    .pagination { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 28px; flex-wrap: wrap; }
    .page-btn { min-width: 40px; height: 40px; padding: 0 6px; border-radius: 8px; border: 1.5px solid var(--border); background: white; color: var(--text-2); font-size: 13px; font-weight: 500; display: flex; align-items: center; justify-content: center; }
    .page-btn:hover { border-color: var(--green); color: var(--green); }
