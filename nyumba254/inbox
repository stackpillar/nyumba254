<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Chats — Nyumba254</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --green:#0F6E56; --green-dark:#085041; --tint:#E1F5EE; --tint-border:#bfe6d8;
    --surface:#fff; --app-bg:#f7f6f2; --border:#e0ded8;
    --ink:#1a1a18; --muted:#888780; --alert:#C53030;
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{font-family:'Inter',sans-serif;color:var(--ink);background:var(--app-bg)}
  button,input,textarea{font-family:inherit}
  :focus-visible{outline:2px solid var(--green);outline-offset:2px}
  a{color:inherit}

  #ni-app{display:flex;flex-direction:column;height:100vh}

  /* ── Header ── */
  #ni-header{flex-shrink:0;background:var(--green);color:#fff;display:flex;align-items:center;gap:16px;padding:14px 20px}
  #ni-back{display:flex;align-items:center;gap:5px;font-size:13px;font-weight:600;text-decoration:none;color:rgba(255,255,255,.9);flex-shrink:0;white-space:nowrap}
  #ni-back:hover{color:#fff}
  #ni-title-wrap{flex:1;min-width:0}
  #ni-title{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;line-height:1.2}
  #ni-subtitle{font-size:12px;opacity:.85;margin-top:1px}
  #ni-sync-btn{flex-shrink:0;background:rgba(255,255,255,.16);border:none;color:#fff;cursor:pointer;padding:8px 14px;border-radius:20px;display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600}
  #ni-sync-btn:hover{background:rgba(255,255,255,.28)}
  @media(max-width:640px){#ni-sync-btn span{display:none}#ni-sync-btn{padding:8px;border-radius:50%}}

  /* ── Body: two-pane on desktop, single pane on mobile ── */
  #ni-body{flex:1;display:flex;min-height:0}

  #ni-sidebar{width:360px;flex-shrink:0;display:flex;flex-direction:column;border-right:1px solid var(--border);background:var(--surface)}
  #ni-search-row{padding:12px;border-bottom:1px solid var(--border);flex-shrink:0}
    .ni-sidebar-tab{flex:1;padding:8px 0;border:1.5px solid var(--border);border-radius:8px;background:#fff;color:#4a4a46;font-size:12.5px;font-weight:700;cursor:pointer}
  .ni-sidebar-tab.active{background:var(--green);border-color:var(--green);color:#fff}
  .ni-tab-count{background:var(--alert);color:#fff;border-radius:10px;font-size:10px;padding:1px 6px;margin-left:4px}
  .ni-saved-item{display:flex;gap:11px;padding:13px 15px;border-bottom:1px solid var(--border);cursor:pointer}
  .ni-saved-item:hover{background:var(--app-bg)}
  .ni-saved-img{width:52px;height:44px;border-radius:8px;background:var(--border);object-fit:cover;flex-shrink:0}
  .ni-saved-title{font-size:13.5px;font-weight:600}
  .ni-saved-sub{font-size:12px;color:var(--muted);margin-top:2px}
  .ni-saved-price{font-size:12.5px;font-weight:700;color:var(--green-dark);margin-top:3px}
  .ni-saved-remove{border:none;background:none;color:var(--muted);cursor:pointer;font-size:16px;align-self:flex-start}
  .ni-profile-field{margin-bottom:14px}
  .ni-profile-field label{display:block;font-size:11.5px;font-weight:700;color:#4a4a46;text-transform:uppercase;letter-spacing:.04em;margin-bottom:5px}
  .ni-toggle-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-top:1px solid var(--border);margin-top:6px}
  #ni-search{width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:9px;font-size:13px;background:var(--app-bg);outline:none}
  #ni-search:focus{border-color:var(--green);background:#fff}
  #ni-list{flex:1;overflow-y:auto}
  #ni-empty,#ni-list-loading{padding:40px 20px;text-align:center;color:var(--muted);font-size:13.5px;line-height:1.5}

  .ni-convo{display:flex;gap:11px;padding:13px 15px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .1s}
  .ni-convo:hover,.ni-convo.active{background:var(--app-bg)}
  .ni-convo-img{width:46px;height:46px;border-radius:9px;background:var(--border);object-fit:cover;flex-shrink:0}
  .ni-convo-body{flex:1;min-width:0}
  .ni-convo-title{font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ni-convo-last{font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:3px}
  .ni-convo-badge{background:var(--alert);color:#fff;font-size:10.5px;font-weight:700;border-radius:10px;min-width:19px;height:19px;padding:0 5px;display:flex;align-items:center;justify-content:center;flex-shrink:0;align-self:center}

  #ni-thread-pane{flex:1;display:flex;flex-direction:column;min-width:0;background:var(--app-bg)}
  #ni-thread-empty{flex:1;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:14px;padding:20px;text-align:center}
  #ni-thread{display:none;flex-direction:column;flex:1;min-height:0}
  #ni-thread.open{display:flex}

  #ni-thread-head{background:var(--green);color:#fff;padding:14px 18px;display:flex;align-items:center;gap:12px;flex-shrink:0}
  .ni-back-btn{display:none;background:none;border:none;color:#fff;cursor:pointer;padding:2px;flex-shrink:0}
  #ni-thread-info{flex:1;min-width:0}
  #ni-thread-name{font-size:15px;font-weight:600;display:flex;align-items:center;gap:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ni-verified{display:inline-flex;flex-shrink:0;color:#7CE0C0}
  #ni-thread-link{font-size:12px;color:rgba(255,255,255,.85);text-decoration:underline}

  .ni-thread-subbar{padding:10px 18px;background:var(--tint);border-bottom:1px solid var(--border);flex-shrink:0;display:flex;gap:8px}
  .ni-subbar-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:9px 8px;background:#fff;color:var(--green-dark);border:1.5px solid var(--green);border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap}
  .ni-subbar-btn:hover{background:var(--tint)}
  .ni-subbar-btn.ghost{color:#4a4a46;border-color:var(--border)}
  .ni-subbar-btn.ghost:hover{background:var(--app-bg)}

  #ni-messages{flex:1;min-height:0;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:8px}
  .ni-row{display:flex;gap:7px;align-items:flex-end;width:100%}
  .ni-row>div:last-child{max-width:60%;width:max-content;display:flex;flex-direction:column}
  .ni-row.mine{flex-direction:row-reverse}
  .ni-av{width:26px;height:26px;border-radius:50%;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--tint);color:var(--green-dark)}
  .ni-row.mine .ni-av{background:var(--green);color:#fff}
  .ni-bubble{width:fit-content;max-width:100%;padding:9px 13px;border-radius:14px;font-size:13.5px;line-height:1.5;background:#fff;border:1px solid var(--border);border-bottom-left-radius:4px;overflow-wrap:break-word;white-space:pre-wrap}
  .ni-row.mine .ni-bubble{background:var(--green);color:#fff;border:none;border-bottom-right-radius:4px}
  .ni-time{font-size:10.5px;color:var(--muted);margin-top:2px;display:inline-flex;align-items:center}
  .ni-row.mine .ni-time{align-self:flex-end}
  .ni-tick{stroke:#9a9a94;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;margin-left:3px;vertical-align:-1px}
  .ni-tick.read{stroke:#34B7F1}
  .ni-date-sep{text-align:center;font-size:11px;color:var(--muted);padding:6px 0;font-weight:600}
  @media(min-width:861px){.ni-row>div:last-child{max-width:66%}}

  #ni-quick-replies{display:flex;gap:6px;flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:10px 18px;background:#fff;border-top:1px solid var(--border);mask-image:linear-gradient(to right,#000 94%,transparent 100%);-webkit-mask-image:linear-gradient(to right,#000 94%,transparent 100%)}
  #ni-quick-replies::-webkit-scrollbar{display:none}
  #ni-quick-replies:empty{display:none;padding:0;border:none;mask-image:none;-webkit-mask-image:none}
  .ni-chip{flex-shrink:0;background:var(--tint);color:var(--green-dark);border:1px solid var(--tint-border);border-radius:16px;padding:7px 13px;font-size:12.5px;font-weight:600;white-space:nowrap;cursor:pointer}
  .ni-chip:hover{background:#c9ecdd}

  #ni-input-row{display:flex;gap:10px;padding:14px 18px;background:#fff;border-top:1px solid var(--border);flex-shrink:0}
  #ni-input{flex:1;resize:none;border:1.5px solid var(--border);border-radius:11px;padding:10px 14px;font-size:14px;outline:none;min-height:44px;max-height:120px;line-height:1.5;background:var(--app-bg)}
  #ni-input:focus{border-color:var(--green);background:#fff}
  #ni-send{width:42px;height:42px;border-radius:50%;background:var(--green);color:#fff;display:flex;align-items:center;justify-content:center;border:none;cursor:pointer;flex-shrink:0}
  #ni-send:disabled{opacity:.5;cursor:not-allowed}

  /* ── Mobile: single pane, sidebar/thread swap ── */
  @media(max-width:860px){
    #ni-sidebar{width:100%;border-right:none}
    #ni-title{font-size:19px}
    body.ni-thread-open #ni-sidebar{display:none}
    body:not(.ni-thread-open) #ni-thread-pane{display:none}
    .ni-back-btn{display:flex}
    #ni-thread-empty{display:none}
    .ni-thread-subbar{flex-wrap:wrap}
  }

  /* ── Booking modal ── */
  .ni-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:200;align-items:center;justify-content:center;padding:20px}
  .ni-overlay.open{display:flex}
  .ni-modal{background:#fff;border-radius:16px;max-width:440px;width:100%;padding:26px 24px;box-shadow:0 8px 32px rgba(0,0,0,.18)}
  .ni-modal h3{font-size:18px;font-weight:700;margin:0 0 4px}
  .ni-modal p.ni-sub{font-size:12.5px;color:var(--muted);margin:0 0 18px;line-height:1.5}
  .ni-field{margin-bottom:14px}
  .ni-field label{display:block;font-size:11.5px;font-weight:700;color:#4a4a46;text-transform:uppercase;letter-spacing:.04em;margin-bottom:5px}
  .ni-field input,.ni-field textarea,.ni-field select{width:100%;padding:10px 13px;border:1.5px solid var(--border);border-radius:10px;font-size:13.5px;background:var(--app-bg);outline:none}
  .ni-field input:focus,.ni-field textarea:focus,.ni-field select:focus{border-color:var(--green);background:#fff}
  .ni-row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .ni-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:6px}
  .ni-cancel{background:var(--app-bg);color:#4a4a46;padding:10px 18px;border-radius:8px;font-size:13px;border:none;cursor:pointer}
  .ni-submit{background:var(--green);color:#fff;padding:10px 20px;border-radius:8px;font-size:13px;font-weight:600;border:none;cursor:pointer}
  .ni-submit:hover{background:var(--green-dark)}
  .ni-submit:disabled{opacity:.6;cursor:not-allowed}

  /* ── Sync modal ── */
  .ni-link-row{display:flex;gap:8px;margin-bottom:14px}
  #ni-sync-link{flex:1;padding:10px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:12.5px;color:#4a4a46;background:var(--app-bg)}
  .ni-copy-btn{background:var(--green);color:#fff;border:none;border-radius:8px;padding:0 16px;font-size:13px;font-weight:600;cursor:pointer}
  .ni-copy-btn:hover{background:var(--green-dark)}
</style>
</head>
<body>
  <div id="ni-app">
    <header id="ni-header">
      <a id="ni-back" href="/listings"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg> Browse listings</a>
      <div id="ni-title-wrap">
        <div id="ni-title">Nyumba254</div>
        <div id="ni-subtitle">Your conversations with sellers</div>
      </div>
      <button id="ni-profile-btn" type="button" title="My details & notifications">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0116 0v1"/></svg>
        <span>My details</span>
      </button>
      <button id="ni-sync-btn" type="button" title="Continue on another device">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
        <span>Sync device</span>
      </button>
    </header>

    <div id="ni-body">
      <aside id="ni-sidebar">
        <div id="ni-sidebar-tabs" style="display:flex;gap:6px;padding:10px 12px 0">
          <button type="button" class="ni-sidebar-tab active" data-tab="chats" onclick="switchSidebarTab('chats')">Chats</button>
          <button type="button" class="ni-sidebar-tab" data-tab="saved" onclick="switchSidebarTab('saved')">Saved <span id="ni-saved-count" class="ni-tab-count" style="display:none">0</span></button>
        </div>
        <div id="ni-search-row"><input id="ni-search" placeholder="Search conversations…"/></div>
        <div id="ni-list"><div id="ni-list-loading">Loading your conversations…</div></div>
        <div id="ni-saved-panel" style="display:none;flex:1;overflow-y:auto"><div id="ni-saved-loading" style="padding:40px 20px;text-align:center;color:var(--muted);font-size:13.5px">Loading saved listings…</div></div>
      </aside>

      <main id="ni-thread-pane">
        <div id="ni-thread-empty">Select a conversation from the list to view messages.</div>
        <div id="ni-thread">
          <div id="ni-thread-head">
            <button class="ni-back-btn" id="ni-thread-back" aria-label="Back to list"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button>
            <div id="ni-thread-info">
              <div id="ni-thread-name">Seller</div>
              <div id="ni-thread-presence" style="font-size:11px;color:rgba(255,255,255,.75);display:flex;align-items:center;gap:5px;margin-top:1px">
                <span id="ni-presence-dot" style="width:6px;height:6px;border-radius:50%;background:#9a9a94;flex-shrink:0"></span>
                <span id="ni-presence-text">Offline</span>
              </div>
              <a id="ni-thread-link" href="#">View listing →</a>
            </div>
            <button id="ni-thread-search-btn" type="button" aria-label="Search in conversation" style="background:none;border:none;color:#fff;cursor:pointer;padding:4px;opacity:.85;flex-shrink:0">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
          </div>
          <div id="ni-thread-searchbar" style="display:none;padding:8px 18px;background:var(--tint);border-bottom:1px solid var(--border);gap:8px;align-items:center">
            <input id="ni-thread-search-input" placeholder="Search this conversation…" style="flex:1;padding:7px 11px;border:1.5px solid var(--tint-border);border-radius:8px;font-size:12.5px;outline:none"/>
            <span id="ni-thread-search-count" style="font-size:11.5px;color:var(--green-dark);white-space:nowrap"></span>
            <button id="ni-thread-search-close" type="button" style="background:none;border:none;color:var(--green-dark);cursor:pointer;font-size:16px">✕</button>
          </div>
          <div class="ni-thread-subbar">
            <button id="ni-book-btn" class="ni-subbar-btn" type="button">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Book a viewing
            </button>
            <button id="ni-invite-btn" class="ni-subbar-btn ghost" type="button">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              Invite a friend
            </button>
          </div>
          <div id="ni-messages"></div>
          <div id="ni-quick-replies"></div>
          <div id="ni-input-row">
            <textarea id="ni-input" placeholder="Type a message…" rows="1"></textarea>
            <button id="ni-send"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="white" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></button>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Booking modal -->
  <div id="ni-viewing-overlay" class="ni-overlay">
    <div class="ni-modal" role="dialog" aria-modal="true" aria-labelledby="ni-viewing-title">
      <h3 id="ni-viewing-title">Book a viewing</h3>
      <p class="ni-sub">Request a time to view this property — the seller will confirm.</p>
      <div class="ni-row2">
        <div class="ni-field"><label>Date <span style="color:var(--alert)">*</span></label><input type="date" id="ni-v-date"/></div>
        <div class="ni-field">
          <label>Time <span style="color:var(--alert)">*</span></label>
          <select id="ni-v-time">
            <option value="">Select time</option>
            <option value="Morning (8am–11am)">Morning (8am–11am)</option>
            <option value="Midday (11am–2pm)">Midday (11am–2pm)</option>
            <option value="Afternoon (2pm–5pm)">Afternoon (2pm–5pm)</option>
            <option value="Evening (5pm–7pm)">Evening (5pm–7pm)</option>
          </select>
        </div>
      </div>
      <div class="ni-field"><label>Full name <span style="color:var(--alert)">*</span></label><input type="text" id="ni-v-name" placeholder="Your full name"/></div>
      <div class="ni-field"><label>Phone <span style="color:var(--alert)">*</span></label><input type="tel" id="ni-v-phone" placeholder="07XX XXX XXX"/></div>
      <div class="ni-field"><label>Notes <span style="text-transform:none;font-weight:400;color:var(--muted)">optional</span></label><textarea id="ni-v-notes" rows="2" placeholder="Anything the seller should know…"></textarea></div>
      <div class="ni-actions">
        <button class="ni-cancel" type="button" id="ni-v-cancel">Cancel</button>
        <button class="ni-submit" type="button" id="ni-v-submit">Request viewing</button>
      </div>
    </div>
  </div>

  <!-- Profile modal -->
  <div id="ni-profile-overlay" class="ni-overlay">
    <div class="ni-modal" role="dialog" aria-modal="true" aria-labelledby="ni-profile-title">
      <h3 id="ni-profile-title">My details</h3>
      <p class="ni-sub">Add your name, email or phone so a seller or Nyumba254 can reach you — and so we can email you if you get a reply while you're offline.</p>
      <div class="ni-profile-field"><label>Full name</label><input type="text" id="ni-p-name" placeholder="Your name"/></div>
      <div class="ni-profile-field"><label>Email</label><input type="email" id="ni-p-email" placeholder="you@example.com"/></div>
      <div class="ni-profile-field"><label>Phone</label><input type="tel" id="ni-p-phone" placeholder="07XX XXX XXX"/></div>
      <div class="ni-toggle-row">
        <span style="font-size:13px;color:#4a4a46">Email me when I get a reply</span>
        <input type="checkbox" id="ni-p-notify" checked style="width:18px;height:18px;accent-color:var(--green)"/>
      </div>
      <div class="ni-actions">
        <button class="ni-cancel" type="button" id="ni-profile-cancel">Close</button>
        <button class="ni-submit" type="button" id="ni-profile-save">Save & email me my link</button>
      </div>
      <p id="ni-profile-status" style="font-size:11.5px;color:var(--muted);margin-top:10px"></p>
    </div>
  </div>

  <!-- Sync modal -->
  <div id="ni-sync-overlay" class="ni-overlay">
    <div class="ni-modal" role="dialog" aria-modal="true" aria-labelledby="ni-sync-title">
      <h3 id="ni-sync-title">Continue on another device</h3>
      <p class="ni-sub">This link opens all of your Nyumba254 conversations on any phone or computer — nothing is lost, nothing is shared publicly.</p>
      <div class="ni-link-row">
        <input type="text" id="ni-sync-link" readonly placeholder="Send a message first to get your link"/>
        <button class="ni-copy-btn" id="ni-sync-copy" type="button">Copy</button>
      </div>
      <div class="ni-actions"><button class="ni-cancel" id="ni-sync-close" type="button">Done</button></div>
    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
