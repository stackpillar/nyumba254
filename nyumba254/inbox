  let presenceChannel = null, typingTimeout = null, lastTypingSentAt = 0, threadSearchTerm = '';

  const $ = (id) => document.getElementById(id);
  function escHtml(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function escAttr(s){ return String(s||'').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

  /* ── Quick replies ── */
  const QUICK_REPLIES_GENERAL = ['Is this still available?','Can you share more photos?','Is the price negotiable?',"What's included in the rent?",'Is a deposit required?','How far is it from town?'];
  function renderQuickReplies() {
    const box = $('ni-quick-replies');
    if (!box || !activeListingId) { if (box) box.innerHTML = ''; return; }
    const bookingChip = lastKnownBooked ? 'Can we reschedule the viewing?' : "I'd like to book a viewing";
    const chips = [...QUICK_REPLIES_GENERAL, bookingChip];
    box.innerHTML = chips.map(c => `<button type="button" class="ni-chip" data-txt="${escAttr(c)}">${escHtml(c)}</button>`).join('');
    box.querySelectorAll('.ni-chip').forEach(btn => btn.addEventListener('click', () => onQuickReplyClick(btn.dataset.txt)));
  }
  function onQuickReplyClick(text) {
    if (/book a viewing/i.test(text) && !/reschedule/i.test(text) && activeListingId) { openBookViewing(activeListingId, activeBuyerToken); return; }
    sendMessage(text);
  }

  /* ── Booking modal ── */
  let viewingContext = { listingId: null, buyerToken: null };
  let viewingSubmitting = false;
  function openBookViewing(listingId, buyerToken) {
    listingId = String(listingId);
    buyerToken = buyerToken || localStorage.getItem('nk_buyer_' + listingId) || null;
    viewingContext = { listingId, buyerToken };
    $('ni-v-date').value = ''; $('ni-v-date').min = new Date().toISOString().split('T')[0];
    $('ni-v-time').value = '';
    $('ni-v-name').value = localStorage.getItem('nk_buyer_name_' + listingId) || '';
    $('ni-v-phone').value = localStorage.getItem('nk_buyer_phone_' + listingId) || '';
    $('ni-v-notes').value = '';
    $('ni-viewing-overlay').classList.add('open');
  }
  function closeBookViewing() { $('ni-viewing-overlay').classList.remove('open'); }

  async function submitBookViewing() {
    if (viewingSubmitting) return;
    const { listingId } = viewingContext;
    if (!listingId) return;
    const date = $('ni-v-date').value, time = $('ni-v-time').value;
    const name = $('ni-v-name').value.trim(), phone = $('ni-v-phone').value.trim(), notes = $('ni-v-notes').value.trim();
    if (!date || !time || !name || !phone) { alert('Please fill in date, time, name and phone.'); return; }

    viewingSubmitting = true;
    const submitBtn = $('ni-v-submit');
    submitBtn.disabled = true; submitBtn.textContent = 'Sending…';

    let buyerToken = viewingContext.buyerToken || localStorage.getItem('nk_buyer_' + listingId);
    if (!buyerToken) {
      buyerToken = (crypto.randomUUID ? crypto.randomUUID() : Date.now()+'-'+Math.random().toString(36).slice(2));
      localStorage.setItem('nk_buyer_' + listingId, buyerToken);
    }
    localStorage.setItem('nk_buyer_name_' + listingId, name);
    localStorage.setItem('nk_buyer_phone_' + listingId, phone);

    const vId = (crypto.randomUUID ? crypto.randomUUID() : Date.now()+'-'+Math.random().toString(36).slice(2));
    const { error: vErr } = await gdb.from('viewing_requests').insert({
      id: vId, listing_id: listingId, buyer_token: buyerToken, buyer_name: name, buyer_phone: phone,
      requested_date: date, requested_time: time, notes: notes || null,
    });
    if (vErr) {
      viewingSubmitting = false;
      submitBtn.disabled = false; submitBtn.textContent = 'Request viewing';
      alert('Could not send your viewing request: ' + (vErr.message || 'unknown error') + ' — please try again.');
      return;
    }
    const summary = `📅 Viewing requested\nDate: ${date}\nTime: ${time}${notes ? `\nNotes: ${notes}` : ''}`;
    await gdb.from('messages').insert({ listing_id: listingId, buyer_token: buyerToken, buyer_name: name, buyer_phone: phone, sender: 'buyer', content: summary });
    fetch(`${EDGE_URL}/send-notification-email`, { method:'POST', headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`},
      body: JSON.stringify({ type:'viewing_request', listingId, buyerName:name, buyerPhone:phone, date, time, notes }) }).catch(()=>{});

    viewingSubmitting = false;
    submitBtn.disabled = false; submitBtn.textContent = 'Request viewing';
    closeBookViewing();
    updateBookButtonLabel(listingId, buyerToken);
    loadConversations().then(() => openConversation(listingId, buyerToken));
  }

  async function updateBookButtonLabel(listingId, buyerToken) {
    const btn = $('ni-book-btn');
    if (!btn) return;
    buyerToken = buyerToken || localStorage.getItem('nk_buyer_' + listingId);
    let booked = false;
    if (buyerToken) {
      const { count } = await gdb.from('viewing_requests').select('id', { count: 'exact', head: true }).eq('listing_id', listingId).eq('buyer_token', buyerToken);
      booked = (count || 0) > 0;
    }
    lastKnownBooked = booked;
    renderQuickReplies();
    btn.innerHTML = booked
      ? `<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Book another viewing`
      : `<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> Book a viewing`;
  }

  /* ── Read receipts ── */
  function tickSvg(isRead) { return `<svg class="ni-tick${isRead ? ' read' : ''}" viewBox="0 0 16 11" width="15" height="10"><path d="M1 5.5l3 3 5-6"/><path d="M6 5.5l3 3 5-6"/></svg>`; }
  function messageIsRead(m) { return !!m.read_at; }

  /* ── Presence: seller online / typing status ── */
  function setPresenceUI(state) {
    const dot = $('ni-presence-dot'), txt = $('ni-presence-text');
    if (!dot || !txt) return;
    if (state === 'online') { dot.style.background = '#2ecc71'; txt.textContent = 'Online now'; }
    else { dot.style.background = '#9a9a94'; txt.textContent = 'Offline'; }
  }
  function sellerCurrentlyOnline() {
    if (!presenceChannel) return false;
    return Object.keys(presenceChannel.presenceState()).some(k => k.startsWith('seller-'));
  }
  function showTypingIndicator() {
    const txt = $('ni-presence-text'), dot = $('ni-presence-dot');
    if (!txt) return;
    txt.textContent = 'Typing…'; dot.style.background = '#F0B429';
    clearTimeout(typingTimeout);
    typingTimeout = setTimeout(() => setPresenceUI(sellerCurrentlyOnline() ? 'online' : 'offline'), 2500);
  }
  function broadcastTyping() {
    if (!presenceChannel || !activeListingId) return;
    const now = Date.now();
    if (now - lastTypingSentAt < 2000) return;
    lastTypingSentAt = now;
    presenceChannel.send({ type: 'broadcast', event: 'typing', payload: { from: 'buyer' } });
  }
  function joinPresence(listingId, buyerToken) {
    leavePresence();
    presenceChannel = gdb.channel(`presence-${listingId}`, { config: { presence: { key: 'buyer-' + buyerToken } } });
    presenceChannel
      .on('presence', { event: 'sync' }, () => setPresenceUI(sellerCurrentlyOnline() ? 'online' : 'offline'))
      .on('broadcast', { event: 'typing' }, ({ payload }) => { if (payload?.from === 'seller') showTypingIndicator(); })
      .subscribe(async (status) => { if (status === 'SUBSCRIBED') await presenceChannel.track({ online: true, at: Date.now() }); });
  }
  function leavePresence() {
    if (presenceChannel) { gdb.removeChannel(presenceChannel); presenceChannel = null; }
    clearTimeout(typingTimeout);
  }

  /* ── In-thread search ── */
  function escRegex(s) { return String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
  function highlightText(text, term) {
    const esc = escHtml(text);
    if (!term) return esc;
    const re = new RegExp('(' + escRegex(escHtml(term)) + ')', 'ig');
    return esc.replace(re, '<mark style="background:#FFE58A;color:inherit;border-radius:2px;padding:0 1px">$1</mark>');
  }
  function toggleThreadSearch(show) {
    $('ni-thread-searchbar').style.display = show ? 'flex' : 'none';
    if (!show) { threadSearchTerm = ''; $('ni-thread-search-input').value = ''; $('ni-thread-search-count').textContent = ''; renderThread(); }
    else $('ni-thread-search-input').focus();
  }
  function runThreadSearch(term) {
    threadSearchTerm = term.trim();
    renderThread();
    const count = threadSearchTerm ? $('ni-messages').querySelectorAll('mark').length : 0;
    $('ni-thread-search-count').textContent = threadSearchTerm ? (count ? `${count} match${count > 1 ? 'es' : ''}` : 'No matches') : '';
    const firstMark = $('ni-messages').querySelector('mark');
    if (firstMark) firstMark.scrollIntoView({ block: 'center' });
  }

  /* ── Sync (resume-link) ── */
  function scanLocalConversations() {
    const out = [];
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      const m = key.match(/^nk_buyer_(?!name_|phone_)(.+)$/);
      if (!m) continue;
      const token = localStorage.getItem(key);
      if (token) out.push({ listingId: m[1], buyerToken: token });
    }
    return out;
  }
  function buildResumeLink() {
    const pairs = scanLocalConversations();
    if (!pairs.length) return null;
    const payload = pairs.map(p => `${p.listingId}:${p.buyerToken}`).join(',');
    const encoded = encodeURIComponent(btoa(unescape(encodeURIComponent(payload))));
    const url = new URL(window.location.origin + window.location.pathname);
    url.searchParams.set('nk_resume', encoded);
    return url.toString();
  }
  function importResumeParam() {
    const params = new URLSearchParams(window.location.search);
    const encoded = params.get('nk_resume');
    if (!encoded) return;
    try {
      const payload = decodeURIComponent(escape(atob(decodeURIComponent(encoded))));
      payload.split(',').forEach(pair => {
        const idx = pair.indexOf(':');
        if (idx < 0) return;
        const lid = pair.slice(0, idx), token = pair.slice(idx + 1);
        if (lid && token) localStorage.setItem('nk_buyer_' + lid, token);
      });
      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('nk_resume');
      window.history.replaceState({}, '', cleanUrl.toString());
    } catch (e) { console.error('Failed to import resume link:', e); }
  }
  function openSyncModal() { $('ni-sync-link').value = buildResumeLink() || ''; $('ni-sync-overlay').classList.add('open'); }
  function closeSyncModal() { $('ni-sync-overlay').classList.remove('open'); }

  function shareActiveListingWithFriend() {
    if (!activeListingId) return;
    const convo = conversations.find(c => c.listingId === activeListingId);
    const title = convo?.title || 'this property';
    const href = $('ni-thread-link')?.getAttribute('href');
    const listingUrl = href && href !== '#' ? `${location.origin}/${href}` : location.href;
    const text = `Check out "${title}" on Nyumba254: ${listingUrl}`;
    if (navigator.share) navigator.share({ title, text, url: listingUrl }).catch(() => {});
    else window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  }

  /* ── Conversation list & thread ── */
  function loadConversations() {
    if (loadPromise) return loadPromise;
    loadPromise = (async () => {
      const pairs = scanLocalConversations();
      if (!pairs.length) { conversations = []; renderList(); return; }
      const { data, error } = await gdb.rpc('get_buyer_conversations', { p_pairs: pairs.map(p => ({ listing_id: p.listingId, buyer_token: p.buyerToken })) });
      if (error) { console.error('get_buyer_conversations error:', error); return; }
      conversations = (data || []).map(row => ({
        listingId: String(row.listing_id), buyerToken: row.buyer_token,
        title: row.listing_title || 'Listing', coverUrl: row.cover_url || '',
        sellerName: row.seller_name || 'Seller', sellerVerified: row.seller_verified === true,
        lastMessage: row.last_message || '', lastAt: row.last_message_at, unread: row.unread_count || 0,
      })).sort((a,b) => new Date(b.lastAt||0) - new Date(a.lastAt||0));
      renderList();
      updateTabTitle();
      subscribeAll();
    })();
    loadPromise.finally(() => { loadPromise = null; });
    return loadPromise;
  }

  function updateTabTitle() {
    const n = conversations.reduce((s,c) => s + c.unread, 0);
    document.title = n > 0 ? `(${n > 9 ? '9+' : n}) My Chats — Nyumba254` : 'My Chats — Nyumba254';
  }

  function renderList() {
    const list = $('ni-list');
    const term = searchTerm.trim().toLowerCase();
    const visible = term ? conversations.filter(c => c.title.toLowerCase().includes(term) || c.sellerName.toLowerCase().includes(term)) : conversations;
    if (!conversations.length) { list.innerHTML = '<div id="ni-empty">No conversations yet — messages you send to sellers will show up here.</div>'; return; }
    if (!visible.length) { list.innerHTML = '<div id="ni-empty">No conversations match your search.</div>'; return; }
    list.innerHTML = visible.map(c => `
      <div class="ni-convo${c.listingId===activeListingId?' active':''}" data-listing="${c.listingId}">
        ${c.coverUrl ? `<img class="ni-convo-img" src="${c.coverUrl}"/>` : `<div class="ni-convo-img"></div>`}
        <div class="ni-convo-body">
          <div class="ni-convo-title">${escHtml(c.title)}${c.sellerVerified ? ' <svg style="display:inline;vertical-align:-2px;color:var(--green)" viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 2l2.4 2.4 3.3-.5.5 3.3L21 9.5 18.4 12 21 14.5l-2.8 2.3-.5 3.3-3.3-.5L12 22l-2.4-2.4-3.3.5-.5-3.3L3 14.5 5.6 12 3 9.5l2.8-2.3.5-3.3 3.3.5z"/></svg>' : ''}</div>
          <div class="ni-convo-last">${escHtml(c.lastMessage || 'No messages yet')}</div>
        </div>
        ${c.unread ? `<div class="ni-convo-badge">${c.unread>9?'9+':c.unread}</div>` : ''}
      </div>`).join('');
    list.querySelectorAll('.ni-convo').forEach(el => el.addEventListener('click', () => openConversation(el.dataset.listing)));
  }

  async function openConversation(listingId, knownBuyerToken) {
    listingId = String(listingId);
    let convo = conversations.find(c => c.listingId === listingId);
    const buyerToken = convo?.buyerToken || knownBuyerToken || localStorage.getItem('nk_buyer_' + listingId);
    if (!buyerToken) return;

    if (!convo) {
      convo = { listingId, buyerToken, title: 'Listing', sellerName: 'Seller', lastMessage: '', lastAt: null, unread: 0, coverUrl: '' };
      conversations.unshift(convo);
    }

    activeListingId = listingId; activeBuyerToken = buyerToken; activeMessages = [];
    document.body.classList.add('ni-thread-open');
    $('ni-thread').classList.add('open');
    $('ni-thread-empty').style.display = 'none';
    updateBookButtonLabel(listingId, buyerToken);
    joinPresence(listingId, buyerToken);
    renderList();

    const verifiedBadge = convo.sellerVerified
      ? `<svg class="ni-verified" viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M12 2l2.4 2.4 3.3-.5.5 3.3L21 9.5 18.4 12 21 14.5l-2.8 2.3-.5 3.3-3.3-.5L12 22l-2.4-2.4-3.3.5-.5-3.3L3 14.5 5.6 12 3 9.5l2.8-2.3.5-3.3 3.3.5z"/><path d="M9 12l2 2 4-4" stroke="var(--green)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>` : '';
    $('ni-thread-name').innerHTML = `<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(convo.sellerName)}</span>${verifiedBadge}`;
    $('ni-thread-link').href = '#';
    $('ni-messages').innerHTML = '<div style="text-align:center;font-size:12px;color:var(--muted);padding:16px">Loading messages…</div>';

    const [{ data, error }, { data: listingRow }] = await Promise.all([
      gdb.from('messages').select('*').eq('listing_id', listingId).eq('buyer_token', buyerToken).order('created_at', { ascending: true }),
      gdb.from('listings').select('listing_number').eq('id', listingId).single()
    ]);
    if (activeListingId !== listingId) return;
    if (listingRow?.listing_number != null) $('ni-thread-link').href = `listing?id=${String(listingRow.listing_number).padStart(6, '0')}`;

    if (!error) {
      activeMessages = data || [];
      renderThread();
      await gdb.rpc('mark_thread_read', { p_listing_id: listingId, p_buyer_token: buyerToken });
      convo.unread = 0;
      renderList();
      updateTabTitle();
      subscribeAll();
    }
    loadConversations();
  }

  function closeThread() {
    document.body.classList.remove('ni-thread-open');
    activeListingId = null; activeBuyerToken = null; activeMessages = [];
    $('ni-thread').classList.remove('open');
    $('ni-thread-empty').style.display = 'flex';
    toggleThreadSearch(false);
    leavePresence();
    renderList();
  }

  function renderThread() {
    const box = $('ni-messages');
    if (!activeMessages.length) { box.innerHTML = '<div style="text-align:center;font-size:12px;color:var(--muted);padding:16px">No messages yet</div>'; renderQuickReplies(); return; }
    let lastDate = '';
    box.innerHTML = activeMessages.map(m => {
      const mine = m.sender === 'buyer';
      const d = new Date(m.created_at);
      const dateStr = d.toLocaleDateString('en-KE',{weekday:'short',day:'numeric',month:'short'});
      const time = d.toLocaleTimeString('en-KE',{hour:'2-digit',minute:'2-digit'});
      const sep = dateStr !== lastDate ? `<div class="ni-date-sep">${dateStr}</div>` : ''; lastDate = dateStr;
      const bodyText = (m.content || m.message || '').replace(/^🤖\s*\[Automated reply\]\s*/, '');
      const ticks = mine ? tickSvg(messageIsRead(m)) : '';
      return `${sep}<div class="ni-row ${mine?'mine':''}">
        <div class="ni-av">${mine?'You':'S'}</div>
        <div><div class="ni-bubble">${highlightText(bodyText, threadSearchTerm)}</div><div class="ni-time">${time}${ticks}</div></div>
      </div>`;
    }).join('');
    box.scrollTop = box.scrollHeight;
    renderQuickReplies();
  }

  async function triggerAiConcierge(listingId, buyerToken, message) {
    try {
      const buyerName = localStorage.getItem('nk_buyer_name_' + listingId) || '';
      await fetch(`${EDGE_URL}/ai-concierge-reply`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` },
        body: JSON.stringify({ listingId, buyerToken, buyerName, buyerMessage: message }) });
    } catch (e) { console.error('AI concierge trigger failed (non-fatal):', e); }
  }

  async function sendMessage(overrideText) {
    const input = $('ni-input');
    const fromChip = typeof overrideText === 'string';
    const text = (fromChip ? overrideText : input.value).trim();
    if (!text || !activeListingId || !activeBuyerToken) return;
    const sendBtn = $('ni-send');
    sendBtn.disabled = true;
    if (!fromChip) { input.value = ''; input.style.height = 'auto'; }

    const { data, error } = await gdb.from('messages').insert({
      listing_id: activeListingId, buyer_token: activeBuyerToken,
      buyer_name: localStorage.getItem('nk_buyer_name_' + activeListingId) || '',
      buyer_phone: localStorage.getItem('nk_buyer_phone_' + activeListingId) || null,
      sender: 'buyer', content: text
    }).select().single();

    sendBtn.disabled = false;
    if (error) { alert('Could not send message, please try again.'); return; }

    activeMessages.push(data);
    renderThread();
    const convo = conversations.find(c => c.listingId === activeListingId);
    if (convo) { convo.lastMessage = text; convo.lastAt = data.created_at; renderList(); }
    triggerAiConcierge(activeListingId, activeBuyerToken, text);
  }

  function subscribeAll() {
    conversations.forEach(c => {
      if (channels[c.listingId]) return;
      channels[c.listingId] = gdb.channel(`ni-messages-${c.listingId}`)
        .on('postgres_changes', { event:'INSERT', schema:'public', table:'messages', filter:`listing_id=eq.${c.listingId}` }, (payload) => {
          const row = payload.new;
          if (row.buyer_token !== c.buyerToken) return;
          if (row.sender !== 'seller') return;
          c.lastMessage = row.content || row.message || '';
          c.lastAt = row.created_at;
          if (activeListingId === c.listingId) {
            if (!activeMessages.some(m => m.id === row.id)) { activeMessages.push(row); renderThread(); }
            gdb.rpc('mark_thread_read', { p_listing_id: c.listingId, p_buyer_token: c.buyerToken });
          } else { c.unread += 1; }
          renderList();
          updateTabTitle();
        }).subscribe();
    });
  }

  /* ── Wiring ── */
  $('ni-send').addEventListener('click', () => sendMessage());
  $('ni-input').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } });
  $('ni-input').addEventListener('input', function(){ this.style.height='auto'; this.style.height=Math.min(this.scrollHeight,120)+'px'; broadcastTyping(); });
  $('ni-search').addEventListener('input', function(){ searchTerm = this.value; renderList(); });
  $('ni-thread-back').addEventListener('click', closeThread);
  $('ni-thread-search-btn').addEventListener('click', () => toggleThreadSearch($('ni-thread-searchbar').style.display !== 'flex'));
  $('ni-thread-search-close').addEventListener('click', () => toggleThreadSearch(false));
  $('ni-thread-search-input').addEventListener('input', function(){ runThreadSearch(this.value); });

  $('ni-book-btn').addEventListener('click', () => { if (activeListingId) openBookViewing(activeListingId, activeBuyerToken); });
  $('ni-v-cancel').addEventListener('click', closeBookViewing);
  $('ni-v-submit').addEventListener('click', submitBookViewing);
  $('ni-viewing-overlay').addEventListener('click', (e) => { if (e.target.id === 'ni-viewing-overlay') closeBookViewing(); });

  $('ni-invite-btn').addEventListener('click', shareActiveListingWithFriend);
  $('ni-sync-btn').addEventListener('click', openSyncModal);
  $('ni-sync-close').addEventListener('click', closeSyncModal);
  $('ni-sync-overlay').addEventListener('click', (e) => { if (e.target.id === 'ni-sync-overlay') closeSyncModal(); });
  $('ni-sync-copy').addEventListener('click', () => {
    const input = $('ni-sync-link');
    if (!input.value) return;
    navigator.clipboard.writeText(input.value).then(() => {
      const btn = $('ni-sync-copy'); const orig = btn.textContent;
      btn.textContent = 'Copied!'; setTimeout(() => { btn.textContent = orig; }, 1800);
    });
  });

  // Public API, kept for parity with the floating widget in case this page
  // is ever deep-linked to a specific conversation (e.g. inbox.html?open=123).
  window.NKInbox = { refresh: loadConversations, open: openConversation, getResumeLink: buildResumeLink };

  importResumeParam();
  const params = new URLSearchParams(window.location.search);
  const openParam = params.get('open');
  loadConversations().then(() => { if (openParam) openConversation(openParam); });
  setInterval(loadConversations, 20000);
    /* ── Buyer profile (name/email/phone) + offline notifications ── */
  const NI_PROFILE_KEYS = { name:'nk_profile_name', email:'nk_profile_email', phone:'nk_profile_phone', notify:'nk_profile_notify' };
  function loadProfile() {
    return {
      name: localStorage.getItem(NI_PROFILE_KEYS.name) || '',
      email: localStorage.getItem(NI_PROFILE_KEYS.email) || '',
      phone: localStorage.getItem(NI_PROFILE_KEYS.phone) || '',
      notify: localStorage.getItem(NI_PROFILE_KEYS.notify) !== '0',
    };
  }
  function openProfileModal() {
    const p = loadProfile();
    $('ni-p-name').value = p.name; $('ni-p-email').value = p.email; $('ni-p-phone').value = p.phone;
    $('ni-p-notify').checked = p.notify;
    $('ni-profile-status').textContent = '';
    $('ni-profile-overlay').classList.add('open');
  }
  function closeProfileModal() { $('ni-profile-overlay').classList.remove('open'); }

  async function saveProfileAndNotify() {
    const name = $('ni-p-name').value.trim();
    const email = $('ni-p-email').value.trim();
    const phone = $('ni-p-phone').value.trim();
    const notify = $('ni-p-notify').checked;
    localStorage.setItem(NI_PROFILE_KEYS.name, name);
    localStorage.setItem(NI_PROFILE_KEYS.email, email);
    localStorage.setItem(NI_PROFILE_KEYS.phone, phone);
    localStorage.setItem(NI_PROFILE_KEYS.notify, notify ? '1' : '0');

    const statusEl = $('ni-profile-status');
    const btn = $('ni-profile-save');
    btn.disabled = true; btn.textContent = 'Saving…';

    // Push this contact info onto every listing conversation this browser knows about,
    // keyed by buyer_token — this is what lets sellers/admin AND the email notifier
    // find this buyer's email later, regardless of which listing they're messaging about.
    const pairs = scanLocalConversations();
    for (const { buyerToken } of pairs) {
      try {
        await gdb.from('buyer_contacts').upsert({
          buyer_token: buyerToken, full_name: name || null, email: email || null,
          phone: phone || null, notify_email: notify, updated_at: new Date().toISOString(),
        }, { onConflict: 'buyer_token' });
      } catch (e) { console.error('buyer_contacts upsert failed:', e); }
    }

    if (email) {
      const link = buildResumeLink();
      if (link) {
        fetch(`${EDGE_URL}/send-notification-email`, {
          method: 'POST', headers: { 'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}` },
          body: JSON.stringify({ type: 'buyer_access_link', buyerEmail: email, buyerName: name, accessLink: link }),
        }).catch(()=>{});
        statusEl.textContent = 'Saved ✓ — check your email for your access link.';
      } else {
        statusEl.textContent = 'Saved ✓ (start a chat first to get an emailed access link).';
      }
    } else {
      statusEl.textContent = 'Saved ✓';
    }
    btn.disabled = false; btn.textContent = 'Save & email me my link';
    setTimeout(closeProfileModal, 1400);
  }

  $('ni-profile-btn').addEventListener('click', openProfileModal);
  $('ni-profile-cancel').addEventListener('click', closeProfileModal);
  $('ni-profile-overlay').addEventListener('click', (e) => { if (e.target.id === 'ni-profile-overlay') closeProfileModal(); });
  $('ni-profile-save').addEventListener('click', saveProfileAndNotify);

  /* ── Saved listings tab ──
     Matches saved.html exactly: one key, nk_saved_listings, holding a
     JSON array of listing ids (not per-listing nk_saved_<id> flags). */
  const SAVED_LISTINGS_KEY = 'nk_saved_listings';
  function scanSavedListingIds() {
    try {
      const raw = localStorage.getItem(SAVED_LISTINGS_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch (e) { return []; }
  }
  let savedListingsLoaded = false;
  async function loadSavedListings() {
    const ids = scanSavedListingIds();
    const countBadge = $('ni-saved-count');
    countBadge.textContent = ids.length; countBadge.style.display = ids.length ? 'inline-block' : 'none';
    const panel = $('ni-saved-panel');
    if (!ids.length) { panel.innerHTML = '<div style="padding:40px 20px;text-align:center;color:var(--muted);font-size:13.5px">No saved listings yet — tap the heart icon on any listing to save it here.</div>'; return; }
    panel.innerHTML = '<div style="padding:40px 20px;text-align:center;color:var(--muted);font-size:13.5px">Loading…</div>';
    const { data, error } = await gdb.from('listings').select('id,title,area,price,price_frequency,listing_number,listing_photos(*)').in('id', ids).eq('status','active');
    if (error || !data) { panel.innerHTML = '<div style="padding:20px;color:var(--muted);font-size:13px">Could not load saved listings.</div>'; return; }
    panel.innerHTML = data.map(l => {
      const cover = (l.listing_photos||[]).find(p=>p.is_cover) || (l.listing_photos||[])[0];
      const suffix = { month:'/mo', night:'/night', week:'/week', term:'/term' }[l.price_frequency] || '';
      return `<div class="ni-saved-item" data-id="${l.id}">
        ${cover ? `<img class="ni-saved-img" src="${cover.url}"/>` : `<div class="ni-saved-img"></div>`}
        <div style="flex:1;min-width:0">
          <div class="ni-saved-title">${(l.title||'').replace(/</g,'&lt;')}</div>
          <div class="ni-saved-sub">${(l.area||'').replace(/</g,'&lt;')}</div>
          <div class="ni-saved-price">KES ${Number(l.price||0).toLocaleString('en-KE')}${suffix}</div>
        </div>
        <button class="ni-saved-remove" data-id="${l.id}" title="Remove">✕</button>
      </div>`;
    }).join('');
    panel.querySelectorAll('.ni-saved-item').forEach(el => el.addEventListener('click', (e) => {
      if (e.target.classList.contains('ni-saved-remove')) return;
      const listingRow = data.find(x => x.id === el.dataset.id);
      window.location.href = `listing?id=${String(listingRow.listing_number).padStart(6,'0')}`;
    }));
    panel.querySelectorAll('.ni-saved-remove').forEach(btn => btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const remaining = scanSavedListingIds().filter(id => id !== btn.dataset.id);
      localStorage.setItem(SAVED_LISTINGS_KEY, JSON.stringify(remaining));
      loadSavedListings();
    }));
  }
  function switchSidebarTab(tab) {
    document.querySelectorAll('.ni-sidebar-tab').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
    $('ni-search-row').style.display = tab === 'chats' ? 'block' : 'none';
    $('ni-list').style.display = tab === 'chats' ? 'block' : 'none';
    $('ni-saved-panel').style.display = tab === 'saved' ? 'block' : 'none';
    if (tab === 'saved' && !savedListingsLoaded) { savedListingsLoaded = true; loadSavedListings(); }
  }
})();
</script>
</body>
