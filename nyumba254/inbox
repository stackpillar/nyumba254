  $('ni-list').addEventListener('click', e => { const c = e.target.closest('.ni-convo'); if (c) return openConvo(c.dataset.l); if (e.target.closest('[data-a="reload"]')) core.fetchConversations(); });
  $('ni-saved').addEventListener('click', e => {
    const rm = e.target.closest('[data-rm]'); if (rm) { core.setSaved(core.savedIds().filter(i => i !== rm.dataset.rm)); return renderSaved(); }
    const g = e.target.closest('[data-a="clear-gone"]'); if (g) { const gone = g.dataset.ids.split(','); core.setSaved(core.savedIds().filter(i => !gone.includes(i))); return renderSaved(); }
    if (e.target.closest('[data-a="reload-saved"]')) renderSaved();
  });
  $('ni-messages').addEventListener('click', e => { const r = e.target.closest('[data-retry]'); if (r) core.retry(r.dataset.retry); if (e.target.closest('[data-a="reopen"]')) { const a = core.active(); if (a) core.openThread(a.listingId, a.token); } });
  $('ni-messages').addEventListener('scroll', () => { if (atBottom()) $('ni-newpill').classList.remove('show'); }, { passive: true });
  $('ni-newpill').addEventListener('click', toBottom);
  $('ni-quick').addEventListener('click', e => { const c = e.target.closest('.ni-chip'); if (!c) return; const t = c.dataset.q; if (/book a viewing/i.test(t)) return openViewing(); sendText(t); });
  $('ni-send').addEventListener('click', sendInput);
  $('ni-input').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendInput(); } });
  $('ni-input').addEventListener('input', function () { this.style.height = 'auto'; this.style.height = Math.min(this.scrollHeight, 120) + 'px'; core.typing(); });
  $('ni-back-btn').addEventListener('click', () => closeThread());
  $('ni-tsearch-btn').addEventListener('click', () => toggleThreadSearch(!$('ni-searchbar').classList.contains('show')));
  $('ni-tsearch-x').addEventListener('click', () => toggleThreadSearch(false));
  $('ni-tsearch').addEventListener('input', function () { threadTerm = this.value.trim(); renderMessages(); });
  $('ni-book-btn').addEventListener('click', openViewing); $('ni-invite-btn').addEventListener('click', invite);
  $('ni-vcancel').addEventListener('click', () => closeModal('ni-vov')); $('ni-vsend').addEventListener('click', sendViewing);
  $('ni-profile-btn').addEventListener('click', openProfile); $('ni-pcancel').addEventListener('click', () => closeModal('ni-pov')); $('ni-psave').addEventListener('click', saveProfile);
  $('ni-sync-btn').addEventListener('click', openSync); $('ni-sync-close').addEventListener('click', () => closeModal('ni-sov'));
  $('ni-sync-copy').addEventListener('click', () => { const i = $('ni-sync-link'); if (!i.value) return; (navigator.clipboard ? navigator.clipboard.writeText(i.value) : Promise.reject()).then(() => { const b = $('ni-sync-copy'), o = b.textContent; b.textContent = 'Copied'; setTimeout(() => { b.textContent = o; }, 1800); }, () => i.select()); });
  $('ni-safety-x').addEventListener('click', () => { core.ls.set('nk_chat_safety_seen', '1'); $('ni-safety').classList.remove('show'); });
  $('ni-report').addEventListener('click', async function () {
    const a = core.active(); if (!a) return;
    if (this.dataset.a === 'ask') { $('ni-safety-t').textContent = 'Send a report about this seller to Nyumba254?'; this.textContent = 'Yes, report'; this.dataset.a = 'go'; return; }
    this.disabled = true; const r = await core.report(a.listingId, 'Reported from the inbox'); this.disabled = false; this.dataset.a = 'ask'; this.textContent = 'Report';
    $('ni-safety-t').textContent = r.ok ? "Thank you. We've received your report." : 'The report could not be sent. Please try again.';
  });
  document.addEventListener('visibilitychange', () => core.setViewing(vis()));

  core.on('convos', () => { renderCounts(); if (tab === 'chats') renderList(); renderHead(); });
  core.on('thread', ev => { if (ev.type === 'reset') { renderMessages(ev); renderHead(); } else if (ev.type === 'append') appendMessage(ev.message, ev.incoming); else if (ev.type === 'update') updateMessage(ev.message); });
  core.on('presence', renderPresence); core.on('viewing', () => { renderHead(); renderQuick(); });
  core.on('net', ev => $('ni-net').classList.toggle('show', !ev.online));
  if (!core.isOnline()) $('ni-net').classList.add('show');

  /* ── start ── */
  core.setPolling(true); core.init(); renderCounts(); renderList();
  const params = new URLSearchParams(location.search);
  if (params.get('tab') === 'saved') switchTab('saved');
  const open = params.get('open'); if (open) core.fetchConversations().then(() => openConvo(open));
  window.NKInbox = { refresh: core.fetchConversations, open: openConvo, getResumeLink: core.buildResumeLink };
})();
</script>
</body>
</html>