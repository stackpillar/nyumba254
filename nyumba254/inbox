<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>My Chats — Nyumba254</title>
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#0F6E56">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --green:#0F6E56; --green-dark:#085041; --tint:#E1F5EE; --tint-border:#bfe6d8;
    --surface:#fff; --app-bg:#f7f6f2; --border:#e0ded8;
    --ink:#1a1a18; --ink-2:#4a4a46; --muted:#6b6a63; --alert:#C53030;
    --amber:#7a4f00; --amber-bg:#FFF7E6; --amber-border:#F3D9A0;
  }
  *,*::before,*::after{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{font-family:'Inter',system-ui,sans-serif;color:var(--ink);background:var(--app-bg);overflow:hidden}
  button,input,textarea,select{font-family:inherit}
  button{cursor:pointer}
  :focus-visible{outline:2px solid var(--green);outline-offset:2px}
  a{color:inherit}
  [hidden]{display:none!important}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
  @media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

  #ni-app{display:flex;flex-direction:column;height:100vh;height:100dvh}

  /* ── Header ── */
  #ni-header{flex-shrink:0;background:var(--green);color:#fff;display:flex;align-items:center;gap:12px;padding:10px 20px;padding-top:calc(10px + env(safe-area-inset-top,0px));min-height:60px}
  #ni-back{display:flex;align-items:center;gap:5px;font-size:13.5px;font-weight:600;text-decoration:none;color:rgba(255,255,255,.92);flex-shrink:0;white-space:nowrap;min-height:44px}
  #ni-back:hover{color:#fff}
  #ni-back svg{width:15px;height:15px}
  #ni-title-wrap{flex:1;min-width:0}
  #ni-title{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;line-height:1.2}
  #ni-subtitle{font-size:12.5px;opacity:.88;margin-top:1px}
  .ni-hbtn{flex-shrink:0;background:rgba(255,255,255,.16);border:0;color:#fff;padding:0 14px;height:40px;border-radius:20px;display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600}
  .ni-hbtn:hover{background:rgba(255,255,255,.28)}
  .ni-hbtn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0}
  @media(max-width:640px){#ni-header{padding-left:12px;padding-right:12px;gap:8px}.ni-hbtn span{display:none}.ni-hbtn{width:44px;height:44px;padding:0;justify-content:center;border-radius:50%}#ni-back span{display:none}#ni-title{font-size:19px}}

  #ni-net{display:none;background:var(--amber-bg);color:var(--amber);border-bottom:1px solid var(--amber-border);font-size:13px;padding:8px 16px;text-align:center;flex-shrink:0}
  #ni-net.show{display:block}

  /* ── Body: two panes on desktop, one on mobile ── */
  #ni-body{flex:1;display:flex;min-height:0}
  #ni-sidebar{width:370px;flex-shrink:0;display:flex;flex-direction:column;border-right:1px solid var(--border);background:var(--surface);min-height:0}
  #ni-tabs{display:flex;gap:6px;padding:10px 12px 0;flex-shrink:0}
  .ni-tab{flex:1;min-height:44px;border:1.5px solid var(--border);border-radius:10px;background:var(--surface);color:var(--ink-2);font-size:13.5px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:6px}
  .ni-tab[aria-selected="true"]{background:var(--green);border-color:var(--green);color:#fff}
  .ni-count{background:var(--alert);color:#fff;border-radius:10px;font-size:11px;padding:1px 7px;min-width:19px;text-align:center}
  #ni-search-row{padding:10px 12px;border-bottom:1px solid var(--border);flex-shrink:0}
  #ni-search{width:100%;min-height:44px;padding:9px 13px;border:1.5px solid var(--border);border-radius:10px;font-size:16px;background:var(--app-bg);color:var(--ink);outline:none}
  #ni-search:focus{border-color:var(--green);background:#fff}
  #ni-list,#ni-saved{flex:1;overflow-y:auto;min-height:0;overscroll-behavior:contain}
  .ni-state{padding:40px 22px;text-align:center;color:var(--muted);font-size:14px;line-height:1.55}
  .ni-btn{background:var(--green);color:#fff;border:0;border-radius:10px;min-height:44px;padding:0 20px;font-size:14px;font-weight:600}
  .ni-btn:hover{background:var(--green-dark)}.ni-btn:disabled{opacity:.6;cursor:not-allowed}
  .ni-btn.ghost{background:var(--app-bg);color:var(--ink-2)}.ni-btn.ghost:hover{background:var(--border)}
  .ni-state .ni-btn{margin-top:12px}
  .ni-sk{height:48px;margin:14px;border-radius:10px;background:linear-gradient(90deg,var(--border) 25%,var(--app-bg) 50%,var(--border) 75%);background-size:200% 100%;animation:ni-sh 1.3s infinite}
  @keyframes ni-sh{to{background-position:-200% 0}}

  .ni-convo{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:13px 15px;border:0;border-bottom:1px solid var(--border);background:transparent;color:inherit;min-height:72px}
  .ni-convo:hover,.ni-convo[aria-current="true"]{background:var(--app-bg)}
  .ni-thumb{width:48px;height:48px;border-radius:10px;background:var(--border);flex-shrink:0;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:var(--green-dark)}
  .ni-thumb img{width:100%;height:100%;object-fit:cover}
  .ni-cb{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
  .ni-ct{font-size:14px;font-weight:600;display:flex;align-items:center;gap:5px;min-width:0}
  .ni-ct span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ni-ct svg{width:13px;height:13px;color:var(--green);flex-shrink:0}
  .ni-cl{font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ni-cm{display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex-shrink:0}
  .ni-cw{font-size:11.5px;color:var(--muted)}
  .ni-badge{background:var(--alert);color:#fff;font-size:11px;font-weight:700;border-radius:10px;min-width:20px;height:20px;padding:0 5px;display:flex;align-items:center;justify-content:center}

  .ni-saved-row{display:flex;align-items:center;gap:6px;padding:6px 6px 6px 15px;border-bottom:1px solid var(--border);min-height:72px}
  .ni-saved-row:hover{background:var(--app-bg)}
  .ni-saved-link{display:flex;align-items:center;gap:12px;flex:1;min-width:0;text-decoration:none;color:inherit;min-height:56px}
  .ni-saved-body{flex:1;min-width:0}
  .ni-saved-title{font-size:14px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ni-saved-sub{font-size:12.5px;color:var(--muted);margin-top:2px}
  .ni-saved-price{font-size:13px;font-weight:700;color:var(--green-dark);margin-top:3px}
  .ni-saved-rm{border:0;background:none;color:var(--muted);font-size:17px;width:44px;height:44px;border-radius:50%;flex-shrink:0}
  .ni-saved-rm:hover{background:var(--border);color:var(--ink)}

  /* ── Thread pane ── */
  #ni-thread-pane{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0;background:var(--app-bg)}
  #ni-thread-empty{flex:1;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:14.5px;padding:20px;text-align:center}
  #ni-thread{display:none;flex-direction:column;flex:1;min-height:0}
  #ni-thread.open{display:flex}
  #ni-thead{background:var(--green);color:#fff;padding:8px 10px 8px 8px;display:flex;align-items:center;gap:6px;flex-shrink:0;min-height:60px}
  .ni-ib{background:none;border:0;color:#fff;min-width:44px;height:44px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;opacity:.92}
  .ni-ib:hover,.ni-hpill:hover{background:rgba(255,255,255,.18);opacity:1}
  .ni-ib svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2}
  .ni-hpill{background:rgba(255,255,255,.14);border:0;color:#fff;height:40px;padding:0 14px;border-radius:20px;display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;flex-shrink:0}
  .ni-hpill svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2}
  #ni-back-btn{display:none}
  #ni-tinfo{flex:1;min-width:0;padding-left:6px}
  #ni-tname{font-size:15.5px;font-weight:600;display:flex;align-items:center;gap:5px;min-width:0}
  #ni-tname span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #ni-tname svg{width:15px;height:15px;color:#7CE0C0;flex-shrink:0}
  #ni-presence{display:flex;align-items:center;gap:6px;font-size:12px;color:rgba(255,255,255,.88);margin-top:1px}
  #ni-dot{width:7px;height:7px;border-radius:50%;background:#b8b8b0;flex-shrink:0}
  #ni-dot.online{background:#2ecc71}#ni-dot.typing{background:#F0B429}
  #ni-searchbar{display:none;align-items:center;gap:8px;padding:8px 14px;background:var(--tint);border-bottom:1px solid var(--border);flex-shrink:0}
  #ni-searchbar.show{display:flex}
  #ni-tsearch{flex:1;min-height:40px;padding:6px 12px;border:1.5px solid var(--tint-border);border-radius:9px;font-size:16px;outline:none;background:#fff;color:var(--ink)}
  #ni-tcount{font-size:12px;color:var(--green-dark);white-space:nowrap}
  #ni-tsearch-x{border:0;background:none;color:var(--green-dark);font-size:18px;width:40px;height:40px}

  .ni-lcard{display:flex;align-items:center;gap:12px;padding:9px 16px;background:var(--tint);border-bottom:1px solid var(--border);flex-shrink:0;text-decoration:none;color:inherit;min-height:60px}
  a.ni-lcard:hover{background:var(--surface)}
  .ni-lcard .ni-thumb{width:42px;height:42px;border-radius:8px}
  .ni-lc-t{flex:1;min-width:0;display:flex;flex-direction:column}
  .ni-lc-t b{font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ni-lc-t span{font-size:12.5px;color:var(--green-dark);font-weight:600}
  .ni-lc-go{font-size:12.5px;font-weight:700;color:var(--green-dark);white-space:nowrap}

  #ni-safety{display:none;align-items:center;gap:8px;padding:8px 16px;background:var(--amber-bg);border-bottom:1px solid var(--amber-border);font-size:13px;color:var(--amber);line-height:1.45;flex-shrink:0}
  #ni-safety.show{display:flex}
  #ni-safety p{flex:1;margin:0}
  #ni-safety button{background:none;border:0;color:inherit;font-weight:700;font-size:13px;text-decoration:underline;min-height:36px;padding:0 6px}

  #ni-msgs-wrap{position:relative;flex:1;min-height:0;display:flex;flex-direction:column}
  #ni-messages{flex:1;min-height:0;overflow-y:auto;padding:18px 20px;display:flex;flex-direction:column;gap:2px;overscroll-behavior:contain}
  #ni-newpill{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);display:none;background:var(--green);color:#fff;border:0;border-radius:20px;padding:0 18px;min-height:38px;font-size:13px;font-weight:600;box-shadow:0 4px 14px rgba(0,0,0,.25)}
  #ni-newpill.show{display:block}
  .ni-empty-thread{margin:auto;text-align:center;color:var(--muted);font-size:14px;line-height:1.6;padding:24px}
  .ni-empty-thread b{display:block;color:var(--ink);font-size:16px;margin-bottom:4px}
  .ni-empty-thread .ni-btn{margin-top:12px}
  .ni-day{text-align:center;font-size:12px;color:var(--muted);padding:12px 0 6px;font-weight:600}
  .ni-row{display:flex;gap:7px;align-items:flex-end;width:100%;margin-top:2px}
  .ni-row.first{margin-top:9px}
  .ni-row.mine{flex-direction:row-reverse}
  .ni-av{width:28px;height:28px;border-radius:50%;font-size:10.5px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--tint);color:var(--green-dark)}
  .ni-row.mine .ni-av{background:var(--green);color:#fff}
  .ni-av.ni-avsp{visibility:hidden}
  .ni-col{max-width:66%;display:flex;flex-direction:column;min-width:0}
  .ni-row.mine .ni-col{align-items:flex-end}
  .ni-bubble{width:fit-content;max-width:100%;padding:9px 14px;border-radius:15px;font-size:14.5px;line-height:1.5;background:var(--surface);border:1px solid var(--border);border-bottom-left-radius:4px;overflow-wrap:anywhere;white-space:pre-wrap}
  .ni-row.mine .ni-bubble{background:var(--green);color:#fff;border:0;border-bottom-left-radius:15px;border-bottom-right-radius:4px}
  .ni-row.failed .ni-bubble{background:var(--alert);opacity:.92}
  .ni-bubble mark{background:#FFE58A;color:inherit;border-radius:2px;padding:0 1px}
  .ni-time{font-size:11.5px;color:var(--muted);margin-top:2px;display:inline-flex;align-items:center;gap:3px}
  .ni-tick svg{stroke:#9a9a94;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;vertical-align:-1px}
  .ni-tick.read svg{stroke:#34B7F1}
  .ni-ai{font-size:11.5px;color:var(--muted);margin-top:3px;font-style:italic}
  .ni-retry{background:none;border:0;color:var(--alert);font-size:12.5px;font-weight:700;text-decoration:underline;padding:6px 0;min-height:32px}
  .ni-queued{font-size:12px;color:var(--amber);margin-top:2px}
  @media(max-width:860px){.ni-col{max-width:82%}}

  #ni-quick{display:flex;gap:6px;flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:9px 16px;background:var(--surface);border-top:1px solid var(--border);flex-shrink:0;mask-image:linear-gradient(to right,#000 94%,transparent);-webkit-mask-image:linear-gradient(to right,#000 94%,transparent)}
  #ni-quick::-webkit-scrollbar{display:none}
  #ni-quick:empty{display:none}
  .ni-chip{flex-shrink:0;background:var(--tint);color:var(--green-dark);border:1px solid var(--tint-border);border-radius:18px;padding:0 14px;min-height:38px;font-size:13px;font-weight:600;white-space:nowrap}
  .ni-chip:hover{background:#c9ecdd}
  #ni-inrow{display:flex;align-items:flex-end;gap:10px;padding:12px 16px;padding-bottom:calc(12px + env(safe-area-inset-bottom,0px));background:var(--surface);border-top:1px solid var(--border);flex-shrink:0}
  #ni-input{flex:1;resize:none;border:1.5px solid var(--border);border-radius:12px;padding:10px 14px;font-size:16px;outline:none;min-height:46px;max-height:120px;line-height:1.4;background:var(--app-bg);color:var(--ink)}
  #ni-input:focus{border-color:var(--green);background:#fff}
  #ni-send{width:46px;height:46px;border-radius:50%;background:var(--green);border:0;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  #ni-send svg{width:18px;height:18px;stroke:#fff;fill:none;stroke-width:2}
  #ni-send:disabled{opacity:.5;cursor:not-allowed}

  @media(max-width:860px){
    #ni-sidebar{width:100%;border-right:0}
    body.ni-open #ni-sidebar{display:none}
    body:not(.ni-open) #ni-thread-pane{display:none}
    #ni-back-btn{display:inline-flex}
    .ni-hpill span{display:none}.ni-hpill{width:44px;height:44px;padding:0;justify-content:center;border-radius:50%}
    #ni-messages{padding:14px 12px}
  }

  /* ── Modals ── */
  .ni-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;align-items:center;justify-content:center;padding:14px;overscroll-behavior:contain}
  .ni-overlay.open{display:flex}
  .ni-modal{background:var(--surface);border-radius:16px;max-width:450px;width:100%;max-height:92vh;max-height:92dvh;overflow-y:auto;padding:24px 22px;box-shadow:0 8px 32px rgba(0,0,0,.2)}
  .ni-modal h3{font-size:19px;font-weight:700;margin:0 0 4px}
  .ni-sub{font-size:13px;color:var(--muted);margin:0 0 16px;line-height:1.5}
  .ni-field{margin-bottom:14px}
  .ni-field label{display:block;font-size:12.5px;font-weight:600;color:var(--ink-2);margin-bottom:5px}
  .ni-field input,.ni-field textarea,.ni-field select{width:100%;min-height:46px;padding:10px 13px;border:1.5px solid var(--border);border-radius:10px;font-size:16px;background:var(--app-bg);color:var(--ink);outline:none}
  .ni-field textarea{min-height:66px;resize:vertical}
  .ni-field input:focus,.ni-field textarea:focus,.ni-field select:focus{border-color:var(--green);background:#fff}
  .ni-field [aria-invalid="true"]{border-color:var(--alert)}
  .ni-err{color:var(--alert);font-size:12.5px;margin-top:4px}.ni-err:empty{display:none}
  .ni-banner{background:#FFF5F5;color:var(--alert);border:1px solid #f0caca;border-radius:10px;padding:9px 12px;font-size:13px;margin-bottom:12px}.ni-banner:empty{display:none}
  .ni-two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  @media(max-width:420px){.ni-two{grid-template-columns:1fr;gap:0}}
  .ni-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:8px;flex-wrap:wrap}
  .ni-toggle{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 0;border-top:1px solid var(--border);margin-top:6px;min-height:52px;font-size:14px;color:var(--ink-2)}
  .ni-toggle input{width:20px;height:20px;accent-color:var(--green)}
  .ni-status{font-size:12.5px;color:var(--muted);margin-top:10px;min-height:1em}
  .ni-linkrow{display:flex;gap:8px;margin-bottom:12px}
  #ni-sync-link{flex:1;min-width:0;padding:10px 12px;border:1.5px solid var(--border);border-radius:10px;font-size:13px;color:var(--ink-2);background:var(--app-bg)}
  .ni-warn{font-size:13px;color:var(--amber);background:var(--amber-bg);border:1px solid var(--amber-border);border-radius:10px;padding:10px 12px;margin-bottom:14px;line-height:1.5}
</style>
<link rel="stylesheet" href="/theme.css"/>
<script src="/theme.js"></script>
<link rel="manifest" href="/manifest.webmanifest"><script>if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js')})}</script>
</head>
<body>
<div id="ni-app">
  <header id="ni-header">
    <a id="ni-back" href="/listings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg><span>Browse listings</span></a>
    <div id="ni-title-wrap"><div id="ni-title">Nyumba254</div><div id="ni-subtitle">Your conversations with sellers</div></div>
    <button id="ni-profile-btn" class="ni-hbtn" type="button" aria-label="My details and notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0116 0v1"/></svg><span>My details</span></button>
    <button id="ni-sync-btn" class="ni-hbtn" type="button" aria-label="Continue on another device"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg><span>Sync device</span></button>
  </header>
  <div id="ni-net" role="status">You're offline. Messages you send will go out as soon as you're back online.</div>

  <div id="ni-body">
    <aside id="ni-sidebar" aria-label="Conversations">
      <div id="ni-tabs" role="tablist">
        <button type="button" class="ni-tab" role="tab" id="ni-tab-chats" data-tab="chats" aria-selected="true">Chats <span id="ni-unread-count" class="ni-count" hidden>0</span></button>
        <button type="button" class="ni-tab" role="tab" id="ni-tab-saved" data-tab="saved" aria-selected="false">Saved <span id="ni-saved-count" class="ni-count" hidden>0</span></button>
      </div>
      <div id="ni-search-row"><label class="sr-only" for="ni-search">Search conversations</label><input id="ni-search" type="search" placeholder="Search conversations…" autocomplete="off"/></div>
      <div id="ni-list" role="tabpanel" aria-labelledby="ni-tab-chats"></div>
      <div id="ni-saved" role="tabpanel" aria-labelledby="ni-tab-saved" hidden></div>
    </aside>

    <main id="ni-thread-pane">
      <div id="ni-thread-empty">Select a conversation from the list to read your messages.</div>
      <div id="ni-thread">
        <div id="ni-thead">
          <button class="ni-ib" id="ni-back-btn" type="button" aria-label="Back to all chats"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
          <div id="ni-tinfo"><div id="ni-tname"></div><div id="ni-presence"><span id="ni-dot"></span><span id="ni-ptxt">Connecting…</span></div></div>
          <button class="ni-ib" id="ni-tsearch-btn" type="button" aria-label="Search in this conversation"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
