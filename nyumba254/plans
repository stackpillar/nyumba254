<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="saved-listings.js"></script>
<script src="nav-badge.js"></script>
<script>
  const SUPABASE_URL = 'https://vliuuloyfhyxcsuchpss.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_oIIcecf3wzKMual5K24Z8Q_zmxVfgsx';
  const { createClient } = supabase;
  const db = createClient(SUPABASE_URL, SUPABASE_KEY);

  /* ══════════════════════════════════════════════════════════════
     All pricing on this page is driven ENTIRELY by platform_settings —
     nothing below is a hardcoded fee. Every number rendered starts as
     a "—" and is filled in once loadLivePrices() resolves.
     ══════════════════════════════════════════════════════════════ */
  const SETTINGS_KEYS_NEEDED = [
    'sale_standard_pct','rent_standard_pct',
    'standard_min_fee','standard_max_fee',
    'standard_fee_per_unit',
    'premium_monthly_price','premium_yearly_price',
    'elite_monthly_price','elite_yearly_price',
    'bnb_basic_price','bnb_bundle_price','bnb_unlimited_price',
  ];
  let SETTINGS = {};

  function fmtKES(n){ return 'KES ' + Number(n||0).toLocaleString('en-KE'); }

  function calcExampleFee(price, pctKey){
    const pct = Number(SETTINGS[pctKey]) || 0;
    const min = Number(SETTINGS.standard_min_fee) || 0;
    const max = Number(SETTINGS.standard_max_fee) || Infinity;
    return Math.round(Math.max(min, Math.min(max, price * (pct/100))));
  }

  function renderFeeTable(){
    const salePct = Number(SETTINGS.sale_standard_pct)||0;
    const rentPct = Number(SETTINGS.rent_standard_pct)||0;
    const perUnit = Number(SETTINGS.standard_fee_per_unit)||0;
    const rows = [
      { name:'House / Land — for sale', sub:'One-time · stays live until sold', example:'3,000,000 property', fee: calcExampleFee(3000000,'sale_standard_pct'), note:`${salePct}% of price` },
      { name:'House / Land — high value', sub:'One-time · stays live until sold', example:'25,000,000 property', fee: calcExampleFee(25000000,'sale_standard_pct'), note:`${salePct}% of price, capped at ${fmtKES(SETTINGS.standard_max_fee)}` },
      { name:'Apartment / House — for rent', sub:'One-time · stays live until occupied', example:'15,000/month rent', fee: calcExampleFee(15000,'rent_standard_pct'), note:`${rentPct}% of monthly rent` },
      { name:'Boarding house / bed spaces', sub:'One-time · stays live until occupied', example:'10 rooms, avg 1,800/mo', fee: calcExampleFee(18000,'rent_standard_pct') + perUnit*10, note:`${rentPct}% of total room value + ${fmtKES(perUnit)}/room` },
      { name:'Shop / office — to lease', sub:'One-time · stays live until occupied', example:'40,000/month lease', fee: calcExampleFee(40000,'rent_standard_pct'), note:`${rentPct}% of monthly lease` },
      { name:'Shop / office — for sale', sub:'One-time · stays live until sold', example:'Same as House/Land — for sale', fee: null, note:'Priced the same way as a house/land sale, by price bracket' },
    ];
    document.getElementById('fee-table-body').innerHTML = rows.map(r => `
      <tr>
        <td><div class="cat-name">${r.name}</div><div class="cat-sub">${r.sub}</div></td>
        <td>${r.note}</td>
        <td>${r.example}</td>
        <td class="fee-amt">${r.fee!=null ? fmtKES(r.fee) : '—'}</td>
      </tr>`).join('');
  }

  function renderBnbPrices(){
    document.getElementById('bnb-basic-price').textContent = fmtKES(SETTINGS.bnb_basic_price);
    document.getElementById('bnb-bundle-price').textContent = fmtKES(SETTINGS.bnb_bundle_price);
    document.getElementById('bnb-unlimited-price').textContent = fmtKES(SETTINGS.bnb_unlimited_price);
  }

  function applySellerPlanPrice(planClass, monthlyKey, yearlyKey){
    const amountEl = document.querySelector(`.plan.${planClass} .amount`);
    const noteEl = document.querySelector(`.plan.${planClass} .plan-price-note`);
    const monthly = Number(SETTINGS[monthlyKey]);
    const yearly = Number(SETTINGS[yearlyKey]);
    if (amountEl && monthly) { amountEl.dataset.monthly = fmtKES(monthly); amountEl.textContent = fmtKES(monthly); }
    if (amountEl && yearly)  amountEl.dataset.yearly = fmtKES(Math.round(yearly/12));
    if (noteEl && yearly)    noteEl.dataset.yearlyNote = `${fmtKES(yearly)} billed yearly`;
  }

  async function loadLivePrices(){
    const { data, error } = await db.from('platform_settings').select('key,value').in('key', SETTINGS_KEYS_NEEDED);
    if (error) { console.error('Could not load pricing settings:', error); return; }
    (data||[]).forEach(r => { SETTINGS[r.key] = Number(r.value); });
    renderFeeTable();
    renderBnbPrices();
    applySellerPlanPrice('premium','premium_monthly_price','premium_yearly_price');
    applySellerPlanPrice('elite','elite_monthly_price','elite_yearly_price');
  }
  loadLivePrices();
  if (typeof NKSaved !== 'undefined') NKSaved.init();

  function toggleMobileMenu() {
    const nav = document.getElementById('mobile-nav');
    const isOpen = nav.classList.toggle('open');
    document.getElementById('mobile-menu-btn')?.setAttribute('aria-expanded', isOpen);
  }
  document.addEventListener('click', e => {
    const nav = document.getElementById('mobile-nav');
    const btn = document.querySelector('.mobile-menu-btn');
    if (nav && nav.classList.contains('open') && !nav.contains(e.target) && !btn.contains(e.target)) nav.classList.remove('open');
  });

  db.auth.getSession().then(({ data: { session } }) => {
    if (!session) return;
    const d = document.getElementById('nav-account-link');
    const m = document.getElementById('mobile-account-link');
    if (d) { d.textContent = 'My Account'; d.href = '/dashboard'; d.style.fontWeight = '600'; d.style.color = 'var(--green)'; }
    if (m) { m.textContent = 'My Account'; m.href = '/dashboard'; }
  });

  let currentUser = null;
  let checkoutPlan = null, checkoutTier = null, checkoutAmount = 0;
  let subToastTimer = null;

  db.auth.getSession().then(({ data: { session } }) => { currentUser = session?.user || null; });
  db.auth.onAuthStateChange((_e, session) => { currentUser = session?.user || null; });

  function isValidMpesaCode(code) {
    return /^[A-Z0-9]{10}$/.test(String(code || '').trim().toUpperCase());
  }
  function validateSubPayRef() {
    const el = document.getElementById('sub-pay-ref');
    const err = document.getElementById('sub-pay-ref-error');
    const hint = document.getElementById('sub-pay-ref-hint');
    const val = el.value.trim();
    const bad = val.length > 0 && !isValidMpesaCode(val);
    err.style.display = bad ? 'block' : 'none';
    hint.style.display = bad ? 'none' : 'block';
    el.style.borderColor = bad ? '#C53030' : (val.length === 10 ? 'var(--green)' : 'var(--border)');
    return !bad && val.length === 10;
  }
  function subToast(msg){
    const t = document.getElementById('cs-toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(subToastTimer);
    subToastTimer = setTimeout(() => t.classList.remove('show'), 3200);
  }

  /* plan is one of: 'premium' | 'elite' | 'bnb_basic' | 'bnb_bundle' | 'bnb_unlimited' */
  const PLAN_LABELS = {
    premium: 'Premium', elite: 'Elite',
    bnb_basic: 'BNB Basic', bnb_bundle: 'BNB Bundle', bnb_unlimited: 'BNB Unlimited',
  };
  const BNB_PLANS = new Set(['bnb_basic','bnb_bundle','bnb_unlimited']);

  async function startSubscriptionCheckout(plan) {
    const { data: { session } } = await db.auth.getSession();
    if (!session) { window.location.href = '/login?next=pricing'; return; }
    currentUser = session.user;
    checkoutPlan = plan;

    if (BNB_PLANS.has(plan)) {
      // BNB plans are flat monthly fees — no yearly toggle, no percentage math.
      checkoutTier = 'monthly';
      checkoutAmount = SETTINGS[`${plan}_price`] || 0;
    } else {
      checkoutTier = yearly ? 'yearly' : 'monthly';
      checkoutAmount = SETTINGS[`${plan}_${checkoutTier}_price`] || 0;
    }

    document.getElementById('sub-pay-title').textContent = `Pay for ${PLAN_LABELS[plan]}${BNB_PLANS.has(plan)?'':` (${checkoutTier})`}`;
    document.getElementById('sub-pay-amount-display').textContent = fmtKES(checkoutAmount);
    document.getElementById('sub-pay-amount-label').textContent = fmtKES(checkoutAmount);
    document.getElementById('sub-pay-ref').value = '';
    document.getElementById('sub-payment-modal').style.display = 'flex';
  }
  function closeSubPaymentModal() { document.getElementById('sub-payment-modal').style.display = 'none'; }

  async function confirmSubManualPayment() {
    const code = document.getElementById('sub-pay-ref').value.trim().toUpperCase();
    if (!code) { subToast('Please enter your M-Pesa code'); return; }
    if (!isValidMpesaCode(code)) {
      validateSubPayRef();
      subToast('Please enter a valid 10-character M-Pesa code');
      document.getElementById('sub-pay-ref').focus();
      return;
    }
    const btn = document.getElementById('sub-pay-verify-btn');
    btn.disabled = true; btn.textContent = 'Submitting…';

    // payment 'type' tells admin.confirmPayment() which profile fields to
    // activate: premium_subscription / elite_subscription toggle
    // subscription_tier+plan; bnb_subscription toggles bnb_plan+bnb_expires_at.
    const paymentType = BNB_PLANS.has(checkoutPlan) ? 'bnb_subscription' : `${checkoutPlan}_subscription`;

    const { error } = await db.from('payments').insert({
      seller_id: currentUser.id,
      amount: checkoutAmount,
      method: 'paybill',
      reference: code,
      type: paymentType,
      plan_key: checkoutPlan,           // 'bnb_basic' | 'bnb_bundle' | 'bnb_unlimited' | 'premium' | 'elite'
      status: 'pending_verification',
    });
    btn.disabled = false; btn.textContent = '✓ Submit for verification';
    if (error) { subToast('Could not submit — please try again'); console.error(error); return; }
    const { data: profileRow } = await db.from('profiles').select('full_name').eq('id', currentUser.id).single();
    fetch(`${SUPABASE_URL}/functions/v1/send-notification-email`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` },
      body: JSON.stringify({ type: 'premium_payment_submitted', audience: 'admin', plan: checkoutPlan, tier: checkoutTier, amount: checkoutAmount, reference: code, sellerName: profileRow?.full_name, sellerEmail: currentUser.email }),
    }).catch(()=>{});
    closeSubPaymentModal();
    subToast('Payment submitted — we\'ll activate your plan shortly ✓');
  }

  let yearly = false;
  function toggleBilling(){
    yearly = !yearly;
    const sw = document.getElementById('billing-switch');
    const grid = document.getElementById('plans-grid');
    sw.classList.toggle('yearly', yearly);
    sw.setAttribute('aria-pressed', String(yearly));
    document.getElementById('label-monthly').classList.toggle('active', !yearly);
    document.getElementById('label-yearly').classList.toggle('active', yearly);
    document.querySelectorAll('#plans-grid .plan-price .amount').forEach(el => { el.textContent = yearly ? el.dataset.yearly : el.dataset.monthly; });
    document.querySelectorAll('#plans-grid .plan-price .period').forEach(el => { el.textContent = yearly ? '/ month, billed yearly' : '/ month'; });
    document.querySelectorAll('#plans-grid .plan-price-note').forEach(el => { const val = yearly ? el.dataset.yearlyNote : el.dataset.monthlyNote; if (val) el.textContent = val; });
  }
</script>

