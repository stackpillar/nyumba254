  <style>
    body{font-family:'Inter',system-ui,sans-serif;background:var(--surface,#f7f6f2);color:var(--text,#1a1a18);line-height:1.7;margin:0}
    main{max-width:720px;margin:0 auto;padding:32px 20px 64px}
    h1{font-family:'Playfair Display',serif;font-size:28px;margin:0 0 12px}
    h2{font-size:18px;margin:28px 0 8px}
    .card{background:var(--white,#fff);border:1px solid var(--border,#e0ded8);border-radius:16px;padding:18px 20px;margin:14px 0}
