  const msgId = (crypto.randomUUID ? crypto.randomUUID() : Date.now()+'-'+Math.random().toString(36).slice(2));
  const { error: msgErr } = await db.from('messages').insert({ id: msgId, listing_id: listingId, buyer_token: token, buyer_name: name, buyer_phone: phone, buyer_id: currentBuyerId, sender: 'buyer', content: message });
  const insertedMsg = msgErr ? null : { id: msgId, listing_id: listingId, buyer_token: token, buyer_name: name, buyer_phone: phone, sender: 'buyer', content: message, created_at: new Date().toISOString() };

  btn.disabled = false; btn.classList.remove('loading');
  if (msgErr) { if (insertedEnq?.id) await db.from('enquiries').delete().eq('id', insertedEnq.id); alert('Something went wrong: ' + (msgErr.message || 'unknown error') + ' — please try calling the seller directly.'); return; }

  setBuyerToken(token);
