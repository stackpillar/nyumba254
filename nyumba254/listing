<script>
(function(){'use strict';
const $=id=>document.getElementById(id),qsa=(s,r)=>[...(r||document).querySelectorAll(s)];
const FREQ={...NK_FREQ_LABEL,semester:'/semester'};
const money=n=>'KES '+Number(n||0).toLocaleString('en-KE');
const pad=n=>String(n).padStart(6,'0');
const lsg=k=>{try{return localStorage.getItem(k)}catch(e){return null}},lss=(k,v)=>{try{localStorage.setItem(k,v)}catch(e){}};
const uuid=()=>crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random().toString(36).slice(2);
const SEC={gated_guard_cctv:'Gated, guarded & CCTV',gated_guard:'Gated with guard',gated_cctv:'Gated with CCTV',gated:'Gated compound',cctv:'CCTV only',none:'None'};
const PARK={private:'Private',shared:'Shared compound',street:'Street only',none:'None'};
const FURN={yes:'Furnished',partial:'Partly furnished',no:'Unfurnished'};
const IC={chev:d=>`<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="${d?'15 18 9 12 15 6':'9 18 15 12 9 6'}"/></svg>`,
 call:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.12 1.2 2 2 0 012.11 0h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 14.92z"/></svg>',
 msg:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>',
 wa:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>',
 share:'<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/><line x1="15.4" y1="6.5" x2="8.6" y2="10.5"/></svg>',
 flag:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>',
 photo:'<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>'};

let L=null,photos=[],idx=0,units=[],uid=null,isOwner=false,phoneRaw=null,revealBusy=false,stars=0,sellerRatingCount=0;
const ctx=(()=>{try{return JSON.parse(sessionStorage.getItem('nk_results_ctx')||'null')}catch(e){return null}})();
let toastT;function toast(m,k){const t=$('toast');t.textContent=m;t.className='toast show'+(k==='error'?' error':'');clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),4200)}
const meta=()=>NK_CATEGORIES[L.category]||{label:nkTitleCase(L.category),group:'standard'};
const freq=()=>L.price_frequency||({boarding:'month',airbnb:'night'}[L.category]||'once');
const where=()=>[L.area,L.county?nkCountyLabel(L.county):''].filter(Boolean).join(', ')||'Kenya';
const ago=iso=>{const d=(Date.now()-new Date(iso))/864e5;return d<1?'today':d<30?Math.floor(d)+'d ago':Math.floor(d/30)+' mo ago'};
const setMeta=(id,v)=>{const e=$(id);if(e)e.setAttribute(id.startsWith('m-canon')?'href':'content',v)};

/* ── load ── */
async function load(){
  const n=new URLSearchParams(location.search).get('id');
  if(!n||!/^\d+$/.test(n))return unavailable('missing');
  try{
    const {data,error}=await db.from('listings').select('*, profiles(full_name, created_at, verification_status), listing_photos(*), listing_units(*), listing_videos(*)').eq('listing_number',parseInt(n,10)).single();
    if(error)return error.code==='PGRST116'?unavailable('missing'):unavailable('error');
    L=data;
    const {data:s}=await nkSessionPromise;uid=(s.session&&s.session.user&&s.session.user.id)||null;
    isOwner=!!uid&&L.seller_id===uid;
    const live=(L.status==='active'||L.status==='occupied')&&!L.is_disabled&&!L.recycle_bin;
    if(!live){
      let admin=false;
      if(uid&&!isOwner){const {data:p}=await db.from('profiles').select('role').eq('id',uid).maybeSingle();admin=p&&p.role==='admin'}
      return (isOwner||admin)?unavailable('private'):unavailable('missing');
    }
    photos=(L.listing_photos||[]).slice().sort((a,b)=>(a.position||0)-(b.position||0));
    const c=photos.find(p=>p.is_cover);idx=c?Math.max(0,photos.indexOf(c)):0;
    units=(L.listing_units||[]).slice().sort((a,b)=>(a.id||0)-(b.id||0));
    render();seo();
    nkTrackRecentViewed(L.id);countView();loadSimilar();loadRating();checkThread();
  }catch(e){console.error(e);unavailable('error')}
}
async function countView(){
  if(isOwner)return;const k='nk_viewed_'+L.id;if(lsg(k))return;lss(k,'1');
  const {data,error}=await db.rpc('increment_listing_views',{listing_id:L.id});
  const el=$('m-views');if(!error&&data!=null&&el)el.textContent=Number(data).toLocaleString('en-KE')+' views';
}

/* ── states ── */
function unavailable(kind){
  document.title='Listing unavailable — Nyumba254';$('m-robots').setAttribute('content','noindex,follow');
  const msg={missing:['This listing is no longer available','It may have been rented, sold or removed, or the link is incorrect.'],error:["We couldn't load this listing",'Check your connection and try again.'],
    private:['This listing is hidden from the public',(L&&L.disabled_reason)?'Reason from admin: '+L.disabled_reason:'Only you and the admin team can see this notice. Status: '+(L?L.status:'')+'.']}[kind];
  $('view').innerHTML=`<div class="state"><h1>${escHtml(msg[0])}</h1><p>${escHtml(msg[1])}</p>${kind==='error'?'<button class="btn btn-primary" data-act="reload">Try again</button>':'<a class="btn btn-primary" href="/listings">Browse listings</a>'}${kind==='private'?'<a class="btn btn-outline" href="/dashboard">Open dashboard</a><a class="btn btn-outline" href="/contact">Contact admin</a>':''}</div>`;
  tabActions();
}

/* ── facts (shown once: first 3 in the strip, the rest in the details card) ── */
function facts(){
  const d=L.details||{},g=meta().group,f=[],add=(k,v)=>{if(v!==undefined&&v!==null&&v!=='')f.push([k,String(v)])};
  const bed=v=>v==null||v===''?null:(Number(v)===0?'Studio':v);
  if(g==='standard'){
    let b=bed(d.bedrooms);
    if(units.length){const bs=[...new Set(units.map(u=>u.bedrooms).filter(x=>x!=null))].sort((a,c)=>a-c),fm=x=>x==0?'Studio':x+'BR';
      if(bs.length>1)b=fm(bs[0])+'–'+fm(bs[bs.length-1]);else if(bs.length===1)b=bed(bs[0])}
    add('Bedrooms',b);add('Bathrooms',d.bathrooms);add('Floor area',d.size_sqm&&d.size_sqm+' m²');add('Furnishing',FURN[d.furnished]);add('Parking',PARK[d.parking]);add('Security',SEC[d.security]);
  }else if(g==='boarding'){
    add('Spaces',units.reduce((s,u)=>s+(u.quantity_total??u.quantity_available??0),0)||d.total_beds);
