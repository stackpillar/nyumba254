<link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<script type="application/ld+json" id="ld-listing"></script>
<script type="application/ld+json" id="ld-crumbs"></script>
<link rel="stylesheet" href="/nk-shared.css"/>
<style>
/* ═══ listing.html: page-specific layout only. Tokens, nav, cards, forms, modals live in /nk-shared.css ═══ */
.wrap{max-width:1200px;margin:0 auto;padding:16px clamp(16px,4vw,32px) 56px;padding-left:max(clamp(16px,4vw,32px),env(safe-area-inset-left));padding-right:max(clamp(16px,4vw,32px),env(safe-area-inset-right))}
.md-only{display:none}
@media(max-width:900px){.md-only{display:revert}.inline-cta.md-only{display:grid}}

/* top bar */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;min-height:44px}
.crumbs{display:flex;flex:1;min-width:0;flex-wrap:wrap;align-items:center;gap:2px 6px;font-size:13px;color:var(--text-3)}
.crumbs a:hover{color:var(--green);text-decoration:underline}
.crumbs .cur{color:var(--text-2);font-weight:600;max-width:40ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.backlink{display:none;align-items:center;gap:6px;min-height:44px;font-size:14px;font-weight:600;color:var(--green-dark);margin-left:-6px;padding:0 8px;border-radius:var(--radius)}
.backlink:hover{background:var(--green-light)}
.backlink svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.4}
.tb-actions{display:flex;gap:8px;flex-shrink:0}
.chip{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0 16px;border-radius:22px;border:1.5px solid var(--border);background:var(--white);font-size:13.5px;font-weight:600;color:var(--text-2);white-space:nowrap}
.chip:hover{border-color:var(--green);color:var(--green-dark)}
.chip svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2}
@media(max-width:768px){.crumbs{display:none}.backlink{display:inline-flex;flex:1;min-width:0}.backlink span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}}
.tbnav{display:inline-flex;gap:8px}
.chip.off{opacity:.42;pointer-events:none}
@media(max-width:600px){.chip.navchip{padding:0;width:44px;justify-content:center}.chip.navchip .lbl{display:none}.chip.iconchip span{display:none}}

/* banners */
.reach{display:flex;align-items:center;gap:8px 12px;flex-wrap:wrap;background:var(--green-light);border:1px solid var(--green-mid);border-radius:var(--radius);padding:10px 14px;margin-bottom:14px;font-size:14px;color:var(--green-dark)}
.reach span{flex:1 1 200px;font-weight:600}
.reach .btn{min-height:40px;padding:0 16px}
.notice{border:1px solid var(--border);background:var(--white);border-radius:var(--radius);padding:11px 14px;font-size:13.5px;color:var(--text-2);margin-bottom:16px;line-height:1.55}
.notice.warn{background:var(--amber-bg);border-color:var(--amber-border);color:var(--amber)}

/* layout */
.layout{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:32px;align-items:start}
.main-col{min-width:0}
.side{position:sticky;top:calc(var(--nav-h) + 16px);max-height:calc(100dvh - var(--nav-h) - 32px);overflow-y:auto;overscroll-behavior:contain;border-radius:var(--radius-lg)}
@media(max-width:1000px){.layout{grid-template-columns:minmax(0,1fr) 340px;gap:24px}}
@media(max-width:900px){.layout{grid-template-columns:minmax(0,1fr)}.side{position:static;max-height:none;overflow:visible}}

/* gallery: every photo FILLS its tile (cover), it is only a preview. Tapping any photo opens the full, uncropped viewer.
   Desktop: one large photo + up to four tiles. Phones: a swipeable carousel (native scroll-snap). */
.gallery{position:relative;margin-bottom:22px}
.gmosaic{display:grid;gap:6px;height:clamp(300px,40vw,480px);border-radius:var(--radius-lg);overflow:hidden;background:var(--border);border:1px solid var(--border);box-shadow:var(--shadow-card)}
.gmosaic.n1{grid-template-columns:minmax(0,1fr)}
.gmosaic.n2{grid-template-columns:repeat(2,minmax(0,1fr))}
.gmosaic.n3{grid-template-columns:minmax(0,2fr) minmax(0,1fr);grid-template-rows:repeat(2,minmax(0,1fr))}
.gmosaic.n4{grid-template-columns:minmax(0,2fr) minmax(0,1fr);grid-template-rows:repeat(3,minmax(0,1fr))}
.gmosaic.n5{grid-template-columns:minmax(0,2fr) repeat(2,minmax(0,1fr));grid-template-rows:repeat(2,minmax(0,1fr))}
.gmosaic.n3>:first-child{grid-row:1/3}.gmosaic.n4>:first-child{grid-row:1/4}.gmosaic.n5>:first-child{grid-row:1/3}
.gm-main{position:relative;min-width:0;min-height:0;overflow:hidden;background:var(--surface)}
.gm-main .gt{position:absolute;inset:0;width:100%;height:100%}
.gm-main .gcount{left:12px;right:auto}
.gt{position:relative;display:block;padding:0;min-width:0;min-height:0;overflow:hidden;background:var(--surface);cursor:zoom-in}
.gt img{width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .35s ease;animation:gfade .28s ease}
@keyframes gfade{from{opacity:.35}to{opacity:1}}
.gt:hover img{transform:scale(1.03)}
/* quiet arrows: light, round, sit on the photo edges; fully solid on hover or keyboard focus */
.gnav{position:absolute;top:50%;transform:translateY(-50%);z-index:4;width:40px;height:40px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.9);color:var(--text);box-shadow:0 2px 10px rgba(0,0,0,.22);opacity:.72;transition:opacity .18s,background .15s,transform .15s}
.gnav.prev{left:12px}.gnav.next{right:12px}
.gnav svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.6}
.gallery:hover .gnav,.gnav:hover,.gnav:focus-visible{opacity:1}
.gnav:hover{background:#fff;transform:translateY(-50%) scale(1.06)}
.gnav:active{transform:translateY(-50%) scale(.96)}
@media(hover:none),(max-width:768px){.gnav{opacity:.9;width:38px;height:38px}.gnav.prev{left:8px}.gnav.next{right:8px}}
.gall{position:absolute;right:14px;bottom:14px;z-index:3;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border-radius:22px;background:var(--white);border:1px solid var(--border);box-shadow:0 2px 10px rgba(0,0,0,.2);font-size:13.5px;font-weight:700;color:var(--text)}
.gall:hover{background:var(--green-light);border-color:var(--green);color:var(--green-dark)}
.gall svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2}
.gheart{position:absolute;top:12px;right:12px;z-index:3}
.gcar{display:none;position:relative;border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow-card);background:var(--surface)}
.gtrack{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;overscroll-behavior-x:contain;aspect-ratio:4/3;max-height:min(64vh,500px)}
.gtrack::-webkit-scrollbar{display:none}
.gslide{flex:0 0 100%;min-width:0;height:100%;padding:0;display:block;scroll-snap-align:center;scroll-snap-stop:always}
.gslide img{width:100%;height:100%;object-fit:cover}
.gcount{position:absolute;right:12px;bottom:12px;z-index:3;display:inline-flex;align-items:center;gap:6px;background:rgba(0,0,0,.62);color:#fff;font-size:12.5px;font-weight:700;padding:5px 11px;border-radius:20px;font-variant-numeric:tabular-nums;pointer-events:none}
.gcount svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}
.gnone{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;height:clamp(240px,32vw,340px);border-radius:var(--radius-lg);border:1px solid var(--border);background:var(--surface);color:var(--text-3);font-size:13.5px}
.gnone svg{width:44px;height:44px;stroke:currentColor;opacity:.5;fill:none;stroke-width:1.5}
@media(max-width:768px){.gmosaic,.gall{display:none}.gcar{display:block}}

/* header block */
.pills{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.pill{display:inline-flex;align-items:center;font-size:12.5px;font-weight:700;padding:5px 12px;border-radius:20px;background:var(--green-light);color:var(--green-dark)}
.pill.st::before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor;margin-right:7px}
.pill.plain{background:var(--white);border:1px solid var(--border);color:var(--text-2);font-weight:600}
.pill.bad{background:var(--danger-bg);color:var(--danger)}
.pill.soon{background:var(--amber-bg);color:var(--amber)}
h1.title{font-family:'Playfair Display',serif;font-size:clamp(25px,5.4vw,34px);line-height:1.2;margin-bottom:8px;overflow-wrap:anywhere;text-wrap:balance;letter-spacing:-.005em}
.loc{display:flex;align-items:flex-start;gap:6px;font-size:14.5px;color:var(--text-2);margin-bottom:14px;overflow-wrap:anywhere}
.loc svg{width:16px;height:16px;flex-shrink:0;margin-top:4px;stroke:var(--green);fill:none;stroke-width:2}
.price{font-family:'Playfair Display',serif;font-size:clamp(28px,6.8vw,38px);font-weight:700;color:var(--green-dark);line-height:1.15;letter-spacing:-.01em;overflow-wrap:anywhere;margin-bottom:6px;font-variant-numeric:lining-nums}
.price small{font-family:'Inter',sans-serif;font-size:14px;font-weight:500;color:var(--text-3)}
.price-req{font-size:.7em}
.cost{font-size:13.5px;color:var(--text-2);margin-bottom:16px}
.price+.strip{margin-top:14px}
.strip{display:grid;grid-template-columns:repeat(var(--n,3),minmax(0,1fr));background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;margin-bottom:16px;box-shadow:0 1px 2px rgba(0,0,0,.03)}
.strip .f{display:flex;flex-direction:column;align-items:center;gap:2px;padding:14px 8px;text-align:center;min-width:0;border-left:1px solid var(--border)}
.strip .f:first-child{border-left:0}
.strip .f svg{width:22px;height:22px;stroke:var(--green);fill:none;stroke-width:1.7;margin-bottom:5px}
.strip b{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:clamp(13.5px,3.6vw,16px);line-height:1.3;overflow-wrap:anywhere;font-variant-numeric:lining-nums}
.strip span{display:block;font-size:12px;color:var(--text-3)}
.meta{display:flex;align-items:center;gap:8px 18px;flex-wrap:wrap;font-size:13px;color:var(--text-3);padding-bottom:16px;margin-bottom:16px;border-bottom:1px solid var(--border)}
.mchip{display:inline-flex;align-items:center;gap:6px}
.mchip svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2}
.tchip{display:inline-flex;align-items:center;gap:5px;font-weight:700;color:var(--green-dark);background:var(--green-light);padding:3px 10px;border-radius:20px}
.tchip svg,.vbadge svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2.6}

/* inline action row (phones: the fixed bar takes over once this scrolls out of view) */
.inline-cta{grid-template-columns:1.4fr 1fr 1fr;gap:8px;margin-bottom:18px}
.inline-cta .vbtn{grid-column:1/-1;min-height:44px;font-size:13.5px}
.inline-cta.two{grid-template-columns:1fr}
.inline-cta .btn{padding:0 8px;min-height:48px}
@media(max-width:400px){.inline-cta .btn{font-size:13.5px}.inline-cta .btn svg{display:none}}

/* section navigation (desktop) */
.anchors{position:sticky;top:var(--nav-h);z-index:20;display:flex;gap:4px;overflow-x:auto;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:4px;margin-bottom:16px;scrollbar-width:none}
.anchors::-webkit-scrollbar{display:none}
.anchors a{flex:0 0 auto;font-size:13.5px;font-weight:600;color:var(--text-2);padding:0 14px;min-height:40px;display:inline-flex;align-items:center;border-radius:8px}
.anchors a:hover{background:var(--surface)}
.anchors a.on{background:var(--green-light);color:var(--green-dark)}
@media(max-width:900px){.anchors{display:none}}

/* sections */
.sec{background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);padding:22px;margin-bottom:16px;min-width:0;box-shadow:0 1px 2px rgba(0,0,0,.03);scroll-margin-top:calc(var(--nav-h) + 68px)}
.sec h2{display:flex;align-items:center;gap:10px;font-size:17px;font-weight:700;margin-bottom:16px}
.hic{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:9px;background:var(--green-light);flex-shrink:0}
.hic svg{width:17px;height:17px;stroke:var(--green-dark);fill:none;stroke-width:2}
@media(max-width:480px){.sec{padding:18px 16px}}
.dgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(170px,100%),1fr));gap:10px}
.dgrid>div{min-width:0;background:var(--surface);border-radius:10px;padding:11px 14px}
.dgrid dt{font-size:12.5px;color:var(--text-3)}
.dgrid dd{font-size:14.5px;font-weight:600;overflow-wrap:anywhere}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.achip{display:inline-flex;align-items:center;gap:7px;padding:8px 13px 8px 10px;border-radius:var(--radius);background:var(--surface);border:1px solid var(--border);font-size:13.5px;font-weight:600;color:var(--text-2);max-width:100%;overflow-wrap:anywhere}
.achip svg{width:15px;height:15px;stroke:var(--green);fill:none;stroke-width:2.6;flex-shrink:0}
.desc{font-size:15px;color:var(--text-2);line-height:1.75;white-space:pre-line;overflow-wrap:anywhere;max-width:72ch}
.desc.clamp{display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden}
.rules{margin:0 0 0 18px;font-size:14px;color:var(--text-2);line-height:1.7}
.rules li{overflow-wrap:anywhere}
.safety ul{margin:0 0 6px 18px;font-size:14px;color:var(--text-2);line-height:1.7}

/* unit rows */
.urow{display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--border);flex-wrap:wrap}
.urow:first-of-type{padding-top:0}.urow:last-of-type{border:0;padding-bottom:0}
.urow .m{flex:1;min-width:150px}
.urow .m b{font-size:14.5px;display:block;overflow-wrap:anywhere}
.urow .m span{font-size:12.5px;color:var(--text-3)}
.urow .a{font-size:12.5px;text-align:right;color:var(--text-3)}
.urow .a b{display:block;color:var(--green-dark);font-size:13px}
.urow .a.none b{color:var(--danger)}
.urow .p{font-weight:700;color:var(--green-dark);text-align:right;min-width:110px}
.urow .p small{display:block;font-weight:500;color:var(--text-3);font-size:12.5px}
.urow .btn{min-height:44px;padding:0 14px}
.occ{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:16px;padding-top:16px;border-top:1px solid var(--border)}
.donut{width:88px;height:88px;border-radius:50%;position:relative;flex-shrink:0}
.donut::after{content:attr(data-pct);position:absolute;inset:11px;background:var(--white);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;color:var(--text)}
@media(max-width:480px){.urow{flex-direction:column;align-items:stretch;gap:8px}.urow .m{min-width:0}.urow .a,.urow .p{text-align:left}.urow .btn{width:100%}}

/* map + video */
.mapbox{position:relative;height:280px;border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);background:var(--surface);display:flex;align-items:center;justify-content:center;text-align:center;font-size:13.5px;color:var(--text-3);padding:12px}
.mapbox #map{position:absolute;inset:0}
.maprow{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:4px 12px;margin-top:8px;font-size:14px}
.maprow .addr{color:var(--text-2);font-weight:600;overflow-wrap:anywhere}
.maprow .link{margin:0}
.maphint{font-size:12.5px;color:var(--text-3);margin-top:6px}
.vid{position:relative;display:block;width:100%;padding-top:56.25%;border-radius:12px;overflow:hidden;background:#111 center/cover;cursor:pointer}
.vid iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.vid .play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.25)}
.vid .play span{width:64px;height:64px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;color:var(--green-dark);font-size:22px}
video.vidfile{width:100%;border-radius:12px;background:#000;max-height:70vh}

/* owner + airbnb */
.owner{border:2px solid var(--green);background:var(--green-light)}
.owner p{font-size:13.5px;color:var(--green-dark)}
.owner .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.bnbcard{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;background:var(--green-light);border:1.5px solid var(--green);border-radius:var(--radius-lg);padding:14px 16px;margin-bottom:16px}
.bnbcard b{display:block;color:var(--green-dark)}
.bnbcard span{font-size:13px;color:var(--text-2)}
.scard .bnbcard{margin:0 0 14px}

/* contact card */
.scard{background:var(--white);border:1px solid var(--border);border-top:3px solid var(--green);border-radius:var(--radius-lg);padding:20px;min-width:0;box-shadow:0 1px 2px rgba(0,0,0,.03),0 8px 24px rgba(15,110,86,.06)}
.s-top{padding-bottom:14px;margin-bottom:14px;border-bottom:1px solid var(--border)}
.s-price{font-family:'Playfair Display',serif;font-size:26px;font-weight:700;color:var(--green-dark);line-height:1.2;overflow-wrap:anywhere}
.s-price small{font-family:'Inter',sans-serif;font-size:13.5px;font-weight:500;color:var(--text-3)}
.s-cost{font-size:13px;color:var(--text-2);margin-top:4px}
.s-h{font-size:16px;margin-bottom:6px}
.s-note{font-size:13.5px;color:var(--text-3);margin-bottom:14px}
.seller{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.seller>div:last-child{min-width:0}
.av{width:46px;height:46px;border-radius:50%;background:var(--green-light);color:var(--green-dark);font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.seller b{display:block;font-size:15px;overflow-wrap:anywhere}
.seller small{display:block;font-size:12.5px;color:var(--text-3);overflow-wrap:anywhere}
.seller small:empty{display:none}
.seller .link{min-height:40px;padding:0;font-size:13px}
.vbadge{display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:700;padding:2px 9px;border-radius:20px;background:var(--green-light);color:var(--green-dark);margin:3px 0}
.vbadge.no{background:var(--surface);color:var(--text-2);border:1px solid var(--border);font-weight:600}
.cbtns{display:grid;grid-template-columns:1.5fr 1fr;gap:10px;margin-bottom:14px}
.or{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--text-3);margin-bottom:14px}
.or::before,.or::after{content:'';flex:1;height:1px;background:var(--border)}
@media(max-width:900px){.cbtns,.or{display:none}}
.phone-panel{background:var(--green-light);border:1px solid var(--green-mid);border-radius:var(--radius);padding:12px 14px;margin-bottom:14px}
.phone-panel .num{font-size:20px;font-weight:700;color:var(--green-dark);letter-spacing:.02em}
.phone-panel .row{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap}
.phone-panel .btn{min-height:40px;padding:0 14px;font-size:13px}
.csum{display:flex;align-items:center;justify-content:space-between;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:4px 6px 4px 12px;font-size:13.5px;margin-bottom:14px}
.csum b{overflow-wrap:anywhere}
.qchips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.qchip{min-height:40px;padding:0 13px;border-radius:20px;border:1.5px solid var(--border);background:var(--white);font-size:13px;font-weight:600;color:var(--text-2)}
.qchip:hover{border-color:var(--green);color:var(--green-dark);background:var(--green-light)}
details.more{margin-bottom:14px}
details.more summary{cursor:pointer;font-size:13.5px;font-weight:600;color:var(--green);min-height:44px;display:flex;align-items:center;list-style:none}
details.more summary::-webkit-details-marker{display:none}
details.more[open] summary{margin-bottom:6px}
.hp{position:absolute;left:-9999px}
.sendrow{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.sendrow .btn{padding:0 10px;font-size:13.5px}
.nf-row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:420px){.nf-row2{grid-template-columns:1fr;gap:0}}
.vlist{margin:10px 0 0 18px;font-size:14px;color:var(--text-2);line-height:1.7}
.notify-modal-body p+p{margin-top:10px}
.notify-modal-body.sent{padding:26px 20px}
.notify-modal-body.sent p{font-size:13.5px;color:var(--text-3);margin-bottom:14px}
.notify-modal-body.sent .btn{width:100%;margin-bottom:8px}
button.tchip,button.vbadge{position:relative;cursor:pointer}
button.tchip{border:0}button.vbadge:not(.no){border:0}
button.tchip::after,button.vbadge::after{content:'';position:absolute;inset:-8px}
button.tchip svg:last-child,button.vbadge svg:last-child{opacity:.7;margin-left:1px}
.netbar{position:sticky;top:var(--nav-h);z-index:90;display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;background:var(--amber-bg);border-bottom:1px solid var(--amber-border);color:var(--amber);font-size:13.5px;font-weight:500;padding:8px 16px;text-align:center}
.netbar.ok{background:var(--green-light);border-color:var(--green-mid);color:var(--green-dark)}
.netbar button{border:1px solid currentColor;border-radius:20px;min-height:36px;padding:0 14px;font-weight:600;font-size:13px}
.netbar.ok button{display:none}
.tip{font-size:12.5px;color:var(--text-2);margin-top:14px;line-height:1.55;background:var(--amber-bg);border:1px solid var(--amber-border);border-radius:var(--radius);padding:10px 12px}
.scard .report{display:block;margin:6px auto 0}
.sent{text-align:center}
.sent-ic{width:48px;height:48px;border-radius:50%;background:var(--green-light);display:flex;align-items:center;justify-content:center;margin:0 auto 10px}
.sent-ic svg{width:22px;height:22px;stroke:var(--green);fill:none;stroke-width:2.5}
.sent h3{font-size:16px;margin-bottom:4px}
.sent p{font-size:13.5px;color:var(--text-3);margin-bottom:14px}
.sent .btn{width:100%;margin-bottom:8px}

/* previous / next listing */
.listnav{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:4px 0 8px}
.lncard{display:flex;align-items:center;gap:12px;min-width:0;background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);padding:14px 16px;min-height:76px;transition:border-color .15s,background .15s}
a.lncard:hover{border-color:var(--green);background:var(--green-light)}
.lncard svg{width:20px;height:20px;stroke:var(--green);fill:none;stroke-width:2.4;flex-shrink:0}
.lncard.n{justify-content:flex-end;text-align:right}
.ln-t{display:flex;flex-direction:column;min-width:0}
.lncard.n .ln-t{align-items:flex-end}
.ln-t small{font-size:12.5px;color:var(--text-3);font-weight:600}
.ln-t b{font-size:14.5px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ln-t em{font-style:normal;font-size:12.5px;color:var(--text-3)}
.lncard.off{opacity:.55;background:var(--surface)}
@media(max-width:600px){.listnav{grid-template-columns:1fr}}

/* similar */
.sim{margin-top:40px}
.sim-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.sim h2{font-family:'Playfair Display',serif;font-size:24px}
.sim-head .link{min-height:40px}
.state{text-align:center;padding:72px 20px}
.state h1{font-size:24px;margin-bottom:8px;font-family:'Playfair Display',serif}
