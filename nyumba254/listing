function nkLSGet(key) { try { return localStorage.getItem(key); } catch(e) { return null; } }
function nkLSSet(key, val) { try { localStorage.setItem(key, val); return true; } catch(e) { return false; } }
function nkLSRemove(key) { try { localStorage.removeItem(key); } catch(e) {} }
function getBuyerToken() { return nkLSGet('nk_buyer_' + listingId); }
function setBuyerToken(t) { nkLSSet('nk_buyer_' + listingId, t); nkLSSet('nk_buyer_name_' + listingId, buyerName); nkLSSet('nk_buyer_phone_' + listingId, buyerPhone); }
function getSavedBuyerInfo(){ buyerName = nkLSGet('nk_buyer_name_' + listingId)||''; buyerPhone = nkLSGet('nk_buyer_phone_' + listingId)||''; }

/* ════════════════════════════════════════════════════
   MAIN LOADER
════════════════════════════════════════════════════ */
function showLoadError() {
  document.getElementById('skeleton-wrap').style.display = 'none';
  document.getElementById('load-error').style.display = 'block';
}
async function loadListing() {
  if (!listingNumber || !/^\d+$/.test(listingNumber)) { showNotFound(); return; }
  try {
    const { data, error } = await db.from('listings')
      .select('*, profiles(full_name, created_at, verification_status), listing_photos(*), listing_units(*)')
      .eq('listing_number', parseInt(listingNumber, 10)).single();

    if (error) { if (error.code === 'PGRST116') showNotFound(); else showLoadError(); return; }
    if (!data) { showNotFound(); return; }

    listing = data;
    listingId = data.id;
    listingUnits = (data.listing_units || []).sort((a,b) => (a.id||0) - (b.id||0));

    const isFullyActive = (data.status === 'active') && !data.is_disabled && !data.recycle_bin;
    const { data: { session } } = await nkSessionPromise;
    const viewerUserId = session?.user?.id || null;
    isListingOwner = !!viewerUserId && (data.seller_id === viewerUserId);
    currentBuyerId = isListingOwner ? null : viewerUserId;

    if (isFullyActive) {
      trackView(data);
      renderListing(data);
      renderLiveMap(data);
      loadSimilar(data.area, data.id);
      loadEnquiryCount(data.id);
      handleBuyerThread(data);
      loadSellerReviewStats(data.seller_id);
      nkCheckReviewPrompt(data.id);
      nkUpdateReportButtonState(data.id);
      if (isListingOwner) renderManageUnitsPanel();
      return;
    }

    let isOwner = isListingOwner, isAdmin = false;
    if (viewerUserId && !isOwner) {
      const { data: profile } = await db.from('profiles').select('role').eq('id', viewerUserId).single();
      isAdmin = (profile?.role === 'admin');
    }
    if (isOwner || isAdmin) showSellerDisabledView(data);
    else showNotFound();
  } catch (e) {
    console.error('loadListing failed:', e);
    showLoadError();
  }
}

async function loadEnquiryCount(lId) {
  const { count } = await db.from('enquiries').select('id', { count: 'exact', head: true }).eq('listing_id', lId);
  enquiryCount = count || 0;
  const el = document.getElementById('listing-enq-count');
  if (el) el.textContent = `${enquiryCount} enquir${enquiryCount === 1 ? 'y' : 'ies'}`;
}

/* Views */
async function trackView(data) {
  const viewedKey = 'nk_viewed_' + listingId;
  const alreadyCounted = !!nkLSGet(viewedKey);
  if (!alreadyCounted) {
    nkLSSet(viewedKey, '1');
    const { data: newCount, error } = await db.rpc('increment_listing_views', { listing_id: listingId });
    if (!error && newCount !== null) updateViewsDisplay(newCount);
    else {
      const fallbackCount = (data.views || 0) + 1;
      await db.from('listings').update({ views: fallbackCount }).eq('id', listingId);
      updateViewsDisplay(fallbackCount);
    }
  } else updateViewsDisplay(data.views || 0);
}
function updateViewsDisplay(count) {
  const el = document.getElementById('listing-views');
  if (el) { el.textContent = `${Number(count).toLocaleString('en-KE')} view${count !== 1 ? 's' : ''}`; el.classList.remove('views-loading'); }
}

function showNotFound() {
  document.getElementById('skeleton-wrap').style.display = 'none';
  document.getElementById('not-found').style.display = 'block';
}
function showSellerDisabledView(data) {
  document.getElementById('skeleton-wrap').style.display = 'none';
  const isRecycleBin = !!data.recycle_bin, isPending = data.status === 'pending', isRejected = data.status === 'rejected';
  let heading = 'Your listing has been deactivated';
  let intro = 'This listing is currently hidden from the public site. Only you and the admin team can see this notice — visitors will see a generic "not found" page.';
  if (isRecycleBin) { heading = 'Your listing is in the recycle bin'; intro = 'An admin has moved this listing to the recycle bin. It is hidden from the public and will be permanently deleted after the grace period.'; }
  else if (isPending) { heading = 'Your listing is pending review'; intro = 'Your listing is under review by our admin team. It will be visible to the public once approved — usually within a few hours.'; }
  else if (isRejected) { heading = 'Your listing was rejected'; intro = 'Your listing was rejected by the admin team. Please review the reason below and resubmit via your dashboard.'; }
  document.getElementById('seller-disabled-heading').textContent = heading;
  document.getElementById('seller-disabled-intro').textContent = intro;
  const reason = data.disabled_reason || null;
  if (reason) { document.getElementById('seller-disabled-reason-text').textContent = reason; document.getElementById('seller-disabled-reason-box').style.display = 'block'; }
  if (isRecycleBin && data.purge_at) {
    const daysLeft = Math.max(0, Math.ceil((new Date(data.purge_at) - new Date()) / 86400000));
    document.getElementById('seller-recycle-days').textContent = daysLeft > 0 ? `Permanent deletion in ${daysLeft} day${daysLeft !== 1 ? 's' : ''}` : 'Deletion imminent — contact admin now';
    document.getElementById('seller-recycle-extra').style.display = 'block';
  }
  document.getElementById('seller-disabled-view').style.display = 'block';
}

async function handleBuyerThread(data) {
  buyerToken = getBuyerToken();
  if (currentBuyerId) {
    const { data: existing } = await db.from('messages').select('*').eq('listing_id', listingId).eq('buyer_id', currentBuyerId).order('created_at', { ascending: true }).limit(1);
    if (existing && existing.length) {
      buyerToken = existing[0].buyer_token || buyerToken;
      buyerName = existing[0].buyer_name || ''; buyerPhone = existing[0].buyer_phone || '';
      if (buyerToken) setBuyerToken(buyerToken);
      document.getElementById('enquiry-form').style.display = 'none';
      await showConversationCard();
      if (typeof NKGlobalChat !== 'undefined') NKGlobalChat.refresh();
      return;
    }
  }
  if (buyerToken) {
    getSavedBuyerInfo();
    document.getElementById('enquiry-form').style.display = 'none';
    await showConversationCard();
    if (typeof NKGlobalChat !== 'undefined') NKGlobalChat.refresh();
  } else {
    document.getElementById('enq-message').value = '';
  }
}

