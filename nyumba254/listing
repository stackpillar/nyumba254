/* sticky action bar (phones and tablets). Appears only when the inline action row is off-screen. */
.ctabar{display:none;position:fixed;left:0;right:0;bottom:var(--nk-tabbar-h);z-index:65;background:var(--white);border-top:1px solid var(--border);padding:8px 12px calc(8px + env(safe-area-inset-bottom,0px));gap:8px;align-items:center;box-shadow:0 -4px 16px rgba(0,0,0,.08);transform:translateY(110%);visibility:hidden;transition:transform .2s ease,visibility 0s linear .2s}
.ctabar.show{transform:none;visibility:visible;transition:transform .2s ease}
@media(max-width:900px){.ctabar:not([hidden]){display:flex}body.nk-cta .nk-tabbar{display:none}}
.ctabar-price{flex:1;min-width:0;line-height:1.25}
.ctabar-price strong{display:block;color:var(--green-dark);font-size:15px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ctabar-price strong small{font-size:11.5px;font-weight:500;color:var(--text-3)}
.ctabar-price span{display:block;font-size:12px;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ctabar .btn{min-height:48px;padding:0 14px}
.ctabar .ctabar-icon{flex:0 0 48px;padding:0}
.ctabar .btn:not(.ctabar-icon){flex:1;padding:0 12px}
.ctabar .ctabar-wa{flex:1.4}
.ctabar-price{flex:1.2}
@media(max-width:479px){.ctabar-price{display:none}}

/* lightbox */
.lb{background:rgba(0,0,0,.96);flex-direction:column;padding:0}
.lb-box{flex:1;min-height:0;width:100%;overflow:auto;display:flex;-webkit-overflow-scrolling:touch}
.lb-box img{margin:auto;max-width:100%;max-height:100%;object-fit:contain;cursor:zoom-in}
.lb-box img.zoomed{max-width:none;max-height:none;width:min(200vw,3200px);height:auto;cursor:zoom-out}
.lb-x{position:absolute;top:calc(12px + env(safe-area-inset-top,0px));right:14px;z-index:3;width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.16);color:#fff;font-size:20px}
.lb .garrow{background:rgba(255,255,255,.16);z-index:3}
.lb .garrow svg{stroke:#fff}
.lb-count{color:#fff;font-size:13px;text-align:center;padding:10px 0 calc(10px + env(safe-area-inset-bottom,0px))}
.lb-hint{position:absolute;left:14px;top:calc(22px + env(safe-area-inset-top,0px));color:rgba(255,255,255,.7);font-size:12.5px}

/* modals used on this page */
.stars{display:flex;gap:2px;justify-content:center;margin-bottom:14px}
.stars button{font-size:32px;color:var(--border);line-height:1;min-width:48px;min-height:48px}
.stars button.on{color:var(--green)}
.share{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(96px,100%),1fr));gap:8px}
.share a,.share button{display:flex;flex-direction:column;align-items:center;gap:4px;padding:14px 6px;border-radius:10px;border:1px solid var(--border);font-size:13px;font-weight:600;min-height:64px;justify-content:center}
.share span{font-size:22px}
#ov-contact-sheet .nk-sheet{max-height:92dvh;padding-top:10px}
.sheet-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}
