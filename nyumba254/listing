/* ── Reviews & reports ── */
const NK_REVIEW_PENDING_KEY = 'nk_pending_reviews', NK_PLATFORM_REVIEW_KEY = 'nk_platform_review_done';
const NK_REVIEW_SNOOZE_MS = 3*24*60*60*1000, NK_REVIEW_ELIGIBLE_MS = 2*60*60*1000, NK_REVIEW_MIN_VISITS = 6, NK_REVIEW_TAB_OPEN_MS = 2*60*60*1000;
let nkCurrentPendingEntry = null, nkSellerStarRating = 0, nkPlatformStarRating = 0, nkReportTargetType = 'listing', nkReportTargetId = null, nkReviewRecheckTimer = null;

function nkTrackContact(lId, sellerId, sellerName) {
  if (!lId) return;
  const pending = JSON.parse(nkLSGet(NK_REVIEW_PENDING_KEY) || '[]');
  if (!pending.some(p => p.listingId === lId)) { pending.push({ listingId: lId, sellerId, sellerName, contactedAt: Date.now(), snoozedUntil: 0, done: false, visitCount: 0 }); nkLSSet(NK_REVIEW_PENDING_KEY, JSON.stringify(pending)); }
}
function nkRecordListingVisit(lId) { const pending = JSON.parse(nkLSGet(NK_REVIEW_PENDING_KEY) || '[]'); const e = pending.find(p => p.listingId === lId && !p.done); if (!e) return; e.visitCount = (e.visitCount || 0) + 1; nkSavePending(pending); }
function nkTabOpenElapsedMs(lId) { const key = 'nk_tab_open_' + lId; let start = sessionStorage.getItem(key); if (!start) { start = String(Date.now()); sessionStorage.setItem(key, start); } return Date.now() - Number(start); }
function nkEntryEligible(entry) { const now = Date.now(); if (now <= entry.snoozedUntil) return false; const conversationAge = now - entry.contactedAt; const visits = entry.visitCount || 0; const tabOpenMs = nkTabOpenElapsedMs(entry.listingId); return conversationAge >= NK_REVIEW_ELIGIBLE_MS || visits >= NK_REVIEW_MIN_VISITS || tabOpenMs >= NK_REVIEW_TAB_OPEN_MS; }
function nkCheckReviewPrompt(currentListingId) {
  if (isListingOwner || !currentListingId) return;
  if (!nkLSGet('nk_buyer_' + currentListingId)) return;
  const pending = JSON.parse(nkLSGet(NK_REVIEW_PENDING_KEY) || '[]');
  const entry = pending.find(p => p.listingId === currentListingId && !p.done);
  if (!entry) return;
  nkRecordListingVisit(currentListingId);
  const freshPending = JSON.parse(nkLSGet(NK_REVIEW_PENDING_KEY) || '[]');
  const freshEntry = freshPending.find(p => p.listingId === currentListingId && !p.done);
  if (!freshEntry || !nkEntryEligible(freshEntry)) { nkScheduleReviewRecheck(currentListingId); return; }
  nkCurrentPendingEntry = freshEntry;
  document.getElementById('nk-review-banner').classList.add('show');
}
function nkScheduleReviewRecheck(currentListingId) {
  if (!currentListingId || nkReviewRecheckTimer) return;
  const remaining = NK_REVIEW_TAB_OPEN_MS - nkTabOpenElapsedMs(currentListingId);
  const delay = (remaining > 0 ? Math.min(remaining, 30 * 60 * 1000) : 30 * 60 * 1000) + 1000;
  nkReviewRecheckTimer = setTimeout(() => { nkReviewRecheckTimer = null; nkCheckReviewPrompt(currentListingId); }, delay);
}
function nkSavePending(pending) { nkLSSet(NK_REVIEW_PENDING_KEY, JSON.stringify(pending)); }
function nkDismissBanner() { document.getElementById('nk-review-banner').classList.remove('show'); }
function nkSnoozeCurrentEntry() { if (!nkCurrentPendingEntry) return; const pending = JSON.parse(nkLSGet(NK_REVIEW_PENDING_KEY) || '[]'); const e = pending.find(p => p.listingId === nkCurrentPendingEntry.listingId); if (e) e.snoozedUntil = Date.now() + NK_REVIEW_SNOOZE_MS; nkSavePending(pending); }
function nkBannerYes() {
  document.getElementById('nk-review-banner').classList.remove('show');
  document.getElementById('nk-review-seller-name').textContent = nkCurrentPendingEntry.sellerName || 'the seller';
  nkRenderStars('nk-seller-stars', 'seller');
  const nameInput = document.getElementById('nk-seller-review-name'); nameInput.value = buyerName || ''; nameInput.disabled = false;
  document.getElementById('nk-seller-review-anon').checked = false;
  document.getElementById('nk-seller-review-modal').classList.add('open');
}
function nkBannerNotYet() { nkSnoozeCurrentEntry(); nkDismissBanner(); }
function nkBannerNo() { const pending = JSON.parse(nkLSGet(NK_REVIEW_PENDING_KEY) || '[]'); const e = pending.find(p => p.listingId === nkCurrentPendingEntry.listingId); if (e) e.done = true; nkSavePending(pending); nkDismissBanner(); }
function nkRenderStars(containerId, kind) {
  const el = document.getElementById(containerId);
  el.innerHTML = [1,2,3,4,5].map(n => `<svg class="nk-star" data-n="${n}" viewBox="0 0 24 24" tabindex="0" role="button" aria-label="${n} star${n>1?'s':''}" onclick="nkSetStar('${kind}',${n})" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();nkSetStar('${kind}',${n});}"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`).join('');
}
function nkSetStar(kind, n) { if (kind === 'seller') nkSellerStarRating = n; else nkPlatformStarRating = n; const container = document.getElementById(kind === 'seller' ? 'nk-seller-stars' : 'nk-platform-stars'); [...container.children].forEach((star, i) => star.classList.toggle('filled', i < n)); }
function nkToggleAnon(kind) {
  const nameInput = document.getElementById(`nk-${kind}-review-name`), anonBox = document.getElementById(`nk-${kind}-review-anon`);
  if (anonBox.checked) { nameInput.dataset.savedValue = nameInput.value; nameInput.value = ''; nameInput.disabled = true; }
  else { nameInput.disabled = false; nameInput.value = nameInput.dataset.savedValue || buyerName || ''; }
}
function nkCloseReviewModal(id) {
  document.getElementById(id).classList.remove('open');
  if (id === 'nk-seller-review-modal' && nkCurrentPendingEntry) nkSnoozeCurrentEntry();
  if (id === 'nk-seller-review-modal') nkMaybePromptPlatformReview();
}
let nkSellerReviewSubmitting = false;
async function nkSubmitSellerReview() {
  if (nkSellerReviewSubmitting) return;
  if (!nkSellerStarRating) { alert('Please pick a star rating'); return; }
  nkSellerReviewSubmitting = true;
  const comment = document.getElementById('nk-seller-review-text').value.trim();
  const isAnon = document.getElementById('nk-seller-review-anon').checked;
  const typedName = document.getElementById('nk-seller-review-name').value.trim();
  const reviewerName = isAnon ? null : (typedName || buyerName || null);
  await db.from('reviews').insert({ review_type: 'seller', target_seller_id: nkCurrentPendingEntry.sellerId, listing_id: nkCurrentPendingEntry.listingId, reviewer_role: 'buyer', reviewer_name: reviewerName, is_anonymous: isAnon, rating: nkSellerStarRating, comment: comment || null });
  const pending = JSON.parse(nkLSGet(NK_REVIEW_PENDING_KEY) || '[]');
  const e = pending.find(p => p.listingId === nkCurrentPendingEntry.listingId);
  if (e) e.done = true;
  nkSavePending(pending);
  document.getElementById('nk-seller-review-modal').classList.remove('open');
  document.getElementById('nk-seller-review-text').value = ''; document.getElementById('nk-seller-review-name').value = ''; document.getElementById('nk-seller-review-name').disabled = false; document.getElementById('nk-seller-review-anon').checked = false;
  nkSellerStarRating = 0; nkSellerReviewSubmitting = false;
  loadSellerReviewStats(nkCurrentPendingEntry.sellerId);
  nkMaybePromptPlatformReview();
}
function nkMaybePromptPlatformReview() {
  if (nkLSGet(NK_PLATFORM_REVIEW_KEY)) return;
  nkPlatformStarRating = 0;
  nkRenderStars('nk-platform-stars', 'platform');
  const nameInput = document.getElementById('nk-platform-review-name'); nameInput.value = buyerName || ''; nameInput.disabled = false;
  document.getElementById('nk-platform-review-anon').checked = false;
  setTimeout(() => document.getElementById('nk-platform-review-modal').classList.add('open'), 400);
}
let nkPlatformReviewSubmitting = false;
async function nkSubmitPlatformReview() {
  if (nkPlatformReviewSubmitting) return;
  if (!nkPlatformStarRating) { alert('Please pick a star rating'); return; }
  nkPlatformReviewSubmitting = true;
  const comment = document.getElementById('nk-platform-review-text').value.trim();
  const isAnon = document.getElementById('nk-platform-review-anon').checked;
  const typedName = document.getElementById('nk-platform-review-name').value.trim();
  const reviewerName = isAnon ? null : (typedName || buyerName || null);
  await db.from('reviews').insert({ review_type: 'platform', reviewer_role: 'buyer', reviewer_name: reviewerName, is_anonymous: isAnon, rating: nkPlatformStarRating, comment: comment || null });
  nkLSSet(NK_PLATFORM_REVIEW_KEY, '1'); nkPlatformReviewSubmitting = false;
  document.getElementById('nk-platform-review-modal').classList.remove('open');
  document.getElementById('nk-platform-review-text').value = ''; document.getElementById('nk-platform-review-name').value = ''; document.getElementById('nk-platform-review-name').disabled = false; document.getElementById('nk-platform-review-anon').checked = false;
}
function nkOpenReportModal(targetType, targetId) {
  nkReportTargetType = targetType || 'listing'; nkReportTargetId = targetId || null;
  document.getElementById('nk-report-reason').value = '';
  const amtEl = document.getElementById('nk-report-amount'); if (amtEl) amtEl.value = '';
  nkToggleReportAmountField();
  document.getElementById('nk-report-modal').classList.add('open');
}
function nkToggleReportAmountField() { const reason = document.getElementById('nk-report-reason').value; const wrap = document.getElementById('nk-report-amount-wrap'); if (!wrap) return; wrap.style.display = (reason === 'unreasonable_fee' || reason === 'scam_attempt') ? 'block' : 'none'; }
function nkCloseReportModal() { document.getElementById('nk-report-modal').classList.remove('open'); }
let nkReportSubmitting = false;
async function nkSubmitReport() {
  if (nkReportSubmitting) return;
  const reason = document.getElementById('nk-report-reason').value;
  const amount = document.getElementById('nk-report-amount')?.value.trim();
  let details = document.getElementById('nk-report-details').value.trim();
  if (!reason) { alert('Please select a reason'); return; }
  if (amount) details = `Amount seller asked for: KES ${Number(amount).toLocaleString('en-KE')}\n\n${details}`;
  nkReportSubmitting = true;
  await db.from('reports').insert({ target_type: nkReportTargetType, target_id: nkReportTargetId, reason, details: details || null });
  nkReportSubmitting = false;
  document.getElementById('nk-report-modal').classList.remove('open');
  document.getElementById('nk-report-reason').value = ''; document.getElementById('nk-report-details').value = '';
  const amtReset = document.getElementById('nk-report-amount'); if (amtReset) amtReset.value = '';
  nkToggleReportAmountField();
  if (nkReportTargetType === 'listing' && nkReportTargetId) nkMarkListingReported(nkReportTargetId);
  alert("Thanks — we've received your report. Our team reviews every one, and impostor or scam accounts get suspended immediately once confirmed.");
}
function nkMarkListingReported(lId) {
  const key = 'nk_reported_listings', reported = JSON.parse(nkLSGet(key) || '[]');
  if (!reported.includes(lId)) { reported.push(lId); nkLSSet(key, JSON.stringify(reported)); }
  nkUpdateReportButtonState(lId);
}
function nkUpdateReportButtonState(lId) {
  const reported = JSON.parse(nkLSGet('nk_reported_listings') || '[]');
  ['report-scam-btn','report-scam-btn-top'].forEach(id => {
    const btn = document.getElementById(id);
    if (!btn) return;
    if (reported.includes(lId)) {
      btn.classList.add('reported');
      btn.innerHTML = `<svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Reported`;
      btn.onclick = () => { if (confirm('You already reported this listing. Submit another report anyway?')) nkOpenReportModal('listing', lId); };
    }
  });
}
async function loadSellerReviewStats(sellerId) {
  if (!sellerId) return;
  const { data, error } = await db.from('reviews').select('rating').eq('review_type', 'seller').eq('target_seller_id', sellerId).eq('status', 'published');
  const wrap = document.getElementById('seller-rating');
  if (error || !data || !data.length) { wrap.style.display = 'none'; return; }
  const avg = data.reduce((s,r) => s + r.rating, 0) / data.length;
  const rounded = Math.round(avg * 10) / 10, fullStars = Math.round(avg);
  wrap.innerHTML = `<span style="display:inline-flex;gap:1px;vertical-align:middle">${[1,2,3,4,5].map(n => `<svg viewBox="0 0 24 24" width="13" height="13" style="${n<=fullStars?'fill:var(--green);stroke:var(--green)':'fill:none;stroke:var(--border)'};stroke-width:1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`).join('')}</span><span style="font-size:12px;color:var(--text-2);font-weight:600;margin-left:4px">${rounded}</span><span style="font-size:11px;color:var(--text-3)">(${data.length} review${data.length!==1?'s':''})</span>`;
  wrap.style.display = 'flex'; wrap.style.alignItems = 'center';
}

/* Boot */
document.getElementById('footer-year').textContent = new Date().getFullYear();
nkPopulateFooterCounties();
loadListing();
</script>

