    const unitType = document.getElementById('enq-unit-type')?.value || '';
    if (unitType) extras.push(`Room type: ${unitType}`);
  }
  if (movein) extras.push(`Preferred move-in: ${movein}`);
  if (budget) {
    const budgetLabels = { under_10k:'Under KES 10,000', '10k_25k':'KES 10,000–25,000', '25k_50k':'KES 25,000–50,000', '50k_100k':'KES 50,000–100,000', over_100k:'Over KES 100,000' };
    extras.push(`Budget: ${budgetLabels[budget]||budget}`);
  }
  if (extras.length) message = `${message}\n\n${extras.join('\n')}`;

  const btn = document.getElementById('btn-enquire');
  btn.disabled = true; btn.classList.add('loading');

  const token = (crypto.randomUUID ? crypto.randomUUID() : Date.now()+'-'+Math.random().toString(36).slice(2));
  buyerToken = token; buyerName = name; buyerPhone = phone;

  const enqId = (crypto.randomUUID ? crypto.randomUUID() : Date.now()+'-'+Math.random().toString(36).slice(2));
  const { error: enqErr } = await db.from('enquiries').insert({ id: enqId, listing_id: listingId, buyer_name: name, buyer_phone: phone, buyer_email: email||null, buyer_token: token, buyer_id: currentBuyerId, message });
  const insertedEnq = enqErr ? null : { id: enqId };
