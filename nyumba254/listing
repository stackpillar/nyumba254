  fetch('/favicon.ico',{method:'HEAD',cache:'no-store'}).then(()=>{hideNet();if(loadFailed)load()}).catch(()=>toast('Still offline. We will keep trying.','error'));
}

/* ═══ load ═══ */
async function fetchListing(n){
  const q=cols=>db.from('listings').select(cols+', '+REL).eq('listing_number',n).single();
  let r=await q(CFG.listCols);
  if(r.error&&r.error.code!=='PGRST116')r=await q('*');   // a column name above does not exist: retry once with everything
  return r;
}
async function load(){
  loadFailed=false;preview=false;
  const n=new URLSearchParams(location.search).get('id');
  if(!n||!/^\d+$/.test(n))return unavailable('missing');
  try{
    const [lr,sr]=await Promise.all([fetchListing(parseInt(n,10)),nkSessionPromise]);
    const {data,error}=lr;
    if(error)return error.code==='PGRST116'?unavailable('missing'):unavailable('error');
    P=data;const s=sr&&sr.data;uid=(s&&s.session&&s.session.user&&s.session.user.id)||null;
    isOwner=!!uid&&P.seller_id===uid;
    const live=(P.status==='active'||P.status==='occupied')&&!P.is_disabled&&!P.recycle_bin;
    if(!live){
      let admin=false;
      if(uid&&!isOwner){try{const {data:p}=await db.from('profiles').select('role').eq('id',uid).maybeSingle();admin=!!p&&p.role==='admin'}catch(e){}}
      if(!(isOwner||admin))return unavailable('missing');
      preview=true;                                   // owners and admins now see the real page with a banner
    }
    photos=(P.listing_photos||[]).slice().sort((a,b)=>(a.position||0)-(b.position||0));
    const c=photos.find(p=>p.is_cover);idx=c?Math.max(0,photos.indexOf(c)):0;
    units=(P.listing_units||[]).slice().sort((a,b)=>String(a.id||'').localeCompare(String(b.id||''),undefined,{numeric:true}));
    render();seo();
    if(!preview){nkTrackRecentViewed(P.id);countView()}
    loadSimilar();loadRating();checkThread();maybeReach();loadNeighbours();
  }catch(e){console.error(e);unavailable('error')}
}
async function countView(){
  if(isOwner)return;const k='nk_viewed_'+P.id,t=Number(lsg(k)||0);if(t&&Date.now()-t<CFG.viewTtlMs)return;lss(k,String(Date.now()));
  try{const {data,error}=await db.rpc('increment_listing_views',{listing_id:P.id});const el=$('m-views');if(!error&&data!=null&&el)el.textContent=Number(data).toLocaleString('en-KE')+' views'}catch(e){}
}
function unavailable(kind){
  P=null;document.title='Listing unavailable — Nyumba254';$('m-robots').setAttribute('content','noindex,follow');
  const msg={error:offline()?["You're offline",'Connect to the internet and this listing will load automatically.']:["We couldn't load this listing",'Check your connection and try again.'],missing:['This listing is no longer available','It may have been rented, sold or removed, or the link is incorrect.']}[kind];loadFailed=kind==='error';
  $('view').innerHTML=`<div class="state"><h1>${escHtml(msg[0])}</h1><p>${escHtml(msg[1])}</p>${kind==='error'?'<button type="button" class="btn btn-primary" data-act="reload">Try again</button>':'<a class="btn btn-primary" href="/listings">Browse listings</a><a class="btn btn-outline" href="/">Home</a>'}</div>`;
  tabActions();ctaBar();
}

/* ═══ derived content ═══ */
function unitTotals(){return {total:units.reduce((s,u)=>s+(u.quantity_total??u.quantity_available??0),0),avail:units.reduce((s,u)=>s+(u.quantity_available??0),0)}}
function availState(){
  if(P.status==='occupied')return {k:'bad',t:isSale()?'Sold':'Occupied'};
  const t=unitTotals();if(units.length&&t.total>0&&t.avail<=0)return {k:'bad',t:'Full'};
  const af=(P.details||{}).available_from;
  if(af){const d=new Date(af);if(!isNaN(d)&&d>new Date(Date.now()+864e5))return {k:'soon',t:'Available '+d.toLocaleDateString('en-KE',{day:'numeric',month:'short'})}}
  return {k:'ok',t:'Available now'};
}
function basePrice(){
  if(meta().group==='boarding'&&units.length){
    const prices=list=>list.map(u=>Number(u.price)).filter(x=>x>0),open=prices(units.filter(u=>(u.quantity_available??0)>0)),all=prices(units);
    const p=open.length?open:all;if(p.length)return Math.min(...p)}
  return Number(P.price)||0;
}
function priceHtml(){
  const v=basePrice(),from=meta().group==='boarding'&&units.length&&v>0;
  if(!(v>0))return '<span class="price-req">Price on request</span>';
  return `${from?'<small>From </small>':''}${escHtml(money(v))}${FREQ[freq()]?`<small>${escHtml(FREQ[freq()])}</small>`:''}`;
}
function costLine(){
  const dm=(P.details||{}).deposit_months;if(dm===undefined||dm===null||dm===''||isNaN(Number(dm)))return '';
  const n=Number(dm),b=basePrice();if(isSale())return '';
  if(n===0)return 'No deposit required';
  if(freq()==='month'&&b>0)return `Move-in about ${money(b*(1+n))} (first month + ${n} month${n===1?'':'s'} deposit)`;
  return `Deposit: ${n} month${n===1?'':'s'}`;
}
function facts(){
  const d=P.details||{},g=meta().group,f=[],add=(k,v)=>{if(v!==undefined&&v!==null&&v!=='')f.push([k,String(v)])};
  const bed=v=>v==null||v===''?null:(Number(v)===0?'Studio':v);
  if(g==='standard'){
    let b=bed(d.bedrooms);
    if(units.length){const bs=[...new Set(units.map(u=>u.bedrooms).filter(x=>x!=null))].sort((a,c)=>a-c),fm=x=>x==0?'Studio':x+'BR';
      if(bs.length>1)b=fm(bs[0])+'–'+fm(bs[bs.length-1]);else if(bs.length===1)b=bed(bs[0])}
    add('Bedrooms',b);add('Bathrooms',d.bathrooms);add('Floor area',d.size_sqm&&d.size_sqm+' m²');add('Furnishing',FURN[d.furnished]);add('Parking',PARK[d.parking]);add('Security',SEC[d.security]);
  }else if(g==='boarding'){
    add('Spaces',unitTotals().total||d.total_beds);add('Residents',nkTitleCase(d.gender||'mixed'));add('Nearest institution',d.institution);
  }else if(g==='airbnb'){
    add('Guests',d.guests);add('Bedrooms',d.bedrooms);add('Bathrooms',d.bathrooms);add('Minimum stay',d.min_stay&&d.min_stay+' night'+(d.min_stay==1?'':'s'));add('Check-in / out',d.checkin);
  }else{
    add('Type',nkTitleCase(d.property_type));add('Floor area',d.size_sqm&&d.size_sqm+' m²');add('Terms',d.lease_type==='sale'?'For sale':'Lease');
    add('Parking',PARK[d.parking]);add('Condition',d.condition==='fitted'?'Fitted, ready to use':d.condition==='shell'?'Shell / bare':'');add('Frontage',d.frontage);add('Units',d.units);
  }
  return f;
}
function extraRows(){
  const d=P.details||{},r=[],dm=d.deposit_months;
  if(!isSale()&&dm!==undefined&&dm!==null&&dm!==''&&!isNaN(Number(dm)))r.push(['Deposit',Number(dm)===0?'No deposit':dm+' month'+(Number(dm)===1?'':'s')]);
  if(d.available_from){const a=new Date(d.available_from);if(!isNaN(a))r.push(['Available from',a<=new Date()?'Now':a.toLocaleDateString('en-KE',{day:'numeric',month:'short',year:'numeric'})])}
  if(d.listed_by)r.push(['Listed by',nkTitleCase(d.listed_by)]);
  r.push(['Listing reference',shortRef()]);
  return r;
}
function amenityLabels(){
  const a=Array.isArray(P.amenities)?P.amenities:[],custom=Array.isArray((P.details||{}).custom_amenities)?P.details.custom_amenities:[];
  const out=a.map(k=>(NK_AMENITIES.find(x=>x.key===k)||{}).label||(/^has_/.test(k)?nkTitleCase(k.replace(/^has_/,'')):k));
  return [...new Set([...out,...custom])].filter(Boolean);
}

