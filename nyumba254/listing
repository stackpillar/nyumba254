/* ── Boarding: occupancy donut ── */
function renderOccupancyOverview() {
  const card = document.getElementById('occ-card');
  if (!listingUnits.length) { card.style.display = 'none'; return; }
  const total = listingUnits.reduce((s,u) => s + (u.quantity_total ?? u.quantity_available ?? 0), 0);
  const available = listingUnits.reduce((s,u) => s + (u.quantity_available ?? 0), 0);
  const occupied = Math.max(0, total - available);
  if (!total) { card.style.display = 'none'; return; }
  card.style.display = 'block';
  const pct = Math.round((occupied/total)*100);
  const donut = document.getElementById('occ-donut');
  donut.style.background = `conic-gradient(var(--green-dark) 0deg ${pct*3.6}deg, var(--green-light) ${pct*3.6}deg 360deg)`;
  document.getElementById('occ-pct').textContent = `${pct}%`;
  document.getElementById('occ-legend-title').textContent = `${occupied} of ${total} spaces taken`;
  document.getElementById('occ-occupied-txt').textContent = `${occupied} Occupied`;
  document.getElementById('occ-available-txt').textContent = `${available} Available`;
  document.getElementById('occ-total-txt').textContent = `${total} Total Spaces`;
}

/* ── Seller: Manage rooms panel ── */
function renderManageUnitsPanel() {
  const panel = document.getElementById('manage-units-card');
  if (!listingUnits.length) { panel.style.display = 'none'; return; }
  panel.style.display = 'block';
  renderManageUnitRows();
}
function renderManageUnitRows() {
  document.getElementById('manage-unit-list').innerHTML = listingUnits.map(u => {
    const available = u.quantity_available ?? 0;
    const total = u.quantity_total ?? available;
    return `
      <div class="room-row" id="manage-unit-${u.id}" style="flex-wrap:wrap">
        <div class="room-row-main" style="min-width:100%;margin-bottom:8px">
          <div class="room-row-label">${escHtml(u.unit_label)} — ${available} of ${total} available</div>
        </div>
        <button class="room-row-btn" style="background:var(--green)" ${available<=0?'disabled':''} onclick="confirmMarkOccupied(${u.id})">Mark one occupied</button>
        <button class="room-row-btn" style="background:var(--white);color:var(--text-2);border:1.5px solid var(--border)" ${available>=total?'disabled':''} onclick="markUnitAvailable(${u.id})">Mark one available</button>
      </div>`;
  }).join('');
}
async function confirmMarkOccupied(unitTypeId) {
  const unit = listingUnits.find(u => u.id === unitTypeId);
  if (!unit || (unit.quantity_available ?? 0) <= 0) return;
  const { data: newAvailable, error } = await db.rpc('mark_unit_occupied', { p_unit_id: unitTypeId, p_floor: null, p_door: null, p_position: null });
  if (error || newAvailable === null) { showToastNK('Could not update availability — please try again.'); return; }
  unit.quantity_available = newAvailable;
  renderManageUnitRows(); renderUnitAvailability(); renderOccupancyOverview();
  showToastNK('Marked as occupied — availability updated.');
}
async function markUnitAvailable(unitTypeId) {
  const unit = listingUnits.find(u => u.id === unitTypeId);
  if (!unit) return;
  const total = unit.quantity_total ?? unit.quantity_available;
  if ((unit.quantity_available ?? 0) >= total) return;
  const { data: newAvailable, error } = await db.rpc('mark_unit_available', { p_unit_id: unitTypeId });
  if (error || newAvailable === null) { showToastNK('Could not update availability — please try again.'); return; }
  unit.quantity_available = newAvailable;
  renderManageUnitRows(); renderUnitAvailability(); renderOccupancyOverview();
  showToastNK('Marked as available again.');
}

/* ── Map ── */
function renderLiveMap(l) {
  const parts = [l.area, nkListingCounty(l), 'Kenya'].filter(Boolean);
  const query = parts.join(', ');
  const hasPin = typeof l.latitude === 'number' && typeof l.longitude === 'number';
  const lat = hasPin ? l.latitude : -1.286389;
  const lng = hasPin ? l.longitude : 36.817223;
  const mapsUrl = hasPin ? `https://www.google.com/maps/search/?api=1&query=${lat},${lng}` : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
  document.getElementById('map-open-link').href = mapsUrl;

  leafletMap = L.map('listing-map', { zoomControl: true, scrollWheelZoom: false }).setView([lat, lng], hasPin ? 15 : 12);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap contributors', maxZoom: 19 }).addTo(leafletMap);
  leafletMarker = L.marker([lat, lng]).addTo(leafletMap);

  document.getElementById('map-loading').classList.add('hidden');
  setTimeout(() => leafletMap.invalidateSize(), 200);

  if (!hasPin) {
    fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(query)}`).then(r => r.json()).then(results => {
      if (results && results[0]) {
        const glat = parseFloat(results[0].lat), glng = parseFloat(results[0].lon);
        leafletMap.setView([glat, glng], 14);
        leafletMarker.setLatLng([glat, glng]);
      }
    }).catch(() => {});
  }
}

/* ── Gallery ── */
function renderGallery() {
  const img = document.getElementById('gallery-img'), noPhoto = document.getElementById('gallery-no-photo');
  const thumbWrap = document.getElementById('gallery-thumbs'), counter = document.getElementById('gallery-counter');
  const prevBtn = document.getElementById('prev-btn'), nextBtn = document.getElementById('next-btn');
  if (!photos.length) { noPhoto.style.display='flex'; img.style.display='none'; return; }
  noPhoto.style.display = 'none'; img.style.display = 'block';
  img.onerror = () => { noPhoto.style.display='flex'; img.style.display='none'; };
  img.src = photos[currentPhoto].url;
  img.alt = listing?.title || 'Property photo';
  const mainBox = document.getElementById('gallery-main');
  const applyRatio = () => {
    if (!img.naturalWidth || !img.naturalHeight) return;
    let ratio = img.naturalWidth / img.naturalHeight;
    ratio = Math.max(NK_GALLERY_MIN_RATIO, Math.min(NK_GALLERY_MAX_RATIO, ratio));
    mainBox.style.setProperty('--gallery-ratio', ratio);
  };
