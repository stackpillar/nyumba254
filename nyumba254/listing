function renderListing(l) {
  const meta = NK_CATEGORIES[l.category] || { label: l.category, group: 'standard' };
  const freq = l.price_frequency || (meta.group === 'boarding' ? 'month' : meta.group === 'airbnb' ? 'night' : 'once');
  const d = l.details || {};

  document.title = `${l.title} — Nyumba254`;
  const ogDesc = `${l.title} in ${l.area}, ${nkListingCounty(l)}. KES ${Number(l.price||0).toLocaleString()}${NK_FREQ_LABEL[freq]||''}. Contact seller on Nyumba254.`;
  document.querySelector('meta[name="description"]').setAttribute('content', ogDesc);
  document.getElementById('og-title').setAttribute('content', `${l.title} — Nyumba254`);
  document.getElementById('og-description').setAttribute('content', ogDesc);
  document.getElementById('og-url').setAttribute('content', window.location.href);
  const ogCover = (l.listing_photos||[]).find(p=>p.is_cover) || (l.listing_photos||[])[0];
  const ogImageUrl = ogCover ? ogCover.url : 'https://nyumba254.com/hero-photo.jpg';
  document.getElementById('og-image').setAttribute('content', ogImageUrl);
  document.getElementById('canonical-link').setAttribute('href', window.location.href.split('?')[0] + '?id=' + listingNumber);
  document.getElementById('twitter-title').setAttribute('content', `${l.title} — Nyumba254`);
  document.getElementById('twitter-description').setAttribute('content', ogDesc);
  document.getElementById('twitter-image').setAttribute('content', ogImageUrl);

  photos = (l.listing_photos || []).sort((a,b) => a.position - b.position);
  const cover = photos.find(p=>p.is_cover) || photos[0];
  currentPhoto = cover ? Math.max(0, photos.indexOf(cover)) : 0;
  renderGallery();

  /* Badge row */
  const badges = [`<span class="status-pill"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Available now</span>`];
  if (l.profiles?.verification_status === 'verified') badges.push(`<span class="status-pill verified"><svg viewBox="0 0 24 24"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>Reviewed by Nyumba254</span>`);
  badges.push(`<span class="status-pill plain">${meta.label}</span>`);
  if (meta.group === 'boarding') badges.push(`<span class="status-pill plain">Student friendly</span>`);
  document.getElementById('badge-row').innerHTML = badges.join('');

  document.getElementById('listing-title').textContent = l.title;
  document.getElementById('listing-loc-text').textContent = `${l.area}, ${nkListingCounty(l)}`;
  document.getElementById('listing-price').innerHTML = `KES ${Number(l.price||0).toLocaleString('en-KE')}${NK_FREQ_LABEL[freq] ? `<span>${NK_FREQ_LABEL[freq]}</span>` : ''}`;

  /* Stat strip — 3 boxes, category-driven */
  let stats = [];
  if (meta.group === 'standard') {
    const totalUnits = l.category === 'apartment' && d.units ? d.units : null;
    stats = [
      { val: totalUnits || (d.bedrooms == 0 ? 'Studio' : d.bedrooms || '—'), lbl: totalUnits ? 'Units' : (d.bedrooms == 0 ? 'Bedsitter' : 'Bedrooms') },
      { val: nkTitleCase(d.furnished === 'yes' ? 'Furnished' : d.furnished === 'partial' ? 'Partly furnished' : d.furnished === 'no' ? 'Unfurnished' : '—'), lbl: 'Furnishing' },
      { val: NK_FREQ_META[freq] ? NK_FREQ_META[freq].split(' —')[0] : '—', lbl: 'Terms' },
    ];
  } else if (meta.group === 'boarding') {
    const totalUnits = listingUnits.reduce((s,u) => s + (u.quantity_total ?? u.quantity_available ?? 0), 0) || d.total_beds || 0;
    stats = [
      { val: totalUnits, lbl: 'Spaces' },
      { val: nkTitleCase(d.gender || 'mixed'), lbl: 'Accommodation' },
      { val: d.institution || '—', lbl: 'Nearby' },
    ];
  } else if (meta.group === 'airbnb') {
    stats = [
      { val: d.guests || '—', lbl: 'Guests' },
      { val: d.bedrooms || '—', lbl: 'Bedrooms' },
      { val: d.min_stay ? `${d.min_stay} night${d.min_stay==1?'':'s'}` : '—', lbl: 'Min. stay' },
    ];
  }
  document.getElementById('stat-strip').innerHTML = stats.map(s => `<div class="stat-box"><div class="val">${s.val}</div><div class="lbl">${s.lbl}</div></div>`).join('');

  document.getElementById('listing-views').textContent = `${l.views||0} views`;
  document.getElementById('listing-posted').textContent = `Posted ${l.created_at ? timeAgoShort(l.created_at) : '—'}`;

  /* Amenities */
  const amenities = Array.isArray(l.amenities) ? l.amenities : [];
  if (amenities.length) {
    document.getElementById('amenities-card').style.display = 'block';
    document.getElementById('amenities-grid').innerHTML = NK_AMENITIES.filter(a => amenities.includes(a.key))
      .map(a => `<div class="amenity-chip"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>${a.label}</div>`).join('');
  }

  if (l.description) { document.getElementById('desc-card').style.display = 'block'; document.getElementById('desc-text').textContent = l.description; }

  /* Boarding room options + occupancy donut */
  if (meta.group === 'boarding') { renderUnitAvailability(); renderOccupancyOverview(); }

  if (listingUnits.length) {
    document.getElementById('enq-unit-type-field').style.display = 'block';
    const sel = document.getElementById('enq-unit-type');
    sel.innerHTML = '<option value="">Any available unit</option>' + listingUnits.filter(u => (u.quantity_available ?? 0) > 0)
      .map(u => `<option value="${escHtml(u.unit_label)}">${escHtml(u.unit_label)} — KES ${Number(u.price).toLocaleString('en-KE')}${meta.group==='boarding'?'/mo':''}</option>`).join('');
  }

  /* Where you'll be */
  document.getElementById('where-area').textContent = l.area || '—';
  document.getElementById('where-county').textContent = nkListingCounty(l);
  const houseRulesText = d.house_rules || null;
  if (houseRulesText) {
    const rules = houseRulesText.split(/\n|,/).map(r => r.trim()).filter(Boolean);
    if (rules.length) {
      document.getElementById('house-rules-wrap').style.display = 'block';
      document.getElementById('house-rules-list').innerHTML = rules.map(r => `<li>${escHtml(r)}</li>`).join('');
    }
  }

  /* Seller card */
  const profile = l.profiles || {};
  const sellerDisplayName = l.contact_name || profile.full_name || 'Seller';
  const initials = sellerDisplayName.split(' ').map(n=>n[0]).join('').toUpperCase().slice(0,2);
  document.getElementById('seller-avatar').textContent = initials;
  document.getElementById('seller-name').textContent = sellerDisplayName;
  document.getElementById('seller-since').textContent = profile.created_at ? `Member since ${new Date(profile.created_at).toLocaleDateString('en-KE',{month:'long',year:'numeric'})}` : '';
  const nkIsVerifiedSeller = profile.verification_status === 'verified';
  document.getElementById('seller-verified-badge').style.display = nkIsVerifiedSeller ? 'inline-flex' : 'none';
  document.getElementById('seller-unverified-badge').style.display = nkIsVerifiedSeller ? 'none' : 'inline-flex';

  const contactHidden = !!l.contact_hidden;
  const phoneFieldEl = document.getElementById('enq-phone-field');
  if (phoneFieldEl) phoneFieldEl.style.display = contactHidden ? 'none' : 'block';

  document.getElementById('skeleton-wrap').style.display = 'none';
  document.getElementById('listing-content').style.display = 'block';

  const jsonLd = { "@context": "https://schema.org", "@type": "Product", "name": l.title, "description": l.description || ogDesc, "image": ogImageUrl,
    "offers": { "@type": "Offer", "priceCurrency": "KES", "price": Number(l.price||0), "availability": "https://schema.org/InStock", "url": window.location.href } };
  document.getElementById('listing-jsonld').textContent = JSON.stringify(jsonLd);
}

function nkTitleCase(s) { if (!s) return ''; return String(s).replace(/_/g,' ').replace(/\b\w/g, c => c.toUpperCase()); }
function timeAgoShort(iso) {
  const d = (Date.now() - new Date(iso)) / 1000;
  if (d < 86400) return 'today';
  if (d < 2592000) return `${Math.floor(d/86400)}d ago`;
  return `${Math.floor(d/2592000)} month${Math.floor(d/2592000)===1?'':'s'} ago`;
}

