const tileOrder=()=>{const n=photos.length;return Array.from({length:Math.min(n,5)},(_,j)=>(idx+j)%n)};   // current photo first, then the next ones, so tiles never repeat the main photo
function tileBtn(i,main){
  const p=photos[i],n=photos.length,saver=document.body.classList.contains('nk-datasaver'),w=main?(saver?640:1200):(saver?400:640);
  return `<button type="button" class="gt${main?' gt-main':''}" data-act="photo" data-i="${i}" aria-label="Open photo ${i+1} of ${n}"><img src="${escHtml(srcFor(p,w))}" data-orig="${escHtml(p.url)}" alt="${main?escHtml(P.title)+', photo '+(i+1)+' of '+n:''}" ${main?'fetchpriority="high"':'loading="lazy"'} decoding="async"/></button>`;
}
function galleryHtml(){
  if(!photos.length)return `<div class="gallery" id="gallery"><div class="gnone">${IC.photo}<span>No photos for this listing yet</span></div></div>`;
  const heart=(typeof NKSaved!=='undefined'&&NKSaved.buildHeartBtn)?NKSaved.buildHeartBtn(P.id):'',n=photos.length,saver=document.body.classList.contains('nk-datasaver');
  const arrows=n>1?`<button type="button" class="gnav prev" data-act="gprev" aria-label="Previous photo">${IC.chev(1)}</button><button type="button" class="gnav next" data-act="gnext" aria-label="Next photo">${IC.chev(0)}</button>`:'';
  const count=n>1?`<div class="gcount" id="gcount" aria-hidden="true">${IC.photo}<span>${idx+1} / ${n}</span></div>`:'';
  if(phoneGallery()){
    return `<div class="gallery" id="gallery"><div class="gcar"><div class="gtrack" id="gtrack" role="group" aria-label="Photos, swipe to browse">${photos.map((p,i)=>`<button type="button" class="gslide" data-act="photo" data-i="${i}" aria-label="Open photo ${i+1} of ${n}"><img src="${escHtml(srcFor(p,saver?640:900))}" data-orig="${escHtml(p.url)}" alt="${i===0?escHtml(P.title)+', photo 1 of '+n:''}" ${i===0?'fetchpriority="high"':'loading="lazy"'} decoding="async"/></button>`).join('')}</div>${arrows}${count}<span class="gheart">${heart}</span></div></div>`;
