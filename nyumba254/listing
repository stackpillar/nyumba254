function nkListingCounty(l) { if (!l) return 'Kenya'; return l.county ? nkCountyLabel(l.county) : nkCountyForArea(l.area); }

function nkPopulateFooterCounties() {
  const el = document.getElementById('footer-counties');
  if (!el) return;
  el.innerHTML = NK_COUNTIES.map(county => {
    const hasAreas = (NK_AREAS_BY_COUNTY[county] || []).length > 0;
