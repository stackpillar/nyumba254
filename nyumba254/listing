  const {total,avail}=unitTotals(),taken=Math.max(0,total-avail),pct=total?Math.round(taken/total*100):0;
  const rows=units.map(u=>{
    const a=u.quantity_available??0,t=u.quantity_total??null,full=a<=0;
    const sub=g==='standard'&&u.bedrooms!=null?(u.bedrooms==0?'Studio':u.bedrooms+' bedroom'+(u.bedrooms==1?'':'s')):(rt[u.unit_label]?rt[u.unit_label]+' person'+(rt[u.unit_label]==1?'':'s'):'');
