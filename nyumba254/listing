.sheet-body .scard{border:0;padding:0;border-radius:0;box-shadow:none}

@media print{nav,.topbar,.side,.ctabar,.nk-tabbar,footer,.sim,.nk-scrolltop-btn,.anchors,.inline-cta{display:none!important}.layout{display:block}}
