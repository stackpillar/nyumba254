/* Previous / Next: from the search results the visitor came from when known, otherwise the neighbouring listings in the same category and county */
async function loadNeighbours(){
  if(!P||nav.src==='ctx')return;
  try{
    const n=P.listing_number,base=()=>{const q=db.from('listings').select('listing_number,title,area').eq('status','active').eq('is_disabled',false).eq('recycle_bin',false).eq('category',P.category);return P.county?q.eq('county',P.county):q};
    const [nw,od]=await Promise.all([base().gt('listing_number',n).order('listing_number',{ascending:true}).limit(1),base().lt('listing_number',n).order('listing_number',{ascending:false}).limit(1)]);
    const mk=r=>{const l=r&&r.data&&r.data[0];return l?{href:'/listing?id='+pad(l.listing_number),title:l.title,sub:l.area}:null};
    nav.prev=mk(nw);nav.next=mk(od);nav.src='db';renderNav();
  }catch(e){}
}
function tabActions(){
