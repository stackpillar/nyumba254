      :`<button type="button" class="btn btn-primary" data-act="pick" data-label="${escHtml(u.unit_label)}" ${full||P.status==='occupied'?'disabled':''}>${full?'Full':'Enquire'}</button>`;
    const pr=Number(u.price)>0?`${escHtml(money(u.price))}${FREQ[freq()]?`<small>${escHtml(FREQ[freq()])}</small>`:''}`:'On request';
    return `<div class="urow"><div class="m"><b>${escHtml(u.unit_label)}</b>${sub?`<span>${escHtml(sub)}</span>`:''}</div><div class="a${full?' none':''}">${t?a+' of '+t:a}<b>${full?'Full':'open'}</b></div><div class="p">${pr}</div>${btn}</div>`;
  }).join('');
