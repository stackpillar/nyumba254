/* ═══ 1. usage tracking: one small insert per action. Stops by itself if the table does not exist yet. Never runs for owners or previews. ═══ */
const EV={ok:true,photo:false};
function track(type,meta){
  if(!P||!EV.ok||preview||isOwner)return;
