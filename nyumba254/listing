<script>
  function nkWaitForListingUuid(cb, tries) {
    tries = tries || 0;
    if (listingId) { cb(listingId); return; }
    if (tries > 100) return;
    setTimeout(() => nkWaitForListingUuid(cb, tries + 1), 100);
  }
  NKSaved.init().then(() => {
    nkWaitForListingUuid((uuid) => {
      const btn = document.createElement('div');
      btn.style.cssText = 'position:absolute;top:14px;right:14px;z-index:3';
      btn.innerHTML = NKSaved.buildHeartBtn(uuid);
      document.querySelector('.gallery-main')?.appendChild(btn);
    });
  });
</script>
<script src="nav-badge.js"></script>
<script src="global-chat-widget.js"></script>

