  return n?`<a class="chip navchip" href="${escHtml(n.href)}" rel="${dir<0?'prev':'next'}" aria-label="${escHtml(aria)}" title="${escHtml(aria)}">${inner}</a>`:`<span class="chip navchip off" aria-disabled="true" aria-label="No ${lbl.toLowerCase()} listing">${inner}</span>`;
}
function navCard(dir,n){
  const ic=dir<0?IC.chev(1):IC.chev(0),lbl=dir<0?'Previous listing':'Next listing',end=dir<0?'This is the first listing':'This is the last listing';
  const body=`<span class="ln-t"><small>${lbl}</small><b>${n?escHtml(n.title||'View listing'):end}</b>${n&&n.sub?`<em>${escHtml(n.sub)}</em>`:''}</span>`,inner=dir<0?ic+body:body+ic;
  return n?`<a class="lncard ${dir<0?'p':'n'}" href="${escHtml(n.href)}" rel="${dir<0?'prev':'next'}">${inner}</a>`:`<span class="lncard off ${dir<0?'p':'n'}" aria-disabled="true">${inner}</span>`;
}
function renderNav(){
