  const la=parseFloat(L.latitude),ln=parseFloat(L.longitude);if(isFinite(la)&&isFinite(ln))return {ll:[la,ln],z:15,exact:true};
  try{const {data}=await db.from('area_centroids').select('lat,lng').eq('county',L.county).eq('area',L.area).maybeSingle();if(data)return {ll:[Number(data.lat),Number(data.lng)],z:14,exact:false}}catch(e){}
  const c=NK_COUNTY_COORDS[L.county];return c?{ll:c,z:11,exact:false}:null;
}
async function initMap(){
  const box=$('mapbox');
  const q=[L.area,L.county,'Kenya'].filter(Boolean).join(', '),la=parseFloat(L.latitude),ln=parseFloat(L.longitude);
  $('maplink').href='https://www.google.com/maps/search/?api=1&query='+(isFinite(la)&&isFinite(ln)?la+','+ln:encodeURIComponent(q));
  const draw=async()=>{
    box.innerHTML='Loading map…';
    try{await loadLeaflet();const p=await position();if(!p){box.textContent='Map not available for this listing.';return}
      box.innerHTML='<div id="map"></div>';const m=window.L.map('map',{scrollWheelZoom:false}).setView(p.ll,p.z);
      window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; OpenStreetMap contributors',maxZoom:19}).addTo(m);
      p.exact?window.L.marker(p.ll).addTo(m):window.L.circle(p.ll,{radius:600,color:'#0F6E56'}).addTo(m);setTimeout(()=>m.invalidateSize(),200);
    }catch(e){box.innerHTML='<button class="btn btn-outline" data-act="map">Map could not load. Try again</button>'}
  };
  window.__drawMap=draw;
  if(document.body.classList.contains('nk-datasaver')){box.innerHTML='<button class="btn btn-outline" data-act="map">Load map (uses extra data)</button>';return}
  if('IntersectionObserver' in window){const io=new IntersectionObserver(es=>{if(es.some(e=>e.isIntersecting)){io.disconnect();draw()}},{rootMargin:'300px'});io.observe(box)}else draw();
}
async function bnbCheck(){
  if(L.category!=='airbnb'||L.status==='occupied')return;
  const {data,error}=await db.from('bnb_properties').select('id,is_publicly_bookable').eq('listing_id',L.id).maybeSingle();
  if(error||!data||!data.is_publicly_bookable)return;
  $('bnb').innerHTML=`<section class="sec bnb"><div style="flex:1;min-width:200px"><b>Check availability and book instantly</b><div style="font-size:13px;opacity:.85">See live dates and pay securely, no waiting for a reply.</div></div><a class="btn" href="https://book.nyumba254.com/property.html?id=${escHtml(data.id)}" target="_blank" rel="noopener">Book this stay</a></section>`;
}

/* ── similar (same county + category first, then same county) ── */
async function loadSimilar(){
  $('sim').hidden=false;
  try{
    let q=db.from('listings').select('*, listing_photos(*), profiles(verification_status)').eq('status','active').eq('is_disabled',false).eq('recycle_bin',false).neq('id',L.id).eq('category',L.category);
    q=L.county?q.eq('county',L.county):q.eq('area',L.area);
    const {data}=await q.limit(24);if(!data||!data.length){$('sim').hidden=true;return}
    const score=l=>(l.area===L.area?0:1e9)+Math.abs(Number(l.price||0)-Number(L.price||0));
    const list=data.sort((a,b)=>score(a)-score(b)).slice(0,4);
    $('sim-grid').innerHTML=list.map(l=>nkBuildCard(l,{compact:true,imgWidth:480})).join('');
    if(typeof NKSaved!=='undefined'&&NKSaved.hydrate)NKSaved.hydrate($('sim-grid'));nkBindRecentViewedTracking($('sim-grid'));
  }catch(e){$('sim').hidden=true}
}

/* ── seller rating ── */
async function loadRating(){
  if(!L.seller_id)return;
  const {data,error}=await db.from('reviews').select('rating').eq('review_type','seller').eq('target_seller_id',L.seller_id).eq('status','published');
  if(error||!data||!data.length)return;sellerRatingCount=data.length;
  const avg=data.reduce((s,r)=>s+r.rating,0)/data.length,el=$('s-rate');
  if(el)el.textContent=`★ ${(Math.round(avg*10)/10)} (${data.length} review${data.length===1?'':'s'})`;
}

/* ── contact ── */
async function reveal(channel){
  if(L.contact_hidden){toast('This seller keeps contact on Nyumba254 chat. Send a message instead.');return openContactSheet()}
  if(revealBusy)return;
  if(!phoneRaw){
    revealBusy=true;
    try{const {data,error}=await db.rpc('reveal_seller_contact',{p_listing_id:L.id,p_device_id:lsg('nk_sid')||'',p_channel:channel});
      if(error){toast('Contact is temporarily unavailable. Send a message instead.','error');return}
      if(!data){toast("You've reached the contact limit for now. Send a message instead.",'error');return}
      phoneRaw=data;
    }catch(e){toast('Contact is temporarily unavailable. Send a message instead.','error');return}finally{revealBusy=false}
  }
  if(channel==='call')location.href='tel:'+phoneRaw.replace(/\s/g,'');
  else window.open(`https://wa.me/${nkNormalizePhone(phoneRaw).replace('+','')}?text=${encodeURIComponent(`Hello, I saw your listing "${L.title}" (ref #${pad(L.listing_number)}) on Nyumba254. Is it still available?`)}`,'_blank','noopener,noreferrer');
  nkTrackContactIntent();
}
function nkTrackContactIntent(){lss('nk_last_contact_'+L.id,String(Date.now()))}
function scrollForm(){const s=$('side');if(s){s.scrollIntoView({behavior:'smooth',block:'start'});setTimeout(()=>{const f=$('q-name')||$('q-msg');if(f)f.focus({preventScroll:true})},400)}}
function prefill(){
  const n=$('q-name');if(!n)return;const p=nkGetBuyerProfile();
  n.value=p.name||'';if($('q-phone'))$('q-phone').value=p.phone||'';if($('q-email'))$('q-email').value=p.email||'';
  $('q-msg').value=`Hi, I'm interested in "${L.title}" (ref #${pad(L.listing_number)}). Is it still available?`;
  ['q-name','q-phone','q-email'].forEach(id=>{const e=$(id);if(e)e.addEventListener('input',()=>{$(id+'-e').textContent='';e.setAttribute('aria-invalid','false')})});
}
async function checkThread(){
  if(isOwner||L.status==='occupied')return;let has=!!lsg('nk_buyer_'+L.id);
  if(!has&&uid){const {count}=await db.from('messages').select('id',{count:'exact',head:true}).eq('listing_id',L.id).eq('buyer_id',uid);has=count>0}
  if(has)showSent(true);
}
function showSent(existing){
  const s=$('sent'),e=$('enq');if(!s||!e)return;e.hidden=true;s.hidden=false;
  s.querySelector('h3').textContent=existing?'You are already in touch':'Message sent';
  s.querySelector('p').textContent=existing?'Continue the conversation with the seller in your chat.':'The seller will reply in your chat. You may also get a call.';
  if(typeof NKGlobalChat!=='undefined'&&NKGlobalChat.refresh)NKGlobalChat.refresh();
}
const okPhone=p=>/^\+254\d{9}$/.test(p)||/^\+\d{9,15}$/.test(p),okMail=e=>/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e);
function setErr(id,m){const e=$(id+'-e');if(e)e.textContent=m;const i=$(id);if(i)i.setAttribute('aria-invalid',m?'true':'false')}
async function legacyEnquiry(x){
  const eid=uuid(),a=await db.from('enquiries').insert({id:eid,listing_id:x.listing_id,buyer_name:x.name,buyer_phone:x.phone,buyer_email:x.email||null,buyer_token:x.token,buyer_id:x.uid,message:x.message});
  if(a.error)return {error:a.error};
  const b=await db.from('messages').insert({id:uuid(),listing_id:x.listing_id,buyer_token:x.token,buyer_name:x.name,buyer_phone:x.phone,buyer_id:x.uid,sender:'buyer',content:x.message});
  if(b.error){await db.from('enquiries').delete().eq('id',eid);return {error:b.error}}return {error:null};
}
async function sendEnquiry(){
  const hidden=!!L.contact_hidden;['q-name','q-phone','q-email'].forEach(i=>setErr(i,''));$('q-banner').textContent='';
  const name=$('q-name').value.trim(),phone=hidden?'':nkNormalizePhone($('q-phone').value.trim()),email=$('q-email').value.trim();let message=$('q-msg').value.trim();let ok=true;
  if(name.length<2){setErr('q-name','Enter your name');ok=false}
  if(!hidden&&!okPhone(phone)){setErr('q-phone','Enter a valid phone number, e.g. 0712 345 678');ok=false}
  if(email&&!okMail(email)){setErr('q-email','That email does not look right');ok=false}
  if(!ok){const bad=document.querySelector('#enq [aria-invalid="true"]');if(bad)bad.focus();return}
  if(!message)message=`Hi, I'm interested in "${L.title}". Is it still available?`;
  if($('q-web').value){showSent();return}
  if(Date.now()-Number(lsg('nk_enq_ts_'+L.id)||0)<60000){$('q-banner').textContent='You just sent an enquiry for this listing. Please wait a minute before sending another.';return}
  const unit=$('q-unit')&&$('q-unit').value;if(unit)message=`Interested in: ${unit}. ${message}`;
  const btn=$('q-send');btn.disabled=true;btn.innerHTML='<span class="spin"></span>Sending…';
  const token=lsg('nk_buyer_'+L.id)||uuid(),x={listing_id:L.id,name,phone,email,message,token,uid};
  let r=await db.rpc('submit_enquiry',{p_listing_id:x.listing_id,p_name:name,p_phone:phone,p_email:email||null,p_message:message,p_buyer_token:token});
  if(r.error&&(r.error.code==='PGRST202'||r.error.code==='42883'||/could not find the function|does not exist/i.test(r.error.message||'')))r=await legacyEnquiry(x);
  btn.disabled=false;btn.textContent='Send message';
  if(r.error){const m=r.error.message||'';$('q-banner').textContent=/rate_limited/.test(m)?'Too many enquiries from this device. Try again in an hour.':/listing_unavailable/.test(m)?'This listing is no longer available.':'Your message was not sent. Please try again.';return}
  lss('nk_buyer_'+L.id,token);lss('nk_enq_ts_'+L.id,String(Date.now()));nkSaveBuyerProfile({name,phone,email});
  const h={'Content-Type':'application/json',apikey:SUPABASE_KEY,Authorization:'Bearer '+SUPABASE_KEY};
  fetch(`${EDGE_URL}/send-notification-email`,{method:'POST',headers:h,body:JSON.stringify({type:'new_buyer_enquiry',buyerName:name,buyerPhone:phone,buyerEmail:email||null,message,listingId:L.id,listingTitle:L.title})}).catch(()=>{});
  fetch(`${EDGE_URL}/send-sms-alert`,{method:'POST',headers:h,body:JSON.stringify({type:'new_enquiry',listingId:L.id,buyerName:name,messagePreview:message,listingTitle:L.title})}).catch(()=>{});
  showSent(false);if(typeof NKGlobalChat!=='undefined'&&NKGlobalChat.registerAndOpen)NKGlobalChat.registerAndOpen(L.id);
}

/* ── owner actions ── */
async function ownerStatus(){
  const next=L.status==='occupied'?'active':'occupied';
  const {error}=await db.from('listings').update({status:next}).eq('id',L.id).eq('seller_id',uid);
  if(error)return toast('Could not update the status. Try again.','error');
  toast(next==='occupied'?'Marked as '+(freq()==='once'?'sold':'occupied'):'Marked as available');setTimeout(()=>location.reload(),700);
}
async function unitAction(id,occupy){
  const u=units.find(x=>String(x.id)===String(id));if(!u)return;
  const {data,error}=occupy?await db.rpc('mark_unit_occupied',{p_unit_id:u.id,p_floor:null,p_door:null,p_position:null}):await db.rpc('mark_unit_available',{p_unit_id:u.id});
  if(error||data===null)return toast('Could not update availability. Try again.','error');
  u.quantity_available=data;const y=window.scrollY;
  const old=qsa('#view .sec').find(s=>s.querySelector('.urow'));if(old){const t=document.createElement('div');t.innerHTML=unitsHtml();old.replaceWith(t.firstElementChild)}
  window.scrollTo(0,y);toast(occupy?'Marked as occupied':'Marked as available');
}

/* ── share / report / rate ── */
function openShare(){
  const url=location.origin+'/listing?id='+pad(L.listing_number),txt=`${L.title} · ${where()} · ${money(L.price)}${FREQ[freq()]||''}`;
  if(navigator.share){navigator.share({title:L.title,text:txt,url}).catch(()=>{});return}
  const e=encodeURIComponent,items=[['💬','WhatsApp',`https://wa.me/?text=${e(txt+'\n'+url)}`],['📘','Facebook',`https://www.facebook.com/sharer/sharer.php?u=${e(url)}`],['𝕏','X',`https://x.com/intent/tweet?text=${e(txt)}&url=${e(url)}`],['✈️','Telegram',`https://t.me/share/url?url=${e(url)}&text=${e(txt)}`],['✉️','Email',`mailto:?subject=${e(L.title)}&body=${e(txt+'\n'+url)}`]];
  $('share-grid').innerHTML=items.map(([i,n,h])=>`<a href="${escHtml(h)}" target="_blank" rel="noopener noreferrer"><span>${i}</span>${n}</a>`).join('')+`<button type="button" data-act="copy" data-url="${escHtml(url)}"><span>🔗</span>Copy link</button>`;
  nkOpenModal($('ov-share'));
}
async function sendReport(){
  const reason=$('rp-reason').value,amt=$('rp-amt').value.trim();let det=$('rp-det').value.trim();
  if(!reason){$('rp-banner').textContent='Select a reason first.';return}
  if(amt)det=`Amount asked: ${money(amt)}\n\n${det}`;
  const b=qsa('#ov-report .btn-primary')[0];b.disabled=true;b.innerHTML='<span class="spin"></span>Sending…';
  const {error}=await db.from('reports').insert({target_type:'listing',target_id:L.id,reason,details:det||null});
  b.disabled=false;b.textContent='Send report';
  if(error){$('rp-banner').textContent='Your report was not sent. Please try again.';return}
  nkCloseModal($('ov-report'));$('rp-banner').textContent='';toast("Thanks. We've received your report and will review it.");
}
function rateStars(){$('rt-stars').innerHTML=[1,2,3,4,5].map(n=>`<button type="button" class="${n<=stars?'on':''}" data-act="star" data-n="${n}" aria-label="${n} star${n>1?'s':''}" aria-pressed="${n===stars}">★</button>`).join('')}
async function sendRate(){
  if(!stars){$('rt-banner').textContent='Pick a star rating first.';return}
  const anon=$('rt-anon').checked,name=anon?null:($('rt-name').value.trim()||null);
  const b=qsa('#ov-rate .btn-primary')[0];b.disabled=true;b.innerHTML='<span class="spin"></span>Sending…';
  const {error}=await db.from('reviews').insert({review_type:'seller',target_seller_id:L.seller_id,listing_id:L.id,reviewer_role:'buyer',reviewer_name:name,is_anonymous:anon,rating:stars,comment:$('rt-txt').value.trim()||null});
  b.disabled=false;b.textContent='Submit review';
  if(error){$('rt-banner').textContent='Your review was not sent. Please try again.';return}
  nkCloseModal($('ov-rate'));toast('Thanks for your review.');loadRating();
}

/* ── events ── */
document.addEventListener('click',e=>{
  const t=e.target.closest('[data-act]');if(!t){
    const n=$('mobile-nav');if(n.classList.contains('open')&&!n.contains(e.target)&&!$('mobile-menu-btn').contains(e.target)){n.classList.remove('open');document.body.style.overflow='';$('mobile-menu-btn').setAttribute('aria-expanded','false')}
    if(e.target.classList.contains('ov'))nkCloseModal(e.target);return}
  const a=t.dataset.act;
  switch(a){
    case 'photo':showPhoto(Number(t.dataset.i));break;case 'prev':showPhoto(idx-1);break;case 'next':showPhoto(idx+1);break;
    case 'lb':lbShow();nkOpenModal($('lb'));break;case 'lprev':showPhoto(idx-1);break;case 'lnext':showPhoto(idx+1);break;
    case 'close':nkCloseModal(t.closest('.ov'));break;case 'reload':location.reload();break;
    case 'call':case 'wa':reveal(a==='call'?'call':'whatsapp');break;
    case 'scroll':openContactSheet();break;case 'send':sendEnquiry();break;
    case 'chat':if(typeof NKGlobalChat!=='undefined')NKGlobalChat.registerAndOpen(L.id);break;
    case 'viewing':if(typeof NKGlobalChat!=='undefined')NKGlobalChat.openBookViewing(L.id);break;
    case 'pick':openContactSheet(t.dataset.label);break;
    case 'occ':unitAction(t.dataset.id,true);break;case 'avail':unitAction(t.dataset.id,false);break;
    case 'status':ownerStatus();break;case 'map':window.__drawMap&&window.__drawMap();break;
    case 'more':{const d=$('desc'),x=d.classList.toggle('clamp');$('more').textContent=x?'Read more ↓':'Show less ↑';break}
    case 'vid':t.innerHTML=`<iframe src="${escHtml(t.dataset.src)}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen title="Video walkthrough"></iframe>`;t.removeAttribute('data-act');t.style.cursor='default';break;
    case 'share':openShare();break;
    case 'copy':navigator.clipboard.writeText(t.dataset.url).then(()=>{t.innerHTML='<span>✓</span>Copied';toast('Link copied')},()=>toast('Could not copy the link','error'));break;
    case 'report':$('rp-reason').value='';$('rp-amt-wrap').hidden=true;$('rp-banner').textContent='';nkOpenModal($('ov-report'));break;
    case 'send-report':sendReport();break;
    case 'rate':stars=0;rateStars();$('rt-name').value=(nkGetBuyerProfile().name)||'';$('rt-banner').textContent='';nkOpenModal($('ov-rate'));break;
    case 'star':stars=Number(t.dataset.n);rateStars();break;case 'send-rate':sendRate();break;
  }
});
document.addEventListener('keydown',e=>{
  if($('lb').classList.contains('open')){if(e.key==='ArrowLeft')showPhoto(idx-1);if(e.key==='ArrowRight')showPhoto(idx+1);return}
