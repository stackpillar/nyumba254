  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green:#0F6E56; --green-light:#E1F5EE; --green-mid:#1D9E75; --green-dark:#085041;
      --red:#C53030; --red-light:#FFF5F5;
      --text:#1a1a18; --text-2:#4a4a46; --text-3:#888780;
      --border:#e0ded8; --surface:#f7f6f2; --white:#ffffff;
      --radius:10px; --radius-lg:16px;
    }
    html { scroll-behavior: smooth; }
    body { font-family:'Inter',sans-serif; color:var(--text); background:var(--surface); font-size:15px; line-height:1.6; }
    a { text-decoration:none; color:inherit; }
    button { font-family:inherit; cursor:pointer; border:none; }
    input,select,textarea { font-family:inherit; }

    nav { position:sticky; top:0; z-index:100; display:flex; align-items:center; justify-content:space-between; padding:0 32px; height:64px; background:var(--white); border-bottom:1px solid var(--border); }
    .logo { display:flex; align-items:center; gap:10px; font-family:'Playfair Display',serif; font-size:20px; color:var(--green-dark); }
    .logo-icon { width:34px; height:34px; background:var(--green); border-radius:8px; display:flex; align-items:center; justify-content:center; }
    .logo-icon svg { width:18px; height:18px; fill:none; stroke:white; stroke-width:2; stroke-linecap:round; }
    .nav-links { display:flex; align-items:center; gap:8px; }
    .nav-link { font-size:14px; color:var(--text-2); padding:8px 14px; border-radius:var(--radius); transition:background .15s; }
    .nav-link:hover { background:var(--surface); }
    .btn-primary { display:inline-flex; align-items:center; gap:6px; font-size:14px; font-weight:500; padding:9px 18px; border-radius:var(--radius); background:var(--green); color:white; transition:background .15s; }
    .btn-primary:hover { background:var(--green-dark); }
    .nav-count { background: var(--green); color: white; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 10px; min-width: 16px; text-align: center; }
    .mobile-menu-btn { display:none; background:none; border:none; cursor:pointer; padding:6px; border-radius:6px; }
    .mobile-menu-btn svg { width:22px; height:22px; stroke:var(--text); fill:none; stroke-width:2; display:block; }
    .mobile-nav { display:none; position:fixed; top:64px; left:0; right:0; background:var(--white); border-bottom:1px solid var(--border); padding:16px; z-index:99; flex-direction:column; gap:4px; box-shadow:0 8px 24px rgba(0,0,0,0.1); }
    .mobile-nav.open { display:flex; }
    .mobile-nav a { font-size:15px; color:var(--text-2); padding:10px 14px; border-radius:var(--radius); }
    .mobile-nav a:hover { background:var(--surface); }
    .mobile-nav .btn-primary { text-align:center; justify-content:center; margin-top:8px; }
    @media (max-width:768px) { .nav-links { display:none; } .mobile-menu-btn { display:flex; } }

    .page-wrap { max-width:1120px; margin:0 auto; padding:20px 24px 80px; }
    .layout { display:grid; grid-template-columns:1fr 360px; gap:28px; align-items:start; }

    .top-bar { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:10px; }
    .back-link { display:inline-flex; align-items:center; gap:6px; font-size:14px; font-weight:600; color:var(--green-dark); }
    .back-link svg { width:16px; height:16px; stroke:var(--green-dark); fill:none; stroke-width:2.2; }
    .top-bar-actions { display:flex; gap:8px; }
    .top-btn { display:inline-flex; align-items:center; gap:6px; padding:8px 16px; border-radius:20px; border:1.5px solid var(--border); background:var(--white); font-size:13px; font-weight:600; cursor:pointer; transition:all .15s; }
    .top-btn svg { width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2; }
    .top-btn.report { color:var(--red); border-color:#f3c6c6; }
    .top-btn.report:hover { background:var(--red-light); }
    .top-btn.share { color:var(--green-dark); border-color:var(--green-mid); }
    .top-btn.share:hover { background:var(--green-light); }

    .gallery { border-radius:var(--radius-lg); overflow:hidden; background:#111; margin-bottom:20px; position:relative; }
    .gallery-main { width:100%; aspect-ratio:var(--gallery-ratio, 16/9); position:relative; overflow:hidden; background:#111; display:flex; align-items:center; justify-content:center; transition:aspect-ratio .25s ease; max-height:62vh; }
    .gallery-main img { position:relative; z-index:1; width:100%; height:100%; object-fit:cover; object-position:center; transition:opacity .3s; }
    .gallery-no-photo { position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; gap:12px; color:var(--text-3); }
    .gallery-no-photo svg { width:48px; height:48px; stroke:var(--border); fill:none; stroke-width:1.5; }
    .gallery-arrow { position:absolute; top:50%; transform:translateY(-50%); width:38px; height:38px; border-radius:50%; background:rgba(255,255,255,0.92); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all .15s; z-index:2; }
    .gallery-arrow:hover { background:white; box-shadow:0 2px 8px rgba(0,0,0,0.12); }
    .gallery-arrow svg { width:16px; height:16px; stroke:var(--text); fill:none; stroke-width:2.5; }
    .gallery-arrow.prev { left:12px; }
    .gallery-arrow.next { right:12px; }
    .gallery-counter { position:absolute; bottom:12px; right:14px; background:rgba(0,0,0,0.55); color:white; font-size:12px; font-weight:500; padding:3px 10px; border-radius:20px; z-index:2; }
    .gallery-thumbs { display:flex; gap:8px; padding:10px; overflow-x:auto; background:var(--white); border-top:1px solid var(--border); }
    .gallery-thumb { width:72px; height:52px; border-radius:6px; overflow:hidden; flex-shrink:0; border:2px solid transparent; cursor:pointer; transition:border-color .15s; position:relative; }
    .gallery-thumb.active { border-color:var(--green); }
    .gallery-thumb.more-overlay::after { content:attr(data-more); position:absolute; inset:0; background:rgba(8,80,65,0.72); color:white; font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center; text-align:center; line-height:1.3; }
    .gallery-thumb:focus-visible, .gallery-main img:focus-visible { outline:2px solid var(--green); outline-offset:2px; }
    .gallery-thumb img { width:100%; height:100%; object-fit:cover; }
    .gallery-main img { cursor:zoom-in; }

    .badge-row { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
    .status-pill { display:inline-flex; align-items:center; gap:5px; font-size:11.5px; font-weight:700; padding:5px 12px; border-radius:20px; background:var(--green-light); color:var(--green-dark); text-transform:uppercase; letter-spacing:.02em; }
    .status-pill svg { width:12px; height:12px; stroke:var(--green-dark); fill:none; stroke-width:2.4; }
    .status-pill.verified { background:var(--green-dark); color:white; }
    .status-pill.verified svg { stroke:white; }
    .status-pill.plain { background:var(--surface); color:var(--text-2); border:1px solid var(--border); }

    .listing-title { font-family:'Playfair Display',serif; font-size:clamp(22px,3vw,30px); color:var(--text); line-height:1.2; margin-bottom:8px; }
    .listing-location { display:flex; align-items:center; gap:6px; font-size:14px; color:var(--text-3); margin-bottom:14px; }
    .listing-location svg { width:15px; height:15px; stroke:var(--green); fill:none; stroke-width:2; flex-shrink:0; }
    .listing-price { font-family:'Playfair Display',serif; font-size:32px; font-weight:700; color:var(--green-dark); margin-bottom:18px; }
    .listing-price span { font-family:'Inter',sans-serif; font-size:14px; font-weight:400; color:var(--text-3); }

    .stat-strip { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--border); border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; margin-bottom:16px; }
    .stat-box { background:var(--white); padding:16px 12px; text-align:center; }
    .stat-box .val { font-size:17px; font-weight:700; color:var(--text); }
    .stat-box .lbl { font-size:11.5px; color:var(--text-3); margin-top:3px; }

    .meta-line { display:flex; align-items:center; gap:16px; flex-wrap:wrap; font-size:12.5px; color:var(--text-3); padding-bottom:16px; margin-bottom:18px; border-bottom:1px solid var(--border); }
    .meta-line span { display:inline-flex; align-items:center; gap:5px; }
    .meta-line svg { width:13px; height:13px; stroke:var(--text-3); fill:none; stroke-width:2; }

    .lcard { background:var(--white); border:1px solid var(--border); border-radius:var(--radius-lg); padding:22px 24px; margin-bottom:18px; }
    .lcard-head { display:flex; align-items:center; gap:9px; margin-bottom:16px; }
    .lcard-head svg { width:17px; height:17px; stroke:var(--green); fill:none; stroke-width:2; flex-shrink:0; }
    .lcard-head h3 { font-size:15.5px; font-weight:700; color:var(--text); }

    .room-row { display:flex; align-items:center; gap:14px; padding:14px 0; border-bottom:1px solid var(--border); flex-wrap:wrap; }
    .room-row:last-child { border-bottom:none; padding-bottom:0; }
    .room-row-icon { width:40px; height:40px; border-radius:50%; background:var(--green-light); color:var(--green-dark); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .room-row-icon svg { width:18px; height:18px; stroke:var(--green-dark); fill:none; stroke-width:2; }
    .room-row-main { flex:1; min-width:140px; }
    .room-row-label { font-size:14px; font-weight:700; color:var(--text); }
    .room-row-sub { font-size:12px; color:var(--text-3); margin-top:2px; }
    .room-row-avail { text-align:right; font-size:12px; color:var(--text-3); min-width:80px; }
    .room-row-avail strong { display:block; font-size:13px; font-weight:700; color:var(--green-dark); }
    .room-row-avail.none strong { color:var(--red); }
    .room-row-price { text-align:right; min-width:100px; }
    .room-row-price strong { font-size:15px; font-weight:700; color:var(--green-dark); }
    .room-row-price span { display:block; font-size:11px; color:var(--text-3); }
    .room-row-btn { padding:9px 16px; border-radius:20px; background:var(--green); color:white; font-size:12.5px; font-weight:700; white-space:nowrap; transition:background .15s; }
    .room-row-btn:hover { background:var(--green-dark); }
    .room-row-btn:disabled { opacity:.45; cursor:not-allowed; }

    .occ-card-body { display:flex; align-items:center; gap:24px; flex-wrap:wrap; }
    .occ-donut-wrap { position:relative; width:120px; height:120px; flex-shrink:0; }
    .occ-donut { width:120px; height:120px; border-radius:50%; }
    .occ-donut-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
    .occ-donut-center .pct { font-size:22px; font-weight:700; color:var(--text); }
    .occ-donut-center .lbl { font-size:10.5px; color:var(--text-3); }
    .occ-legend { flex:1; min-width:180px; }
    .occ-legend-title { font-size:14px; font-weight:700; color:var(--text); margin-bottom:10px; }
    .occ-legend-row { display:flex; align-items:center; gap:8px; font-size:13px; color:var(--text-2); margin-bottom:6px; }
    .occ-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
    .occ-dot.occupied { background:var(--green-dark); }
    .occ-dot.available { background:var(--green-mid); }
    .occ-dot.total { background:var(--border); border:1px solid var(--text-3); }

    .amenity-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:10px; }
    .amenity-chip { display:flex; align-items:center; gap:8px; padding:12px; border-radius:var(--radius); background:var(--surface); font-size:13px; font-weight:600; color:var(--text-2); }
    .amenity-chip svg { width:16px; height:16px; stroke:var(--green-dark); fill:none; stroke-width:2.6; flex-shrink:0; }

    .desc-text { font-size:14px; color:var(--text-2); line-height:1.8; white-space:pre-line; }
    .desc-text.collapsed { display:-webkit-box; -webkit-line-clamp:6; -webkit-box-orient:vertical; overflow:hidden; }
    .read-more { font-size:13px; color:var(--green); font-weight:600; margin-top:10px; cursor:pointer; display:inline-block; }

    .where-grid { display:grid; grid-template-columns:1fr 1fr; gap:22px; align-items:start; }
    .where-left dl { display:grid; grid-template-columns:auto 1fr; gap:5px 10px; font-size:13.5px; }
    .where-left dt { color:var(--text-3); }
    .where-left dd { color:var(--text); font-weight:600; }
    .private-pill { display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:700; color:var(--green-dark); background:var(--green-light); padding:3px 10px; border-radius:20px; margin-bottom:10px; }
    .private-pill svg { width:11px; height:11px; stroke:var(--green-dark); fill:none; stroke-width:2.4; }
    .house-rules-title { font-size:12.5px; font-weight:700; color:var(--text); margin:14px 0 6px; }
    .house-rules-list { list-style:none; padding:0; }
    .house-rules-list li { font-size:13px; color:var(--text-2); padding:4px 0; display:flex; align-items:flex-start; gap:7px; }
    .house-rules-list li::before { content:'•'; color:var(--green); font-weight:700; }
    .map-frame-wrap { position:relative; width:100%; height:230px; background:var(--surface); border-radius:var(--radius); overflow:hidden; border:1px solid var(--border); }
    #listing-map { position:absolute; inset:0; }
    .map-loading { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; color:var(--text-3); z-index:1; pointer-events:none; }
    .map-loading.hidden { display:none; }
    .map-loading svg { width:28px; height:28px; stroke:var(--border); fill:none; stroke-width:1.5; }
    .map-open-link { font-size:12px; color:var(--green); font-weight:600; display:inline-flex; align-items:center; gap:4px; margin-top:8px; }
    .map-open-link svg { width:12px; height:12px; stroke:var(--green); fill:none; stroke-width:2; }
    @media(max-width:700px) { .where-grid { grid-template-columns:1fr; } }

    .similar-section { margin-top:8px; }
    .similar-section h3 { font-size:16px; font-weight:700; color:var(--text); margin-bottom:16px; }
    .similar-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px; }
    .similar-card { background:var(--white); border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; cursor:pointer; transition:transform .2s,box-shadow .2s; }
    .similar-card:hover, .similar-card:focus-visible { transform:translateY(-2px); box-shadow:0 4px 16px rgba(0,0,0,0.08); }
    .similar-card:focus-visible { outline:2px solid var(--green); outline-offset:2px; }
    .similar-img { height:130px; background:var(--surface); overflow:hidden; }
    .similar-img img { width:100%; height:100%; object-fit:cover; }
    .similar-body { padding:12px 14px; }
    .similar-area { font-size:11px; font-weight:600; color:var(--green); text-transform:uppercase; letter-spacing:.06em; margin-bottom:3px; }
    .similar-title { font-size:13px; font-weight:600; color:var(--text); margin-bottom:6px; line-height:1.3; }
    .similar-price { font-size:15px; font-weight:700; color:var(--green-dark); }

    .sidebar-card { background:var(--white); border:1px solid var(--border); border-radius:var(--radius-lg); padding:22px; position:static; margin-bottom:16px; }
    .sidebar-kicker { font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--green); margin-bottom:4px; }
    .sidebar-title { font-size:17px; font-weight:700; color:var(--text); margin-bottom:6px; }
    .sidebar-sub { font-size:12.5px; color:var(--text-3); margin-bottom:18px; line-height:1.6; }

    .seller-row { display:flex; align-items:center; gap:12px; padding:14px 0; border-top:1px solid var(--border); border-bottom:1px solid var(--border); margin-bottom:18px; }
    .seller-avatar { width:42px; height:42px; border-radius:50%; background:var(--green-light); display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:700; color:var(--green-dark); flex-shrink:0; }
    .seller-name { font-size:14px; font-weight:700; color:var(--text); }
    .seller-since { font-size:12px; color:var(--text-3); }
    .verified-badge { display:inline-flex; align-items:center; gap:3px; font-size:11px; color:var(--green); font-weight:700; margin-top:3px; background:var(--green-light); padding:2px 8px; border-radius:20px; }
    .verified-badge svg { width:12px; height:12px; stroke:var(--green); fill:none; stroke-width:3; }
    .unverified-badge { display:inline-flex; align-items:center; gap:3px; font-size:11px; color:var(--text-2); font-weight:600; margin-top:3px; background:var(--surface); border:1px solid var(--border); padding:2px 8px; border-radius:20px; }
    .unverified-badge svg { width:12px; height:12px; stroke:var(--text-2); fill:none; stroke-width:2; }
    #seller-rating { display:flex; align-items:center; gap:2px; }

    .contact-btns { display:flex; flex-direction:column; gap:10px; margin-bottom:18px; }
    .btn-call { display:flex; align-items:center; justify-content:center; gap:8px; padding:13px; border-radius:var(--radius); font-size:14.5px; font-weight:700; background:var(--green); color:white; transition:background .15s; }
    .btn-call:hover { background:var(--green-dark); }
    .btn-whatsapp { display:flex; align-items:center; justify-content:center; gap:8px; padding:13px; border-radius:var(--radius); font-size:14.5px; font-weight:700; background:var(--green-dark); color:white; transition:background .15s; }
    .btn-whatsapp:hover { background:var(--text); }
    .btn-call:disabled,.btn-whatsapp:disabled { opacity:.7; cursor:wait; }
    .btn-call svg,.btn-whatsapp svg { width:18px; height:18px; flex-shrink:0; }
    .or-divider { display:flex; align-items:center; gap:10px; font-size:12px; color:var(--text-3); margin-bottom:16px; }
    .or-divider::before,.or-divider::after { content:''; flex:1; height:1px; background:var(--border); }

    .report-scam-btn { display:flex; align-items:center; justify-content:center; gap:8px; width:100%; padding:11px; margin-bottom:18px; background:var(--red-light); color:var(--red); border:1.5px solid #feb2b2; border-radius:var(--radius); font-size:13px; font-weight:600; cursor:pointer; transition:all .15s; font-family:inherit; }
    .report-scam-btn:hover { background:#fed7d7; border-color:var(--red); }
    .report-scam-btn svg { width:15px; height:15px; stroke:var(--red); fill:none; stroke-width:2; flex-shrink:0; }
    .report-scam-btn.reported { background:var(--surface); color:var(--text-3); border-color:var(--border); cursor:default; }
    .report-scam-btn.reported:hover { background:var(--surface); border-color:var(--border); }
    .report-scam-btn.reported svg { stroke:var(--text-3); }

    .field { margin-bottom:14px; }
    .field label { display:block; font-size:11.5px; font-weight:700; color:var(--text-2); text-transform:uppercase; letter-spacing:.04em; margin-bottom:5px; }
    .field label .opt-lbl { text-transform:none; font-weight:400; color:var(--text-3); letter-spacing:0; }
    .field input,.field textarea,.field select { width:100%; padding:10px 14px; border:1.5px solid var(--border); border-radius:var(--radius); font-size:14px; color:var(--text); background:var(--surface); outline:none; transition:border-color .15s,background .15s; }
    .field input:focus,.field textarea:focus,.field select:focus { border-color:var(--green); background:var(--white); }
    .field input.error,.field textarea.error { border-color:var(--red); }
    .field textarea { resize:vertical; min-height:76px; line-height:1.6; }
    .field-row-2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .field-error { font-size:11px; color:var(--red); margin-top:4px; display:none; }
    .field-error.show { display:block; }
    .btn-enquire { width:100%; padding:13px; background:var(--green); color:white; font-size:14.5px; font-weight:700; border-radius:var(--radius); transition:background .15s; display:flex; align-items:center; justify-content:center; gap:8px; margin-top:4px; }
