    <span class="gheart">${heart}</span><button type="button" class="gall" data-act="photo" data-i="${idx}">${IC.expand}${n>1?`Show all ${n} photos`:'View photo'}</button></div>`;
}
function renderGallery(){const g=$('gallery');if(!g||!P)return;g.outerHTML=galleryHtml();syncTrack();if(typeof NKSaved!=='undefined'&&NKSaved.hydrate)NKSaved.hydrate($('gallery'))}
/* desktop: swap only the photo tiles, so the arrow buttons keep keyboard focus */
function renderMosaic(){
  const gm=$('gm-main');if(!gm)return;const order=tileOrder();
  gm.querySelector('.gt').outerHTML=tileBtn(order[0],true);
  qsa('#gmosaic > .gt').forEach(b=>b.remove());
  gm.insertAdjacentHTML('afterend',order.slice(1).map(i=>tileBtn(i,false)).join(''));
  const c=$('gcount');if(c)c.lastElementChild.textContent=`${idx+1} / ${photos.length}`;
}
function syncTrack(smooth){
  const t=$('gtrack');if(!t||!photos.length)return;
  const w=t.clientWidth;if(w&&Math.abs(t.scrollLeft-idx*w)>2)t.scrollTo({left:idx*w,behavior:smooth?'smooth':'auto'});
  const c=$('gcount');if(c)c.lastElementChild.textContent=`${idx+1} / ${photos.length}`;
}
function unitsHtml(){
