  if(name.length<2){setErr('q-name','Enter your name');ok=false}
  if(!hidden&&!okPhone(phone)){setErr('q-phone','Enter a valid phone number, e.g. 0712 345 678');ok=false}
  if(email&&!okMail(email)){setErr('q-email','That email does not look right');ok=false;const d=$('q-email').closest('details');if(d)d.open=true}
  if(!ok){const f=$('q-fields');if(f)f.hidden=false;const s=$('q-sum');if(s)s.hidden=true;const bad=document.querySelector('#enq [aria-invalid="true"]');if(bad)bad.focus();return}
  if(!message)message=baseMsg()+' Is it still available?';
  if($('q-web').value){showSent(false);return}
  if(cooling()){$('q-banner').textContent=COOLDOWN;return}
  if(needNet())return;
  const unit=$('q-unit')&&$('q-unit').value;if(unit)message=`Interested in: ${unit}. ${message}`;
  const btn=$('q-send');btn.disabled=true;btn.innerHTML='<span class="spin"></span>Sending…';
  let r;try{r=await postEnquiry({name,phone,email,message},'form')}catch(e){r={error:e}}
  btn.disabled=false;btn.textContent='Send message';
  if(r.error){if(isNetErr(r.error))showNet("You're offline. Your message is kept, so try again when you're back online.");$('q-banner').textContent=enquiryFailure(r.error);return}
  showSent(false);   // the chat opens only when the buyer taps "Open conversation", so two layers never compete
}

/* ═══ 3. request a viewing: a date and time slot, sent to the seller through the same enquiry path ═══ */
const localISO=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
function openViewing(){
  if(!P||isOwner||P.status==='occupied')return;
  const sheet=$('ov-contact-sheet');if(sheet&&sheet.classList.contains('open'))nkCloseModal(sheet);
  ['vw-date','vw-name','vw-phone'].forEach(i=>setErr(i,''));$('vw-banner').textContent='';
  const pr=nkGetBuyerProfile(),first=(P.contact_name||(P.profiles||{}).full_name||'the seller').split(' ')[0],t=new Date();
  $('vw-sub').textContent=`Tell ${first} when you would like to see "${P.title}".`;
  $('vw-date').min=localISO(t);t.setDate(t.getDate()+1);$('vw-date').value=localISO(t);
  $('vw-name').value=pr.name||'';$('vw-phone').value=pr.phone||'';$('vw-note').value='';
  $('vw-phone-f').hidden=!!P.contact_hidden;$('vw-form').hidden=false;$('vw-done').hidden=true;
  nkOpenModal($('ov-view'));
}
async function sendViewing(){
  ['vw-date','vw-name','vw-phone'].forEach(i=>setErr(i,''));$('vw-banner').textContent='';
  const hidden=!!P.contact_hidden,date=$('vw-date').value,slot=$('vw-slot').value,name=$('vw-name').value.trim(),phone=hidden?'':nkNormalizePhone($('vw-phone').value.trim()),note=$('vw-note').value.trim();let ok=true;
  if(!date){setErr('vw-date','Pick a date');ok=false}else if(date<localISO(new Date())){setErr('vw-date','Pick today or a later date');ok=false}
  if(name.length<2){setErr('vw-name','Enter your name');ok=false}
  if(!hidden&&!okPhone(phone)){setErr('vw-phone','Enter a valid phone number, e.g. 0712 345 678');ok=false}
  if(!ok){const bad=document.querySelector('#vw-form [aria-invalid="true"]');if(bad)bad.focus();return}
  const done=()=>{$('vw-form').hidden=true;$('vw-done').hidden=false;showSent(false)};
  if($('vw-web').value){done();return}
  if(cooling()){$('vw-banner').textContent=COOLDOWN;return}
  if(needNet())return;
  const when=new Date(date+'T00:00:00').toLocaleDateString('en-KE',{weekday:'long',day:'numeric',month:'long'});
  const message=`Viewing request for "${P.title}" (ref ${shortRef()}): ${when}, ${slot}.${note?' Note: '+note+'.':''} Please confirm if this works.`;
  const btn=$('vw-send');btn.disabled=true;btn.innerHTML='<span class="spin"></span>Sending…';
  let r;try{r=await postEnquiry({name,phone,email:'',message},'viewing')}catch(e){r={error:e}}
  btn.disabled=false;btn.textContent='Send request';
  if(r.error){if(isNetErr(r.error))showNet("You're offline. Your request is kept, so try again when you're back online.");$('vw-banner').textContent=enquiryFailure(r.error);return}
  done();
}

/* ═══ 4. verified explainer ═══ */
function openVerify(verified){
  $('vf-body').innerHTML=(verified?'<p><b>Verified seller</b> means Nyumba254 has checked this seller\'s identity.</p><p>That is a good sign, but it is not a guarantee about the property itself.</p>':'<p>This seller has not completed identity verification yet.</p><p>That does not mean anything is wrong, but take extra care.</p>')+
    '<ul class="vlist"><li>View the property in person first.</li><li>Meet the person you will pay, and ask for a receipt.</li><li>Never pay before you have viewed it. Nyumba254 never asks buyers for money.</li></ul>';
  nkOpenModal($('ov-verify'));
}

/* ═══ owner actions ═══ */
async function ownerStatus(){
  const next=P.status==='occupied'?'active':'occupied';
  const {error}=await db.from('listings').update({status:next}).eq('id',P.id).eq('seller_id',uid);
  if(error)return toast('Could not update the status. Try again.','error');
  toast(next==='occupied'?'Marked as '+(isSale()?'sold':'occupied'):'Marked as available');setTimeout(()=>location.reload(),700);
}
async function unitAction(id,occupy){
  const u=units.find(x=>String(x.id)===String(id));if(!u)return;
  const {data,error}=occupy?await db.rpc('mark_unit_occupied',{p_unit_id:u.id,p_floor:null,p_door:null,p_position:null}):await db.rpc('mark_unit_available',{p_unit_id:u.id});
  if(error||data===null)return toast('Could not update availability. Try again.','error');
  u.quantity_available=data;const y=window.scrollY,old=$('sec-units');
  if(old){const t=document.createElement('div');t.innerHTML=unitsHtml();old.replaceWith(t.firstElementChild)}
  window.scrollTo(0,y);toast(occupy?'Marked as occupied':'Marked as available');
}

/* ═══ share / report / rate ═══ */
async function openShare(){
  const url=location.origin+'/listing?id='+pad(P.listing_number),txt=`${P.title} · ${where()} · ${basePrice()>0?money(basePrice())+(FREQ[freq()]||''):'Price on request'}`;
  if(navigator.share){try{await navigator.share({title:P.title,text:txt,url});return}catch(e){if(e&&e.name==='AbortError')return}}
  const e=encodeURIComponent,items=[['💬','WhatsApp',`https://wa.me/?text=${e(txt+'\n'+url)}`],['📘','Facebook',`https://www.facebook.com/sharer/sharer.php?u=${e(url)}`],['𝕏','X',`https://x.com/intent/tweet?text=${e(txt)}&url=${e(url)}`],['✈️','Telegram',`https://t.me/share/url?url=${e(url)}&text=${e(txt)}`],['✉️','Email',`mailto:?subject=${e(P.title)}&body=${e(txt+'\n'+url)}`]];
  $('share-grid').innerHTML=items.map(([i,n,h])=>`<a href="${escHtml(h)}" target="_blank" rel="noopener noreferrer"><span>${i}</span>${n}</a>`).join('')+`<button type="button" data-act="copy" data-url="${escHtml(url)}"><span>🔗</span>Copy link</button>`;
  nkOpenModal($('ov-share'));
}
async function sendReport(){
  const reason=$('rp-reason').value,amt=$('rp-amt').value.trim();let det=$('rp-det').value.trim();
  if(!reason){$('rp-banner').textContent='Select a reason first.';return}
  if(amt)det=`Amount asked: ${money(amt)}\n\n${det}`;
  const b=qsa('#ov-report .btn-primary')[0];b.disabled=true;b.innerHTML='<span class="spin"></span>Sending…';
  const {error}=await db.from('reports').insert({target_type:'listing',target_id:P.id,reason,details:det||null});
  b.disabled=false;b.textContent='Send report';
  if(error){$('rp-banner').textContent='Your report was not sent. Please try again.';return}
  nkCloseModal($('ov-report'));$('rp-banner').textContent='';toast("Thanks. We've received your report and will review it.");
}
function rateStars(){$('rt-stars').innerHTML=[1,2,3,4,5].map(n=>`<button type="button" class="${n<=stars?'on':''}" data-act="star" data-n="${n}" aria-label="${n} star${n>1?'s':''}" aria-pressed="${n===stars}">★</button>`).join('')}
async function sendRate(){
  if(!stars){$('rt-banner').textContent='Pick a star rating first.';return}
  const anon=$('rt-anon').checked,name=anon?null:($('rt-name').value.trim()||null);
  const b=qsa('#ov-rate .btn-primary')[0];b.disabled=true;b.innerHTML='<span class="spin"></span>Sending…';
  const {error}=await db.from('reviews').insert({review_type:'seller',target_seller_id:P.seller_id,listing_id:P.id,reviewer_role:'buyer',reviewer_name:name,is_anonymous:anon,rating:stars,comment:$('rt-txt').value.trim()||null});
  b.disabled=false;b.textContent='Submit review';
  if(error){$('rt-banner').textContent='Your review was not sent. Please try again.';return}
  nkCloseModal($('ov-rate'));toast('Thanks for your review.');loadRating();
}

/* ═══ events ═══ */
function closeMenu(){const n=$('mobile-nav');n.classList.remove('open');document.body.style.overflow='';$('mobile-menu-btn').setAttribute('aria-expanded','false')}
document.addEventListener('click',e=>{
  const bk=e.target.closest('[data-back]');
  if(bk&&canHistoryBack()){e.preventDefault();history.back();return}
  const nl=e.target.closest('a.navchip, a.lncard');if(nl)track('listing_nav',{dir:nl.getAttribute('rel')||''});
  if(e.target.closest('#sim-grid a.card'))track('similar_click');
  const anc=e.target.closest('[data-anchor]');
  if(anc){e.preventDefault();const t=$(anc.dataset.anchor);if(t)t.scrollIntoView({behavior:'smooth',block:'start'});return}
  const t=e.target.closest('[data-act]');
  if(!t){
    const n=$('mobile-nav');if(n.classList.contains('open')&&!n.contains(e.target)&&!$('mobile-menu-btn').contains(e.target))closeMenu();
    if(e.target.classList&&(e.target.classList.contains('notify-modal-overlay')||e.target.classList.contains('nk-sheet-overlay')))nkCloseModal(e.target);
    return}
  const a=t.dataset.act;
  switch(a){
    case 'photo':if(!EV.photo){EV.photo=true;track('photo_open')}idx=Number(t.dataset.i)||0;lbShow();nkOpenModal($('lb'));break;case 'gprev':showPhoto(idx-1);break;case 'gnext':showPhoto(idx+1);break;
    case 'lb':lbShow();nkOpenModal($('lb'));break;case 'lprev':showPhoto(idx-1);break;case 'lnext':showPhoto(idx+1);break;case 'lbzoom':lbZoom();break;
    case 'close':nkCloseModal(t.closest('.notify-modal-overlay, .nk-sheet-overlay'));break;case 'reload':location.reload();break;
    case 'call':case 'wa':track(a==='call'?'call_tap':'whatsapp_tap',{src:t.dataset.src||'unknown'});reveal(a==='call'?'call':'whatsapp');break;
    case 'copynum':{const n=($('phone-panel')||{dataset:{}}).dataset.n||nkNormalizePhone(phoneRaw);navigator.clipboard.writeText(n).then(()=>toast('Number copied'),()=>toast('Could not copy the number','error'));break}
    case 'scroll':openContactSheet();break;case 'send':sendEnquiry();break;
    case 'qmsg':{$('q-msg').value=baseMsg()+' '+QMSG[Number(t.dataset.i)];$('q-msg').focus({preventScroll:true});break}
    case 'again':{$('sent').hidden=true;$('enq').hidden=false;$('q-msg').value=baseMsg()+' ';if(!coarse())$('q-msg').focus({preventScroll:true});break}
    case 'edit-contact':{$('q-fields').hidden=false;$('q-sum').hidden=true;$('q-name').focus({preventScroll:true});break}
    case 'chat':if(typeof NKGlobalChat!=='undefined')NKGlobalChat.registerAndOpen(P.id);break;
    case 'viewing':track('viewing_open',{src:t.dataset.src||'unknown'});openViewing();break;case 'send-viewing':sendViewing();break;
    case 'verinfo':track('verify_info');openVerify(t.dataset.v==='1');break;case 'retry-net':retryNet();break;
    case 'pick':openContactSheet(t.dataset.label);break;
    case 'occ':unitAction(t.dataset.id,true);break;case 'avail':unitAction(t.dataset.id,false);break;
    case 'status':ownerStatus();break;case 'map':window.__drawMap&&window.__drawMap();break;
    case 'more':{const d=$('desc'),x=d.classList.toggle('clamp');t.textContent=x?'Read more ↓':'Show less ↑';t.setAttribute('aria-expanded',String(!x));break}
    case 'vid':{const wrap=t;const f=document.createElement('div');f.className='vid';f.innerHTML=`<iframe src="${escHtml(t.dataset.src)}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen title="Video walkthrough"></iframe>`;wrap.replaceWith(f);break}
    case 'share':track('share');openShare();break;
    case 'copy':navigator.clipboard.writeText(t.dataset.url).then(()=>{t.innerHTML='<span>✓</span>Copied';toast('Link copied')},()=>toast('Could not copy the link','error'));break;
    case 'report':$('rp-reason').value='';$('rp-amt-wrap').hidden=true;$('rp-banner').textContent='';nkOpenModal($('ov-report'));break;
    case 'send-report':sendReport();break;
    case 'rate':stars=0;rateStars();$('rt-name').value=(nkGetBuyerProfile().name)||'';$('rt-banner').textContent='';nkOpenModal($('ov-rate'));break;
    case 'star':stars=Number(t.dataset.n);rateStars();break;case 'send-rate':sendRate();break;
    case 'reach-yes':lss('nk_reach_'+P.id,'1');$('reach').hidden=true;toast('Great. Good luck with the viewing.');break;
    case 'reach-no':lss('nk_reach_'+P.id,'1');$('reach').hidden=true;toast('Send the seller a message here and they will reply in your chat.');openContactSheet();break;
  }
});
document.addEventListener('keydown',e=>{
  if($('lb').classList.contains('open')){if(e.key==='ArrowLeft')showPhoto(idx-1);if(e.key==='ArrowRight')showPhoto(idx+1);return}
  if(e.key==='Escape'&&$('mobile-nav').classList.contains('open')){closeMenu();$('mobile-menu-btn').focus();return}
  const g=$('gallery');if(P&&photos.length>1&&g&&g.contains(document.activeElement)){if(e.key==='ArrowLeft'){e.preventDefault();showPhoto(idx-1)}if(e.key==='ArrowRight'){e.preventDefault();showPhoto(idx+1)}}
});
document.addEventListener('change',e=>{if(e.target.id==='rp-reason')$('rp-amt-wrap').hidden=!/unreasonable_fee|scam_attempt/.test(e.target.value)});
/* photo fallback: if a resized URL fails (transforms unavailable), fall back to the original file once */
document.addEventListener('error',e=>{const im=e.target;if(im&&im.tagName==='IMG'&&im.dataset&&im.dataset.orig&&im.getAttribute('src')!==im.dataset.orig)im.src=im.dataset.orig},true);
/* carousel: keep the counter and index in step with the native swipe */
let gTick=false;
document.addEventListener('scroll',e=>{const t=e.target;if(!t||t.id!=='gtrack'||gTick)return;gTick=true;requestAnimationFrame(()=>{gTick=false;const w=t.clientWidth;if(!w)return;const i=Math.round(t.scrollLeft/w);if(i!==idx&&i>=0&&i<photos.length){idx=i;const c=$('gcount');if(c)c.lastElementChild.textContent=`${idx+1} / ${photos.length}`}})},true);
/* the carousel jumps to whichever photo the viewer was left on; the layout switches between mosaic and carousel at 768px */
new MutationObserver(m=>{if(m.some(x=>x.attributeName==='class')&&!$('lb').classList.contains('open'))syncTrack()}).observe($('lb'),{attributes:true});
matchMedia('(max-width:768px)').addEventListener('change',renderGallery);
swipe($('lb-box'),d=>{if(!zoomed)showPhoto(idx+d)});
document.addEventListener('visibilitychange',()=>{if(!document.hidden)maybeReach()});
window.addEventListener('pageshow',e=>{if(e.persisted&&P){checkThread();maybeReach();if(typeof NKSaved!=='undefined'&&NKSaved.hydrate)NKSaved.hydrate($('view'))}});

/* ═══ page chrome ═══ */
$('scrolltop-btn').addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
let tick=false;window.addEventListener('scroll',()=>{if(tick)return;tick=true;requestAnimationFrame(()=>{$('scrolltop-btn').classList.toggle('visible',window.scrollY>800);tick=false})},{passive:true});
$('mobile-menu-btn').addEventListener('click',()=>{const o=$('mobile-nav').classList.toggle('open');$('mobile-menu-btn').setAttribute('aria-expanded',String(o));document.body.style.overflow=o?'hidden':''});
$('nk-datasaver-off').addEventListener('click',nkToggleDataSaver);
let tabbarSync=()=>{};
function tabbar(){const tb=document.querySelector('.nk-tabbar');if(!tb)return;
  tabbarSync=()=>document.documentElement.style.setProperty('--nk-tabbar-h',(getComputedStyle(tb).display==='none'?0:Math.ceil(tb.getBoundingClientRect().height))+'px');
  tabbarSync();if('ResizeObserver' in window)new ResizeObserver(tabbarSync).observe(tb);
  addEventListener('resize',()=>{tabbarSync();measureCta()});addEventListener('load',()=>{tabbarSync();measureCta()});matchMedia('(max-width:900px)').addEventListener('change',()=>{tabbarSync();measureCta()})}
function liftChat(){const skip=new Set(['toast','main-nav','mobile-nav','ctabar','lb','scrolltop-btn']);const scan=()=>[...document.body.children].forEach(el=>{
  if(el.classList.contains('nk-chat-fab')||skip.has(el.id)||/^(SCRIPT|MAIN|FOOTER|NAV)$/.test(el.tagName)||/notify-modal-overlay|nk-sheet-overlay|nk-tabbar|ctabar/.test(el.className))return;
  const cs=getComputedStyle(el);if(cs.position!=='fixed'||cs.bottom==='auto'||cs.right==='auto')return;
  if(/chat|help|support/i.test((el.textContent+' '+(el.getAttribute('aria-label')||'')+' '+el.id+' '+el.className).slice(0,400)))el.classList.add('nk-chat-fab')});
  scan();new MutationObserver(nkDebounce(scan,150)).observe(document.body,{childList:true});setTimeout(scan,1500);setTimeout(scan,4000)}
function footerCounties(){$('footer-counties').innerHTML=NK_COUNTIES.map(c=>nkAreaCountFor(c)>0?`<a href="${escHtml(nkBuildListingsUrl({county:c}))}">${escHtml(nkCountyLabel(c))}</a>`:`<span class="soon">${escHtml(nkCountyLabel(c))}</span>`).join('')}
const src=$('nav-count-badge'),tgt=$('nk-tab-saved-badge');
if(src&&tgt){const s=()=>{const n=src.textContent.trim();tgt.textContent=n;tgt.classList.toggle('visible',src.style.display!=='none'&&n!=='0'&&n!=='')};new MutationObserver(s).observe(src,{childList:true,attributes:true,attributeFilter:['style']});s()}
$('yr').textContent=new Date().getFullYear();footerCounties();
window.addEventListener('offline',()=>showNet("You're offline. What's already on screen still works, but sending messages needs a connection."));
window.addEventListener('online',()=>{showNet('Back online.','ok');setTimeout(hideNet,2500);if(loadFailed)load()});
if(offline())showNet("You're offline. What's already on screen still works, but sending messages needs a connection.");
nkInitDataSaver();nkInitAccountNav(['nav-account-link','mobile-account-link']);
nkSessionPromise.then(({data})=>{if(data&&data.session)$('tab-account-link').setAttribute('href','/dashboard')});
nkTrackPageView();tabbar();liftChat();tabActions();load();
})();
