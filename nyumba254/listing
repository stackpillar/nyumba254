const listingNumber = new URLSearchParams(window.location.search).get('id');
let listingId = null;
let listing = null;
let photos = [];
let currentPhoto = 0;
let buyerToken = null, buyerName = '', buyerPhone = '';
let threadMessages = [];
let currentBuyerId = null;
let listingUnits = [];
let isListingOwner = false;
