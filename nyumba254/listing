  const ext=(label)=>`<a class="btn btn-outline" href="${escHtml(url)}" target="_blank" rel="noopener">${escHtml(label)}</a>`;
  let inner;
  if(yt)inner=`<button type="button" class="vid" data-act="vid" data-src="https://www.youtube.com/embed/${escHtml(yt[1])}?autoplay=1" aria-label="Play video walkthrough" ${saver?'':`style="background-image:url('https://img.youtube.com/vi/${escHtml(yt[1])}/hqdefault.jpg')"`}><span class="play"><span>▶</span></span></button>`;
