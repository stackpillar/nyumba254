<body>

<div id="loading-screen">
  <div class="spin"></div>
  <p>Loading KYC Verification Center…</p>
</div>

<div class="toast" id="toast" role="status" aria-live="polite">
  <span id="toast-msg"></span>
</div>

<div id="app" style="display:none">
  <div class="topbar">
    <div class="topbar-brand">
      <div class="topbar-brand-icon"><img src="/logo-icon.png" alt="Nyumba254"/></div>
      <span class="topbar-brand-text">Nyumba254</span>
    </div>
    <a href="/dashboard.html" class="topbar-back"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>Back to dashboard</a>
  </div>

  <div class="page-wrap">
    <div class="kyc-page">
      <div class="kyc-header">
        <div class="kyc-brandmark">
          <div class="kyc-brandmark-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><polyline points="9 12 11 14 15 10"/></svg></div>
          <div><div class="kyc-eyebrow">Nyumba254 · Trust &amp; Safety</div><div class="kyc-h1">KYC Verification Center</div></div>
        </div>
        <div class="kyc-header-status">
          <svg class="kyc-seal" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
          <div class="kyc-status-text" id="kyc-header-status-text">Verifying your identity keeps buyers safe and unlocks <strong>unlimited listings</strong> plus a visible trust badge.</div>
        </div>
      </div>

      <div class="kyc-stepper" id="kyc-stepper"></div>

      <div class="kyc-body">
        <div id="role-verification-content"></div>
        <div id="kyc-body-content"></div>
      </div>

      <div class="kyc-footer">
        <div class="kyc-footer-note">🔒 Documents are encrypted in transit and only visible to Nyumba254's verification team.</div>
        <div style="display:flex;gap:10px;flex-wrap:wrap" id="kyc-footer-actions"></div>
      </div>
    </div>
  </div>
</div>

<script>
const SUPABASE_URL = 'https://vliuuloyfhyxcsuchpss.supabase.co';
const SUPABASE_KEY = 'sb_publishable_oIIcecf3wzKMual5K24Z8Q_zmxVfgsx';
const { createClient } = supabase;

const authStorage = {
  getItem: (key) => (localStorage.getItem('ny_remember') === '0' ? sessionStorage : localStorage).getItem(key),
  setItem: (key, value) => (localStorage.getItem('ny_remember') === '0' ? sessionStorage : localStorage).setItem(key, value),
  removeItem: (key) => { localStorage.removeItem(key); sessionStorage.removeItem(key); }
};

const db = createClient(SUPABASE_URL, SUPABASE_KEY, {
  auth: { storage: authStorage, persistSession: true, autoRefreshToken: true }
});

let currentUser = null, currentProfile = null;
const VERIFY_BUCKET = 'verification-docs';

let toastTimer;
function showToast(msg, type='success'){
  const t=document.getElementById('toast'), m=document.getElementById('toast-msg');
  clearTimeout(toastTimer);
  t.className='toast '+type;
  m.textContent=msg;
  t.classList.add('show');
  toastTimer=setTimeout(()=>t.classList.remove('show'),3500);
}
function escHtml(s){ if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

async function init(){
  try{
    const{data:{session}}=await db.auth.getSession();
    if(!session){ window.location.href='/login?next=/kyc.html'; return; }
    currentUser=session.user;

    const{data,error}=await db.from('profiles').select('*').eq('id',currentUser.id).single();
    if(error || !data){ await db.auth.signOut(); window.location.href='/login'; return; }
    currentProfile=data;

    document.getElementById('loading-screen').style.display='none';
    document.getElementById('app').style.display='block';

    loadVerificationUI();
    await loadRoleVerificationUI();
    if(location.hash==='#role-verification')document.getElementById('role-verification-content')?.scrollIntoView({behavior:'smooth',block:'start'});
  }catch(err){
    console.error('Init error:',err);
    document.getElementById('loading-screen').innerHTML =
      '<p style="color:white;max-width:320px;text-align:center">Something went wrong loading this page. Please refresh.<br><span style="opacity:.6;font-size:11px">'+escHtml(err.message||String(err))+'</span></p>';
  }
}

function kycStatusMeta(status){
  return {
    unverified: {pill:'unverified',pillLabel:'Not started',dotIdx:0},
    pending:    {pill:'pending',pillLabel:'Under review',dotIdx:1},
    verified:   {pill:'verified',pillLabel:'Verified ✓',dotIdx:2},
    rejected:   {pill:'rejected',pillLabel:'Needs changes',dotIdx:0},
  }[status] || {pill:'unverified',pillLabel:'Not started',dotIdx:0};
}

function roleVerificationLabel(role){
  return {
    owner:'Direct from owner',
    caretaker:'Caretaker',
    agent:'Agent',
    company:'Company'
  }[role]||role;
}

function roleVerificationRequirements(role){
  return {
    owner:'A document supporting your ownership claim, such as a title, lease, or other property record.',
    caretaker:'Written authorization from the owner or property manager.',
    agent:'Evidence of your agency affiliation or authorization to represent the properties you list.',
    company:'Company registration or other evidence that you are authorized to represent the company.'
  }[role]||'Documents that support your selected role.';
}

async function loadRoleVerificationUI(){
  const root=document.getElementById('role-verification-content');
  if(!root)return;
  const role=currentProfile?.account_type;
  if(!role||role==='buyer'){
    root.innerHTML=`<section class="kyc-checklist" id="role-verification" style="margin-bottom:20px"><div class="kyc-section-title">Role verification</div><p style="font-size:13px;color:var(--text-2)">Choose an owner, caretaker, agent, or company role in your dashboard before submitting role evidence. A selected role is a claim; verification is proof.</p><a class="btn btn-outline" style="margin-top:12px" href="/dashboard#settings">Choose or review my role</a></section>`;
    return;
  }

  let latest=null;
  try{
    const{data,error}=await db.from('role_verification_submissions').select('account_type,status,admin_note,submitted_at').eq('profile_id',currentUser.id).order('submitted_at',{ascending:false}).limit(1);
    if(error)throw error;
    latest=data?.[0]||null;
  }catch(error){
    console.error('Could not load role-verification status:',error);
    root.innerHTML='<section class="kyc-checklist" id="role-verification" style="margin-bottom:20px"><div class="kyc-section-title">Role verification</div><p style="font-size:13px;color:var(--text-2)">Role-verification status is temporarily unavailable. Your identity verification remains available below.</p></section>';
    return;
  }

  const verified=currentProfile?.verified_role===role;
  const pending=latest?.status==='pending'&&latest.account_type===role;
  const requirements=roleVerificationRequirements(role);
  root.innerHTML=`<section class="kyc-checklist" id="role-verification" style="margin-bottom:20px">
    <div class="kyc-section-title">Role verification · ${escHtml(roleVerificationLabel(role))}</div>
    <p style="font-size:13px;color:var(--text-2);line-height:1.6;margin-bottom:12px">Your selected role is a claim; verification is proof. This review is separate from identity KYC, so accounts already identity-verified can submit role evidence here.</p>
    ${verified?'<div class="kyc-checklist-item"><svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>Your current role is verified.</div>':pending?`<div class="kyc-checklist-item"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>Your role documents were submitted on ${escHtml(new Date(latest.submitted_at).toLocaleDateString('en-KE'))} and are awaiting review.</div>`:''}
    ${latest?.status==='rejected'&&latest.account_type===role&&latest.admin_note?`<p style="font-size:13px;color:var(--red);margin:8px 0">Review note: ${escHtml(latest.admin_note)}</p>`:''}
    ${!verified&&!pending?`<p style="font-size:13px;color:var(--text-2);margin-bottom:10px">${escHtml(requirements)}</p>
      <label for="role-verification-files" style="display:block;font-size:13px;font-weight:600;margin:10px 0 6px">Supporting documents (1–5 files)</label>
      <input id="role-verification-files" type="file" accept="image/*,.pdf" multiple/>
      <label for="role-verification-note" style="display:block;font-size:13px;font-weight:600;margin:12px 0 6px">Optional note</label>
      <textarea id="role-verification-note" maxlength="1000" rows="3" style="width:100%;padding:10px;border:1px solid var(--border);border-radius:8px;font:inherit" placeholder="Add context that helps our team review your role evidence."></textarea>
      <button class="btn btn-primary" style="margin-top:12px" type="button" id="role-verification-submit" onclick="submitRoleVerification()">Submit role evidence</button>`:''}
    <p id="role-verification-status" role="status" aria-live="polite" style="font-size:12px;color:var(--text-3);margin-top:8px"></p>
  </section>`;
}

async function submitRoleVerification(){
  const fileInput=document.getElementById('role-verification-files');
  const files=[...(fileInput?.files||[])];
  const status=document.getElementById('role-verification-status');
  const button=document.getElementById('role-verification-submit');
  if(!files.length||files.length>5){if(status)status.textContent='Choose between one and five supporting documents.';return;}
  const maxSize=10*1024*1024;
  if(files.some(file=>file.size>maxSize||!(file.type==='application/pdf'||file.type.startsWith('image/')))){
    if(status)status.textContent='Each file must be an image or PDF no larger than 10 MB.';
    return;
  }
  if(button){button.disabled=true;button.textContent='Uploading…';}
  if(status)status.textContent='Upload in progress. Keep this page open.';
  const uploadedPaths=[];
  try{
    for(const [index,file] of files.entries()){
      const extension=(file.name.split('.').pop()||'file').toLowerCase().replace(/[^a-z0-9]/g,'').slice(0,8)||'file';
      const path=`${currentUser.id}/role-verification/${Date.now()}-${index}.${extension}`;
      const{error}=await db.storage.from(VERIFY_BUCKET).upload(path,file,{upsert:false});
      if(error)throw error;
      uploadedPaths.push(path);
    }
    const note=document.getElementById('role-verification-note')?.value.trim()||null;
    const{error}=await db.rpc('submit_role_verification',{p_document_paths:uploadedPaths,p_applicant_note:note});
    if(error)throw error;
    status.textContent='Your role documents were submitted for review.';
    await loadRoleVerificationUI();
  }catch(error){
    console.error('Role-verification submission failed:',error);
    let message=error.message||'Could not submit role documents. Please try again.';
    if(uploadedPaths.length){
      try{
        const{error:cleanupError}=await db.storage.from(VERIFY_BUCKET).remove(uploadedPaths);
        if(cleanupError){
          console.error('Could not remove role-verification documents after submission failed:',cleanupError);
          message+=' Some uploaded documents could not be removed; contact support before retrying.';
        }
      }catch(cleanupError){
        console.error('Could not remove role-verification documents after submission failed:',cleanupError);
        message+=' Some uploaded documents could not be removed; contact support before retrying.';
      }
    }
    if(status)status.textContent=message;
  }finally{
    if(button){button.disabled=false;button.textContent='Submit role evidence';}
  }
}

function loadVerificationUI() {
  const v = currentProfile || {};
  const status = v.verification_status || 'unverified';
  const meta = kycStatusMeta(status);

  const steps=['Identity','Ownership','Review'];
  const stepperEl=document.getElementById('kyc-stepper');
  if(stepperEl){
    stepperEl.innerHTML = steps.map((label,i)=>{
      const cls = i<meta.dotIdx ? 'done' : (i===meta.dotIdx ? 'current' : '');
      const dot = i<meta.dotIdx ? '✓' : (i+1);
      const line = i<steps.length-1 ? '<div class="kyc-step-line"></div>' : '';
      return `<div class="kyc-step ${cls}"><div class="kyc-step-dot">${dot}</div><div class="kyc-step-label">${label}</div></div>${line}`;
    }).join('');
  }

  const bodyEl=document.getElementById('kyc-body-content');
  const footEl=document.getElementById('kyc-footer-actions');
  const headStatusEl=document.getElementById('kyc-header-status-text');
  if(!bodyEl||!footEl)return;

  if (status === 'verified') {
    if(headStatusEl) headStatusEl.innerHTML = "<strong>You're fully verified.</strong> Buyers see a trust badge on every listing, and your listing space is unlimited.";
    bodyEl.innerHTML = `
      <div class="kyc-checklist">
        <div class="kyc-checklist-item"><svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>Identity document verified</div>
        <div class="kyc-checklist-item"><svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>Ownership / authority document verified</div>
        <div class="kyc-checklist-item"><svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>Trust badge active on all listings</div>
      </div>`;
    footEl.innerHTML = `<a href="/dashboard.html" class="btn btn-outline">Back to dashboard</a>`;
    return;
  }

  if (status === 'pending') {
    if(headStatusEl) headStatusEl.innerHTML = "<strong>Your documents are under review.</strong> Our team typically completes this within 24 hours.";
    bodyEl.innerHTML = `
      <div class="kyc-section-title">Submitted for review</div>
      <div class="kyc-checklist">
        <div class="kyc-checklist-item"><svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>National ID (front &amp; back) received</div>
        <div class="kyc-checklist-item"><svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>${v.verification_is_owner===false?'Authority letter':'Proof of ownership'} received</div>
      </div>
      ${v.extra_verification_status==='requested' ? `
      <div class="kyc-section-title">⚠️ Additional document requested</div>
      <div class="kyc-upload-card">
        <p style="font-size:13px;color:var(--text-2);margin-bottom:10px">${escHtml(v.extra_verification_reason||'')}</p>
        <div class="kyc-upload-input"><input type="file" id="kyc-extra-doc-file" accept="image/*,.pdf"/></div>
        <button class="btn btn-primary" style="margin-top:10px" onclick="submitExtraVerification()">Upload document</button>
      </div>` : ''}
      <div class="kyc-trust-row">
        <div class="kyc-trust-item"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>Encrypted upload</div>
        <div class="kyc-trust-item"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>~24hr review</div>
      </div>`;
    footEl.innerHTML = `<a href="/dashboard.html" class="btn btn-outline">Back to dashboard</a>`;
    return;
  }

  if(headStatusEl){
    headStatusEl.innerHTML = status==='rejected'
      ? `<strong>Your last submission needs changes.</strong> ${v.verification_rejection_reason?escHtml(v.verification_rejection_reason):'Please review and resubmit below.'}`
      : `Verifying your identity keeps buyers safe and unlocks <strong>unlimited listings</strong> plus a visible trust badge.`;
  }
  bodyEl.innerHTML = `
    <div class="kyc-section-title">Before you start</div>
    <div class="kyc-checklist">
      <div class="kyc-checklist-item"><svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>A valid, unexpired national ID (front and back)</div>
      <div class="kyc-checklist-item"><svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>Proof of ownership (title deed / lease) or an authority letter if listing on someone's behalf</div>
      <div class="kyc-checklist-item"><svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>Clear, uncropped photos or scans — takes about 2 minutes</div>
    </div>

    <div class="kyc-section-title">Ownership status</div>
    <div class="form-group" style="margin-bottom:18px">
      <select id="kyc-is-owner" onchange="updateVerifyProofLabel()">
        <option value="yes">Yes, I own this property</option>
        <option value="no">No — I'm listing on someone's behalf</option>
      </select>
    </div>

    <div class="kyc-section-title">Step 1 · Identity document</div>
    <div class="kyc-upload-card">
      <div class="kyc-upload-top">
        <div class="kyc-upload-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><circle cx="8" cy="11" r="2.4"/><path d="M4 18c1-2.2 2.8-3.4 4-3.4s3 1.2 4 3.4M15 9h5M15 13h5"/></svg></div>
        <div><div class="kyc-upload-title">National ID — front side</div><div class="kyc-upload-sub">Clear photo or scan, all corners visible</div></div>
        <span class="kyc-required-tag">Required</span>
      </div>
      <div class="kyc-upload-input"><input type="file" id="kyc-id-front-file" accept="image/*,.pdf"/></div>
    </div>
    <div class="kyc-upload-card">
      <div class="kyc-upload-top">
        <div class="kyc-upload-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="6" y1="9" x2="18" y2="9"/><line x1="6" y1="13" x2="18" y2="13"/><line x1="6" y1="17" x2="12" y2="17"/></svg></div>
        <div><div class="kyc-upload-title">National ID — back side</div><div class="kyc-upload-sub">Both sides are required to verify authenticity</div></div>
        <span class="kyc-required-tag">Required</span>
      </div>
      <div class="kyc-upload-input"><input type="file" id="kyc-id-back-file" accept="image/*,.pdf"/></div>
    </div>

    <div class="kyc-section-title">Step 2 · <span id="kyc-proof-label-text">Proof of ownership</span></div>
    <div class="kyc-upload-card">
      <div class="kyc-upload-top">
        <div class="kyc-upload-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
        <div><div class="kyc-upload-title" id="kyc-proof-title">Title deed or lease copy</div><div class="kyc-upload-sub" id="kyc-proof-sub">Confirms your right to list this property</div></div>
        <span class="kyc-required-tag">Required</span>
      </div>
      <div class="kyc-upload-input"><input type="file" id="kyc-proof-file" accept="image/*,.pdf"/></div>
    </div>

    <div class="kyc-trust-row">
      <div class="kyc-trust-item"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>Encrypted upload</div>
      <div class="kyc-trust-item"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>~24hr review</div>
      <div class="kyc-trust-item"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>Team-reviewed, never automated</div>
    </div>
  `;
  footEl.innerHTML = `<a href="/dashboard.html" class="btn btn-outline">Not now</a><button class="btn btn-primary" id="kyc-submit-btn" onclick="submitVerification()">Submit for review</button>`;
  updateVerifyProofLabel();

  ['kyc-id-front-file','kyc-id-back-file','kyc-proof-file'].forEach(id=>{
    const inp=document.getElementById(id);
    if(inp) inp.addEventListener('change',()=>{ inp.closest('.kyc-upload-card')?.classList.toggle('has-file', inp.files.length>0); });
  });
}

function updateVerifyProofLabel() {
  const sel=document.getElementById('kyc-is-owner');
  if(!sel)return;
  const isOwner = sel.value === 'yes';
  const labelText=document.getElementById('kyc-proof-label-text');
  const title=document.getElementById('kyc-proof-title');
  const sub=document.getElementById('kyc-proof-sub');
  if(labelText) labelText.textContent = isOwner ? 'Proof of ownership' : 'Authority to list';
  if(title) title.textContent = isOwner ? 'Title deed or lease copy' : "Authority letter, or the owner's ID + written consent";
  if(sub) sub.textContent = isOwner ? 'Confirms your right to list this property' : 'Confirms the owner has authorized you to list on their behalf';
}

async function uploadVerifyFile(file, kind) {
  const ext = (file.name.split('.').pop() || 'jpg').toLowerCase();
  const path = `${currentUser.id}/${kind}-${Date.now()}.${ext}`;
  const { error } = await db.storage.from(VERIFY_BUCKET).upload(path, file, { upsert:false });
  if (error) throw error;
  return path;
}

async function submitVerification() {
  const idFile = document.getElementById('kyc-id-front-file').files[0];
  const idFile2 = document.getElementById('kyc-id-back-file').files[0];
  const proofFile = document.getElementById('kyc-proof-file').files[0];
  const isOwner = document.getElementById('kyc-is-owner').value === 'yes';
  if (!idFile || !idFile2) { showToast('Please upload both the front and back of your ID','error'); return; }
  if (!proofFile) { showToast('Please attach your proof of ownership document','error'); return; }
  const btn = document.getElementById('kyc-submit-btn');
  btn.disabled = true; btn.innerHTML = '<span class="spinner-sm"></span> Uploading…';
  try {
    const idPath = await uploadVerifyFile(idFile, 'id-front');
    const idPath2 = await uploadVerifyFile(idFile2, 'id-back');
    const proofPath = await uploadVerifyFile(proofFile, isOwner ? 'ownership' : 'authority');
    const { error } = await db.from('profiles').update({
      verification_status: 'pending', verification_is_owner: isOwner,
      verification_id_url: idPath, verification_id_url_2: idPath2, verification_proof_url: proofPath,
      verification_proof_type: isOwner ? 'title_deed_or_lease' : 'authority_letter',
      verification_submitted_at: new Date().toISOString(), verification_rejection_reason: null,
    }).eq('id', currentUser.id);
    if (error) throw error;
    await db.from('verification_activity_log').insert({ seller_id: currentUser.id, action:'submitted' });
    currentProfile = { ...currentProfile, verification_status:'pending', verification_is_owner:isOwner };
    loadVerificationUI();
    showToast('Submitted for review ✓','success');
    fetch(`${SUPABASE_URL}/functions/v1/send-notification-email`, { method:'POST', headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}, body: JSON.stringify({
      type:'verification_submitted', sellerName: currentProfile?.full_name, sellerEmail: currentUser.email, isOwner, proofType: isOwner?'Title deed / lease':'Authority letter',
    })}).catch(()=>{});
  } catch(e) {
    showToast('Upload failed: '+e.message,'error');
  } finally {
    const b=document.getElementById('kyc-submit-btn');
    if(b){ b.disabled = false; b.textContent = 'Submit for review'; }
  }
}

async function submitExtraVerification() {
  const file = document.getElementById('kyc-extra-doc-file')?.files[0];
  if (!file) { showToast('Please attach a file','error'); return; }
  try {
    const path = await uploadVerifyFile(file, 'extra');
    const docs = Array.isArray(currentProfile?.extra_verification_docs) ? [...currentProfile.extra_verification_docs] : [];
    docs.push({ url: path, uploaded_at: new Date().toISOString() });
    const { error } = await db.from('profiles').update({ extra_verification_docs: docs, extra_verification_status: 'submitted' }).eq('id', currentUser.id);
    if (error) throw error;
    await db.from('verification_activity_log').insert({ seller_id: currentUser.id, action:'extra_submitted' });
    currentProfile = { ...currentProfile, extra_verification_docs: docs, extra_verification_status:'submitted' };
    loadVerificationUI();
    showToast('Uploaded ✓ — our team will review it shortly','success');
    fetch(`${SUPABASE_URL}/functions/v1/send-notification-email`, { method:'POST', headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}, body: JSON.stringify({
      type:'extra_verification_submitted', sellerName: currentProfile?.full_name, sellerEmail: currentUser.email,
    })}).catch(()=>{});
  } catch(e) { showToast('Upload failed: '+e.message,'error'); }
}

init();
</script>
<script>
try {
  var sid = localStorage.getItem('nk_sid');
  if (!sid) { sid = (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2)); localStorage.setItem('nk_sid', sid); }
  db.from('page_views').insert({ path: location.pathname, referrer: document.referrer || null, user_agent: navigator.userAgent, session_id: sid }).then(function(){}, function(){});
} catch (e) {}
</script>
