<script src="/nk-shared.js"></script>
<script>
  /* SUPABASE_URL, SUPABASE_KEY, EDGE_URL, db (the Supabase client with the same
     "remember me" storage adapter), nkSessionPromise, nkNormalizePhone and
     escHtml all come from nk-shared.js now — no more duplicated bootstrap. */

  // ── Production site base — used for ALL auth email redirects so links ──
  // ── always work no matter where signup/reset was triggered from       ──
  const SITE_BASE = 'https://nyumba254.com';

  // ── Safe redirect target: same-origin relative paths only.        ──
  // ── Fixes both the missing-leading-slash bug and the open-redirect ──
  // ── vulnerability (next=https://evil.com, next=@evil.com, etc.)    ──
  function safeNext(raw) {
    if (!raw) return '/dashboard';
    try {
      const u = new URL(raw, location.origin);
      return (u.origin === location.origin) ? (u.pathname + u.search) : '/dashboard';
    } catch (e) { return '/dashboard'; }
  }

  const urlParams = new URLSearchParams(window.location.search);
  const redirectTo = safeNext(urlParams.get('next'));
  const arrivalReason = urlParams.get('reason');
  const arrivalEmail = urlParams.get('email');

  // ── Offline handling ──
  function isOffline() { return navigator.onLine === false; }
  function showNet(msg, kind) {
    const b = document.getElementById('netbar');
    document.getElementById('netbar-t').textContent = msg;
    b.classList.toggle('ok', kind === 'ok');
    b.classList.add('show');
  }
  function hideNet() { document.getElementById('netbar').classList.remove('show'); }
  function needNet(msg) {
    if (isOffline()) { showNet(msg || "You're offline. Connect to the internet and try again."); return true; }
    return false;
  }
  function isNetErr(err) {
    return isOffline() || /failed to fetch|network|load failed/i.test((err && err.message) || '');
  }
  document.getElementById('netbar-retry').addEventListener('click', () => { if (!isOffline()) hideNet(); });
  window.addEventListener('offline', () => showNet("You're offline. Forms won't submit until you're back online."));
  window.addEventListener('online', () => { showNet('Back online.', 'ok'); setTimeout(hideNet, 2000); });
  if (isOffline()) showNet("You're offline. Forms won't submit until you're back online.");

  // ── Small timeout wrapper so a hung request doesn't leave the button ──
  // ── stuck in its loading state forever.                              ──
  function withTimeout(promise, ms) {
    return Promise.race([
      promise,
      new Promise((_, reject) => setTimeout(() => {
        const e = new Error('Request timed out'); e.isTimeout = true; reject(e);
      }, ms))
    ]);
  }
  function friendlyError(err) {
    if (err && err.isTimeout) return 'This is taking longer than expected. Check your connection and try again.';
    if (isNetErr(err)) return "No connection. Please check your internet and try again.";
    return (err && err.message) || 'Something went wrong. Please try again.';
  }

  // ── If already logged in, redirect immediately; otherwise reveal the form ──
  nkSessionPromise.then(({ data }) => {
    if (data && data.session) {
      window.location.href = redirectTo;
    } else {
      document.getElementById('session-check').style.display = 'none';
      // Only autofocus on devices with a real pointer (skip on touch, to
      // avoid popping the keyboard and jumping the layout on load).
      if (arrivalReason !== 'existing_account' && window.matchMedia('(pointer: fine)').matches) {
        document.getElementById('login-email')?.focus({ preventScroll: true });
      }
    }
  }).catch(() => {
    document.getElementById('session-check').style.display = 'none';
    showNet("Couldn't check your session. You can still sign in below.");
  });

  // ── Tab switching ──
  function switchTab(tab) {
    ['login', 'register'].forEach(t => {
      const btn = document.getElementById('tab-' + t);
      const active = t === tab;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-selected', String(active));
    });
    switchPanel(tab);
  }

  function switchPanel(panel) {
    ['login', 'register', 'reset'].forEach(p => {
      const el = document.getElementById('panel-' + p);
      if (el) el.classList.toggle('active', p === panel);
    });
    clearAllErrors();
    loginFailCount = 0;
    const heading = document.getElementById(panel + '-title');
    if (heading) heading.focus({ preventScroll: true });
  }

  // ── Error helpers ──
  function clearAllErrors() {
    document.querySelectorAll('.alert').forEach(a => { a.className = 'alert'; });
    document.querySelectorAll('.field-error').forEach(e => e.classList.remove('show'));
    document.querySelectorAll('input.error').forEach(i => { i.classList.remove('error'); i.setAttribute('aria-invalid', 'false'); });
    document.getElementById('resend-link')?.remove();
  }

  function showAlert(alertId, msgId, message, type) {
    const el = document.getElementById(alertId);
    el.className = 'alert ' + type;
    document.getElementById(msgId).textContent = message;
    // an alert always starts clean — no stale resend link from a previous attempt
    if (alertId === 'login-alert') document.getElementById('resend-link')?.remove();
  }

  function fieldError(inputId, errId, show) {
    const input = document.getElementById(inputId);
    input?.classList.toggle('error', show);
    input?.setAttribute('aria-invalid', show ? 'true' : 'false');
    document.getElementById(errId)?.classList.toggle('show', show);
  }

  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    btn.disabled = loading;
    btn.classList.toggle('loading', loading);
  }

  // ── Phone formatter (cursor-position safe, matching the pattern used ──
  // ── elsewhere in the codebase for price/phone reformatting) ──
  function formatPhone(input) {
    const fromEnd = input.value.length - (input.selectionEnd ?? input.value.length);
    let v = input.value.replace(/\D/g, '').slice(0, 12);
    if (v.startsWith('254')) v = '0' + v.slice(3);
    if (v.length > 4 && v.length <= 7) v = v.slice(0,4) + ' ' + v.slice(4);
    else if (v.length > 7) v = v.slice(0,4) + ' ' + v.slice(4,7) + ' ' + v.slice(7);
    input.value = v;
    const p = Math.max(0, input.value.length - fromEnd);
    try { input.setSelectionRange(p, p); } catch (e) {}
  }

  // ── Password visibility toggle ──
  function togglePw(inputId, btn) {
    const input = document.getElementById(inputId);
    const show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    btn.innerHTML = show
      ? `<svg viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`
      : `<svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
  }

  // ── Password strength ──
  function checkPwStrength(pw) {
    const fill = document.getElementById('pw-fill');
    const label = document.getElementById('pw-label');
    if (!pw) { fill.style.width = '0'; label.textContent = ''; return; }
    let score = 0;
    if (pw.length >= 8) score++;
    if (/[A-Z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    if (/[^A-Za-z0-9]/.test(pw)) score++;
    const levels = [
      { w:'25%', c:'#e74c3c', t:'Weak — add numbers or symbols' },
      { w:'50%', c:'#e67e22', t:'Fair — try a longer password' },
      { w:'75%', c:'#f39c12', t:'Good' },
      { w:'100%', c:'#27ae60', t:'Strong ✓' },
    ];
    const l = levels[Math.max(score-1,0)];
    fill.style.width = l.w; fill.style.background = l.c;
    label.textContent = l.t; label.style.color = l.c;
  }

  const isEmail = v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  // Real Kenyan MSISDN check (via the shared normalizer), replacing the old
  // "length >= 9" check that let through obviously-wrong numbers.
  const okPhone = v => /^\+254\d{9}$/.test(nkNormalizePhone(v));

  // ── LOGIN ──
  let loginFailCount = 0;
  async function doLogin() {
    clearAllErrors();
    const email = document.getElementById('login-email').value.trim();
    const pw    = document.getElementById('login-password').value;
    let ok = true;
    if (!isEmail(email)) { fieldError('login-email','err-login-email',true); ok=false; }
    if (!pw) { fieldError('login-password','err-login-pw',true); ok=false; }
    if (!ok) return;
    if (needNet("You're offline. Connect to the internet to sign in.")) return;

    const remember = document.getElementById('login-remember').checked;
    localStorage.setItem('ny_remember', remember ? '1' : '0');

    setLoading('btn-login', true);
    let error;
    try {
      ({ error } = await withTimeout(db.auth.signInWithPassword({ email, password: pw }), 15000));
    } catch (e) {
      setLoading('btn-login', false);
      showAlert('login-alert','login-alert-msg', friendlyError(e), 'error');
      return;
    }
    setLoading('btn-login', false);

    if (error) {
      if (error.message.includes('Email not confirmed')) {
        loginFailCount = 0;
        showAlert('login-alert','login-alert-msg',
          'Please verify your email first — check your inbox.', 'error');
        showResendLink(email);
        return;
      }
      if (error.message.includes('Invalid login credentials')) {
        loginFailCount++;
        if (loginFailCount >= 3) {
          showAlert('login-alert','login-alert-msg',
            "Still not working? Double-check your email, or reset your password below.", 'error');
        } else {
          showAlert('login-alert','login-alert-msg',
            'Email or password is incorrect. Please try again.', 'error');
        }
      } else {
        showAlert('login-alert','login-alert-msg', error.message, 'error');
      }
      return;
    }
    window.location.href = redirectTo;
  }

  // ── Google OAuth ──
  async function signInWithGoogle() {
    if (needNet("You're offline. Connect to the internet to continue with Google.")) return;
    try {
      const { error } = await withTimeout(db.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: SITE_BASE + redirectTo }
      }), 15000);
      if (error) showAlert('login-alert','login-alert-msg', error.message, 'error');
    } catch (e) {
      showAlert('login-alert','login-alert-msg', friendlyError(e), 'error');
    }
  }

  // ── Show a "resend verification email" link under the login alert ──
  function showResendLink(email) {
    const alertEl = document.getElementById('login-alert');
    if (document.getElementById('resend-link')) return;
    const link = document.createElement('a');
    link.id = 'resend-link';
    link.href = '#';
    link.style.cssText = 'display:block;margin-top:6px;font-weight:600;text-decoration:underline;color:inherit';
    link.textContent = 'Resend verification email';
    link.onclick = async (e) => {
      e.preventDefault();
      if (needNet("You're offline. Connect to the internet to resend the email.")) return;
      link.textContent = 'Sending…';
      try {
        const { error } = await withTimeout(db.auth.resend({
          type: 'signup',
          email: email,
          options: { emailRedirectTo: SITE_BASE + '/verify-email' }
        }), 15000);
        if (error) {
          link.textContent = (error.status === 429 || /rate limit|after/i.test(error.message || ''))
            ? 'Please wait a minute before requesting again'
            : 'Could not resend — try again shortly';
        } else {
          link.textContent = '✓ Verification email sent — check your inbox';
          link.style.pointerEvents = 'none';
        }
      } catch (err) {
        link.textContent = friendlyError(err);
      }
    };
    alertEl.appendChild(link);
  }

  // ── Consent checkbox helpers ──
  function clearConsentError() {
    document.getElementById('consent-box').classList.remove('error');
    document.getElementById('err-consent').classList.remove('show');
  }

  // ── REGISTER ──
  async function doRegister() {
    clearAllErrors();
    clearConsentError();
    const first   = document.getElementById('reg-firstname').value.trim();
    const last    = document.getElementById('reg-lastname').value.trim();
    const email   = document.getElementById('reg-email').value.trim();
    const phone   = document.getElementById('reg-phone').value.trim();
    const pw      = document.getElementById('reg-password').value;
    const confirm = document.getElementById('reg-confirm').value;
    const consent = document.getElementById('reg-consent').checked;
    let ok = true;

    if (!first)        { fieldError('reg-firstname','err-firstname',true); ok=false; }
    if (!last)         { fieldError('reg-lastname','err-lastname',true); ok=false; }
    if (!isEmail(email)){ fieldError('reg-email','err-reg-email',true); ok=false; }
    if (!okPhone(phone)){ fieldError('reg-phone','err-phone',true); ok=false; }
    if (pw.length < 8) { fieldError('reg-password','err-reg-pw',true); ok=false; }
    if (confirm !== pw) { fieldError('reg-confirm','err-reg-confirm',true); ok=false; }
    if (!consent) {
      document.getElementById('consent-box').classList.add('error');
      document.getElementById('err-consent').classList.add('show');
      ok = false;
    }
    if (!ok) return;
    if (needNet("You're offline. Connect to the internet to create your account.")) return;

    // Normalize once here, then reuse everywhere below — the stored value
    // is always E.164 (+254...), matching every other page in the codebase.
    const phoneNorm = nkNormalizePhone(phone);

    setLoading('btn-register', true);
    let data, error;
    try {
      ({ data, error } = await withTimeout(db.auth.signUp({
        email, password: pw,
        options: {
          data: { full_name: `${first} ${last}`, phone: phoneNorm },
          emailRedirectTo: SITE_BASE + '/verify-email'
        }
      }), 20000));
    } catch (e) {
      setLoading('btn-register', false);
      showAlert('register-alert','register-alert-msg', friendlyError(e), 'error');
      return;
    }
    setLoading('btn-register', false);

    if (error) {
      showAlert('register-alert','register-alert-msg',
        error.message.includes('already registered')
          ? 'An account with this email already exists. Try signing in instead.'
          : error.message,
        'error');
      return;
    }

    // ── Supabase anti-enumeration quirk ──
    // With "Confirm email" on, signUp() does NOT return an error for an
    // already-registered + already-confirmed email. Instead it returns a
    // fake success with data.user present but an EMPTY identities array.
    // No new confirmation email is actually sent in this case.
    if (data.user && Array.isArray(data.user.identities) && data.user.identities.length === 0) {
      showAlert('register-alert','register-alert-msg',
        'An account with this email already exists. Try signing in instead.',
        'error');
      return;
    }

    // Save to profiles table (phone stored normalized, same format as
    // every other page that writes to profiles.phone)
    if (data.user) {
      try {
        await db.from('profiles').upsert({
          id: data.user.id,
          full_name: `${first} ${last}`,
          phone: phoneNorm, email
        });
      } catch (e) { /* non-fatal — profile can be completed later */ }
    }

    // Notify admin of the new seller registration
    fetch(`${EDGE_URL}/send-notification-email`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` },
      body: JSON.stringify({
        type: 'new_seller_registered',
        audience: 'admin',
        sellerName: `${first} ${last}`,
        sellerEmail: email,
        sellerPhone: phoneNorm,
      }),
    }).catch(()=>{});

    // Remember email so the "resend" link on the success screen works
    window.lastRegEmail = email;

    // Hide form, show success
    document.querySelector('#panel-register .auth-title').style.display = 'none';
    document.querySelector('#panel-register .auth-sub').style.display = 'none';
    document.querySelector('#panel-register #register-alert').style.display = 'none';
    document.getElementById('register-form').style.display = 'none';
    document.querySelectorAll('#panel-register #google-slot-register').forEach(el => el.style.display='none');
    document.getElementById('register-success').style.display = 'block';
    document.getElementById('register-success').setAttribute('tabindex','-1');
    document.getElementById('register-success').focus({ preventScroll: true });
  }

  // ── Resend verification email from the success screen ──
  async function resendFromSuccess() {
    const link = document.getElementById('resend-success-link');
    if (!window.lastRegEmail) return;
    if (needNet("You're offline. Connect to the internet to resend the email.")) return;
    link.textContent = 'Sending…';
    try {
      const { error } = await withTimeout(db.auth.resend({
        type: 'signup',
        email: window.lastRegEmail,
        options: { emailRedirectTo: SITE_BASE + '/verify-email' }
      }), 15000);
      link.textContent = error
        ? ((error.status === 429 || /rate limit|after/i.test(error.message || ''))
            ? 'Please wait a minute, then try again'
            : 'Could not resend — try again shortly')
        : '✓ Sent! Check your inbox (and spam folder)';
      if (!error) link.style.pointerEvents = 'none';
    } catch (e) {
      link.textContent = friendlyError(e);
    }
  }

  // ── PASSWORD RESET ──
  async function doReset() {
    clearAllErrors();
    const email = document.getElementById('reset-email').value.trim();
    if (!isEmail(email)) { fieldError('reset-email','err-reset-email',true); return; }
    if (needNet("You're offline. Connect to the internet to send the reset link.")) return;

    setLoading('btn-reset', true);
    let error;
    try {
      ({ error } = await withTimeout(db.auth.resetPasswordForEmail(email, {
        redirectTo: SITE_BASE + '/reset-confirm'
      }), 15000));
    } catch (e) {
      setLoading('btn-reset', false);
      showAlert('reset-alert','reset-alert-msg', friendlyError(e), 'error');
      return;
    }
    setLoading('btn-reset', false);

    if (error) { showAlert('reset-alert','reset-alert-msg', error.message, 'error'); return; }
    document.getElementById('reset-form').style.display = 'none';
    document.getElementById('reset-success').style.display = 'block';
  }

  // ── Live listing count ──
  async function loadStat() {
    try {
      const { count } = await db.from('listings').select('*', { count:'exact', head:true }).eq('status','active');
      const el = document.getElementById('stat-total');
      if (el) el.textContent = count || '0';
    } catch (e) { /* non-fatal decorative stat */ }
  }
  loadStat();

  // ── One shared Google-button template for both panels (was duplicated ──
  // ── markup before; now a single source, so re-enabling it later is a  ──
  // ── one-line change instead of two). ──
  function googleButtonHtml() {
    return `<button type="button" class="btn-google" onclick="signInWithGoogle()">
        <svg viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l6-6C34 5.5 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13 24 13c3.1 0 5.8 1.1 8 3l6-6C34 5.5 29.3 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.6 2.4-7.2 2.4-5.2 0-9.6-3.3-11.2-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.2 4.3-4.1 5.6l6.2 5.2C40.9 36 44 30.5 44 24c0-1.3-.1-2.6-.4-3.5z"/></svg>
        Continue with Google
      </button>
      <div class="divider">or</div>`;
  }
  document.getElementById('google-slot-login').innerHTML = googleButtonHtml();
  document.getElementById('google-slot-register').innerHTML = googleButtonHtml();

  // ── Check URL for ?tab=register (e.g. from homepage CTA) ──
  const tabParam = urlParams.get('tab');
  if (tabParam === 'register') switchTab('register');

  // ── Arrived here after post-listing detected an existing account ──
  if (arrivalReason === 'existing_account') {
    if (arrivalEmail) document.getElementById('login-email').value = decodeURIComponent(arrivalEmail);
    showAlert('login-alert', 'login-alert-msg',
      'Good news — you already have a Nyumba254 account with this email. Your listing details are saved, so just sign in below to pick up right where you left off.',
      'success');
    document.getElementById('login-password')?.focus();
  }
</script>
<script src="nk-quick-help-widget.js" defer></script>
