<body>

<div id="session-check" role="status" aria-live="polite" aria-label="Checking your session"><div class="spinner"></div></div>

<div class="netbar" id="netbar" role="status" aria-live="polite"><span id="netbar-t"></span><button type="button" id="netbar-retry">Retry</button></div>

<!-- ── NAVBAR ── -->
<nav>
  <a href="index.html" class="logo">
    <div class="logo-icon">
      <img src="/logo-icon.png" alt="Nyumba254"/>
    </div>
    Nyumba254
  </a>
  <div class="nav-right">
    <span class="nav-right-full">Looking to buy or rent? </span><a href="listings.html"><span class="nav-right-full">Browse listings</span><span class="nav-right-short">Browse</span> →</a>
  </div>
</nav>

<div class="page">

  <!-- ── LEFT PANEL ── -->
  <div class="left-panel">
    <div class="left-eyebrow">Kisumu · Nairobi · Mombasa</div>
    <h2>List your property,<br>reach <span>real buyers</span></h2>
    <p>No agents. No commission. Just your listing in front of thousands of people searching for apartments, shops, and offices across Kenya.</p>

    <div class="benefits">
      <div class="benefit">
        <div class="benefit-icon">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="benefit-text">
          <strong>Your listing, your control</strong>
          <span>Edit, pause, or remove your listing anytime from your dashboard.</span>
        </div>
      </div>
      <div class="benefit">
        <div class="benefit-icon">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="benefit-text">
          <strong>Live in under 10 minutes</strong>
          <span>Fill the form, upload photos, pay via M-Pesa — live immediately.</span>
        </div>
      </div>
      <div class="benefit">
        <div class="benefit-icon">
          <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        </div>
        <div class="benefit-text">
          <strong>Buyers contact you directly</strong>
          <span>Enquiries go straight to your phone — no middleman, no delays.</span>
        </div>
      </div>
      <div class="benefit">
        <div class="benefit-icon">
          <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
        </div>
        <div class="benefit-text">
          <strong>Pay easily via M-Pesa</strong>
          <span>KES 800 standard or KES 2,500 featured — STK Push to your phone.</span>
        </div>
      </div>
    </div>

    <div class="left-stats">
      <div><div class="left-stat-val" id="stat-total">—</div><div class="left-stat-lbl">Active listings</div></div>
      <div><div class="left-stat-val">47</div><div class="left-stat-lbl">Counties covered</div></div>
      <div><div class="left-stat-val">0%</div><div class="left-stat-lbl">Agent fee</div></div>
    </div>
  </div>

  <!-- ── RIGHT PANEL ── -->
  <div class="right-panel">
    <div class="auth-card">

      <!-- Tabs -->
      <div class="auth-tabs" role="tablist" aria-label="Account access">
        <button class="auth-tab active" id="tab-login" role="tab" aria-selected="true" aria-controls="panel-login" onclick="switchTab('login')">Sign in</button>
        <button class="auth-tab" id="tab-register" role="tab" aria-selected="false" aria-controls="panel-register" onclick="switchTab('register')">Create account</button>
      </div>

      <!-- ════════════════════════════ -->
      <!-- LOGIN                        -->
      <!-- ════════════════════════════ -->
      <div id="panel-login" class="active" role="tabpanel" aria-labelledby="tab-login">
        <div class="trust-strip">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Your data is encrypted and never sold or shared. See our <a href="privacy.html">Privacy Policy</a>.</span>
        </div>
        <h1 class="auth-title" id="login-title" tabindex="-1">Welcome back</h1>
        <p class="auth-sub">Sign in to manage your listings and enquiries.</p>

        <div class="alert" id="login-alert" role="alert" aria-live="assertive">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
