<script>
  const SUPABASE_URL = 'https://vliuuloyfhyxcsuchpss.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_oIIcecf3wzKMual5K24Z8Q_zmxVfgsx';
  const { createClient } = supabase;

  // ── "Remember me" storage adapter ──
  // Checked -> session persists in localStorage (survives closing the browser).
  // Unchecked -> session lives in sessionStorage (cleared when the tab closes).
  const authStorage = {
    getItem: (key) => (localStorage.getItem('ny_remember') === '0' ? sessionStorage : localStorage).getItem(key),
    setItem: (key, value) => (localStorage.getItem('ny_remember') === '0' ? sessionStorage : localStorage).setItem(key, value),
    removeItem: (key) => { localStorage.removeItem(key); sessionStorage.removeItem(key); }
  };

  const db = createClient(SUPABASE_URL, SUPABASE_KEY, {
    auth: { storage: authStorage, persistSession: true, autoRefreshToken: true }
  });

  // ── Production site base — used for ALL auth email redirects so links ──
  // ── always work no matter where signup/reset was triggered from       ──
  const SITE_BASE = 'https://nyumba254.com';

  // ── Redirect destination ──
  // If user came from post-listing page, send them back after login
  const redirectTo = new URLSearchParams(window.location.search).get('next') || '/dashboard';

  // ── If already logged in, redirect immediately; otherwise reveal the form ──
  db.auth.getSession().then(({ data }) => {
    if (data.session) {
      window.location.href = redirectTo;
    } else {
      document.getElementById('session-check').style.display = 'none';
    }
  });

  // ── Tab switching ──
  function switchTab(tab) {
    ['login','register'].forEach(t => {
      document.getElementById('tab-' + t).classList.toggle('active', t === tab);
    });
    switchPanel(tab);
  }

  function switchPanel(panel) {
    ['login','register','reset'].forEach(p => {
      const el = document.getElementById('panel-' + p);
      if (el) el.classList.remove('active');
    });
    document.getElementById('panel-' + panel)?.classList.add('active');
    clearAllErrors();
  }

  // ── Error helpers ──
  function clearAllErrors() {
    document.querySelectorAll('.alert').forEach(a => { a.className = 'alert'; });
    document.querySelectorAll('.field-error').forEach(e => e.classList.remove('show'));
    document.querySelectorAll('input.error').forEach(i => i.classList.remove('error'));
  }

  function showAlert(alertId, msgId, message, type) {
    const el = document.getElementById(alertId);
    el.className = 'alert ' + type;
    document.getElementById(msgId).textContent = message;
  }

  function fieldError(inputId, errId, show) {
    document.getElementById(inputId)?.classList.toggle('error', show);
    document.getElementById(errId)?.classList.toggle('show', show);
  }

  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    btn.disabled = loading;
    btn.classList.toggle('loading', loading);
  }

  // ── Phone formatter ──
  function formatPhone(input) {
    let v = input.value.replace(/\D/g, '').slice(0, 12);
    // Format as 07XX XXX XXX or +254 7XX XXX XXX
    if (v.startsWith('254')) v = '0' + v.slice(3);
    if (v.length > 4 && v.length <= 7) v = v.slice(0,4) + ' ' + v.slice(4);
    else if (v.length > 7) v = v.slice(0,4) + ' ' + v.slice(4,7) + ' ' + v.slice(7);
    input.value = v;
  }

  // ── Password visibility toggle ──
  function togglePw(inputId, btn) {
    const input = document.getElementById(inputId);
    const show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    btn.innerHTML = show
      ? `<svg viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`
      : `<svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
  }

  // ── Password strength ──
  function checkPwStrength(pw) {
    const fill = document.getElementById('pw-fill');
    const label = document.getElementById('pw-label');
    if (!pw) { fill.style.width = '0'; label.textContent = ''; return; }
    let score = 0;
    if (pw.length >= 8) score++;
    if (/[A-Z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    if (/[^A-Za-z0-9]/.test(pw)) score++;
    const levels = [
      { w:'25%', c:'#e74c3c', t:'Weak — add numbers or symbols' },
      { w:'50%', c:'#e67e22', t:'Fair — try a longer password' },
      { w:'75%', c:'#f39c12', t:'Good' },
      { w:'100%', c:'#27ae60', t:'Strong ✓' },
    ];
    const l = levels[Math.max(score-1,0)];
    fill.style.width = l.w; fill.style.background = l.c;
    label.textContent = l.t; label.style.color = l.c;
  }

  const isEmail = v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  const isPhone = v => v.replace(/\s/g,'').length >= 9;

  // ── LOGIN ──
  let loginFailCount = 0;
  async function doLogin() {
    clearAllErrors();
    const email = document.getElementById('login-email').value.trim();
    const pw    = document.getElementById('login-password').value;
    let ok = true;
    if (!isEmail(email)) { fieldError('login-email','err-login-email',true); ok=false; }
    if (!pw) { fieldError('login-password','err-login-pw',true); ok=false; }
    if (!ok) return;

    const remember = document.getElementById('login-remember').checked;
    localStorage.setItem('ny_remember', remember ? '1' : '0');

    setLoading('btn-login', true);
    const { error } = await db.auth.signInWithPassword({ email, password: pw });
    setLoading('btn-login', false);

    if (error) {
      if (error.message.includes('Email not confirmed')) {
        showAlert('login-alert','login-alert-msg',
          'Please verify your email first — check your inbox.', 'error');
        showResendLink(email);
        return;
      }
      if (error.message.includes('Invalid login credentials')) {
        loginFailCount++;
        if (loginFailCount >= 3) {
          showAlert('login-alert','login-alert-msg',
            "Still not working? Double-check your email, or reset your password below.", 'error');
        } else {
          showAlert('login-alert','login-alert-msg',
            'Email or password is incorrect. Please try again.', 'error');
        }
      } else {
        showAlert('login-alert','login-alert-msg', error.message, 'error');
      }
      return;
    }
    window.location.href = redirectTo;
  }

  // ── Google OAuth ──
  async function signInWithGoogle() {
    const { error } = await db.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: SITE_BASE + redirectTo }
    });
    if (error) {
      showAlert('login-alert','login-alert-msg', error.message, 'error');
    }
  }

  // ── Show a "resend verification email" link under the login alert ──
  function showResendLink(email) {
    const alertEl = document.getElementById('login-alert');
    // Avoid adding multiple resend links if user clicks login twice
    if (document.getElementById('resend-link')) return;
    const link = document.createElement('a');
    link.id = 'resend-link';
    link.href = '#';
    link.style.cssText = 'display:block;margin-top:6px;font-weight:600;text-decoration:underline;color:inherit';
    link.textContent = 'Resend verification email';
    link.onclick = async (e) => {
      e.preventDefault();
      link.textContent = 'Sending…';
      const { error } = await db.auth.resend({
        type: 'signup',
        email: email,
        options: { emailRedirectTo: SITE_BASE + '/verify-email' }
      });
      if (error) {
        link.textContent = error.message.includes('rate limit') || error.message.includes('after')
          ? 'Please wait a minute before requesting again'
          : 'Could not resend — try again shortly';
      } else {
        link.textContent = '✓ Verification email sent — check your inbox';
        link.style.pointerEvents = 'none';
      }
    };
    alertEl.appendChild(link);
  }

  // ── Consent checkbox helpers ──
  function clearConsentError() {
    document.getElementById('consent-box').classList.remove('error');
    document.getElementById('err-consent').classList.remove('show');
  }

  // ── REGISTER ──
  async function doRegister() {
    clearAllErrors();
    clearConsentError();
    const first   = document.getElementById('reg-firstname').value.trim();
    const last    = document.getElementById('reg-lastname').value.trim();
    const email   = document.getElementById('reg-email').value.trim();
    const phone   = document.getElementById('reg-phone').value.trim();
    const pw      = document.getElementById('reg-password').value;
    const consent = document.getElementById('reg-consent').checked;
    let ok = true;

    if (!first)        { fieldError('reg-firstname','err-firstname',true); ok=false; }
    if (!last)         { fieldError('reg-lastname','err-lastname',true); ok=false; }
    if (!isEmail(email)){ fieldError('reg-email','err-reg-email',true); ok=false; }
    if (!isPhone(phone)){ fieldError('reg-phone','err-phone',true); ok=false; }
    if (pw.length < 8) { fieldError('reg-password','err-reg-pw',true); ok=false; }
    if (!consent) {
      document.getElementById('consent-box').classList.add('error');
      document.getElementById('err-consent').classList.add('show');
      ok = false;
    }
    if (!ok) return;

    setLoading('btn-register', true);
    const { data, error } = await db.auth.signUp({
      email, password: pw,
      options: {
        data: { full_name: `${first} ${last}`, phone },
        emailRedirectTo: SITE_BASE + '/verify-email'
      }
    });
    setLoading('btn-register', false);

    if (error) {
      showAlert('register-alert','register-alert-msg',
        error.message.includes('already registered')
          ? 'An account with this email already exists. Try signing in instead.'
          : error.message,
        'error');
      return;
    }

    // ── Supabase anti-enumeration quirk ──
    // With "Confirm email" on, signUp() does NOT return an error for an
    // already-registered + already-confirmed email. Instead it returns a
    // fake success with data.user present but an EMPTY identities array.
    // No new confirmation email is actually sent in this case.
    if (data.user && Array.isArray(data.user.identities) && data.user.identities.length === 0) {
      showAlert('register-alert','register-alert-msg',
        'An account with this email already exists. Try signing in instead.',
        'error');
      return;
    }

    // Save to profiles table
    if (data.user) {
      await db.from('profiles').upsert({
        id: data.user.id,
        full_name: `${first} ${last}`,
        phone, email
      });
    }

    // Notify admin of the new seller registration
    fetch(`${SUPABASE_URL}/functions/v1/send-notification-email`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` },
      body: JSON.stringify({
        type: 'new_seller_registered',
        audience: 'admin',
        sellerName: `${first} ${last}`,
        sellerEmail: email,
        sellerPhone: phone,
      }),
    }).catch(()=>{});

    // Remember email so the "resend" link on the success screen works
    window.lastRegEmail = email;

    // Hide form, show success
    document.querySelector('#panel-register .auth-title').style.display = 'none';
    document.querySelector('#panel-register .auth-sub').style.display = 'none';
    document.querySelector('#panel-register #register-alert').style.display = 'none';
    document.querySelectorAll('#panel-register .form-row, #panel-register .form-group, #panel-register .btn-submit, #panel-register .terms, #panel-register p.auth-sub, #panel-register .consent-box, #panel-register .btn-google, #panel-register .divider').forEach(el => el.style.display='none');
    document.getElementById('register-success').style.display = 'block';
  }

  // ── Resend verification email from the success screen ──
  async function resendFromSuccess() {
    const link = document.getElementById('resend-success-link');
    if (!window.lastRegEmail) return;
    link.textContent = 'Sending…';
    const { error } = await db.auth.resend({
      type: 'signup',
      email: window.lastRegEmail,
      options: { emailRedirectTo: SITE_BASE + '/verify-email' }
    });
    link.textContent = error
      ? (error.message.includes('rate limit') || error.message.includes('after')
          ? 'Please wait a minute, then try again'
          : 'Could not resend — try again shortly')
      : '✓ Sent! Check your inbox (and spam folder)';
    link.style.pointerEvents = 'none';
  }

  // ── PASSWORD RESET ──
  async function doReset() {
    clearAllErrors();
    const email = document.getElementById('reset-email').value.trim();
    if (!isEmail(email)) { fieldError('reset-email','err-reset-email',true); return; }

    setLoading('btn-reset', true);
    const { error } = await db.auth.resetPasswordForEmail(email, {
      redirectTo: SITE_BASE + '/reset-confirm'
    });
    setLoading('btn-reset', false);

    if (error) { showAlert('reset-alert','reset-alert-msg', error.message, 'error'); return; }
    document.getElementById('reset-form').style.display = 'none';
    document.getElementById('reset-success').style.display = 'block';
  }

  // ── Live listing count ──
  async function loadStat() {
    const { count } = await db.from('listings').select('*', { count:'exact', head:true }).eq('status','active');
    const el = document.getElementById('stat-total');
    if (el) el.textContent = count || '0';
  }
  loadStat();

  // ── Enter key support ──
  document.addEventListener('keydown', e => {
    if (e.key !== 'Enter' || e.target.tagName === 'BUTTON') return;
    const panels = { 'panel-login': doLogin, 'panel-register': doRegister, 'panel-reset': doReset };
    for (const [id, fn] of Object.entries(panels)) {
      if (document.getElementById(id)?.classList.contains('active')) { fn(); break; }
    }
  });

  // ── Check URL for ?tab=register (e.g. from homepage CTA) ──
  const tabParam = new URLSearchParams(window.location.search).get('tab');
  if (tabParam === 'register') switchTab('register');
</script>
<script src="nk-quick-help-widget.js" defer></script>
</body>
