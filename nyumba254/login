<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sign in — Nyumba254</title>
  <meta name="description" content="Sign in or create a seller account on Nyumba254 to list your apartment, shop, or office anywhere in Kenya."/>
  <meta name="robots" content="noindex,follow"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet"/>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green:       #0F6E56;
      --green-light: #E1F5EE;
      --green-mid:   #1D9E75;
      --green-dark:  #085041;
      --text:        #1a1a18;
      --text-2:      #4a4a46;
      --text-3:      #888780;
      --border:      #e0ded8;
      --surface:     #f7f6f2;
      --white:       #ffffff;
      --red:         #c0392b;
      --red-light:   #fdecea;
      --amber:       #7a4f00;
      --amber-bg:    #FFF7E6;
      --amber-border:#F3D9A0;
      --radius:      10px;
      --radius-lg:   16px;
    }
    html { scroll-behavior: smooth; height: 100%; }
    body {
      font-family: 'Inter', sans-serif; color: var(--text);
      background: var(--surface); font-size: 15px; line-height: 1.6;
      min-height: 100vh; display: flex; flex-direction: column;
    }
    a { text-decoration: none; color: inherit; }
    button { font-family: inherit; cursor: pointer; border: none; }

    /* ── Offline banner ── */
    .netbar {
      display: none; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
      background: var(--amber-bg); border-bottom: 1px solid var(--amber-border); color: var(--amber);
      font-size: 13px; font-weight: 500; padding: 8px 16px; text-align: center;
    }
    .netbar.show { display: flex; }
    .netbar.ok { background: var(--green-light); border-color: #9FE1CB; color: var(--green-dark); }
    .netbar button { border: 1px solid currentColor; border-radius: 20px; min-height: 32px; padding: 0 14px; font-weight: 600; font-size: 12.5px; background: transparent; color: inherit; }
    .netbar.ok button { display: none; }

    /* ── Navbar ── */
    nav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 32px; height: 64px;
      background: var(--white); border-bottom: 1px solid var(--border); flex-shrink: 0;
      gap: 12px;
    }
    .logo { display: flex; align-items: center; gap: 10px; font-family: 'Playfair Display', serif; font-size: 20px; color: var(--green-dark); flex-shrink: 0; white-space: nowrap; }
    .logo-icon { width:auto; height:40px; background:transparent; border-radius:0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .logo-icon svg { width: 18px; height: 18px; fill: none; stroke: white; stroke-width: 2; stroke-linecap: round; }
    .logo-icon img { width:auto; height:100%; aspect-ratio:1/1; object-fit:cover; display:block; border-radius:22%; box-shadow:0 0 0 1px rgba(0,0,0,.08); }
    .nav-right { font-size: 14px; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nav-right a { color: var(--green); font-weight: 500; white-space: nowrap; }
    .nav-right a:hover { text-decoration: underline; }
    .nav-right .nav-right-full { display: inline; }
    .nav-right .nav-right-short { display: none; }

    /* ── Layout ── */
    .page { flex: 1; display: grid; grid-template-columns: 1fr 1fr; min-height: calc(100vh - 64px); }

    /* ── Left panel ── */
    .left-panel {
      background: var(--green-dark); padding: 64px 56px;
      display: flex; flex-direction: column; justify-content: center;
      position: relative; overflow: hidden;
    }
    .left-panel::before {
      content: ''; position: absolute; inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .left-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.1); color: #9FE1CB;
      font-size: 12px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase;
      padding: 5px 14px; border-radius: 20px; margin-bottom: 28px; width: fit-content; position: relative;
    }
    .left-eyebrow::before {
      content: ''; width: 6px; height: 6px; background: #5DCAA5; border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.8)} }
    .left-panel h2 {
      font-family: 'Playfair Display', serif; font-size: clamp(28px,3vw,40px);
      color: white; line-height: 1.2; margin-bottom: 20px; position: relative;
    }
    .left-panel h2 span { color: #5DCAA5; }
    .left-panel > p { font-size: 15px; color: rgba(255,255,255,0.6); margin-bottom: 40px; max-width: 340px; position: relative; }

    .benefits { display: flex; flex-direction: column; gap: 20px; position: relative; }
    .benefit { display: flex; align-items: flex-start; gap: 14px; }
    .benefit-icon {
      width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.08);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px;
    }
    .benefit-icon svg { width: 18px; height: 18px; stroke: #5DCAA5; fill: none; stroke-width: 2; stroke-linecap: round; }
    .benefit-text strong { display: block; font-size: 14px; font-weight: 600; color: white; margin-bottom: 2px; }
    .benefit-text span { font-size: 13px; color: rgba(255,255,255,0.5); }

    .left-stats {
      display: flex; gap: 28px; margin-top: 48px;
      padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.1); position: relative;
    }
    .left-stat-val { font-size: 20px; font-weight: 700; color: white; }
    .left-stat-lbl { font-size: 12px; color: rgba(255,255,255,0.45); margin-top: 2px; }

    /* ── Right panel ── */
    .right-panel { display: flex; align-items: center; justify-content: center; padding: 48px 40px; background: var(--white); }
    .auth-card { width: 100%; max-width: 420px; }

    /* Tabs */
    .auth-tabs {
      display: flex; background: var(--surface); border-radius: var(--radius);
      padding: 4px; margin-bottom: 32px;
    }
    .auth-tab {
      flex: 1; text-align: center; padding: 9px 16px; font-size: 14px; font-weight: 500;
      color: var(--text-3); border-radius: 7px; cursor: pointer; transition: all .15s; background: transparent;
    }
    .auth-tab.active { background: var(--white); color: var(--text); box-shadow: 0 1px 4px rgba(0,0,0,0.1); }

    /* Form */
    .auth-title { font-family: 'Playfair Display', serif; font-size: 24px; color: var(--text); margin-bottom: 6px; }
    .auth-title:focus { outline: none; }
    .auth-sub { font-size: 14px; color: var(--text-3); margin-bottom: 28px; }

    .form-group { margin-bottom: 16px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    label.field-label {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 13px; font-weight: 500; color: var(--text-2); margin-bottom: 6px;
    }
    label.field-label .opt { font-weight: 400; font-size: 11px; color: var(--text-3); }

    .input-wrap { position: relative; }
    .input-wrap .icon {
      position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
      width: 16px; height: 16px; stroke: var(--text-3); fill: none; stroke-width: 2;
      pointer-events: none; transition: stroke .15s;
    }
    .input-wrap:focus-within .icon { stroke: var(--green); }

    .input-wrap input {
      width: 100%; padding: 11px 14px 11px 40px;
      border: 1.5px solid var(--border); border-radius: var(--radius);
      font-family: inherit; font-size: 14px; color: var(--text);
      background: var(--white); outline: none; transition: border-color .15s, box-shadow .15s;
    }
    .input-wrap input:focus { border-color: var(--green); box-shadow: 0 0 0 3px rgba(15,110,86,0.08); }
    .input-wrap input.error { border-color: var(--red); }
    .input-wrap input.error:focus { box-shadow: 0 0 0 3px rgba(192,57,43,0.08); }

    .field-error { font-size: 12px; color: var(--red); margin-top: 5px; display: none; }
    .field-error.show { display: block; }

    /* Password toggle */
    .pw-toggle {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; padding: 4px; color: var(--text-3); border-radius: 4px;
      transition: color .15s;
    }
    .pw-toggle:hover { color: var(--text); }
    .pw-toggle svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; display: block; }
    .input-wrap input:has(+ .pw-toggle) { padding-right: 40px; }

    /* Password strength */
    .pw-strength { margin-top: 6px; }
    .pw-strength-bar { height: 3px; border-radius: 2px; background: var(--border); overflow: hidden; margin-bottom: 4px; }
    .pw-strength-fill { height: 100%; border-radius: 2px; transition: width .3s, background .3s; width: 0%; }
    .pw-strength-label { font-size: 11px; color: var(--text-3); }

    /* Alert banner */
    .alert {
      display: none; align-items: flex-start; gap: 10px;
      padding: 12px 14px; border-radius: var(--radius); font-size: 13px; margin-bottom: 18px;
    }
    .alert.error { display: flex; background: var(--red-light); color: var(--red); border: 1px solid #f5c6c2; }
    .alert.success { display: flex; background: var(--green-light); color: var(--green-dark); border: 1px solid #9FE1CB; }
    .alert svg { width: 16px; height: 16px; flex-shrink: 0; margin-top: 1px; fill: none; stroke: currentColor; stroke-width: 2; }

    /* Remember + forgot row */
    .remember-row {
      display: flex; align-items: center; justify-content: space-between;
      margin-top: -8px; margin-bottom: 16px;
    }
    .remember-label { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-2); cursor: pointer; }
    .remember-label input[type="checkbox"] { width: 15px; height: 15px; accent-color: var(--green); cursor: pointer; }
    .remember-row a { font-size: 13px; color: var(--green); font-weight: 500; }
    .remember-row a:hover { text-decoration: underline; }

    /* Submit */
    .btn-submit {
      width: 100%; padding: 13px; background: var(--green); color: white;
      font-size: 15px; font-weight: 600; border-radius: var(--radius);
      transition: background .15s; display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn-submit:hover:not(:disabled) { background: var(--green-dark); }
    .btn-submit:disabled { opacity: .65; cursor: not-allowed; }
    .spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin .7s linear infinite; display: none; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .btn-submit.loading .spinner { display: block; }
    .btn-submit.loading .btn-text { display: none; }

    /* Google button */
    .btn-google {
      width: 100%; padding: 12px; background: var(--white); color: var(--text);
      font-size: 14px; font-weight: 600; border-radius: var(--radius);
      border: 1.5px solid var(--border); transition: background .15s, border-color .15s;
      display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .btn-google:hover { background: var(--surface); border-color: #c9c7bf; }
    .btn-google svg { width: 18px; height: 18px; flex-shrink: 0; }

    /* Divider */
    .divider { display: flex; align-items: center; gap: 12px; margin: 20px 0; color: var(--text-3); font-size: 13px; }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .terms { font-size: 12px; color: var(--text-3); text-align: center; margin-top: 14px; line-height: 1.7; }
    .terms a { color: var(--green); }
    .terms a:hover { text-decoration: underline; }

    .secure-note {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      font-size: 11.5px; color: var(--text-3); margin-top: 10px;
    }
    .secure-note svg { width: 12px; height: 12px; stroke: var(--text-3); fill: none; stroke-width: 2; }

    /* Consent checkbox */
    .consent-box {
      background: var(--surface); border: 1.5px solid var(--border);
      border-radius: var(--radius); padding: 14px 16px; margin-bottom: 18px;
      transition: border-color .15s, background .15s;
    }
    .consent-box.error { border-color: var(--red); background: var(--red-light); }
    .consent-label { display: flex; align-items: flex-start; gap: 10px; cursor: pointer; }
    .consent-label input[type="checkbox"] {
      width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px;
      accent-color: var(--green); cursor: pointer;
    }
    .consent-text { font-size: 13px; color: var(--text-2); line-height: 1.6; }
    .consent-text a { color: var(--green); font-weight: 600; text-decoration: underline; }
    .consent-text a:hover { color: var(--green-dark); }
    .consent-box #err-consent { margin-top: 8px; margin-bottom: 0; }

    /* Trust strip */
    .trust-strip {
      display: flex; align-items: center; gap: 10px;
      background: var(--green-light); border: 1px solid #cdeee1;
      border-radius: var(--radius); padding: 12px 14px; margin-bottom: 24px;
    }
    .trust-strip svg { width: 20px; height: 20px; stroke: var(--green-dark); fill: none; stroke-width: 2; flex-shrink: 0; }
    .trust-strip span { font-size: 12.5px; color: var(--green-dark); line-height: 1.5; }
    .trust-strip a { color: var(--green-dark); font-weight: 600; text-decoration: underline; }

    /* Spam note on success screens */
    .spam-note {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 12px 14px; margin-bottom: 18px;
      font-size: 12.5px; color: var(--text-2); line-height: 1.6; text-align: left;
    }
    .spam-note strong { color: var(--text); }
    .spam-note a { color: var(--green); font-weight: 600; cursor: pointer; }
    .spam-note a:hover { text-decoration: underline; }

    /* Phone hint */
    .phone-note { font-size: 12px; color: var(--text-3); margin-top: 5px; }

    /* Panels */
    #panel-login, #panel-register, #panel-reset { display: none; }
    #panel-login.active, #panel-register.active, #panel-reset.active { display: block; }

    /* Reset back link */
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; color: var(--green); font-weight: 500;
      margin-bottom: 20px; cursor: pointer;
    }
    .back-link:hover { text-decoration: underline; }
    .back-link svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2.5; }

    /* Success screens */
    .success-screen { text-align: center; padding: 16px 0; display: none; }
    .success-icon { width: 64px; height: 64px; background: var(--green-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
    .success-icon svg { width: 28px; height: 28px; stroke: var(--green); fill: none; stroke-width: 2.5; }
    .success-screen h3 { font-family: 'Playfair Display', serif; font-size: 22px; margin-bottom: 8px; }
    .success-screen p { font-size: 14px; color: var(--text-3); margin-bottom: 24px; line-height: 1.6; }
    .btn-green {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--green); color: white; padding: 12px 28px;
      border-radius: var(--radius); font-size: 14px; font-weight: 600; transition: background .15s;
    }
    .btn-green:hover { background: var(--green-dark); }

    /* Session check overlay */
    #session-check {
      position: fixed; inset: 0; background: var(--white);
      display: flex; align-items: center; justify-content: center; z-index: 999;
    }
    #session-check .spinner {
      display: block; width: 28px; height: 28px;
      border: 3px solid var(--border); border-top-color: var(--green);
      border-radius: 50%; animation: spin .7s linear infinite;
    }

    /* Responsive */
    @media (max-width: 900px) {
      .page { grid-template-columns: 1fr; }
      .left-panel { display: none; }
      .right-panel { padding: 40px 24px; }
      nav { padding: 0 16px; }
    }
    @media (max-width: 480px) {
      .form-row { grid-template-columns: 1fr; gap: 0; }
      .right-panel { padding: 28px 16px; }
    }
    @media (max-width: 420px) {
      nav { padding: 0 14px; height: 56px; }
      .logo { font-size: 17px; gap: 6px; }
      .logo-icon { width:auto; height:40px; }
      .nav-right .nav-right-full { display: none; }
      .nav-right .nav-right-short { display: inline; }
      .nav-right { font-size: 13px; }
    }
  </style>
  <link rel="stylesheet" href="/theme.css"/>
  <script src="/theme.js"></script>
