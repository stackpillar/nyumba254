<!-- ═══ 1. PAGE CHROME: no dependency on Supabase or nk-shared.js, so menu / slideshow / footer still work if either is blocked ═══ -->
<script>
(function () {
'use strict';
const $ = id => document.getElementById(id);
const qsa = (s, r) => Array.from((r || document).querySelectorAll(s));
const debounce = (fn, ms) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };

/* toast */
let toastT;
function toast(msg, kind) {
  const t = $('toast'); if (!t) return;
  t.textContent = msg; t.className = 'toast show' + (kind === 'error' ? ' error' : '');
  clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('show'), 3500);
}

/* mobile menu: aria state, Escape, outside click, scroll lock */
const mBtn = $('mobile-menu-btn'), mNav = $('mobile-nav');
function setMenu(open) {
  mNav.classList.toggle('open', open);
  mBtn.setAttribute('aria-expanded', String(open));
  mBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  document.body.style.overflow = open ? 'hidden' : '';
}
mBtn.addEventListener('click', () => setMenu(!mNav.classList.contains('open')));
document.addEventListener('click', e => { if (mNav.classList.contains('open') && !mNav.contains(e.target) && !mBtn.contains(e.target)) setMenu(false); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && mNav.classList.contains('open')) { setMenu(false); mBtn.focus(); } });
matchMedia('(min-width: 769px)').addEventListener('change', e => { if (e.matches) setMenu(false); });

/* copy email */
document.addEventListener('click', e => {
  const b = e.target.closest('[data-copy]'); if (!b) return;
  (navigator.clipboard ? navigator.clipboard.writeText(b.dataset.copy) : Promise.reject())
    .then(() => toast('Email address copied'), () => toast('Could not copy. Please select the address manually.', 'error'));
});

/* footer year */
$('footer-year').textContent = new Date().getFullYear();

/* timeline: shows "June 2025 · The idea" once a datetime="YYYY-MM" is filled in; otherwise leaves the phase name alone */
qsa('time.timeline-year').forEach(t => {
  const v = (t.getAttribute('datetime') || '').trim();
  if (!/^\d{4}-\d{2}(-\d{2})?$/.test(v)) return;
  const d = new Date((v.length === 7 ? v + '-01' : v) + 'T00:00:00');
  if (!isNaN(d)) t.textContent = d.toLocaleDateString('en-KE', { month: 'long', year: 'numeric' }) + ' · ' + (t.dataset.phase || '');
});

/* decorative skyline (aria-hidden) */
(function skyline() {
  const B = [[48, 60, '1011'], [64, 90, '011011'], [80, 110, '11011110'], [100, 118, '11111111', 1], [72, 100, '101101'], [56, 72, '1101'], [44, 52, '0110']];
  $('skyline').innerHTML = B.map(([w, h, p, acc]) =>
    `<div class="hero-building${acc ? ' accent' : ''}" style="width:${w}px;height:${h}px"><div class="hero-building-win">${p.split('').map(c => `<span${c === '1' ? ' class="lit"' : ''}></span>`).join('')}</div></div>`).join('');
})();

/* hero slideshow: slide 1 is in the HTML; the rest are fetched only after page load, one step ahead.
   Off entirely for Data Saver, reduced motion and hidden tabs. */
(function slideshow() {
  const slides = qsa('.hero-slide');
  if (slides.length < 2) return;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let cur = 0, timer = null, ready = false;
  const saver = () => document.body.classList.contains('nk-datasaver');
  const load = i => { const s = slides[i % slides.length]; if (s && !s.getAttribute('src') && s.dataset.src) s.src = s.dataset.src; };
  function next() {
    slides[cur].classList.remove('active');
    cur = (cur + 1) % slides.length;
    slides[cur].classList.add('active');
    load(cur + 1);
  }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  function start() {
    stop();
    if (!ready || saver() || reduce.matches || document.hidden) return;
    load(cur + 1);
    timer = setInterval(next, 4500);
  }
  const arm = () => { ready = true; start(); };
  addEventListener('load', () => ('requestIdleCallback' in window ? requestIdleCallback(arm, { timeout: 2500 }) : setTimeout(arm, 1200)));
  document.addEventListener('visibilitychange', start);
  document.addEventListener('nk:datasaver', start);
  reduce.addEventListener('change', start);
})();

/* saved-count badge mirrored into the tab bar */
(function () {
  const src = $('nav-count-badge'), tgt = $('nk-tab-saved-badge');
  if (!src || !tgt) return;
  const sync = () => { const n = src.textContent.trim(); tgt.textContent = n; tgt.classList.toggle('visible', src.style.display !== 'none' && n !== '0' && n !== ''); };
  new MutationObserver(sync).observe(src, { childList: true, attributes: true, attributeFilter: ['style'] }); sync();
})();

/* measure the real tab bar height so the toast, chat widget and page padding never overlap it */
(function () {
  const tb = document.querySelector('.nk-tabbar'); if (!tb) return;
  const sync = () => document.documentElement.style.setProperty('--nk-tabbar-h', (getComputedStyle(tb).display === 'none' ? 0 : Math.ceil(tb.getBoundingClientRect().height)) + 'px');
  sync();
  if ('ResizeObserver' in window) new ResizeObserver(sync).observe(tb);
  addEventListener('resize', sync); addEventListener('load', sync);
  matchMedia('(max-width: 768px)').addEventListener('change', sync);
})();

/* keep the floating chat / help widget above the tab bar (CSS for .nk-chat-fab lives in nk-shared.css) */
(function liftChat() {
  const skip = new Set(['toast', 'main-nav', 'mobile-nav', 'nk-datasaver-banner']);
  const scan = () => Array.from(document.body.children).forEach(el => {
    if (el.classList.contains('nk-chat-fab') || skip.has(el.id) || /^(SCRIPT|MAIN|FOOTER|NAV|STYLE|LINK|A)$/.test(el.tagName) || el.classList.contains('nk-tabbar')) return;
    const cs = getComputedStyle(el);
    if (cs.position !== 'fixed' || cs.bottom === 'auto' || cs.right === 'auto') return;
    if (/chat|help|support/i.test((el.textContent + ' ' + (el.getAttribute('aria-label') || '') + ' ' + el.id + ' ' + el.className).slice(0, 400))) el.classList.add('nk-chat-fab');
  });
  scan();
  new MutationObserver(debounce(scan, 150)).observe(document.body, { childList: true });
  setTimeout(scan, 1500); setTimeout(scan, 4000);
})();
})();
</script>

<!-- ═══ 2. DATA: Supabase client, then the shared module ═══ -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/nk-shared.js"></script>
<script>
(function () {
'use strict';
const $ = id => document.getElementById(id);

/* If the Supabase CDN or nk-shared.js failed, every name it declares sits in the temporal dead zone,
   so probe inside try/catch and fall back to a static, still-usable page. */
let shared = true;
try { void db; void NK_COUNTIES; void NK_AREAS_BY_COUNTY; void nkBuildListingsUrl; void escHtml; void nkInitAccountNav; } catch (e) { shared = false; }
if (!shared) {
  $('cp-body').innerHTML = '<p class="cp-empty">Live county numbers are unavailable right now.</p>';
  $('proof-section').hidden = true;
  return;
}

/* ── shared chrome: Data Saver, account nav, page view ── */
nkInitDataSaver();
$('nk-datasaver-off').addEventListener('click', nkToggleDataSaver);
nkInitAccountNav(['nav-account-link', 'mobile-account-link']);
nkSessionPromise.then(({ data }) => { if (data && data.session) $('tab-account-link').setAttribute('href', '/dashboard'); }).catch(() => {});
nkTrackPageView();

/* ── footer counties: real links, and a non-link label where a county has no areas yet ── */
$('footer-counties').innerHTML = NK_COUNTIES.map(c => nkAreaCountFor(c) > 0
  ? `<a href="${escHtml(nkBuildListingsUrl({ county: c }))}">${escHtml(nkCountyLabel(c))}</a>`
  : `<span class="soon">${escHtml(nkCountyLabel(c))}</span>`).join('');

/* ── areas covered: computed from the shared data, never hard-coded ── */
const areaTotal = Object.values(NK_AREAS_BY_COUNTY).reduce((s, a) => s + a.length, 0);
$('stat-areas').textContent = areaTotal.toLocaleString('en-KE');

/* ═══ live stats ═══
   Preferred: one RPC, get_public_stats() (see about-stats.sql). Fallback: three light queries.
   A failed query renders "—", never "0". Result cached in sessionStorage for 10 minutes. */
const STATS_KEY = 'nk_about_stats_v1', STATS_TTL = 10 * 60 * 1000;
const num = v => { const n = Number(v); return Number.isFinite(n) ? n : null; };
function readCache() { try { const c = JSON.parse(sessionStorage.getItem(STATS_KEY)); if (c && Date.now() - c.ts < STATS_TTL) return c.d; } catch (e) {} return null; }
function writeCache(d) { try { sessionStorage.setItem(STATS_KEY, JSON.stringify({ ts: Date.now(), d })); } catch (e) {} }

function fromRpc(x) {
  const counties = Array.isArray(x.counties) ? x.counties.map(c => ({ county: c.county, count: num(c.count) })).filter(c => c.county && c.count > 0) : null;
  return { listings: num(x.active_listings), sellers: num(x.sellers), newWeek: num(x.new_this_week), counties };
}
async function fromQueries() {
  const since = new Date(Date.now() - 7 * 864e5).toISOString();
  const [tot, wk, rows] = await Promise.all([
    db.from('listings').select('id', { count: 'exact', head: true }).eq('status', 'active'),
    db.from('listings').select('id', { count: 'exact', head: true }).eq('status', 'active').gte('created_at', since),
    db.from('listings').select('county,seller_id').eq('status', 'active').limit(2000)
  ]);
  if (tot.error || tot.count == null) return null;
  const d = { listings: tot.count, sellers: null, newWeek: wk.error ? null : wk.count, counties: null };
  /* Sellers and county counts are only trustworthy when we received every row; otherwise show "—" instead of a low number.
     (The RPC has no such limit, which is why it is the recommended route.) */
  if (!rows.error && rows.data && rows.data.length === tot.count) {
    d.sellers = new Set(rows.data.map(r => r.seller_id).filter(Boolean)).size;
    const tally = {};
    rows.data.forEach(r => { if (r.county) tally[r.county] = (tally[r.county] || 0) + 1; });
    d.counties = Object.entries(tally).map(([county, count]) => ({ county, count })).sort((a, b) => b.count - a.count);
  }
  return d;
}
async function loadStats() {
  const cached = readCache(); if (cached) return cached;
  let d = null;
  try {
    const r = await db.rpc('get_public_stats');
    if (!r.error && r.data) { const x = Array.isArray(r.data) ? r.data[0] : r.data; if (x && typeof x === 'object' && num(x.active_listings) != null) d = fromRpc(x); }
  } catch (e) {}
  if (!d) { try { d = await fromQueries(); } catch (e) { d = null; } }
  if (d) writeCache(d);
  return d;
}

const setNum = (id, v) => { $(id).textContent = v == null ? '—' : Number(v).toLocaleString('en-KE'); };
function renderStats(d) {
  setNum('stat-listings', d && d.listings);
  setNum('stat-sellers', d && d.sellers);
  const note = $('stat-note');
  if (d && d.newWeek > 0) { note.innerHTML = `<strong>${d.newWeek.toLocaleString('en-KE')}</strong> new listing${d.newWeek === 1 ? '' : 's'} added in the last 7 days`; note.hidden = false; }
}

/* ── coverage panel + pills, from the same data ── */
const mapPin = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>';
function renderCounties(d) {
  const body = $('cp-body'), pills = $('area-pills');
  const live = d && d.counties && d.counties.length ? d.counties.filter(c => NK_COUNTIES.includes(c.county)) : [];
  let shown = NK_TIER1.slice();

  if (live.length) {
    const top = live.slice(0, 6), max = top[0].count;
    body.innerHTML = '<ul class="cp-list">' + top.map(c =>
      `<li><a href="${escHtml(nkBuildListingsUrl({ county: c.county }))}"><span class="cp-name">${escHtml(nkCountyLabel(c.county))}</span><span class="cp-count">${c.count.toLocaleString('en-KE')} listing${c.count === 1 ? '' : 's'}</span><span class="cp-bar" style="--w:${Math.max(4, Math.round(c.count / max * 100))}%"></span></a></li>`).join('') + '</ul>';
    shown = NK_TIER1.concat(live.map(c => c.county).filter(c => !NK_TIER1.includes(c)).slice(0, 4));
  } else {
    body.innerHTML = '<p class="cp-empty">Live county numbers are unavailable right now. Start with our busiest counties:</p><ul class="cp-list">' +
      NK_TIER1.map(c => `<li><a href="${escHtml(nkBuildListingsUrl({ county: c }))}"><span class="cp-name">${escHtml(nkCountyLabel(c))}</span></a></li>`).join('') + '</ul>';
  }
  const rest = NK_COUNTIES.length - shown.length;
  pills.innerHTML = shown.map(c => `<a class="area-pill${NK_TIER1.includes(c) ? ' tier1' : ''}" href="${escHtml(nkBuildListingsUrl({ county: c }))}">${mapPin}${escHtml(nkCountyLabel(c))}</a>`).join('') +
    `<a class="area-pill more" href="/listings">+ ${rest} more count${rest === 1 ? 'y' : 'ies'}</a>`;
}

loadStats().then(d => { renderStats(d); renderCounties(d); }).catch(() => { renderStats(null); renderCounties(null); });

/* ═══ reviews ═══
   Recent (not "best") published reviews. Honors is_anonymous, clamps ratings, truncates long comments,
   never prints a seller's name, and hides the whole section when there is nothing to show. */
const clip = (s, n) => { s = String(s).trim(); if (s.length <= n) return s; const cut = s.slice(0, n); return cut.slice(0, Math.max(cut.lastIndexOf(' '), Math.floor(n * .6))) + '…'; };
const userIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
function reviewCard(r) {
  const n = Math.min(5, Math.max(1, Math.round(Number(r.rating))));
  const named = !r.is_anonymous && String(r.reviewer_name || '').trim();
  const name = named ? String(r.reviewer_name).trim() : 'Anonymous';
  const ini = named ? name.split(/\s+/).map(w => w[0]).join('').toUpperCase().slice(0, 2) : '';
  const seller = r.review_type === 'seller';
  const when = r.created_at ? new Date(r.created_at) : null;
  const dateHtml = when && !isNaN(when) ? ` · <time datetime="${escHtml(when.toISOString())}">${escHtml(when.toLocaleDateString('en-KE', { month: 'short', year: 'numeric' }))}</time>` : '';
  const reply = r.response_text && String(r.response_text).trim() ? `<div class="proof-reply"><div class="proof-reply-label">${seller ? "Seller's reply" : "Nyumba254's reply"}</div><p class="proof-reply-text">${escHtml(clip(r.response_text, 220))}</p></div>` : '';
  return `<figure class="proof-card">
    <div class="proof-stars" role="img" aria-label="${n} out of 5 stars"><span aria-hidden="true">${'★'.repeat(n)}${'☆'.repeat(5 - n)}</span></div>
    <blockquote class="proof-quote">${escHtml(clip(r.comment, 280))}</blockquote>
    <figcaption class="proof-author"><div class="proof-avatar" aria-hidden="true">${ini ? escHtml(ini) : userIcon}</div><div><div class="proof-name">${escHtml(name)}</div><div class="proof-role">${seller ? 'Review of a seller' : 'Review of Nyumba254'}${dateHtml}</div></div></figcaption>
    ${reply}
  </figure>`;
}
async function loadReviews() {
  const sec = $('proof-section');
  try {
    const { data, error } = await db.from('reviews')
      .select('reviewer_name, is_anonymous, rating, comment, created_at, response_text, review_type')
      .in('review_type', ['platform', 'seller']).eq('status', 'published').not('comment', 'is', null)
      .order('created_at', { ascending: false }).limit(12);
    if (error) throw error;
    const rows = (data || []).filter(r => Number(r.rating) >= 1 && String(r.comment || '').trim().length >= 10).slice(0, 6);
    if (!rows.length) { sec.hidden = true; return; }
    const grid = $('proof-grid');
    grid.className = 'proof-grid' + (rows.length === 1 ? ' n1' : rows.length === 2 ? ' n2' : '');
    grid.innerHTML = rows.map(reviewCard).join('');
    sec.hidden = false;
  } catch (e) { console.error('Reviews failed to load:', e); sec.hidden = true; }
}
loadReviews();
})();
</script>
