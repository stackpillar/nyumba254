function cyclePhoto(card, id, dir) {
  const row = savedRows.find(r => r.listing_id === id); if (!row) return;
  const ph = photosOf(row.listing); if (ph.length < 2) return;
  const n = ((photoIdx[id] || 0) + dir + ph.length) % ph.length;
