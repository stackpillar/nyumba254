function moveOrder(id, dir) {
  normalizeOrder();
  const vis = currentAvailIds;
  const i = vis.indexOf(id), j = i + dir;
  if (i < 0 || j < 0 || j >= vis.length) return;
  const a = meta.order.indexOf(vis[i]), b = meta.order.indexOf(vis[j]);
  [meta.order[a], meta.order[b]] = [meta.order[b], meta.order[a]];
  saveMeta(); render();
  const card = document.querySelector('.card[data-listing-id="' + (window.CSS && CSS.escape ? CSS.escape(id) : id) + '"]');
  const btn = card && card.querySelector(dir < 0 ? '[data-act="move-up"]' : '[data-act="move-down"]');
  if (btn && !btn.disabled) btn.focus(); else if (card) { const other = card.querySelector('[data-act="move-up"]:not(:disabled),[data-act="move-down"]:not(:disabled)'); if (other) other.focus(); }
}
function dropBefore(dragged, target) {
  normalizeOrder();
  meta.order.splice(meta.order.indexOf(dragged), 1);
  meta.order.splice(meta.order.indexOf(target), 0, dragged);
  saveMeta(); render();
}

