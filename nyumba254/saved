  $('bulk-compare').disabled = n < 2 || n > 3;
  $('bulk-compare').title = n > 3 ? 'Compare works with up to 3 listings' : '';
  ['bulk-share', 'bulk-folder', 'bulk-remove'].forEach(id => { $(id).disabled = n === 0; });
  document.documentElement.style.setProperty('--nk-stack', on ? (bar.offsetHeight || 60) + 'px' : '0px');
}
function toggleSelectMode() {
  ui.select = !ui.select;
  if (!ui.select) ui.selected.clear();
  if (ui.select && ui.sort === 'manual') { ui.sort = 'saved'; }
  render();
}

/* ════════════════════════════════════════════════════════════
   REALTIME + LIVE UPDATES (item 24)
   ════════════════════════════════════════════════════════════ */
function scheduleRealtime() { clearTimeout(rtTimer); rtTimer = setTimeout(startRealtime, 600); }
function stopRealtime() { if (rt) { try { db.removeChannel(rt); } catch (e) {} rt = null; } }
function startRealtime() {
  stopRealtime();
  if (shareMode) return;
  const ids = savedRows.map(r => r.listing_id).slice(0, 50);
  if (!ids.length) return;
  try {
    rt = db.channel('saved-' + Math.random().toString(36).slice(2))
      .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'listings', filter: 'id=in.(' + ids.join(',') + ')' }, payload => onListingUpdate(payload && payload.new))
      .subscribe();
  } catch (e) { rt = null; }
}
function onListingUpdate(n) {
  if (!n || !n.id) return;
  const row = savedRows.find(r => r.listing_id === n.id); if (!row) return;
  const before = row.listing, wasAvail = isAvailable(before), oldPrice = Number(before.price);
  Object.keys(n).forEach(k => { if (!Array.isArray(n[k]) || k === 'amenities') before[k] = n[k]; });
  if (wasAvail && !isAvailable(before)) toast('"' + before.title + '" is no longer available');
  else if (Number(before.price) !== oldPrice) toast('Price changed on "' + before.title + '"');
  writeCache(); render(); renderSummary();
}

/* ════════════════════════════════════════════════════════════
   CHROME
   ════════════════════════════════════════════════════════════ */
function toggleMobileMenu() {
  const open = $('mobile-nav').classList.toggle('open');
  $('mobile-menu-btn').setAttribute('aria-expanded', String(open));
  document.body.style.overflow = open ? 'hidden' : '';
}
function nkPopulateFooterCounties() {
  $('footer-counties').innerHTML = NK_COUNTIES.map(c => nkAreaCountFor(c)
    ? `<a href="${escHtml(nkBuildListingsUrl({ county: c }))}">${escHtml(nkCountyLabel(c))}</a>` : '').join('');
}
function openClearModal() {
  const n = savedRows.length;
  $('clear-modal-title').textContent = `Clear all ${n} saved listing${n !== 1 ? 's' : ''}?`;
  $('clear-modal-text').textContent = `This removes ${n === 1 ? 'your saved listing' : 'all ' + n + ' saved listings'} from your shortlist. You can undo right after, or save them again later.`;
  nkOpenModal($('clear-modal'));
}
function closeClearModal() { nkCloseModal($('clear-modal')); }

function initTabbarMeasure() {
  const tb = document.querySelector('.nk-tabbar'); if (!tb) return;
  const sync = () => {
    const h = getComputedStyle(tb).display === 'none' ? 0 : Math.ceil(tb.getBoundingClientRect().height);
    document.documentElement.style.setProperty('--nk-tabbar-h', h + 'px');
  };
  sync();
  if ('ResizeObserver' in window) new ResizeObserver(sync).observe(tb);
  window.addEventListener('resize', sync); window.addEventListener('load', sync);
  window.matchMedia('(max-width: 768px)').addEventListener('change', sync);
}
function liftChatWidget() {
  const ours = new Set(['toast', 'clear-modal', 'edit-modal', 'folder-modal', 'share-modal', 'compare-modal', 'bulk-bar', 'main-nav', 'mobile-nav']);
  const scan = () => {
    Array.from(document.body.children).forEach(el => {
      if (el.classList.contains('nk-chat-fab') || ours.has(el.id) || el.classList.contains('nk-tabbar') || el.tagName === 'SCRIPT') return;
      const cs = getComputedStyle(el);
      if (cs.position !== 'fixed' || cs.bottom === 'auto' || cs.right === 'auto') return;
      const label = (el.textContent + ' ' + (el.getAttribute('aria-label') || '') + ' ' + el.id + ' ' + el.className).slice(0, 400);
      if (/chat/i.test(label)) el.classList.add('nk-chat-fab');
    });
  };
  scan();
  new MutationObserver(nkDebounce(scan, 150)).observe(document.body, { childList: true });
  setTimeout(scan, 1500); setTimeout(scan, 4000);
}

/* ════════════════════════════════════════════════════════════
   EVENTS
   ════════════════════════════════════════════════════════════ */
function handleAct(a, e) {
  const act = a.dataset.act, card = a.closest('.card'), id = card ? card.dataset.listingId : null;
  switch (act) {
    case 'remove': removeMany([id]); break;
    case 'share': shareListing(id); break;
    case 'edit': openEdit(id); break;
    case 'viewed': markViewed(id); break;
    case 'wa': case 'call': case 'contact': case 'similar': case 'cal': track('saved_' + act, { listing_id: id }); return;   // let the link open
    case 'photo-prev': e.preventDefault(); cyclePhoto(card, id, -1); break;
    case 'photo-next': e.preventDefault(); cyclePhoto(card, id, 1); break;
    case 'move-up': moveOrder(id, -1); break;
    case 'move-down': moveOrder(id, 1); break;
    case 'remove-unavail': removeUnavailable(); break;
    case 'retry': retryLoad(); break;
    case 'clear-filters': clearFilters(); break;
    case 'more': ui.limit += PAGE_SIZE; render(); break;
  }
}
function onViewClick(id) {
  nkTrackRecentViewed(id);
  const row = savedRows.find(r => r.listing_id === id);
  if (row && !shareMode) { const m = mi(id); m.price = Number(row.listing.price) || 0; m.freq = row.listing.price_frequency || ''; saveMeta(); }
  track('saved_open', { listing_id: id });
}

function bindEvents() {
  $('mobile-menu-btn').addEventListener('click', toggleMobileMenu);
  document.addEventListener('click', e => {
    const n = $('mobile-nav');
    if (n.classList.contains('open') && !n.contains(e.target) && !$('mobile-menu-btn').contains(e.target)) {
      n.classList.remove('open'); document.body.style.overflow = ''; $('mobile-menu-btn').setAttribute('aria-expanded', 'false');
    }
    if (e.target.classList && e.target.classList.contains('modal-overlay')) nkCloseModal(e.target);
  });
  $('sign-out-btn').addEventListener('click', doSignOut);
  $('copy-shortlist-link').addEventListener('click', async () => {
    const token = getOrCreateShortlistToken();
    if (!token) { toast('Could not generate link', 'error'); return; }
    const url = location.origin + '/saved?list=' + token;
    try {
      await navigator.clipboard.writeText(url);
      toast('Link copied to clipboard');
      track('shortlist_link_copied');
    } catch (e) {
      const ta = document.createElement('textarea');
      ta.value = url;
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); toast('Link copied'); } catch (_) { toast('Could not copy', 'error'); }
      document.body.removeChild(ta);
    }
  });
  $('email-shortlist').addEventListener('click', async () => {
    const token = getOrCreateShortlistToken();
    if (!token) { toast('Could not generate link', 'error'); return; }
    const email = prompt('Email address to send shortlist to:', currentUser?.email || '');
    if (!email) return;
    try {
      const url = location.origin + '/saved?list=' + token;
      const { error } = await db.functions.invoke('send-notification', {
        body: {
          type: 'shortlist_email_sent',
          audience: 'buyer',
          buyerEmail: email,
          buyerName: 'Buyer',
          shortlistUrl: url,
          listingCount: savedRows.length,
          listings: savedRows.slice(0, 10).map(r => ({
            title: r.listing.title,
            area: r.listing.area,
            price: r.listing.price,
          })),
        },
      });
      if (error) throw error;
      toast('Shortlist sent to ' + email);
      track('shortlist_emailed');
    } catch (e) {
      console.error('Email failed:', e);
      toast('Could not send email. Try copying the link instead.', 'error');
    }
  });
  $('theme-btn').addEventListener('click', toggleTheme);
  $('print-btn').addEventListener('click', () => { track('print'); window.print(); });
  $('share-all-btn').addEventListener('click', () => shareRows(savedRows.filter(r => isAvailable(r.listing)).length ? savedRows.filter(r => isAvailable(r.listing)) : savedRows, 'Share your shortlist'));
  $('clear-all-btn').addEventListener('click', openClearModal);
  $('clear-cancel-btn').addEventListener('click', closeClearModal);
  $('clear-confirm-btn').addEventListener('click', confirmClearAll);
  $('share-save-all').addEventListener('click', saveAllShared);
  $('stale-note').addEventListener('click', e => { if (e.target.closest('[data-act="retry"]')) retryLoad(); });

  // toolbar
  const reset = () => { ui.limit = PAGE_SIZE; render(); };
  $('f-q').addEventListener('input', nkDebounce(e => { ui.q = e.target.value.trim().toLowerCase(); reset(); }, 180));
  $('f-sort').addEventListener('change', e => { ui.sort = e.target.value; if (ui.sort === 'manual') { ui.select = false; ui.selected.clear(); toast('Drag cards, or use the Earlier and Later buttons, to reorder.'); } reset(); });
  $('f-cat').addEventListener('change', e => { ui.cat = e.target.value; reset(); });
  $('f-county').addEventListener('change', e => { ui.county = e.target.value; reset(); });
  $('f-avail').addEventListener('change', e => { ui.avail = e.target.value; reset(); });
  $('f-status').addEventListener('change', e => { ui.status = e.target.value; reset(); });
  $('f-folder').addEventListener('change', e => { ui.folder = e.target.value; reset(); });
  $('clear-filters-btn').addEventListener('click', clearFilters);
  $('view-grid').addEventListener('click', () => { ui.view = 'grid'; render(); });
  $('view-map').addEventListener('click', () => { ui.view = 'map'; render(); track('map_view'); });
  $('select-btn').addEventListener('click', toggleSelectMode);
  $('unavail-summary').addEventListener('click', () => { unavailPref = !$('unavail-wrap').open; });

  // bulk bar
  $('bulk-done').addEventListener('click', toggleSelectMode);
  $('bulk-all').addEventListener('click', () => { currentAvailIds.forEach(i => ui.selected.add(i)); render(); });
  $('bulk-compare').addEventListener('click', openCompare);
  $('bulk-remove').addEventListener('click', () => { const ids = [...ui.selected]; if (ids.length) removeMany(ids); });
  $('bulk-share').addEventListener('click', () => shareRows(savedRows.filter(r => ui.selected.has(r.listing_id)), 'Share selected listings'));
  $('bulk-folder').addEventListener('click', () => { $('folder-modal-sub').textContent = ui.selected.size + ' listing' + (ui.selected.size !== 1 ? 's' : '') + ' selected'; $('fm-folder').value = ''; nkOpenModal($('folder-modal')); });
  $('fm-cancel').addEventListener('click', () => nkCloseModal($('folder-modal')));
  $('fm-save').addEventListener('click', () => {
    const f = $('fm-folder').value.trim().slice(0, 40);
    ui.selected.forEach(id => { mi(id).folder = f; });
    saveMeta();
    if (shortlistMode) syncShortlistToServer();
    nkCloseModal($('folder-modal')); render();
    toast(f ? 'Moved to "' + f + '"' : 'Removed from folders');
  });

  // modals
  $('em-cancel').addEventListener('click', () => nkCloseModal($('edit-modal')));
  $('em-save').addEventListener('click', saveEdit);
  $('sh-close').addEventListener('click', () => nkCloseModal($('share-modal')));
  $('sh-copy').addEventListener('click', async () => { toast((await copyText(shareCtx.text)) ? 'Copied to clipboard' : 'Could not copy. Select the text and copy it manually.', ''); });
  $('sh-native').addEventListener('click', () => { if (navigator.share) navigator.share({ title: shareCtx.title, text: shareCtx.text }).catch(() => {}); });
  $('sh-wa').addEventListener('click', () => track('share_whatsapp'));
  $('cmp-close').addEventListener('click', () => nkCloseModal($('compare-modal')));

  // results (delegated)
  const results = $('results');
  results.addEventListener('click', e => {
    const a = e.target.closest('[data-act]');
    if (a) return handleAct(a, e);
    const v = e.target.closest('[data-view-id]');
    if (v) onViewClick(v.dataset.viewId);
  });
  results.addEventListener('change', e => {
    const box = e.target.closest('.sel-input'); if (!box) return;
    const card = box.closest('.card'), id = card.dataset.listingId;
    if (box.checked) ui.selected.add(id); else ui.selected.delete(id);
    card.classList.toggle('selected', box.checked);
    updateBulkBar();
  });
  // swipe between photos
  let tx = null, tcard = null;
  results.addEventListener('touchstart', e => { const m = e.target.closest('.card-media'); if (!m || e.touches.length !== 1) { tx = null; return; } tx = e.touches[0].clientX; tcard = m.closest('.card'); }, { passive: true });
  results.addEventListener('touchend', e => { if (tx === null || !tcard) return; const dx = e.changedTouches[0].clientX - tx; if (Math.abs(dx) > 45) cyclePhoto(tcard, tcard.dataset.listingId, dx < 0 ? 1 : -1); tx = null; }, { passive: true });
  // drag to reorder
  let dragId = null;
  results.addEventListener('dragstart', e => {
    const c = e.target.closest && e.target.closest('.card[draggable="true"]'); if (!c) return;
    dragId = c.dataset.listingId; e.dataTransfer.effectAllowed = 'move';
    try { e.dataTransfer.setData('text/plain', dragId); } catch (_) {}
    c.classList.add('dragging');
  });
  results.addEventListener('dragover', e => {
    if (!dragId) return;
    const c = e.target.closest('.card[draggable="true"]');
    if (c && c.dataset.listingId !== dragId) { e.preventDefault(); qsa('.drag-over').forEach(x => x.classList.remove('drag-over')); c.classList.add('drag-over'); }
  });
  results.addEventListener('drop', e => {
    if (!dragId) return;
    const c = e.target.closest('.card[draggable="true"]'); if (!c) return;
    e.preventDefault();
    const target = c.dataset.listingId, d = dragId; dragId = null;
    if (target !== d) dropBefore(d, target);
  });
  results.addEventListener('dragend', () => { dragId = null; qsa('.dragging,.drag-over').forEach(x => x.classList.remove('dragging', 'drag-over')); });

  // suggestion grids
  const side = e => {
    const add = e.target.closest('[data-add]'); if (add) return addToSaved(add.dataset.add, add);
    const v = e.target.closest('[data-view-id]'); if (v) nkTrackRecentViewed(v.dataset.viewId);
  };
  $('recommended-grid').addEventListener('click', side);
  $('recent-grid').addEventListener('click', side);

  $('nk-datasaver-off').addEventListener('click', nkToggleDataSaver);
  window.addEventListener('pageshow', e => { if (e.persisted) { render(); silentRefresh(true); } });
  document.addEventListener('visibilitychange', () => { if (!document.hidden) silentRefresh(); });
  window.addEventListener('focus', () => silentRefresh());
  window.addEventListener('storage', e => {
    if (!e.key) return;
    if (e.key === SAVED_KEY) silentRefresh(true);
    else if (e.key === metaKey) { meta = readMeta(metaKey); render(); }
    else if (e.key === THEME_KEY && (e.newValue === 'light' || e.newValue === 'dark')) applyTheme(e.newValue);
  });
  setInterval(() => { if (!document.hidden) silentRefresh(); }, 120000);

  // print: show everything, then restore
  window.addEventListener('beforeprint', () => {
    $('print-meta').textContent = new Date().toLocaleDateString('en-KE', { day: 'numeric', month: 'long', year: 'numeric' }) + ' · ' + savedRows.length + ' listing' + (savedRows.length !== 1 ? 's' : '');
    ui._prevLimit = ui.limit; ui._prevView = ui.view; ui.limit = 1e9; ui.view = 'grid'; render(); $('unavail-wrap').open = true;
  });
  window.addEventListener('afterprint', () => { ui.limit = ui._prevLimit || PAGE_SIZE; ui.view = ui._prevView || 'grid'; render(); });
}

/* ════════════════════════════════════════════════════════════
   INIT
   ════════════════════════════════════════════════════════════ */
async function nkSavedInit() {
  $('footer-year').textContent = new Date().getFullYear();
  applyTheme(document.documentElement.getAttribute('data-theme') || 'dark');
  nkPopulateFooterCounties();
  nkInitDataSaver();
  bindEvents();
  initTabbarMeasure();
  liftChatWidget();

  const { data } = await nkSessionPromise;
  currentUser = (data && data.session && data.session.user) || null;
  metaKey = META_KEY + ':' + (currentUser ? currentUser.id : 'anon');
  meta = readMeta(metaKey);

  nkInitAccountNav(['nav-account-link', 'mobile-account-link']);
  if (currentUser) $('tab-account-link').setAttribute('href', '/dashboard');

  // shared read-only shortlist: /saved?share=000123,000456
  const sp = new URLSearchParams(location.search).get('share');
  if (sp) sharedNums = sp.split(',').map(s => Number(s)).filter(n => Number.isFinite(n) && n > 0).slice(0, 60);
  shareMode = sharedNums.length > 0;

  // anonymous shortlist: /saved?list=sl_abc123xyz
  const listParam = new URLSearchParams(location.search).get('list');
  isAnonShortlist = !!(!currentUser && listParam && listParam.startsWith('sl_'));   // no `const` — assigns the global

  let ok;
  if (shareMode) {
    $('page-title').textContent = 'Shared shortlist';
    $('page-sub').textContent = 'A shortlist someone sent you. Nothing here changes your own saved listings.';
    ok = await loadShared(sharedNums);
    $('share-banner').hidden = false;
    $('share-banner-text').textContent = savedRows.length + ' listing' + (savedRows.length !== 1 ? 's' : '') + ' shared with you.';
  } else if (isAnonShortlist) {
    shortlistToken = listParam;
    $('page-title').textContent = 'Your shortlist';
    $('page-sub').textContent = 'Properties you saved — no account needed.';
    const cached = readCache();
    if (cached && cached.rows.length) { savedRows = cached.rows; render(); }
    ok = await loadFromAnonymousShortlist();
    if (ok) $('sync-banner-anon').hidden = false;
  } else {
    let merged = 0;
    if (currentUser) {
      $('sync-banner-signedin').hidden = false;
      $('signed-in-email').textContent = currentUser.email || '';
      merged = await mergeLocalIntoAccount();
    }
    const cached = readCache();
    if (cached && cached.rows.length) { savedRows = cached.rows; render(); }     // instant paint, refreshed below
    ok = await loadOwn();
    if (merged) toast('Added ' + merged + ' listing' + (merged !== 1 ? 's' : '') + ' from this device to your account');
    if (!currentUser) {
      $('sync-banner-anon').hidden = false;
      if (ok) { shortlistMode = true; syncShortlistToServer(); }   // push this device's existing saves to the server immediately
    }
  }

  loaded = true; lastRefresh = Date.now();
  loadError = !ok;
  if (ok) { ensureSnapshots(); pruneMeta(); writeCache(); }
  render();
  loadRecommended(); loadRecent(); scheduleRealtime();
  nkTrackPageView();
  track(shareMode ? 'shared_view' : 'saved_view', { count: savedRows.length });
}

document.addEventListener('DOMContentLoaded', nkSavedInit);
})();
</script>
