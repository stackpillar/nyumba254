  $('recent-grid').innerHTML = recentRows.map(buildRecommendedCard).join('');
}

/* ── map (item 15) ── */
let map = null, mapLayer = null;
function loadLeaflet() {
  return new Promise((res, rej) => {
    if (window.L) return res();
    const css = document.createElement('link');
    css.rel = 'stylesheet'; css.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
    document.head.appendChild(css);
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
    s.onload = res; s.onerror = rej;
    document.head.appendChild(s);
  });
}
function coordsOf(l, id) {
  const d = l.details || {};
  const lat = parseFloat(l.latitude ?? l.lat ?? d.latitude ?? d.lat);
  const lng = parseFloat(l.longitude ?? l.lng ?? l.lon ?? d.longitude ?? d.lng);
  if (isFinite(lat) && isFinite(lng)) return { lat, lng, exact: true };
  const c = (typeof NK_COUNTY_COORDS !== 'undefined') && NK_COUNTY_COORDS[countyKeyOf(l)];
  if (!c) return null;
  let h = 0;
  for (const ch of String(id)) h = (h * 31 + ch.charCodeAt(0)) | 0;
  return { lat: c[0] + (((h >> 8) & 255) / 255 - .5) * .06, lng: c[1] + ((h & 255) / 255 - .5) * .06, exact: false };
}
async function renderMap(rows) {
  try { await loadLeaflet(); } catch (e) { toast('Could not load the map. Check your connection.', 'error'); ui.view = 'grid'; render(); return; }
  if (ui.view !== 'map') return;
  if (!map) {
    map = L.map('map', { scrollWheelZoom: false }).setView([-0.5, 37.5], 6);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap contributors' }).addTo(map);
    mapLayer = L.layerGroup().addTo(map);
  }
  mapLayer.clearLayers();
  const pts = []; let approx = 0;
  rows.forEach(r => {
    const l = r.listing, c = coordsOf(l, r.listing_id);
    if (!c) return;
    if (!c.exact) approx++;
    L.circleMarker([c.lat, c.lng], { radius: 10, color: '#085041', weight: 2, fillColor: '#1D9E75', fillOpacity: .9 }).addTo(mapLayer)
      .bindPopup(`<strong>${escHtml(l.title)}</strong><br>${escHtml(plainPrice(l))}<br>${escHtml(l.area || '')}<br><a href="${listingHref(l)}">View listing</a>`);
    pts.push([c.lat, c.lng]);
  });
  map.invalidateSize();
  if (pts.length) map.fitBounds(pts, { padding: [40, 40], maxZoom: 14 });
  $('map-note').textContent = pts.length
    ? (approx ? `${approx} pin${approx > 1 ? 's are' : ' is'} placed near the middle of the listing's county, not the exact address.` : 'Pins show the listed locations.')
    : 'None of these listings have a location to show on the map.';
}

