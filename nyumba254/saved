const short = n => (n >= 1e6 ? (n / 1e6).toFixed(n % 1e6 === 0 ? 0 : 1).replace(/\.0$/, '') + 'M' : fmtNum(n));
function renderSummary() {
  const box = $('summary-strip');
  if (!savedRows.length) { box.hidden = true; return; }
  const av = savedRows.filter(r => isAvailable(r.listing));
  const chip = (a, b) => `<div class="sum-chip"><strong>${escHtml(a)}</strong><span>${escHtml(b)}</span></div>`;
  const out = [chip(String(av.length), 'available now')];
  const un = savedRows.length - av.length;
  if (un) out.push(chip(String(un), 'no longer available'));
  const byFreq = {};
  av.forEach(r => { const p = Number(r.listing.price) || 0; if (p > 0) (byFreq[r.listing.price_frequency || 'month'] = byFreq[r.listing.price_frequency || 'month'] || []).push(p); });
  Object.entries(byFreq).sort((a, b) => b[1].length - a[1].length).slice(0, 3).forEach(([f, arr]) => {
    const min = Math.min(...arr), max = Math.max(...arr), avg = Math.round(arr.reduce((s, x) => s + x, 0) / arr.length);
    out.push(chip('KES ' + (min === max ? short(min) : short(min) + '–' + short(max)), (FREQ_TXT[f] || '') + ' · avg ' + short(avg)));
  });
  const cc = {};
  av.forEach(r => { const c = countyKeyOf(r.listing); if (c) cc[c] = (cc[c] || 0) + 1; });
  const top = Object.entries(cc).sort((a, b) => b[1] - a[1]).slice(0, 3);
  if (top.length) out.push(chip(top.map(([c, n]) => nkCountyLabel(c).replace(/\s*\(.*\)/, '') + ' ' + n).join(' · '), 'by county'));
  if (!shareMode) {
    const next = savedRows.map(r => getMi(r.listing_id).viewAt).filter(v => v && new Date(v).getTime() > Date.now()).sort()[0];
    if (next) out.push(chip(fmtViewing(next), 'next viewing'));
  }
  box.innerHTML = out.join('');
  box.hidden = false;
}

