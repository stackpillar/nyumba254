async function removeMany(ids) {
  if (shareMode || !ids.length) return;
  const set = new Set(ids);
  const rows = savedRows.filter(r => set.has(r.listing_id));
  if (!rows.length) return;
  const nextId = ids.length === 1 ? nextCardId(ids[0]) : null;
  const snapshot = savedRows.slice();
  mutating++;
  savedRows = savedRows.filter(r => !set.has(r.listing_id));
  ids.forEach(i => ui.selected.delete(i));
  render(); focusAfterRemove(nextId);
  let err = null;
  if (currentUser) {
    const { error } = await db.from('saved_listings').delete().eq('user_id', currentUser.id).in('listing_id', rows.map(r => r.listing_id));
    err = error;
  } else {
    rows.forEach(r => removeLocalSaved(r.listing_id));
  }
  mutating--;
  if (err) {
    console.error('Remove error:', err.message);
    savedRows = snapshot; render();
    toast('Could not remove. Please try again.', 'error');
    return;
  }
  writeCache();
  if (shortlistMode) syncShortlistToServer();
  track('saved_remove', { count: rows.length, listing_id: rows.length === 1 ? rows[0].listing_id : null });
  toast(rows.length === 1 ? 'Removed from shortlist' : 'Removed ' + rows.length + ' listings', '', { label: 'Undo', fn: () => restoreRows(rows) });
  loadRecommended(); scheduleRealtime();
}
async function restoreRows(rows) {
  const fresh = rows.filter(r => !savedRows.some(x => x.listing_id === r.listing_id));
  if (!fresh.length) return;
  mutating++;
  savedRows.push(...fresh); render();
  let err = null;
  if (currentUser) {
    const withDate = fresh.map(r => Object.assign({ user_id: currentUser.id, listing_id: r.listing_id }, r.created_at ? { created_at: r.created_at } : {}));
    let res = await db.from('saved_listings').insert(withDate);
    if (res.error) res = await db.from('saved_listings').insert(fresh.map(r => ({ user_id: currentUser.id, listing_id: r.listing_id })));
    err = res.error;
  } else {
    fresh.forEach(r => addLocalSaved(r.listing_id));
  }
  mutating--;
  if (err) {
    savedRows = savedRows.filter(r => !fresh.includes(r)); render();
    toast('Could not undo. Please save the listing again.', 'error');
    return;
  }
  writeCache();
  if (shortlistMode) syncShortlistToServer();
  track('saved_undo', { count: fresh.length });
  toast(fresh.length === 1 ? 'Restored to your shortlist' : 'Restored ' + fresh.length + ' listings');
  loadRecommended(); scheduleRealtime();
}
function findCandidate(id) { return recommendedRows.find(l => l.id === id) || recentRows.find(l => l.id === id); }
async function addToSaved(id, btnEl) {
  if (shareMode) return;
  const listing = findCandidate(id);
  if (!listing || savedRows.some(r => r.listing_id === id)) return;
  if (btnEl) { btnEl.classList.add('added'); btnEl.disabled = true; }
  const row = { listing_id: id, created_at: currentUser ? new Date().toISOString() : null, listing, seq: topSeq() };
  mutating++;
  savedRows.push(row);
  recommendedRows = recommendedRows.filter(l => l.id !== id);
  recentRows = recentRows.filter(l => l.id !== id);
  render(); renderRecommended(); renderRecent();
  let err = null;
  if (currentUser) {
    const { error } = await db.from('saved_listings').insert({ user_id: currentUser.id, listing_id: id });
    err = error;
  } else {
    addLocalSaved(id);
  }
  mutating--;
  if (err) {
    console.error('Save error:', err.message);
    savedRows = savedRows.filter(r => r !== row);
    recommendedRows.unshift(listing);
    render(); renderRecommended(); renderRecent();
    toast('Could not save. Please try again.', 'error');
    return;
  }
  ensureSnapshots(); writeCache();
  if (shortlistMode) syncShortlistToServer();
  track('saved_add', { listing_id: id });
