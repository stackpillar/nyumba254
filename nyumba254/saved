const filtersActive = () => !!(ui.q || ui.cat || ui.county || ui.status || ui.folder || ui.avail !== 'all');
function matches(row) {
  const l = row.listing, m = getMi(row.listing_id);
  if (ui.cat && l.category !== ui.cat) return false;
  if (ui.county && countyKeyOf(l) !== ui.county) return false;
  if (ui.status && (m.status || '') !== ui.status) return false;
  if (ui.folder && (m.folder || '') !== ui.folder) return false;
  if (ui.q) {
    const hay = [l.title, l.area, l.address, l.county, m.note, m.folder].join(' ').toLowerCase();
    if (!ui.q.split(/\s+/).every(t => hay.includes(t))) return false;
  }
  return true;
}
function normalizeOrder() {
  const ids = savedRows.slice().sort((a, b) => a.seq - b.seq).map(r => r.listing_id);
  const set = new Set(ids);
  const kept = meta.order.filter(x => set.has(x));
  const have = new Set(kept);
  ids.forEach(x => { if (!have.has(x)) kept.push(x); });
  meta.order = kept;
}
function sortRows(rows) {
  const a = rows.slice();
  const price = r => Number(r.listing.price) || 0;
  switch (ui.sort) {
    case 'price-asc': a.sort((x, y) => price(x) - price(y)); break;
    case 'price-desc': a.sort((x, y) => price(y) - price(x)); break;
    case 'area': a.sort((x, y) => String(x.listing.area || '').localeCompare(String(y.listing.area || ''))); break;
    case 'manual': {
      normalizeOrder();
      const pos = id => meta.order.indexOf(id);
      a.sort((x, y) => pos(x.listing_id) - pos(y.listing_id));
      break;
    }
    default: a.sort((x, y) => x.seq - y.seq);
  }
  return a;
}
