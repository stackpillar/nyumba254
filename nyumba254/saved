/* ── recommendations (item 25) and recently viewed (item 26) ── */
async function loadRecommended() {
  const my = ++recToken;
  const excl = new Set(savedRows.map(r => r.listing_id));
  const av = savedRows.filter(r => isAvailable(r.listing)).map(r => r.listing);
  const base = () => db.from('listings').select(LISTING_SELECT).eq('status', 'active').eq('is_disabled', false).eq('recycle_bin', false);
  let rows = [], basis = '';
  if (av.length) {
    const cat = mode(av.map(l => l.category)), county = mode(av.map(l => l.county));
    const freq = mode(av.map(l => l.price_frequency));
    const prices = av.filter(l => l.price_frequency === freq).map(l => Number(l.price)).filter(n => n > 0).sort((a, b) => a - b);
    let q = base();
    if (cat) q = q.eq('category', cat);
    if (county) q = q.eq('county', county);
    if (prices.length && freq) {
      const med = prices[Math.floor(prices.length / 2)];
      q = q.eq('price_frequency', freq).gte('price', Math.round(med * 0.75)).lte('price', Math.round(med * 1.25));
      basis = `${(NK_CATEGORIES[cat] || {}).label || 'Listings'}${county ? ' in ' + nkCountyLabel(county) : ''} near KES ${fmtNum(med)}${NK_FREQ_LABEL[freq] || ''}`;
    }
    const { data, error } = await q.order('created_at', { ascending: false }).order('id').limit(excl.size + 12);
    if (my !== recToken) return;
    if (!error) rows = (data || []).filter(l => !excl.has(l.id)).slice(0, 8);
  }
  let similar = rows.length >= 4;
  if (!similar) {
    const { data, error } = await base().order('created_at', { ascending: false }).order('id').limit(excl.size + 8);
    if (my !== recToken) return;
    if (error) { console.error('Load recommended error:', error.message); recommendedRows = []; renderRecommended(); return; }
    rows = (data || []).filter(l => !excl.has(l.id)).slice(0, 8);
  }
  recommendedRows = rows;
  $('rec-sub').textContent = similar && basis ? 'Similar to your shortlist: ' + basis : 'Recently listed properties across Kenya';
  renderRecommended();
}
function renderRecommended() {
  const section = $('recommended-section');
  section.hidden = !recommendedRows.length || shareMode;
  if (section.hidden) return;
  $('recommended-grid').innerHTML = recommendedRows.map(buildRecommendedCard).join('');
}
async function loadRecent() {
  if (shareMode) return;
  let list = [];
  try { list = await nkFetchRecentlyViewed(); } catch (e) {}
  const excl = new Set(savedRows.map(r => r.listing_id));
  recentRows = list.filter(l => !excl.has(l.id) && isAvailable(l)).slice(0, 8);
  renderRecent();
}
function renderRecent() {
