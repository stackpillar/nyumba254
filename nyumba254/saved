<script src="/nk-shared.js"></script>
<script>
(function () {
'use strict';

/* ════════════════════════════════════════════════════════════
   CONFIG
   ════════════════════════════════════════════════════════════ */
const SAVED_KEY = 'nk_saved_listings';              // written by saved-listings.js (heart buttons)
const META_KEY = 'nk_saved_meta_v1';                // notes / status / folder / viewing / order / price snapshot (per device)
const CACHE_KEY = 'nk_saved_cache_v1';              // last shortlist, for instant render
const SHORTLIST_TOKEN_KEY = 'nk_shortlist_token';   // anonymous shortlist token
const THEME_KEY = 'nk_theme';
const PAGE_SIZE = 12;
const LISTING_SELECT = '*, listing_photos(*), profiles(verification_status)';
/* Columns that may hold the seller's phone. Add or reorder to match your `listings` table. */
const CONTACT_FIELDS = ['whatsapp_number', 'whatsapp', 'contact_phone', 'phone', 'phone_number', 'seller_phone', 'contact_number'];
const STATUS_LABEL = { interested: 'Interested', contacted: 'Contacted', viewing: 'Viewing booked', viewed: 'Viewed', rejected: 'Rejected' };
const FREQ_TXT = { month: 'per month', night: 'per night', week: 'per week', term: 'per term', once: 'for sale' };

/* ════════════════════════════════════════════════════════════
   HELPERS
   ════════════════════════════════════════════════════════════ */
const $ = id => document.getElementById(id);
const qsa = (sel, root) => Array.from((root || document).querySelectorAll(sel));
const pad = n => String(n).padStart(6, '0');
const p2 = n => String(n).padStart(2, '0');
const listingHref = l => '/listing?id=' + pad(l.listing_number);
const absUrl = l => location.origin + listingHref(l);
const fmtNum = n => Number(n || 0).toLocaleString('en-KE');
const plainPrice = l => 'KES ' + fmtNum(l.price) + (NK_FREQ_LABEL[l.price_frequency] || '');

let currentUser = null;
let savedRows = [];
let recommendedRows = [];
let recentRows = [];
let loadError = false;
let loaded = false;
let shareMode = false;
let sharedNums = [];
let mutating = 0;
let metaKey = META_KEY + ':anon';
let meta = { items: {}, order: [] };
let shortlistToken = null;  // anonymous shortlist token
let shortlistMode = false;  // loading from server (not just localStorage)
let isAnonShortlist = false;  // true if viewing /saved?list=sl_abc123
let renderedIds = [];
let currentAvailIds = [];
let unavailPref = null;
let editingId = null;
let shareCtx = { title: '', text: '' };
let recToken = 0;
let refreshing = false;
let lastRefresh = 0;
let rt = null;
let rtTimer = null;
const photoIdx = {};

const ui = { q: '', cat: '', county: '', avail: 'all', status: '', folder: '', sort: 'saved', view: 'grid', select: false, selected: new Set(), limit: PAGE_SIZE };

/* ── toast (supports an action button, e.g. Undo) ── */
let toastTimer;
function toast(msg, kind, action) {
  const t = $('toast'); if (!t) return;
  t.textContent = msg;
  if (action) {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'toast-action'; b.textContent = action.label;
    b.addEventListener('click', () => { t.classList.remove('show'); clearTimeout(toastTimer); action.fn(); });
    t.appendChild(b);
  }
  t.className = 'toast show' + (kind === 'error' ? ' error' : '') + (action ? ' has-action' : '');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), action ? 7000 : 4200);
}

/* ── event tracking (item 37). Needs the nk_events table; silently ignored if it doesn't exist. ── */
function sessionId() { try { return localStorage.getItem('nk_sid') || null; } catch (e) { return null; } }
function track(event, extra) {
  try {
    const x = extra || {};
    db.from('nk_events').insert({
      event, listing_id: x.listing_id || null, user_id: currentUser ? currentUser.id : null,
      session_id: sessionId(), path: location.pathname, meta: x
    }).then(() => {}, () => {});
  } catch (e) {}
}

/* ── local saved ids (same storage as saved-listings.js; tolerant of string ids or {id} objects) ── */
function idOf(x) { return (x && typeof x === 'object') ? (x.id || x.listing_id || x.listingId) : x; }
function getLocalRaw() { try { const r = JSON.parse(localStorage.getItem(SAVED_KEY) || '[]'); return Array.isArray(r) ? r : []; } catch (e) { return []; } }
function getLocalSavedIds() { return getLocalRaw().map(idOf).filter(Boolean); }
function setLocalRaw(a) { try { localStorage.setItem(SAVED_KEY, JSON.stringify(a)); } catch (e) {} }
function removeLocalSaved(id) { setLocalRaw(getLocalRaw().filter(x => idOf(x) !== id)); }
function addLocalSaved(id) {
  const raw = getLocalRaw();
  if (raw.some(x => idOf(x) === id)) return;
  raw.push(raw.some(x => x && typeof x === 'object') ? { id, savedAt: Date.now() } : id);
  setLocalRaw(raw);
}

/* ── per-device metadata (notes, status, folder, viewing date, manual order, price snapshot) ── */
function readMeta(key) {
  try {
    const m = JSON.parse(localStorage.getItem(key) || 'null');
    if (m && typeof m === 'object') return { items: m.items || {}, order: Array.isArray(m.order) ? m.order : [] };
  } catch (e) {}
  return { items: {}, order: [] };
}
function saveMeta() { try { localStorage.setItem(metaKey, JSON.stringify(meta)); } catch (e) {} }
const getMi = id => (shareMode ? {} : (meta.items[id] || {}));
function mi(id) { return meta.items[id] || (meta.items[id] = {}); }

/* ── Anonymous shortlist token ── */
function getOrCreateShortlistToken() {
  if (shortlistToken) return shortlistToken;
  try {
    shortlistToken = localStorage.getItem(SHORTLIST_TOKEN_KEY);
    if (!shortlistToken) {
      // Generate: "sl_" + 16 random alphanumeric chars
      shortlistToken = 'sl_' + Math.random().toString(36).substring(2, 18).padEnd(16, 'x');
      localStorage.setItem(SHORTLIST_TOKEN_KEY, shortlistToken);
    }
  } catch (e) {
    shortlistToken = null;
  }
  return shortlistToken;
}

async function syncShortlistToServer() {
  if (!shortlistToken || currentUser || shareMode) return;  // don't sync if signed in or in share mode
  try {
    const listings = savedRows.map(r => ({
      id: r.listing_id,
      title: r.listing.title,
      area: r.listing.area,
      price: r.listing.price,
      price_frequency: r.listing.price_frequency,
      saved_at: r.created_at || new Date().toISOString(),
      notes: getMi(r.listing_id).note || '',
      status: getMi(r.listing_id).status || '',
      folder: getMi(r.listing_id).folder || '',
    }));
    await db.from('anonymous_shortlists').upsert({
      token: shortlistToken,
      listings,
      accessed_at: new Date().toISOString(),
      expires_at: new Date(Date.now() + 90 * 24 * 60 * 60 * 1000).toISOString(),
    });
  } catch (e) {
    console.error('Sync to server failed:', e.message);
  }
}

async function loadFromAnonymousShortlist() {
  const token = getOrCreateShortlistToken();
  if (!token) { savedRows = []; return true; }
  try {
    const { data, error } = await db.from('anonymous_shortlists')
      .select('listings')
      .eq('token', token)
      .maybeSingle();                 // returns null (no error) when the row doesn't exist yet
    if (error) { console.error('Load anon shortlist error:', error.message); return false; }
    shortlistMode = true;             // server round-trip succeeded, even if empty
    try { localStorage.setItem(SHORTLIST_TOKEN_KEY, token); } catch (e2) {}   // remember this token on this device
    const listings = (data && Array.isArray(data.listings)) ? data.listings : [];
    if (!listings.length) { savedRows = []; assignSeq(); return true; }
    const ids = listings.map(l => l.id).filter(Boolean);
    const { data: rows, error: fetchErr } = await db.from('listings')
      .select(LISTING_SELECT).in('id', ids);
    if (fetchErr || !rows) return false;
    const byId = Object.fromEntries(rows.map(l => [l.id, l]));
    savedRows = ids.map(id => {
      const l = byId[id];
      const cached = listings.find(c => c.id === id);
      if (!l) return null;
      return { listing_id: id, created_at: cached?.saved_at || null, listing: l };
    }).filter(Boolean);
    meta.items = {};
    listings.forEach(cached => {
      if (!cached.id) return;
      meta.items[cached.id] = meta.items[cached.id] || {};
      if (cached.notes) meta.items[cached.id].note = cached.notes;
      if (cached.status) meta.items[cached.id].status = cached.status;
      if (cached.folder) meta.items[cached.id].folder = cached.folder;
    });
    assignSeq();
    return true;
  } catch (e) {
    console.error('Load from anonymous shortlist failed:', e.message);
    return false;
  }
}

/* ── cache (item 29) ── */
const cacheKey = () => CACHE_KEY + ':' + (currentUser ? currentUser.id : 'anon');
function writeCache() {
  if (shareMode) return;
  try { localStorage.setItem(cacheKey(), JSON.stringify({ t: Date.now(), rows: savedRows.slice(0, 40) })); } catch (e) {}
}
function readCache() {
  try { const c = JSON.parse(localStorage.getItem(cacheKey()) || 'null'); if (c && Array.isArray(c.rows)) return c; } catch (e) {}
  return null;
}
function clearAllCaches() {
  try { Object.keys(localStorage).filter(k => k.indexOf(CACHE_KEY) === 0).forEach(k => localStorage.removeItem(k)); } catch (e) {}
}

/* ── listing state ── */
const isAvailable = l => l.status === 'active' && !l.is_disabled && !l.recycle_bin;
const isOccupied = l => l.status === 'occupied' && !l.is_disabled && !l.recycle_bin;
const isUnavailable = l => !!(l.is_disabled || l.recycle_bin || (l.status !== 'active' && l.status !== 'occupied'));
const occLabelOf = l => (l.price_frequency === 'once' ? 'Sold' : 'Occupied');
function nkListingCounty(l) {
  if (!l) return 'Kenya';
  if (l.county) return nkCountyLabel(l.county);
  return nkCountyLabel(NK_AREA_TO_COUNTY_GUESS[l.area] || '') || 'Kenya';
}
const countyKeyOf = l => l.county || NK_AREA_TO_COUNTY_GUESS[l.area] || '';
function nkFormatPriceLike(price, freq) { return formatPrice({ price, price_frequency: freq, category: 'apartment' }); }
function photosOf(l) {
  const p = (l.listing_photos || []).slice().sort((a, b) => (a.position || 0) - (b.position || 0));
  const ci = p.findIndex(x => x.is_cover);
  if (ci > 0) p.unshift(p.splice(ci, 1)[0]);
  return p;
}
function agoText(iso) {
  if (!iso) return '';
  const d = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
  if (isNaN(d)) return '';
  if (d <= 0) return 'Listed today';
  if (d === 1) return 'Listed yesterday';
  if (d < 30) return 'Listed ' + d + ' days ago';
  const mo = Math.floor(d / 30);
  return mo < 12 ? 'Listed ' + mo + ' mo ago' : 'Listed over a year ago';
}
function hasAm(l, key) {
  const d = l.details || {};
  if (l[key] === true || d[key] === true) return true;
  const a = d.amenities || l.amenities;
  return Array.isArray(a) && (a.includes(key) || a.includes(key.replace(/^has_/, '')));
}
function contactPhone(l) {
  const d = l.details || {};
  for (const k of CONTACT_FIELDS) {
    const v = l[k] || d[k];
    if (v) { const n = nkNormalizePhone(v); if (n) return n; }
  }
  return '';
}
function waLink(phone, l) {
  const msg = 'Hi, I\'m interested in "' + l.title + '" (' + absUrl(l) + ') that I found on Nyumba254.';
  return 'https://wa.me/' + phone.replace(/\D/g, '') + '?text=' + encodeURIComponent(msg);
}
function fmtViewing(v) {
  const d = new Date(v); if (isNaN(d)) return '';
  return d.toLocaleString('en-KE', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
}
function calUrl(l, viewAt) {
  const s = new Date(viewAt); if (isNaN(s)) return '';
  const e = new Date(s.getTime() + 3600000);
  const f = d => d.getFullYear() + p2(d.getMonth() + 1) + p2(d.getDate()) + 'T' + p2(d.getHours()) + p2(d.getMinutes()) + '00';
  return 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' + encodeURIComponent('Viewing: ' + l.title) +
    '&dates=' + f(s) + '/' + f(e) + '&details=' + encodeURIComponent(absUrl(l)) + '&location=' + encodeURIComponent(l.address || l.area || '');
}
function topSeq() { return savedRows.reduce((m, r) => Math.min(m, r.seq == null ? 0 : r.seq), 0) - 1; }
function mode(arr) {
  const c = {}; let best = null, n = 0;
  arr.forEach(x => { if (x == null || x === '') return; c[x] = (c[x] || 0) + 1; if (c[x] > n) { n = c[x]; best = x; } });
  return best;
}

/* ════════════════════════════════════════════════════════════
   THEME (item 33)
   ════════════════════════════════════════════════════════════ */
function applyTheme(t) {
  document.documentElement.setAttribute('data-theme', t);
  const b = $('theme-btn');
  if (b) { b.textContent = t === 'dark' ? 'Light mode' : 'Dark mode'; b.setAttribute('aria-label', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'); }
  const m = document.querySelector('meta[name="theme-color"]');
  if (m) m.setAttribute('content', t === 'dark' ? '#0f1512' : '#0F6E56');
}
function toggleTheme() {
  const t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  try { localStorage.setItem(THEME_KEY, t); } catch (e) {}
  applyTheme(t);
}

/* ════════════════════════════════════════════════════════════
   LOAD
   ════════════════════════════════════════════════════════════ */
function assignSeq() { savedRows.forEach((r, i) => { r.seq = i; }); }

async function loadFromAccount() {
  const { data, error } = await db.from('saved_listings')
    .select('listing_id, created_at, listings(' + LISTING_SELECT + ')')
    .eq('user_id', currentUser.id)
    .order('created_at', { ascending: false });
  if (error) { console.error('Load saved listings error:', error.message); return false; }
  savedRows = (data || []).filter(r => r.listings).map(r => ({ listing_id: r.listing_id, created_at: r.created_at, listing: r.listings }));
  assignSeq();
  return true;
}
async function loadFromLocalStorage() {
  const ids = getLocalSavedIds();
  if (!ids.length) { savedRows = []; return true; }
  const { data, error } = await db.from('listings').select(LISTING_SELECT).in('id', ids);
  if (error) { console.error('Load saved listings error:', error.message); return false; }
  savedRows = ids.slice().reverse().map(id => (data || []).find(l => l.id === id)).filter(Boolean).map(l => ({ listing_id: l.id, created_at: null, listing: l }));
  assignSeq();
  return true;
}
async function loadShared(nums) {
  const { data, error } = await db.from('listings').select(LISTING_SELECT).in('listing_number', nums);
  if (error) { console.error('Load shared listings error:', error.message); return false; }
  savedRows = nums.map(n => (data || []).find(l => Number(l.listing_number) === n)).filter(Boolean).map(l => ({ listing_id: l.id, created_at: null, listing: l }));
  assignSeq();
  return true;
}

/* Merge this device's local saves with the server-side anonymous shortlist, rather than letting
   whichever source loaded last silently overwrite the other. Local-only listings (saved via the
   heart button on another page, not yet synced from this device) are fetched and appended to
   whatever the server already has, so two devices never clobber each other's saves. */
async function loadAnonymousMerged() {
  const localIds = getLocalSavedIds();
  const serverOk = await loadFromAnonymousShortlist();   // sets savedRows + shortlistMode from server
  const serverRows = serverOk ? savedRows.slice() : [];
  const serverIds = new Set(serverRows.map(r => r.listing_id));
  const missingIds = localIds.filter(id => !serverIds.has(id));
  if (!missingIds.length) {
    if (!serverOk) return false;
    savedRows = serverRows; assignSeq();
    return true;
  }
  const { data, error } = await db.from('listings').select(LISTING_SELECT).in('id', missingIds);
  if (error) {
    console.error('Merge local into shortlist error:', error.message);
    if (!serverOk) return false;
    savedRows = serverRows; assignSeq();
    return true;
  }
  const localOnlyRows = missingIds.map(id => (data || []).find(l => l.id === id)).filter(Boolean)
    .map(l => ({ listing_id: l.id, created_at: null, listing: l }));
  savedRows = serverRows.concat(localOnlyRows);
  assignSeq();
  shortlistMode = true;   // we now hold data that should be pushed back to the server
  return true;
}
const loadOwn = async () => {
  if (currentUser) return loadFromAccount();
  return loadAnonymousMerged();
};

/* Item 1: merge anonymous saves into the account on sign-in. Nothing is deleted locally unless it was saved (or is a dead listing). */
async function mergeLocalIntoAccount() {
  const ids = getLocalSavedIds();
  if (!ids.length) return 0;
  const { data: ex, error: e1 } = await db.from('saved_listings').select('listing_id').eq('user_id', currentUser.id);
  if (e1) return 0;
  const have = new Set((ex || []).map(r => r.listing_id));
  const rows = ids.filter(id => !have.has(id)).map(id => ({ user_id: currentUser.id, listing_id: id }));
  const keep = []; let ok = 0;
  if (rows.length) {
    const { error } = await db.from('saved_listings').insert(rows);
    if (!error) ok = rows.length;
    else {
      for (const r of rows) {
        const { error: e } = await db.from('saved_listings').insert(r);
        if (!e) ok++;
        else if (e.code !== '23503' && e.code !== '23505') keep.push(r.listing_id);   // keep only on real failures (network, RLS)
      }
    }
  }
  setLocalRaw(getLocalRaw().filter(x => keep.includes(idOf(x))));
  // carry notes/status/folder over from the anonymous shortlist
  const anon = readMeta(META_KEY + ':anon');
  const mine = readMeta(metaKey);
  Object.keys(anon.items).forEach(id => { if (!mine.items[id]) mine.items[id] = anon.items[id]; });
  anon.order.forEach(id => { if (!mine.order.includes(id)) mine.order.push(id); });
  meta = mine; saveMeta();
  try { localStorage.removeItem(META_KEY + ':anon'); } catch (e) {}
  if (ok) track('saved_merge', { count: ok });
  return ok;
}

function ensureSnapshots() {
  if (shareMode) return;
  let dirty = false;
  savedRows.forEach(r => {
    const m = mi(r.listing_id);
    if (m.price === undefined) { m.price = Number(r.listing.price) || 0; m.freq = r.listing.price_frequency || ''; dirty = true; }
  });
  if (dirty) saveMeta();
}
function pruneMeta() {
  if (shareMode) return;
  const ids = new Set(savedRows.map(r => r.listing_id));
  Object.keys(meta.items).forEach(id => { if (!ids.has(id)) delete meta.items[id]; });
  meta.order = meta.order.filter(id => ids.has(id));
