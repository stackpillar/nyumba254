}
function priceDiff(l, id) {
  const m = getMi(id);
  if (!m.price || m.freq !== (l.price_frequency || '')) return 0;
  return (Number(l.price) || 0) - Number(m.price);
}

async function silentRefresh(force) {
  if (refreshing || shareMode || mutating > 0 || !loaded) return;
  if (!force && Date.now() - lastRefresh < 15000) return;
  refreshing = true;
  const before = savedRows.map(r => r.listing_id).sort().join();
