<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <title>Your Shortlist — Nyumba254</title>
  <meta name="description" content="Your saved property listings on Nyumba254 — keep track of apartments, houses, boarding rooms and Airbnb rentals you're interested in across Kenya."/>
  <meta name="robots" content="noindex,follow"/>
  <meta name="theme-color" content="#0f1512"/>
  <link rel="canonical" href="https://nyumba254.com/saved"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link rel="preconnect" href="https://vliuuloyfhyxcsuchpss.supabase.co"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet"/>
  <link rel="icon" href="/favicon.ico" sizes="any"/>
  <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  <!-- Apply the saved theme before first paint (no flash). Stored choice wins; otherwise dark, unless the device asks for light. -->
  <script>
  (function () {
    var t = null;
    try { t = localStorage.getItem('nk_theme'); } catch (e) {}
    if (t !== 'light' && t !== 'dark') {
      t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', t);
    var m = document.querySelector('meta[name="theme-color"]');
    if (m) m.setAttribute('content', t === 'dark' ? '#0f1512' : '#0F6E56');
  })();
  </script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green: #0F6E56; --green-light: #E1F5EE; --green-mid: #1D9E75; --green-dark: #085041; --green-border: #9FE1CB;
      --accent: #0F6E56; --accent-strong: #085041;
      --gold: #BA7517; --gold-light: #FAEEDA; --gold-border: #FAC775;
      --danger: #C53030; --danger-solid: #C53030; --danger-bg: #FFF5F5;
      --text: #1a1a18; --text-2: #4a4a46; --text-3: #6b6a63;
      --border: #e0ded8; --surface: #f7f6f2; --bg: #ffffff; --card: #ffffff;
      --sk1: #f0efe9; --sk2: #e8e7e1; --shadow: rgba(0,0,0,.09);
      --radius: 10px; --radius-lg: 16px;
      --nav-h: 64px;
      --nk-tabbar-h: 0px; --nk-stack: 0px;
      color-scheme: light;
    }
    html[data-theme="dark"] {
      --green-light: #123A2E; --green-border: #245a49;
      --accent: #5FD3AE; --accent-strong: #8FE6C8;
      --gold: #E0A245; --gold-light: #3A2C12; --gold-border: #6b4d1c;
      --danger: #F07272; --danger-bg: #3A1B1B;
      --text: #ECEFEC; --text-2: #C3CBC6; --text-3: #98A39C;
      --border: #2B3832; --surface: #1B2520; --bg: #0F1512; --card: #151D19;
      --sk1: #1B2520; --sk2: #232f29; --shadow: rgba(0,0,0,.5);
      color-scheme: dark;
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', system-ui, sans-serif; color: var(--text); background: var(--bg); font-size: 15px; line-height: 1.6; padding-bottom: var(--nk-tabbar-h); }
    body.has-bulk { padding-bottom: calc(var(--nk-tabbar-h) + 76px); }
    a { text-decoration: none; color: inherit; }
    img { display: block; max-width: 100%; }
    button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
    button:disabled { cursor: not-allowed; opacity: .5; }
    input, select, textarea { font-family: inherit; font-size: 14px; color: var(--text); background: var(--surface); border: 1.5px solid var(--border); border-radius: 8px; padding: 9px 12px; width: 100%; }
    input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--green-mid); outline-offset: 1px; }
    [hidden] { display: none !important; }
    :focus-visible { outline: 2px solid var(--green-mid); outline-offset: 2px; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; } }
    .skip-link { position: absolute; left: -9999px; top: 0; background: var(--green); color: white; padding: 10px 18px; border-radius: 0 0 8px 0; z-index: 100001; font-size: 14px; font-weight: 600; }
    .skip-link:focus { left: 0; }

    /* ── Data saver banner ── */
    .nk-datasaver-banner { display: none; align-items: center; justify-content: center; gap: 10px; background: #FFF7E6; color: #7a4f00; border-bottom: 1px solid #F3D9A0; font-size: 13px; padding: 9px 16px; text-align: center; flex-wrap: wrap; }
    .nk-datasaver-banner.visible { display: flex; }
    .nk-datasaver-banner button { border: 1px solid #7a4f00; color: #7a4f00; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 20px; }
    .nk-datasaver-banner button:hover { background: #7a4f00; color: white; }

    /* ── Navbar ── */
    nav#main-nav { position: sticky; top: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 0 32px; height: var(--nav-h); background: var(--bg); border-bottom: 1px solid var(--border); }
    .logo { display: flex; align-items: center; gap: 10px; font-family: 'Playfair Display', serif; font-size: 20px; color: var(--accent-strong); font-weight: 600; }
    .logo-icon { height: 40px; display: flex; align-items: center; justify-content: center; }
    .logo-icon img { width: auto; height: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 22%; box-shadow: 0 0 0 1px rgba(0,0,0,.08); }
    .nav-links { display: flex; align-items: center; gap: 6px; }
    .nav-link { font-size: 14px; color: var(--text-2); padding: 8px 14px; border-radius: var(--radius); transition: background .15s; white-space: nowrap; display: flex; align-items: center; gap: 6px; }
    .nav-link:hover { background: var(--surface); color: var(--text); }
    .nav-link[aria-current="page"] { color: var(--accent); font-weight: 600; }
    .nav-link svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; }
    .nav-count { background: var(--green); color: white; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 10px; min-width: 16px; text-align: center; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; font-size: 14px; font-weight: 500; padding: 9px 18px; border-radius: var(--radius); transition: all .15s; }
    .btn-primary { background: var(--green); color: white; }
    .btn-primary:hover { background: var(--green-dark); }
    .btn-outline { display: inline-flex; align-items: center; justify-content: center; gap: 6px; font-size: 13px; font-weight: 500; padding: 8px 16px; border-radius: var(--radius); border: 1.5px solid var(--border); background: var(--card); color: var(--text-2); transition: all .15s; min-height: 38px; }
    .btn-outline:hover:not(:disabled) { border-color: var(--green-mid); color: var(--accent); }

    /* ── Mobile menu ── */
    .mobile-menu-btn { display: none; padding: 12px; border-radius: 6px; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; }
    .mobile-menu-btn svg { width: 22px; height: 22px; stroke: var(--text); fill: none; stroke-width: 2; display: block; }
    .mobile-nav { display: none; position: fixed; top: var(--nav-h); left: 0; right: 0; max-height: calc(100dvh - var(--nav-h)); overflow-y: auto; -webkit-overflow-scrolling: touch; background: var(--bg); border-bottom: 1px solid var(--border); padding: 16px; z-index: 99; flex-direction: column; gap: 4px; box-shadow: 0 8px 24px rgba(0,0,0,.2); }
    .mobile-nav.open { display: flex; }
    .mobile-nav a { font-size: 15px; color: var(--text-2); padding: 12px 14px; border-radius: var(--radius); }
    .mobile-nav a:hover { background: var(--surface); }
    .mobile-nav a[aria-current="page"] { color: var(--accent); font-weight: 600; }
    .mobile-nav .btn-primary { color: #fff; margin-top: 8px; justify-content: center; }

    /* ── Page header ── */
    .page-header { background: var(--bg); border-bottom: 1px solid var(--border); padding: 28px 32px; }
    .page-header-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .page-header h1 { font-family: 'Playfair Display', serif; font-size: 28px; color: var(--text); margin-bottom: 4px; }
    .page-header p { font-size: 14px; color: var(--text-3); }
    .header-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .print-header { display: none; }

    /* ── Banners ── */
    .sync-banner { max-width: 1100px; margin: 20px auto 0; padding: 14px 18px; border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
    .sync-banner.anon { background: var(--gold-light); border: 1px solid var(--gold-border); }
    .sync-banner.signed-in { background: var(--green-light); border: 1px solid var(--green-border); }
    .sync-banner-text { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text-2); }
    .sync-banner-text svg { width: 18px; height: 18px; flex-shrink: 0; }
    .sync-banner.anon svg { stroke: var(--gold); fill: none; stroke-width: 2; }
    .sync-banner.signed-in svg { stroke: var(--accent-strong); fill: none; stroke-width: 2; }
    .sync-banner strong { color: var(--text); }

    .notice { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 16px; border-radius: var(--radius); font-size: 13px; margin-bottom: 16px; }
    .notice.nudge { background: var(--gold-light); border: 1px solid var(--gold-border); color: var(--text-2); }
    .notice.info { background: var(--green-light); border: 1px solid var(--green-border); color: var(--text-2); }
    .notice.warn { background: var(--surface); border: 1px solid var(--border); color: var(--text-2); }
    .notice strong { color: var(--text); }
    .notice-actions { display: flex; gap: 8px; flex-wrap: wrap; }

    /* ── Main ── */
    .main-wrap { max-width: 1100px; margin: 0 auto; padding: 28px 32px 80px; }

    /* ── Summary strip ── */
    .summary-strip { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; }
    .sum-chip { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 14px; display: flex; flex-direction: column; min-width: 120px; }
    .sum-chip strong { font-size: 15px; color: var(--text); font-weight: 700; line-height: 1.3; }
    .sum-chip span { font-size: 11.5px; color: var(--text-3); }

    /* ── Filter row + toolbar ── */
    .filter-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 10px; }
    .result-count { font-size: 14px; color: var(--text-2); }
    .result-count:focus { outline: none; }
    .result-count strong { color: var(--text); font-weight: 600; }
    .clear-all-btn { font-size: 13px; color: var(--danger); background: none; font-weight: 500; }
    .clear-all-btn:hover { text-decoration: underline; }
    .toolbar { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin-bottom: 18px; align-items: center; }
    .toolbar .tb-search { grid-column: span 2; }
    .toolbar select, .toolbar input { min-height: 40px; padding: 8px 10px; }
    .toolbar-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; grid-column: 1 / -1; }
    .view-toggle { display: inline-flex; border: 1.5px solid var(--border); border-radius: var(--radius); overflow: hidden; }
    .view-toggle button { padding: 8px 14px; font-size: 13px; font-weight: 600; color: var(--text-2); min-height: 38px; }
    .view-toggle button[aria-pressed="true"] { background: var(--green); color: #fff; }
    .btn-outline[aria-pressed="true"] { border-color: var(--green-mid); color: var(--accent); background: var(--green-light); }

    /* ── Listings grid ── */
    .listings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
    .more-wrap { text-align: center; margin: 22px 0 4px; }

    /* Card */
    .card { position: relative; background: var(--card); border-radius: var(--radius-lg); border: 1px solid var(--border); overflow: hidden; transition: transform .2s, box-shadow .2s; display: flex; flex-direction: column; }
    .card:hover { transform: translateY(-2px); box-shadow: 0 4px 20px var(--shadow); }
    .card.unavailable { opacity: .82; }
    .card.selected { outline: 2px solid var(--green-mid); outline-offset: -1px; }
    .card.dragging { opacity: .45; }
    .card.drag-over { outline: 2px dashed var(--green-mid); outline-offset: 2px; }
    .card[draggable="true"] { cursor: grab; }
    .card-media { position: relative; }
    .card-img-link { display: block; }
    .card-img-link:focus-visible { outline: 2px solid var(--green-mid); outline-offset: -2px; }
    .card-img { height: 180px; background: var(--surface); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .card-img img { width: 100%; height: 100%; object-fit: cover; }
    .card-img-placeholder { display: flex; flex-direction: column; align-items: center; gap: 6px; color: var(--text-3); }
    .card-img-placeholder svg { width: 32px; height: 32px; opacity: .3; stroke: currentColor; fill: none; stroke-width: 1.5; }
    .badge-featured { position: absolute; top: 10px; left: 10px; background: var(--green-dark); color: white; font-size: 10px; font-weight: 600; padding: 3px 9px; border-radius: 20px; z-index: 2; }
    .badge-unavailable { position: absolute; inset: 0; background: rgba(20,20,18,.6); color: white; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; text-align: center; padding: 12px; z-index: 2; }
    .photo-count { position: absolute; right: 10px; bottom: 10px; background: rgba(0,0,0,.6); color: #fff; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 12px; z-index: 3; pointer-events: none; }
    .photo-nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 3; width: 30px; height: 30px; border-radius: 50%; background: rgba(0,0,0,.5); color: #fff; font-size: 16px; line-height: 1; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .15s; }
    .photo-nav.prev { left: 8px; } .photo-nav.next { right: 8px; }
    .card:hover .photo-nav, .photo-nav:focus-visible { opacity: 1; }
    @media (hover: none) { .photo-nav { opacity: .85; } }
    .sel-box { position: absolute; left: 10px; bottom: 10px; z-index: 4; background: var(--card); border: 1.5px solid var(--border); border-radius: 8px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .sel-box input { width: 18px; height: 18px; padding: 0; accent-color: var(--green); cursor: pointer; }

    .remove-heart-btn, .add-heart-btn {
      position: absolute; top: 10px; right: 10px; z-index: 4;
      width: 36px; height: 36px; border-radius: 50%;
      background: rgba(255,255,255,.95); border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all .15s;
    }
    .remove-heart-btn:hover { background: #FFF5F5; border-color: #C53030; }
    .remove-heart-btn svg { width: 16px; height: 16px; fill: #C53030; stroke: #C53030; stroke-width: 1.5; transition: transform .15s; }
    .remove-heart-btn:hover svg { transform: scale(1.1); }
    .add-heart-btn:hover { background: #E1F5EE; border-color: #0F6E56; }
    .add-heart-btn svg { fill: none; stroke: #4a4a46; width: 16px; height: 16px; stroke-width: 2; transition: all .15s; }
    .add-heart-btn:hover svg { stroke: #085041; transform: scale(1.1); }
    .add-heart-btn.added { pointer-events: none; }
    .add-heart-btn.added svg { fill: #C53030; stroke: #C53030; }

    .card-body { padding: 14px 16px; display: flex; flex-direction: column; flex: 1; }
    .card-top-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
    .card-area { font-size: 11px; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: .06em; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .card-cat-pill { font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 12px; background: var(--surface); color: var(--text-3); border: 1px solid var(--border); white-space: nowrap; }
    .card-cat-pill.apartment, .card-cat-pill.house, .card-cat-pill.boarding { background: var(--green-light); color: var(--accent-strong); border-color: var(--green-mid); }
    .card-cat-pill.airbnb { background: var(--gold-light); color: var(--gold); border-color: var(--gold); }
    .card-cat-pill.commercial { background: var(--surface); color: var(--text-2); border-color: var(--text-3); }
    .card-verified-badge { display: inline-flex; align-items: center; gap: 3px; background: var(--green-light); color: var(--accent-strong); font-size: 9.5px; font-weight: 700; padding: 1px 7px 1px 5px; border-radius: 20px; text-transform: none; letter-spacing: 0; }
    .card-verified-badge svg { width: 9px; height: 9px; stroke: var(--accent-strong); fill: none; stroke-width: 2.6; }
    .card-title { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 3px; line-height: 1.35; }
    .card-sub { font-size: 12px; color: var(--text-3); margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-price { font-size: 17px; font-weight: 700; color: var(--accent-strong); margin-bottom: 4px; }
    .card-price span { font-size: 12px; font-weight: 400; color: var(--text-3); }
    .chip-row { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px; }
    .chip { font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 12px; background: var(--surface); color: var(--text-2); border: 1px solid var(--border); }
    .chip.drop { background: var(--green-light); color: var(--accent-strong); border-color: var(--green-mid); }
    .chip.rise { background: var(--gold-light); color: var(--gold); border-color: var(--gold); }
    .chip.status { background: var(--green-light); color: var(--accent-strong); border-color: var(--green-mid); }
    .chip.status.rejected { background: var(--danger-bg); color: var(--danger); border-color: var(--danger); }
    .chip.folder { background: var(--surface); }
    .chip.viewing { background: var(--gold-light); color: var(--gold); border-color: var(--gold); }
    .card-meta { display: flex; gap: 12px; font-size: 12px; color: var(--text-2); padding-top: 10px; border-top: 1px solid var(--border); margin-bottom: 10px; flex-wrap: wrap; }
    .card-meta-item { display: flex; align-items: center; gap: 4px; }
    .card-meta-item svg { width: 13px; height: 13px; stroke: var(--text-3); fill: none; stroke-width: 2; }
    .card-note { font-size: 12.5px; color: var(--text-2); background: var(--surface); border-left: 3px solid var(--green-mid); border-radius: 6px; padding: 7px 10px; margin-bottom: 10px; white-space: pre-wrap; word-break: break-word; }
    .card-saved-date { font-size: 11px; color: var(--text-3); margin-bottom: 10px; }
    .card-actions { display: flex; gap: 6px; flex-wrap: wrap; margin: 0 0 10px; }
    .act-btn { display: inline-flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; font-weight: 600; padding: 6px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--card); color: var(--text-2); min-height: 34px; transition: all .15s; }
    .act-btn:hover:not(:disabled) { border-color: var(--green-mid); color: var(--accent); }
    .act-btn.wa { border-color: #25D366; color: #128C7E; }
    html[data-theme="dark"] .act-btn.wa { color: #4ADE80; }
    .act-btn.danger { color: var(--danger); }
    .card-reorder { display: flex; gap: 6px; margin-bottom: 8px; }
    .card-view-btn { display: block; text-align: center; width: 100%; padding: 9px; border-radius: var(--radius); background: var(--green); color: white; font-size: 13px; font-weight: 600; transition: background .15s; margin-top: auto; }
    .card-view-btn:hover { background: var(--green-dark); }
    .card-view-btn:focus-visible { outline: 2px solid var(--green-mid); outline-offset: 2px; }
    .card-view-btn.disabled-btn { background: var(--surface); color: var(--text-3); cursor: not-allowed; }

    /* ── Unavailable section ── */
    .unavail { margin-top: 32px; border-top: 1px solid var(--border); padding-top: 18px; }
    .unavail > summary { cursor: pointer; font-weight: 600; font-size: 15px; color: var(--text-2); padding: 6px 0; }
    .unavail-actions { margin: 10px 0 16px; }

    /* ── Map ── */
    #map { height: 480px; border-radius: var(--radius-lg); border: 1px solid var(--border); z-index: 1; }
    .map-note { font-size: 12px; color: var(--text-3); margin-top: 8px; }

    /* ── Skeleton ── */
    .skeleton { background: var(--card); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); }
    .skeleton-img { height: 180px; background: linear-gradient(90deg, var(--sk1) 25%, var(--sk2) 50%, var(--sk1) 75%); background-size: 200% 100%; animation: shimmer 1.4s infinite; }
    .skeleton-body { padding: 14px 16px; }
    .skeleton-line { height: 11px; background: linear-gradient(90deg, var(--sk1) 25%, var(--sk2) 50%, var(--sk1) 75%); background-size: 200% 100%; animation: shimmer 1.4s infinite; border-radius: 4px; margin-bottom: 9px; }
    .skeleton-line.short { width: 55%; }
    .skeleton-line.xshort { width: 35%; }
    @keyframes shimmer { to { background-position: -200% 0; } }

    /* ── Empty / error states ── */
    .empty-state { text-align: center; padding: 60px 20px; color: var(--text-3); }
    .empty-state svg.big { width: 52px; height: 52px; margin: 0 auto 18px; stroke: var(--text-3); opacity: .6; fill: none; stroke-width: 1.5; display: block; }
