    .nk-tab-postcircle svg { width: 20px; height: 20px; stroke: white; }
    .nk-tab-badge { position: absolute; top: 0; right: 22%; background: var(--green); color: white; font-size: 9px; font-weight: 800; min-width: 15px; height: 15px; border-radius: 10px; display: none; align-items: center; justify-content: center; padding: 0 3px; border: 1.5px solid var(--bg); }
