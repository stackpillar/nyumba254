<script>
  function switchTab(tab) {
    document.querySelectorAll('.hero-tab').forEach((btn, i) => {
      const isActive = (i === 0 && tab === 'buyer') || (i === 1 && tab === 'seller');
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-selected', String(isActive));
    });
    document.getElementById('panel-buyer').classList.toggle('active', tab === 'buyer');
    document.getElementById('panel-seller').classList.toggle('active', tab === 'seller');
  }
  const tabParam = new URLSearchParams(window.location.search).get('tab');
  if (tabParam === 'seller') switchTab('seller');

  function toggleFaq(el) {
    el.parentElement.classList.toggle('open');
  }

  function toggleMobileMenu() {
    const nav = document.getElementById('mobile-nav');
    const isOpen = nav.classList.toggle('open');
    document.getElementById('mobile-menu-btn')?.setAttribute('aria-expanded', isOpen);
  }
  document.addEventListener('click', e => {
    const nav = document.getElementById('mobile-nav');
    const btn = document.querySelector('.mobile-menu-btn');
    if (nav && nav.classList.contains('open') && !nav.contains(e.target) && !btn.contains(e.target)) nav.classList.remove('open');
  });

  const NK_COUNTIES = [
