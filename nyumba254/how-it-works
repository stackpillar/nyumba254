<script>
  const SUPABASE_URL = 'https://vliuuloyfhyxcsuchpss.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_oIIcecf3wzKMual5K24Z8Q_zmxVfgsx';
  const { createClient } = supabase;
  const authStorage = {
    getItem: (key) => (localStorage.getItem('ny_remember') === '0' ? sessionStorage : localStorage).getItem(key),
    setItem: (key, value) => (localStorage.getItem('ny_remember') === '0' ? sessionStorage : localStorage).setItem(key, value),
    removeItem: (key) => { localStorage.removeItem(key); sessionStorage.removeItem(key); }
  };
  const db = createClient(SUPABASE_URL, SUPABASE_KEY, { auth: { storage: authStorage, persistSession: true, autoRefreshToken: true } });
  const nkSessionPromise = db.auth.getSession();

  let sid = localStorage.getItem('nk_sid');
  if (!sid) { sid = (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2)); localStorage.setItem('nk_sid', sid); }
  db.from('page_views').insert({ path: location.pathname, referrer: document.referrer || null, user_agent: navigator.userAgent, session_id: sid });

  window.NK_SETTINGS = { trial_days: 14, sale_standard_pct: 0.1, rent_standard_pct: 3, standard_min_fee: 500, standard_max_fee: 18000, standard_fee_per_unit: 50, bnb_basic_price: 700 };
  function fmtKES(n) { return 'KES ' + Number(n).toLocaleString('en-KE'); }
  function applyHiwPricing() {
    const s = window.NK_SETTINGS;
    const el = id => document.getElementById(id);
    if (el('hiw-trial-days')) el('hiw-trial-days').textContent = s.trial_days;
    if (el('hiw-standard-amount')) el('hiw-standard-amount').innerHTML = `${s.rent_standard_pct}%<span class="unit"> of rent, or ${s.sale_standard_pct}% of sale price</span>`;
    if (el('hiw-standard-duration')) el('hiw-standard-duration').innerHTML = `Capped between ${fmtKES(s.standard_min_fee)} and ${fmtKES(s.standard_max_fee)}, plus ${fmtKES(s.standard_fee_per_unit)} per extra unit type on multi-unit properties. Billed only after your listing is approved.`;
    if (el('hiw-bnb-amount')) el('hiw-bnb-amount').innerHTML = `${fmtKES(s.bnb_basic_price)}<span class="unit">/mo</span>`;
  }
  (async function loadHiwSettings() {
    try {
      const { data, error } = await db.from('platform_settings').select('key,value');
      if (!error && data) data.forEach(row => { if (row.key in window.NK_SETTINGS) window.NK_SETTINGS[row.key] = Number(row.value); });
    } catch (e) { console.error('loadHiwSettings exception:', e); }
    applyHiwPricing();
  })();

  nkSessionPromise.then(({ data: { session } }) => {
    if (!session) return;
    const desktopLink = document.getElementById('nav-account-link');
    const mobileLink = document.getElementById('mobile-account-link');
    if (desktopLink) { desktopLink.textContent = 'My account'; desktopLink.href = '/dashboard'; desktopLink.style.fontWeight = '600'; desktopLink.style.color = 'var(--green)'; }
    if (mobileLink) { mobileLink.textContent = 'My account'; mobileLink.href = '/dashboard'; }
  });
</script>
