  function openReviewRespondModal(id) {
    const r = _reviews.find(x=>x.id===id); if(!r) return;
    editingReviewId = id;
    document.getElementById('review-respond-original').textContent = r.comment || '(No comment left — rating only)';
    document.getElementById('review-respond-text').value = r.response_text || '';
    document.getElementById('review-respond-modal').classList.add('open');
    focusModalField('review-respond-modal','#review-respond-text');
  }
  function closeReviewRespondModal() { document.getElementById('review-respond-modal').classList.remove('open'); editingReviewId=null; }
async function toggleReviewPublish(id, isCurrentlyPublished) {
    const newStatus = isCurrentlyPublished ? 'draft' : 'published';
    const { error } = await db.from('reviews').update({ status: newStatus }).eq('id', id);
    if (error) { toast('Error: '+error.message,'error'); return; }
    logAction('toggle_review_publish','review',id,newStatus);
    toast(newStatus==='published' ? 'Review published to pricing page ✓' : 'Review unpublished — removed from pricing page','success');
    const r = _reviews.find(x=>x.id===id);
    if (r) r.status = newStatus;
    renderReviewsTable();
  }
  async function submitReviewResponse() {
    const text = document.getElementById('review-respond-text').value.trim();
    if (!text) { toast('Please write a response first','error'); return; }
    const { error } = await db.from('reviews').update({
      response_text: text, responded_by: currentUser?.id||null, responded_at: new Date().toISOString()
    }).eq('id', editingReviewId);
    if (error) { toast('Error: '+error.message,'error'); return; }
    logAction('respond_review','review',editingReviewId,text);
    toast('Response posted ✓','success');
    closeReviewRespondModal();
    loadReviews();
  }

