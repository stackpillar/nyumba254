async function confirmPayment(p){
  const{error}=await db.from('payments').update({status:'confirmed'}).eq('id',p.id);if(error)throw error;
  if(p.listing_id){
    const{data:row}=await db.from('listings').select('status,publish_at').eq('id',p.listing_id).single();
    const upd={payment_status:'paid'};
    if(row&&['approved_unpaid','approved_unpaid_bnb'].includes(row.status))upd.status=row.publish_at&&new Date(row.publish_at)>new Date()?'scheduled':'active';
    await db.from('listings').update(upd).eq('id',p.listing_id);
    const{data:l}=await db.from('listings').select('title,seller_id,profiles(full_name,email)').eq('id',p.listing_id).single();
    if(l?.profiles?.email)notifySeller('payment_confirmed',{listingId:p.listing_id,listingTitle:l.title,amount:p.amount,sellerName:l.profiles.full_name,sellerEmail:l.profiles.email});
    notifyInApp(l?.seller_id,'payment','Payment confirmed',`Payment of ${KES(p.amount)} for "${l?.title}" was confirmed.`,'/dashboard.html');
    notifySms('payment_confirmed',{listingId:p.listing_id,listingTitle:l?.title,amount:p.amount});
    notifyByEmail('payment_confirmed_admin',{listingId:p.listing_id,listingTitle:l?.title,amount:p.amount,reference:p.reference,sellerName:l?.profiles?.full_name,sellerEmail:l?.profiles?.email});
  }else if(p.type==='bnb_subscription'&&p.seller_id){
    const exp=new Date(Date.now()+30*864e5).toISOString();
    const{data:s}=await db.from('profiles').update({bnb_plan:p.plan_key,bnb_unit_limit:p.plan_key==='bnb_unlimited'?null:p.plan_key==='bnb_bundle'?5:1,bnb_expires_at:exp}).eq('id',p.seller_id).select().single();
    await reactivate(p.seller_id,true);
    if(s?.email)notifySeller('premium_granted',{sellerName:s.full_name,sellerEmail:s.email,plan:p.plan_key,expiresAt:exp});
    notifyInApp(p.seller_id,'payment','BNB plan activated',`Your ${String(p.plan_key).replace('_',' ')} plan is active.`,'/dashboard.html');logAction('activate_bnb_subscription','profile',p.seller_id,p.plan_key);
  }else if((p.type==='premium_subscription'||p.type==='elite_subscription')&&p.seller_id){
    const elite=p.type==='elite_subscription',a=Number(p.amount),yr=elite?S.cfg.elite_yearly_price:S.cfg.premium_yearly_price,mo=elite?S.cfg.elite_monthly_price:S.cfg.premium_monthly_price;
    const tier=Math.abs(a-yr)<Math.abs(a-mo)?'yearly':'monthly',exp=new Date(Date.now()+(tier==='yearly'?365:30)*864e5).toISOString();
    const up={subscription_tier:tier,subscription_plan:elite?'elite':'premium',subscription_expires_at:exp,is_pro:true,has_rental_capacity:true};if(elite)up.has_bnb_capacity=true;
    const{data:s}=await db.from('profiles').update(up).eq('id',p.seller_id).select().single();
    await reactivate(p.seller_id,false);if(elite)await reactivate(p.seller_id,true);
    if(s?.email)notifySeller('premium_granted',{sellerName:s.full_name,sellerEmail:s.email,plan:tier,expiresAt:exp});
    notifyInApp(p.seller_id,'payment','Plan activated',`Your ${elite?'Elite':'Premium'} (${tier}) plan is active.`,'/dashboard.html');logAction('activate_subscription_from_payment','profile',p.seller_id,`${elite?'elite':'premium'} ${tier}`);
  }else if(p.type==='bnb_property_renewal'&&p.bnb_property_id){
    const{data:bp}=await db.from('bnb_properties').select('pre_expiry_bookable').eq('id',p.bnb_property_id).single();
    await db.from('bnb_properties').update({plan_status:'active',plan_expires_at:new Date(Date.now()+30*864e5).toISOString().slice(0,10),is_publicly_bookable:!!bp?.pre_expiry_bookable}).eq('id',p.bnb_property_id);
    logAction('renew_bnb_property','bnb_property',p.bnb_property_id,'');
  }
  logAction('confirm_payment','payment',p.id,p.listing_id||p.type||'');ui.toast('Payment confirmed','ok');
}
