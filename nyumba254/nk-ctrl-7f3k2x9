    if (!filtered.length) {
      tbody.innerHTML    = `<tr><td colspan="8"><div class="table-loading"><p>Nothing here</p></div></td></tr>`;
      mobileEl.innerHTML = `<div class="table-loading"><p>Nothing here</p></div>`;
      return;
