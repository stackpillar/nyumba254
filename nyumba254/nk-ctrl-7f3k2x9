  const paymentActionBusy = new Set();
  async function confirmPayment(id, listingId) {
    if (paymentActionBusy.has(id)) return;
    paymentActionBusy.add(id);
    const {error} = await db.from('payments').update({status:'confirmed'}).eq('id',id);
    if(error){toast('Error confirming','error'); paymentActionBusy.delete(id); return;}

    const p = _payments[id];

    if (listingId) {
      // Confirming payment must flip the listing live immediately — this
      // used to only set payment_status:'paid' and leave status stuck on
      // 'approved_unpaid', so the dashboard kept showing "Awaiting payment"
      // forever even after confirmation.
      const { data: listingRow } = await db.from('listings').select('status, publish_at').eq('id', listingId).single();
      const isFutureScheduled = listingRow?.publish_at && new Date(listingRow.publish_at) > new Date();
      const listingUpdate = { payment_status: 'paid' };
      if (listingRow && (listingRow.status === 'approved_unpaid' || listingRow.status === 'approved_unpaid_bnb')) {
        listingUpdate.status = isFutureScheduled ? 'scheduled' : 'active';
      }
      await db.from('listings').update(listingUpdate).eq('id', listingId);
    } else if (p && p.type === 'bnb_subscription' && p.seller_id) {
      const unitLimit = p.plan_key === 'bnb_unlimited' ? null : p.plan_key === 'bnb_bundle' ? 5 : 1;
      const expiresAt = new Date(Date.now() + 30*86400000).toISOString();
      const { data: seller } = await db.from('profiles').update({
        bnb_plan: p.plan_key, bnb_unit_limit: unitLimit, bnb_expires_at: expiresAt,
      }).eq('id', p.seller_id).select().single();
      await reactivateAirbnbListingsForSeller(p.seller_id);
      if (seller?.email) notifySeller('premium_granted', { sellerName: seller.full_name, sellerEmail: seller.email, plan: p.plan_key, expiresAt });
      logAction('activate_bnb_subscription','profile',p.seller_id, p.plan_key);
    } else if (p && (p.type === 'premium_subscription' || p.type === 'elite_subscription') && p.seller_id) {
      // Subscription payment — auto-activates the plan on confirm, no separate
      // "Grant Premium" step needed.
      const tier = p.type === 'elite_subscription'
        ? (Math.abs(Number(p.amount) - SETTINGS.elite_yearly_price) < Math.abs(Number(p.amount) - SETTINGS.elite_monthly_price) ? 'yearly' : 'monthly')
        : (Math.abs(Number(p.amount) - SETTINGS.premium_yearly_price) < Math.abs(Number(p.amount) - SETTINGS.premium_monthly_price) ? 'yearly' : 'monthly');
      const planName = p.type === 'elite_subscription' ? 'elite' : 'premium';
      const days = tier === 'yearly' ? 365 : 30;
      const expiresAt = new Date(Date.now() + days*86400000).toISOString();
      // Elite covers unlimited BNB capacity too — grant has_bnb_capacity
      // alongside has_rental_capacity whenever the plan being activated is elite.
      const subUpdate = {
        subscription_tier: tier, subscription_plan: planName, subscription_expires_at: expiresAt, is_pro: true,
        has_rental_capacity: true,
      };
      if (planName === 'elite') subUpdate.has_bnb_capacity = true;
      const { data: seller } = await db.from('profiles').update(subUpdate).eq('id', p.seller_id).select().single();
      await reactivateRentalListingsForSeller(p.seller_id);
      if (planName === 'elite') await reactivateAirbnbListingsForSeller(p.seller_id);
      if (seller?.email) notifySeller('premium_granted', { sellerName: seller.full_name, sellerEmail: seller.email, plan: tier, expiresAt });
      logAction('activate_subscription_from_payment','profile',p.seller_id,`${planName} ${tier}`);
    }

    paymentActionBusy.delete(id);
    logAction('confirm_payment','payment',id,listingId||'');

    if (listingId) {
      const { data: l } = await db.from('listings').select('title, profiles(full_name, email)').eq('id', listingId).single();
      if (l?.profiles?.email) {
        notifySeller('payment_confirmed', {
          listingId, listingTitle: l.title, amount: p?.amount,
          sellerName: l.profiles.full_name, sellerEmail: l.profiles.email,
        });
      }
      notifySms('payment_confirmed', { listingId, listingTitle: l?.title, amount: p?.amount });
      notifyByEmail('payment_confirmed_admin', {
        listingId, listingTitle: l?.title, amount: p?.amount, reference: p?.reference,
        sellerName: l?.profiles?.full_name, sellerEmail: l?.profiles?.email,
      });
    }

    toast('Payment confirmed ✓','success');
    loadPayments(); loadOverview();
    if (currentView === 'premium-sellers') loadPremiumSellers();
  }

