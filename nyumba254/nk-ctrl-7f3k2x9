          <div class="mobile-card-row"><span>Comment</span><span style="text-align:right;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r.comment||'—')}</span></div>
          <div class="mobile-card-row"><span>Response</span><span>${r.response_text?'Sent':'None'}</span></div>
          <div class="mobile-card-row"><span>Date</span><span>${fmtDate(r.created_at)}</span></div>
        </div>
        <div class="mobile-card-actions">
