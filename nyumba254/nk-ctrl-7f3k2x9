const ov=()=>$('#ov');
function fieldHtml(f){
  const id='f_'+f.id,v=f.value??'';
  if(f.type==='checkbox')return `<label class="chk"><input type="checkbox" id="${id}" ${v?'checked':''}> ${esc(f.label)}</label>`;
  let inp;
  if(f.type==='textarea')inp=`<textarea id="${id}" rows="${f.rows||3}" placeholder="${esc(f.placeholder||'')}">${esc(v)}</textarea>`;
  else if(f.type==='select')inp=`<select id="${id}">${f.options.map(o=>`<option value="${esc(o.v)}" ${String(o.v)===String(v)?'selected':''}>${esc(o.l)}</option>`).join('')}</select>`;
  else inp=`<input id="${id}" type="${f.type||'text'}" value="${esc(v)}" placeholder="${esc(f.placeholder||'')}" ${f.step?`step="${f.step}"`:''}>`;
  return `<div class="fld"><label for="${id}">${esc(f.label)}</label>${inp}${f.help?`<small>${esc(f.help)}</small>`:''}</div>`;
}
const ui={
  active:null,
  toast(msg,type='',act){
    const t=document.createElement('div');t.className='toast '+type;t.setAttribute('role',type==='err'?'alert':'status');
    t.innerHTML=`<span>${esc(msg)}</span>${act?`<button class="tl">${esc(act.label)}</button>`:''}`;
    if(act)$('.tl',t).onclick=()=>{t.remove();act.fn();};
    $('#toasts').appendChild(t);setTimeout(()=>t.remove(),act?7500:4200);
  },
  open(html,cls=''){const w=document.createElement('div');w.className='scrim '+cls;w.innerHTML=html;ov().appendChild(w);return w;},
  modal({title,body,foot,wide,cls,onOpen}){
    return new Promise(res=>{
      const w=ui.open(`<div class="modal ${wide?'wide':''} ${cls||''}" role="dialog" aria-modal="true" aria-label="${esc(title)}"><div class="mh"><h3>${esc(title)}</h3><button class="btn ghost icon" data-x aria-label="Close">${icon('x')}</button></div><div class="mb">${body}</div><div class="mf">${foot||''}</div></div>`);
      const prev=document.activeElement;
      const close=v=>{w.remove();document.removeEventListener('keydown',onKey,true);prev&&prev.focus&&prev.focus();res(v===undefined?null:v);};
      const onKey=e=>{if(e.key==='Escape'&&w===ov().lastElementChild){e.stopPropagation();close(null);}};
      document.addEventListener('keydown',onKey,true);
      w.addEventListener('mousedown',e=>{if(e.target===w)close(null);});
      w.addEventListener('click',e=>{if(e.target.closest('[data-x]'))close(null);const v=e.target.closest('[data-v]');if(v)close(v.dataset.v);});
      if(onOpen)onOpen(w,close);
      setTimeout(()=>($('input:not([type=checkbox]),textarea,select',w)||$('.btn.pri,.btn.bad',w)||w).focus?.(),30);
    });
  },
  form({title,fields,submit='Save',danger,intro,wide,onOpen}){
    return ui.modal({title,wide,body:(intro?`<p class="intro">${intro}</p>`:'')+fields.map(fieldHtml).join(''),
      foot:`<button class="btn" data-x>Cancel</button><button class="btn ${danger?'bad':'pri'}" data-sub>${esc(submit)}</button>`,
      onOpen:(w,close)=>{
        const go=()=>{const out={};
          for(const f of fields){const el=$('#f_'+f.id,w);if(!el)continue;
            const v=f.type==='checkbox'?el.checked:f.type==='number'?(el.value===''?null:parseFloat(el.value)):el.value.trim();
            if(f.required&&(v===''||v===null)){el.setAttribute('aria-invalid','true');el.focus();ui.toast(`${f.label} is required`,'err');return;}
            out[f.id]=v;}
          close(out);};
        $('[data-sub]',w).onclick=go;
        w.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey&&!['TEXTAREA','BUTTON'].includes(e.target.tagName)){e.preventDefault();go();}});
        onOpen&&onOpen(w);
      }});
  },
  async confirm({title,message,confirm='Confirm',danger}){
    return (await ui.modal({title,body:`<p class="intro">${message}</p>`,foot:`<button class="btn" data-x>Cancel</button><button class="btn ${danger?'bad':'pri'}" data-v="1">${esc(confirm)}</button>`}))==='1';
  },
  async ask({title,message,label='Reason',confirm,danger,required=true,type='textarea',value=''}){
    const r=await ui.form({title,intro:message,fields:[{id:'v',label,type,required,value}],submit:confirm||'Confirm',danger});return r?r.v:null;
  },
  async typed(word,title,message){
    const r=await ui.form({title,intro:message,fields:[{id:'v',label:`Type ${word} to confirm`,required:true}],submit:'Delete permanently',danger:true});
    return !!r&&r.v.toUpperCase()===word;
  },
  drawer(title,html,foot=''){
    const w=ui.open(`<aside class="drawer" role="dialog" aria-modal="true" aria-label="${esc(title)}"><div class="mh"><h3>${esc(title)}</h3><button class="btn ghost icon" data-x aria-label="Close">${icon('x')}</button></div><div class="mb">${html}</div><div class="mf">${foot}</div></aside>`,'right');
    const close=()=>{w.remove();document.removeEventListener('keydown',onKey);};
    const onKey=e=>{if(e.key==='Escape'&&w===ov().lastElementChild)close();};
    document.addEventListener('keydown',onKey);
    w.addEventListener('mousedown',e=>{if(e.target===w)close();});
    w.addEventListener('click',e=>{if(e.target.closest('[data-x]'))close();});
    return{el:w,close,body:$('.mb',w),foot:$('.mf',w),set(h){$('.mb',w).innerHTML=h;}};
  },
  menu(anchor,items){
    ui.closeMenu();items=items.filter(i=>!i.hide);
    const m=document.createElement('div');m.className='menu';m.setAttribute('role','menu');
    m.innerHTML=items.map((i,k)=>i.sep?`<div class="sep">${esc(i.sep)}</div>`:`<button role="menuitem" class="${i.danger?'bad':''}" data-k="${k}">${esc(i.label)}</button>`).join('');
    document.body.appendChild(m);
    const r=anchor.getBoundingClientRect(),w=m.offsetWidth,h=m.offsetHeight;
    m.style.left=Math.max(8,Math.min(r.right-w,innerWidth-w-8))+'px';
    m.style.top=(r.bottom+h+8>innerHeight?Math.max(8,r.top-h-4):r.bottom+4)+'px';
    m.onclick=e=>{const b=e.target.closest('[data-k]');if(!b)return;ui.closeMenu();items[+b.dataset.k].fn();};
    ui._md=e=>{if(!m.contains(e.target))ui.closeMenu();};
    setTimeout(()=>document.addEventListener('mousedown',ui._md),0);
    ui._m=m;$('button',m)?.focus();
  },
  closeMenu(){ui._m?.remove();ui._m=null;document.removeEventListener('mousedown',ui._md);}
};

/* ───── data table engine ───── */
function Table(cfg){
  const PAGE=cfg.size||50,p=cfg.params||{};
  const st={tab:cfg.tabs?(cfg.tabs.find(t=>t.id===p.tab)?p.tab:cfg.tabs[0].id):null,q:p.q||'',page:0,sort:cfg.sort?{...cfg.sort}:null,f:{},sel:new Set(),map:new Map(),acts:new Map(),rows:[],count:null,hasMore:false,all:null,dirty:true,focus:-1,counts:{}};
  (cfg.paramKeys||(cfg.filters||[]).map(f=>f.id)).forEach(k=>{if(p[k])st.f[k]=p[k];});
  let root,seq=0;const T={st,cfg};
  const R=s=>$(s,root);
  function sync(){
    const q=new URLSearchParams();
    if(cfg.tabs&&st.tab!==cfg.tabs[0].id)q.set('tab',st.tab);if(st.q)q.set('q',st.q);
    Object.entries(st.f).forEach(([k,v])=>v&&q.set(k,v));
    history.replaceState(null,'',`#/${cfg.route}${q.toString()?'?'+q:''}`);
  }
  function shell(){
    root.innerHTML=`<div class="tb-top"><label class="search">${icon('search')}<input type="search" placeholder="${esc(cfg.search||'Search…')}" value="${esc(st.q)}" aria-label="Search"><kbd>/</kbd></label><div class="filters"></div><div style="margin-left:auto;display:flex;gap:8px">${(cfg.toolbar||[]).map((b,i)=>`<button class="btn ${b.cls||''}" data-tb="${i}">${esc(b.label)}</button>`).join('')}${cfg.csv?`<button class="btn" data-exp>${icon('dl')}Export</button>`:''}</div></div>
    ${cfg.tabs?'<div class="tabs" role="tablist"></div>':''}<div class="chips"></div><div class="hdr"></div><div class="bulk" hidden></div>
    <div class="card"><div class="tw"><table><thead></thead><tbody></tbody></table></div><div class="pager"></div></div>`;
    $('.search input',root).oninput=debounce(e=>{st.q=e.target.value.trim();st.page=0;st.sel.clear();if(cfg.remoteSearch)st.dirty=true;sync();load();},300);
    root.onclick=async e=>{
      const t=e.target.closest('.tabs button');if(t){st.tab=t.dataset.t;st.page=0;st.sel.clear();st.map.clear();sync();load();return;}
      const tb=e.target.closest('[data-tb]');if(tb){await cfg.toolbar[+tb.dataset.tb].fn(T);return;}
      if(e.target.closest('[data-exp]'))return exportCsv();
      const ch=e.target.closest('[data-chip]');if(ch){chipsNow[+ch.dataset.chip].clear();st.page=0;sync();paintFilters();load();return;}
      const th=e.target.closest('th.s');if(th){const k=th.dataset.k;st.sort=st.sort&&st.sort.key===k?{key:k,dir:st.sort.dir==='asc'?'desc':'asc'}:{key:k,dir:'desc'};st.page=0;load();return;}
      if(e.target.closest('[data-pg]')){st.page+=e.target.closest('[data-pg]').dataset.pg==='n'?1:-1;load();root.scrollIntoView({block:'start'});return;}
      if(e.target.closest('[data-all]')){const on=e.target.closest('[data-all]').checked;st.rows.forEach(r=>on?st.sel.add(String(cfg.id(r))):st.sel.delete(String(cfg.id(r))));paintBody();paintBulk();return;}
      if(e.target.closest('[data-retry]'))return T.reload(false);
    };
    R('tbody').onclick=e=>{
      const tr=e.target.closest('tr[data-id]');if(!tr)return;const id=tr.dataset.id,r=st.map.get(id);
      const cb=e.target.closest('.c-sel input');if(cb){cb.checked?st.sel.add(id):st.sel.delete(id);tr.classList.toggle('sel',cb.checked);paintBulk();return;}
      const ab=e.target.closest('[data-a]');if(ab){run(st.acts.get(id)[+ab.dataset.a],r,ab);return;}
      const mo=e.target.closest('[data-more]');if(mo){ui.menu(mo,st.acts.get(id).map(a=>({...a,fn:()=>run(a,r)})));return;}
      if(e.target.closest('a,button,input,select,textarea'))return;
      cfg.open&&cfg.open(r,T);
    };
    paintFilters();
  }
  let chipsNow=[];
  function paintFilters(){
    R('.filters').innerHTML=(cfg.filters||[]).map(f=>f.type==='date'
      ?`<input type="date" data-f="${f.id}" value="${esc(st.f[f.id]||'')}" aria-label="${esc(f.label)}" title="${esc(f.label)}">`
      :`<select data-f="${f.id}" aria-label="${esc(f.label)}" ${f.disabled&&f.disabled(st)?'disabled':''}><option value="">${esc(f.all)}</option>${f.options(st).map(o=>`<option value="${esc(o.v)}" ${String(st.f[f.id]||'')===String(o.v)?'selected':''}>${esc(o.l)}</option>`).join('')}</select>`).join('');
    $$('[data-f]',root).forEach(el=>el.onchange=async()=>{st.f[el.dataset.f]=el.value;st.page=0;st.sel.clear();if(cfg.onFilter)await cfg.onFilter(el.dataset.f,st);if(cfg.refetchOnFilter)st.dirty=true;sync();paintFilters();load();});
    paintChips();
  }
  function paintChips(){
    chipsNow=cfg.chips?cfg.chips(st):[];
    R('.chips').innerHTML=chipsNow.map((c,i)=>`<span class="chip">${esc(c.label)}<button data-chip="${i}" aria-label="Remove filter">×</button></span>`).join('');
  }
  function paintTabs(){
    if(!cfg.tabs)return;
    R('.tabs').innerHTML=cfg.tabs.map(t=>`<button role="tab" data-t="${t.id}" class="${t.id===st.tab?'on':''}" aria-selected="${t.id===st.tab}">${esc(t.label)}${st.counts[t.id]!=null?`<span class="n">${st.counts[t.id]}</span>`:''}</button>`).join('');
  }
