            ${aBtn('message','Message seller','message',`messageSellerInChat('${p.id}')`)}
            ${hasRental?aBtn('reject','Revoke Premium','reject',`revokePremiumFlow('${p.id}')`):''}
            ${hasBnb?aBtn('reject','Revoke BNB plan','reject',`revokeBnbFlow('${p.id}')`):''}` : `
            ${aBtn('upgrade','Grant Premium','approve',`openGrantPremiumModal('${p.id}')`)}
            ${aBtn('message','Message seller','message',`messageSellerInChat('${p.id}')`)}`;
      const menuActions = subscribed ? [
            ...(p.subscription_plan==='elite'?[{label:'🔗 Open storefront', cls:'', fn:`window.open('/storefront?seller=${p.id}','_blank','noopener,noreferrer')`}]:[]),
            {label:'Change plan / extend', cls:'', fn:`openGrantPremiumModal('${p.id}')`},
            {label:'Message seller', cls:'blue', fn:`messageSellerInChat('${p.id}')`},
            ...(hasRental?[{label:'Revoke Premium', cls:'danger', fn:`revokePremiumFlow('${p.id}')`}]:[]),
            ...(hasBnb?[{label:'Revoke BNB plan', cls:'danger', fn:`revokeBnbFlow('${p.id}')`}]:[]),
          ] : [
            {label:'Grant Premium', cls:'success', fn:`openGrantPremiumModal('${p.id}')`},
            {label:'Message seller', cls:'blue', fn:`messageSellerInChat('${p.id}')`},
          ];
      return `<tr>
        <td>${esc(p.full_name||'—')}<div class="listing-meta">${esc(p.email||'')}${p.phone?' · '+esc(p.phone):''}</div></td>
        <td>${planCell}</td>
        <td>${tierCell}</td>
        <td>${p.is_pro?'<span class="badge active">✓ Pro badge</span>':'<span class="badge standard">Off</span>'}</td>
