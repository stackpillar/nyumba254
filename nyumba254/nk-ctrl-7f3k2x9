  async function loadVerification() {
    const tbody    = document.getElementById('verification-body');
    const mobileEl = document.getElementById('verification-mobile');
    tbody.innerHTML = `<tr class="skeleton-row"><td colspan="4"><div class="skel"></div></td></tr>`.repeat(3);
    mobileEl.innerHTML = '';

    let q = db.from('profiles').select('*').neq('role','admin');
    q = verificationTab === 'verified'
      ? q.eq('verification_status','verified').order('verification_reviewed_at',{ascending:false})
      : q.or('verification_status.eq.pending,extra_verification_status.eq.submitted').order('verification_submitted_at',{ascending:false});
    const { data, error } = await q;

    // Badge and tab counts always reflect the live totals, not just whichever tab is open.
    const { count: pendingCount } = await db.from('profiles').select('*',{count:'exact',head:true}).neq('role','admin').eq('verification_status','pending');
    const { count: verifiedCount } = await db.from('profiles').select('*',{count:'exact',head:true}).neq('role','admin').eq('verification_status','verified');
    document.getElementById('nav-badge-verification').textContent = pendingCount||0;
    const vtcP = document.getElementById('vtc-pending');  if (vtcP) vtcP.textContent = pendingCount||0;
    const vtcV = document.getElementById('vtc-verified'); if (vtcV) vtcV.textContent = verifiedCount||0;

    const isVerifiedTab = verificationTab === 'verified';

    if (error || !data?.length) {
      const emptyMsg = isVerifiedTab ? 'No verified sellers yet' : 'Nothing pending review';
      tbody.innerHTML    = `<tr><td colspan="4"><div class="table-loading"><p>${emptyMsg}</p></div></td></tr>`;
      mobileEl.innerHTML = `<div class="table-loading"><p>${emptyMsg}</p></div>`;
      return;
    }
    _verifySellers = {}; data.forEach(p=>{_verifySellers[p.id]=p;});

    tbody.innerHTML = data.map(p => {
      const menuItems = isVerifiedTab ? [
        {label:'Revoke verification', cls:'danger', fn:`revokeVerification('${p.id}')`},
      ] : [
        {label:'View ID (front)', cls:'', fn:`viewVerifyDoc('${p.id}','id')`},
        {label:'View ID (back)',  cls:'', fn:`viewVerifyDoc('${p.id}','id2')`},
        {label:'View proof of ownership', cls:'', fn:`viewVerifyDoc('${p.id}','proof')`},
        ...(p.verification_status==='pending'?[
          {label:'✓ Approve', cls:'success', fn:`approveVerification('${p.id}')`},
          {label:'✕ Reject',  cls:'danger',  fn:`rejectVerification('${p.id}')`},
        ]:[]),
        ...(p.extra_verification_status==='submitted'?[{label:'Approve extra docs', cls:'success', fn:`approveExtraVerification('${p.id}')`}]:[]),
        {label:'Request extra documents', cls:'blue', fn:`requestExtraVerification('${p.id}')`},
      ];
      const actionsHtml = isVerifiedTab
        ? aBtn('reject','Revoke verification','reject',`revokeVerification('${p.id}')`)
        : `${aBtn('idcard','View ID (front)','view',`viewVerifyDoc('${p.id}','id')`)}${aBtn('idcard','View ID (back)','view',`viewVerifyDoc('${p.id}','id2')`)}${aBtn('doc','View proof of ownership','view',`viewVerifyDoc('${p.id}','proof')`)}${p.verification_status==='pending'?(aBtn('approve','Approve','approve',`approveVerification('${p.id}')`)+aBtn('reject','Reject','reject',`rejectVerification('${p.id}')`)):''}${p.extra_verification_status==='submitted'?aBtn('approve','Approve extra docs','approve',`approveExtraVerification('${p.id}')`):''}${aBtn('mail','Request extra documents','message',`requestExtraVerification('${p.id}')`)}`;
      return `<tr>
        <td>${esc(p.full_name||'—')}<div class="listing-meta">${esc(p.email||'')}</div></td>
        <td>${isVerifiedTab ? '<span class="badge active">✓ Verified — documents not shown here</span>' : `${p.verification_is_owner===false?'Not owner':'Owner'}${p.extra_verification_status==='submitted'?' · Extra docs submitted':''}`}</td>
        <td>${isVerifiedTab ? (p.verification_reviewed_at?fmtDate(p.verification_reviewed_at):'—') : (p.verification_submitted_at?fmtDate(p.verification_submitted_at):'—')}</td>
        <td>
          <div class="action-btns">${actionsHtml}</div>
          ${mobileMenu(p.id, menuItems)}
        </td>
      </tr>`;
    }).join('');

    mobileEl.innerHTML = data.map(p => `<div class="mobile-card">
      <div class="mobile-card-header">
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;font-size:13px">${esc(p.full_name||'—')}</div>
          <div style="font-size:11px;color:var(--text-3)">${esc(p.email||'')}</div>
        </div>
        <span class="badge ${isVerifiedTab?'active':'pending'}">${isVerifiedTab?'verified':(p.verification_status==='pending'?'pending':'extra docs')}</span>
      </div>
      <div class="mobile-card-body">
        ${isVerifiedTab
          ? `<div class="mobile-card-row"><span>Verified on</span><span>${p.verification_reviewed_at?fmtDate(p.verification_reviewed_at):'—'}</span></div>`
          : `<div class="mobile-card-row"><span>Ownership</span><span>${p.verification_is_owner===false?'Not owner':'Owner'}</span></div>
             <div class="mobile-card-row"><span>Submitted</span><span>${p.verification_submitted_at?fmtDate(p.verification_submitted_at):'—'}</span></div>`}
      </div>
      <div class="mobile-card-actions">
        ${isVerifiedTab
          ? aBtn('reject','Revoke','reject',`revokeVerification('${p.id}')`)
          : `${aBtn('idcard','ID front','view',`viewVerifyDoc('${p.id}','id')`)}${aBtn('idcard','ID back','view',`viewVerifyDoc('${p.id}','id2')`)}${aBtn('doc','Proof','view',`viewVerifyDoc('${p.id}','proof')`)}${p.verification_status==='pending'?(aBtn('approve','Approve','approve',`approveVerification('${p.id}')`)+aBtn('reject','Reject','reject',`rejectVerification('${p.id}')`)):''}${p.extra_verification_status==='submitted'?aBtn('approve','Approve extra','approve',`approveExtraVerification('${p.id}')`):''}`}
      </div>
    </div>`).join('');
  }

  async function viewVerifyDoc(sellerId, kind) {
    const p = _verifySellers[sellerId]; if (!p) return;
    const path = kind==='id' ? p.verification_id_url : kind==='id2' ? p.verification_id_url_2 : p.verification_proof_url;
    if (!path) { toast('No document uploaded','error'); return; }
    const { data, error } = await db.storage.from('verification-docs').createSignedUrl(path, 3600);
    if (error || !data?.signedUrl) { toast('Could not open document: '+(error?.message||''),'error'); return; }
    window.open(data.signedUrl, '_blank', 'noopener,noreferrer');
  }

  async function approveVerification(sellerId) {
    const p = _verifySellers[sellerId]; if (!p) return;
    const { error } = await db.from('profiles').update({ verification_status:'verified', verification_reviewed_at:new Date().toISOString(), verification_reviewed_by: currentUser.id }).eq('id', sellerId);
    if (error) { toast('Error: '+error.message,'error'); return; }
    await db.from('verification_activity_log').insert({ seller_id: sellerId, action:'approved', admin_id: currentUser.id });
    notifySeller('verification_approved', { sellerName: p.full_name, sellerEmail: p.email });
    toast('Seller verified ✓','success');
    loadVerification();
  }

  function rejectVerification(sellerId) {
    const p = _verifySellers[sellerId]; if (!p) return;
    openConfirm({ title:'Reject verification?', message:`${p.full_name||'This seller'} will be asked to resubmit.`, requireReason:true, reasonLabel:'Reason (shown to seller)', confirmText:'Reject', confirmClass:'reject', onConfirm: async (reason) => {
      const { error } = await db.from('profiles').update({ verification_status:'rejected', verification_rejection_reason: reason, verification_reviewed_at:new Date().toISOString(), verification_reviewed_by: currentUser.id }).eq('id', sellerId);
      if (error) { toast('Error: '+error.message,'error'); return; }
      await db.from('verification_activity_log').insert({ seller_id: sellerId, action:'rejected', detail: reason, admin_id: currentUser.id });
      notifySeller('verification_rejected', { sellerName: p.full_name, sellerEmail: p.email, reason });
      toast('Verification rejected','success');
      loadVerification();
    }});
  }

  async function approveExtraVerification(sellerId) {
