  // ══════════════════════════════════════════════════════════════
  // ACW — Admin Chat Widget
  // A trimmed, embedded version of admin-chat.html. Runs its badge
  // + realtime subscriptions from the moment the dashboard loads,
  // regardless of whether the panel itself is ever opened, so the
  // launcher badge reflects new messages instantly.
  // ══════════════════════════════════════════════════════════════
  const ACW = (() => {
    let sessions = [];
    let activeId = null;
    let messages = [];
    let filter = 'all';
    let search = '';
    let msgChannel = null;
    let globalChannel = null;
    let typingChannel = null;
    let typingHideTimer = null;
    let adminTypingTimer = null;
    let isOpen = false;
    let currentSellerName = null;
    let currentThreadSessionKey = null;
    let currentIsSellerThread = false;
    let _acwSellerCache = {};

    function escT(s) { return esc(s); }

    function isSeller(s) {
      if (!s) return false;
      if (s.session_type === 'seller') return true;
      if ((s.session_key||'').startsWith('seller_')) return true;
      return false;
    }
    function otherLabel(s) {
      return (s && s.visitor_name && s.visitor_name.trim()) ? s.visitor_name.trim() : 'Visitor';
    }
    function timeAgo(iso) {
      const m = Math.floor((Date.now()-new Date(iso))/60000);
      if (m<1) return 'now'; if (m<60) return `${m}m`;
      const h = Math.floor(m/60); if (h<24) return `${h}h`;
      const d = Math.floor(h/24); if (d<7) return `${d}d`;
      return new Date(iso).toLocaleDateString('en-KE',{day:'numeric',month:'short'});
    }

    let pollTimer = null;

    async function refreshBadge() {
      try {
        const { data, error } = await db.from('chat_sessions').select('unread_admin').eq('is_resolved', false);
        if (error) { console.error('ACW refreshBadge error:', error); return; }
        const total = (data||[]).reduce((s,r)=>s+(r.unread_admin||0),0);
        const badge = document.getElementById('acw-launcher-badge');
        badge.textContent = total > 99 ? '99+' : total;
        badge.classList.toggle('show', total > 0);
        const unreadTab = document.getElementById('acw-badge-unread');
        if (unreadTab) {
          unreadTab.textContent = total;
          unreadTab.style.display = total > 0 ? 'inline-flex' : 'none';
        }
        document.title = total > 0 ? `(${total}) Admin — Nyumba254` : 'Admin Dashboard — Nyumba254';
      } catch (e) {
        console.error('ACW refreshBadge exception:', e);
      }
    }

    function subscribeGlobal() {
      if (globalChannel) globalChannel.unsubscribe();
      globalChannel = db.channel('acw-global-watch')
        .on('postgres_changes', {event:'*', schema:'public', table:'chat_sessions'}, () => {
          refreshBadge();
          if (isOpen) loadList();
        })
        .on('postgres_changes', {event:'INSERT', schema:'public', table:'chat_messages'}, p => {
          if (p.new.sender !== 'admin') {
            refreshBadge();
            if (isOpen) loadList();
            notifyNewMessage(p.new);
          }
        })
        .subscribe((status) => {
          if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT' || status === 'CLOSED') {
            console.warn('ACW realtime channel status:', status, '— relying on polling fallback');
          }
        });

      // Safety-net poll: some networks/proxies silently never establish or
      // drop the realtime websocket, which would otherwise leave the badge
      // stuck. Polling guarantees it still catches up within a few seconds.
      if (pollTimer) clearInterval(pollTimer);
      pollTimer = setInterval(refreshBadge, 8000);

      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) refreshBadge();
      });
      window.addEventListener('focus', refreshBadge);

      if ('Notification' in window && Notification.permission === 'default') {
        Notification.requestPermission().catch(()=>{});
      }
    }

    // Sound ping — synthesized via Web Audio, no external asset needed.
    function playPing() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.type = 'sine'; osc.frequency.value = 880;
        gain.gain.setValueAtTime(0.0001, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.15, ctx.currentTime + 0.01);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.35);
        osc.start(); osc.stop(ctx.currentTime + 0.35);
      } catch (e) { /* Web Audio unavailable — silently skip */ }
    }

    // Browser notification + sound for a new incoming message. Only fires a
    // desktop notification when the tab is backgrounded (matches how most
    // chat apps behave) — sound plays either way as a lighter-weight cue.
    function notifyNewMessage(msg) {
      playPing();
      if (document.hidden && 'Notification' in window && Notification.permission === 'granted') {
        try {
          const n = new Notification('New message — Nyumba254 Admin', {
            body: (msg.body || '').slice(0, 120),
            tag: 'nk-admin-chat',
          });
          n.onclick = () => { window.focus(); n.close(); };
        } catch (e) { /* Notification constructor can throw in some contexts — ignore */ }
      }
    }

    async function loadList() {
      const { data } = await db.from('chat_sessions').select('*').order('last_msg_at',{ascending:false, nullsFirst:false});
      sessions = data || [];
      renderList();
      renderTabBadges();
    }

    async function markAllRead() {
      const unreadIds = sessions.filter(s => (s.unread_admin||0) > 0).map(s => s.id);
      if (!unreadIds.length) { toast('Nothing to mark — all caught up','success'); return; }
      await db.from('chat_sessions').update({unread_admin:0}).in('id', unreadIds);
      sessions.forEach(s => { if (unreadIds.includes(s.id)) s.unread_admin = 0; });
      renderList();
      renderTabBadges();
      refreshBadge();
      toast('All conversations marked read ✓','success');
    }

    // Per-tab badges count actual unread MESSAGES (sum of unread_admin),
    // not just "1" per conversation with unread mail — e.g. a seller
    // thread with 5 unread messages shows "5", not a flat presence dot.
    function renderTabBadges() {
      const counts = { all: 0, unread: 0, open: 0, sellers: 0, visitors: 0 };
      sessions.forEach(s => {
        const n = s.unread_admin || 0;
        counts.all += n;
        if (n > 0) counts.unread += n;
        if (!s.is_resolved) counts.open += n;
        if (isSeller(s)) counts.sellers += n; else counts.visitors += n;
      });
      Object.entries(counts).forEach(([key, val]) => {
        const el = document.getElementById('acw-badge-' + key);
        if (!el) return;
        el.textContent = val > 99 ? '99+' : val;
        el.style.display = val > 0 ? 'inline-flex' : 'none';
      });
    }

    function renderList() {
      const listEl = document.getElementById('acw-list');
      let filtered = sessions.filter(s => {
        if (filter==='unread')   return (s.unread_admin||0) > 0;
        if (filter==='open')     return !s.is_resolved;
        if (filter==='sellers')  return isSeller(s);
        if (filter==='visitors') return !isSeller(s);
        return true;
      });
      if (search.trim()) {
        const q = search.toLowerCase();
        filtered = filtered.filter(s => (s.visitor_name||'').toLowerCase().includes(q) || (s.page||'').toLowerCase().includes(q));
      }
      if (!filtered.length) {
        listEl.innerHTML = `<div class="acw-empty">No conversations found</div>`;
        return;
      }
      listEl.innerHTML = filtered.map(s => {
        const seller = isSeller(s);
        const name = otherLabel(s);
        const unread = (s.unread_admin||0) > 0;
        return `<div class="acw-item${unread?' unread':''}" onclick="ACW.openThread('${s.id}')">
          <div class="acw-item-top">
            <span class="acw-item-name">${escT(name)}</span>
            <span class="acw-item-time">${s.last_msg_at?timeAgo(s.last_msg_at):''}</span>
          </div>
          <div class="acw-item-preview">${s.is_resolved?'Resolved conversation':(unread?`${s.unread_admin} new message(s)`:'Tap to view')}</div>
          <div class="acw-item-meta">
            ${unread?'<span class="acw-dot"></span>':''}
            <span class="acw-tag ${seller?'seller':''}">${seller?'Seller':'Visitor'}</span>
            ${s.is_resolved?'<span class="acw-tag resolved">Resolved</span>':''}
          </div>
        </div>`;
      }).join('');
    }

    function setFilter(f, btn) {
      filter = f;
      document.querySelectorAll('.acw-tab').forEach(t=>t.classList.remove('active'));
      btn.classList.add('active');
      renderList();
    }
    function filterList() {
      search = document.getElementById('acw-search-input').value;
      renderList();
    }

    async function openThread(id) {
      activeId = id;
      await db.from('chat_sessions').update({unread_admin:0}).eq('id', id);
      refreshBadge();

      document.getElementById('acw-list-pane').classList.add('hidden-on-thread');
      document.getElementById('acw-newchat-pane').classList.remove('active');
      document.getElementById('acw-thread-pane').classList.add('active');

      // Fetch the session directly rather than relying on the cached list —
      // the list may not have loaded yet (e.g. opening straight from a
      // seller's profile), which previously left the header showing
      // placeholder text even though the thread itself worked.
      let s = sessions.find(x=>x.id===id);
      if (!s) {
        const { data } = await db.from('chat_sessions').select('*').eq('id', id).single();
        s = data || {};
        if (s.id) sessions.push(s);
      } else {
        s.unread_admin = 0;
      }
      renderTabBadges();
      document.getElementById('acw-thread-name').textContent = otherLabel(s);
      document.getElementById('acw-thread-meta').textContent = isSeller(s) ? 'Registered seller' : `Visitor · ${(s.page||'').replace('.html','')}`;

      // No guessing at a profile id from the session_key — just remember
      // exactly what this open thread already is. "+ New" builds a fresh
      // session directly off these, so it can never fall through to search.
      currentThreadSessionKey = s.session_key || null;
      currentSellerName       = otherLabel(s);
      currentIsSellerThread   = isSeller(s);

      const resolveBtn = s.is_resolved
        ? `<button class="acw-mini-btn reopen" onclick="ACW.reopen('${id}')">Reopen</button>`
        : `<button class="acw-mini-btn resolve" onclick="ACW.resolve('${id}')">Resolve</button>`;
      const newMsgBtn = currentIsSellerThread
        ? `<button class="acw-mini-btn" onclick="ACW.startNewTopicForCurrentSeller()">+ New</button>`
        : '';
      document.getElementById('acw-thread-actions').innerHTML = newMsgBtn + resolveBtn;

      document.getElementById('acw-resolved-note').style.display = s.is_resolved ? 'block' : 'none';
      document.getElementById('acw-reply-inner').style.display = s.is_resolved ? 'none' : 'flex';

      await loadMessages(id);
      subscribeMessages(id);
      if (!s.is_resolved) document.getElementById('acw-reply-input')?.focus({preventScroll:true});
    }

    function backToList() {
      document.getElementById('acw-list-pane').classList.remove('hidden-on-thread');
      document.getElementById('acw-thread-pane').classList.remove('active');
      document.getElementById('acw-newchat-pane').classList.remove('active');
      activeId = null;
      if (msgChannel) { msgChannel.unsubscribe(); msgChannel = null; }
      if (typingChannel) { typingChannel.unsubscribe(); typingChannel = null; }
      hideTyping();
      loadList();
    }

    // ─── New message: search any registered seller and start/resume a chat ───
    let sellerSearchTimer = null;

    function showNewChat() {
      document.getElementById('acw-list-pane').classList.add('hidden-on-thread');
      document.getElementById('acw-thread-pane').classList.remove('active');
      document.getElementById('acw-newchat-pane').classList.add('active');
      const input = document.getElementById('acw-newchat-search');
      input.value = '';
      document.getElementById('acw-newchat-results').innerHTML = '<div class="acw-empty">Type a name, email, or phone…</div>';
      input.focus();
    }
    function hideNewChat() {
      document.getElementById('acw-newchat-pane').classList.remove('active');
      document.getElementById('acw-list-pane').classList.remove('hidden-on-thread');
    }
    function onNewChatInput() {
      clearTimeout(sellerSearchTimer);
      sellerSearchTimer = setTimeout(searchSellers, 300);
    }
    async function searchSellers() {
      const q = document.getElementById('acw-newchat-search').value.trim();
      const resultsEl = document.getElementById('acw-newchat-results');
      if (!q) { resultsEl.innerHTML = '<div class="acw-empty">Type a name, email, or phone…</div>'; return; }
      resultsEl.innerHTML = '<div class="acw-spinner"></div>';
      const { data, error } = await db.from('profiles').select('id,full_name,email,phone')
        .or(`full_name.ilike.%${q}%,email.ilike.%${q}%,phone.ilike.%${q}%`).limit(20);
      if (error) { resultsEl.innerHTML = `<div class="acw-empty">Search failed: ${escT(error.message)}</div>`; return; }
      if (!data || !data.length) { resultsEl.innerHTML = '<div class="acw-empty">No sellers found</div>'; return; }
      data.forEach(p => { _acwSellerCache[p.id] = p; });
      resultsEl.innerHTML = data.map(p => {
        const ini = (p.full_name||'?').split(' ').map(n=>n[0]).join('').toUpperCase().slice(0,2);
        return `<div class="acw-seller-row" onclick="ACW.startChatWith('${p.id}')">
          <div class="acw-seller-avatar">${ini}</div>
          <div class="acw-seller-info">
            <div class="acw-seller-name">${escT(p.full_name||'—')}</div>
            <div class="acw-seller-meta">${escT(p.phone||p.email||'')}</div>
          </div>
        </div>`;
      }).join('');
    }
    async function startChatWith(sellerId) {
      const sellerName = _acwSellerCache[sellerId]?.full_name || 'Seller';
      const sessionKey = `seller_${sellerId}_support`;
      let { data: existing } = await db.from('chat_sessions').select('id').eq('session_key', sessionKey).maybeSingle();
      if (!existing) {
        const { data: created, error } = await db.from('chat_sessions').insert({
          session_key: sessionKey, session_type: 'seller', visitor_name: sellerName,
          page: 'dashboard.html', topic: 'Message from admin', status: 'open',
          is_resolved: false, last_msg_at: new Date().toISOString(),
        }).select().single();
        if (error) { toast('Could not start chat: '+error.message,'error'); return; }
        existing = created;
      }
      hideNewChat();
      openThread(existing.id);
    }

    // Always spins up a brand-new, empty chat_session for the seller behind
    // the currently open thread — unlike startChatWith (used by the search
    // picker), this never finds-and-reopens an existing session, so it can't
    // land you back in old messages. Used by the "+ New" button that sits
    // next to Resolve/Reopen inside an open seller conversation. Builds the
    // new key directly off the thread that's already loaded — no parsing,
    // no lookup, no path that can fall through to search.
    async function startNewTopicForCurrentSeller() {
      if (!currentIsSellerThread) { toast('New message is only available inside a seller conversation','error'); return; }
      const base = currentThreadSessionKey || `seller_${(currentSellerName||'seller').toLowerCase().replace(/[^a-z0-9]+/g,'_')}`;
      const sessionKey = `${base}__new_${Date.now()}`;
      const { data: created, error } = await db.from('chat_sessions').insert({
        session_key: sessionKey, session_type: 'seller', visitor_name: currentSellerName || 'Seller',
        page: 'dashboard.html', topic: 'New message from admin', status: 'open',
        is_resolved: false, last_msg_at: new Date().toISOString(),
      }).select().single();
      if (error) { toast('Could not start new message: '+error.message,'error'); return; }
      toast('New conversation started ✓','success');
      openThread(created.id);
    }

    async function loadMessages(id) {
      const wrap = document.getElementById('acw-messages');
      wrap.innerHTML = '<div class="acw-spinner"></div>';
      const { data } = await db.from('chat_messages').select('*').eq('session_id', id).order('created_at',{ascending:true});
      messages = data || [];
      renderMessages();
      const unreadIds = messages.filter(m=>m.sender!=='admin' && !m.read_at).map(m=>m.id);
      if (unreadIds.length) await db.from('chat_messages').update({read_at:new Date().toISOString()}).in('id',unreadIds);
    }

    function renderMessages() {
      const wrap = document.getElementById('acw-messages');
      if (!messages.length) {
        wrap.innerHTML = `<div class="acw-empty">No messages yet — say hello.</div>`;
        return;
      }
      wrap.innerHTML = messages.map(m => {
        const time = new Date(m.created_at).toLocaleTimeString('en-KE',{hour:'2-digit',minute:'2-digit'});
        return `<div class="acw-msg-wrap ${m.sender}">
          <div class="acw-msg-bubble ${m.sender}">${escT(m.body)}</div>
          <div class="acw-msg-time">${time}</div>
        </div>`;
      }).join('');
      wrap.scrollTop = wrap.scrollHeight;
    }

    function subscribeMessages(id) {
      if (msgChannel) msgChannel.unsubscribe();
      msgChannel = db.channel(`acw-msgs-${id}`)
        .on('postgres_changes', {event:'INSERT', schema:'public', table:'chat_messages', filter:`session_id=eq.${id}`}, payload => {
          const m = payload.new;
          if (messages.find(x=>x.id===m.id)) return;
          messages.push(m);
          renderMessages();
          if (m.sender !== 'admin') {
            db.from('chat_messages').update({read_at:new Date().toISOString()}).eq('id', m.id);
            hideTyping();
          }
        })
        .subscribe();
      subscribeTyping(id);
    }

    function subscribeTyping(id) {
      if (typingChannel) typingChannel.unsubscribe();
      typingChannel = db.channel(`acw-typing-${id}`)
        .on('broadcast', {event:'typing'}, ({payload}) => {
          if (payload.sender === 'admin') return;
          if (payload.typing) showTyping(); else hideTyping();
        })
        .subscribe();
    }
    function showTyping() {
      const el = document.getElementById('acw-typing-indicator');
      if (el) el.style.display = 'flex';
      clearTimeout(typingHideTimer);
      typingHideTimer = setTimeout(hideTyping, 4000);
    }
    function hideTyping() {
      clearTimeout(typingHideTimer);
      const el = document.getElementById('acw-typing-indicator');
      if (el) el.style.display = 'none';
    }

    function onInput(el) {
      document.getElementById('acw-send-btn').disabled = !el.value.trim();
      el.style.height = 'auto';
      el.style.height = Math.min(el.scrollHeight, 90) + 'px';
      if (typingChannel) {
        typingChannel.send({type:'broadcast', event:'typing', payload:{sender:'admin', typing:true}});
        clearTimeout(adminTypingTimer);
        adminTypingTimer = setTimeout(() => {
          if (typingChannel) typingChannel.send({type:'broadcast', event:'typing', payload:{sender:'admin', typing:false}});
        }, 3000);
      }
    }
    function onKeyDown(e) {
      if (e.key==='Enter' && !e.shiftKey) { e.preventDefault(); send(); }
    }

    async function send() {
      const input = document.getElementById('acw-reply-input');
      const body = input.value.trim();
      if (!body || !activeId) return;
      const btn = document.getElementById('acw-send-btn');
      btn.disabled = true; input.value=''; input.style.height='auto';
      clearTimeout(adminTypingTimer);
      if (typingChannel) typingChannel.send({type:'broadcast', event:'typing', payload:{sender:'admin', typing:false}});

      const { data: msg, error } = await db.from('chat_messages').insert({session_id:activeId, sender:'admin', body}).select().single();
      if (error) { toast('Failed to send','error'); btn.disabled=false; return; }
      messages.push(msg); renderMessages();
      await db.from('chat_sessions').update({last_msg_at:new Date().toISOString()}).eq('id', activeId);
      const sess = sessions.find(s=>s.id===activeId);
      if (sess) sess.last_msg_at = new Date().toISOString();
      input.focus();
    }

    async function resolve(id) {
      await db.from('chat_sessions').update({is_resolved:true}).eq('id', id);
      const s = sessions.find(x=>x.id===id); if (s) s.is_resolved=true;
      renderTabBadges();
      if (activeId===id) openThread(id);
    }
    async function reopen(id) {
      await db.from('chat_sessions').update({is_resolved:false}).eq('id', id);
      const s = sessions.find(x=>x.id===id); if (s) s.is_resolved=false;
      renderTabBadges();
      if (activeId===id) openThread(id);
    }

    function open() {
      document.getElementById('acw-panel').classList.add('open');
      document.getElementById('acw-launcher').classList.add('hide');
      isOpen = true;
      document.getElementById('acw-newchat-pane').classList.remove('active');
      document.getElementById('acw-thread-pane').classList.remove('active');
      document.getElementById('acw-list-pane').classList.remove('hidden-on-thread');
      loadList();
    }
    function close() {
      document.getElementById('acw-panel').classList.remove('open');
      document.getElementById('acw-launcher').classList.remove('hide');
      isOpen = false;
      backToList();
    }
    function openFullPage() {
      window.open('/admin-chat' + (activeId ? `?session=${activeId}` : ''), '_blank', 'noopener,noreferrer');
    }

    function init() {
      refreshBadge();
      subscribeGlobal();
    }

    return {
      open, close, openFullPage, openThread, backToList, setFilter, filterList,
      onInput, onKeyDown, send, resolve, reopen, init,
      showNewChat, hideNewChat, onNewChatInput, searchSellers, startChatWith,
      startNewTopicForCurrentSeller, markAllRead,
    };
  })();

  // ─── INIT ───
  // Watches every .modal-overlay for its 'open' class toggling. Does two
  // things so a form modal always appears fully in view on mobile without
  // the admin needing to hunt for it or scroll:
  //  1. Hides the floating Admin Chat Center launcher/panel (unchanged).
  //  2. Locks the background page AND snaps scroll to the top the instant
  //     a modal opens. Fixed-position elements on mobile Chrome are placed
  //     against the full layout viewport, which is taller than what's
  //     visible while the URL bar is showing — so if the background page
  //     was scrolled down when a modal opened, the sheet could render
  //     partly below the visible screen until the admin scrolled to find
  //     it. Resetting scroll to 0 before the sheet renders means it's
  //     always immediately visible, centered on-screen, no searching.
  // Reappears/unlocks automatically the moment the modal closes.
  let _nkModalWasOpen = false;
  function watchModalsForChatWidget() {
    function updateModalState() {
      const anyOpen = !!document.querySelector('.modal-overlay.open');
      document.body.classList.toggle('nk-modal-open', anyOpen);
      if (anyOpen && !_nkModalWasOpen) {
        window.scrollTo(0, 0);
        document.querySelector('.page-area')?.scrollTo?.(0, 0);
      }
      _nkModalWasOpen = anyOpen;
    }
    document.querySelectorAll('.modal-overlay').forEach(el => {
      new MutationObserver(updateModalState).observe(el, { attributes: true, attributeFilter: ['class'] });
    });
    updateModalState();
  }

  async function init() {
    await checkAuth();
    populateCountyFilter();
    await loadSettings();
    syncThemeIcon();
    loadOverview();
    loadEnquiriesBadge();
    loadReportsBadge();
    loadReviewsBadge();
    loadPremiumBadge();
    loadConciergeBadge();
    subscribeReportsRealtime();
    loadSocialSettings();
    watchModalsForChatWidget();
    ACW.init();
  }
  init();
</script>
