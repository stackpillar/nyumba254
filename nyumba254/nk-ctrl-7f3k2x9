  async function loadContactReveals() {
    const tbody   = document.getElementById('contact-reveals-body');
    const btbody  = document.getElementById('blocked-devices-body');
    const mobileEl = document.getElementById('contact-reveals-mobile');
    tbody.innerHTML  = `<tr class="skeleton-row"><td colspan="5"><div class="skel"></div></td></tr>`.repeat(4);
