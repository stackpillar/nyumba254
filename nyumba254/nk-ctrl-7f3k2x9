  async function loadEnquiries() {
    const tbody    = document.getElementById('enquiries-body');
    const mobileEl = document.getElementById('enquiries-mobile');
    tbody.innerHTML    = `<tr class="skeleton-row"><td colspan="6"><div class="skel"></div></td></tr>`.repeat(4);
    mobileEl.innerHTML = '';

    const [{data: enqData}, {data: msgData}, {data: chatData}] = await Promise.all([
      db.from('enquiries').select('*, listings(title, area)').order('created_at',{ascending:false}).limit(200),
      db.from('messages').select('*, listings(title, area, seller_id)').order('created_at',{ascending:true}).limit(500),
      db.from('chat_sessions').select('*').order('last_msg_at',{ascending:false}).limit(200),
    ]);

    const items = [];

    (enqData||[]).forEach(e => {
      items.push({
        type:'enquiry', id:'enq-'+e.id, unread: !e.admin_read_at,
        name: e.buyer_name || 'Unknown buyer', contact: e.buyer_phone || e.buyer_email || '',
        related: e.listings?.title ? `${e.listings.title} · ${e.listings.area||''}` : '—',
        preview: e.message || '', date: e.created_at,
      });
      _enqThreads['enq-'+e.id] = { kind:'enquiry', rawId:e.id, name:e.buyer_name, contact:e.buyer_phone||e.buyer_email, related:e.listings?.title||'—', body:e.message||'' };
    });

    const threadMap = new Map();
    (msgData||[]).forEach(m => {
      const key = `msg-${m.listing_id}__${m.buyer_token || m.buyer_phone || 'anon'}`;
      if (!threadMap.has(key)) threadMap.set(key, []);
      threadMap.get(key).push(m);
    });
    threadMap.forEach((msgs, key) => {
      msgs.sort((a,b)=>new Date(a.created_at)-new Date(b.created_at));
      const buyerMsgs = msgs.filter(m => m.sender === 'buyer');
      if (!buyerMsgs.length) return;
      const last = buyerMsgs[buyerMsgs.length-1];
      const unread = buyerMsgs.some(m => !m.admin_read_at);
      items.push({
        type:'message', id:key, unread,
        name: last.buyer_name || 'Buyer', contact: last.buyer_phone || '',
        related: last.listings?.title ? `${last.listings.title} · ${last.listings.area||''}` : '—',
        preview: last.content || last.message || '',
        date: last.created_at,
      });
      _enqThreads[key] = { kind:'message', name:last.buyer_name||'Buyer', contact:last.buyer_phone||'', related:last.listings?.title||'—', messages:msgs, listingId: last.listing_id, sellerId: last.listings?.seller_id||null, buyerToken: last.buyer_token||null, buyerPhone: last.buyer_phone||null, buyerName: last.buyer_name||null };
    });

    (chatData||[]).forEach(c => {
      const isSeller = c.session_type === 'seller';
      items.push({
        type: isSeller ? 'seller_chat' : 'site_chat',
        id:'chat-'+c.id, unread: (c.unread_admin||0) > 0,
        name: c.visitor_name || (isSeller ? 'Seller' : 'Site visitor'),
        contact:'', related: c.page || '—',
        preview: c.is_resolved ? '(resolved conversation)' : `(${c.unread_admin||0} unread from them)`,
        date: c.last_msg_at || c.created_at,
        sessionId: c.id,
      });
    });

    items.sort((a,b)=> new Date(b.date) - new Date(a.date));
    _enqItems = items;

    const counts = { all: items.length, enquiry:0, message:0, site_chat:0, seller_chat:0 };
    items.forEach(i => { if (counts[i.type] !== undefined) counts[i.type]++; });
    Object.entries(counts).forEach(([k,v]) => { const el=document.getElementById('etc-'+k); if(el) el.textContent = v; });
    const enqNavBadge = document.getElementById('nav-badge-enquiries');
    if (enqNavBadge) enqNavBadge.textContent = counts.all;

    renderEnquiriesTable();
  }

