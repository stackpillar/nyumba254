  let premiumTab = 'active';
  let _premiumSellers = [];
  let grantingSellerId = null;

  function setPremiumTab(tab) {
    premiumTab = tab;
    document.querySelectorAll('#view-premium-sellers .tab-btn').forEach(b=>b.classList.remove('active'));
    document.getElementById('ptab-'+tab)?.classList.add('active');
    renderPremiumTable();
  }

  let _premiumSearchActive = false;
  async function loadPremiumSellers() {
    const tbody = document.getElementById('premium-body');
    const mobileEl = document.getElementById('premium-mobile');
    tbody.innerHTML = `<tr class="skeleton-row"><td colspan="6"><div class="skel"></div></td></tr>`.repeat(3);
    mobileEl.innerHTML = '';
    const search = document.getElementById('premium-search')?.value.trim() || '';
    _premiumSearchActive = !!search;
    let q = db.from('profiles').select('*').neq('role','admin');
    if (search) {
      // Platform-wide: any seller by name/email/phone, not just existing
      // subscribers — lets you find a seller and grant them a plan directly.
      q = q.or(`full_name.ilike.%${search}%,email.ilike.%${search}%,phone.ilike.%${search}%`).limit(30);
    } else {
      q = q.or('subscription_tier.neq.none,bnb_plan.not.is.null').order('subscription_expires_at',{ascending:true, nullsFirst:false});
    }
    const { data, error } = await q;
    if (error) { tbody.innerHTML = `<tr><td colspan="6"><div class="table-loading"><p>Could not load: ${esc(error.message)}</p></div></td></tr>`; return; }
    _premiumSellers = data || [];
    data.forEach(p => { _users[p.id] = p; });

    const now = Date.now(), soon = now + 7*86400000;
    const subscribed = _premiumSellers.filter(p => (p.subscription_tier && p.subscription_tier !== 'none') || p.bnb_plan);
    const counts = { active:0, expiring:0, expired:0, all:subscribed.length };
    subscribed.forEach(p => {
      const expRaw = (p.subscription_tier && p.subscription_tier !== 'none') ? p.subscription_expires_at : p.bnb_expires_at;
      const exp = expRaw ? new Date(expRaw).getTime() : null;
      if (exp && exp < now) counts.expired++;
      else if (exp && exp < soon) counts.expiring++;
      else counts.active++;
    });
    Object.entries(counts).forEach(([k,v]) => { const el=document.getElementById('ptc-'+k); if(el) el.textContent=v; });
    document.getElementById('premium-count').textContent = _premiumSearchActive
      ? `${_premiumSellers.length} seller(s) match "${search}"`
      : `${counts.all} premium seller(s)`;
    await loadPremiumBadge();
    renderPremiumTable();
  }
  const debouncedLoadPremium = debounce(loadPremiumSellers, 400);

  async function loadPremiumBadge() {
    const nowIso = new Date().toISOString();
    const [{ count: rentalCount }, { count: bnbCount }] = await Promise.all([
      db.from('profiles').select('*',{count:'exact',head:true})
        .neq('subscription_tier','none')
        .or('subscription_expires_at.is.null,subscription_expires_at.gt.'+nowIso),
      db.from('profiles').select('*',{count:'exact',head:true})
        .not('bnb_plan','is',null)
        .or('bnb_expires_at.is.null,bnb_expires_at.gt.'+nowIso),
    ]);
    const el = document.getElementById('nav-badge-premium');
    if (el) el.textContent = (rentalCount||0) + (bnbCount||0);
  }

  function premiumRowStatus(p) {
    const isBnbOnly = !(p.subscription_tier && p.subscription_tier !== 'none') && !!p.bnb_plan;
    const expiresAt = isBnbOnly ? p.bnb_expires_at : p.subscription_expires_at;
    if (!expiresAt) return { text:'No expiry set', cls:'trial' };
    const days = Math.ceil((new Date(expiresAt)-new Date())/86400000);
    if (days < 0) return { text:'Expired', cls:'rejected' };
    if (days <= 7) return { text:`${days}d left`, cls:'pending' };
    return { text:`${days}d left`, cls:'active' };
  }

  function renderPremiumTable() {
    const now = Date.now(), soon = now + 7*86400000;
    const filtered = _premiumSearchActive ? _premiumSellers : _premiumSellers.filter(p => {
      const hasRental = p.subscription_tier && p.subscription_tier !== 'none';
      const hasBnb = !!p.bnb_plan;
      const subscribed = hasRental || hasBnb;
      if (!subscribed) return false;
      const exp = hasRental
        ? (p.subscription_expires_at ? new Date(p.subscription_expires_at).getTime() : null)
        : (p.bnb_expires_at ? new Date(p.bnb_expires_at).getTime() : null);
      if (premiumTab==='all') return true;
      if (premiumTab==='expired') return exp && exp < now;
      if (premiumTab==='expiring') return exp && exp >= now && exp < soon;
      if (premiumTab==='active') return !exp || exp >= soon;
      return true;
    });
    const tbody = document.getElementById('premium-body');
    const mobileEl = document.getElementById('premium-mobile');
    if (!filtered.length) {
      const msg = _premiumSearchActive ? 'No sellers match your search' : 'No sellers here';
      tbody.innerHTML = `<tr><td colspan="6"><div class="table-loading"><p>${msg}</p></div></td></tr>`;
      mobileEl.innerHTML = `<div class="table-loading"><p>${msg}</p></div>`;
