            <div style="font-size:11px;color:var(--text-3)">${esc(i.related)}</div>
          </div>
          <span class="badge ${ENQ_TYPE_BADGE_CLASS[i.type]}">${ENQ_TYPE_LABEL[i.type]}</span>
