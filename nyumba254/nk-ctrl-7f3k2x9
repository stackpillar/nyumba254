  const BNB_TIERS = ['bnb_basic','bnb_bundle'];
  function updateGrantPlanOptions() {
    const tier = document.getElementById('grant-tier')?.value || 'none';
    const bnbTier = document.getElementById('grant-bnb-tier')?.value || 'none';
    const proRow = document.getElementById('grant-pro-badge-row');
    const sel = document.getElementById('grant-plan');
    const billingWrap = sel?.closest('.field');
    if (proRow) proRow.style.display = (tier === 'none') ? 'none' : 'flex';

    if (sel) {
      if (tier === 'none') {
        sel.innerHTML = '';
        if (billingWrap) billingWrap.style.display = 'none';
      } else {
        if (billingWrap) billingWrap.style.display = 'block';
        const monthlyPrice = tier === 'elite' ? (SETTINGS.elite_monthly_price||3000) : (SETTINGS.premium_monthly_price||1200);
        const yearlyPrice  = tier === 'elite' ? (SETTINGS.elite_yearly_price||30000) : (SETTINGS.premium_yearly_price||12000);
        sel.innerHTML = `
          <option value="monthly">Monthly — KES ${monthlyPrice.toLocaleString('en-KE')}</option>
          <option value="yearly">Yearly — KES ${yearlyPrice.toLocaleString('en-KE')}</option>`;
      }
    }

    const bundleNote = document.getElementById('grant-bundle-note');
    if (bundleNote) {
      if (tier === 'elite' && bnbTier !== 'none') {
        bundleNote.style.display = 'block';
        bundleNote.textContent = `ℹ️ Elite already includes unlimited BNB listings — granting a separate BNB tier here isn't necessary unless you specifically want it recorded too.`;
      } else {
        bundleNote.style.display = 'none';
      }
    }
  }

  let grantSellerSearchTimer = null;
  function searchGrantSeller(q) {
    clearTimeout(grantSellerSearchTimer);
    grantSellerSearchTimer = setTimeout(async () => {
      const resultsEl = document.getElementById('grant-seller-results');
      if (!q.trim()) { resultsEl.innerHTML = ''; return; }
      const { data } = await db.from('profiles').select('id,full_name,email').neq('role','admin')
        .or(`full_name.ilike.%${q}%,email.ilike.%${q}%`).limit(8);
      (data||[]).forEach(p => { _users[p.id] = { ..._users[p.id], ...p }; });
      resultsEl.innerHTML = (data||[]).map(p =>
        `<div style="padding:8px 10px;border:1px solid var(--border);border-radius:8px;margin-bottom:4px;cursor:pointer" onclick="pickGrantSeller('${p.id}')">
          <strong>${esc(p.full_name||'—')}</strong><div style="font-size:11px;color:var(--text-3)">${esc(p.email||'')}</div>
        </div>`
      ).join('') || '<div style="font-size:12px;color:var(--text-3)">No matches</div>';
    }, 300);
  }
  function pickGrantSeller(id) {
    grantingSellerId = id;
    const name = _users[id]?.full_name || 'Seller';
    document.getElementById('grant-premium-title').textContent = `Grant Premium — ${name}`;
    document.getElementById('grant-seller-picker')?.remove();
  }

  function closeGrantPremiumModal() { document.getElementById('grant-premium-modal').classList.remove('open'); grantingSellerId=null; }

  let grantPremiumBusy = false;
  async function confirmGrantPremium() {
    if (grantPremiumBusy) return;
    if (!grantingSellerId) { toast('Pick a seller first','error'); return; }
    const tier = document.getElementById('grant-tier')?.value || 'none';
    const bnbTier = document.getElementById('grant-bnb-tier')?.value || 'none';
    const billing = document.getElementById('grant-plan')?.value || 'monthly';
    const isPro = document.getElementById('grant-is-pro').checked;
    const reconciledPaid = parseFloat(document.getElementById('grant-reconcile-paid')?.value) || null;

    if (tier === 'none' && bnbTier === 'none') { toast('Pick a feature tier, a BNB tier, or both','error'); return; }

    grantPremiumBusy = true;
    const btn = document.getElementById('btn-confirm-grant-premium');
    if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }

    const update = {};
    let totalAmount = 0;
    const days = billing === 'yearly' ? 365 : 30;
    const tierExpiresAt = new Date(Date.now() + days*86400000).toISOString();
    const bnbExpiresAt = new Date(Date.now() + 30*86400000).toISOString();

    if (tier !== 'none') {
      Object.assign(update, {
        subscription_tier: billing, subscription_plan: tier, subscription_expires_at: tierExpiresAt,
        is_pro: isPro, has_rental_capacity: true, subscription_started_at: new Date().toISOString(),
      });
      // Elite covers unlimited BNB too — grant BNB capacity alongside it,
      // no separate BNB plan/price required.
      if (tier === 'elite') update.has_bnb_capacity = true;
      totalAmount += tier === 'elite'
        ? (billing === 'yearly' ? SETTINGS.elite_yearly_price : SETTINGS.elite_monthly_price)
        : (billing === 'yearly' ? SETTINGS.premium_yearly_price : SETTINGS.premium_monthly_price);
    }
    if (bnbTier !== 'none') {
      Object.assign(update, {
        bnb_plan: bnbTier,
        bnb_unit_limit: bnbTier === 'bnb_bundle' ? 5 : 1,
        bnb_expires_at: bnbExpiresAt,
        has_bnb_capacity: true,
      });
      totalAmount += SETTINGS[bnbTier + '_price'] || 0;
    }

    const amount = reconciledPaid != null ? reconciledPaid : totalAmount;

    const { data, error } = await db.from('profiles').update(update).eq('id', grantingSellerId).select();

    grantPremiumBusy = false;
    if (btn) { btn.disabled = false; btn.textContent = 'Grant Premium'; }
    if (error) { toast('Error: '+error.message,'error'); return; }
    if (!data?.length) { toast('Blocked by RLS — check Supabase policy','error'); return; }

    const label = [tier!=='none'?tier:null, bnbTier!=='none'?bnbTier:null].filter(Boolean).join('+');
    await db.from('payments').insert({
      seller_id: grantingSellerId, amount, method:'manual',
      reference:`Admin-granted ${label}`,
      type: tier === 'elite' ? 'elite_subscription' : tier === 'premium' ? 'premium_subscription' : 'bnb_subscription',
      plan_key: bnbTier !== 'none' ? bnbTier : null,
      status:'confirmed',
    });

    if (tier !== 'none') await reactivateRentalListingsForSeller(grantingSellerId);
    if (bnbTier !== 'none' || tier === 'elite') await reactivateAirbnbListingsForSeller(grantingSellerId);

    logAction('grant_premium','profile',grantingSellerId, label);
    const seller = data[0];
    if (seller?.email) notifySeller('premium_granted', { sellerName: seller.full_name, sellerEmail: seller.email, plan: billing, expiresAt: tierExpiresAt });
    toast('Plan granted ✓','success');
    closeGrantPremiumModal();
    loadPremiumSellers();
    if (currentView==='users') loadUsers();
  }

  function revokeBnbFlow(sellerId) {
    const p = _premiumSellers.find(x=>x.id===sellerId) || _users[sellerId];
    openConfirm({
      title:'Revoke BNB plan?',
      message:`${p?.full_name||'This seller'} loses their BNB plan immediately — their Airbnb listings will be disabled until they resubscribe. This does not issue a refund.`,
      confirmText:'Revoke BNB plan', confirmClass:'reject',
      onConfirm: async () => {
        const { error } = await db.from('profiles').update({ bnb_plan:null, bnb_unit_limit:null, bnb_expires_at:null }).eq('id', sellerId);
        if (error) { toast('Error: '+error.message,'error'); return; }
        logAction('revoke_bnb','profile',sellerId,'');
        if (p?.email) notifySeller('premium_revoked', { sellerName: p.full_name, sellerEmail: p.email });
        toast('BNB plan revoked','success');
        loadPremiumSellers();
      }
    });
  }

  function revokePremiumFlow(sellerId) {
    const p = _premiumSellers.find(x=>x.id===sellerId) || _users[sellerId];
    openConfirm({
      title:'Revoke Premium?',
      message:`${p?.full_name||'This seller'} loses Premium immediately — Pro badge and any subscription-gated features turn off right away. This does not issue a refund.`,
      confirmText:'Revoke Premium', confirmClass:'reject',
      onConfirm: async () => {
        const { error } = await db.from('profiles').update({ subscription_tier:'none', subscription_expires_at:null, is_pro:false }).eq('id', sellerId);
        if (error) { toast('Error: '+error.message,'error'); return; }
        logAction('revoke_premium','profile',sellerId,'');
        if (p?.email) notifySeller('premium_revoked', { sellerName: p.full_name, sellerEmail: p.email });
        toast('Premium revoked','success');
        loadPremiumSellers();
      }
    });
  }

  // ════════════════════════════════════
  // CONCIERGE INBOX — standalone, high-priority
  // ════════════════════════════════════
  let _ccSellers = [];
  let _ccListings = [];
  let _ccListingsById = {};
  let _ccThreads = [];
  let _ccActiveKey = null;
  let _ccSearch = '';
  let _ccSellerFilter = 'all';
  let _ccChannel = null;

  const CC_QUICK_REPLIES = [
    { id:'available', label:'✅ Still available', match:['available','still there','is it taken','still open','vacant'],
      body: (ctx) => `Hi ${ctx.buyerFirst}! Yes, ${ctx.listingTitle} is still available. Let me know if you'd like to arrange a viewing.` },
    { id:'price', label:'💰 Price & fees', match:['price','how much','cost','rent is','fee'],
      body: (ctx) => `Hi ${ctx.buyerFirst}! ${ctx.listingTitle} is ${ctx.priceText}. ${ctx.rentNote}` },
    { id:'location', label:'📍 Location', match:['where','location','directions','area','nearby'],
      body: (ctx) => `Hi ${ctx.buyerFirst}! It's located in ${ctx.area}${ctx.subArea?`, ${ctx.subArea}`:''}. Happy to share directions closer to your visit.` },
    { id:'viewing', label:'📅 Book a viewing', match:['view','see it','visit','viewing','come see','when can i'],
      body: (ctx) => `Hi ${ctx.buyerFirst}! We'd love to show you around. What day and time works best for you this week?` },
    { id:'thanks', label:'🙏 Thank you', match:['thank','thanks','asante'],
      body: (ctx) => `You're most welcome, ${ctx.buyerFirst}! Let us know if you have any other questions.` },
    { id:'followup', label:'👋 Friendly follow-up', match:[],
      body: (ctx) => `Hi ${ctx.buyerFirst}, just checking in — are you still interested in ${ctx.listingTitle}? Happy to answer any questions.` },
  ];

  function ccBuildContext(t) {
    const l = t.listing || {};
    const buyerFirst = (t.buyerName||'there').split(' ')[0];
    const priceText = l.is_multi_unit ? `priced from ${fmtListingPrice(l)}` : `${fmtListingPrice(l)}`;
    const rentNote = l.price_type==='rent' ? "That's the monthly rent." : "That's the asking price.";
    return { buyerFirst, listingTitle: l.title||'the listing', priceText, rentNote, area: l.area||'the area', subArea: l.sub_area||'' };
  }
  function ccSuggestFor(t) {
    const lastBuyerMsg = [...t.messages].reverse().find(m=>m.sender==='buyer');
    const text = (lastBuyerMsg?.content || '').toLowerCase();
    const ctx = ccBuildContext(t);
    let tpl = CC_QUICK_REPLIES.find(q => q.match.some(k => text.includes(k)));
    if (!tpl) tpl = CC_QUICK_REPLIES.find(q=>q.id==='followup');
    return { template: tpl, body: tpl.body(ctx) };
  }

  async function loadConciergeSellers() {
    const { data } = await db.from('profiles').select('id,full_name,email,phone,concierge_enabled_at').eq('concierge_enabled', true).order('concierge_enabled_at',{ascending:false});
    _ccSellers = data || [];
    _ccSellers.forEach(s => { _users[s.id] = { ..._users[s.id], ...s }; });
  }

  async function loadConciergeInbox() {
    const listPane = document.getElementById('cc-thread-list');
    if (listPane) listPane.innerHTML = '<div class="acw-spinner"></div>';
    await loadConciergeSellers();
    ccRenderSellerChips();
    if (!_ccSellers.length) {
      _ccListings = []; _ccListingsById = {}; _ccThreads = [];
      ccRenderEmptyState('No sellers have managed chat turned on yet.');
      ccUpdateStats();
      return;
    }
    const sellerIds = _ccSellers.map(s=>s.id);
    const { data: listings } = await db.from('listings').select('id,title,area,sub_area,price,price_type,is_multi_unit,price_min,price_max,listing_number,seller_id').in('seller_id', sellerIds);
    _ccListings = listings || [];
    _ccListingsById = {}; _ccListings.forEach(l => { _ccListingsById[l.id] = l; });
    const listingIds = _ccListings.map(l=>l.id);
    if (!listingIds.length) { _ccThreads = []; ccRenderEmptyState('These sellers have no listings yet.'); ccUpdateStats(); return; }

    const cutoff = new Date(Date.now() - 120*86400000).toISOString();
    const [{ data: enqData }, { data: msgData }] = await Promise.all([
      db.from('enquiries').select('*').in('listing_id', listingIds).gte('created_at', cutoff).order('created_at',{ascending:false}).limit(400),
      db.from('messages').select('*').in('listing_id', listingIds).gte('created_at', cutoff).order('created_at',{ascending:true}).limit(1000),
    ]);
    ccBuildThreads(enqData||[], msgData||[]);
    ccRenderThreadList();
    ccUpdateStats();
    ccSubscribeRealtime(listingIds);
  }

  function ccBuildThreads(enqRows, msgRows) {
    const map = new Map();
    enqRows.forEach(e => {
      const key = `${e.listing_id}__${e.buyer_phone || e.buyer_token || e.id}`;
      if (!map.has(key)) {
        const listing = _ccListingsById[e.listing_id];
        map.set(key, {
          key, listingId: e.listing_id, listing,
          sellerId: listing?.seller_id, buyerToken: e.buyer_token||null, buyerPhone: e.buyer_phone||'',
          buyerName: e.buyer_name || 'Unknown buyer',
          messages: [{ id:'enq-'+e.id, sender:'buyer', content: e.message||'', created_at: e.created_at, admin_read_at: e.admin_read_at, _table:'enquiries', _rawId:e.id }],
          lastAt: e.created_at,
        });
      }
    });
    msgRows.forEach(m => {
      const key = `${m.listing_id}__${m.buyer_phone || m.buyer_token || ''}`;
      if (map.has(key)) {
        const t = map.get(key);
        const dupe = t.messages.some(x => x.id==='enq-'+m.id);
        if (!dupe) t.messages.push({ ...m, content: m.content||m.message, _table:'messages', _rawId:m.id });
        if (new Date(m.created_at) > new Date(t.lastAt)) t.lastAt = m.created_at;
      } else {
        const listing = _ccListingsById[m.listing_id];
        map.set(key, {
          key, listingId: m.listing_id, listing,
          sellerId: listing?.seller_id, buyerToken: m.buyer_token||null, buyerPhone: m.buyer_phone||'',
          buyerName: m.buyer_name || 'Buyer',
          messages: [{ ...m, content: m.content||m.message, _table:'messages', _rawId:m.id }],
          lastAt: m.created_at,
        });
      }
    });
    _ccThreads = Array.from(map.values()).map(t => {
      t.messages.sort((a,b)=>new Date(a.created_at)-new Date(b.created_at));
      t.unreadCount = t.messages.filter(m=>m.sender==='buyer' && !m.admin_read_at).length;
      t.sellerName = _users[t.sellerId]?.full_name || 'Seller';
      return t;
    }).sort((a,b)=> new Date(b.lastAt) - new Date(a.lastAt));
  }

  function ccSubscribeRealtime(listingIds) {
    if (_ccChannel) { _ccChannel.unsubscribe(); _ccChannel = null; }
    if (!listingIds.length) return;
    _ccChannel = db.channel('cc-inbox-'+Date.now())
      .on('postgres_changes', {event:'INSERT', schema:'public', table:'messages', filter:`listing_id=in.(${listingIds.join(',')})`}, payload => {
        ccHandleIncoming(payload.new);
      })
      .subscribe();
  }
  function ccHandleIncoming(m) {
    const key = `${m.listing_id}__${m.buyer_phone || m.buyer_token || ''}`;
    let t = _ccThreads.find(x=>x.key===key);
    const rec = { ...m, content: m.content||m.message, _table:'messages', _rawId:m.id };
    if (t) {
      if (t.messages.some(x=>x.id===m.id)) return;
      t.messages.push(rec);
      t.lastAt = m.created_at;
      if (m.sender==='buyer' && !m.admin_read_at) t.unreadCount++;
      _ccThreads = _ccThreads.filter(x=>x.key!==key);
      _ccThreads.unshift(t);
    } else {
      const listing = _ccListingsById[m.listing_id];
      if (!listing) return;
      t = { key, listingId:m.listing_id, listing, sellerId:listing.seller_id, buyerToken:m.buyer_token||null, buyerPhone:m.buyer_phone||'', buyerName:m.buyer_name||'Buyer', messages:[rec], lastAt:m.created_at, unreadCount: m.sender==='buyer'?1:0, sellerName: _users[listing.seller_id]?.full_name||'Seller' };
      _ccThreads.unshift(t);
    }
    ccRenderThreadList();
    ccUpdateStats();
    if (_ccActiveKey === key) ccRenderThread(t);
    if (m.sender === 'buyer') toast(`New buyer message — ${t.buyerName}`, 'success');
  }

  function ccRenderSellerChips() {
    const wrap = document.getElementById('cc-seller-chips');
    if (!wrap) return;
    wrap.innerHTML = `<button class="acw-tab ${_ccSellerFilter==='all'?'active':''}" onclick="ccSetSellerFilter('all')">All sellers</button>` +
      _ccSellers.map(s => `<button class="acw-tab ${_ccSellerFilter===s.id?'active':''}" onclick="ccSetSellerFilter('${s.id}')">${esc((s.full_name||'Seller').split(' ')[0])}</button>`).join('');
  }
  function ccSetSellerFilter(id) { _ccSellerFilter = id; ccRenderSellerChips(); ccRenderThreadList(); }

  function ccFilteredThreads() {
    let list = _ccThreads;
    if (_ccSellerFilter !== 'all') list = list.filter(t=>t.sellerId===_ccSellerFilter);
    if (_ccSearch.trim()) {
      const q = _ccSearch.toLowerCase();
      list = list.filter(t => (t.buyerName||'').toLowerCase().includes(q) || (t.listing?.title||'').toLowerCase().includes(q) || (t.sellerName||'').toLowerCase().includes(q));
    }
    return list;
  }
  function ccRenderThreadList() {
    const el = document.getElementById('cc-thread-list');
    if (!el) return;
    const list = ccFilteredThreads();
    const countEl = document.getElementById('cc-thread-count');
    if (countEl) countEl.textContent = `${list.length} conversation${list.length!==1?'s':''}`;
    if (!list.length) { el.innerHTML = `<div class="acw-empty">No conversations found</div>`; return; }
    el.innerHTML = list.map(t => {
      const last = t.messages[t.messages.length-1];
      const preview = last ? (last.sender==='seller'?'You: ':'') + (last.content||'') : '';
      const unread = t.unreadCount > 0;
      return `<div class="acw-item${unread?' unread':''}${_ccActiveKey===t.key?' cc-active':''}" onclick="ccOpenThread('${t.key}')">
        <div class="acw-item-top"><span class="acw-item-name">${esc(t.buyerName)}</span><span class="acw-item-time">${ccTimeAgo(t.lastAt)}</span></div>
        <div class="acw-item-preview">${esc(preview.slice(0,70))}</div>
        <div class="acw-item-meta">
          ${unread?'<span class="acw-dot"></span>':''}
          <span class="acw-tag seller">${esc(t.sellerName)}</span>
          <span class="acw-tag">${esc(t.listing?.title||'Listing')}</span>
        </div>
      </div>`;
    }).join('');
  }
  function ccSearchInput(v) { _ccSearch = v; ccRenderThreadList(); }
  function ccTimeAgo(iso) {
    const m = Math.floor((Date.now()-new Date(iso))/60000);
    if (m<1) return 'now'; if (m<60) return `${m}m`;
    const h = Math.floor(m/60); if (h<24) return `${h}h`;
    const d = Math.floor(h/24); if (d<7) return `${d}d`;
    return new Date(iso).toLocaleDateString('en-KE',{day:'numeric',month:'short'});
  }

  async function ccOpenThread(key) {
    const t = _ccThreads.find(x=>x.key===key); if (!t) return;
    _ccActiveKey = key;
    ccRenderThreadList();
    document.getElementById('cc-empty-state').style.display = 'none';
    document.getElementById('cc-thread-pane').style.display = 'flex';
    ccRenderThread(t);
    await ccMarkThreadRead(t);
  }
  function ccRenderThread(t) {
    document.getElementById('cc-thread-buyer').textContent = t.buyerName;
    document.getElementById('cc-thread-meta').innerHTML = `${esc(t.sellerName)} · ${esc(t.listing?.title||'Listing')}${t.buyerPhone?' · '+esc(t.buyerPhone):''}`;
    const waLink = t.buyerPhone ? `<a href="https://wa.me/${(t.buyerPhone||'').replace(/[\s+]/g,'').replace(/^0/,'254')}" target="_blank" class="acw-mini-btn" style="text-decoration:none;color:#25D366;border-color:#25D366">WhatsApp</a>` : '';
    const listingLink = t.listing ? `<a href="/listing?id=${String(t.listing.listing_number).padStart(6,'0')}" target="_blank" class="acw-mini-btn" style="text-decoration:none">View listing</a>` : '';
    document.getElementById('cc-thread-actions').innerHTML = waLink + listingLink;

    const msgsEl = document.getElementById('cc-messages');
    msgsEl.innerHTML = t.messages.map(m => {
      const time = new Date(m.created_at).toLocaleTimeString('en-KE',{hour:'2-digit',minute:'2-digit'});
      const who = m.sender==='seller' ? (m.sent_by_admin_id?'You (as seller)':'Seller') : t.buyerName;
      return `<div class="acw-msg-wrap ${m.sender==='seller'?'admin':'visitor'}">
        <div class="acw-msg-bubble ${m.sender==='seller'?'admin':'visitor'}">${esc(m.content||'')}</div>
        <div class="acw-msg-time">${esc(who)} · ${time}</div>
      </div>`;
    }).join('');
    msgsEl.scrollTop = msgsEl.scrollHeight;

    ccRenderSuggestion(t);
    document.getElementById('cc-quickbar').innerHTML = ccQuickBarHtml(t.key);
  }
  async function ccMarkThreadRead(t) {
    if (!t.unreadCount) return;
    const enqIds = t.messages.filter(m=>m._table==='enquiries' && m.sender==='buyer' && !m.admin_read_at).map(m=>m._rawId);
    const msgIds = t.messages.filter(m=>m._table==='messages' && m.sender==='buyer' && !m.admin_read_at).map(m=>m._rawId);
    const now = new Date().toISOString();
    if (enqIds.length) await db.from('enquiries').update({ admin_read_at: now }).in('id', enqIds);
    if (msgIds.length) await db.from('messages').update({ admin_read_at: now }).in('id', msgIds);
    t.messages.forEach(m => { if (m.sender==='buyer' && !m.admin_read_at) m.admin_read_at = now; });
    t.unreadCount = 0;
    ccRenderThreadList();
    ccUpdateStats();
    loadConciergeBadge();
  }

  function ccRenderSuggestion(t) {
    const wrap = document.getElementById('cc-suggestion');
    if (!wrap) return;
    const lastBuyerMsg = [...t.messages].reverse().find(m=>m.sender==='buyer');
    if (!lastBuyerMsg) { wrap.style.display='none'; return; }
    const { template, body } = ccSuggestFor(t);
    wrap.style.display = 'block';
    wrap.innerHTML = `
      <div class="cc-suggest-label">💡 Suggested reply (${esc(template.label.replace(/^\S+\s/,''))})</div>
      <div class="cc-suggest-body">${esc(body)}</div>
      <div class="cc-suggest-actions">
        <button class="acw-mini-btn resolve" onclick="ccSendQuick('${t.key}','${template.id}')">⚡ Send this</button>
        <button class="acw-mini-btn" onclick="ccEditSuggestion('${t.key}','${template.id}')">✎ Edit first</button>
      </div>`;
  }
  function ccQuickBarHtml(key) {
    return CC_QUICK_REPLIES.map(q => `<button class="cc-chip" onclick="ccSendQuick('${key}','${q.id}')">${q.label}</button>`).join('');
  }
  async function ccSendQuick(key, templateId) {
    const t = _ccThreads.find(x=>x.key===key); if (!t) return;
    const tpl = CC_QUICK_REPLIES.find(q=>q.id===templateId); if (!tpl) return;
    const body = tpl.body(ccBuildContext(t));
    await ccSendMessage(t, body);
    toast('Quick reply sent ✓','success');
  }
  function ccEditSuggestion(key, templateId) {
    const t = _ccThreads.find(x=>x.key===key); if (!t) return;
    const tpl = CC_QUICK_REPLIES.find(q=>q.id===templateId); if (!tpl) return;
    document.getElementById('cc-reply-input').value = tpl.body(ccBuildContext(t));
    document.getElementById('cc-reply-input').focus();
  }

  async function ccSendMessage(t, body) {
    if (!body || !body.trim()) return;
    const payload = { listing_id: t.listingId, buyer_token: t.buyerToken, buyer_name: t.buyerName, buyer_phone: t.buyerPhone||null, sender:'seller', content: body.trim(), sent_by_admin_id: currentUser?.id||null };
    const { data, error } = await db.from('messages').insert(payload).select().single();
    if (error) { toast('Could not send: '+error.message,'error'); return; }
    t.messages.push({ ...data, content: data.content||data.message, _table:'messages', _rawId:data.id });
    t.lastAt = data.created_at;
    _ccThreads = _ccThreads.filter(x=>x.key!==t.key); _ccThreads.unshift(t);
    ccRenderThreadList();
    if (_ccActiveKey === t.key) ccRenderThread(t);
    logAction('concierge_reply','listing',t.listingId,`Replied to ${t.buyerName}`);
  }
  async function ccSendComposer() {
    const t = _ccThreads.find(x=>x.key===_ccActiveKey); if (!t) return;
    const input = document.getElementById('cc-reply-input');
    const body = input.value.trim();
    if (!body) return;
    input.value=''; input.style.height='auto';
    await ccSendMessage(t, body);
  }
  function ccComposerKeydown(e) { if (e.key==='Enter' && !e.shiftKey) { e.preventDefault(); ccSendComposer(); } }

  function ccUpdateStats() {
    const totalUnread = _ccThreads.reduce((s,t)=>s+(t.unreadCount||0),0);
    const statUnread = document.getElementById('cc-stat-unread'); if (statUnread) statUnread.textContent = totalUnread;
    const statConvos = document.getElementById('cc-stat-convos'); if (statConvos) statConvos.textContent = _ccThreads.length;
    const statSellers = document.getElementById('cc-stat-sellers'); if (statSellers) statSellers.textContent = _ccSellers.length;
    const badge = document.getElementById('nav-badge-concierge');
    if (badge) badge.textContent = totalUnread;
  }
  function ccRenderEmptyState(msg) {
    const el = document.getElementById('cc-thread-list');
    if (el) el.innerHTML = `<div class="acw-empty">${esc(msg)}</div>`;
    ccRenderThreadList();
  }
  async function loadConciergeBadge() {
    if (!_ccSellers.length) await loadConciergeSellers();
    const listingIds = _ccListings.length ? _ccListings.map(l=>l.id) : [];
    const badge = document.getElementById('nav-badge-concierge');
    if (!listingIds.length) { if (badge) badge.textContent = '0'; return; }
    const [{count:c1},{count:c2}] = await Promise.all([
      db.from('enquiries').select('*',{count:'exact',head:true}).in('listing_id',listingIds).is('admin_read_at',null),
      db.from('messages').select('*',{count:'exact',head:true}).in('listing_id',listingIds).eq('sender','buyer').is('admin_read_at',null),
    ]);
