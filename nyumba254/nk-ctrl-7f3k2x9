    if (error) { toast('Error: '+error.message,'error'); return; }
    await db.from('verification_activity_log').insert({ seller_id: sellerId, action:'extra_approved', admin_id: currentUser.id });
    toast('Extra documents approved ✓','success');
    loadVerification();
