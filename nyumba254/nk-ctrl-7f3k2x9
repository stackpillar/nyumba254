function csvDownload(name,headers,rows){
  if(!rows.length)return ui.toast('Nothing to export','err');
  const safeCell=v=>{const s=String(v??'');return /^[=+\-@\t\r]/.test(s)?"'"+s:s;};
  const csv=[headers,...rows].map(r=>r.map(v=>`"${safeCell(v).replace(/"/g,'""')}"`).join(',')).join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}

