      done++;i++;await paint();
    }catch(e){ui.toast(e.message,'err');}
    busy=false;
  }
  const onKey=e=>{if(w!==ov().lastElementChild||/INPUT|TEXTAREA/.test(e.target.tagName))return;const k=e.key.toLowerCase();if(k==='a'){e.preventDefault();decide('a');}else if(k==='r'){e.preventDefault();decide('r');}else if(k==='s'||k==='arrowright'){e.preventDefault();i++;paint();}else if(k==='escape'){close();}};
  document.addEventListener('keydown',onKey,true);
