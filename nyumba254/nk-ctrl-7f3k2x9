  async function loadReviews(append) {
    const tbody    = document.getElementById('reviews-body');
    const mobileEl = document.getElementById('reviews-mobile');
    const loadMoreBtn = document.getElementById('reviews-load-more-btn');
    const loadMoreWrap = document.getElementById('reviews-load-more-wrap');
    if (!append) {
      reviewsPage = 0;
      _reviews = [];
      tbody.innerHTML    = `<tr class="skeleton-row"><td colspan="8"><div class="skel"></div></td></tr>`.repeat(4);
      mobileEl.innerHTML = '';
      if (loadMoreWrap) loadMoreWrap.style.display = 'none';
    } else if (loadMoreBtn) {
      loadMoreBtn.disabled = true; loadMoreBtn.textContent = 'Loading…';
    }

    const { data, error } = await db
      .from('reviews')
      .select('*, target_seller:profiles!target_seller_id(full_name), listings(title)')
      .order('created_at',{ascending:false})
      .range(reviewsPage*PAGE_SIZE, reviewsPage*PAGE_SIZE+PAGE_SIZE-1);

    if (loadMoreBtn) { loadMoreBtn.disabled = false; loadMoreBtn.textContent = 'Load more'; }

    if (error || (!append && !data)) {
      tbody.innerHTML    = `<tr><td colspan="8"><div class="table-loading"><p>Could not load reviews</p></div></td></tr>`;
      mobileEl.innerHTML = `<div class="table-loading"><p>Could not load reviews</p></div>`;
      return;
    }
    if (append && !data?.length) { if (loadMoreWrap) loadMoreWrap.style.display='none'; return; }

    _reviews = append ? _reviews.concat(data) : data;
    document.getElementById('revtc-platform').textContent = _reviews.filter(r=>r.review_type==='platform').length;
    document.getElementById('revtc-seller').textContent   = _reviews.filter(r=>r.review_type==='seller').length;
    if (loadMoreWrap) loadMoreWrap.style.display = (data.length === PAGE_SIZE) ? 'block' : 'none';
    renderReviewsTable();
  }
  function loadMoreReviews() { reviewsPage++; loadReviews(true); }

  function setReviewTab(tab) {
    reviewTab = tab;
    document.querySelectorAll('#view-reviews .tab-btn').forEach(b=>b.classList.remove('active'));
    document.getElementById('revtab-'+tab)?.classList.add('active');
    renderReviewsTable();
  }

  function renderReviewsTable() {
    const filtered = _reviews.filter(r=>r.review_type===reviewTab);
    document.getElementById('reviews-count').textContent = `${filtered.length} review${filtered.length!==1?'s':''}`;
    const tbody    = document.getElementById('reviews-body');
    const mobileEl = document.getElementById('reviews-mobile');

    if (!filtered.length) {
      tbody.innerHTML    = `<tr><td colspan="8"><div class="table-loading"><p>No reviews yet</p></div></td></tr>`;
      mobileEl.innerHTML = `<div class="table-loading"><p>No reviews yet</p></div>`;
      return;
    }

    const stars = n => '<span style="color:var(--gold)">' + '★'.repeat(n) + '</span><span style="color:var(--border)">' + '★'.repeat(5-n) + '</span>';

    tbody.innerHTML = filtered.map(r => {
      const target = r.review_type==='platform' ? 'Nyumba254' : (r.target_seller?.full_name || '—');
      const canRespond = r.review_type==='platform';
      const isPublished = r.status === 'published';
      const publishBtn = aBtn(
        isPublished ? 'deactivate' : 'activate',
        isPublished ? 'Unpublish from pricing page' : 'Publish to pricing page',
        isPublished ? 'reject' : 'approve',
        `toggleReviewPublish('${r.id}', ${isPublished})`
      );
      const respondBtn = canRespond
        ? aBtn('edit', r.response_text ? 'Edit response' : 'Respond', 'view', `openReviewRespondModal('${r.id}')`)
        : '';
      return `<tr>
        <td style="white-space:nowrap;font-size:13px">${stars(r.rating)}</td>
        <td>${esc(r.reviewer_name||(r.reviewer_role==='seller'?'Seller':'Buyer'))}<div class="listing-meta" style="text-transform:capitalize">${esc(r.reviewer_role)}</div></td>
        <td>${esc(target)}${r.listings?.title?`<div class="listing-meta">${esc(r.listings.title)}</div>`:''}</td>
        <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r.comment||'—')}</td>
        <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${r.response_text?esc(r.response_text):'<span style="color:var(--text-3)">No response</span>'}</td>
        <td><span class="badge ${isPublished?'active':'pending'}">${isPublished?'Published':'Draft'}</span></td>
        <td>${fmtDate(r.created_at)}</td>
        <td><div class="action-btns">${publishBtn}${respondBtn}</div></td>
      </tr>`;
    }).join('');

    mobileEl.innerHTML = filtered.map(r => {
      const target = r.review_type==='platform' ? 'Nyumba254' : (r.target_seller?.full_name || '—');
      const canRespond = r.review_type==='platform';
      const isPublished = r.status === 'published';
      const publishBtn = aBtn(
        isPublished ? 'deactivate' : 'activate',
        isPublished ? 'Unpublish' : 'Publish',
        isPublished ? 'reject' : 'approve',
        `toggleReviewPublish('${r.id}', ${isPublished})`
      );
      return `<div class="mobile-card">
        <div class="mobile-card-header">
          <div style="flex:1;min-width:0">
            <div style="font-size:13px">${stars(r.rating)}</div>
            <div style="font-size:11px;color:var(--text-3)">${esc(r.reviewer_name||'Anonymous')} · ${esc(target)}</div>
          </div>
          <span class="badge ${isPublished?'active':'pending'}">${isPublished?'Published':'Draft'}</span>
        </div>
