  function toggleSelectReport(id,checked) { if(checked) selectedReportIds.add(id); else selectedReportIds.delete(id); renderReportsBulkBar(); }
  function toggleSelectAllReports(checked) {
    document.querySelectorAll('.report-select-cb').forEach(cb => {
      cb.checked = checked;
      if(checked) selectedReportIds.add(cb.dataset.id); else selectedReportIds.delete(cb.dataset.id);
    });
    renderReportsBulkBar();
  }
  function renderReportsBulkBar() {
    const bar = document.getElementById('reports-bulk-bar');
    if (!bar) return;
    if (!selectedReportIds.size) { bar.classList.remove('show'); return; }
    bar.classList.add('show');
    document.getElementById('reports-bulk-count').textContent = selectedReportIds.size + ' selected';
  }
  async function bulkDismissReports() {
    const ids = [...selectedReportIds];
    if (!ids.length) return;
    for (const id of ids) await db.from('reports').update({status:'dismissed',resolved_at:new Date().toISOString()}).eq('id',id);
    logAction('bulk_dismiss_report','report','multiple',`${ids.length} report(s)`);
    toast(`${ids.length} report(s) dismissed`,'success');
    selectedReportIds.clear();
    loadReports();
    loadReportsBadge();
  }

