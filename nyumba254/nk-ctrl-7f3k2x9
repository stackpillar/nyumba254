    const filter = filterEl?.value || 'all';
    let q = db.from('platform_announcements').select('*').order('created_at', { ascending: false }).limit(50);
    if (filter === 'manual') q = q.eq('trigger_source','manual');
    if (filter === 'automated') q = q.eq('trigger_source','automated');
    const { data, error } = await q;
    if (error || !data?.length) { tbody.innerHTML = `<tr><td colspan="7"><div class="table-loading"><p>No broadcasts sent yet</p></div></td></tr>`; return; }
    tbody.innerHTML = data.map(a => `<tr>
