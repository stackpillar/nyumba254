<body>
<div id="gate"><div class="spin"></div></div>
<div id="login" hidden><form class="lg" id="lgf"><h1>Nyumba254 admin</h1><p>Staff sign-in. There is no self-registration.</p>
<div id="lge" class="intro" style="color:var(--red)" hidden></div>
<div class="fld"><label for="lem">Email</label><input id="lem" type="email" autocomplete="username" required></div>
<div class="fld"><label for="lpw">Password</label><input id="lpw" type="password" autocomplete="current-password" required></div>
<button class="btn pri" style="width:100%" id="lgb">Sign in</button></form></div>
<div class="app" id="app" hidden>
<aside id="sb" aria-label="Main navigation"></aside>
<div class="main">
<header class="top"><button class="btn ghost icon" id="burger" aria-label="Open menu"></button><h2 id="title">Dashboard</h2>
<button class="cmdbtn" id="cmdb" aria-label="Search and jump (Ctrl+K)"></button>
<button class="btn ghost icon" id="theme" aria-label="Toggle dark mode"></button></header>
<main id="view" tabindex="-1"></main>
</div></div>
<div id="ov"></div><div id="toasts" aria-live="polite"></div>
<script>
'use strict';
const SUPABASE_URL='https://vliuuloyfhyxcsuchpss.supabase.co';
const SUPABASE_KEY='sb_publishable_oIIcecf3wzKMual5K24Z8Q_zmxVfgsx';
const EDGE=`${SUPABASE_URL}/functions/v1`;
const authStorage={
  getItem:k=>(localStorage.getItem('ny_remember')==='0'?sessionStorage:localStorage).getItem(k),
  setItem:(k,v)=>(localStorage.getItem('ny_remember')==='0'?sessionStorage:localStorage).setItem(k,v),
  removeItem:k=>{localStorage.removeItem(k);sessionStorage.removeItem(k);}
};
const db=supabase.createClient(SUPABASE_URL,SUPABASE_KEY,{auth:{storage:authStorage,persistSession:true,autoRefreshToken:true}});

/* ───── helpers ───── */
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const KES=n=>'KES '+Number(n||0).toLocaleString('en-KE');
const dt=d=>d?new Date(d).toLocaleDateString('en-KE',{day:'numeric',month:'short',year:'numeric'}):'—';
const dtt=d=>d?new Date(d).toLocaleString('en-KE',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}):'—';
const ago=iso=>{if(!iso)return'';const s=(Date.now()-new Date(iso))/1000;if(s<60)return'now';if(s<3600)return Math.floor(s/60)+'m';if(s<86400)return Math.floor(s/3600)+'h';if(s<604800)return Math.floor(s/86400)+'d';return dt(iso);};
const debounce=(f,ms)=>{let t;return(...a)=>{clearTimeout(t);t=setTimeout(()=>f(...a),ms);};};
const safe=s=>String(s||'').replace(/[,()%_\\*]/g,' ').trim();
const initials=n=>(n||'?').split(' ').map(x=>x[0]).join('').toUpperCase().slice(0,2);
const TONE={active:'ok',paid:'ok',confirmed:'ok',resolved:'ok',published:'ok',verified:'ok',pending:'warn',reviewing:'warn',approved_unpaid:'warn',approved_unpaid_bnb:'warn',pending_verification:'warn',scheduled:'warn',draft:'warn',submitted:'warn',rejected:'bad',unpaid:'bad',open:'bad',suspended:'bad',expired:'bad',disabled:'bad',blocked:'bad',trial:'info',occupied:'info',sold:'info',paused:'mute',dismissed:'mute',standard:'mute',unverified:'mute'};
