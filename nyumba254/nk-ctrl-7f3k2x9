  // ─── ANALYTICS ───
  async function loadAnalytics() {
    const fromV = document.getElementById('analytics-date-from')?.value;
    const toV   = document.getElementById('analytics-date-to')?.value;
    const {count:total} = await db.from('page_views').select('*',{count:'exact',head:true});
    document.getElementById('an-total').textContent = total||0;
    const todayStart = new Date(); todayStart.setHours(0,0,0,0);
    const {count:today} = await db.from('page_views').select('*',{count:'exact',head:true}).gte('created_at',todayStart.toISOString());
    document.getElementById('an-today').textContent = today||0;
    let rq = db.from('page_views').select('*').order('created_at',{ascending:false});
    if (fromV) rq = rq.gte('created_at', fromV + 'T00:00:00');
    if (toV)   rq = rq.lte('created_at', toV + 'T23:59:59');
    const {data:recent} = await rq.limit(300);
    const sessions = new Set((recent||[]).map(r=>r.session_id));
    document.getElementById('an-sessions').textContent = sessions.size;
    const pathCounts = {};
    (recent||[]).forEach(r => { pathCounts[r.path] = (pathCounts[r.path]||0)+1; });
    const topPaths = Object.entries(pathCounts).sort((a,b)=>b[1]-a[1]).slice(0,6);
    document.getElementById('top-pages').innerHTML = topPaths.length
      ? topPaths.map(([p,c])=>`<div class="quick-row"><span>${esc(p)}</span><span>${c}</span></div>`).join('')
      : '<div class="quick-row"><span>No data yet</span><span>—</span></div>';
    const tbody = document.getElementById('visits-body');
    if(!recent?.length){
      tbody.innerHTML = `<tr><td colspan="4"><div class="table-loading"><p>No visits recorded yet</p></div></td></tr>`;
      return;
    }
    tbody.innerHTML = recent.slice(0,50).map(r=>`<tr>
      <td>${esc(r.path)}</td>
      <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r.referrer||'Direct')}</td>
      <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;color:var(--text-3)">${esc(r.user_agent||'')}</td>
      <td>${new Date(r.created_at).toLocaleString('en-KE')}</td>
    </tr>`).join('');
  }

