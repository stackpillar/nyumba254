  // Days left before a listing's plan expires. Trial listings use
  // trial_expires_at directly; paid listings are computed from
  // created_at + the plan's duration in SETTINGS (there's no separate
  // expires_at column, so this mirrors the same math the public site
  // would need to decide when a listing quietly goes stale).
  function listingDaysLeft(l) {
    if (l.status === 'expired' && !l.expiry_override) return { text: 'Expired', cls: 'rejected' };
    if (l.expiry_override) {
      const days = Math.ceil((new Date(l.expiry_override) - new Date()) / 86400000);
      return { text: days < 0 ? 'Expired' : `${days}d left (extended)`, cls: days < 0 ? 'rejected' : days <= 3 ? 'pending' : 'active' };
    }
    if (l.payment_status === 'trial') {
      if (!l.trial_expires_at) return { text: '—', cls: 'standard' };
      const days = Math.ceil((new Date(l.trial_expires_at) - new Date()) / 86400000);
      return { text: days < 0 ? 'Trial expired' : `${days}d (trial)`, cls: days < 0 ? 'rejected' : days <= 3 ? 'pending' : 'trial' };
    }
    if (l.payment_status !== 'paid' || !l.created_at) return { text: '—', cls: 'standard' };
    const durationDays = l.is_featured ? SETTINGS.featured_duration_days : SETTINGS.standard_duration_days;
    const expiresAt = new Date(l.created_at).getTime() + durationDays * 86400000;
    const days = Math.ceil((expiresAt - Date.now()) / 86400000);
    return { text: days < 0 ? 'Expired' : `${days}d left`, cls: days < 0 ? 'rejected' : days <= 3 ? 'pending' : days <= 7 ? 'featured' : 'active' };
  }
  function expiryBadgeHtml(l) {
    const e = listingDaysLeft(l);
    return `<span class="badge ${e.cls}">${esc(e.text)}</span>`;
  }

