  function calcUpgradeAmount(l, plan) {
    const priceType = l.price_type === 'rent' ? 'rent' : 'sale';
    const feePlan = plan === 'featured' ? 'featured' : 'standard';
    const units = l.listing_units || [];
    if (units.length) {
      const portfolioValue = units.reduce((s,u)=>s + Number(u.price||0) * Number(u.quantity_total ?? u.quantity_available ?? 1), 0);
      const pctFee = calcListingFee(portfolioValue, priceType, feePlan);
      const perUnit = (feePlan === 'featured' ? SETTINGS.featured_fee_per_unit : SETTINGS.standard_fee_per_unit) * units.length;
      return pctFee + perUnit;
    }
    return calcListingFee(l.price, priceType, feePlan);
  }
