  const LISTING_PHOTOS_BUCKET = 'listing-photos'; // ← set to your actual bucket name

  // One-time sanity check so a wrong bucket name fails loudly on load,
  // instead of storage cleanup silently no-opping on every delete.
  (async function verifyPhotosBucket() {
    const { error } = await db.storage.from(LISTING_PHOTOS_BUCKET).list('', { limit: 1 });
    if (error) console.error(`LISTING_PHOTOS_BUCKET ("${LISTING_PHOTOS_BUCKET}") may be wrong — storage cleanup on delete will silently fail:`, error.message);
  })();

  function storagePathFromPublicUrl(url) {
    const marker = `/storage/v1/object/public/${LISTING_PHOTOS_BUCKET}/`;
    const i = (url||'').indexOf(marker);
    return i === -1 ? null : url.slice(i + marker.length);
  }

  // Shared by doDeleteListing (single item) and purgeExpired (bulk) so both
  // paths clean up storage files AND every related table the same way —
  // previously only the single-delete path did either of those things.
  // `listingObj` lets a caller that already has listing_photos loaded (e.g.
  // purgeExpired's own query) skip re-fetching from the _listings cache.
  async function deleteListingCascade(id, listingObj) {
    const l = listingObj || _listings[id];
    const paths = (l?.listing_photos||[]).map(p => storagePathFromPublicUrl(p.url)).filter(Boolean);
    if (paths.length) {
      const { error: storageErr } = await db.storage.from(LISTING_PHOTOS_BUCKET).remove(paths);
      if (storageErr) console.error('Storage cleanup failed (row still deleted):', storageErr.message);
    }
    await db.from('listing_photos').delete().eq('listing_id', id);
    await db.from('enquiries').delete().eq('listing_id', id);
    await db.from('messages').delete().eq('listing_id', id);
    await db.from('unit_occupancy_log').delete().eq('listing_id', id);
    await db.from('listing_units').delete().eq('listing_id', id);
    await db.from('reviews').delete().eq('listing_id', id);
    return db.from('listings').delete().eq('id', id).select();
  }

  async function doDeleteListing(id,title) {
