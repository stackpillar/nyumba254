  let puAudienceCountTimer = null;
  async function updatePuAudienceCount() {
    clearTimeout(puAudienceCountTimer);
    const el = document.getElementById('pu-audience-count');
    if (!el) return;
    el.textContent = 'Checking recipient count…';
    puAudienceCountTimer = setTimeout(async () => {
      const audience = document.getElementById('pu-audience').value;
      try {
        let count = 0;
        if (audience === 'all') {
          const { count: c } = await db.from('profiles').select('*',{count:'exact',head:true}).neq('role','admin');
          count = c || 0;
        } else if (audience === 'verified') {
          const { count: c } = await db.from('profiles').select('*',{count:'exact',head:true}).neq('role','admin').eq('verification_status','verified');
          count = c || 0;
        } else if (audience === 'premium') {
          const { count: c } = await db.from('profiles').select('*',{count:'exact',head:true}).neq('role','admin').neq('subscription_tier','none');
          count = c || 0;
        } else if (audience === 'active_listings') {
          const { data } = await db.from('listings').select('seller_id').eq('status','active');
          count = new Set((data||[]).map(r=>r.seller_id)).size;
        }
        el.textContent = `≈ ${count} seller(s) will receive this`;
      } catch (e) {
        el.textContent = 'Could not estimate recipient count';
      }
    }, 300);
  }

