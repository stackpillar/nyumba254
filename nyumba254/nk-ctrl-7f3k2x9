  function closeReportModal() { document.getElementById('report-modal').classList.remove('open'); }

  async function getSellerTotalReportCount(sellerId) {
    const { data: sellerListings } = await db.from('listings').select('id').eq('seller_id', sellerId);
    const listingIds = (sellerListings||[]).map(l=>l.id);
    let total = 0;
    if (listingIds.length) {
      const { count } = await db.from('reports').select('*',{count:'exact',head:true}).eq('target_type','listing').in('target_id', listingIds);
      total += count||0;
    }
    const { count: directCount } = await db.from('reports').select('*',{count:'exact',head:true}).eq('target_type','seller').eq('target_id', sellerId);
    total += directCount||0;
    return total;
  }

  async function setReportStatus(id, status) {
    const notesEl = document.getElementById('report-admin-notes');
    const updates = { status };
    if (notesEl) updates.admin_notes = notesEl.value.trim() || null;
    if (status==='resolved' || status==='dismissed') updates.resolved_at = new Date().toISOString();
    const { error } = await db.from('reports').update(updates).eq('id', id);
    if (error) { toast('Error: '+error.message,'error'); return; }
    logAction('update_report','report',id,status);
    toast(`Report marked ${status}`,'success');
    closeReportModal();
    loadReports();
    loadReportsBadge();
  }

  async function loadReportsBadge() {
    const { count } = await db.from('reports').select('*',{count:'exact',head:true}).eq('status','open');
    const el = document.getElementById('nav-badge-reports');
    if (el) el.textContent = count || 0;
  }

  // Keeps the sidebar "Reports" badge live instead of only updating on page
  // load / after an admin action — mirrors how the chat widget's badge works.
  let reportsRealtimeChannel = null;
  function subscribeReportsRealtime() {
    if (reportsRealtimeChannel) reportsRealtimeChannel.unsubscribe();
    reportsRealtimeChannel = db.channel('reports-badge-watch')
      .on('postgres_changes', {event:'*', schema:'public', table:'reports'}, () => {
        loadReportsBadge();
        if (currentView==='reports') loadReports();
      })
      .subscribe();
  }

