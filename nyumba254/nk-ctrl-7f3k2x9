async function reviewQueue(){
  const{data}=await db.from('listings').select(LSEL).eq('status','pending').eq('recycle_bin',false).order('created_at',{ascending:true}).limit(100);
  if(!data?.length)return ui.toast('Nothing pending — all clear!','ok');
  let i=0,done=0,busy=false;
  const w=ui.open(`<div class="modal wide rq" role="dialog" aria-modal="true" aria-label="Review queue"><div class="mh"><h3 id="rqt"></h3><button class="btn ghost icon" data-x aria-label="Close">${icon('x')}</button></div><div class="mb" id="rqb"></div><div class="mf"><small style="margin-right:auto"><kbd>A</kbd> approve · <kbd>R</kbd> reject · <kbd>S</kbd> skip · <kbd>Esc</kbd> close</small><button class="btn" data-s>Skip</button><button class="btn bad" data-r>Reject</button><button class="btn pri" data-a>Approve</button></div></div>`);
  const close=()=>{w.remove();document.removeEventListener('keydown',onKey,true);refreshBadges();};
  async function paint(){
    if(i>=data.length){close();ui.toast(`Review complete — ${done} decided`,'ok');return;}
    const l=data[i],c=coverOf(l),n=(l.listing_photos||[]).length;
    $('#rqt',w).textContent=`Review ${i+1} of ${data.length}`;
    $('#rqb',w).innerHTML=`<div>${c?`<img class="hero" src="${esc(c.url)}" alt="">`:'<div class="hero empty" style="display:grid;place-items:center">No photos</div>'}<small>${n} photo${n!==1?'s':''}</small></div>
    <div><h3 style="margin-bottom:6px">${esc(l.title)}</h3><p style="font-size:20px;font-weight:700;margin-bottom:8px">${esc(priceOf(l))}</p>
