<script>
  const SUPABASE_URL = 'https://vliuuloyfhyxcsuchpss.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_oIIcecf3wzKMual5K24Z8Q_zmxVfgsx';
  const { createClient } = supabase;

  // ── Match the "Remember me" storage adapter used on the sign-in page ──
  const authStorage = {
    getItem: (key) => (localStorage.getItem('ny_remember') === '0' ? sessionStorage : localStorage).getItem(key),
    setItem: (key, value) => (localStorage.getItem('ny_remember') === '0' ? sessionStorage : localStorage).setItem(key, value),
    removeItem: (key) => { localStorage.removeItem(key); sessionStorage.removeItem(key); }
  };

  const db = createClient(SUPABASE_URL, SUPABASE_KEY, {
    auth: { storage: authStorage, persistSession: true, autoRefreshToken: true }
  });

  const EDGE_URL = `${SUPABASE_URL}/functions/v1`;
  // Returns {ok, status, body} instead of nothing, so callers that need to
  // know whether the email actually went out can surface the real error
  // instead of blindly claiming success.
  async function notifyByEmail(type, payload) {
    try {
      const res = await fetch(`${EDGE_URL}/send-notification-email`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_KEY,
          'Authorization': `Bearer ${SUPABASE_KEY}`,
        },
        body: JSON.stringify({ type, ...payload }),
      });
      let body = null;
      try { body = await res.json(); } catch(_) {}
      if (!res.ok || body?.success === false) {
        console.error('notifyByEmail: edge function returned', res.status, body);
        return { ok: false, status: res.status, body };
      }
      return { ok: true, status: res.status, body };
    } catch (err) {
      console.error('notifyByEmail failed:', err);
      return { ok: false, status: 0, body: { error: err.message } };
    }
  }
  function notifySeller(type, payload) { return notifyByEmail(type, { ...payload, audience: 'seller' }); }
function notifySms(type, payload) {
  return fetch(`${EDGE_URL}/send-sms-alert`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` },
    body: JSON.stringify({ type, ...payload }),
  }).catch(e => console.error('notifySms failed:', e));
}
  async function notifyInApp(sellerId, type, title, body, link) {
    if (!sellerId) return;
    try { await db.from('notifications').insert({ seller_id: sellerId, type, title, body, link }); }
    catch (e) { console.error('notifyInApp failed:', e); }
  }

  // ─── Email reminder templates ──────────────────────────────────────
  // Sent via notifyByEmail('admin_seller_notice', {...}) — the edge
  // function needs a case for 'admin_seller_notice' that emails
  // payload.subject / payload.message to payload.sellerEmail.
  const EMAIL_TEMPLATES = [
    { id:'verification_reminder', label:'Account verification reminder', subject:'Verify your Nyumba254 account',
      body: (name)=>`Hi ${name||'there'},\n\nJust a quick reminder to verify your Nyumba254 seller account. Verified sellers get unlimited listings and a trust badge buyers can see — it only takes about 2 minutes.\n\nYou can start from your dashboard under Settings → Account verification.\n\nThanks for listing with us.` },
    { id:'listing_improvement', label:'Improve listing details', subject:'A few tips to improve your listing',
      body: (name)=>`Hi ${name||'there'},\n\nWe noticed a few things that could make your listing stand out more to buyers — clearer photos, a fuller description, and an accurate price all help. Feel free to update it from your dashboard any time.\n\nLet us know if you need a hand.` },
    { id:'trial_expiring', label:'Free trial ending soon', subject:'Your free trial is ending soon',
      body: (name)=>`Hi ${name||'there'},\n\nYour free trial listing period is coming to an end soon. To keep your listing visible to buyers, upgrade to a paid plan from your dashboard.\n\nThanks for using Nyumba254.` },
    { id:'payment_reminder', label:'Payment reminder', subject:'Complete your listing payment',
      body: (name)=>`Hi ${name||'there'},\n\nWe noticed your listing payment hasn't been confirmed yet. Once it's settled, your listing stays live and visible to buyers without interruption.\n\nReach out if you've already paid and this is a mistake — we'll check right away.` },
    { id:'welcome_tips', label:'Welcome & getting-started tips', subject:'Getting the most out of Nyumba254',
      body: (name)=>`Hi ${name||'there'},\n\nWelcome to Nyumba254! A few quick tips to get more enquiries: add clear photos, keep your price accurate, and reply to buyer messages quickly.\n\nWe're here if you need anything.` },
    { id:'custom', label:'Custom message', subject:'A message from Nyumba254',
      body: ()=>'' },
  ];
  let emailReminderTarget = null;
  function openEmailReminderModal(sellerId) {
    const seller = _users[sellerId];
    const sellerName = seller?.full_name || 'Seller';
    const sellerEmail = seller?.email || '';
    if (!sellerEmail) { toast('This seller has no email on file','error'); return; }
    emailReminderTarget = { id: sellerId, name: sellerName, email: sellerEmail };
    document.getElementById('email-reminder-title').textContent = `Email ${sellerName||'seller'}`;
    const sel = document.getElementById('email-reminder-template');
    sel.innerHTML = EMAIL_TEMPLATES.map(t=>`<option value="${t.id}">${esc(t.label)}</option>`).join('');
    sel.value = 'verification_reminder';
    applyEmailTemplate();
    document.getElementById('email-reminder-modal').classList.add('open');
    focusModalField('email-reminder-modal','#email-reminder-subject');
  }
  function applyEmailTemplate() {
    const t = EMAIL_TEMPLATES.find(x=>x.id===document.getElementById('email-reminder-template').value);
    if (!t || !emailReminderTarget) return;
    document.getElementById('email-reminder-subject').value = t.subject;
    document.getElementById('email-reminder-body').value = t.body(emailReminderTarget.name);
  }
  function closeEmailReminderModal() { document.getElementById('email-reminder-modal').classList.remove('open'); emailReminderTarget=null; }
  let emailReminderBusy = false;
  async function sendEmailReminder() {
    if (emailReminderBusy || !emailReminderTarget) return;
    const subject = document.getElementById('email-reminder-subject').value.trim();
    const messageBody = document.getElementById('email-reminder-body').value.trim();
    if (!messageBody) { toast('Please write a message first','error'); return; }
    const templateId = document.getElementById('email-reminder-template').value;
    emailReminderBusy = true;
    const btn = document.getElementById('btn-send-email-reminder');
    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
    const result = await notifyByEmail('admin_seller_notice', {
      audience: 'seller', noticeType: templateId, subject, message: messageBody,
      sellerName: emailReminderTarget.name, sellerEmail: emailReminderTarget.email,
    });
    emailReminderBusy = false;
    if (btn) { btn.disabled = false; btn.textContent = 'Send email'; }
    if (!result.ok) {
      const detail = result.body?.error || result.body?.failedRecipients?.[0]?.error || `HTTP ${result.status}`;
      toast('Email failed to send: '+detail,'error');
      return;
    }
    logAction('email_seller','profile',emailReminderTarget.id,`Sent "${subject}"`);
    toast('Email sent ✓','success');
    closeEmailReminderModal();
  }

  async function banAuthUser(userId) {
    const { data: { session } } = await db.auth.getSession();
    if (!session) { toast('Not signed in — auth-level ban skipped','error'); return; }
    try {
      const res = await fetch(`${EDGE_URL}/admin-auth-actions`, {
        method: 'POST',
        headers: { 'Content-Type':'application/json', 'Authorization': `Bearer ${session.access_token}` },
        body: JSON.stringify({ action: 'ban', targetUserId: userId }),
      });
      if (!res.ok) { toast('Auth-level ban failed: '+await res.text(),'error'); return; }
    } catch (err) { toast('Auth-level ban failed: '+err.message,'error'); }
  }

  async function unbanAuthUser(userId) {
    const { data: { session } } = await db.auth.getSession();
    if (!session) { toast('Not signed in — auth-level unban skipped','error'); return; }
    try {
      const res = await fetch(`${EDGE_URL}/admin-auth-actions`, {
        method: 'POST',
        headers: { 'Content-Type':'application/json', 'Authorization': `Bearer ${session.access_token}` },
        body: JSON.stringify({ action: 'unban', targetUserId: userId }),
      });
      if (!res.ok) { toast('Auth-level unban failed: '+await res.text(),'error'); return; }
    } catch (err) { toast('Auth-level unban failed: '+err.message,'error'); }
  }

  // ── Dark mode — applied immediately (before any other rendering) so
  // there's no light-mode flash on load for users who've enabled it. ──
  (function initTheme() {
    const saved = localStorage.getItem('nk-admin-theme');
    if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
  })();
  function toggleDarkMode() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    if (isDark) {
      document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('nk-admin-theme', 'light');
    } else {
      document.documentElement.setAttribute('data-theme', 'dark');
      localStorage.setItem('nk-admin-theme', 'dark');
    }
    document.getElementById('theme-icon-moon').style.display = isDark ? 'block' : 'none';
    document.getElementById('theme-icon-sun').style.display  = isDark ? 'none' : 'block';
    document.getElementById('theme-toggle-btn')?.setAttribute('aria-pressed', String(!isDark));
  }
  function syncThemeIcon() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.getElementById('theme-icon-moon').style.display = isDark ? 'none' : 'block';
    document.getElementById('theme-icon-sun').style.display  = isDark ? 'block' : 'none';
    document.getElementById('theme-toggle-btn')?.setAttribute('aria-pressed', String(isDark));
  }


  let TRIAL_DAYS = 14;

  // Defaults mirror what used to be hardcoded — loadSettings() overwrites
  // these with whatever's actually saved in platform_settings, so nothing
  // changes for existing installs until an admin edits a value.
  const SETTINGS = {
    sale_standard_pct: 0.1,
    sale_featured_pct: 0.15,
    rent_standard_pct: 3,
    rent_featured_pct: 6,
    standard_min_fee: 500,
    standard_max_fee: 18000,
    featured_min_fee: 1200,
    featured_max_fee: 28000,
    standard_fee_per_unit: 50,
    featured_fee_per_unit: 150,
    trial_days: 14,
    standard_duration_days: 60,
    featured_duration_days: 90,
    recycle_bin_days: 30,
    premium_monthly_price: 1200,
    premium_yearly_price: 12000,
    elite_monthly_price: 3000,
    elite_yearly_price: 30000,
    elite_ai_listing_uses_monthly: 20,
    elite_valuation_uses_monthly: 20,
    bnb_basic_price: 700,
    bnb_bundle_price: 2000,
  };

  // Shared logic — keep this in sync with the identical function in
  // post-listing.html. Percentage fee, clamped to a min/max floor+ceiling.
  function calcListingFee(price, priceType, plan) {
    price = Math.max(0, Number(price) || 0);
    const pct = Number(SETTINGS[`${priceType === 'rent' ? 'rent' : 'sale'}_${plan === 'featured' ? 'featured' : 'standard'}_pct`]) || 0;
    let fee = price * (pct / 100);
    const min = Number(SETTINGS[plan === 'featured' ? 'featured_min_fee' : 'standard_min_fee']) || 0;
    const max = Number(SETTINGS[plan === 'featured' ? 'featured_max_fee' : 'standard_max_fee']) || Infinity;
    return Math.round(Math.max(min, Math.min(max, fee)));
  }
  const SETTINGS_KEYS = Object.keys(SETTINGS);

  async function loadSettings() {
    const { data, error } = await db.from('platform_settings').select('key,value,updated_at');
    if (error) { console.error('loadSettings error:', error); applySettingsToUI(); return; }
    let lastUpdated = null;
    (data||[]).forEach(row => {
      if (SETTINGS_KEYS.includes(row.key)) {
        SETTINGS[row.key] = Number(row.value);
        if (!lastUpdated || new Date(row.updated_at) > new Date(lastUpdated)) lastUpdated = row.updated_at;
      }
    });
    TRIAL_DAYS = SETTINGS.trial_days;
    applySettingsToUI();
    const metaEl = document.getElementById('settings-saved-meta');
    if (metaEl) metaEl.textContent = lastUpdated ? `Last updated ${fmtDate(lastUpdated)}` : 'Using defaults — not yet customized';
  }

  function applySettingsToUI() {
    const stdLabel = document.getElementById('price-standard-label');
    const featLabel = document.getElementById('price-featured-label');
    if (stdLabel)  stdLabel.textContent  = `Sale ${SETTINGS.sale_standard_pct}% / Rent ${SETTINGS.rent_standard_pct}%`;
    if (featLabel) featLabel.textContent = `Sale ${SETTINGS.sale_featured_pct}% / Rent ${SETTINGS.rent_featured_pct}%`;
  }

  function loadSettingsForm() {
    SETTINGS_KEYS.forEach(k => {
      const el = document.getElementById('set-' + k);
      if (el) el.value = SETTINGS[k];
    });
    db.from('platform_settings').select('key,value').in('key',['rm_name','rm_phone']).then(({data})=>{
      (data||[]).forEach(row=>{ const el=document.getElementById('set-'+row.key); if(el) el.value=row.value||''; });
    });
  }

  async function saveSettings() {
    const rows = SETTINGS_KEYS.map(k => {
      const el = document.getElementById('set-' + k);
      const val = Number(el?.value);
      return { key: k, value: isNaN(val) ? SETTINGS[k] : val, updated_at: new Date().toISOString(), updated_by: currentUser?.id || null };
    });
    const rmName = document.getElementById('set-rm_name')?.value.trim() || '';
    const rmPhone = document.getElementById('set-rm_phone')?.value.trim() || '';
    rows.push({ key: 'rm_name', value: rmName, updated_at: new Date().toISOString(), updated_by: currentUser?.id || null });
    rows.push({ key: 'rm_phone', value: rmPhone, updated_at: new Date().toISOString(), updated_by: currentUser?.id || null });
    const { error } = await db.from('platform_settings').upsert(rows, { onConflict: 'key' });
    if (error) { toast('Error saving settings: '+error.message,'error'); return; }
    rows.forEach(r => { SETTINGS[r.key] = r.value; });
    TRIAL_DAYS = SETTINGS.trial_days;
    applySettingsToUI();
    loadSettingsForm();
    logAction('update_settings','settings','pricing','Updated pricing/plan settings');
    toast('Settings saved ✓','success');
    const metaEl = document.getElementById('settings-saved-meta');
    if (metaEl) metaEl.textContent = 'Last updated just now';
