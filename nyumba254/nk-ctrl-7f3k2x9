        <td>
          ${seller?`<div style="font-weight:500">${esc(seller.full_name||'—')}</div><div class="listing-meta">${esc(seller.phone||'—')}</div>`:'<span style="color:var(--text-3)">—</span>'}
          ${repeatCount>1?`<div style="margin-top:3px"><span class="badge rejected">${repeatCount} reports</span></div>`:''}
          ${seller?.is_disabled?`<div style="margin-top:3px"><span class="badge rejected">suspended</span></div>`:''}
