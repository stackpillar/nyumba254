                  <option value="maintenance_scheduled">Scheduled maintenance</option>
                  <option value="maintenance_complete">Maintenance complete</option>
                  <option value="incident_report">Service incident report</option>
                </optgroup>
                <optgroup label="Security">
                  <option value="security_password">Recommend password reset</option>
                  <option value="security_breach_notice">Security notice — precautionary</option>
                </optgroup>
                <optgroup label="Billing & growth">
                  <option value="billing_price_change">Pricing change notice</option>
                  <option value="promotion_seasonal">Seasonal promotion</option>
                  <option value="referral_program">Referral program launch</option>
                  <option value="milestone_growth">Platform milestone / thank you</option>
                </optgroup>
                <optgroup label="Engagement">
                  <option value="welcome_reminder">Getting-started reminder</option>
                  <option value="holiday_greeting">Holiday / seasonal greeting</option>
                  <option value="survey_request">Feedback survey request</option>
                  <option value="event_invite">Webinar / event invite</option>
                </optgroup>
              </select>
            </div>
            <div class="settings-field" style="margin-bottom:14px"><label>Category</label>
              <select id="pu-category" style="width:100%;padding:10px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:14px">
                <option value="general">📣 General update</option>
                <option value="feature">✨ New feature</option>
                <option value="maintenance">🛠️ Maintenance / downtime</option>
                <option value="policy_update">📜 Terms / Privacy Policy update</option>
                <option value="security_alert">🔒 Security alert</option>
                <option value="billing">💳 Billing / pricing notice</option>
                <option value="promotion">🎁 Promotion / special offer</option>
                <option value="milestone">🎉 Platform news / milestone</option>
                <option value="legal">⚖️ Legal / compliance</option>
                <option value="event">📅 Event / webinar</option>
                <option value="survey">📝 Survey / feedback request</option>
                <option value="incident">🚨 Incident report</option>
              </select>
            </div>
            <div class="settings-field" style="margin-bottom:14px"><label>Title</label><input type="text" id="pu-title" maxlength="120" placeholder="e.g. We've updated our Terms of Service" oninput="updatePuCounters()"/></div>
