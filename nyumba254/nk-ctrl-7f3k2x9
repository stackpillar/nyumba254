      const seller  = reportTargetSeller(r);
      const repeatCount = seller ? (_reportSellerCountsApprox[seller.id]||1) : 0;
      return `<div class="mobile-card">
        <div class="mobile-card-header">
          <div style="flex:1;min-width:0">
            <div style="font-weight:600;font-size:13px">${esc(reportTargetLabel(r))}</div>
            <div style="font-size:11px;color:var(--text-3)">${esc(r.target_type)}${seller?' · '+esc(seller.full_name||''):''}</div>
          </div>
          <span class="badge ${r.status}">${r.status}</span>
