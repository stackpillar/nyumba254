  async function loadPuStats() {
    const { count: totalBroadcasts } = await db.from('platform_announcements').select('*',{count:'exact',head:true});
    const { data: emailRows } = await db.from('platform_announcements').select('emails_sent');
    const totalEmails = (emailRows||[]).reduce((s,r)=>s+(r.emails_sent||0),0);
    const { count: activeRules } = await db.from('platform_automation_rules').select('*',{count:'exact',head:true}).eq('enabled', true);
    const { count: totalRules } = await db.from('platform_automation_rules').select('*',{count:'exact',head:true});
    const cutoff = new Date(Date.now() - 30*86400000).toISOString();
    const { count: autoSent30d } = await db.from('platform_automation_log').select('*',{count:'exact',head:true}).gte('sent_at', cutoff);
    document.getElementById('pu-stat-total').textContent = totalBroadcasts||0;
    document.getElementById('pu-stat-emails').textContent = totalEmails.toLocaleString('en-KE');
    document.getElementById('pu-stat-automated').textContent = `${activeRules||0} / ${totalRules||0}`;
    document.getElementById('pu-stat-automated-trend').textContent = activeRules>0 ? 'live' : 'off';
    document.getElementById('pu-stat-auto-sent').textContent = autoSent30d||0;
  }

