<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard — Nyumba254</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet"/>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green:        #0F6E56;
      --green-light:  #E1F5EE;
      --green-dark:   #085041;
      --green-mid:    #1D9E75;
      --gold:         #BA7517;
      --gold-light:   #FAEEDA;
      --red:          #C53030;
      --red-light:    #FFF5F5;
      --blue:         #185FA5;
      --blue-light:   #E6F1FB;
      --purple:       #5B3E96;
      --purple-light: #EDE7F6;
      --text:         #1a1a18;
      --text-2:       #4a4a46;
      --text-3:       #888780;
      --border:       #e0ded8;
      --surface:      #f7f6f2;
      --sidebar-bg:   #0d1f1a;
      --sidebar-w:    240px;
      --white:        #ffffff;
      --radius:       10px;
      --radius-lg:    14px;
    }
    /* Dark mode — overrides the same custom properties everything else
       already references, so the rest of the stylesheet needs no changes.
       Toggled via [data-theme="dark"] on <html>, persisted in localStorage. */
    :root[data-theme="dark"] {
      --white:        #171d1a;
      --surface:      #0e1310;
      --border:       #2b332e;
      --text:         #edf1ee;
      --text-2:       #c3cac5;
      --text-3:       #8b948e;
      --green-light:  #12332a;
      --gold-light:   #3a2c12;
      --red-light:    #3a1a1a;
      --blue-light:   #16283a;
      --purple-light: #241a3a;
    }
    :root[data-theme="dark"] .skel { background: linear-gradient(90deg,#232a26 25%,#2c332e 50%,#232a26 75%); background-size:200% 100%; }
    :root[data-theme="dark"] .thumb-img svg,
    :root[data-theme="dark"] .listing-thumb svg { opacity: .6; }
    html { height: 100%; }
    body { font-family: 'Inter', sans-serif; color: var(--text); background: var(--surface); font-size: 14px; line-height: 1.6; display: flex; min-height: 100vh; transition: background .15s, color .15s; }
    a { text-decoration: none; color: inherit; }
    button { font-family: inherit; cursor: pointer; border: none; }
    input, select, textarea { font-family: inherit; }

    /* SIDEBAR */
    .sidebar { width: var(--sidebar-w); background: var(--sidebar-bg); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh; z-index: 200; transition: transform .25s; }
    .sidebar-logo { display: flex; align-items: center; gap: 10px; padding: 20px 20px 16px; font-family: 'Playfair Display', serif; font-size: 17px; color: white; border-bottom: 1px solid rgba(255,255,255,0.07); }
    .sidebar-logo-icon { width: 30px; height: 30px; background: var(--green); border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .sidebar-logo-icon svg { width: 15px; height: 15px; fill: none; stroke: white; stroke-width: 2; stroke-linecap: round; }
    .sidebar-badge { font-size: 10px; font-weight: 700; background: var(--red); color: white; padding: 2px 7px; border-radius: 10px; margin-left: auto; letter-spacing: .04em; }
    .sidebar-nav { flex: 1; padding: 16px 10px; overflow-y: auto; }
    .nav-section-label { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,0.3); padding: 10px 10px 6px; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; cursor: pointer; color: rgba(255,255,255,0.55); font-size: 13px; font-weight: 500; transition: all .15s; margin-bottom: 2px; position: relative; background: none; width: 100%; text-align: left; border: none; }
    .nav-item:hover { background: rgba(255,255,255,0.07); color: white; }
    .nav-item.active { background: rgba(15,110,86,0.3); color: white; }
    .nav-item svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; flex-shrink: 0; }
    .nav-badge { margin-left: auto; background: var(--red); color: white; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 10px; }
    .nav-badge.gold { background: var(--gold); }
    .nav-badge.green { background: var(--green-mid); }
    .sidebar-footer { padding: 14px 10px; border-top: 1px solid rgba(255,255,255,0.07); }
    .sidebar-user { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; }
    .sidebar-avatar { width: 30px; height: 30px; border-radius: 50%; background: var(--green); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: white; flex-shrink: 0; }
    .sidebar-user-info { flex: 1; min-width: 0; }
    .sidebar-user-name { font-size: 12px; font-weight: 600; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sidebar-user-role { font-size: 11px; color: rgba(255,255,255,0.4); }
    .sidebar-logout { background: none; color: rgba(255,255,255,0.4); padding: 4px; border-radius: 4px; transition: color .15s; }
    .sidebar-logout:hover { color: white; }
    .sidebar-logout svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; display: block; }
/* ── Seller unread message badge on Message button ── */
    .seller-msg-badge {
      display:inline-flex; align-items:center; justify-content:center;
      min-width:17px; height:17px; border-radius:10px;
      background:var(--red); color:white;
      font-size:10px; font-weight:700; padding:0 4px;
      margin-left:5px; vertical-align:middle;
      animation:sellerBadgePop .3s ease;
    }
    @keyframes sellerBadgePop {
      from { transform:scale(0); opacity:0; }
      to   { transform:scale(1); opacity:1; }
    }
    /* MAIN */
    /* .sidebar is fixed, so it's out of flow and contributes nothing to
       this flex row — flex:1 was stretching .main to the FULL viewport
       width, then margin-left pushed that box another 240px right,
       overflowing the page by exactly one sidebar width. Combined with
       overflow-x:hidden below, that overflow was invisible and
       unreachable: real content (4th stat card, last table columns) was
       rendered off-screen with no way to scroll to it. Sizing .main
       explicitly removes the overflow at the source. */
    .main { margin-left: var(--sidebar-w); width: calc(100% - var(--sidebar-w)); display: flex; flex-direction: column; min-height: 100vh; }
    .topbar { background: var(--white); border-bottom: 1px solid var(--border); padding: 0 28px; height: 60px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
    .topbar-left { display: flex; align-items: center; gap: 12px; }
    .mobile-menu-btn { display: none; background: none; padding: 6px; border-radius: 6px; }
    .mobile-menu-btn svg { width: 20px; height: 20px; stroke: var(--text-2); fill: none; stroke-width: 2; display: block; }
    .theme-toggle-btn { background: none; padding: 6px; border-radius: 6px; }
    .theme-toggle-btn svg { width: 20px; height: 20px; stroke: var(--text-2); fill: none; stroke-width: 2; display: block; }
    .topbar-title { font-size: 15px; font-weight: 600; color: var(--text); }
    .topbar-right { display: flex; align-items: center; gap: 10px; }
    .topbar-search { display: flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 7px 12px; }
    .topbar-search svg { width: 14px; height: 14px; stroke: var(--text-3); fill: none; stroke-width: 2; flex-shrink: 0; }
    .topbar-search input { border: none; background: none; outline: none; font-size: 13px; color: var(--text); width: 180px; }
    .topbar-search input::placeholder { color: var(--text-3); }
    .topbar-btn { padding: 7px 14px; border-radius: 8px; font-size: 13px; font-weight: 500; transition: all .15s; }
    .topbar-btn.green { background: var(--green); color: white; }
    .topbar-btn.green:hover { background: var(--green-dark); }
    .page-area { padding: 28px; flex: 1; }

    /* STAT CARDS */
    .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 28px; }
    .stat-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px 22px; display: flex; flex-direction: column; gap: 12px; }
    .stat-card-top { display: flex; align-items: flex-start; justify-content: space-between; }
    .stat-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .stat-icon svg { width: 18px; height: 18px; fill: none; stroke-width: 2; stroke-linecap: round; }
    .stat-icon.green { background: var(--green-light); } .stat-icon.green svg { stroke: var(--green); }
    .stat-icon.gold  { background: var(--gold-light);  } .stat-icon.gold  svg { stroke: var(--gold);  }
    .stat-icon.blue  { background: var(--blue-light);  } .stat-icon.blue  svg { stroke: var(--blue);  }
    .stat-icon.red   { background: var(--red-light);   } .stat-icon.red   svg { stroke: var(--red);   }
    .stat-trend { font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 10px; }
    .stat-trend.up      { background: var(--green-light); color: var(--green-dark); }
    .stat-trend.neutral { background: var(--surface); color: var(--text-3); }
    .stat-trend.pending { background: var(--gold-light); color: var(--gold); }
    .stat-val   { font-size: 28px; font-weight: 700; color: var(--text); line-height: 1; }
    .stat-label { font-size: 13px; color: var(--text-3); margin-top: 2px; }

    /* CARDS */
    .card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); margin-bottom: 20px; }
    .card-header { padding: 18px 22px 14px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
    .card-title { font-size: 14px; font-weight: 600; color: var(--text); }

    /* TABS */
    .tab-bar { display: flex; border-bottom: 1px solid var(--border); padding: 0 22px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .tab-bar::-webkit-scrollbar { display: none; }
    .tab-btn { padding: 12px 16px; font-size: 13px; font-weight: 500; color: var(--text-3); background: none; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: all .15s; white-space: nowrap; }
    .tab-btn:hover { color: var(--text); }
    .tab-btn.active { color: var(--green); border-bottom-color: var(--green); }
    .tab-btn .count { display: inline-block; background: var(--surface); color: var(--text-3); font-size: 11px; padding: 1px 6px; border-radius: 8px; margin-left: 5px; }
    .tab-btn.active .count { background: var(--green-light); color: var(--green-dark); }

    /* FILTERS */
    .filters-row { display: flex; align-items: center; gap: 8px; padding: 14px 22px; flex-wrap: wrap; }
    .filter-select { padding: 7px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 13px; color: var(--text); background: var(--white); outline: none; cursor: pointer; }
    .filter-select:focus { border-color: var(--green); }
    .filter-search { flex: 1; min-width: 160px; padding: 7px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 13px; color: var(--text); background: var(--white); outline: none; }
    .filter-search:focus { border-color: var(--green); }

    /* BULK BAR */
    .bulk-bar { display: none; align-items: center; gap: 10px; padding: 10px 22px; background: var(--green-light); border-bottom: 1px solid var(--border); flex-wrap: wrap; }
    .bulk-bar.show { display: flex; }
    .bulk-count { font-size: 13px; font-weight: 600; color: var(--green-dark); }

    /* TABLE */
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; scroll-snap-type: x proximity; }
    .table-wrap table { min-width: 920px; }
    .table-wrap table th, .table-wrap table td { scroll-snap-align: start; }
    table { width: 100%; border-collapse: collapse; }
    th { padding: 10px 16px; text-align: left; font-size: 11px; font-weight: 700; color: var(--text-3); text-transform: uppercase; letter-spacing: .06em; border-bottom: 1px solid var(--border); background: var(--surface); white-space: nowrap; }
    td { padding: 13px 16px; border-bottom: 1px solid var(--border); font-size: 13px; color: var(--text-2); vertical-align: middle; white-space: nowrap; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: var(--surface); }
    /* Every table in this dashboard ends with an Actions column. When the
       table scrolls horizontally (min-width:920px above), that column was
       the first thing to disappear off the right edge — reading as "the
       actions are gone" when they're really just one scroll away. Pinning
       the last column keeps Actions on-screen at all times, however far
       the rest of the row is scrolled. */
    .table-wrap table th:last-child,
    .table-wrap table td:last-child {
      position: sticky; right: 0; z-index: 5;
      background: var(--white);
      box-shadow: -1px 0 0 var(--border);
      min-width: 112px;
    }
    .table-wrap table td:last-child .action-btns:has(> .action-btn.icon) {
      grid-template-columns: repeat(3, 28px);
      gap: 4px;
    }
    .table-wrap table th:last-child { background: var(--surface); }
    .table-wrap table tr:hover td:last-child { background: var(--surface); }
    input[type="checkbox"] { width: 15px; height: 15px; accent-color: var(--green); cursor: pointer; }

    .listing-thumb { display: flex; align-items: center; gap: 12px; }
    .thumb-img { width: 48px; height: 38px; border-radius: 6px; background: var(--surface); flex-shrink: 0; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .thumb-img svg { width: 18px; height: 18px; stroke: var(--text-3); fill: none; stroke-width: 1.5; }
    .thumb-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 5px; }
    .listing-info { min-width: 0; }
    .listing-title { font-size: 13px; font-weight: 500; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }
    .listing-meta { font-size: 11px; color: var(--text-3); margin-top: 1px; }

    .badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 20px; white-space: nowrap; }
    .badge.pending  { background: var(--gold-light); color: var(--gold); }
    .badge.active   { background: var(--green-light); color: var(--green-dark); }
    .badge.sold     { background: var(--blue-light); color: var(--blue); }
    .badge.expired  { background: var(--surface); color: var(--text-3); }
    .badge.rejected { background: var(--red-light); color: var(--red); }
    .badge.scheduled { background: var(--blue-light); color: var(--blue); }
    .badge.featured { background: var(--gold-light); color: var(--gold); }
    .badge.standard { background: var(--surface); color: var(--text-3); }
    .badge.paid     { background: var(--green-light); color: var(--green-dark); }
    .badge.unpaid   { background: var(--red-light); color: var(--red); }
    .badge.trial    { background: var(--blue-light); color: var(--blue); }
    .badge.apartment { background: var(--green-light); color: var(--green-dark); }
    .badge.house { background: var(--blue-light); color: var(--blue); }
    .badge.boarding { background: var(--gold-light); color: var(--gold); }
    .badge.airbnb { background: var(--purple-light); color: var(--purple); }
    .badge.commercial { background: var(--blue-light); color: var(--blue); }
    .badge.open       { background: var(--red-light); color: var(--red); }
    .badge.reviewing  { background: var(--gold-light); color: var(--gold); }
    .badge.resolved   { background: var(--green-light); color: var(--green-dark); }
    .badge.dismissed  { background: var(--surface); color: var(--text-3); }
    .badge.multiunit  { background: var(--purple-light); color: var(--purple); }
    .badge::before  { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

    /* ACTION BUTTONS — desktop */
    .action-btns { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .action-btns .action-btn { display: inline-flex; align-items: center; justify-content: center; }
    .action-btn { padding: 5px 10px; border-radius: 6px; font-size: 12px; font-weight: 500; transition: all .15s; white-space: nowrap; border: none; cursor: pointer; min-height: 30px; }
    .action-btn.approve { background: var(--green-light); color: var(--green-dark); }
    .action-btn.approve:hover { background: var(--green); color: white; }
    .action-btn.reject  { background: var(--red-light); color: var(--red); }
    .action-btn.reject:hover  { background: var(--red); color: white; }
    .action-btn.view    { background: var(--surface); color: var(--text-2); border: 1px solid var(--border); }
    .action-btn.view:hover { border-color: var(--green); color: var(--green); }
    .action-btn.feature { background: var(--gold-light); color: var(--gold); }
    .action-btn.feature:hover { background: var(--gold); color: white; }
    .action-btn.delete  { background: transparent; color: var(--text-3); border: 1px solid var(--border); }
    .action-btn.delete:hover { background: var(--red-light); color: var(--red); border-color: var(--red); }
    .action-btn.message { background: var(--blue-light); color: var(--blue); }
    .action-btn.message:hover { background: var(--blue); color: white; }
    .action-btn.upgrade { background: var(--blue-light); color: var(--blue); }
    .action-btn.upgrade:hover { background: var(--blue); color: white; }

    .action-btn.disabled,
    .action-btn:disabled {
      opacity: .32;
      filter: grayscale(1) blur(.4px);
      cursor: not-allowed;
      pointer-events: none;
    }
    .action-menu-item.disabled {
      opacity: .32;
      filter: grayscale(1);
      cursor: not-allowed;
      pointer-events: none;
    }
    .btn-modal.disabled,
    .btn-modal:disabled {
      opacity: .32;
      filter: grayscale(1) blur(.4px);
      cursor: not-allowed;
      pointer-events: none;
    }

    .action-btns .action-btn.icon {
      width: 30px; height: 30px; padding: 0; border-radius: 8px;
      display: inline-flex; align-items: center; justify-content: center;
      position: relative; flex-shrink: 0;
    }
    .action-btn.icon svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; display: block; }

    /* Icon-only action groups (Listings, Trial, Multi-unit, Recycle bin,
       Payments, Sellers, Reports, Reviews, Contact reveals — every table's
       Actions column) get a fixed compact 2-column grid instead of letting
       flex-wrap collapse them into a single vertical column when the cell
       is narrow. Text-label groups (Export CSV, bulk-bar, etc.) are
       untouched since they don't contain .action-btn.icon children. */
    .action-btns:has(> .action-btn.icon) {
      display: grid;
      grid-template-columns: repeat(3, 30px);
      gap: 6px;
      align-items: start;
      width: max-content;
    }
    [data-tip] { position: relative; }
    [data-tip]::after {
      content: attr(data-tip);
      position: absolute; bottom: calc(100% + 7px); left: 50%; transform: translateX(-50%) translateY(2px);
      background: var(--text); color: #fff; font-size: 11px; font-weight: 500; line-height: 1.3;
      padding: 5px 9px; border-radius: 6px; white-space: nowrap;
      opacity: 0; visibility: hidden; pointer-events: none;
      transition: opacity .12s ease, transform .12s ease;
      z-index: 60;
    }
    [data-tip]::before {
      content: ''; position: absolute; bottom: calc(100% + 3px); left: 50%; transform: translateX(-50%);
      border: 4px solid transparent; border-top-color: var(--text);
      opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .12s ease; z-index: 60;
    }
    [data-tip]:hover::after, [data-tip]:focus-visible::after { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
    [data-tip]:hover::before, [data-tip]:focus-visible::before { opacity: 1; visibility: visible; }

    /* MOBILE ACTION MENU (dropdown) */
    .action-menu-wrap { position: relative; display: none; }
    .action-menu-btn {
      display: flex; align-items: center; gap: 6px;
      padding: 9px 14px; border-radius: 8px; font-size: 13px; font-weight: 500;
      background: var(--white); border: 1.5px solid var(--border); color: var(--text);
      cursor: pointer; transition: all .15s; min-height: 44px;
    }
    .action-menu-btn:active { background: var(--surface); }
    .action-menu-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; flex-shrink: 0; }
    .action-menu-dropdown {
      position: fixed; right: 12px;
      background: var(--white); border: 1px solid var(--border);
      border-radius: var(--radius); min-width: 200px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.18);
      z-index: 400; overflow: hidden; display: none;
    }
    .action-menu-dropdown.open { display: block; }
    .action-menu-item {
      display: block; width: 100%; text-align: left;
      padding: 13px 16px; font-size: 14px; font-weight: 500;
      border: none; background: none; cursor: pointer;
      color: var(--text-2); transition: background .12s;
      border-bottom: 1px solid var(--border); min-height: 44px;
    }
    .action-menu-item:last-child { border-bottom: none; }
    .action-menu-item:hover, .action-menu-item:active { background: var(--surface); }
    .action-menu-item.danger  { color: var(--red); }
    .action-menu-item.success { color: var(--green-dark); }
    .action-menu-item.gold    { color: var(--gold); }
    .action-menu-item.blue    { color: var(--blue); }

    /* MOBILE CARD LIST */
    .mobile-card-list { display: none; padding: 12px; }
    .mobile-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 10px; overflow: hidden; }
    .mobile-card-header { display: flex; align-items: center; gap: 12px; padding: 14px; border-bottom: 1px solid var(--border); }
    .mobile-card-body { padding: 10px 14px; }
    /* The flex + ellipsis combo used previously could compute a zero-width
       box for the value span on some mobile browsers — text present in the
       DOM but rendered invisibly, not just clipped. Block-stacking the
       label above the value removes flex/overflow tricks entirely, so the
       value ALWAYS has real space and ALWAYS wraps into view instead of
       vanishing. Still compact — a tight two-line block per field. */
    .mobile-card-row { padding: 5px 0; font-size: 12.5px; border-bottom: 1px solid var(--border); }
    .mobile-card-row:last-child { border-bottom: none; }
    .mobile-card-row span:first-child { display: block; color: var(--text-3); font-size: 10.5px; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 1px; }
    .mobile-card-row span:last-child  { display: block; font-weight: 500; color: var(--text); word-break: break-word; }
    .mobile-card-actions { padding: 10px 14px; border-top: 1px solid var(--border); display: flex; gap: 6px; flex-wrap: wrap; }
    .mobile-card-actions .action-btn { flex: 1; min-width: 76px; text-align: center; padding: 8px; font-size: 12.5px; min-height: 40px; display: flex; align-items: center; justify-content: center; }
    /* !important because the previous non-important rule was losing to
       something and letting icon buttons stretch full-width, which is
       what made the star/eye/pencil/play/trash row balloon into six huge
       squares instead of compact 40px icon buttons. */
    .mobile-card-actions .action-btn.icon { flex: 0 0 auto !important; min-width: 40px !important; width: 40px !important; padding: 0 !important; }
    .mobile-card-actions .action-btn.icon svg { width: 16px; height: 16px; }

    /* TWO COL */
    /* Grid items default to min-width:auto — their content's natural width —
       so this column would refuse to shrink below whatever's inside it (the
       listings table) and force the whole row to overflow the page, even
       with .main correctly sized. minmax(0, 1fr) overrides that default so
       the column actually shrinks to fit; the table's own overflow-x:auto
       then takes over and scrolls internally instead of blowing out the page. */
    .two-col { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; }

    .revenue-banner { background: var(--green-dark); border-radius: var(--radius-lg); padding: 24px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 20px; flex-wrap: wrap; }
    .revenue-banner h3 { font-family: 'Playfair Display', serif; font-size: 22px; color: white; margin-bottom: 4px; }
    .revenue-banner p { font-size: 13px; color: rgba(255,255,255,0.6); }
    .revenue-amounts { display: flex; gap: 32px; }
    .rev-item { text-align: right; }
    .rev-val { font-size: 22px; font-weight: 700; color: white; }
    .rev-lbl { font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 2px; }

    .user-cell { display: flex; align-items: center; gap: 10px; }
    .user-avatar { width: 30px; height: 30px; border-radius: 50%; background: var(--green-light); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: var(--green-dark); flex-shrink: 0; }

    .quick-panel { display: flex; flex-direction: column; gap: 16px; }
    .quick-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 18px 20px; }
    .quick-card h4 { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 14px; }
    .quick-row { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 13px; gap: 4px 8px; }
    .quick-row:last-child { border-bottom: none; }
    .quick-row span:first-child { color: var(--text-2); }
    .quick-row span:last-child { font-weight: 600; color: var(--text); word-break: break-word; }

    .table-loading { text-align: center; padding: 48px; color: var(--text-3); }
    .skeleton-row td { padding: 12px 16px; }
    .skel { height: 12px; background: linear-gradient(90deg,#f0efe9 25%,#e8e7e1 50%,#f0efe9 75%); background-size:200% 100%; animation:shimmer 1.4s infinite; border-radius:4px; }
    .skel.short  { width: 60%; }
    .skel.xshort { width: 35%; }
    @keyframes shimmer { to { background-position: -200% 0; } }

    /* MODALS */
    .modal-overlay { position: fixed; inset: 0; height: 100vh; height: 100dvh; background: rgba(0,0,0,0.5); z-index: 500; display: none; align-items: flex-end; justify-content: center; padding: 0; }
    .modal-overlay.open { display: flex; }
    .modal { background: var(--white); width: 100%; max-width: 520px; max-height: 92vh; overflow-y: auto; border-radius: var(--radius-lg) var(--radius-lg) 0 0; animation: slideUp .22s ease; }
    @keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .modal-header { padding: 20px 24px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; background: var(--white); z-index: 10; }
    .modal-header h3 { font-size: 16px; font-weight: 600; color: var(--text); }
    .modal-close { background: none; color: var(--text-3); font-size: 22px; line-height: 1; padding: 0 4px; transition: color .15s; border: none; cursor: pointer; min-width: 32px; min-height: 32px; }
    .modal-close:hover { color: var(--text); }
    .modal-body { padding: 20px 24px; }
    .modal-body .field { margin-bottom: 16px; }
    .modal-body label { display: block; font-size: 12px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 5px; }
    .modal-body .val { font-size: 14px; color: var(--text); font-weight: 500; }
    .modal-body .val.mono { font-family: monospace; font-size: 13px; background: var(--surface); padding: 4px 8px; border-radius: 5px; }
    .modal-body input[type="text"],
    .modal-body input[type="number"],
    .modal-body select,
    .modal-body textarea {
      width: 100%; padding: 10px 12px; border: 1.5px solid var(--border);
      border-radius: 8px; font-size: 14px; font-family: inherit; color: var(--text);
      background: var(--white); outline: none;
      -webkit-appearance: none; appearance: none;
      min-height: 44px;
    }
    .modal-body textarea { min-height: 80px; resize: vertical; }
    .modal-body input:focus, .modal-body select:focus, .modal-body textarea:focus { border-color: var(--green); }
    .modal-body .check-field { display: flex; align-items: center; gap: 10px; padding: 8px 0; }
    .modal-body .check-field input[type="checkbox"] { width: 18px; height: 18px; }
    .modal-body .check-field label { margin: 0; text-transform: none; font-size: 14px; font-weight: 500; color: var(--text-2); letter-spacing: 0; }
    .modal-footer { padding: 16px 24px; border-top: 1px solid var(--border); display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; position: sticky; bottom: 0; background: var(--white); }
    .btn-modal { padding: 10px 18px; border-radius: 8px; font-size: 13px; font-weight: 600; transition: all .15s; border: none; cursor: pointer; min-height: 44px; }
    .btn-modal.approve { background: var(--green); color: white; }
    .btn-modal.approve:hover { background: var(--green-dark); }
    .btn-modal.reject  { background: var(--red-light); color: var(--red); border: 1px solid var(--red); }
    .btn-modal.reject:hover { background: var(--red); color: white; }
    .btn-modal.cancel  { background: var(--surface); color: var(--text-2); }
    .confirm-warning { background: var(--gold-light); color: var(--gold); border-radius: 8px; padding: 10px 12px; font-size: 12px; margin-top: 10px; line-height: 1.5; }

    /* Settings page fields (standalone — .field/.modal-body input rules
       only apply inside modals, so this page needs its own copies) */
    .settings-field { margin-bottom: 4px; }
    .settings-field label { display: block; font-size: 12px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 5px; }
    .settings-field input {
      width: 100%; padding: 10px 12px; border: 1.5px solid var(--border);
      border-radius: 8px; font-size: 14px; font-family: inherit; color: var(--text);
      background: var(--white); outline: none; min-height: 44px;
    }
    .settings-field input:focus { border-color: var(--green); }
    .multiunit-info-box { background: var(--purple-light); color: var(--purple); border-radius: 8px; padding: 10px 12px; font-size: 12px; margin-bottom: 14px; line-height: 1.6; }
    .unit-type-mini-table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    .unit-type-mini-table th, .unit-type-mini-table td { text-align: left; font-size: 12px; padding: 6px 8px; border-bottom: 1px solid var(--border); }
    .unit-type-mini-table th { color: var(--text-3); font-weight: 600; text-transform: uppercase; font-size: 10px; letter-spacing: .04em; }

    /* TOAST */
    .toast { position: fixed; bottom: 24px; right: 24px; z-index: 999; background: var(--text); color: white; padding: 12px 20px; border-radius: var(--radius); font-size: 13px; transform: translateY(60px); opacity: 0; transition: all .3s; max-width: 320px; pointer-events: none; }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.success { background: var(--green-dark); }
    .toast.error   { background: var(--red); }

    .view { display: none; }
    .view.active { display: block; }

    /* RESPONSIVE */
    @media (max-width: 1100px) {
      .stat-grid { grid-template-columns: repeat(2,1fr); }
      .two-col { grid-template-columns: 1fr; }
    }
    /* Catches ANY inline style="grid-template-columns:..." anywhere in the
       page and forces it to a single column on phones — fixes the settings
       form, edit-listing modal rows, and any inline grid added later, all
       in one place, without hunting down each instance individually. */
    @media (max-width: 640px) {
      [style*="grid-template-columns"] { grid-template-columns: 1fr !important; }
    }
    html, body { overflow-x: hidden; }

    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
      .main { margin-left: 0; width: 100%; }
      .mobile-menu-btn { display: flex; }
      .stat-grid { grid-template-columns: 1fr 1fr; }
      .page-area { padding: 12px; }
      .topbar { padding: 0 16px; }
      .topbar-search { display: none; }
      .revenue-amounts { flex-direction: column; gap: 8px; }
      .rev-item { text-align: left; }
      .mobile-hide { display: none !important; }
      .mobile-card-list { display: block; }
      .action-btns { display: none; }
      .action-menu-wrap { display: block; }
      .modal { max-width: 100%; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
      .modal-footer { padding-bottom: max(16px, env(safe-area-inset-bottom)); }
      /* Filters (county/area/category/search, date-range pickers, etc.)
         were sized by content and refused to wrap properly on narrow
         screens, pushing past the viewport. Stacking them full-width
         removes the overflow at the source instead of just clipping it. */
      .filters-row { padding: 10px 12px; flex-direction: column; align-items: stretch; }
      .filter-select, .filter-search { width: 100%; min-width: 0; }
      .filters-row label { width: 100%; display: flex; align-items: center; gap: 6px; }
      .filters-row label input { flex: 1; min-width: 0; }
      #seller-filter-banner { flex-wrap: wrap; }
      input, select, textarea { max-width: 100%; }
      .card-header { padding: 14px 16px 12px; }
      /* Prevent iOS auto-zoom-on-focus: any focusable field under 16px
         triggers it, forcing the user to pinch back out. */
      .modal-body input[type="text"],
      .modal-body input[type="number"],
      .modal-body select,
      .modal-body textarea,
      .filter-select,
      .filter-search,
      .settings-field input,
      .acw-search input,
      .acw-reply-inner textarea,
      #email-reminder-subject,
      #confirm-reason-input { font-size: 16px; }
    }
    @media (max-width: 480px) {
      .stat-grid { grid-template-columns: 1fr; }
      .revenue-banner { padding: 16px; }
      .toast { left: 12px; right: 12px; bottom: 84px; max-width: none; }
    }

    /* ══════════════════════════════════════════════════════════════
       ADMIN CHAT WIDGET — floating chat launcher + panel
       Embeds a trimmed-down version of admin-chat.html directly on
       the dashboard. Badge counting/realtime subscriptions run the
       moment the dashboard loads (independent of whether the panel
       is open), so unread counts update live without opening chat.
    ══════════════════════════════════════════════════════════════ */
    .acw-launcher {
      position: fixed; right: 24px; bottom: 24px; z-index: 700;
      display: flex; align-items: center; gap: 10px;
      background: var(--sidebar-bg); color: white;
      padding: 13px 20px 13px 16px; border-radius: 999px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.28);
      cursor: pointer; border: none; font-family: inherit;
      transition: transform .15s ease, box-shadow .15s ease;
    }
    .acw-launcher:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(0,0,0,0.32); }
    .acw-launcher-icon {
      width: 30px; height: 30px; border-radius: 50%; background: var(--green);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0; position: relative;
    }
    .acw-launcher-icon svg { width: 15px; height: 15px; stroke: white; fill: none; stroke-width: 2; }
    .acw-launcher-label { font-size: 13px; font-weight: 600; white-space: nowrap; }
    .acw-launcher-badge {
      position: absolute; top: -6px; right: -6px;
      min-width: 18px; height: 18px; border-radius: 10px;
      background: var(--red); color: white; font-size: 10px; font-weight: 700;
      display: none; align-items: center; justify-content: center; padding: 0 4px;
      border: 2px solid var(--sidebar-bg);
    }
    .acw-launcher-badge.show { display: flex; animation: acwBlink 1.4s ease-in-out infinite; }
    .acw-launcher.hide,
    body.nk-modal-open .acw-launcher,
    body.nk-concierge-open .acw-launcher { display: none; }
    body.nk-modal-open .acw-panel,
    body.nk-concierge-open .acw-panel { display: none !important; }
    /* Locks the background page while any modal sheet is open, so it can't
       be mid-scroll underneath a fixed-position modal on mobile. */
    body.nk-modal-open { overflow: hidden; }

    @keyframes acwBlink { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

    .acw-panel {
      position: fixed; right: 24px; bottom: 24px; z-index: 701;
      width: 380px; height: 620px; max-height: calc(100vh - 48px);
      background: var(--white); border-radius: var(--radius-lg);
      box-shadow: 0 20px 60px rgba(0,0,0,0.35);
      display: none; flex-direction: column; overflow: hidden;
      border: 1px solid var(--border);
    }
    .acw-panel.open { display: flex; }
    .acw-head {
      flex-shrink: 0; background: var(--sidebar-bg); color: white;
      padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
    }
    .acw-head-title { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; min-width: 0; }
    .acw-head-title svg { width: 16px; height: 16px; stroke: white; fill: none; stroke-width: 2; flex-shrink: 0; }
    .acw-head-actions { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
    .acw-icon-btn {
      width: 28px; height: 28px; border-radius: 7px; background: rgba(255,255,255,0.08);
      display: flex; align-items: center; justify-content: center; border: none; cursor: pointer;
      color: rgba(255,255,255,0.8); transition: background .15s, color .15s;
    }
    .acw-icon-btn:hover { background: rgba(255,255,255,0.18); color: white; }
    .acw-icon-btn svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; }

    .acw-body { flex: 1; display: flex; min-height: 0; }

    /* List pane */
    .acw-list-pane { width: 100%; display: flex; flex-direction: column; min-height: 0; }
    .acw-list-pane.hidden-on-thread { display: none; }
    .acw-newmsg-row { padding: 10px 12px 0; flex-shrink: 0; }
    .acw-newmsg-btn {
      width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px;
      padding: 9px 12px; border-radius: 8px; border: none; cursor: pointer;
      background: var(--green); color: white; font-size: 12.5px; font-weight: 600; font-family: inherit;
      transition: background .15s;
    }
    .acw-newmsg-btn:hover { background: var(--green-dark); }
    .acw-newmsg-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2.4; flex-shrink: 0; }
    .acw-search { padding: 10px 12px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
    .acw-search-inner { position: relative; }
    .acw-search-inner svg { position: absolute; left: 9px; top: 50%; transform: translateY(-50%); width: 13px; height: 13px; stroke: var(--text-3); fill: none; stroke-width: 2; }
    .acw-search input {
      width: 100%; padding: 7px 10px 7px 28px; border: 1.5px solid var(--border); border-radius: 8px;
      font-size: 12.5px; font-family: inherit; background: var(--surface); color: var(--text); outline: none;
    }
    .acw-search input:focus { border-color: var(--green); background: white; }
    .acw-tabs {
      display: flex; gap: 4px; padding: 8px 12px; border-bottom: 1px solid var(--border);
      overflow-x: auto; scrollbar-width: none; flex-shrink: 0;
    }
    .acw-tabs::-webkit-scrollbar { display: none; }
    .acw-tab {
      flex-shrink: 0; padding: 5px 10px; border-radius: 20px; font-size: 11px; font-weight: 600;
      background: var(--surface); color: var(--text-3); border: none; cursor: pointer; font-family: inherit;
      display: flex; align-items: center; gap: 4px;
    }
    .acw-tab.active { background: var(--green); color: white; }
    .acw-tab-badge { background: var(--red); color: white; font-size: 9px; font-weight: 700; padding: 0 4px; border-radius: 8px; min-width: 14px; text-align: center; animation: acwBlink 1.4s ease-in-out infinite; }
    .acw-list { flex: 1; overflow-y: auto; }
    .acw-item {
      padding: 10px 14px; border-bottom: 1px solid var(--border); cursor: pointer; transition: background .12s;
    }
    .acw-item:hover, .acw-item:active { background: var(--surface); }
    .acw-item-top { display: flex; justify-content: space-between; align-items: center; gap: 6px; margin-bottom: 2px; }
    .acw-item-name { font-size: 12.5px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .acw-item.unread .acw-item-name { font-weight: 700; }
    .acw-item-time { font-size: 10.5px; color: var(--text-3); flex-shrink: 0; }
    .acw-item-preview { font-size: 11.5px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .acw-item.unread .acw-item-preview { color: var(--text-2); font-weight: 600; }
    .acw-item-meta { display: flex; align-items: center; gap: 5px; margin-top: 4px; }
    .acw-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--red); flex-shrink: 0; animation: acwBlink 1.4s ease-in-out infinite; }
    .acw-tag { font-size: 9.5px; padding: 1px 6px; border-radius: 8px; background: var(--surface); color: var(--text-3); border: 1px solid var(--border); }
    .acw-tag.seller { background: var(--blue-light); color: var(--blue); border-color: transparent; }
    .acw-tag.resolved { background: var(--green-light); color: var(--green-dark); border-color: transparent; }
    .acw-empty { padding: 30px 16px; text-align: center; color: var(--text-3); font-size: 12.5px; }

    /* New message pane */
    .acw-newchat-pane { width: 100%; display: none; flex-direction: column; min-height: 0; }
    .acw-newchat-pane.active { display: flex; }
    .acw-newchat-head { padding: 9px 12px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .acw-newchat-title { font-size: 12.5px; font-weight: 700; color: var(--text); }
    .acw-newchat-results { flex: 1; overflow-y: auto; }
    .acw-seller-row { padding: 10px 14px; border-bottom: 1px solid var(--border); cursor: pointer; display: flex; align-items: center; gap: 10px; transition: background .12s; }
    .acw-seller-row:hover { background: var(--surface); }
    .acw-seller-avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--green-light); color: var(--green-dark); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; flex-shrink: 0; }
    .acw-seller-info { min-width: 0; }
    .acw-seller-name { font-size: 12.5px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .acw-seller-meta { font-size: 11px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Thread pane */
    .acw-thread-pane { width: 100%; display: none; flex-direction: column; min-height: 0; }
    .acw-thread-pane.active { display: flex; }
    .acw-thread-head {
      padding: 9px 12px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; flex-shrink: 0;
    }
    .acw-back-btn { background: none; border: none; cursor: pointer; color: var(--text-2); padding: 4px; display: flex; flex-shrink: 0; }
    .acw-back-btn svg { width: 17px; height: 17px; stroke: currentColor; fill: none; stroke-width: 2; }
    .acw-thread-info { min-width: 0; flex: 1; }
    .acw-thread-name { font-size: 12.5px; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .acw-thread-meta { font-size: 10.5px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .acw-typing-indicator { font-size: 10.5px; color: var(--green); font-style: italic; display: flex; align-items: center; gap: 5px; margin-top: 2px; }
    .acw-typing-dots { display: inline-flex; gap: 3px; }
    .acw-typing-dots span { width: 4px; height: 4px; border-radius: 50%; background: var(--green); animation: acwTypingDot .9s infinite; }
    .acw-typing-dots span:nth-child(2) { animation-delay: .15s; }
    .acw-typing-dots span:nth-child(3) { animation-delay: .3s; }
    @keyframes acwTypingDot { 0%,80%,100% { transform: translateY(0); opacity: .4; } 40% { transform: translateY(-3px); opacity: 1; } }
    .acw-thread-actions { display: flex; gap: 5px; flex-shrink: 0; }
    .acw-mini-btn {
      font-size: 10.5px; font-weight: 600; padding: 5px 8px; border-radius: 6px; cursor: pointer;
      border: 1.5px solid var(--border); background: white; color: var(--text-2); font-family: inherit;
    }
    .acw-mini-btn.resolve { border-color: var(--green); color: var(--green); }
    .acw-mini-btn.reopen { border-color: var(--gold); color: var(--gold); }

    .acw-messages { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .acw-msg-wrap { display: flex; flex-direction: column; max-width: 84%; }
    .acw-msg-wrap.admin { align-self: flex-end; align-items: flex-end; }
    .acw-msg-wrap.visitor { align-self: flex-start; align-items: flex-start; }
    .acw-msg-bubble { padding: 8px 11px; font-size: 12.5px; line-height: 1.5; border-radius: 12px; word-break: break-word; }
    .acw-msg-bubble.visitor { background: var(--surface); border: 1px solid var(--border); border-radius: 12px 12px 12px 2px; color: var(--text); }
    .acw-msg-bubble.admin { background: var(--green); color: white; border-radius: 12px 12px 2px 12px; }
    .acw-msg-time { font-size: 10px; color: var(--text-3); margin-top: 2px; padding: 0 2px; }

    .acw-reply-bar { border-top: 1px solid var(--border); padding: 8px 10px; flex-shrink: 0; }
    .acw-reply-inner { display: flex; align-items: flex-end; gap: 6px; }
    .acw-reply-inner textarea {
      flex: 1; padding: 8px 11px; border: 1.5px solid var(--border); border-radius: 14px;
      font-size: 12.5px; font-family: inherit; background: var(--surface); color: var(--text);
      outline: none; resize: none; min-height: 36px; max-height: 90px; line-height: 1.4;
    }
    .acw-reply-inner textarea:focus { border-color: var(--green); background: white; }
    .acw-send-btn {
      width: 36px; height: 36px; border-radius: 50%; background: var(--green); border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .acw-send-btn:disabled { opacity: .5; cursor: not-allowed; }
    .acw-send-btn svg { width: 14px; height: 14px; stroke: white; fill: none; stroke-width: 2.5; }
    .acw-resolved-note { text-align: center; padding: 8px; font-size: 11.5px; color: var(--text-3); background: var(--surface); border-radius: 8px; }

    .acw-spinner { width: 22px; height: 22px; border: 2.5px solid var(--border); border-top-color: var(--green); border-radius: 50%; animation: acwspin .7s linear infinite; margin: 30px auto; display: block; }
    @keyframes acwspin { to { transform: rotate(360deg); } }

    @media (max-width: 480px) {
      .acw-panel { right: 8px; left: 8px; top: 8px; bottom: 8px; width: auto; height: auto; max-height: none; }
      .acw-launcher { right: 14px; bottom: 14px; }
      .acw-launcher-label { display: none; }
      .acw-launcher { padding: 12px; }
    }

    /* ══════════════════════════════════════════════════════════════
       CONCIERGE INBOX — standalone, isolated managed-chat workspace.
       This is admin replying to BUYERS on behalf of concierge-enabled
       sellers — a different thing from ACW (admin↔seller support chat).
    ══════════════════════════════════════════════════════════════ */
    .cc-stat-strip { display:flex; gap:14px; flex-wrap:wrap; padding:14px 22px 0; }
    .cc-stat-pill { background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:10px 16px; min-width:120px; }
    .cc-stat-pill .cc-stat-val { font-size:20px; font-weight:700; color:var(--text); }
    .cc-stat-pill .cc-stat-lbl { font-size:11px; color:var(--text-3); margin-top:2px; }
    .cc-toolbar { display:flex; gap:8px; align-items:center; padding:14px 22px; flex-wrap:wrap; }
    .cc-seller-chips { display:flex; gap:6px; flex-wrap:wrap; padding:0 22px 12px; overflow-x:auto; }
    .cc-layout { display:grid; grid-template-columns: 320px 1fr; height:640px; border-top:1px solid var(--border); }
    .cc-list-col { border-right:1px solid var(--border); overflow-y:auto; }
    .cc-active { background: var(--green-light) !important; }
    .cc-thread-col { display:flex; flex-direction:column; min-height:0; }
    .cc-thread-head { padding:12px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:12px; flex-shrink:0; }
    .cc-thread-head-info { flex:1; min-width:0; }
    .cc-thread-head-name { font-size:14px; font-weight:700; color:var(--text); }
    .cc-thread-head-meta { font-size:11.5px; color:var(--text-3); margin-top:1px; }
    .cc-messages-pane { flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:8px; background:var(--surface); }
    .cc-suggestion { display:none; margin:0 16px; padding:12px 14px; background:var(--gold-light); border:1px solid #f2d29b; border-radius:10px; }
    .cc-suggest-label { font-size:11px; font-weight:700; color:var(--gold); text-transform:uppercase; letter-spacing:.04em; margin-bottom:6px; }
    .cc-suggest-body { font-size:13px; color:var(--text-2); line-height:1.5; margin-bottom:10px; }
    .cc-suggest-actions { display:flex; gap:8px; }
    .cc-quickbar { display:flex; gap:6px; flex-wrap:wrap; padding:10px 16px 0; }
    .cc-chip { font-size:12px; font-weight:600; padding:6px 12px; border-radius:20px; border:1.5px solid var(--green); background:white; color:var(--green-dark); cursor:pointer; transition:all .15s; }
    .cc-chip:hover { background:var(--green); color:white; }
    .cc-composer { display:flex; gap:8px; align-items:flex-end; padding:12px 16px; border-top:1px solid var(--border); flex-shrink:0; }
    .cc-composer textarea { flex:1; padding:10px 14px; border:1.5px solid var(--border); border-radius:16px; font-size:13.5px; font-family:inherit; resize:none; outline:none; min-height:42px; max-height:110px; background:var(--surface); color:var(--text); }
    .cc-composer textarea:focus { border-color:var(--green); background:white; }
    .cc-send-btn { width:42px; height:42px; border-radius:50%; background:var(--green); border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .cc-send-btn:hover { background:var(--green-dark); }
    .cc-send-btn svg { width:16px; height:16px; stroke:white; fill:none; stroke-width:2.4; }
    .cc-empty-state { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; color:var(--text-3); padding:40px; text-align:center; }
    .cc-empty-state svg { width:44px; height:44px; stroke:var(--border); fill:none; stroke-width:1.4; margin-bottom:14px; }
    @media (max-width:900px) {
      .cc-layout { grid-template-columns:1fr; height:auto; }
      .cc-list-col { border-right:none; border-bottom:1px solid var(--border); max-height:280px; }
      .cc-thread-col { min-height:480px; }
    }
  </style>
</head>
