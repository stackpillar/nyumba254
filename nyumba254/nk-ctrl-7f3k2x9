        <td>${fmtDate(r.created_at)}</td>
        <td>
          <div class="action-btns">
            ${aBtn('view','View full details','view',`openReportModal('${r.id}')`)}
            ${seller && !seller.is_disabled?aBtn('suspend','Suspend seller','reject',`quickSuspendSeller('${seller.id}')`):''}
          </div>
          ${mobileMenu(r.id,[
            {label:'View full details', cls:'', fn:`openReportModal('${r.id}')`},
            ...(seller && !seller.is_disabled?[{label:'Suspend seller', cls:'danger', fn:`quickSuspendSeller('${seller.id}')`}]:[]),
