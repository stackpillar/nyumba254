    }).join('');
    mobileEl.innerHTML = filtered.map(p => {
      const hasRental = p.subscription_tier && p.subscription_tier !== 'none';
      const hasBnb = !!p.bnb_plan;
      const subscribed = hasRental || hasBnb;
      const st = subscribed ? premiumRowStatus(p) : { text:'Not subscribed', cls:'standard' };
      const planText = hasRental ? (p.subscription_plan==='elite'?'Elite':'Premium') : (hasBnb ? (bnbLabel[p.bnb_plan]||p.bnb_plan) : '—');
      return `<div class="mobile-card">
