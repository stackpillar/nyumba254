.reply{display:flex;gap:8px;padding:10px;border-top:1px solid var(--bd)}.reply textarea{flex:1;min-height:40px;max-height:110px;resize:none;border:1.5px solid var(--bd);border-radius:10px;padding:9px 12px;background:var(--bg);outline:0}
@media(max-width:900px){
.app{grid-template-columns:1fr}#sb{position:fixed;left:0;top:0;width:274px;transform:translateX(-100%);transition:transform .2s}#sb.open{transform:none}
#burger{display:inline-flex}.top{padding:0 12px}.cmdbtn{min-width:0}.cmdbtn span,.cmdbtn kbd{display:none}#view{padding:14px}
.two,.rq .mb{grid-template-columns:1fr}.chat{grid-template-columns:1fr;height:auto}.chat .cl{max-height:240px;border-right:0;border-bottom:1px solid var(--bd)}.chat .ct{height:60vh}
