  async function markInquiryRead(id) {
    const t = _enqThreads[id]; if (!t) return;
    if (t.kind === 'enquiry') {
      await db.from('enquiries').update({ admin_read_at: new Date().toISOString() }).eq('id', t.rawId);
    } else if (t.kind === 'message') {
      const unreadIds = (t.messages||[]).filter(m => m.sender === 'buyer' && !m.admin_read_at).map(m => m.id);
      if (unreadIds.length) await db.from('messages').update({ admin_read_at: new Date().toISOString() }).in('id', unreadIds);
    }
    const item = _enqItems.find(i => i.id === id);
    if (item) item.unread = false;
    renderEnquiriesTable();
    loadEnquiriesBadge();
  }

  async function markAllEnquiriesRead() {
    const nowIso = new Date().toISOString();
    await Promise.all([
      db.from('enquiries').update({ admin_read_at: nowIso }).is('admin_read_at', null),
      db.from('messages').update({ admin_read_at: nowIso }).eq('sender', 'buyer').is('admin_read_at', null),
    ]);
    _enqItems.forEach(i => { if (i.type === 'enquiry' || i.type === 'message') i.unread = false; });
    renderEnquiriesTable();
    loadEnquiriesBadge();
  }

  function openInquiryModal(id) {
    const t = _enqThreads[id]; if (!t) return;
    _activeInquiryId = id;
    document.getElementById('inquiry-modal-title').textContent = t.related || 'Conversation';
    const isConcierge = t.kind==='message' && t.sellerId && _conciergeSellerIds.has(t.sellerId);
    let body = '';
    if (t.kind === 'enquiry') {
      body = `
        <div class="field"><label>From</label><div class="val">${esc(t.name)}${t.contact?' · '+esc(t.contact):''}</div></div>
        <div class="field"><label>Listing</label><div class="val">${esc(t.related)}</div></div>
        <div class="field"><label>Message</label><div class="val" style="font-size:13px;color:var(--text-2);line-height:1.6">${esc(t.body||'—')}</div></div>`;
    } else {
      body = `
        <div class="field"><label>Between</label><div class="val">${esc(t.name)}${t.contact?' · '+esc(t.contact):''} and the seller</div></div>
        <div class="field"><label>Listing</label><div class="val">${esc(t.related)}</div></div>
        ${isConcierge?'<div class="confirm-warning" style="background:var(--green-light);color:var(--green-dark)">🎧 This seller has managed chat on — you can reply below on their behalf. It shows to the buyer as a normal reply from the seller.</div>':''}
        <div class="field"><label>Full conversation</label>
          <div style="display:flex;flex-direction:column;gap:8px;margin-top:6px">
            ${t.messages.map(m => `
              <div style="align-self:${m.sender==='seller'?'flex-end':'flex-start'};max-width:85%">
                <div style="font-size:11px;color:var(--text-3);margin-bottom:2px">${m.sender==='seller'?(m.sent_by_admin_id?'Seller (via admin)':'Seller'):'Buyer'} · ${new Date(m.created_at).toLocaleString('en-KE')}</div>
                <div style="background:${m.sender==='seller'?'var(--green-light)':'var(--surface)'};border-radius:10px;padding:8px 12px;font-size:13px;color:var(--text-2)">${esc(m.content||m.message||'')}</div>
              </div>`).join('')}
          </div>
        </div>
        ${isConcierge?`<div class="field"><label>Reply as the seller</label><textarea id="concierge-reply-text" rows="3" placeholder="Type a reply — the buyer will see this as coming from the seller…"></textarea></div>`:''}`;
    }
    document.getElementById('inquiry-modal-body').innerHTML = body;
    document.getElementById('inquiry-modal-footer').innerHTML = isConcierge
      ? `<button class="btn-modal cancel" onclick="closeInquiryModal()">Close</button><button class="btn-modal approve" onclick="sendConciergeReply()">Send reply</button>`
      : `<button class="btn-modal cancel" onclick="closeInquiryModal()">Close</button>`;
    document.getElementById('inquiry-modal').classList.add('open');
