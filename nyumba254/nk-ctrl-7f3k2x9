.kpi{padding:16px 18px}.kpi small{display:block}.kpi b{font-size:26px;display:block;line-height:1.2;margin-top:2px}
.att{display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:12px;border:1px solid var(--bd);background:var(--bg)}
.att:hover{border-color:var(--g)}.att b{font-size:24px;min-width:38px}.att.hot b{color:var(--red)}.att span{color:var(--tx2);font-weight:500}.att i{margin-left:auto;color:var(--tx3)}
.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}
.row{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--bd)}.row:last-child{border-bottom:0}
.bar{height:6px;background:var(--sf);border-radius:4px;overflow:hidden;margin-top:4px}.bar i{display:block;height:100%;background:var(--g)}
.savebar{position:sticky;bottom:12px;display:flex;gap:10px;align-items:center;justify-content:space-between;background:var(--tx);color:var(--bg);padding:10px 14px;border-radius:12px;margin-top:16px;box-shadow:var(--sh)}
.rq{max-width:880px}.rq .mb{display:grid;grid-template-columns:1.1fr 1fr;gap:20px}.rq .hero{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px;background:var(--sf)}
.cmd{max-width:560px;padding:0;align-self:start;margin-top:12vh}.cmd input{width:100%;border:0;border-bottom:1px solid var(--bd);padding:16px 18px;outline:0;background:none;font-size:15px}
.cmd .res{max-height:50vh;overflow-y:auto;padding:6px}.cmd .res button{display:flex;width:100%;text-align:left;padding:9px 12px;border-radius:8px;gap:10px;align-items:center}.cmd .res button.on,.cmd .res button:hover{background:var(--gl)}.cmd .res small{margin-left:auto}
.chat{display:grid;grid-template-columns:330px 1fr;height:calc(100vh - 130px);min-height:480px;overflow:hidden}
.chat .cl{border-right:1px solid var(--bd);overflow-y:auto}.chat .ct{display:flex;flex-direction:column;min-width:0}
.ci{padding:11px 14px;border-bottom:1px solid var(--bd);cursor:pointer}.ci:hover,.ci.on{background:var(--hl)}.ci.un b::after{content:'';display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--red);margin-left:6px}
.msgs{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:8px;background:var(--sf)}
