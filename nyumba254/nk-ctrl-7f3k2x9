          <div class="mobile-card-row"><span>Details</span><span style="text-align:right;max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r.details||'—')}</span></div>
          ${repeatCount>1?`<div class="mobile-card-row"><span>Pattern</span><span style="color:var(--red);font-weight:700">${repeatCount} reports on this seller</span></div>`:''}
