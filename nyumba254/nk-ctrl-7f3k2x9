        <label>Reason (internal)</label>
        <textarea id="admin-video-block-reason" rows="2" placeholder="e.g. Video did not match the property, inappropriate content…">${esc(seller?.video_walkthrough_block_reason||'')}</textarea>
      </div>`;
    document.getElementById('admin-video-block')?.addEventListener('change', function () {
      document.getElementById('admin-video-block-reason-wrap').style.display = this.checked ? 'block' : 'none';
    });
    document.getElementById('admin-video-footer').innerHTML = `
      <button class="btn-modal cancel" onclick="closeAdminVideoModal()">Close</button>
      ${current ? `<button class="btn-modal reject" onclick="adminDeleteVideo(${current.id})">Delete video</button>` : ''}
      <button class="btn-modal approve" onclick="adminSaveVideo()">${current ? 'Replace video' : 'Add video'}</button>
      ${seller ? `<button class="btn-modal ${blocked ? 'approve' : 'reject'}" onclick="adminToggleVideoBlock('${seller.id}', ${!blocked})">${blocked ? 'Unblock seller' : 'Save block'}</button>` : ''}`;
  }

  function closeAdminVideoModal() { document.getElementById('admin-video-modal').classList.remove('open'); adminVideoListingId = null; }

  async function adminSaveVideo() {
    const url = document.getElementById('admin-video-url').value.trim();
    if (!url) { toast('Enter a video link first', 'error'); return; }
    if (!/^https?:\/\//i.test(url)) { toast('Enter a valid URL starting with http:// or https://', 'error'); return; }
    // Admin insert/update bypasses the seller block flag (RLS policy
    // "admins manage all listing videos" — separate from the seller policy).
    await db.from('listing_videos').delete().eq('listing_id', adminVideoListingId);
    const { error } = await db.from('listing_videos').insert({ listing_id: adminVideoListingId, url, position: 0 });
    if (error) { toast('Error saving video: ' + error.message, 'error'); return; }
    logAction('admin_set_listing_video', 'listing', adminVideoListingId, url);
    toast('Video saved ✓', 'success');
    openAdminVideoModal(adminVideoListingId);
  }

  async function adminDeleteVideo(videoId) {
    const { error } = await db.from('listing_videos').delete().eq('id', videoId);
    if (error) { toast('Error deleting: ' + error.message, 'error'); return; }
    logAction('admin_delete_listing_video', 'listing', adminVideoListingId, '');
    toast('Video deleted', 'success');
    openAdminVideoModal(adminVideoListingId);
  }

  async function adminToggleVideoBlock(sellerId, nextBlocked) {
    const reason = nextBlocked ? (document.getElementById('admin-video-block-reason')?.value.trim() || null) : null;
    const { data, error } = await db.from('profiles').update({
      video_walkthrough_blocked: nextBlocked,
      video_walkthrough_block_reason: reason,
    }).eq('id', sellerId).select();
    if (error) { toast('Error: ' + error.message, 'error'); return; }
    if (!data?.length) { toast('Blocked by RLS — check Supabase policy', 'error'); return; }
    logAction(nextBlocked ? 'block_seller_videos' : 'unblock_seller_videos', 'profile', sellerId, reason || '');
    toast(nextBlocked ? 'Seller blocked from adding videos ✓' : 'Seller unblocked ✓', 'success');
    _users[sellerId] = { ..._users[sellerId], video_walkthrough_blocked: nextBlocked, video_walkthrough_block_reason: reason };
    openAdminVideoModal(adminVideoListingId);
  }

  async function adminApproveSellerVideo(pendingId) {
    const { data: p } = await db.from('pending_seller_videos').select('*').eq('id', pendingId).single();
    if (!p) return;
    await db.from('listing_videos').delete().eq('listing_id', p.listing_id);
    await db.from('listing_videos').insert({ listing_id: p.listing_id, url: p.youtube_url, position: 0 });
    await db.from('pending_seller_videos').update({ status: 'approved', reviewed_at: new Date().toISOString(), reviewed_by: currentUser.id }).eq('id', pendingId);
    logAction('approve_seller_video', 'listing', p.listing_id, p.youtube_url);
    toast('Video approved and published ✓', 'success');
    openAdminVideoModal(p.listing_id);
  }
  async function adminRejectSellerVideo(pendingId) {
    const { data: p } = await db.from('pending_seller_videos').select('*').eq('id', pendingId).single();
    await db.from('pending_seller_videos').update({ status: 'rejected', reviewed_at: new Date().toISOString(), reviewed_by: currentUser.id }).eq('id', pendingId);
    toast('Video rejected', 'success');
    if (p) openAdminVideoModal(p.listing_id);
  }

