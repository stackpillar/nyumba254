  async function sendConciergeReply() {
    const t = _enqThreads[_activeInquiryId]; if (!t) return;
    const textEl = document.getElementById('concierge-reply-text');
    const text = textEl.value.trim();
    if (!text) return;
    const { data, error } = await db.from('messages').insert({
      listing_id: t.listingId, buyer_token: t.buyerToken, buyer_name: t.buyerName,
      buyer_phone: t.buyerPhone, sender: 'seller', content: text, sent_by_admin_id: currentUser.id,
    }).select().single();
    if (error) { toast('Could not send: '+error.message,'error'); return; }
    t.messages.push(data);
    openInquiryModal(_activeInquiryId);
    toast('Reply sent ✓','success');
  }

