  async function sendPlatformUpdate() {
    const title = document.getElementById('pu-title').value.trim();
    const message = document.getElementById('pu-message').value.trim();
    if (!title || !message) { toast('Title and message are required', 'error'); return; }
    const category = document.getElementById('pu-category').value;
    if (category === 'policy_update' && !confirm('Sending a policy update — make sure the Link field points to the updated Terms/Privacy page. Continue?')) return;
    const btn = document.getElementById('btn-send-platform-update');
    const statusEl = document.getElementById('pu-status');
    btn.disabled = true; btn.textContent = 'Sending…'; statusEl.textContent = '';
    const { data: { session } } = await db.auth.getSession();
    try {
      const res = await fetch(`${EDGE_URL}/send-platform-announcement`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${session?.access_token || SUPABASE_KEY}` },
        body: JSON.stringify({
          title, message,
          link: document.getElementById('pu-link').value.trim() || null,
          category,
          sendNotification: document.getElementById('pu-send-notif').checked,
          sendEmail: document.getElementById('pu-send-email').checked,
          audience: document.getElementById('pu-audience').value,
          createdBy: currentUser?.id || null,
        }),
      });
      const body = await res.json();
      if (!res.ok || body.error) throw new Error(body.error || 'Failed to send');
      toast(`Sent to ${body.recipients} seller(s) — ${body.emailsSent||0} email(s) delivered ✓`, 'success');
      document.getElementById('pu-title').value = '';
      document.getElementById('pu-message').value = '';
      document.getElementById('pu-link').value = '';
      document.getElementById('pu-template').value = '';
      document.getElementById('pu-preview-box').style.display = 'none';
      updatePuCounters();
      logAction('send_platform_update', 'announcement', body.announcementId, title);
      loadPlatformUpdatesHistory();
    } catch (e) {
      toast('Could not send: ' + e.message, 'error');
    } finally {
      btn.disabled = false; btn.textContent = 'Send to sellers';
    }
  }

