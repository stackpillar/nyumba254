  // REPORTS
  // ════════════════════════════════════
  let _reports = [];
  let reportTab = 'open';
  const _reportTargetsCache = { listing:{}, seller:{} };
  let _reportSellerCountsApprox = {};

  const REPORT_REASON_LABEL = {
    fake_listing:'Fake listing', scam_attempt:'Scam / money upfront',
    wrong_info:'Details don\'t match', offensive:'Offensive content', other:'Other'
  };

  async function loadReports(append) {
    const tbody    = document.getElementById('reports-body');
    const mobileEl = document.getElementById('reports-mobile');
    const loadMoreBtn = document.getElementById('reports-load-more-btn');
    const loadMoreWrap = document.getElementById('reports-load-more-wrap');
    if (!append) {
      reportsPage = 0;
      _reports = [];
      _reportTargetsCache.listing = {};
      _reportTargetsCache.seller  = {};
      tbody.innerHTML    = `<tr class="skeleton-row"><td colspan="7"><div class="skel"></div></td></tr>`.repeat(4);
      mobileEl.innerHTML = '';
      if (loadMoreWrap) loadMoreWrap.style.display = 'none';
    } else if (loadMoreBtn) {
      loadMoreBtn.disabled = true; loadMoreBtn.textContent = 'Loading…';
    }

    const { data, error } = await db.from('reports').select('*').order('created_at',{ascending:false}).range(reportsPage*PAGE_SIZE, reportsPage*PAGE_SIZE+PAGE_SIZE-1);
    if (loadMoreBtn) { loadMoreBtn.disabled = false; loadMoreBtn.textContent = 'Load more'; }
    if (error || (!append && !data)) {
      tbody.innerHTML    = `<tr><td colspan="7"><div class="table-loading"><p>Could not load reports</p></div></td></tr>`;
      mobileEl.innerHTML = `<div class="table-loading"><p>Could not load reports</p></div>`;
      return;
    }
    if (append && !data?.length) { if (loadMoreWrap) loadMoreWrap.style.display='none'; return; }

    // Accumulate across pages — tab counts below are computed from the full
    // running set, not just this page, so "Load more" never makes counts
    // regress or under-report what's actually been loaded so far.
    _reports = append ? _reports.concat(data) : data;

    const listingIds      = [...new Set(data.filter(r=>r.target_type==='listing' && r.target_id).map(r=>r.target_id))];
    const directSellerIds = [...new Set(data.filter(r=>r.target_type==='seller'  && r.target_id).map(r=>r.target_id))];

    if (listingIds.length) {
      const { data: ls } = await db.from('listings').select('*, listing_photos(*), listing_units(*), profiles(*)').in('id', listingIds);
      (ls||[]).forEach(l => {
        _reportTargetsCache.listing[l.id] = l;
        _listings[l.id] = l;
        if (l.profiles) {
          _reportTargetsCache.seller[l.profiles.id] = l.profiles;
          _users[l.profiles.id] = l.profiles;
        }
      });
    }
    if (directSellerIds.length) {
      const { data: ps } = await db.from('profiles').select('*').in('id', directSellerIds);
      (ps||[]).forEach(p => { _reportTargetsCache.seller[p.id] = p; _users[p.id] = p; });
    }

    const counts2 = {};
    _reports.forEach(r => {
      const seller = reportTargetSeller(r);
      if (seller) counts2[seller.id] = (counts2[seller.id]||0) + 1;
    });
    _reportSellerCountsApprox = counts2;

    const counts = { open:0, reviewing:0, resolved:0, dismissed:0, all:_reports.length };
    _reports.forEach(r => { if (counts[r.status]!==undefined) counts[r.status]++; });
    Object.entries(counts).forEach(([k,v]) => { const el=document.getElementById('rtc-'+k); if(el) el.textContent=v; });

    if (loadMoreWrap) loadMoreWrap.style.display = (data.length === PAGE_SIZE) ? 'block' : 'none';
    renderReportsTable();
  }
  function loadMoreReports() { reportsPage++; loadReports(true); }

  function setReportTab(tab) {
    reportTab = tab;
    document.querySelectorAll('#view-reports .tab-btn').forEach(b=>b.classList.remove('active'));
    document.getElementById('rtab-'+tab)?.classList.add('active');
    renderReportsTable();
  }

  function reportTargetLabel(r) {
    if (r.target_type === 'listing') return _reportTargetsCache.listing[r.target_id]?.title || 'Listing (deleted or unknown)';
    if (r.target_type === 'seller')  return _reportTargetsCache.seller[r.target_id]?.full_name  || 'Seller (unknown)';
    if (r.target_type === 'system')  return 'Nyumba254 platform';
    return 'Other';
  }
  function reportTargetSeller(r) {
    if (r.target_type === 'seller')  return _reportTargetsCache.seller[r.target_id] || null;
    if (r.target_type === 'listing') return _reportTargetsCache.listing[r.target_id]?.profiles || null;
    return null;
  }

