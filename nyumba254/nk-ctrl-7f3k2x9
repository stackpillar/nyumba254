    tbody.innerHTML = filtered.map(r => {
      const listing = r.target_type==='listing' ? _reportTargetsCache.listing[r.target_id] : null;
      const seller  = reportTargetSeller(r);
      const repeatCount = seller ? (_reportSellerCountsApprox[seller.id]||1) : 0;
      const cover = listing ? ((listing.listing_photos||[]).find(p=>p.is_cover)||(listing.listing_photos||[])[0]) : null;
