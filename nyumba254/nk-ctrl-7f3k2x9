    const { error: cascadeErr } = await db.from('listings')
      .update({ is_disabled: true, disabled_reason: 'Seller account suspended' })
      .eq('seller_id', id).eq('is_disabled', false);
    if (cascadeErr) console.error('Listing cascade on suspend failed:', cascadeErr.message);
    await banAuthUser(id);
    logAction('suspend_profile','profile',id,reason);
    const u=_users[id];
    if (u?.email) {
      notifySeller('account_suspended', { sellerName: u.full_name, sellerEmail: u.email });
    }
    toast('Account suspended','success');
    if(u){ u.is_disabled=true; u.disabled_reason=reason; }
    if (currentView==='users') loadUsers();
    if (currentView==='reports') renderReportsTable();
    if (currentView==='listings') loadAllListings();
  }
  async function enableProfile(id) {
    const {error}=await db.from('profiles').update({is_disabled:false,disabled_reason:null}).eq('id',id);
    if(error){toast('Error','error');return;}
    await unbanAuthUser(id);
    logAction('reinstate_profile','profile',id,'');
    const u=_users[id];
    if (u?.email) {
      notifySeller('account_reinstated', { sellerName: u.full_name, sellerEmail: u.email });
    }
    toast('Account reinstated ✓','success');
    if(u){ u.is_disabled=false; u.disabled_reason=null; }
    closeProfileModal(); if (currentView==='users') loadUsers();
    if (currentView==='reports') renderReportsTable();
  }
  function deleteProfileFlow(id) {
    const u = _users[id];
    closeProfileModal();
    openConfirm({
      title:'Delete this seller?',
      message:`Removes ${u?.full_name||'this seller'}'s profile. Their login can only be removed via the Supabase admin API.`,
      warningText:'⚠ Cannot be undone.',
      confirmText:'Delete profile', confirmClass:'reject',
      onConfirm:()=>doDeleteProfile(id)
    });
  }
  async function doDeleteProfile(id) {
    // Clean up every listing this seller owns first — otherwise they're left
    // with a seller_id pointing at a profile row that no longer exists,
    // breaking any query that joins profiles(...).
    const { data: sellerListings } = await db.from('listings').select('id, listing_photos(*)').eq('seller_id', id);
    for (const row of (sellerListings||[])) await deleteListingCascade(row.id, row);

    const {data,error}=await db.from('profiles').delete().eq('id',id).select();
    if(error){toast('Error: '+error.message,'error');return;}
    if(!data?.length){toast('Blocked by RLS — check Supabase policy','error');return;}
    logAction('delete_profile','profile',id, sellerListings?.length?`Also removed ${sellerListings.length} listing(s)`:'');
    toast('Profile deleted','success'); loadUsers();
  }

