  function revokeVerification(sellerId) {
    const p = _verifySellers[sellerId]; if (!p) return;
    openConfirm({
      title:'Revoke verification?',
      message:`${p.full_name||'This seller'} will lose their verified badge and go back to the unverified listing limit. They'll need to resubmit documents to be verified again.`,
      requireReason:true, reasonLabel:'Internal note',
      confirmText:'Revoke verification', confirmClass:'reject',
      onConfirm: async (reason) => {
        const { error } = await db.from('profiles').update({ verification_status:'unverified', verification_reviewed_at:new Date().toISOString(), verification_reviewed_by: currentUser.id }).eq('id', sellerId);
