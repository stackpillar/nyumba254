.kv{display:grid;grid-template-columns:130px 1fr;gap:6px 12px;margin-bottom:16px}.kv dt{color:var(--tx3);font-size:12.5px}.kv dd{font-weight:500;word-break:break-word}
.sec{font:700 12px Inter;color:var(--tx3);margin:18px 0 8px}
.strip{display:flex;gap:8px;overflow-x:auto;margin-bottom:14px}.strip img{height:90px;border-radius:8px;border:1px solid var(--bd)}
