  // ── Plan coverage check — does the seller's ACTIVE subscription cover
  // this listing's category? Airbnb needs an active BNB plan; every other
  // category needs an active rental Premium/Elite plan with plan_category
  // set to 'rental'. Used both for the pre-approval warning and inside
  // doApprove itself.
  async function sellerPlanCoversListing(l) {
    if (!l?.seller_id) return false;
    const { data: prof } = await db.from('profiles')
      .select('has_bnb_capacity,bnb_expires_at,has_rental_capacity,subscription_tier,subscription_plan,subscription_expires_at')
      .eq('id', l.seller_id).single();
    const eliteActive = !!prof?.subscription_tier && prof.subscription_tier !== 'none' && prof?.subscription_plan === 'elite'
      && (!prof?.subscription_expires_at || new Date(prof.subscription_expires_at) > new Date());
    const bnbActive = !!prof?.has_bnb_capacity && prof?.bnb_expires_at && new Date(prof.bnb_expires_at) > new Date();
    const rentalActive = !!prof?.has_rental_capacity && prof?.subscription_tier && prof.subscription_tier !== 'none'
      && (!prof?.subscription_expires_at || new Date(prof.subscription_expires_at) > new Date());
    // Elite now covers unlimited BNB too — a BNB listing is covered by either
    // an active BNB-specific plan OR an active Elite subscription.
    return l.category === 'airbnb' ? (bnbActive || eliteActive) : rentalActive;
  }

  // ── Reactivation on plan grant/renewal — instant, no re-review. ──
  async function reactivateAirbnbListingsForSeller(sellerId) {
    await db.from('listings').update({ is_disabled:false, disabled_reason:null, disabled_at:null, disabled_by_subscription:false })
      .eq('seller_id', sellerId).eq('category','airbnb').eq('disabled_by_subscription', true);
    await db.from('listings').update({ status:'active', payment_status:'paid' })
      .eq('seller_id', sellerId).eq('category','airbnb').eq('status','approved_unpaid_bnb');
    if (currentView==='listings') loadAllListings();
    if (currentView==='overview') loadOverview();
  }
  async function reactivateRentalListingsForSeller(sellerId) {
    await db.from('listings').update({ is_disabled:false, disabled_reason:null, disabled_at:null, disabled_by_subscription:false })
      .eq('seller_id', sellerId).neq('category','airbnb').eq('disabled_by_subscription', true);
    await db.from('listings').update({ status:'active', payment_status:'paid' })
      .eq('seller_id', sellerId).neq('category','airbnb').eq('status','approved_unpaid');
    if (currentView==='listings') loadAllListings();
    if (currentView==='overview') loadOverview();
  }

  async function approveListing(id) {
    const l = _listings[id]; if(!l) return;
    if (l.payment_status==='paid' || l.payment_status==='trial') { doApprove(id,l.title); return; }
    const covered = await sellerPlanCoversListing(l);
    if (covered) { doApprove(id,l.title); return; }
    openConfirm({title:'Approve unpaid listing?', message:`"${l.title}" hasn't been paid for and isn't covered by an active plan. You can approve it anyway — the seller will be asked to pay for this listing separately.`, warningText:'⚠ This listing will go live without a confirmed payment.', confirmText:'Approve anyway', confirmClass:'approve', onConfirm:()=>doApprove(id,l.title)});
  }
  async function doApprove(id,title) {
    const l = _listings[id];
    const now = new Date();
    const isFutureScheduled = l?.publish_at && new Date(l.publish_at) > now;
    const isTrial = l?.payment_status === 'trial';
    const isPaid  = l?.payment_status === 'paid';
    const isAirbnb = l?.category === 'airbnb';

    // Covers BOTH cases now: an active BNB plan for airbnb listings, and an
    // active rental Premium/Elite plan for every other category. Either way,
    // a covered listing goes straight to active — no per-listing payment.
    const planCoversThis = (!isTrial && l?.seller_id) ? await sellerPlanCoversListing(l) : false;

    const newStatus = isFutureScheduled ? 'scheduled'
      : (isTrial || isPaid || planCoversThis) ? 'active'
      : isAirbnb ? 'approved_unpaid_bnb'
      : 'approved_unpaid';

    const {data,error} = await db.from('listings').update({status:newStatus, payment_status: planCoversThis ? 'paid' : l.payment_status}).eq('id',id).select();
    if (error)       { toast('Error approving: '+error.message,'error'); return; }
    if (!data?.length){ toast('Blocked by RLS — check Supabase policy','error'); return; }
    logAction(isFutureScheduled ? 'approve_listing_scheduled' : 'approve_listing','listing',id,title||'');

    if (l?.profiles?.email) {
      if (isTrial) {
        notifySeller('listing_approved', { listingId: id, listingTitle: title, sellerName: l.profiles.full_name, sellerEmail: l.profiles.email });
      } else if (isFutureScheduled) {
        notifySeller('listing_scheduled', { listingId: id, listingTitle: title, publishAt: l.publish_at, sellerName: l.profiles.full_name, sellerEmail: l.profiles.email });
      } else if (planCoversThis) {
        notifySeller('listing_approved', { listingId: id, listingTitle: title, sellerName: l.profiles.full_name, sellerEmail: l.profiles.email });
      } else if (isAirbnb) {
        notifySeller('listing_approved_subscribe_bnb', { listingId: id, listingTitle: title, sellerName: l.profiles.full_name, sellerEmail: l.profiles.email });
      } else if (!isPaid) {
        const standardAmount = calcUpgradeAmount(l,'basic');
        const featuredAmount = calcUpgradeAmount(l,'featured');
        await db.from('listings').update({ payment_due_amount: standardAmount }).eq('id', id);
        notifySeller('listing_approved_payment_required', {
          listingId: id, listingTitle: title, standardAmount, featuredAmount,
          sellerName: l.profiles.full_name, sellerEmail: l.profiles.email,
        });
      } else {
        notifySeller('listing_approved', { listingId: id, listingTitle: title, sellerName: l.profiles.full_name, sellerEmail: l.profiles.email });
      }
    }
    notifySms('listing_status', { listingId: id, listingTitle: title, status: newStatus });
    toast(
      isFutureScheduled ? `Listing approved — will go live ${new Date(l.publish_at).toLocaleString('en-KE')} ✓` :
      newStatus==='active' ? (planCoversThis ? 'Approved — live now, covered by seller\'s plan ✓' : 'Listing approved and live ✓') :
      newStatus==='approved_unpaid_bnb' ? 'Approved — seller notified to subscribe to a BNB plan' :
      'Listing approved — seller notified to pay before it goes live',
      'success'
    );
    loadOverview(); if(currentView==='listings') loadAllListings();
    if (newStatus==='active') { maybeAutoPostSocial(id); checkAndNotifyDemandMatches(id, l); }
  }

  async function checkAndNotifyDemandMatches(listingId, l) {
    try {
      let q = db.from('listing_alerts').select('id', {count:'exact', head:true});
      if (l.area) q = q.eq('area', l.area);
      if (l.category) q = q.eq('category', l.category);
      const { count } = await q;
      if (!count) return;
      await db.from('seller_demand_notices').insert({ seller_id: l.seller_id, listing_id: listingId, area: l.area, category: l.category, match_count: count });
      const sub = l.profiles;
      const active = sub?.subscription_tier && sub.subscription_tier !== 'none' && (!sub.subscription_expires_at || new Date(sub.subscription_expires_at) > new Date());
      if (active && sub?.email) {
        notifySeller('demand_match', { listingId, listingTitle: l.title, sellerName: sub.full_name, sellerEmail: sub.email, matchCount: count, area: l.area });
      }
    } catch(e) { console.error('Demand match check failed:', e); }
  }

