      <div class="field"><label>Seller since</label><div class="val">${fmtDate(seller.created_at)}</div></div>
      <div class="field"><label>Account status</label><div class="val">${seller.is_disabled?`<span class="badge rejected">suspended</span>${seller.disabled_reason?' — '+esc(seller.disabled_reason):''}`:'<span class="badge active">active</span>'}</div></div>
