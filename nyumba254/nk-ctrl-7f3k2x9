const S={user:null,me:null,cfg:{sale_standard_pct:.1,sale_featured_pct:.15,rent_standard_pct:3,rent_featured_pct:6,standard_min_fee:500,standard_max_fee:18000,featured_min_fee:1200,featured_max_fee:28000,standard_fee_per_unit:50,featured_fee_per_unit:150,trial_days:14,standard_duration_days:60,featured_duration_days:90,recycle_bin_days:30,premium_monthly_price:1200,premium_yearly_price:12000,elite_monthly_price:3000,elite_yearly_price:30000,elite_ai_listing_uses_monthly:20,elite_valuation_uses_monthly:20,bnb_basic_price:700,bnb_bundle_price:2000,require_payment_to_publish:1,enforce_verification_general:0,unverified_listing_limit:2},social:{facebook:false,instagram:false,tiktok:false}};
async function loadSettings(){
  const{data}=await db.from('platform_settings').select('key,value');
  (data||[]).forEach(r=>{
    if(r.key in S.cfg)S.cfg[r.key]=Number(r.value);
    const m=/^auto_post_(facebook|instagram|tiktok)$/.exec(r.key);if(m)S.social[m[1]]=r.value==='1'||r.value===1;
  });
}
function calcFee(price,type,plan){
  price=Math.max(0,Number(price)||0);const f=plan==='featured'?'featured':'standard';
  const pct=Number(S.cfg[`${type==='rent'?'rent':'sale'}_${f}_pct`])||0;
  return Math.round(Math.max(Number(S.cfg[f+'_min_fee'])||0,Math.min(Number(S.cfg[f+'_max_fee'])||Infinity,price*pct/100)));
}
function upgradeAmount(l,plan){
  const type=l.price_type==='rent'?'rent':'sale',f=plan==='featured'?'featured':'standard',u=l.listing_units||[];
  if(u.length){const pv=u.reduce((s,x)=>s+Number(x.price||0)*Number(x.quantity_total??x.quantity_available??1),0);return calcFee(pv,type,f)+S.cfg[f+'_fee_per_unit']*u.length;}
  return calcFee(l.price,type,f);
}

