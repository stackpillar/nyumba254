      ` : `<div class="field"><label>Current video link</label><div class="val" style="color:var(--text-3)">No video on this listing</div></div>`}
      <div class="field"><label>${current ? 'Replace with a new link' : 'Add a video link'}</label>
        <input type="text" id="admin-video-url" placeholder="https://youtube.com/watch?v=… or TikTok/Instagram/Vimeo/direct file link"/>
      </div>
      <hr style="border:none;border-top:1px solid var(--border);margin:16px 0"/>
      <div class="field"><label>Seller</label><div class="val">${esc(seller?.full_name || '—')}</div></div>
      <div class="field check-field"><input type="checkbox" id="admin-video-block" ${blocked?'checked':''}/><label for="admin-video-block">Block this seller from adding video walkthroughs</label></div>
      ${blocked && seller?.video_walkthrough_block_reason ? `<div class="confirm-warning">Currently blocked: ${esc(seller.video_walkthrough_block_reason)}</div>` : ''}
