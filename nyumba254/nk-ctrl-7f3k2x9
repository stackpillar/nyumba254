    mobileEl.innerHTML = '';

    const [{ data: summary, error: sumErr }, { data: blocked, error: blkErr }] = await Promise.all([
      db.rpc('get_contact_reveal_summary', { p_hours: 24 }),
      db.rpc('get_blocked_devices'),
    ]);

    if (sumErr) console.error('get_contact_reveal_summary error:', sumErr);
    if (blkErr) console.error('get_blocked_devices error:', blkErr);

