      <div class="card" style="padding:18px"><small>Preview — what sellers will see</small><h3 id="pvt" style="margin:8px 0 6px"></h3><p id="pvm" style="white-space:pre-wrap;color:var(--tx2)"></p></div></div>`;
      const pv=()=>{$('#pvt',box).textContent=$('#ptl',box).value||'(no title yet)';$('#pvm',box).textContent=$('#pm',box).value||'(no message yet)';$('#pcn',box).textContent=`${$('#pm',box).value.length} / 2000`;};
      const ac=debounce(async()=>{$('#pac',box).textContent=`≈ ${await audienceCount($('#pa',box).value)} seller(s) will receive this`;},200);
      $('#pt',box).onchange=e=>{const t=PU_TPL[e.target.value];if(!t)return;$('#pc',box).value=t.category;$('#ptl',box).value=t.title;$('#pm',box).value=t.message;$('#pl',box).value=t.link;pv();};
      box.addEventListener('input',pv);$('#pa',box).onchange=ac;ac();pv();
      $('#ps',box).onclick=async()=>{
        const title=$('#ptl',box).value.trim(),message=$('#pm',box).value.trim(),audience=$('#pa',box).value;if(!title||!message)return ui.toast('Title and message are required','err');
        if(/\[[^\]]+\]/.test(message+title)&&!await ui.confirm({title:'Placeholders still in the text',message:'Your message still contains [bracketed placeholders]. Send anyway?',confirm:'Send anyway',danger:true}))return;
        const n=await audienceCount(audience);if(!await ui.confirm({title:`Send to ${n} seller(s)?`,message:`<b>${esc(title)}</b><br>This sends immediately and can’t be recalled.`,confirm:'Send now'}))return;
        const b=$('#ps',box);b.disabled=true;b.textContent='Sending…';
        try{
          const{data:{session}}=await db.auth.getSession();
          const r=await fetch(`${EDGE}/send-platform-announcement`,{method:'POST',headers:{'Content-Type':'application/json',apikey:SUPABASE_KEY,Authorization:`Bearer ${session?.access_token||SUPABASE_KEY}`},body:JSON.stringify({title,message,link:$('#pl',box).value.trim()||null,category:$('#pc',box).value,sendNotification:$('#pn',box).checked,sendEmail:$('#pe',box).checked,audience,createdBy:S.user.id})});
          const body=await r.json();if(!r.ok||body.error)throw new Error(body.error||'Failed to send');
          ui.toast(`Sent to ${body.recipients} seller(s) — ${body.emailsSent||0} email(s) delivered`,'ok');logAction('send_platform_update','announcement',body.announcementId,title);tab='history';paint();
        }catch(e){ui.toast('Could not send: '+e.message,'err');b.disabled=false;b.textContent='Send to sellers';}
      };
    }else if(tab==='auto'){
      const{data,error}=await db.from('platform_automation_rules').select('*').order('id');
      box.innerHTML=`<p class="intro">These rules run on a schedule and message sellers automatically (each seller at most once per rule every 20 hours). Toggle a rule on to activate it.</p>`+(error||!data?.length?'<div class="card empty"><h4>No automation rules found</h4><p>Run the setup SQL to seed the defaults.</p></div>':data.map(r=>`<div class="card" style="padding:16px;margin-bottom:10px"><div style="display:flex;justify-content:space-between;align-items:center;gap:12px"><div><b>${esc(r.rule_key.replace(/_/g,' '))}</b> ${bd(r.enabled?'active':'off',r.enabled?'ok':'mute')}<br><small>${r.last_run_at?'Last checked '+dtt(r.last_run_at):'Never run yet'}</small></div><label class="chk" style="margin:0"><input type="checkbox" data-r="${r.id}" ${r.enabled?'checked':''}> Enabled</label></div><div class="fld" style="margin:12px 0 8px"><input class="in" id="rt${r.id}" value="${esc(r.title)}"></div><div class="fld"><textarea class="in" id="rm${r.id}" rows="2">${esc(r.message)}</textarea></div><button class="btn sm" data-sv="${r.id}">Save wording</button></div>`).join(''));
      box.onchange=async e=>{const c=e.target.closest('[data-r]');if(!c)return;const{error}=await db.from('platform_automation_rules').update({enabled:c.checked,updated_at:new Date().toISOString(),updated_by:S.user.id}).eq('id',c.dataset.r);if(error){ui.toast(error.message,'err');c.checked=!c.checked;return;}logAction('toggle_automation_rule','automation_rule',c.dataset.r,c.checked?'enabled':'disabled');ui.toast(c.checked?'Rule enabled':'Rule disabled','ok');paint();};
      box.onclick=async e=>{const s=e.target.closest('[data-sv]');if(!s)return;const id=s.dataset.sv,t=$('#rt'+id,box).value.trim(),m=$('#rm'+id,box).value.trim();if(!t||!m)return ui.toast('Title and message are required','err');const{error}=await db.from('platform_automation_rules').update({title:t,message:m,updated_at:new Date().toISOString(),updated_by:S.user.id}).eq('id',id);ui.toast(error?error.message:'Wording saved',error?'err':'ok');};
    }else{
      box.innerHTML='';
      const T=Table({route:'updates',params:{},size:50,id:r=>r.id,search:'',tabs:[{id:'all',label:'All'},{id:'manual',label:'Manual'},{id:'automated',label:'Automated'}],
        async fetch(st){let q=db.from('platform_announcements').select('*',{count:'exact'});if(st.tab!=='all')q=q.eq('trigger_source',st.tab);const{data,error,count}=await q.order('created_at',{ascending:false}).range(st.page*st.size,st.page*st.size+st.size-1);if(error)throw error;return{rows:data,count};},
        columns:[{label:'Title',nl:1,render:r=>`<b style="color:var(--tx)">${esc(r.title)}</b>`},{label:'Category',render:r=>bd((r.category||'').replace(/_/g,' '),'info')},{label:'Source',render:r=>bd(r.trigger_source==='automated'?'automated':'manual','mute')},{label:'Audience',render:r=>esc((r.audience||'').replace(/_/g,' '))},{label:'Recipients',render:r=>r.recipient_count},{label:'Emails',render:r=>`${r.emails_sent||0} sent${r.emails_failed?` · ${r.emails_failed} failed`:''}`},{label:'Sent',render:r=>dtt(r.created_at)}],
        empty:['No broadcasts yet','Sent updates are listed here.']}).mount(box);
    }
  }
  paint();
}};

/* ═════════ BOOT ═════════ */
async function boot(){
  const{data:{user}}=await db.auth.getUser();
  if(!user){$('#gate').remove();$('#login').hidden=false;return;}
  const{data:me}=await db.from('profiles').select('*').eq('id',user.id).single();
  if(!me||me.role!=='admin'){await db.auth.signOut();$('#gate').remove();$('#login').hidden=false;$('#lge').hidden=false;$('#lge').textContent='This account does not have admin access.';return;}
  S.user=user;S.me=me;await loadSettings();buildShell();
  $('#login').hidden=true;$('#app').hidden=false;$('#gate').remove();
  window.addEventListener('hashchange',route);await route();refreshBadges();
  const live=debounce(refreshBadges,1500);
  db.channel('admin-live').on('postgres_changes',{event:'*',schema:'public',table:'reports'},live).on('postgres_changes',{event:'*',schema:'public',table:'payments'},()=>{live();ui.active?.cfg.route==='payments'&&ui.active.reload();}).on('postgres_changes',{event:'INSERT',schema:'public',table:'listings'},()=>{live();ui.toast('A new listing was submitted');}).on('postgres_changes',{event:'INSERT',schema:'public',table:'chat_messages'},pl=>{live();if(pl.new.sender!=='admin'&&parseHash().id!=='support')ui.toast('New support message','',{label:'Open',fn:()=>go('support')});}).subscribe();
  document.addEventListener('visibilitychange',()=>{if(!document.hidden)refreshBadges();});
}
$('#lgf').onsubmit=async e=>{
  e.preventDefault();const b=$('#lgb'),er=$('#lge');er.hidden=true;b.disabled=true;b.textContent='Signing in…';
  const{error}=await db.auth.signInWithPassword({email:$('#lem').value.trim(),password:$('#lpw').value});
  b.disabled=false;b.textContent='Sign in';
  if(error){er.hidden=false;er.textContent=/invalid/i.test(error.message)?'Incorrect email or password.':error.message;return;}
  location.hash='';location.reload();
};
boot();
</script>
