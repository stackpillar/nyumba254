    const { count: trialCount } = await db.from('listings').select('*',{count:'exact',head:true}).eq('payment_status','trial').eq('recycle_bin',false);
    document.getElementById('nav-badge-trial').textContent = trialCount||0;

    const { count: multiUnitCount } = await db.from('listings').select('*, listing_units!inner(id)',{count:'exact',head:true}).eq('recycle_bin',false);
    document.getElementById('nav-badge-multiunit').textContent = multiUnitCount||0;

    const { data: pays } = await db.from('payments').select('amount,type').eq('status','confirmed');
    const rev      = (pays||[]).reduce((s,p) => s + Number(p.amount), 0);
    // Sum what was actually paid per type — NOT count × current SETTINGS
    // price, which would silently misreport history the moment a price is
    // edited (old payments were made at whatever the rate was back then).
    const stdRev   = (pays||[]).filter(p=>p.type==='listing_fee').reduce((s,p)=>s+Number(p.amount),0);
    const featRev  = (pays||[]).filter(p=>p.type==='featured_upgrade').reduce((s,p)=>s+Number(p.amount),0);
    document.getElementById('stat-revenue').textContent = rev.toLocaleString('en-KE');
    document.getElementById('rev-standard').textContent = `KES ${stdRev.toLocaleString()}`;
    document.getElementById('rev-featured').textContent = `KES ${featRev.toLocaleString()}`;
    document.getElementById('rev-total').textContent    = `KES ${rev.toLocaleString()}`;

    const { data: activeRows } = await db.from('listings').select('county,area').eq('status','active').eq('recycle_bin',false);
    const countyCounts = {};
    (activeRows||[]).forEach(r => {
      const key = r.county || 'Kisumu';
      countyCounts[key] = (countyCounts[key]||0) + 1;
    });
    const countyBreakdown = Object.entries(countyCounts).sort((a,b)=>b[1]-a[1]).slice(0,8);
    document.getElementById('area-breakdown').innerHTML = countyBreakdown.length
      ? countyBreakdown.map(([county,count])=>`<div class="quick-row"><span>${esc(county)}</span><span>${count}</span></div>`).join('')
      : '<div class="quick-row"><span>No active listings yet</span><span>—</span></div>';

    for (const cat of ['apartment','house','boarding','airbnb','commercial']) {
      const {count} = await db.from('listings').select('*',{count:'exact',head:true}).eq('category',cat).eq('status','active').eq('recycle_bin',false);
      const el = document.getElementById('cat-'+cat);
      if (el) el.textContent = count||0;
    }

    loadPendingPreview();
    loadTabCounts();
  }

