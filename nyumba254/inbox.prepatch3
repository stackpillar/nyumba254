  const dateShort = iso => new Date(iso + 'T00:00:00').toLocaleDateString(loc(), { day: 'numeric', month: 'short' });
  const dateLong = iso => new Date(iso + 'T00:00:00').toLocaleDateString(loc(), { weekday: 'short', day: 'numeric', month: 'short' });
  const SLOTS = [['Morning (8am–11am)', 'Morning, 8am to 11am', 'Asubuhi, 8am hadi 11am'], ['Midday (11am–2pm)', 'Midday, 11am to 2pm', 'Mchana, 11am hadi 2pm'], ['Afternoon (2pm–5pm)', 'Afternoon, 2pm to 5pm', 'Alasiri, 2pm hadi 5pm'], ['Evening (5pm–7pm)', 'Evening, 5pm to 7pm', 'Jioni, 5pm hadi 7pm']];
  const SLOT_HOURS = { 'Morning (8am–11am)': [8, 11], 'Midday (11am–2pm)': [11, 14], 'Afternoon (2pm–5pm)': [14, 17], 'Evening (5pm–7pm)': [17, 19] };
  const slotName = v => { const s = SLOTS.find(x => x[0] === v); return s ? s[lang === 'sw' ? 2 : 1] : v; };

