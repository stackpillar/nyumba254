<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>My Chats — Nyumba254</title>
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#0F6E56">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --green:#0F6E56; --green-dark:#085041; --tint:#E1F5EE; --tint-border:#bfe6d8;
    --surface:#fff; --app-bg:#f7f6f2; --border:#e0ded8;
    --ink:#1a1a18; --ink-2:#4a4a46; --muted:#6b6a63; --alert:#C53030;
    --amber:#7a4f00; --amber-bg:#FFF7E6; --amber-border:#F3D9A0;
  }
  *,*::before,*::after{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{font-family:'Inter',system-ui,sans-serif;color:var(--ink);background:var(--app-bg);overflow:hidden}
  button,input,textarea,select{font-family:inherit}
  button{cursor:pointer}
  :focus-visible{outline:2px solid var(--green);outline-offset:2px}
  a{color:inherit}
  [hidden]{display:none!important}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
  @media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
  #ni-app{display:flex;flex-direction:column;height:100vh;height:100dvh}

  /* ── Header ── */
  #ni-header{flex-shrink:0;background:var(--green);color:#fff;display:flex;align-items:center;gap:10px;padding:10px 20px;padding-top:calc(10px + env(safe-area-inset-top,0px));min-height:60px}
  #ni-back{display:flex;align-items:center;gap:5px;font-size:13.5px;font-weight:600;text-decoration:none;color:rgba(255,255,255,.92);flex-shrink:0;white-space:nowrap;min-height:44px}
  #ni-back:hover{color:#fff}
  #ni-back svg{width:15px;height:15px}
  #ni-title-wrap{flex:1;min-width:0}
  #ni-title{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;line-height:1.2}
  #ni-subtitle{font-size:12.5px;opacity:.88;margin-top:1px}
  #ni-nav{display:none;gap:4px}
  #ni-nav a{color:rgba(255,255,255,.92);text-decoration:none;font-size:13.5px;font-weight:600;padding:0 12px;min-height:40px;display:inline-flex;align-items:center;border-radius:20px}
  #ni-nav a:hover{background:rgba(255,255,255,.16);color:#fff}
  @media(min-width:1000px){#ni-nav{display:flex}}
  .ni-hbtn{flex-shrink:0;background:rgba(255,255,255,.16);border:0;color:#fff;padding:0 14px;height:40px;border-radius:20px;display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600}
  .ni-hbtn:hover{background:rgba(255,255,255,.28)}
  .ni-hbtn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0}
  @media(max-width:640px){#ni-header{padding-left:12px;padding-right:12px;gap:6px}.ni-hbtn.icon span{display:none}.ni-hbtn.icon{width:44px;height:44px;padding:0;justify-content:center;border-radius:50%}#ni-back span{display:none}#ni-title{font-size:19px}#ni-subtitle{display:none}#ni-lang{padding:0 12px}}
  #ni-net{display:none;background:var(--amber-bg);color:var(--amber);border-bottom:1px solid var(--amber-border);font-size:13px;padding:8px 16px;text-align:center;flex-shrink:0}
  #ni-net.show{display:block}

  /* ── Body: 1 pane on phones, 2 on computers, 3 on wide screens ── */
  #ni-body{flex:1;display:flex;min-height:0}
  #ni-sidebar{width:370px;flex-shrink:0;display:flex;flex-direction:column;border-right:1px solid var(--border);background:var(--surface);min-height:0}
  #ni-tabs{display:flex;gap:6px;padding:10px 12px 0;flex-shrink:0}
  .ni-tab{flex:1;min-height:44px;border:1.5px solid var(--border);border-radius:10px;background:var(--surface);color:var(--ink-2);font-size:13.5px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:6px}
  .ni-tab[aria-selected="true"]{background:var(--green);border-color:var(--green);color:#fff}
  .ni-count{background:var(--alert);color:#fff;border-radius:10px;font-size:11px;padding:1px 7px;min-width:19px;text-align:center}
  #ni-search-row{padding:10px 12px 6px;flex-shrink:0}
  #ni-search{width:100%;min-height:44px;padding:9px 13px;border:1.5px solid var(--border);border-radius:10px;font-size:16px;background:var(--app-bg);color:var(--ink);outline:none}
  #ni-search:focus{border-color:var(--green);background:#fff}
  #ni-filters{display:flex;gap:6px;overflow-x:auto;padding:4px 12px 10px;flex-shrink:0;scrollbar-width:none;border-bottom:1px solid var(--border)}
  #ni-filters::-webkit-scrollbar{display:none}
  .ni-fchip{flex-shrink:0;min-height:36px;padding:0 13px;border-radius:18px;border:1.5px solid var(--border);background:var(--surface);color:var(--ink-2);font-size:13px;font-weight:600;display:inline-flex;align-items:center;gap:6px}
  .ni-fchip[aria-pressed="true"]{background:var(--tint);border-color:var(--green);color:var(--green-dark)}
  .ni-fchip .ni-count{font-size:10.5px}
  #ni-notif{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--tint);border-bottom:1px solid var(--tint-border);flex-shrink:0;font-size:13px;color:var(--green-dark)}
  #ni-notif p{flex:1;margin:0;font-weight:600;line-height:1.35}
  #ni-notif button{min-height:36px;border-radius:18px;border:0;padding:0 14px;font-size:12.5px;font-weight:700}
  #ni-notif .yes{background:var(--green);color:#fff}#ni-notif .no{background:transparent;color:var(--green-dark)}
  #ni-list,#ni-saved{flex:1;overflow-y:auto;min-height:0;overscroll-behavior:contain;position:relative}
  #ni-saved{display:flex;flex-direction:column}
  #ni-ptr{display:none;text-align:center;font-size:12.5px;color:var(--green-dark);background:var(--tint);padding:8px;flex-shrink:0}
  #ni-ptr.show{display:block}
  .ni-state{padding:44px 24px;text-align:center;color:var(--muted);font-size:14px;line-height:1.55}
  .ni-state h4{margin:0 0 6px;font-size:16px;color:var(--ink)}
  .ni-btn{background:var(--green);color:#fff;border:0;border-radius:10px;min-height:44px;padding:0 20px;font-size:14px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;text-decoration:none}
  .ni-btn:hover{background:var(--green-dark)}.ni-btn:disabled{opacity:.55;cursor:not-allowed}
  .ni-btn.ghost{background:var(--app-bg);color:var(--ink-2)}.ni-btn.ghost:hover{background:var(--border)}
  .ni-state .ni-btn{margin-top:14px}
  .ni-sk{height:48px;margin:14px;border-radius:10px;background:linear-gradient(90deg,var(--border) 25%,var(--app-bg) 50%,var(--border) 75%);background-size:200% 100%;animation:ni-sh 1.3s infinite}
  @keyframes ni-sh{to{background-position:-200% 0}}

  .ni-swipe{position:relative;overflow:hidden;border-bottom:1px solid var(--border);background:var(--green-dark)}
  .ni-swipe-bg{position:absolute;inset:0;display:flex;align-items:center;justify-content:flex-end;padding-right:22px;color:#fff;font-size:13px;font-weight:700}
  .ni-convo{position:relative;display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:13px 15px;border:0;background:var(--surface);color:inherit;min-height:76px;touch-action:pan-y;transition:transform .18s ease}
  .ni-convo.dragging{transition:none}
  .ni-convo:hover,.ni-convo[aria-current="true"]{background:var(--app-bg)}
  .ni-thumb{width:48px;height:48px;border-radius:10px;background:var(--border);flex-shrink:0;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:var(--green-dark)}
  .ni-thumb img{width:100%;height:100%;object-fit:cover}
  .ni-cb{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
  .ni-ct{font-size:14px;font-weight:600;display:flex;align-items:center;gap:5px;min-width:0}
  .ni-ct span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ni-ct svg{width:13px;height:13px;color:var(--green);flex-shrink:0}
  .ni-cl{font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ni-draft{color:var(--alert);font-weight:600}
  .ni-vtag{align-self:flex-start;font-size:11.5px;font-weight:600;color:var(--green-dark);background:var(--tint);border-radius:10px;padding:1px 8px}
  .ni-cm{display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex-shrink:0}
  .ni-cw{font-size:11.5px;color:var(--muted)}
  .ni-badge{background:var(--alert);color:#fff;font-size:11px;font-weight:700;border-radius:10px;min-width:20px;height:20px;padding:0 5px;display:flex;align-items:center;justify-content:center}
  .ni-arch{position:absolute;right:8px;bottom:8px;width:36px;height:36px;border-radius:50%;border:0;background:var(--surface);color:var(--muted);display:none;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.18)}
  .ni-arch svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2}
  .ni-arch:hover{color:var(--green-dark);background:var(--tint)}
  @media(hover:hover){.ni-swipe:hover .ni-arch,.ni-swipe:focus-within .ni-arch{display:flex}}

  /* saved tab */
  #ni-saved-tools{display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1px solid var(--border);flex-shrink:0}
  #ni-saved-sort{flex:1;min-height:44px;border:1.5px solid var(--border);border-radius:10px;padding:0 10px;font-size:14px;background:var(--surface);color:var(--ink)}
  #ni-cmp-btn{min-height:44px;padding:0 14px;font-size:13px}
  #ni-saved-list{flex:1;overflow-y:auto;min-height:0}
  .ni-saved-row{display:flex;align-items:center;gap:6px;padding:6px 6px 6px 8px;border-bottom:1px solid var(--border);min-height:76px}
  .ni-saved-row:hover{background:var(--app-bg)}
  .ni-cmp{width:44px;height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .ni-cmp input{width:20px;height:20px;accent-color:var(--green)}
  .ni-saved-link{display:flex;align-items:center;gap:12px;flex:1;min-width:0;text-decoration:none;color:inherit;min-height:56px}
  .ni-saved-body{flex:1;min-width:0}
  .ni-saved-title{font-size:14px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block}
  .ni-saved-sub{font-size:12.5px;color:var(--muted);margin-top:2px;display:block}
  .ni-saved-price{font-size:13px;font-weight:700;color:var(--green-dark);margin-top:3px;display:block}
  .ni-sold{display:inline-block;font-size:11px;font-weight:700;color:#fff;background:var(--alert);border-radius:10px;padding:1px 8px;margin-left:6px}
  .ni-saved-rm{border:0;background:none;color:var(--muted);font-size:17px;width:44px;height:44px;border-radius:50%;flex-shrink:0}
  .ni-saved-rm:hover{background:var(--border);color:var(--ink)}
  .ni-cmp-table{width:100%;border-collapse:collapse;font-size:13.5px}
  .ni-cmp-table th,.ni-cmp-table td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--border);vertical-align:top}
  .ni-cmp-table th{color:var(--muted);font-weight:600;width:96px}
  .ni-cmp-table td.best{background:var(--tint);font-weight:700;color:var(--green-dark)}
  .ni-cmp-scroll{overflow-x:auto}

  /* ── Thread pane ── */
  #ni-thread-pane{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0;background:var(--app-bg)}
  #ni-thread-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);font-size:14.5px;padding:20px;text-align:center;gap:6px}
  #ni-thread-empty small{font-size:12.5px}
  #ni-thread{display:none;flex-direction:column;flex:1;min-height:0}
  #ni-thread.open{display:flex}
  #ni-thead{position:relative;background:var(--green);color:#fff;padding:8px 8px 8px 8px;display:flex;align-items:center;gap:4px;flex-shrink:0;min-height:60px}
  .ni-ib{background:none;border:0;color:#fff;min-width:44px;height:44px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;opacity:.92}
  .ni-ib:hover,.ni-hpill:hover{background:rgba(255,255,255,.18);opacity:1}
  .ni-ib svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2}
  .ni-hpill{background:rgba(255,255,255,.14);border:0;color:#fff;height:40px;padding:0 14px;border-radius:20px;display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;flex-shrink:0}
  .ni-hpill svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2}
  #ni-back-btn{display:none}
  #ni-details-btn{display:none}
  #ni-tinfo{flex:1;min-width:0;padding-left:6px}
  #ni-tname{font-size:15.5px;font-weight:600;display:flex;align-items:center;gap:5px;min-width:0}
  #ni-tname span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #ni-tname svg{width:15px;height:15px;color:#7CE0C0;flex-shrink:0}
  #ni-presence{display:flex;align-items:center;gap:6px;font-size:12px;color:rgba(255,255,255,.88);margin-top:1px}
  #ni-dot{width:7px;height:7px;border-radius:50%;background:#b8b8b0;flex-shrink:0}
  #ni-dot.online{background:#2ecc71}#ni-dot.typing{background:#F0B429}
  #ni-menu{position:absolute;right:8px;top:calc(100% - 4px);z-index:30;min-width:230px;background:var(--surface);color:var(--ink);border:1px solid var(--border);border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.2);padding:6px;display:none}
  #ni-menu.open{display:block}
  #ni-menu button{display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:0;background:none;min-height:46px;padding:0 12px;border-radius:8px;font-size:14px;color:inherit}
  #ni-menu button:hover,#ni-menu button:focus-visible{background:var(--app-bg)}
  #ni-menu svg{width:18px;height:18px;stroke:var(--green-dark);fill:none;stroke-width:2;flex-shrink:0}
  #ni-menu hr{border:0;border-top:1px solid var(--border);margin:4px 0}
  #ni-menu .danger{color:var(--alert)}#ni-menu .danger svg{stroke:var(--alert)}
  #ni-searchbar{display:none;align-items:center;gap:8px;padding:8px 14px;background:var(--tint);border-bottom:1px solid var(--border);flex-shrink:0}
  #ni-searchbar.show{display:flex}
  #ni-tsearch{flex:1;min-height:40px;padding:6px 12px;border:1.5px solid var(--tint-border);border-radius:9px;font-size:16px;outline:none;background:#fff;color:var(--ink)}
  #ni-tcount{font-size:12px;color:var(--green-dark);white-space:nowrap}
  #ni-tsearch-x{border:0;background:none;color:var(--green-dark);font-size:18px;width:40px;height:40px}
  #ni-gone{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:9px 16px;background:#FFF5F5;border-bottom:1px solid #f0caca;color:var(--alert);font-size:13.5px;font-weight:600;flex-shrink:0}
  #ni-gone p{margin:0;flex:1 1 200px}
  #ni-gone a{color:var(--alert);text-decoration:underline;font-weight:700;min-height:36px;display:inline-flex;align-items:center}
  #ni-vstrip{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:8px 16px;background:var(--surface);border-bottom:1px solid var(--border);flex-shrink:0}
  #ni-vstrip-t{flex:1 1 200px;font-size:13.5px;font-weight:600;color:var(--green-dark)}
  #ni-vstrip button{min-height:36px;border-radius:18px;border:1.5px solid var(--green);background:var(--surface);color:var(--green-dark);font-size:12.5px;font-weight:700;padding:0 13px}
  #ni-vstrip button:hover{background:var(--tint)}
  .ni-lcard{display:flex;align-items:center;gap:12px;padding:9px 16px;background:var(--tint);border-bottom:1px solid var(--border);flex-shrink:0;text-decoration:none;color:inherit;min-height:60px}
  a.ni-lcard:hover{background:var(--surface)}
  .ni-lcard .ni-thumb{width:42px;height:42px;border-radius:8px}
  .ni-lc-t{flex:1;min-width:0;display:flex;flex-direction:column}
  .ni-lc-t b{font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ni-lc-t span{font-size:12.5px;color:var(--green-dark);font-weight:600}
  .ni-lc-go{font-size:12.5px;font-weight:700;color:var(--green-dark);white-space:nowrap}
  #ni-safety{display:none;align-items:center;gap:8px;padding:8px 16px;background:var(--amber-bg);border-bottom:1px solid var(--amber-border);font-size:13px;color:var(--amber);line-height:1.45;flex-shrink:0}
  #ni-safety.show{display:flex}
  #ni-safety p{flex:1;margin:0}
  #ni-safety button{background:none;border:0;color:inherit;font-weight:700;font-size:13px;text-decoration:underline;min-height:36px;padding:0 6px}

  #ni-msgs-wrap{position:relative;flex:1;min-height:0;display:flex;flex-direction:column}
  #ni-messages{flex:1;min-height:0;overflow-y:auto;padding:18px 20px;display:flex;flex-direction:column;gap:2px;overscroll-behavior:contain}
  #ni-newpill{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);display:none;background:var(--green);color:#fff;border:0;border-radius:20px;padding:0 18px;min-height:38px;font-size:13px;font-weight:600;box-shadow:0 4px 14px rgba(0,0,0,.25)}
  #ni-newpill.show{display:block}
  #ni-typing{position:absolute;left:18px;bottom:8px;display:none;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:7px 12px;font-size:12px;color:var(--muted);box-shadow:0 2px 8px rgba(0,0,0,.08)}
  #ni-typing.show{display:flex}
  .ni-dots{display:inline-flex;gap:3px}
  .ni-dots i{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:ni-bounce 1s infinite}
  .ni-dots i:nth-child(2){animation-delay:.15s}.ni-dots i:nth-child(3){animation-delay:.3s}
  @keyframes ni-bounce{0%,60%,100%{transform:translateY(0);opacity:.5}30%{transform:translateY(-4px);opacity:1}}
  .ni-earlier{align-self:center;min-height:38px;border-radius:19px;border:1.5px solid var(--border);background:var(--surface);color:var(--green-dark);font-size:13px;font-weight:600;padding:0 16px;margin-bottom:8px}
  .ni-earlier:hover{background:var(--tint)}
  .ni-empty-thread{margin:auto;text-align:center;color:var(--muted);font-size:14px;line-height:1.6;padding:24px}
  .ni-empty-thread b{display:block;color:var(--ink);font-size:16px;margin-bottom:4px}
  .ni-empty-thread .ni-btn{margin-top:12px}
  .ni-day{text-align:center;font-size:12px;color:var(--muted);padding:12px 0 6px;font-weight:600}
  .ni-newline{display:flex;align-items:center;gap:10px;margin:12px 0 6px;color:var(--alert);font-size:12px;font-weight:700}
  .ni-newline::before,.ni-newline::after{content:'';flex:1;height:1px;background:var(--alert);opacity:.4}
  .ni-row{display:flex;gap:7px;align-items:flex-end;width:100%;margin-top:2px}
  .ni-row.first{margin-top:9px}
  .ni-row.mine{flex-direction:row-reverse}
  .ni-av{width:28px;height:28px;border-radius:50%;font-size:10.5px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--tint);color:var(--green-dark)}
  .ni-row.mine .ni-av{background:var(--green);color:#fff}
  .ni-av.ni-avsp{visibility:hidden}
  .ni-col{max-width:66%;display:flex;flex-direction:column;min-width:0}
  .ni-row.mine .ni-col{align-items:flex-end}
  .ni-bubble{width:fit-content;max-width:100%;padding:9px 14px;border-radius:15px;font-size:14.5px;line-height:1.5;background:var(--surface);border:1px solid var(--border);border-bottom-left-radius:4px;overflow-wrap:anywhere;white-space:pre-wrap}
  .ni-row.mine .ni-bubble{background:var(--green);color:#fff;border:0;border-bottom-left-radius:15px;border-bottom-right-radius:4px}
  .ni-row.failed .ni-bubble{background:var(--alert);opacity:.92}
  .ni-bubble mark{background:#FFE58A;color:inherit;border-radius:2px;padding:0 1px}
  .ni-time{font-size:11.5px;color:var(--muted);margin-top:2px;display:inline-flex;align-items:center;gap:3px}
  .ni-tick svg{stroke:#9a9a94;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;vertical-align:-1px}
  .ni-tick.read svg{stroke:#34B7F1}
  .ni-ai{font-size:11.5px;color:var(--muted);margin-top:3px;font-style:italic}
  .ni-scam{font-size:12.5px;line-height:1.45;color:var(--amber);background:var(--amber-bg);border:1px solid var(--amber-border);border-radius:10px;padding:8px 11px;margin-top:5px}
  .ni-retry{background:none;border:0;color:var(--alert);font-size:12.5px;font-weight:700;text-decoration:underline;padding:6px 0;min-height:32px}
  .ni-queued{font-size:12px;color:var(--amber);margin-top:2px}
  @media(max-width:860px){.ni-col{max-width:82%}}

  #ni-quick{display:flex;gap:6px;flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:9px 16px;background:var(--surface);border-top:1px solid var(--border);flex-shrink:0;mask-image:linear-gradient(to right,#000 94%,transparent);-webkit-mask-image:linear-gradient(to right,#000 94%,transparent)}
  #ni-quick::-webkit-scrollbar{display:none}
  #ni-quick:empty{display:none}
  .ni-chip{flex-shrink:0;background:var(--tint);color:var(--green-dark);border:1px solid var(--tint-border);border-radius:18px;padding:0 14px;min-height:38px;font-size:13px;font-weight:600;white-space:nowrap}
  .ni-chip:hover{background:#c9ecdd}
  #ni-inrow{display:flex;align-items:flex-end;gap:10px;padding:12px 16px;padding-bottom:calc(12px + env(safe-area-inset-bottom,0px));background:var(--surface);border-top:1px solid var(--border);flex-shrink:0}
  #ni-input{flex:1;resize:none;border:1.5px solid var(--border);border-radius:12px;padding:10px 14px;font-size:16px;outline:none;min-height:46px;max-height:120px;line-height:1.4;background:var(--app-bg);color:var(--ink)}
  #ni-input:focus{border-color:var(--green);background:#fff}
  #ni-send{width:46px;height:46px;border-radius:50%;background:var(--green);border:0;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  #ni-send svg{width:18px;height:18px;stroke:#fff;fill:none;stroke-width:2}
  #ni-send:disabled{opacity:.5;cursor:not-allowed}

  /* ── Listing details panel (wide screens) ── */
  #ni-side{display:none;width:340px;flex-shrink:0;flex-direction:column;background:var(--surface);border-left:1px solid var(--border);overflow-y:auto;min-height:0}
  @media(min-width:1200px){body.ni-open:not(.ni-side-off) #ni-side{display:flex}#ni-details-btn{display:inline-flex}}
  .ni-side-main{aspect-ratio:4/3;background:var(--border);overflow:hidden}
  .ni-side-main img{width:100%;height:100%;object-fit:cover}
  .ni-side-thumbs{display:flex;gap:6px;padding:8px 12px}
  .ni-side-thumbs button{flex:1;aspect-ratio:1;border:2px solid transparent;border-radius:8px;overflow:hidden;padding:0;background:var(--border);max-width:64px}
  .ni-side-thumbs button[aria-current="true"]{border-color:var(--green)}
  .ni-side-thumbs img{width:100%;height:100%;object-fit:cover}
  .ni-side-body{padding:6px 16px 20px}
  .ni-side-body h3{font-family:'Playfair Display',serif;font-size:19px;margin:6px 0 4px;line-height:1.25}
  .ni-side-price{font-size:22px;font-weight:700;color:var(--green-dark);margin:4px 0}
  .ni-side-loc{font-size:13.5px;color:var(--ink-2);margin-bottom:10px}
  .ni-side-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
  .ni-tag{font-size:12px;font-weight:700;border-radius:12px;padding:3px 10px;background:var(--tint);color:var(--green-dark)}
  .ni-tag.bad{background:#FFF5F5;color:var(--alert)}
  .ni-side dl{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 0 14px}
  .ni-side dl div{background:var(--app-bg);border-radius:10px;padding:8px 10px;min-width:0}
  .ni-side dt{font-size:11.5px;color:var(--muted)}
  .ni-side dd{margin:0;font-size:13.5px;font-weight:600;overflow-wrap:anywhere}
  .ni-side .ni-btn{width:100%;margin-bottom:8px}

  @media(max-width:860px){
    #ni-sidebar{width:100%;border-right:0}
    body.ni-open #ni-sidebar{display:none}
    body:not(.ni-open) #ni-thread-pane{display:none}
    #ni-back-btn{display:inline-flex}
    .ni-hpill span{display:none}.ni-hpill{width:44px;height:44px;padding:0;justify-content:center;border-radius:50%}
    #ni-messages{padding:14px 12px}
  }

  /* ── Modals + toast ── */
  .ni-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;align-items:center;justify-content:center;padding:14px;overscroll-behavior:contain}
  .ni-overlay.open{display:flex}
  .ni-modal{background:var(--surface);border-radius:16px;max-width:450px;width:100%;max-height:92vh;max-height:92dvh;overflow-y:auto;padding:24px 22px;box-shadow:0 8px 32px rgba(0,0,0,.2)}
  .ni-modal.wide{max-width:720px}
  .ni-modal h3{font-size:19px;font-weight:700;margin:0 0 4px}
  .ni-sub{font-size:13px;color:var(--muted);margin:0 0 16px;line-height:1.5}
  .ni-field{margin-bottom:14px}
  .ni-field label{display:block;font-size:12.5px;font-weight:600;color:var(--ink-2);margin-bottom:5px}
  .ni-field input,.ni-field textarea,.ni-field select{width:100%;min-height:46px;padding:10px 13px;border:1.5px solid var(--border);border-radius:10px;font-size:16px;background:var(--app-bg);color:var(--ink);outline:none}
  .ni-field textarea{min-height:66px;resize:vertical}
  .ni-field input:focus,.ni-field textarea:focus,.ni-field select:focus{border-color:var(--green);background:#fff}
  .ni-field [aria-invalid="true"]{border-color:var(--alert)}
  .ni-err{color:var(--alert);font-size:12.5px;margin-top:4px}.ni-err:empty{display:none}
  .ni-banner{background:#FFF5F5;color:var(--alert);border:1px solid #f0caca;border-radius:10px;padding:9px 12px;font-size:13px;margin-bottom:12px}.ni-banner:empty{display:none}
  .ni-two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  @media(max-width:420px){.ni-two{grid-template-columns:1fr;gap:0}}
  .ni-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:8px;flex-wrap:wrap}
  .ni-toggle{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 0;border-top:1px solid var(--border);margin-top:6px;min-height:52px;font-size:14px;color:var(--ink-2)}
  .ni-toggle input{width:20px;height:20px;accent-color:var(--green)}
  .ni-status{font-size:12.5px;color:var(--muted);margin-top:10px;min-height:1em}
  .ni-linkrow{display:flex;gap:8px;margin-bottom:12px}
  #ni-sync-link{flex:1;min-width:0;padding:10px 12px;border:1.5px solid var(--border);border-radius:10px;font-size:13px;color:var(--ink-2);background:var(--app-bg)}
  .ni-warn{font-size:13px;color:var(--amber);background:var(--amber-bg);border:1px solid var(--amber-border);border-radius:10px;padding:10px 12px;margin-bottom:14px;line-height:1.5}
  #ni-toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);z-index:400;background:#1a1a18;color:#fff;border-radius:12px;padding:10px 14px;font-size:14px;display:flex;align-items:center;gap:12px;box-shadow:0 8px 24px rgba(0,0,0,.3);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;max-width:min(92vw,460px)}
  #ni-toast.show{opacity:1;transform:translate(-50%,0);pointer-events:auto}
  #ni-toast button{background:none;border:0;color:#7CE0C0;font-weight:700;font-size:14px;min-height:36px;padding:0 6px}
</style>
<link rel="stylesheet" href="/theme.css"/>
<script src="/theme.js"></script>
<link rel="manifest" href="/manifest.webmanifest"><script>if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js')})}</script>
</head>
<body>
<div id="ni-app">
  <header id="ni-header">
    <a id="ni-back" href="/listings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg><span data-i18n="browse">Browse listings</span></a>
    <div id="ni-title-wrap"><div id="ni-title">Nyumba254</div><div id="ni-subtitle" data-i18n="subtitle">Your conversations with sellers</div></div>
    <nav id="ni-nav" aria-label="Site"><a href="/" data-i18n="nav_home">Home</a><a id="ni-acct" href="/login" data-i18n="nav_signin">Sign in</a></nav>
    <button id="ni-lang" class="ni-hbtn" type="button" aria-label="Change language">Kiswahili</button>
    <button id="ni-profile-btn" class="ni-hbtn icon" type="button" data-i18n-aria="details_aria" aria-label="My details and notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0116 0v1"/></svg><span data-i18n="details">My details</span></button>
    <button id="ni-sync-btn" class="ni-hbtn icon" type="button" data-i18n-aria="sync_aria" aria-label="Continue on another device"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg><span data-i18n="sync">Sync device</span></button>
  </header>
  <div id="ni-net" role="status" data-i18n="offline">You're offline. Messages you send will go out as soon as you're back online.</div>

  <div id="ni-body">
    <aside id="ni-sidebar" aria-label="Conversations">
      <div id="ni-tabs" role="tablist">
        <button type="button" class="ni-tab" role="tab" id="ni-tab-chats" data-tab="chats" aria-selected="true"><span data-i18n="tab_chats">Chats</span> <span id="ni-unread-count" class="ni-count" hidden>0</span></button>
        <button type="button" class="ni-tab" role="tab" id="ni-tab-saved" data-tab="saved" aria-selected="false"><span data-i18n="tab_saved">Saved</span> <span id="ni-saved-count" class="ni-count" hidden>0</span></button>
      </div>
      <div id="ni-search-row"><label class="sr-only" for="ni-search" data-i18n="search_aria">Search conversations</label><input id="ni-search" type="search" data-i18n-ph="search_ph" placeholder="Search conversations…" autocomplete="off"/></div>
      <div id="ni-filters" role="group" aria-label="Filter conversations"></div>
      <div id="ni-notif" hidden><p data-i18n="notif_t">Get alerts when a seller replies</p><button type="button" class="yes" data-a="notif-yes" data-i18n="notif_yes">Turn on</button><button type="button" class="no" data-a="notif-no" data-i18n="notif_no">Not now</button></div>
      <div id="ni-ptr" data-i18n="ptr">Pull down to refresh</div>
      <div id="ni-list" role="tabpanel" aria-labelledby="ni-tab-chats"></div>
      <div id="ni-saved" role="tabpanel" aria-labelledby="ni-tab-saved" hidden>
        <div id="ni-saved-tools"><label class="sr-only" for="ni-saved-sort" data-i18n="sort_aria">Sort saved listings</label><select id="ni-saved-sort"><option value="new" data-i18n="sort_new">Recently saved</option><option value="low" data-i18n="sort_low">Price: low to high</option><option value="high" data-i18n="sort_high">Price: high to low</option></select><button type="button" class="ni-btn" id="ni-cmp-btn" disabled data-i18n="compare">Compare</button></div>
        <div id="ni-saved-list"></div>
      </div>
    </aside>

    <main id="ni-thread-pane">
      <div id="ni-thread-empty"><span data-i18n="pick">Select a conversation from the list to read your messages.</span><small data-i18n="hint_keys">Tip: press / to search and ↑ ↓ to switch chats</small></div>
      <div id="ni-thread">
        <div id="ni-thead">
          <button class="ni-ib" id="ni-back-btn" type="button" data-i18n-aria="back_aria" aria-label="Back to all chats"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
          <div id="ni-tinfo"><div id="ni-tname"></div><div id="ni-presence"><span id="ni-dot"></span><span id="ni-ptxt">Connecting…</span></div></div>
          <button class="ni-ib" id="ni-tsearch-btn" type="button" data-i18n-aria="tsearch_aria" aria-label="Search in this conversation"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
          <button class="ni-hpill" id="ni-book-btn" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><span id="ni-book-label">Book a viewing</span></button>
          <button class="ni-ib" id="ni-details-btn" type="button" data-i18n-aria="details_panel" aria-label="Show or hide listing details"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="15" y1="3" x2="15" y2="21"/></svg></button>
          <button class="ni-ib" id="ni-more" type="button" aria-haspopup="menu" aria-expanded="false" data-i18n-aria="more" aria-label="More"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="12" cy="19" r="1.2"/></svg></button>
          <div id="ni-menu" role="menu" aria-label="Conversation actions">
            <button type="button" role="menuitem" data-m="call"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.12 1.2 2 2 0 012.11 0h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 14.92z"/></svg><span data-i18n="m_call">Call seller</span></button>
            <button type="button" role="menuitem" data-m="wa"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg><span data-i18n="m_wa">WhatsApp seller</span></button>
            <button type="button" role="menuitem" data-m="invite"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg><span data-i18n="m_invite">Invite a friend</span></button>
            <hr>
            <button type="button" role="menuitem" data-m="archive"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg><span id="ni-m-archive-t">Archive conversation</span></button>
            <button type="button" role="menuitem" data-m="report" class="danger"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg><span data-i18n="m_report">Report seller</span></button>
          </div>
        </div>
        <div id="ni-searchbar"><input id="ni-tsearch" type="search" data-i18n-ph="tsearch_ph" placeholder="Search this conversation…" aria-label="Search this conversation"/><span id="ni-tcount" aria-live="polite"></span><button id="ni-tsearch-x" type="button" aria-label="Close search">✕</button></div>
        <div id="ni-gone" hidden role="alert"></div>
        <div id="ni-vstrip" hidden><span id="ni-vstrip-t"></span><button type="button" data-a="ics" data-i18n="v_cal">Add to calendar</button><button type="button" data-a="resched" data-i18n="v_change">Change time</button></div>
        <div id="ni-lcard"></div>
        <div id="ni-safety" role="note"><p id="ni-safety-t"></p><button type="button" id="ni-report" data-a="ask" data-i18n="report">Report</button><button type="button" id="ni-safety-x" aria-label="Dismiss safety note">✕</button></div>
        <div id="ni-msgs-wrap"><div id="ni-messages" role="log" aria-live="polite" aria-label="Messages"></div><div id="ni-typing" role="status"><span class="ni-dots"><i></i><i></i><i></i></span><span id="ni-typing-t">Typing…</span></div><button type="button" id="ni-newpill" data-i18n="new_pill">New message ↓</button></div>
        <div id="ni-quick"></div>
        <div id="ni-inrow"><label class="sr-only" for="ni-input" data-i18n="msg_aria">Message</label><textarea id="ni-input" data-i18n-ph="input_ph" placeholder="Type a message…" rows="1"></textarea><button id="ni-send" type="button" data-i18n-aria="send_aria" aria-label="Send message"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></button></div>
      </div>
    </main>
    <aside id="ni-side" aria-label="Listing details"></aside>
  </div>
</div>

<!-- Booking modal -->
<div id="ni-vov" class="ni-overlay"><div class="ni-modal" role="dialog" aria-modal="true" aria-labelledby="ni-vt">
  <h3 id="ni-vt">Book a viewing</h3><p class="ni-sub" data-i18n="v_sub">Request a time to see this property. The seller confirms in your chat.</p>
  <div class="ni-banner" id="ni-verr" role="alert"></div>
  <div class="ni-two">
    <div class="ni-field"><label for="ni-vdate" data-i18n="v_date">Date</label><input type="date" id="ni-vdate"/><div class="ni-err" id="ni-vdate-e" role="alert"></div></div>
    <div class="ni-field"><label for="ni-vtime" data-i18n="v_time">Time</label><select id="ni-vtime"></select><div class="ni-err" id="ni-vtime-e" role="alert"></div></div>
  </div>
  <div class="ni-field"><label for="ni-vname" data-i18n="v_name">Full name</label><input type="text" id="ni-vname" autocomplete="name"/><div class="ni-err" id="ni-vname-e" role="alert"></div></div>
  <div class="ni-field"><label for="ni-vphone" data-i18n="v_phone">Phone</label><input type="tel" id="ni-vphone" inputmode="tel" autocomplete="tel" placeholder="07XX XXX XXX"/><div class="ni-err" id="ni-vphone-e" role="alert"></div></div>
  <div class="ni-field"><label for="ni-vnotes" data-i18n="v_notes">Notes (optional)</label><textarea id="ni-vnotes" rows="2"></textarea></div>
  <div class="ni-actions"><button class="ni-btn ghost" type="button" id="ni-vcancel" data-i18n="cancel">Cancel</button><button class="ni-btn" type="button" id="ni-vsend" data-i18n="v_send">Request viewing</button></div>
</div></div>

<!-- Profile modal -->
<div id="ni-pov" class="ni-overlay"><div class="ni-modal" role="dialog" aria-modal="true" aria-labelledby="ni-pt">
  <h3 id="ni-pt" data-i18n="details">My details</h3><p class="ni-sub" data-i18n="p_sub">Add your name, email or phone so sellers can reach you, and so we can email you when a seller replies while you're away.</p>
  <div class="ni-field"><label for="ni-p-name" data-i18n="v_name">Full name</label><input type="text" id="ni-p-name" autocomplete="name"/></div>
  <div class="ni-field"><label for="ni-p-email">Email</label><input type="email" id="ni-p-email" autocomplete="email" placeholder="you@example.com"/><div class="ni-err" id="ni-p-email-e" role="alert"></div></div>
  <div class="ni-field"><label for="ni-p-phone" data-i18n="v_phone">Phone</label><input type="tel" id="ni-p-phone" inputmode="tel" autocomplete="tel" placeholder="07XX XXX XXX"/><div class="ni-err" id="ni-p-phone-e" role="alert"></div></div>
  <label class="ni-toggle" for="ni-p-notify"><span data-i18n="p_notify">Email me when I get a reply</span><input type="checkbox" id="ni-p-notify" checked/></label>
  <div class="ni-actions"><button class="ni-btn ghost" type="button" id="ni-pcancel" data-i18n="close">Close</button><button class="ni-btn" type="button" id="ni-psave" data-i18n="p_save">Save &amp; email me my link</button></div>
  <p class="ni-status" id="ni-pstatus" role="status"></p>
</div></div>

<!-- Sync modal -->
<div id="ni-sov" class="ni-overlay"><div class="ni-modal" role="dialog" aria-modal="true" aria-labelledby="ni-st">
  <h3 id="ni-st" data-i18n="s_title">Continue on another device</h3><p class="ni-sub" data-i18n="s_sub">This link opens all of your Nyumba254 chats and saved listings on any phone or computer.</p>
  <div class="ni-warn" data-i18n="s_warn">Anyone who has this link can read your chats. Send it only to yourself and never post it publicly.</div>
  <div class="ni-linkrow"><input type="text" id="ni-sync-link" readonly aria-label="Your link"/><button class="ni-btn" id="ni-sync-copy" type="button" data-i18n="copy">Copy</button></div>
  <div class="ni-actions"><button class="ni-btn ghost" id="ni-sync-close" type="button" data-i18n="done">Done</button></div>
</div></div>

<!-- Compare modal -->
<div id="ni-cov" class="ni-overlay"><div class="ni-modal wide" role="dialog" aria-modal="true" aria-labelledby="ni-ct">
  <h3 id="ni-ct" data-i18n="compare">Compare</h3><div class="ni-cmp-scroll" id="ni-cmp-body"></div>
  <div class="ni-actions"><button class="ni-btn ghost" id="ni-cmp-close" type="button" data-i18n="close">Close</button></div>
</div></div>

<div id="ni-toast" role="status" aria-live="polite"><span id="ni-toast-t"></span><button type="button" id="ni-toast-a" hidden></button></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/nk-chat-core.js"></script>
<script>
(function () {
  'use strict';
  const core = window.NKChatCore, esc = core.esc, $ = id => document.getElementById(id), qsa = (s, r) => [...(r || document).querySelectorAll(s)];
