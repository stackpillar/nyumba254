  const QRD = {
    avail: ['Is this still available?', 'Je, bado inapatikana?'], view: ["I'd like to book a viewing", 'Ningependa kupanga kutazama'], view_r: ['Can we reschedule the viewing?', 'Je, tunaweza kubadilisha muda wa kutazama?'],
    deposit: ['Is a deposit required?', 'Je, amana inahitajika?'], price: ['Is the price negotiable?', 'Je, bei inaweza kujadiliwa?'], incl: ["What's included in the rent?", 'Kodi inajumuisha nini?'], photos: ['Can you share more photos?', 'Unaweza kutuma picha zaidi?'], town: ['How far is it from town?', 'Ni umbali gani kutoka mjini?'],
    campus: ['Is it near campus?', 'Je, iko karibu na chuo?'], meals: ['Are meals included?', 'Je, chakula kimejumuishwa?'], curfew: ['Is there a curfew?', 'Je, kuna muda wa kufunga geti?'], utils: ['Is there water and power all day?', 'Je, kuna maji na umeme wakati wote?'],
    dates: ['Is it free on these dates?', 'Je, iko wazi tarehe hizi?'], clean: ['Is there a cleaning fee?', 'Je, kuna ada ya usafi?'], checkin: ['Is check-in flexible?', 'Je, muda wa kuingia unaweza kubadilika?'],
    lease: ['Is the lease negotiable?', 'Je, mkataba unaweza kujadiliwa?'], parking: ['Is there parking?', 'Je, kuna maegesho?'], service: ['What is the service charge?', 'Ada ya huduma ni kiasi gani?']
  };
  const QSETS = { base: ['avail', 'view', 'deposit', 'price', 'incl', 'photos', 'town'], boarding: ['avail', 'view', 'campus', 'meals', 'curfew', 'utils', 'deposit', 'price'], airbnb: ['avail', 'dates', 'clean', 'checkin', 'price', 'photos'], commercial: ['avail', 'view', 'lease', 'parking', 'service', 'price', 'photos'] };

  /* ═════ state ═════ */
  let tab = 'chats', term = '', filter = 'all', threadTerm = '', pushed = false, lastFocus = null, newLineKey = null, newLineFor = null, draftT = null, sidePhoto = 0, savedData = [];
  const cmpSel = new Set(), DK = 'nk_chat_draft_';
  const getDraft = id => core.ls.get(DK + id) || '';
  const setDraft = (id, v) => { if (v && v.trim()) core.ls.set(DK + id, v); else core.ls.del(DK + id); };
  const isArch = id => core.Archive.has(id);
  const activeConvo = () => { const a = core.active(); return a ? core.convos().find(c => c.listingId === a.listingId) : null; };
  const vis = () => !!core.active() && !document.hidden;
  const atBottom = () => { const b = $('ni-messages'); return b.scrollHeight - b.scrollTop - b.clientHeight < 90; };
  const toBottom = () => { const b = $('ni-messages'); b.scrollTop = b.scrollHeight; $('ni-newpill').classList.remove('show'); };
  const setErr = (id, m) => { const e = $(id + '-e'), i = $(id); if (e) e.textContent = m || ''; if (i) i.setAttribute('aria-invalid', m ? 'true' : 'false'); };
  const autosize = el => { el.style.height = 'auto'; el.style.height = Math.min(el.scrollHeight, 120) + 'px'; };
  const labels = () => ({ ai: t('ai'), retry: t('retry_msg'), queued: t('queued'), scam: t('scam') });

  /* ── toast ── */
  let toastT;
  const hideToast = () => $('ni-toast').classList.remove('show');
  function toast(msg, label, fn) { $('ni-toast-t').textContent = msg; const b = $('ni-toast-a'); b.hidden = !label; b.textContent = label || ''; b.onclick = () => { if (fn) fn(); hideToast(); }; $('ni-toast').classList.add('show'); clearTimeout(toastT); toastT = setTimeout(hideToast, label ? 6000 : 3800); }

  /* ── modals ── */
  function openModal(id, focusId) { lastFocus = document.activeElement; $(id).classList.add('open'); if (focusId && !touch()) setTimeout(() => { const f = $(focusId); if (f) f.focus(); }, 50); }
  function closeModal(id) { $(id).classList.remove('open'); if (lastFocus && lastFocus.focus && document.contains(lastFocus)) lastFocus.focus(); }
  qsa('.ni-overlay').forEach(o => o.addEventListener('click', e => { if (e.target === o) closeModal(o.id); }));

  /* ═════ counts, filters, conversation list ═════ */
  function renderCounts() {
    const n = core.convos().filter(c => !isArch(c.listingId)).reduce((s, c) => s + (c.unread || 0), 0), b = $('ni-unread-count'); b.hidden = !n; b.textContent = n > 9 ? '9+' : n; core.setTitleBadge(core.unread());
    const ids = core.savedIds(), s = $('ni-saved-count'); s.hidden = !ids.length; s.textContent = ids.length;
  }
  function visibleConvos() {
    const q = term.trim().toLowerCase();
    return core.convos().filter(c => {
      const arch = isArch(c.listingId); if (filter === 'archived' ? !arch : arch) return false;
      if (filter === 'unread' && !c.unread) return false; if (filter === 'viewing' && !core.booked(c.listingId)) return false;
      return !q || c.title.toLowerCase().includes(q) || c.sellerName.toLowerCase().includes(q) || (c.lastMessage || '').toLowerCase().includes(q);
    });
  }
  function renderFilters() {
    const all = core.convos(), unread = all.filter(c => !isArch(c.listingId) && c.unread).length, arch = all.filter(c => isArch(c.listingId)).length;
    const chip = (k, label, n) => `<button type="button" class="ni-fchip" data-f="${k}" aria-pressed="${filter === k}">${esc(label)}${n ? ` <span class="ni-count">${n}</span>` : ''}</button>`;
    $('ni-filters').innerHTML = chip('all', t('f_all')) + chip('unread', t('f_unread'), unread) + chip('viewing', t('f_view')) + (arch ? chip('archived', t('f_arch'), arch) : '');
    $('ni-filters').hidden = !all.length;
  }
  function convoHtml(c) {
    const a = core.active(), draft = getDraft(c.listingId), nv = core.nextViewing(c.listingId), arch = isArch(c.listingId), id = esc(c.listingId);
    const last = draft ? `<span class="ni-draft">${esc(t('draft'))}</span> ${esc(draft)}` : esc(c.lastMessage || t('no_msgs'));
    return `<div class="ni-swipe"><div class="ni-swipe-bg" aria-hidden="true">${esc(t(arch ? 'unarchive_short' : 'archive_short'))}</div><button type="button" class="ni-convo" data-l="${id}" aria-current="${!!a && a.listingId === c.listingId}"><span class="ni-thumb">${c.coverUrl ? `<img src="${esc(c.coverUrl)}" alt="" loading="lazy"/>` : esc(core.initials(c.sellerName))}</span><span class="ni-cb"><span class="ni-ct"><span>${esc(c.title)}</span>${c.sellerVerified ? VER : ''}</span><span class="ni-cl">${last}</span>${nv ? `<span class="ni-vtag">📅 ${esc(dateShort(nv.requested_date))}</span>` : ''}</span><span class="ni-cm"><span class="ni-cw">${esc(core.whenLabel(c.lastAt))}</span>${c.unread ? `<span class="ni-badge">${c.unread > 9 ? '9+' : c.unread}</span>` : ''}</span></button><button type="button" class="ni-arch" data-arch="${id}" aria-label="${esc(t(arch ? 'unarch_aria' : 'arch_aria'))}" title="${esc(t(arch ? 'unarch_aria' : 'arch_aria'))}">${ICON_ARCH}</button></div>`;
  }
  function renderList() {
    const list = $('ni-list'), all = core.convos(); renderFilters();
    if (!all.length && core.loading()) { list.innerHTML = '<div class="ni-sk"></div><div class="ni-sk"></div><div class="ni-sk"></div><div class="ni-sk"></div>'; return; }
    if (!all.length && core.loadError()) { list.innerHTML = `<div class="ni-state">${esc(t('e_load'))}<br><button type="button" class="ni-btn" data-a="reload">${esc(t('retry'))}</button></div>`; return; }
    if (!all.length) { list.innerHTML = `<div class="ni-state"><h4>${esc(t('e_none_t'))}</h4>${esc(t('e_none_d'))}<br><a class="ni-btn" href="/listings">${esc(t('e_browse'))}</a></div>`; return; }
    const v = visibleConvos(); if (!v.length) { list.innerHTML = `<div class="ni-state">${esc(t('e_filter'))}</div>`; return; }
    list.innerHTML = v.map(convoHtml).join('');
  }
  function setArchived(id, on, silent) {
    core.Archive.set(id, on); const a = core.active();
    if (on && a && a.listingId === id) closeThread(false);
    renderCounts(); renderList(); if (!silent) toast(t(on ? 'archived' : 'unarchived'), t('undo'), () => setArchived(id, !on, true));
  }

  /* ═════ saved listings: sort, sold badges, compare ═════ */
  async function renderSaved() {
    const panel = $('ni-saved-list'), ids = core.savedIds(); renderCounts(); $('ni-saved-tools').hidden = !ids.length;
    if (!ids.length) { panel.innerHTML = `<div class="ni-state"><h4>${esc(t('s_none_t'))}</h4>${esc(t('s_none_d'))}<br><a class="ni-btn" href="/listings">${esc(t('e_browse'))}</a></div>`; return; }
    panel.innerHTML = '<div class="ni-sk"></div><div class="ni-sk"></div>';
    let res; try { res = await core.getClient().from('listings').select('id,title,area,county,price,price_frequency,listing_number,category,details,status,listing_photos(*)').in('id', ids).in('status', ['active', 'occupied']); } catch (e) { res = { error: e }; }
    if (res.error || !res.data) { panel.innerHTML = `<div class="ni-state">${esc(t('s_load'))}<br><button type="button" class="ni-btn" data-a="reload-saved">${esc(t('retry'))}</button></div>`; return; }
    const found = new Set(res.data.map(l => l.id)), gone = ids.filter(i => !found.has(i)), mode = $('ni-saved-sort').value;
    savedData = res.data.slice().sort((a, b) => mode === 'low' ? Number(a.price) - Number(b.price) : mode === 'high' ? Number(b.price) - Number(a.price) : ids.indexOf(b.id) - ids.indexOf(a.id));
    [...cmpSel].forEach(i => { if (!found.has(i)) cmpSel.delete(i); }); updateCmpBtn();
    panel.innerHTML = savedData.map(l => {
      const cover = (l.listing_photos || []).find(p => p.is_cover) || (l.listing_photos || [])[0], sold = l.status === 'occupied';
      return `<div class="ni-saved-row"><label class="ni-cmp"><input type="checkbox" data-cmp="${esc(l.id)}" ${cmpSel.has(l.id) ? 'checked' : ''} aria-label="${esc(t('compare'))}: ${esc(l.title || '')}"/></label><a class="ni-saved-link" href="/listing?id=${String(l.listing_number).padStart(6, '0')}"><span class="ni-thumb" style="width:52px;height:46px">${cover ? `<img src="${esc(cover.url)}" alt="" loading="lazy"/>` : ''}</span><span class="ni-saved-body"><span class="ni-saved-title">${esc(l.title || '')}</span><span class="ni-saved-sub">${esc(l.area || '')}${sold ? `<span class="ni-sold">${esc(t(l.price_frequency === 'once' ? 'sold' : 'occupied'))}</span>` : ''}</span><span class="ni-saved-price">${esc(core.priceLabel(l) || t('price_req'))}</span></span></a><button type="button" class="ni-saved-rm" data-rm="${esc(l.id)}" aria-label="${esc(t('remove_aria'))}">✕</button></div>`;
    }).join('') + (gone.length ? `<div class="ni-state" style="padding:20px">${esc(t('gone_saved', gone.length))}<br><button type="button" class="ni-btn ghost" data-a="clear-gone" data-ids="${esc(gone.join(','))}">${esc(t('remove_them'))}</button></div>` : '');
    if (!savedData.length && !gone.length) panel.innerHTML = `<div class="ni-state">${esc(t('s_none_t'))}</div>`;
  }
  function updateCmpBtn() { const n = cmpSel.size, b = $('ni-cmp-btn'); b.disabled = n < 2; b.textContent = n ? t('compare_n', n) : t('compare'); }
  function openCompare() {
    const items = savedData.filter(l => cmpSel.has(l.id)); if (items.length < 2) return;
    const sameFreq = items.every(l => l.price_frequency === items[0].price_frequency), prices = items.map(l => Number(l.price) || 0), best = sameFreq && prices.some(p => p > 0) ? Math.min(...prices.filter(p => p > 0)) : null;
    const row = (label, fn, hl) => `<tr><th scope="row">${esc(label)}</th>${items.map((l, i) => `<td${hl && hl(l, i) ? ' class="best"' : ''}>${fn(l)}</td>`).join('')}</tr>`;
    $('ni-cmp-body').innerHTML = `<table class="ni-cmp-table"><thead><tr><th></th>${items.map(l => `<th scope="col" style="color:var(--ink)"><a href="/listing?id=${String(l.listing_number).padStart(6, '0')}">${esc(l.title || '')}</a></th>`).join('')}</tr></thead><tbody>` +
      row(t('c_price'), l => esc(core.priceLabel(l) || t('price_req')), (l, i) => best !== null && prices[i] === best) + row(t('c_loc'), l => esc([l.area, l.county].filter(Boolean).join(', '))) + row(t('c_type'), l => esc(l.category || '-')) +
      row(t('c_bed'), l => { const b = (l.details || {}).bedrooms; return b == null || b === '' ? '-' : Number(b) === 0 ? esc(t('studio')) : esc(b); }) + row(t('c_bath'), l => esc((l.details || {}).bathrooms || '-')) + row(t('c_size'), l => (l.details || {}).size_sqm ? esc(l.details.size_sqm) + ' m²' : '-') +
      row(t('c_status'), l => esc(l.status === 'occupied' ? t(l.price_frequency === 'once' ? 'sold' : 'occupied') : t('available'))) + '</tbody></table>';
    openModal('ni-cov', 'ni-cmp-close');
  }
  function switchTab(x) {
    tab = x; qsa('.ni-tab').forEach(b => b.setAttribute('aria-selected', String(b.dataset.tab === x)));
    const chats = x === 'chats'; $('ni-search-row').hidden = !chats; $('ni-filters').hidden = !chats || !core.convos().length; $('ni-list').hidden = !chats; $('ni-saved').hidden = chats; renderNotif();
    if (!chats) renderSaved();
  }

  /* ═════ thread: header, banners, viewing strip, details panel ═════ */
  function renderHead() {
    const c = activeConvo(), a = core.active(); if (!c || !a) return;
    $('ni-tname').innerHTML = `<span>${esc(c.sellerName)}</span>${c.sellerVerified ? VER : ''}`;
    const l = core.listing(), price = core.priceLabel(l), num = l && l.listing_number != null ? String(l.listing_number).padStart(6, '0') : null;
    const inner = `<span class="ni-thumb">${c.coverUrl ? `<img src="${esc(c.coverUrl)}" alt=""/>` : esc(core.initials(c.title))}</span><span class="ni-lc-t"><b>${esc((l && l.title) || c.title)}</b><span>${esc(price || (l && l.area) || '')}</span></span>${num ? `<span class="ni-lc-go">${esc(t('view_listing'))}</span>` : ''}`;
    $('ni-lcard').innerHTML = num ? `<a class="ni-lcard" href="/listing?id=${num}">${inner}</a>` : `<div class="ni-lcard">${inner}</div>`;
    $('ni-book-label').textContent = t(core.booked(a.listingId) ? 'book_again' : 'book'); $('ni-book-btn').setAttribute('aria-label', t(core.booked(a.listingId) ? 'book_again' : 'book'));
    $('ni-m-archive-t').textContent = t(isArch(a.listingId) ? 'm_unarchive' : 'm_archive');
  }
  function renderPresence() { const s = core.presence(); $('ni-ptxt').textContent = t({ connecting: 'p_connecting', online: 'p_online', away: 'p_away', typing: 'p_typing' }[s] || 'p_away'); $('ni-dot').className = s === 'online' ? 'online' : s === 'typing' ? 'typing' : ''; $('ni-typing').classList.toggle('show', s === 'typing'); $('ni-typing-t').textContent = t('typing_t'); }
  function renderGone() {
    const l = core.listing(), el = $('ni-gone'); let msg = null;
    if (core.listingGone()) msg = t('gone_missing'); else if (l && l.status && l.status !== 'active') msg = t(l.price_frequency === 'once' && l.status === 'occupied' ? 'gone_sold' : 'gone_occ');
    if (!msg) { el.hidden = true; el.innerHTML = ''; return; }
    const qs = l && l.category ? '?category=' + encodeURIComponent(l.category) + (l.county ? '&county=' + encodeURIComponent(l.county) : '') : '';
    el.innerHTML = `<p>${esc(msg)}</p><a href="/listings${qs}">${esc(t('gone_link'))}</a>`; el.hidden = false;
  }
  function renderVStrip() {
    const a = core.active(), el = $('ni-vstrip'), v = a && core.nextViewing(a.listingId);
    if (!v) { el.hidden = true; return; } el.hidden = false; $('ni-vstrip-t').textContent = `📅 ${t('v_label')}: ${dateLong(v.requested_date)} · ${slotName(v.requested_time)}`;
  }
  function factsFor(l) {
    const d = l.details || {}, c = l.category, f = [], add = (k, v) => { if (v !== undefined && v !== null && v !== '') f.push([t(k), String(v)]); };
    if (c === 'boarding') { add('f_res', d.gender && d.gender.charAt(0).toUpperCase() + d.gender.slice(1)); add('f_inst', d.institution); }
    else if (c === 'airbnb') { add('f_guests', d.guests); add('f_beds', d.bedrooms); add('f_baths', d.bathrooms); add('f_stay', d.min_stay); }
    else if (c === 'commercial') { add('f_type', d.property_type); add('f_area', d.size_sqm && d.size_sqm + ' m²'); }
    else { add('f_beds', d.bedrooms == null || d.bedrooms === '' ? '' : Number(d.bedrooms) === 0 ? t('studio') : d.bedrooms); add('f_baths', d.bathrooms); add('f_area', d.size_sqm && d.size_sqm + ' m²'); add('f_furn', d.furnished && t('furn_' + d.furnished)); }
    return f;
  }
  function renderSide() {
    const el = $('ni-side'), l = core.listing(), a = core.active(); if (!a || !l) { el.innerHTML = ''; return; }
    const photos = (l.listing_photos || []).slice().sort((x, y) => (x.position || 0) - (y.position || 0)), cov = photos.find(p => p.is_cover); if (cov) { photos.splice(photos.indexOf(cov), 1); photos.unshift(cov); }
    sidePhoto = Math.min(sidePhoto, Math.max(0, photos.length - 1));
    const num = String(l.listing_number).padStart(6, '0'), ver = (l.profiles || {}).verification_status === 'verified', gone = l.status !== 'active';
    const maps = isFinite(parseFloat(l.latitude)) && isFinite(parseFloat(l.longitude)) ? `https://www.google.com/maps/search/?api=1&query=${l.latitude},${l.longitude}` : 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent([l.address, l.area, l.county, 'Kenya'].filter(Boolean).join(', '));
    el.innerHTML = `<div class="ni-side-main">${photos[sidePhoto] ? `<img src="${esc(photos[sidePhoto].url)}" alt=""/>` : ''}</div>${photos.length > 1 ? `<div class="ni-side-thumbs">${photos.slice(0, 5).map((p, i) => `<button type="button" data-ph="${i}" aria-current="${i === sidePhoto}" aria-label="Photo ${i + 1}"><img src="${esc(p.url)}" alt="" loading="lazy"/></button>`).join('')}</div>` : ''}
      <div class="ni-side-body"><h3>${esc(l.title)}</h3><div class="ni-side-price">${esc(core.priceLabel(l) || t('price_req'))}</div><div class="ni-side-loc">📍 ${esc([l.area, l.county].filter(Boolean).join(', '))}</div>
      <div class="ni-side-tags"><span class="ni-tag${gone ? ' bad' : ''}">${esc(gone ? t(l.price_frequency === 'once' ? 'sold' : 'occupied') : t('available'))}</span><span class="ni-tag">${esc(t(ver ? 'verified' : 'unverified'))}</span></div>
      <dl>${factsFor(l).map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join('')}</dl>
      <a class="ni-btn" href="/listing?id=${num}">${esc(t('open_listing'))}</a><a class="ni-btn ghost" href="${esc(maps)}" target="_blank" rel="noopener">${esc(t('open_maps'))}</a></div>`;
  }

  /* ═════ messages ═════ */
  function computeNewLine() {
    newLineKey = null; let n = core.unreadAtOpen(); if (n <= 0) return; const ms = core.messages();
    for (let i = ms.length - 1; i >= 0; i--) if (ms[i].sender === 'seller') { n--; if (n === 0) { newLineKey = String(ms[i].localId || ms[i].id); break; } }
  }
  function renderQuick() {
    const box = $('ni-quick'), a = core.active(), mine = core.messages().filter(m => m.sender === 'buyer').length; if (!a || mine >= 2) { box.innerHTML = ''; return; }
    const l = core.listing(), set = QSETS[l && l.category] || QSETS.base, booked = core.booked(a.listingId);
    box.innerHTML = set.map(id => { const key = id === 'view' && booked ? 'view_r' : id, txt = QRD[key][lang === 'sw' ? 1 : 0]; return `<button type="button" class="ni-chip" data-k="${id}" data-q="${esc(txt)}">${esc(txt)}</button>`; }).join('');
  }
  function renderMessages(ev, keep) {
    const box = $('ni-messages'), ms = core.messages(), c = activeConvo(), peer = core.initials(c && c.sellerName);
    if (ev && ev.loading) { box.innerHTML = `<div class="ni-empty-thread">${esc(t('loading'))}</div>`; return; }
    if (ev && ev.error) { box.innerHTML = `<div class="ni-empty-thread"><b>${esc(t('load_err'))}</b><button type="button" class="ni-btn" data-a="reopen">${esc(t('retry'))}</button></div>`; return; }
    if (!ms.length) { box.innerHTML = `<div class="ni-empty-thread"><b>${esc(t('empty_t'))}</b>${esc(t('empty_d'))}</div>`; renderQuick(); return; }
    const prevH = box.scrollHeight, prevTop = box.scrollTop, L = labels();
    let html = core.hasMore() ? `<button type="button" class="ni-earlier" data-a="earlier">${esc(t('earlier'))}</button>` : '', prev = null;
    ms.forEach(m => {
      if (!prev || core.dayLabel(prev.created_at) !== core.dayLabel(m.created_at)) html += core.ui.dayHtml(m.created_at, 'ni');
      if (newLineKey && String(m.localId || m.id) === newLineKey) html += `<div class="ni-newline" id="ni-newline"><span>${esc(t('new_line'))}</span></div>`;
      html += core.ui.rowHtml(m, prev, 'ni', peer, threadTerm, L); prev = m;
    });
    box.innerHTML = html;
    if (keep) box.scrollTop = prevTop + (box.scrollHeight - prevH);
    else if (threadTerm) { const marks = box.querySelectorAll('mark'); $('ni-tcount').textContent = marks.length ? t('matches', marks.length) : t('no_match'); if (marks[0]) marks[0].scrollIntoView({ block: 'center' }); }
    else if (newLineKey && $('ni-newline')) { $('ni-newline').scrollIntoView({ block: 'start' }); box.scrollTop = Math.max(0, box.scrollTop - 10); }
    else toBottom();
    renderQuick();
  }
  function appendMessage(m, incoming) {
    if (threadTerm) return renderMessages();
    const box = $('ni-messages'), ms = core.messages(), i = ms.indexOf(m), prev = i > 0 ? ms[i - 1] : null, c = activeConvo(), was = atBottom();
    if (box.querySelector('.ni-empty-thread')) box.innerHTML = '';
    let html = ''; if (!prev || core.dayLabel(prev.created_at) !== core.dayLabel(m.created_at)) html += core.ui.dayHtml(m.created_at, 'ni');
    box.insertAdjacentHTML('beforeend', html + core.ui.rowHtml(m, prev, 'ni', core.initials(c && c.sellerName), '', labels()));
    if (m.sender === 'buyer' || was) toBottom(); else if (incoming) $('ni-newpill').classList.add('show');
    renderQuick();
  }
  function updateMessage(m) {
    const ms = core.messages(), i = ms.indexOf(m), prev = i > 0 ? ms[i - 1] : null, c = activeConvo(), k = String(m.localId || m.id);
    const el = qsa('#ni-messages .ni-row').find(r => r.dataset.k === k); if (!el) return;
    const d = document.createElement('div'); d.innerHTML = core.ui.rowHtml(m, prev, 'ni', core.initials(c && c.sellerName), threadTerm, labels()); el.replaceWith(d.firstElementChild);
  }

  /* ═════ open, close, send ═════ */
  function saveCurrentDraft() { const a = core.active(); if (a) setDraft(a.listingId, $('ni-input').value); }
  function resetSafety() { const b = $('ni-report'); $('ni-safety-t').textContent = t('safety'); b.dataset.a = 'ask'; b.textContent = t('report'); }
  async function openConvo(id, token, fromPop) {
    id = String(id); saveCurrentDraft(); newLineKey = null; newLineFor = null;
    $('ni-thread').classList.add('open'); $('ni-thread-empty').style.display = 'none'; document.body.classList.add('ni-open');
    if (!desk() && !pushed && !fromPop) { history.pushState({ ni: 'thread' }, ''); pushed = true; }
    $('ni-safety').classList.toggle('show', !core.ls.get('nk_chat_safety_seen')); resetSafety(); closeMenu(); toggleThreadSearch(false, true);
    const inp = $('ni-input'); inp.value = getDraft(id); autosize(inp);
    const opening = core.openThread(id, token); core.setViewing(vis()); renderHead(); renderPresence();
    const ok = await opening; if (!ok && !core.active()) return closeThread(true);
    renderHead(); renderPresence(); renderList(); renderCounts(); if (!touch()) inp.focus({ preventScroll: true });
  }
  function closeThread(fromPop) {
    saveCurrentDraft(); if (pushed && !fromPop) { pushed = false; history.back(); } if (fromPop) pushed = false;
    document.body.classList.remove('ni-open'); $('ni-thread').classList.remove('open'); $('ni-thread-empty').style.display = 'flex';
    newLineKey = null; newLineFor = null; closeMenu(); toggleThreadSearch(false, true); core.closeThread(); core.setViewing(false); $('ni-side').innerHTML = ''; renderList();
  }
  window.addEventListener('popstate', () => { if (core.active() && !desk()) closeThread(true); });
  function toggleThreadSearch(show, silent) {
    $('ni-searchbar').classList.toggle('show', show);
    if (!show) { threadTerm = ''; $('ni-tsearch').value = ''; $('ni-tcount').textContent = ''; if (!silent) renderMessages(); } else $('ni-tsearch').focus();
  }
  function sendText(txt) { const m = core.send(txt); if (m && !touch()) $('ni-input').focus(); return m; }
  function sendInput() { const i = $('ni-input'), v = i.value; if (!v.trim()) return; i.value = ''; autosize(i); const a = core.active(); if (a) setDraft(a.listingId, ''); sendText(v); renderList(); }

  /* ═════ menu: call, WhatsApp, invite, archive, report ═════ */
  const closeMenu = () => { $('ni-menu').classList.remove('open'); $('ni-more').setAttribute('aria-expanded', 'false'); };
  function toggleMenu() { const open = !$('ni-menu').classList.contains('open'); $('ni-menu').classList.toggle('open', open); $('ni-more').setAttribute('aria-expanded', String(open)); if (open) { renderHead(); const f = $('ni-menu').querySelector('button'); if (f && !touch()) f.focus(); } }
  async function doContact(ch) {
    const a = core.active(); if (!a) return; closeMenu();
    let win = null; if (ch === 'whatsapp') { win = window.open('about:blank', '_blank'); if (win) try { win.opener = null; } catch (e) {} }   // opened inside the tap, so Safari does not block it
    toast(t('c_getting')); const r = await core.revealContact(a.listingId, ch);
    if (r.error) { if (win) win.close(); toast(t(r.error === 'offline' ? 'c_offline' : r.error === 'limit' ? 'c_limit' : 'c_unavail')); return; }
    const n = core.normPhone(r.phone), l = core.listing(), title = (l && l.title) || (activeConvo() || {}).title || '';
    if (ch === 'whatsapp') { const url = `https://wa.me/${n.replace('+', '')}?text=${encodeURIComponent(t('wa_text', title))}`; if (win) { try { win.location.href = url; } catch (e) { location.href = url; } } else window.open(url, '_blank', 'noopener,noreferrer'); hideToast(); }
    else if (touch()) { location.href = 'tel:' + n; hideToast(); }
    else { try { navigator.clipboard.writeText(n); } catch (e) {} toast(`${core.prettyPhone(n)} · ${t('c_copied')}`); }
  }
  function invite() {
    const l = core.listing(), c = activeConvo(); if (!c) return;
    const url = l && l.listing_number != null ? `${location.origin}/listing?id=${String(l.listing_number).padStart(6, '0')}` : location.origin, title = (l && l.title) || c.title;
    if (navigator.share) navigator.share({ title, text: t('invite_text', title, url), url }).catch(() => {}); else window.open('https://wa.me/?text=' + encodeURIComponent(t('invite_text', title, url)), '_blank', 'noopener');
  }
  function reportAsk() { $('ni-safety').classList.add('show'); const b = $('ni-report'); $('ni-safety-t').textContent = t('report_ask'); b.textContent = t('report_yes'); b.dataset.a = 'go'; b.focus(); }
  function menuAction(m) {
    const a = core.active(); closeMenu(); if (!a) return;
    if (m === 'call') doContact('call'); else if (m === 'wa') doContact('whatsapp'); else if (m === 'invite') invite();
    else if (m === 'archive') setArchived(a.listingId, !isArch(a.listingId)); else if (m === 'report') reportAsk();
  }

  /* ═════ viewing: request, change time, add to calendar ═════ */
  let viewingFor = null, resched = false;
  function openViewing(isResched) {
    const a = core.active(); if (!a) return; viewingFor = a.listingId; resched = !!isResched && !!core.nextViewing(a.listingId);
    const p = core.Profile.forListing(viewingFor), tm = new Date(), nv = core.nextViewing(viewingFor); ['ni-vdate', 'ni-vtime', 'ni-vname', 'ni-vphone'].forEach(i => setErr(i, '')); $('ni-verr').textContent = '';
    $('ni-vt').textContent = t(resched ? 'v_title_r' : 'v_title'); $('ni-vsend').textContent = t(resched ? 'v_send_r' : 'v_send');
    $('ni-vtime').innerHTML = `<option value="">${esc(t('v_select'))}</option>` + SLOTS.map(s => `<option value="${esc(s[0])}">${esc(s[lang === 'sw' ? 2 : 1])}</option>`).join('');
    $('ni-vdate').min = core.localISO(tm); if (resched && nv) { $('ni-vdate').value = nv.requested_date; $('ni-vtime').value = nv.requested_time; } else { tm.setDate(tm.getDate() + 1); $('ni-vdate').value = core.localISO(tm); $('ni-vtime').value = ''; }
    $('ni-vname').value = p.name; $('ni-vphone').value = p.phone; $('ni-vnotes').value = ''; openModal('ni-vov', 'ni-vdate');
  }
  async function sendViewing() {
    ['ni-vdate', 'ni-vtime', 'ni-vname', 'ni-vphone'].forEach(i => setErr(i, '')); $('ni-verr').textContent = '';
    const b = $('ni-vsend'), label = b.textContent; b.disabled = true; b.textContent = t('sending');
    const r = await core.requestViewing({ listingId: viewingFor, date: $('ni-vdate').value, time: $('ni-vtime').value, name: $('ni-vname').value, phone: $('ni-vphone').value, notes: $('ni-vnotes').value, reschedule: resched });
    b.disabled = false; b.textContent = label;
    if (!r.ok) { if (r.field) { setErr('ni-v' + r.field, r.error); const f = $('ni-v' + r.field); if (f) f.focus(); } else $('ni-verr').textContent = r.error; return; }
    closeModal('ni-vov'); if (r.warning) toast(r.warning); renderHead(); renderQuick(); renderVStrip(); renderList();
  }
  const icsText = s => String(s == null ? '' : s).replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n');
  function icsFor(v, l, c) {
    const [s, e] = SLOT_HOURS[v.requested_time] || [9, 10], d = String(v.requested_date).replace(/-/g, ''), p = n => String(n).padStart(2, '0'), now = new Date(), stamp = now.getUTCFullYear() + p(now.getUTCMonth() + 1) + p(now.getUTCDate()) + 'T' + p(now.getUTCHours()) + p(now.getUTCMinutes()) + p(now.getUTCSeconds()) + 'Z';
    const title = (l && l.title) || (c && c.title) || 'Property', url = l && l.listing_number != null ? location.origin + '/listing?id=' + String(l.listing_number).padStart(6, '0') : location.origin;
    return ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Nyumba254//Viewing//EN', 'CALSCALE:GREGORIAN', 'BEGIN:VEVENT', 'UID:' + (v.id || core.uuid()) + '@nyumba254.com', 'DTSTAMP:' + stamp, 'DTSTART:' + d + 'T' + p(s) + '0000', 'DTEND:' + d + 'T' + p(e) + '0000', 'SUMMARY:' + icsText('Viewing: ' + title), 'LOCATION:' + icsText([l && l.address, l && l.area, l && l.county].filter(Boolean).join(', ')), 'DESCRIPTION:' + icsText('Viewing arranged through Nyumba254. Confirm the time with the seller in your chat. ' + url), 'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
  }
  function downloadIcs() {
    const a = core.active(), v = a && core.nextViewing(a.listingId); if (!v) return;
    const blob = new Blob([icsFor(v, core.listing(), activeConvo())], { type: 'text/calendar;charset=utf-8' }), url = URL.createObjectURL(blob), link = document.createElement('a');
    link.href = url; link.download = 'nyumba254-viewing.ics'; document.body.appendChild(link); link.click(); link.remove(); setTimeout(() => URL.revokeObjectURL(url), 1500);
  }

  /* ═════ profile, sync ═════ */
  function openProfile() { const p = core.Profile.get(); $('ni-p-name').value = p.name; $('ni-p-email').value = p.email; $('ni-p-phone').value = p.phone; $('ni-p-notify').checked = p.notify; setErr('ni-p-email', ''); setErr('ni-p-phone', ''); $('ni-pstatus').textContent = ''; openModal('ni-pov', 'ni-p-name'); }
  async function saveProfile() {
    const name = $('ni-p-name').value.trim(), email = $('ni-p-email').value.trim(), phoneRaw = $('ni-p-phone').value.trim(), notify = $('ni-p-notify').checked, phone = phoneRaw ? core.normPhone(phoneRaw) : '';
    setErr('ni-p-email', ''); setErr('ni-p-phone', ''); let ok = true;
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setErr('ni-p-email', t('bad_email')); ok = false; }
    if (phone && !core.okPhone(phone)) { setErr('ni-p-phone', t('bad_phone')); ok = false; }
    if (!ok) return;
    const b = $('ni-psave'), st = $('ni-pstatus'), label = b.textContent; b.disabled = true; b.textContent = t('saving');
    core.Profile.set({ name, email, phone, notify }); const r = await core.saveContacts({ name, email, phone, notify });
    if (email) {
      const link = core.buildResumeLink();
      if (link) { fetch(EDGE + '/send-notification-email', { method: 'POST', headers: { 'Content-Type': 'application/json', apikey: KEY, Authorization: 'Bearer ' + KEY }, body: JSON.stringify({ type: 'buyer_access_link', buyerEmail: email, buyerName: name, accessLink: link }) }).catch(() => {}); st.textContent = t('pn_saved_mail'); }
      else st.textContent = t('pn_saved_nochat');
    } else st.textContent = t('pn_saved');
    if (!r.ok) st.textContent += t('pn_sync_fail');
    b.disabled = false; b.textContent = label; setTimeout(() => { if ($('ni-pov').classList.contains('open')) closeModal('ni-pov'); }, 1600);
  }
  function openSync() { $('ni-sync-link').value = core.buildResumeLink() || ''; openModal('ni-sov', 'ni-sync-copy'); }

  /* ═════ browser notifications ═════ */
  const notifOK = () => 'Notification' in window;
  function renderNotif() { $('ni-notif').hidden = !(notifOK() && Notification.permission === 'default' && !core.ls.get('nk_notif_dismissed') && core.convos().length > 0 && tab === 'chats'); }
  function notify(convo, message) {
    if (!notifOK() || Notification.permission !== 'granted' || !document.hidden) return;
    try { const n = new Notification(t('notif_title', convo.sellerName, convo.title), { body: message ? message.content : '', tag: 'nk-' + convo.listingId, icon: convo.coverUrl || undefined }); n.onclick = () => { window.focus(); openConvo(convo.listingId); n.close(); }; } catch (e) {}
  }

  /* ═════ language ═════ */
  function applyLang() {
    document.documentElement.lang = lang; core.setLang(lang);
    qsa('[data-i18n]').forEach(e => { e.textContent = t(e.dataset.i18n); });
    qsa('[data-i18n-ph]').forEach(e => { e.placeholder = t(e.dataset.i18nPh); });
    qsa('[data-i18n-aria]').forEach(e => { e.setAttribute('aria-label', t(e.dataset.i18nAria)); });
    $('ni-lang').textContent = lang === 'en' ? 'Kiswahili' : 'English'; $('ni-lang').setAttribute('aria-label', lang === 'en' ? 'Badilisha lugha kuwa Kiswahili' : 'Change language to English');
    $('ni-m-archive-t').textContent = t('m_archive'); $('ni-book-label').textContent = t('book'); $('ni-safety-t').textContent = t('safety'); updateCmpBtn(); acctLabel();
    renderList(); renderCounts(); renderNotif(); if (tab === 'saved') renderSaved();
    if (core.active()) { renderHead(); renderPresence(); renderGone(); renderVStrip(); renderSide(); renderMessages(); resetSafety(); }
  }
  function acctLabel() { const a = $('ni-acct'); a.textContent = t(a.dataset.in ? 'nav_account' : 'nav_signin'); }

  /* ═════ touch gestures ═════ */
  function bindGestures() {
    const list = $('ni-list'); let sx = 0, sy = 0, el = null, dx = 0, locked = null, py = null;
    list.addEventListener('touchstart', e => { const s = e.target.closest('.ni-convo'); if (!e.touches || e.touches.length !== 1) { el = null; py = null; return; } el = s || null; sx = e.touches[0].clientX; sy = e.touches[0].clientY; dx = 0; locked = null; py = list.scrollTop <= 0 ? sy : null; }, { passive: true });
    list.addEventListener('touchmove', e => {
      if (!e.touches || !e.touches[0]) return; const mx = e.touches[0].clientX - sx, my = e.touches[0].clientY - sy;
      if (locked === null && (Math.abs(mx) > 8 || Math.abs(my) > 8)) locked = Math.abs(mx) > Math.abs(my) ? 'x' : 'y';
      if (el && locked === 'x') { dx = Math.min(0, mx); el.classList.add('dragging'); el.style.transform = `translateX(${dx}px)`; }
      else if (py !== null && locked === 'y' && my > 20) { $('ni-ptr').classList.add('show'); $('ni-ptr').textContent = my > 70 ? t('ptr_go') : t('ptr'); }
    }, { passive: true });
    list.addEventListener('touchend', e => {
      const c = (e.changedTouches && e.changedTouches[0]) || {}, my = (c.clientY || 0) - sy; $('ni-ptr').classList.remove('show');
      if (el) { el.classList.remove('dragging'); el.style.transform = ''; if (locked === 'x' && dx < -90) { const id = el.dataset.l; el = null; setArchived(id, !isArch(id)); return; } }
      if (py !== null && locked === 'y' && my > 70) core.fetchConversations(); el = null; py = null;
    }, { passive: true });
    const pane = $('ni-thread-pane'); let bx = null, by = 0;
    pane.addEventListener('touchstart', e => { const c = e.touches && e.touches[0]; bx = (c && c.clientX < 32 && !desk()) ? c.clientX : null; by = c ? c.clientY : 0; }, { passive: true });
    pane.addEventListener('touchend', e => { if (bx === null) return; const c = (e.changedTouches && e.changedTouches[0]) || {}; if ((c.clientX || 0) - bx > 90 && Math.abs((c.clientY || 0) - by) < 60) closeThread(); bx = null; }, { passive: true });
  }
  function stepConvo(dir) { const v = visibleConvos(); if (!v.length) return; const a = core.active(); let i = a ? v.findIndex(c => c.listingId === a.listingId) : -1; i = Math.max(0, Math.min(v.length - 1, i < 0 ? (dir > 0 ? 0 : v.length - 1) : i + dir)); openConvo(v[i].listingId); }

  /* ═════ wire it up ═════ */
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { const o = qsa('.ni-overlay.open').pop(); if (o) return closeModal(o.id); if ($('ni-menu').classList.contains('open')) { closeMenu(); $('ni-more').focus(); } return; }
    const tg = e.target, typing = tg && (/INPUT|TEXTAREA|SELECT/.test(tg.tagName) || tg.isContentEditable);
    if (typing || e.ctrlKey || e.metaKey || e.altKey || qsa('.ni-overlay.open').length) return;
    if (e.key === '/') { e.preventDefault(); switchTab('chats'); $('ni-search').focus(); }
    else if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && desk() && tab === 'chats') { e.preventDefault(); stepConvo(e.key === 'ArrowDown' ? 1 : -1); }
  });
  document.addEventListener('click', e => { if ($('ni-menu').classList.contains('open') && !e.target.closest('#ni-menu') && !e.target.closest('#ni-more')) closeMenu(); });
  $('ni-tabs').addEventListener('click', e => { const b = e.target.closest('.ni-tab'); if (b) switchTab(b.dataset.tab); });
  $('ni-search').addEventListener('input', function () { term = this.value; renderList(); });
  $('ni-filters').addEventListener('click', e => { const b = e.target.closest('[data-f]'); if (b) { filter = b.dataset.f; renderList(); } });
  $('ni-list').addEventListener('click', e => {
    const a = e.target.closest('[data-arch]'); if (a) return setArchived(a.dataset.arch, !isArch(a.dataset.arch));
    const c = e.target.closest('.ni-convo'); if (c) return openConvo(c.dataset.l); if (e.target.closest('[data-a="reload"]')) core.fetchConversations();
  });
  $('ni-notif').addEventListener('click', e => { const b = e.target.closest('[data-a]'); if (!b) return; if (b.dataset.a === 'notif-yes') Notification.requestPermission().then(renderNotif, renderNotif); else { core.ls.set('nk_notif_dismissed', '1'); renderNotif(); } });
  $('ni-saved').addEventListener('click', e => {
    const rm = e.target.closest('[data-rm]'); if (rm) { core.setSaved(core.savedIds().filter(i => i !== rm.dataset.rm)); cmpSel.delete(rm.dataset.rm); return renderSaved(); }
    const g = e.target.closest('[data-a="clear-gone"]'); if (g) { const gone = g.dataset.ids.split(','); core.setSaved(core.savedIds().filter(i => !gone.includes(i))); return renderSaved(); }
    if (e.target.closest('[data-a="reload-saved"]')) renderSaved();
  });
  $('ni-saved').addEventListener('change', e => { const c = e.target.closest('[data-cmp]'); if (!c) return; if (c.checked) { if (cmpSel.size >= 3) { c.checked = false; return toast(lang === 'sw' ? 'Unaweza kulinganisha hadi matangazo 3.' : 'You can compare up to 3 listings.'); } cmpSel.add(c.dataset.cmp); } else cmpSel.delete(c.dataset.cmp); updateCmpBtn(); });
  $('ni-saved-sort').addEventListener('change', renderSaved); $('ni-cmp-btn').addEventListener('click', openCompare); $('ni-cmp-close').addEventListener('click', () => closeModal('ni-cov'));
  $('ni-messages').addEventListener('click', e => {
    const r = e.target.closest('[data-retry]'); if (r) return core.retry(r.dataset.retry);
    if (e.target.closest('[data-a="reopen"]')) { const a = core.active(); if (a) core.openThread(a.listingId, a.token); }
    const er = e.target.closest('[data-a="earlier"]'); if (er) { er.textContent = t('loading_short'); er.disabled = true; core.loadEarlier().then(() => { if (core.hasMore() === false) renderMessages(null, true); }); }
  });
  $('ni-messages').addEventListener('scroll', () => { if (atBottom()) $('ni-newpill').classList.remove('show'); }, { passive: true });
  $('ni-newpill').addEventListener('click', toBottom);
  $('ni-quick').addEventListener('click', e => { const c = e.target.closest('.ni-chip'); if (!c) return; if (c.dataset.k === 'view') return openViewing(!!core.booked((core.active() || {}).listingId)); sendText(c.dataset.q); });
  $('ni-send').addEventListener('click', sendInput);
  $('ni-input').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendInput(); } });
  $('ni-input').addEventListener('input', function () { autosize(this); core.typing(); clearTimeout(draftT); draftT = setTimeout(() => { const a = core.active(); if (a) { setDraft(a.listingId, this.value); renderList(); } }, 350); });
  $('ni-back-btn').addEventListener('click', () => closeThread());
  $('ni-tsearch-btn').addEventListener('click', () => toggleThreadSearch(!$('ni-searchbar').classList.contains('show')));
  $('ni-tsearch-x').addEventListener('click', () => toggleThreadSearch(false));
  $('ni-tsearch').addEventListener('input', function () { threadTerm = this.value.trim(); renderMessages(); });
  $('ni-book-btn').addEventListener('click', () => openViewing(!!core.booked((core.active() || {}).listingId)));
  $('ni-more').addEventListener('click', toggleMenu); $('ni-menu').addEventListener('click', e => { const b = e.target.closest('[data-m]'); if (b) menuAction(b.dataset.m); });
  $('ni-vstrip').addEventListener('click', e => { const b = e.target.closest('[data-a]'); if (!b) return; if (b.dataset.a === 'ics') downloadIcs(); else openViewing(true); });
  $('ni-details-btn').addEventListener('click', () => { const off = document.body.classList.toggle('ni-side-off'); core.ls.set('nk_inbox_side', off ? '0' : '1'); });
  $('ni-side').addEventListener('click', e => { const b = e.target.closest('[data-ph]'); if (b) { sidePhoto = Number(b.dataset.ph); renderSide(); } });
  $('ni-vcancel').addEventListener('click', () => closeModal('ni-vov')); $('ni-vsend').addEventListener('click', sendViewing);
  $('ni-profile-btn').addEventListener('click', openProfile); $('ni-pcancel').addEventListener('click', () => closeModal('ni-pov')); $('ni-psave').addEventListener('click', saveProfile);
  $('ni-sync-btn').addEventListener('click', openSync); $('ni-sync-close').addEventListener('click', () => closeModal('ni-sov'));
  $('ni-sync-copy').addEventListener('click', () => { const i = $('ni-sync-link'); if (!i.value) return; (navigator.clipboard ? navigator.clipboard.writeText(i.value) : Promise.reject()).then(() => { const b = $('ni-sync-copy'); b.textContent = t('copied'); setTimeout(() => { b.textContent = t('copy'); }, 1800); }, () => i.select()); });
  $('ni-safety-x').addEventListener('click', () => { core.ls.set('nk_chat_safety_seen', '1'); $('ni-safety').classList.remove('show'); });
  $('ni-report').addEventListener('click', async function () {
    const a = core.active(); if (!a) return; if (this.dataset.a === 'ask') return reportAsk();
    this.disabled = true; const r = await core.report(a.listingId, 'Reported from the inbox'); this.disabled = false; this.dataset.a = 'ask'; this.textContent = t('report'); $('ni-safety-t').textContent = t(r.ok ? 'report_ok' : 'report_fail');
  });
  $('ni-lang').addEventListener('click', () => { lang = lang === 'en' ? 'sw' : 'en'; core.ls.set('nk_lang', lang); applyLang(); });
  document.addEventListener('visibilitychange', () => core.setViewing(vis()));

  core.on('convos', () => { renderCounts(); if (tab === 'chats') renderList(); renderNotif(); if (core.active()) renderHead(); });
  core.on('thread', ev => {
    if (ev.type === 'reset') { const a = core.active(); if (!ev.loading && !ev.error && a && newLineFor !== a.listingId) { newLineFor = a.listingId; computeNewLine(); } renderMessages(ev); if (!ev.loading) { renderHead(); renderGone(); renderVStrip(); renderSide(); } }
    else if (ev.type === 'append') appendMessage(ev.message, ev.incoming); else if (ev.type === 'update') updateMessage(ev.message); else if (ev.type === 'prepend') renderMessages(null, true);
  });
  core.on('presence', renderPresence);
  core.on('viewing', () => { if (core.active()) { renderHead(); renderQuick(); renderVStrip(); } renderList(); });
  core.on('incoming', ev => { const id = ev.convo.listingId; if (isArch(id)) { core.Archive.set(id, false); renderCounts(); renderList(); } notify(ev.convo, ev.message); });
  core.on('net', ev => $('ni-net').classList.toggle('show', !ev.online));
  if (!core.isOnline()) $('ni-net').classList.add('show');
  if (core.ls.get('nk_inbox_side') === '0') document.body.classList.add('ni-side-off');

  /* ── start ── */
  applyLang(); bindGestures(); core.setPolling(true); core.init(); renderCounts(); renderList();
  try { core.getClient().auth.getSession().then(({ data }) => { if (data && data.session) { const a = $('ni-acct'); a.href = '/dashboard'; a.dataset.in = '1'; acctLabel(); } }, () => {}); } catch (e) {}
  const params = new URLSearchParams(location.search);
  if (params.get('tab') === 'saved') switchTab('saved');
  const open = params.get('open'); if (open) core.fetchConversations().then(() => openConvo(open));
  window.NKInbox = { refresh: core.fetchConversations, open: openConvo, getResumeLink: core.buildResumeLink, icsFor, setLang: l => { lang = l; applyLang(); } };
})();
</script>
<script src="/nk-shared.js"></script>
</body>
</html>